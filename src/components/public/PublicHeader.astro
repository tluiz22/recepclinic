---
// Topo das páginas públicas (/agendar e /preparo, F5.1): logo e nome da
// clínica na cor dela; "Voltar para o site" só quando a clínica tem site
// (cliente, 05/out/2026). Redesign R11: as cores vêm das variáveis do
// PatientLayout (bg-clinic, text-clinic-text).
import type { PublicClinicBrand } from "../../lib/data/config/brand";

interface Props {
  brand: PublicClinicBrand;
  /** Largura do conteúdo da página, para o topo alinhar com ele. */
  container?: string;
}

const { brand, container = "max-w-2xl" } = Astro.props;
---

<header class="bg-clinic text-clinic-text">
  <div class={`mx-auto flex w-full items-center justify-between gap-3 px-4 py-3.5 sm:px-6 sm:py-4 ${container}`}>
    <div class="flex min-w-0 items-center gap-3">
      {
        brand.logoUrl && (
          <img src={brand.logoUrl} alt="" class="h-10 w-10 shrink-0 rounded-lg bg-white object-contain p-1 sm:h-11 sm:w-11" />
        )
      }
      <p class="truncate text-[17px] leading-tight font-semibold sm:text-[19px]">{brand.name}</p>
    </div>
    {
      brand.websiteUrl && (
        <a
          href={brand.websiteUrl}
          rel="noopener"
          class="inline-flex h-9 shrink-0 items-center rounded-lg border border-current px-3 text-sm font-semibold text-clinic-text no-underline hover:opacity-85 sm:h-[38px] sm:px-3.5 sm:text-[15px]"
        >
          Voltar para o site
        </a>
      )
    }
  </div>
</header>

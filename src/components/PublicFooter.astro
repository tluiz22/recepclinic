---
// Rodapé das páginas públicas (/agendar e /preparo, F5.1): aviso de
// emergência para qualquer área, "Feito com RecepClinic" e as páginas legais
// do site do produto (cliente, 05/out/2026). Sem contato nem endereço da
// clínica. Redesign R11: cinzas neutros e a largura da página.
const PRODUCT_SITE = "https://www.recepclinic.com.br";

interface Props {
  container?: string;
}

const { container = "max-w-2xl" } = Astro.props;
---

<footer class="border-t border-gray-200 bg-gray-50">
  <div class={`mx-auto flex w-full flex-col gap-4 px-4 py-6 sm:px-6 sm:py-8 ${container}`}>
    <aside
      class="rounded-[10px] border border-amber-200 bg-amber-50 px-4 py-3.5 text-[15px] leading-normal text-amber-900"
      role="note"
      aria-label="Aviso de emergência"
    >
      <strong>Aviso de emergência:</strong> Esta página não realiza atendimento de urgência ou
      emergência. Em caso de emergência, procure atendimento imediato ou ligue 192.
    </aside>
    <nav aria-label="RecepClinic" class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-[13.5px] text-gray-600">
      <a href={PRODUCT_SITE} rel="noopener" class="text-gray-600 no-underline hover:text-gray-900">Feito com <strong class="font-semibold">RecepClinic</strong></a>
      <a href={`${PRODUCT_SITE}/privacidade`} rel="noopener" class="text-gray-600 underline hover:text-gray-900">Privacidade</a>
      <a href={`${PRODUCT_SITE}/termos`} rel="noopener" class="text-gray-600 underline hover:text-gray-900">Termos de uso</a>
    </nav>
  </div>
</footer>

---
// Preparo do exame (F2d; D4): quadro antes dos dias, na revisão e na tela final, com o link do arquivo (PDF) quando há.
// O texto vem na formatação do WhatsApp (*negrito*): no portal sai sem os asteriscos. O preparo também sai pelo
// WhatsApp depois da confirmação (preparation.ts), como no bot.
import type { PortalExam } from "../../lib/data/portal/portal";
import { publicBaseUrl } from "../../lib/data/whatsapp/clinicSender";
import { preparationPath } from "../../lib/publicId";
import { whatsappPlain } from "../../lib/portal";

interface Props {
  exam: PortalExam;
  title?: string;
  fileLabel?: string;
}

const { exam, title = "Preparo do exame", fileLabel = "Ver orientações completas (PDF)" } = Astro.props;
// Só *negrito* e _itálico_ como palavras inteiras: "preparo_jejum_8h" e endereços ficam como estão.
const text = exam.preparation ? whatsappPlain(exam.preparation) : null;
const fileHref = exam.hasPreparationFile ? `${publicBaseUrl(Astro.url)}${preparationPath(exam.serviceId)}` : null;
---

{
  (text || fileHref) && (
    <section class="flex flex-col gap-1.5 rounded-[14px] border border-amber-200 bg-amber-50 px-4 py-3.5 text-amber-950" aria-label={title}>
      <p class="font-bold">{title}</p>
      {text && <p class="text-[17px] whitespace-pre-line">{text}</p>}
      {fileHref && (
        <a href={fileHref} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center self-start font-bold text-amber-900 underline">
          {fileLabel}
        </a>
      )}
    </section>
  )
}

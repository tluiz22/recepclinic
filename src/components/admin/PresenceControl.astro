---
// Presença confirmada pelo paciente (Fase 19) nos cards da Agenda (dia) e do
// Resumo do dia: selo "Presença confirmada ✓" com quem/quando, e o botão de
// marcar/desfazer à mão (confirmação por ligação ou texto).
import Badge from "./Badge.astro";

interface Props {
  appointmentId: string;
  // "Confirmada por WhatsApp no dia …" (`formatPresenceLine`) — null = não confirmada.
  confirmedLine: string | null;
  // Tela pra onde voltar depois de marcar/desfazer.
  returnTo: string;
  // Botão só para atendimento ativo e ainda por vir.
  editable: boolean;
}

const { appointmentId, confirmedLine, returnTo, editable } = Astro.props;
const confirmed = confirmedLine !== null;
---

{
  (confirmed || editable) && (
    <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1.5">
      {confirmed && (
        <span class="flex flex-wrap items-center gap-x-2 gap-y-0.5">
          <Badge variant="success">Presença confirmada ✓</Badge>
          <span class="text-xs text-slate-400">{confirmedLine}</span>
        </span>
      )}
      {editable && (
        <form method="POST" action={`/api/admin/agenda/appointments/${appointmentId}/presence`}>
          <input type="hidden" name="confirmed" value={confirmed ? "0" : "1"} />
          <input type="hidden" name="return_to" value={returnTo} />
          <button
            type="submit"
            class={
              confirmed
                ? "text-xs font-medium text-slate-500 hover:text-slate-700 hover:underline"
                : "rounded-md border border-emerald-300 px-2.5 py-1 text-xs font-semibold text-emerald-700 hover:bg-emerald-50"
            }
          >
            {confirmed ? "Desfazer presença confirmada" : "Marcar presença confirmada"}
          </button>
        </form>
      )}
    </div>
  )
}

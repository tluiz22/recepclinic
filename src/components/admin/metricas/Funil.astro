---
// Métricas › Funil (Fase 15; aba própria na Fase 23 · etapa 4, etapas
// atualizadas na etapa 6): etapas de cada fluxo do bot + passos da página
// /agendar, Remarcar e Cancelar separados por origem (menu ou lembrete) e o
// cartão "Atendimento humano". Gráfico em barras CSS, sem lib (decisão do
// cliente).
import Card from "../Card.astro";
import Badge from "../Badge.astro";
import { createClient } from "../../../lib/supabase/server";
import { buildFunnelReport } from "../../../lib/metrics/whatsappFunnel";
import { fetchFunnelEvents, formatPercent } from "../../../lib/metrics/data";
import type { MetricsPeriod } from "../../../lib/metrics/period";

interface Props {
  period: MetricsPeriod;
}

const { period } = Astro.props;
const supabase = createClient(Astro.request, Astro.cookies);

const events = await fetchFunnelEvents(supabase, period.start, period.end);
const report = buildFunnelReport(events, period.start, period.end);
---

<p class="mt-6 text-sm text-slate-500">
  Tentativas iniciadas no período. Cada barra é proporcional a quem iniciou; a porcentagem é a conversão em relação à
  etapa anterior. Sem resposta há mais de 30 minutos conta como abandono na última etapa alcançada.
</p>

<div class="mt-3 grid gap-4 lg:grid-cols-2">
  {
    report.flows.map((flow) => {
      const first = flow.stages[0]?.count ?? 0;
      return (
        <Card>
          <h3 class="font-semibold text-slate-900">{flow.label}</h3>
          {first === 0 ? (
            <p class="mt-3 text-sm text-slate-500">Nenhuma tentativa no período.</p>
          ) : (
            <>
              <div class="mt-3 space-y-2">
                {flow.stages.map((stage) => (
                  <div class="grid grid-cols-[8.5rem_1fr_4.5rem] items-center gap-2 text-xs sm:text-sm">
                    <span class="truncate text-slate-600">{stage.label}</span>
                    <div class="h-5 rounded bg-slate-100">
                      <div
                        class="h-5 rounded bg-sky-500"
                        style={`width: ${Math.max((stage.count / first) * 100, stage.count > 0 ? 2 : 0)}%`}
                      />
                    </div>
                    <span class="text-right tabular-nums text-slate-900">
                      <span class="font-semibold">{stage.count}</span>
                      {stage.conversion !== null && (
                        <span class="ml-1 text-slate-500">{formatPercent(stage.conversion)}</span>
                      )}
                    </span>
                  </div>
                ))}
              </div>

              <div class="mt-4 flex flex-wrap gap-1.5">
                <Badge variant="success">Concluídas: {flow.outcomes.concluded}</Badge>
                <Badge variant="warning">Abandonaram: {flow.outcomes.abandoned}</Badge>
                {flow.outcomes.blocked > 0 && <Badge variant="neutral">Barradas: {flow.outcomes.blocked}</Badge>}
                {flow.outcomes.declined > 0 && <Badge variant="neutral">Desistiram: {flow.outcomes.declined}</Badge>}
                {flow.outcomes.error > 0 && <Badge variant="danger">Erro: {flow.outcomes.error}</Badge>}
                {flow.outcomes.in_progress > 0 && (
                  <Badge variant="info">Em andamento: {flow.outcomes.in_progress}</Badge>
                )}
              </div>

              {flow.notes.length > 0 && (
                <ul class="mt-3 space-y-0.5 text-xs text-slate-600">
                  {flow.notes.map((note) => (
                    <li>
                      {note.label}: <span class="font-semibold">{note.count}</span>
                    </li>
                  ))}
                </ul>
              )}

              {flow.blockedReasons.length > 0 && (
                <ul class="mt-3 space-y-0.5 text-xs text-slate-500">
                  {flow.blockedReasons.map((reason) => (
                    <li>
                      Barradas — {reason.label}: {reason.count}
                    </li>
                  ))}
                </ul>
              )}
            </>
          )}
        </Card>
      );
    })
  }

  <Card>
    <h3 class="font-semibold text-slate-900">Atendimento humano</h3>
    <dl class="mt-3 space-y-2 text-sm">
      <div class="flex items-baseline justify-between gap-3">
        <dt class="text-slate-600">Pediram a secretária pelo menu</dt>
        <dd class="font-semibold tabular-nums text-slate-900">{report.handoffRequests}</dd>
      </div>
      <div class="flex items-baseline justify-between gap-3">
        <dt class="text-slate-600">
          Secretária assumiu pelo app
          {report.agentTookOver.total > 0 && (
            <span class="block text-xs text-slate-500">
              {report.agentTookOver.midJourney} no meio de um agendamento, remarcação ou cancelamento
            </span>
          )}
        </dt>
        <dd class="font-semibold tabular-nums text-slate-900">{report.agentTookOver.total}</dd>
      </div>
    </dl>
    <p class="mt-3 text-xs text-slate-400">
      "Assumiu pelo app" conta cada vez que a secretária escreveu pelo WhatsApp Business e o bot pausou (registrado a
      partir de 02/10/2026).
    </p>
  </Card>
</div>

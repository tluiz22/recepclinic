---
// Indicador das Métricas (redesign de 22/out/2026, M4): rótulo, número,
// variação contra o mesmo período do mês anterior (com o período escrito) e
// a base. O "i" abre a regra de contagem em português simples (HelpTip, o
// padrão da ajuda contextual de 23/out/2026).
import type { Delta } from "./compare";
import HelpTip from "../ui/HelpTip.astro";

interface Props {
  label: string;
  value: string;
  delta?: Delta;
  /** "289 de 1 a 22/set (mesmos 22 dias)" ou o motivo de não comparar. */
  previous?: string | null;
  /** Selo "Parcial" (desfecho ainda desconhecido). */
  partial?: boolean;
  /** Regra de contagem (o "i"). */
  rule: string;
  id: string;
}

const { label, value, delta, previous, partial = false, rule, id } = Astro.props;
const DELTA = {
  good: "bg-conf-100 text-conf-800",
  bad: "bg-ns-100 text-ns-800",
  flat: "bg-canvas-deep text-ink-mid",
};
---

<div class:list={["relative flex min-w-0 flex-col gap-2 rounded-xl border bg-white px-4 py-3.5 sm:px-5 sm:py-4", partial ? "border-pend-200 bg-pend-50" : "border-line"]}>
  <div class="flex items-start justify-between gap-2">
    <span class="text-[14.5px] leading-snug font-semibold text-ink-mid">{label}</span>
    <HelpTip variant="card" subject={label} text={rule} id={id} />
  </div>
  <span class="font-display text-[34px] leading-none font-bold text-ink tabular-nums sm:text-[38px]">{value}</span>
  {
    (delta || previous) && (
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
        {delta && <span class={`inline-flex items-center rounded-full px-2 py-0.5 text-[13px] font-bold ${DELTA[delta.tone]}`}>{delta.text}</span>}
        {previous && <span class="text-[13.5px] leading-snug text-ink-soft">{previous}</span>}
      </div>
    )
  }
  {
    partial && (
      <span class="self-start rounded-full bg-pend-100 px-2 py-0.5 text-[12.5px] font-bold text-pend-800">Parcial</span>
    )
  }
  <div class="text-[14px] leading-snug text-ink-soft"><slot /></div>
</div>

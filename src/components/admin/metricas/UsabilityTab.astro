---
// Métricas › Usabilidade (frente Usabilidade, U2): só o Suporte. Sinais de dificuldade tirados de dados já gravados;
// a clínica é uma por vez. Número alto é pista para olhar, não prova de erro.
import { dayBounds, todayIn } from "../../../lib/clinicTime";
import type { ClinicContext } from "../../../lib/clinicAccess";
import type { DbClient } from "../../../lib/data/clients";
import { getVisitSteps } from "../../../lib/data/portal/visit";
import { getUsabilitySignals } from "../../../lib/data/usability";
import { logError } from "../../../lib/log";
import { formatRate, type DateRange } from "../../../lib/metricsRules";
import { biggestLoss, visitFunnel } from "../../../lib/portalVisit";
import { rankSignals, signalShare, type SignalCount } from "../../../lib/usabilitySignals";
import type { StepCount } from "../../../lib/portalVisit";

interface Props {
  db: DbClient;
  clinic: ClinicContext;
  range: DateRange;
  links: { retry: string; portal: string };
  now: Date;
}

const { db, clinic, range, links, now } = Astro.props;
const tz = clinic.timezone;
const start = dayBounds(range.from, tz).start;
const end = dayBounds(range.to, tz).end;

let signals: SignalCount[] | null = null;
let steps: StepCount[] = [];
try {
  [signals, steps] = await Promise.all([getUsabilitySignals(db, clinic.clinicId, start, end), getVisitSteps(db, clinic.clinicId, start, end)]);
} catch (error) {
  logError("métricas: usabilidade não carregou", error, { clinica: clinic.clinicId });
}

const limitDay = dayBounds(todayIn(tz, now), tz).start.getTime() - 30 * 86_400_000;
const oldRange = start.getTime() < limitDay;
const ranked = signals ? rankSignals(signals) : [];
const loss = biggestLoss(visitFunnel(steps));
const withCases = ranked.filter((r) => (r.count?.affected ?? 0) > 0).length;

const card = "flex min-w-0 flex-col gap-1.5 rounded-xl border border-line bg-white px-4 py-4 sm:px-5";
const h2 = "font-display text-lg leading-tight font-bold text-ink";
const sub = "text-sm leading-relaxed text-ink-soft";
---

{
  signals === null ? (
    <div role="alert" class="mt-4 rounded-xl border border-ns-100 bg-ns-100/40 px-4 py-4">
      <h2 class={`${h2} text-ns-800`}>Não foi possível carregar a Usabilidade</h2>
      <a href={links.retry} class="mt-2 inline-flex h-11 items-center rounded-lg bg-brand px-4 font-semibold text-white no-underline hover:bg-brand-strong">Tentar de novo</a>
    </div>
  ) : (
    <>
      <p class="mt-4 rounded-xl border border-line bg-white px-4 py-3 text-sm text-ink-mid">
        Só o Suporte vê esta aba. Os sinais saem do que o sistema já guarda, sem gravar nada a mais. Um número alto é uma pista para olhar essa parte do sistema, não prova de que o paciente ou a recepção erraram.
      </p>
      {oldRange && (
        <p role="note" class="mt-3 rounded-xl border border-pend-200 bg-pend-50 px-4 py-3 text-sm text-ink-mid">
          Códigos e reservas do portal são guardados por 30 dias. Neste período, esses sinais estão incompletos; os de marcação e cancelamento têm o histórico inteiro.
        </p>
      )}

      <section aria-labelledby="sinais" class="mt-4">
        <h2 id="sinais" class={h2}>Sinais de dificuldade</h2>
        <p class={`${sub} mt-1`}>
          {withCases === 0 ? "Nenhum sinal apareceu neste período." : `${withCases} de ${ranked.length} sinais apareceram neste período, do que mais se repete para o que menos.`}
        </p>
        <ul class="mt-3 flex flex-col gap-3" aria-label="Sinais">
          {ranked.map(({ signal, count }) => {
            const share = signalShare(count);
            const affected = count?.affected ?? 0;
            return (
              <li data-sinal={signal.id} class={card}>
                <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                  <h3 class="min-w-0 font-semibold text-ink">{signal.label}</h3>
                  <span class="rounded-full bg-canvas-deep px-2.5 py-0.5 text-[13px] font-semibold text-ink-mid">{signal.where}</span>
                </div>
                <p class="text-[15px] tabular-nums text-ink">
                  <strong class={affected > 0 ? "text-ns-800" : ""}>{affected}</strong>
                  {count && count.base > 0 ? ` de ${count.base} ${count.base === 1 ? signal.baseOne : signal.baseLabel}` : " (sem base no período)"}
                  {share !== null && <span class="ml-1.5 text-ink-soft">{formatRate(share)}</span>}
                </p>
                {affected > 0 && (
                  <>
                    <p class={sub}><strong class="text-ink-mid">O que pode significar:</strong> {signal.meaning}</p>
                    <p class={sub}><strong class="text-ink-mid">O que melhorar:</strong> {signal.improve}</p>
                  </>
                )}
              </li>
            );
          })}
          <li data-sinal="funil" class={card}>
            <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
              <h3 class="min-w-0 font-semibold text-ink">Onde mais visitas pararam no portal</h3>
              <span class="rounded-full bg-canvas-deep px-2.5 py-0.5 text-[13px] font-semibold text-ink-mid">Portal</span>
            </div>
            <p class="text-[15px] text-ink">
              {loss ? (
                <><strong>Passo {loss.step}, “{loss.label}”:</strong> {loss.stoppedHere} {loss.stoppedHere === 1 ? "visita parou" : "visitas pararam"} ali.</>
              ) : (
                "Nenhuma visita parou no meio do caminho neste período."
              )}
            </p>
            <a href={links.portal} class="inline-flex min-h-11 items-center self-start text-sm font-semibold text-brand no-underline hover:underline focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-brand">Ver o funil completo em Portal</a>
          </li>
        </ul>
      </section>
    </>
  )
}

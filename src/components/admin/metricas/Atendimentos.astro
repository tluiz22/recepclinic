---
// Métricas › Atendimentos (Fase 9 "Relatórios"; virou aba de Métricas na
// Fase 23 · etapa 4, com o seletor de período): volume, não comparecimento
// e agendamentos por origem. Tabelas simples, sem gráfico.
import { createClient } from "../../../lib/supabase/server";
import { AUTHORSHIP_COLUMNS, describeAuthorship, fetchStaffLabels, type AuthorshipRow } from "../../../lib/authorship";
import { formatPercent } from "../../../lib/metrics/data";
import type { MetricsPeriod } from "../../../lib/metrics/period";
import { appointmentColumns, scopeAppointments, type MetricsFilter } from "../../../lib/metrics/filter";

interface Props {
  period: MetricsPeriod;
  filter: MetricsFilter | null;
}

const { period, filter } = Astro.props;
const supabase = createClient(Astro.request, Astro.cookies);

interface Row {
  appointment_type: "first_visit" | "return_visit" | "exam";
  status: string;
  clinic_locations: { type: string } | { type: string }[] | null;
}

const { data } = await scopeAppointments(
  supabase
    .from("appointments")
    .select(appointmentColumns("appointment_type, status, clinic_locations ( type )", filter))
    .gte("scheduled_at", period.start.toISOString())
    .lt("scheduled_at", period.end.toISOString()),
  filter
);

const rows = (data ?? []) as unknown as Row[];

function locationType(row: Row): string | undefined {
  const location = Array.isArray(row.clinic_locations) ? row.clinic_locations[0] : row.clinic_locations;
  return location?.type;
}

// Volume do período: quebrado por tipo × local, exclui cancelado (não ocupou
// de fato a agenda). Conta o que ainda está scheduled/confirmed se o
// período não terminou — fácil de restringir a completed/no_show depois,
// se preferir.
const volumeCategories = [
  { label: "Consulta – Consultório", match: (r: Row) => r.appointment_type === "first_visit" && locationType(r) === "clinic" },
  { label: "Consulta – Domiciliar", match: (r: Row) => r.appointment_type === "first_visit" && locationType(r) === "home_visit" },
  { label: "Retorno – Consultório", match: (r: Row) => r.appointment_type === "return_visit" && locationType(r) === "clinic" },
  { label: "Retorno – Domiciliar", match: (r: Row) => r.appointment_type === "return_visit" && locationType(r) === "home_visit" },
  { label: "Exame", match: (r: Row) => r.appointment_type === "exam" },
];

const nonCanceledRows = rows.filter((r) => r.status !== "canceled");
const volumeRows = volumeCategories.map((category) => ({
  label: category.label,
  count: nonCanceledRows.filter(category.match).length,
}));
const volumeTotal = nonCanceledRows.length;

// Taxa de não comparecimento: só entre desfechos já decididos (completed/no_show).
function noShowRate(matching: Row[]): { completed: number; noShow: number; rate: number | null } {
  const completed = matching.filter((r) => r.status === "completed").length;
  const noShow = matching.filter((r) => r.status === "no_show").length;
  const decided = completed + noShow;
  return { completed, noShow, rate: decided > 0 ? noShow / decided : null };
}

const noShowCategories = [
  { label: "Consulta", rows: rows.filter((r) => r.appointment_type === "first_visit") },
  { label: "Retorno", rows: rows.filter((r) => r.appointment_type === "return_visit") },
  { label: "Exame", rows: rows.filter((r) => r.appointment_type === "exam") },
];

const noShowRows = noShowCategories.map((category) => ({
  label: category.label,
  ...noShowRate(category.rows),
}));
const noShowTotalRow = { label: "Total geral", ...noShowRate(rows) };

// Por origem (Fase 17): quem marcou/remarcou/cancelou no período — conta pela
// data em que a AÇÃO aconteceu (created_at/rescheduled_at/canceled_at),
// não pela data do atendimento. Remarcação conta só a última de cada
// atendimento (é o que fica registrado).
const [{ data: createdData }, { data: rescheduledData }, { data: canceledData }, staffLabels] = await Promise.all([
  scopeAppointments(
    supabase
      .from("appointments")
      .select(appointmentColumns(AUTHORSHIP_COLUMNS, filter))
      .gte("created_at", period.start.toISOString())
      .lt("created_at", period.end.toISOString()),
    filter
  ),
  scopeAppointments(
    supabase
      .from("appointments")
      .select(appointmentColumns(AUTHORSHIP_COLUMNS, filter))
      .gte("rescheduled_at", period.start.toISOString())
      .lt("rescheduled_at", period.end.toISOString()),
    filter
  ),
  scopeAppointments(
    supabase
      .from("appointments")
      .select(appointmentColumns(AUTHORSHIP_COLUMNS, filter))
      .gte("canceled_at", period.start.toISOString())
      .lt("canceled_at", period.end.toISOString()),
    filter
  ),
  fetchStaffLabels(supabase),
]);

const ORIGIN_ORDER = ["WhatsApp", "Secretária", "Médica", "Tela (usuário não registrado)"];
const originCounts = new Map<string, { created: number; rescheduled: number; canceled: number }>(
  ORIGIN_ORDER.map((origin) => [origin, { created: 0, rescheduled: 0, canceled: 0 }])
);

function countOrigin(rowsToCount: AuthorshipRow[] | null, key: "createdBy" | "rescheduledBy" | "canceledBy") {
  const field = key === "createdBy" ? "created" : key === "rescheduledBy" ? "rescheduled" : "canceled";
  for (const row of rowsToCount ?? []) {
    const origin = describeAuthorship(row, staffLabels)[key];
    if (!origin) continue;
    if (!originCounts.has(origin)) originCounts.set(origin, { created: 0, rescheduled: 0, canceled: 0 });
    originCounts.get(origin)![field] += 1;
  }
}

countOrigin(createdData as AuthorshipRow[] | null, "createdBy");
countOrigin(rescheduledData as AuthorshipRow[] | null, "rescheduledBy");
countOrigin(canceledData as AuthorshipRow[] | null, "canceledBy");

const originRows = [...originCounts.entries()].map(([label, counts]) => ({ label, ...counts }));
const originTotalRow = originRows.reduce(
  (total, row) => ({
    created: total.created + row.created,
    rescheduled: total.rescheduled + row.rescheduled,
    canceled: total.canceled + row.canceled,
  }),
  { created: 0, rescheduled: 0, canceled: 0 }
);
---

<h2 class="mt-6 text-base font-semibold text-slate-900">Volume de atendimentos</h2>
<p class="mt-1 text-sm text-slate-500">Com data no período, sem os cancelados.</p>
<div class="mt-3 rounded-lg border border-slate-200 bg-white shadow-sm">
  <table class="w-full table-fixed border-collapse text-left text-xs sm:text-sm">
    <thead class="bg-slate-50 text-slate-600">
      <tr>
        <th class="px-2 py-2 font-medium">Tipo</th>
        <th class="w-20 px-2 py-2 text-right font-medium sm:w-28">Qtd.</th>
      </tr>
    </thead>
    <tbody>
      {
        volumeRows.map((row) => (
          <tr class="border-t border-slate-200">
            <td class="px-2 py-2">{row.label}</td>
            <td class="px-2 py-2 text-right">{row.count}</td>
          </tr>
        ))
      }
      <tr class="border-t border-slate-200 font-semibold text-slate-900">
        <td class="px-2 py-2">Total</td>
        <td class="px-2 py-2 text-right">{volumeTotal}</td>
      </tr>
    </tbody>
  </table>
</div>

<h2 class="mt-8 text-base font-semibold text-slate-900">Taxa de não comparecimento</h2>
<p class="mt-1 text-sm text-slate-500">
  Só considera atendimentos já com desfecho decidido (Realizada ou Não compareceu).
</p>
<div class="mt-3 rounded-lg border border-slate-200 bg-white shadow-sm">
  <table class="w-full table-fixed border-collapse text-left text-xs sm:text-sm">
    <thead class="bg-slate-50 text-slate-600">
      <tr>
        <th class="w-[40%] px-1.5 py-2 font-medium">Tipo</th>
        <th class="w-[20%] px-1.5 py-2 text-right font-medium">Realiz.</th>
        <th class="w-[20%] px-1.5 py-2 text-right font-medium">Faltou</th>
        <th class="w-[20%] px-1.5 py-2 text-right font-medium">Taxa</th>
      </tr>
    </thead>
    <tbody>
      {
        noShowRows.map((row) => (
          <tr class="border-t border-slate-200">
            <td class="px-1.5 py-2">{row.label}</td>
            <td class="px-1.5 py-2 text-right">{row.completed}</td>
            <td class="px-1.5 py-2 text-right">{row.noShow}</td>
            <td class="px-1.5 py-2 text-right">{formatPercent(row.rate)}</td>
          </tr>
        ))
      }
      <tr class="border-t border-slate-200 font-semibold text-slate-900">
        <td class="px-1.5 py-2">{noShowTotalRow.label}</td>
        <td class="px-1.5 py-2 text-right">{noShowTotalRow.completed}</td>
        <td class="px-1.5 py-2 text-right">{noShowTotalRow.noShow}</td>
        <td class="px-1.5 py-2 text-right">{formatPercent(noShowTotalRow.rate)}</td>
      </tr>
    </tbody>
  </table>
</div>

<h2 class="mt-8 text-base font-semibold text-slate-900">Agendamentos por origem</h2>
<p class="mt-1 text-sm text-slate-500">
  Quem marcou, remarcou e cancelou no período (pela data da ação, não do atendimento).
</p>
<div class="mt-3 rounded-lg border border-slate-200 bg-white shadow-sm">
  <table class="w-full table-fixed border-collapse text-left text-xs sm:text-sm">
    <thead class="bg-slate-50 text-slate-600">
      <tr>
        <th class="w-[40%] px-1.5 py-2 font-medium">Origem</th>
        <th class="w-[20%] px-1.5 py-2 text-right font-medium">Marcou</th>
        <th class="w-[20%] px-1.5 py-2 text-right font-medium">Remarcou</th>
        <th class="w-[20%] px-1.5 py-2 text-right font-medium">Cancelou</th>
      </tr>
    </thead>
    <tbody>
      {
        originRows.map((row) => (
          <tr class="border-t border-slate-200">
            <td class="px-1.5 py-2">{row.label}</td>
            <td class="px-1.5 py-2 text-right">{row.created}</td>
            <td class="px-1.5 py-2 text-right">{row.rescheduled}</td>
            <td class="px-1.5 py-2 text-right">{row.canceled}</td>
          </tr>
        ))
      }
      <tr class="border-t border-slate-200 font-semibold text-slate-900">
        <td class="px-1.5 py-2">Total</td>
        <td class="px-1.5 py-2 text-right">{originTotalRow.created}</td>
        <td class="px-1.5 py-2 text-right">{originTotalRow.rescheduled}</td>
        <td class="px-1.5 py-2 text-right">{originTotalRow.canceled}</td>
      </tr>
    </tbody>
  </table>
</div>

---
// Métricas › Retomar contato (Fase 15 "Não concluíram"; aba própria na Fase
// 23 · etapa 4): abandonos e erros do período, para a equipe retomar o
// contato. Sai da lista quem concluiu o mesmo fluxo depois.
import PhoneLinks from "../PhoneLinks.astro";
import Card from "../Card.astro";
import Badge from "../Badge.astro";
import { createClient } from "../../../lib/supabase/server";
import { buildFunnelReport } from "../../../lib/metrics/whatsappFunnel";
import { fetchFunnelEvents, formatDateTime } from "../../../lib/metrics/data";
import type { MetricsPeriod } from "../../../lib/metrics/period";

interface Props {
  period: MetricsPeriod;
}

const { period } = Astro.props;
const supabase = createClient(Astro.request, Astro.cookies);

const events = await fetchFunnelEvents(supabase, period.start, period.end);
const report = buildFunnelReport(events, period.start, period.end);

const LIMIT = 50;
const incomplete = report.incomplete.slice(0, LIMIT);

// Nome do responsável (quando já cadastrado).
const guardianIds = [...new Set(incomplete.map((row) => row.guardianId).filter((id): id is string => !!id))];
const { data: guardianRows } = guardianIds.length
  ? await supabase.from("guardians").select("id, full_name").in("id", guardianIds)
  : { data: [] };
const guardianNames = new Map((guardianRows ?? []).map((row) => [row.id as string, row.full_name as string]));
---

<p class="mt-6 text-sm text-slate-500">
  Quem começou pelo WhatsApp e não concluiu no período (abandono ou erro), para retomar o contato. Sai da lista quem
  concluiu o mesmo fluxo depois.
  {report.incomplete.length > LIMIT && ` Mostrando os ${LIMIT} mais recentes.`}
</p>

{
  incomplete.length === 0 ? (
    <p class="mt-3 text-sm text-slate-500">Ninguém nessa situação no período.</p>
  ) : (
    <div class="mt-3 grid gap-3 sm:grid-cols-2">
      {incomplete.map((row) => (
        <Card>
          <div class="flex items-start justify-between gap-2">
            <div>
              <p class="font-medium text-slate-900">
                {(row.guardianId && guardianNames.get(row.guardianId)) || "Responsável sem cadastro"}
              </p>
              <PhoneLinks phone={row.guardianPhone} class="text-sm" />
            </div>
            <Badge variant="info">{row.flowLabel}</Badge>
          </div>
          <p class="mt-2 text-sm text-slate-600">
            Última etapa: <span class="font-medium text-slate-800">{row.lastStage}</span>
          </p>
          <p class="text-sm text-slate-600">{row.detail}</p>
          <p class="mt-1 text-xs text-slate-400">Iniciou em {formatDateTime(row.startedAt)}</p>
        </Card>
      ))}
    </div>
  )
}

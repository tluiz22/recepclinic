---
// Métricas › Faltosos (Fase 23 · etapa 7): pacientes com 2 ou mais "Não
// compareceu" e faltas em pelo menos metade dos atendimentos registrados, em
// todo o histórico (não usa o período). Mais faltas primeiro. O mesmo selo
// aparece na Agenda e em Pacientes, para a secretária.
import Card from "../Card.astro";
import Badge from "../Badge.astro";
import PhoneLinks from "../PhoneLinks.astro";
import { createClient } from "../../../lib/supabase/server";
import { fetchFrequentNoShows, noShowLabel } from "../../../lib/noShow";

const supabase = createClient(Astro.request, Astro.cookies);

const frequent = await fetchFrequentNoShows(supabase);

interface PatientInfo {
  id: string;
  full_name: string;
  guardian_id: string;
  is_active: boolean;
  guardians: { full_name: string; phone: string | null } | null;
}

const patients = new Map<string, PatientInfo>();
const ids = frequent.map((row) => row.patientId);
for (let index = 0; index < ids.length; index += 150) {
  const { data } = await supabase
    .from("patients")
    .select("id, full_name, guardian_id, is_active, guardians ( full_name, phone )")
    .in("id", ids.slice(index, index + 150));
  for (const row of (data ?? []) as unknown as PatientInfo[]) patients.set(row.id, row);
}

function formatDay(iso: string | null): string {
  if (!iso) return "—";
  return new Intl.DateTimeFormat("pt-BR", {
    timeZone: "America/Fortaleza",
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  }).format(new Date(iso));
}

const rows = frequent.map(({ patientId, stats }) => {
  const patient = patients.get(patientId);
  return {
    key: patientId,
    patientName: patient?.full_name ?? "Paciente não encontrado",
    inactive: patient ? !patient.is_active : false,
    guardianName: patient?.guardians?.full_name ?? "—",
    phone: patient?.guardians?.phone ?? null,
    label: noShowLabel(stats),
    lastNoShow: formatDay(stats.lastNoShowAt),
    historyHref: patient ? `/admin/pacientes/${patient.guardian_id}/criancas/${patient.id}/historico` : null,
  };
});
---

<p class="mt-6 text-sm text-slate-600">
  Pacientes com <strong>2 ou mais faltas</strong> que faltaram em <strong>pelo menos metade</strong> dos atendimentos
  com comparecimento registrado (Realizada ou Não compareceu), em todo o histórico. O selo "Faltou X de Y" também
  aparece na Agenda e em Pacientes.
</p>

{
  rows.length === 0 ? (
    <p class="mt-4 text-sm text-slate-500">Nenhum paciente nessa situação.</p>
  ) : (
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      {rows.map((row) => (
        <Card>
          <div class="flex items-start justify-between gap-2">
            <div>
              <p class="font-medium text-slate-900">
                {row.patientName}
                {row.inactive && (
                  <Badge variant="neutral" class="ml-2 align-middle">
                    Inativo
                  </Badge>
                )}
              </p>
              <p class="text-sm text-slate-600">Responsável: {row.guardianName}</p>
            </div>
            <Badge variant="danger">{row.label}</Badge>
          </div>
          <p class="mt-2 text-sm text-slate-600">Última falta: {row.lastNoShow}</p>
          {row.phone ? (
            <PhoneLinks phone={row.phone} class="mt-3 text-sm" />
          ) : (
            <p class="mt-3 text-sm text-slate-500">Sem telefone cadastrado.</p>
          )}
          {row.historyHref && (
            <a
              href={row.historyHref}
              class="mt-3 block border-t border-slate-100 pt-2 text-xs text-slate-500 hover:text-sky-700 hover:underline"
            >
              Ver histórico do paciente
            </a>
          )}
        </Card>
      ))}
    </div>
  )
}

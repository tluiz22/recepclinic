---
// Tabela simples das Métricas (F4.9): cabeçalho e linhas, sem gráfico
// (decisão do cliente no piloto). A última linha pode vir em negrito (total).
interface Props {
  headers: string[];
  rows: (string | number)[][];
  boldLast?: boolean;
  empty?: string;
}

const { headers, rows, boldLast = false, empty = "Nada no período." } = Astro.props;
---

<div class="mt-2 overflow-x-auto rounded-lg border border-slate-200 bg-white">
  <table class="w-full text-sm">
    <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
      <tr>
        {headers.map((h, i) => <th class={`px-3 py-2 font-medium ${i > 0 ? "text-right" : ""}`}>{h}</th>)}
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      {
        rows.map((row, r) => (
          <tr class={boldLast && r === rows.length - 1 ? "font-semibold text-slate-900" : "text-slate-700"}>
            {row.map((cell, i) => (
              <td class={`px-3 py-2 ${i > 0 ? "text-right tabular-nums" : ""}`}>{cell}</td>
            ))}
          </tr>
        ))
      }
      {
        rows.length === 0 && (
          <tr>
            <td colspan={headers.length} class="px-3 py-3 text-center text-slate-500">
              {empty}
            </td>
          </tr>
        )
      }
    </tbody>
  </table>
</div>

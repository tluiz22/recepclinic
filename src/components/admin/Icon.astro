---

<svg
  xmlns="http://www.w3.org/2000/svg"
  fill="none"
  viewBox="0 0 24 24"
  stroke-width={strokeWidth}
  stroke="currentColor"
  class={className}
  aria-hidden="true"
>
  <path stroke-linecap="round" stroke-linejoin="round" d={paths[name]}></path>
</svg>

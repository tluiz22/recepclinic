---
// Resultado do "Reenviar lembrete" (Fase 22 · etapa 6), lido de `?reenvio=`.
import { RESEND_MESSAGES, parseResendOutcome } from "../../lib/reminderResend";

const outcome = parseResendOutcome(Astro.url.searchParams.get("reenvio"));
const message = outcome ? RESEND_MESSAGES[outcome] : null;
---

{
  message && (
    <p
      class={`mt-4 rounded-lg border px-3 py-2 text-sm ${
        message.ok ? "border-emerald-200 bg-emerald-50 text-emerald-800" : "border-amber-200 bg-amber-50 text-amber-800"
      }`}
    >
      {message.text}
    </p>
  )
}

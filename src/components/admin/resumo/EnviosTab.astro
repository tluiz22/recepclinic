---
// Resumo do Dia › Envios (F4.8; cliente, 05/out/2026: no Resumo do Dia, para
// toda a equipe; o Profissional vê só as próprias agendas): se os envios
// automáticos rodaram e quais atendimentos por vir têm envio com falha. Sem
// botão de reenvio aqui: cada atendimento leva à Agenda do dia, onde ficam
// "Enviar/Reenviar lembrete" e "Reenviar preparo" (como no piloto).
// Redesign R3 (15/out/2026): aviso no topo e selos no padrão novo.
import Icon from "../Icon.astro";
import Pill, { type PillTone } from "../ui/Pill.astro";
import HelpTip from "../ui/HelpTip.astro";
import { resumo } from "../../../lib/ajuda/resumo";
import { formatInstant, localDateOf } from "../../../lib/clinicTime";
import { jobRunState, type JobRun, type AppointmentWithFailedSends, type JobRunState } from "../../../lib/data/sends";
import { MAX_ATTEMPTS } from "../../../lib/data/whatsapp/retryRules";

import ServiceTag, { type ServiceTagInfo } from "../agenda/ServiceTag.astro";
import { serviceBesideCategory } from "../agenda/categoryStyle";
interface Props {
  alerts: string[];
  runs: JobRun[];
  failed: AppointmentWithFailedSends[];
  timeZone: string;
  /** Tipo e cor de cada serviço, para a etiqueta do tipo (cliente, 19/out/2026). */
  tags: Map<string, ServiceTagInfo>;
}

const { alerts, runs, failed, timeZone, tags } = Astro.props;
const now = new Date();
const JOB_LABELS: Record<string, string> = {
  appointment_reminders: "Lembretes",
  daily_summary: "Resumo do dia",
  waitlist_offers: "Ofertas da lista de espera",
};
const STATE: Record<JobRunState, { label: string; tone: PillTone }> = {
  ok: { label: "Rodou", tone: "success" },
  error: { label: "Erro", tone: "danger" },
  running: { label: "Rodando", tone: "info" },
  stuck: { label: "Travou", tone: "danger" },
};
const BOX = "overflow-hidden rounded-xl border border-line bg-white";
const BOX_HEAD = "border-b border-line bg-[#f8faf9] px-4 py-3";
const BOX_TITLE = "text-[15px] font-bold text-ink";
---

<div class="mt-4 flex flex-col gap-4">
  {
    alerts.length > 0 && (
      <div role="status" class="flex max-w-4xl items-start gap-2.5 rounded-[10px] border border-can-200 bg-can-50 px-3.5 py-3 text-[15px] text-can-800">
        <Icon name="warning" class="mt-0.5 h-[18px] w-[18px] shrink-0" strokeWidth={2} />
        <ul class="flex flex-col gap-0.5">
          {alerts.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </div>
    )
  }

  <div class="grid items-start gap-4 xl:grid-cols-2">
    <section class={BOX} aria-labelledby="envios-falha">
      <div class={BOX_HEAD}>
        <HelpTip subject="Envios com falha" text={resumo.dicas.enviosFalha} id="envios-falha-ajuda">
          <h2 id="envios-falha" class={BOX_TITLE}>Atendimentos com envio com falha ({failed.length})</h2>
        </HelpTip>
      </div>
      <ul class="divide-y divide-[#e6ecea] px-4">
        {
          failed.map((a) => (
            <li class="flex flex-wrap items-center justify-between gap-2 py-3">
              <a href={`/admin/agenda?date=${localDateOf(a.scheduledAt, timeZone)}`} class="flex min-w-0 flex-col gap-0.5 no-underline">
                <span class="text-[15px] font-semibold text-ink hover:text-brand hover:underline">
                  <span class="capitalize">{formatInstant(a.scheduledAt, timeZone, "EEE dd/MM HH:mm")}</span> · {a.patientName}
                </span>
                <span class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-sm text-ink-soft">
                  <ServiceTag info={tags.get(a.serviceId)} />
                  {(() => {
                    const category = tags.get(a.serviceId)?.category;
                    return category ? serviceBesideCategory(a.serviceName, category) : a.serviceName;
                  })()}
                </span>
              </a>
              <span class="flex flex-wrap gap-1.5">
                {a.retrying.map((attempt) => (
                  <Pill tone="info">{`Tentando de novo (${attempt} de ${MAX_ATTEMPTS})`}</Pill>
                ))}
                {a.failedSends > 0 && <Pill tone="danger">{`${a.failedSends} ${a.failedSends === 1 ? "envio com falha" : "envios com falha"}`}</Pill>}
              </span>
            </li>
          ))
        }
        {failed.length === 0 && <li class="py-3 text-sm text-ink-soft">Nenhum.</li>}
      </ul>
    </section>

    <section class={BOX} aria-labelledby="envios-execucoes">
      <div class={BOX_HEAD}>
        <HelpTip subject="Envios automáticos" text={resumo.dicas.enviosRotinas} id="envios-rotinas">
          <h2 id="envios-execucoes" class={BOX_TITLE}>Quando os envios automáticos rodaram</h2>
        </HelpTip>
      </div>
      <ul class="divide-y divide-[#e6ecea] px-4">
        {
          runs.map((run) => {
            const state = STATE[jobRunState(run, now)];
            return (
              <li class="flex flex-wrap items-center justify-between gap-2 py-3">
                <span class="flex flex-col gap-0.5">
                  <span class="text-[15px] font-semibold text-ink">{JOB_LABELS[run.job] ?? run.job}</span>
                  <span class="text-sm text-ink-soft">
                    {formatInstant(run.startedAt, timeZone, "dd/MM/yyyy HH:mm")}
                    {run.trigger === "manual" ? " · manual" : ""}
                  </span>
                </span>
                <Pill tone={state.tone}>{state.label}</Pill>
              </li>
            );
          })
        }
        {runs.length === 0 && <li class="py-3 text-sm text-ink-soft">Nenhum registro ainda.</li>}
      </ul>
    </section>
  </div>
</div>

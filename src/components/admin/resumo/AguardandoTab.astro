---
// Resumo do Dia › Aguardando remarcação (F4.8; cliente, 05/out/2026, como no
// piloto): cancelados pela clínica (em massa ou pelo bloqueio) que ainda não
// remarcaram. "Remarcar" abre o Marcar com o paciente, o serviço e a agenda;
// "Desistiu" tira da lista (com confirmação; fica na trilha). Redesign R3
// (15/out/2026): Remarcar em destaque e Desistiu à parte, em vermelho.
import { currentPath, withReturn } from "../../../lib/returnPath";
import PhoneLinks from "../PhoneLinks.astro";
import Button from "../ui/Button.astro";
import { formatInstant } from "../../../lib/clinicTime";
import type { AgendaAppointment } from "../../../lib/data/agenda/view";
import { actorText, type ActorLabel } from "../../../lib/data/agenda/trail";
import { capitalize, type Vocabulary } from "../../../lib/vocabulary";

import ServiceTag, { type ServiceTagInfo } from "../agenda/ServiceTag.astro";
import { serviceBesideCategory } from "../agenda/categoryStyle";
interface Props {
  appointments: AgendaAppointment[];
  actors: Map<string, ActorLabel>;
  timeZone: string;
  vocabulary: Vocabulary;
  /** Tipo e cor de cada serviço, para a etiqueta do tipo (cliente, 19/out/2026). */
  tags: Map<string, ServiceTagInfo>;
  /** Para onde o "Desistiu" volta (CRM A1: a mesma aba no Relacionamento). */
  returnTo?: string;
}

const { appointments, actors, timeZone, vocabulary, tags, returnTo = "/admin/consultas?tab=aguardando_remarcacao" } = Astro.props;
---

<p class="mt-4 text-[15px] text-ink-soft">
  Cancelados pela clínica que ainda não remarcaram. Saem da lista sozinhos quando remarcam.
</p>
{
  appointments.length > 0 && (
    <ul class="mt-3 max-w-4xl divide-y divide-[#e6ecea] rounded-xl border border-line bg-white px-4">
      {appointments.map((a) => {
        const by = a.canceledBy ? actorText(actors.get(a.canceledBy)) : null;
        return (
          <li class="flex flex-col gap-3 py-3.5 sm:flex-row sm:items-start sm:justify-between">
            <div class="flex min-w-0 flex-col gap-0.5">
              <a href={withReturn(`/admin/pacientes/${a.patientId}`, currentPath(Astro.url))} class="text-base font-semibold text-ink no-underline hover:text-brand hover:underline">
                {a.patientName}
              </a>
              <span class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-[15px] text-ink-soft sm:text-sm">
                <ServiceTag info={tags.get(a.serviceId)} />
                {[serviceBesideCategory(a.serviceName, a.category), a.agendaName, `era ${formatInstant(a.scheduledAt, timeZone, "EEE dd/MM 'às' HH:mm")}`].filter(Boolean).join(" · ")}
              </span>
              <span class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-[15px] text-ink-soft sm:text-sm">
                {!a.isContactSelf && `${capitalize(vocabulary.contact)}: ${a.contactName} · `}
                <PhoneLinks phone={a.contactPhone} plain />
              </span>
              {a.canceledAt && (
                <span class="text-[13px] text-ink-soft">
                  Cancelado em {formatInstant(a.canceledAt, timeZone, "dd/MM 'às' HH:mm")}
                  {by ? ` por ${by}` : ""}
                </span>
              )}
            </div>
            <div class="flex shrink-0 items-center justify-between gap-2 sm:flex-col sm:items-end">
              <Button variant="primary" size="sm" href={withReturn(`/admin/agenda/marcar?patient_id=${a.patientId}&service_id=${a.serviceId}&agenda_id=${a.agendaId}`, returnTo)}>
                Remarcar
              </Button>
              <form method="POST" action={`/api/admin/agenda/atendimentos/${a.id}`} class="contents">
                <input type="hidden" name="acao" value="desistiu" />
                <input type="hidden" name="return_to" value={returnTo} />
                <Button
                  type="submit"
                  size="sm"
                  variant="danger-quiet"
                  class="js-confirm-delete"
                  data-confirm-title="Marcar como desistiu?"
                  data-confirm-message={`${a.patientName} sai desta lista (a clínica para de acompanhar a remarcação). Fica registrado na trilha.`}
                  data-confirm-label="Desistiu"
                >
                  Desistiu
                </Button>
              </form>
            </div>
          </li>
        );
      })}
    </ul>
  )
}
{appointments.length === 0 && <p class="mt-3 rounded-xl border border-dashed border-line-strong px-3 py-5 text-center text-[15px] text-ink-soft">Ninguém aguardando remarcação.</p>}

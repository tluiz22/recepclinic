---
// Resumo do Dia › Lista de espera (F4.8; item "Lista de espera"): quem
// espera para antecipar, por agenda e serviço, na ordem em que a vaga é
// oferecida (ordem de entrada), com a oferta em andamento e "Tirar da lista"
// (com confirmação); abaixo, as últimas ofertas. Redesign R3 (15/out/2026).
// "Como funciona?" e lista vazia explicada (ajuda contextual, 23/out/2026).
import { currentPath, withReturn } from "../../../lib/returnPath";
import PhoneLinks from "../PhoneLinks.astro";
import Button from "../ui/Button.astro";
import Pill, { type PillTone } from "../ui/Pill.astro";
import Signal from "../ui/Signal.astro";
import EmptyState from "../ui/EmptyState.astro";
import HowItWorks from "../ui/HowItWorks.astro";
import { resumo } from "../../../lib/ajuda/resumo";
import { formatInstant } from "../../../lib/clinicTime";
import type { OfferHistoryItem, OfferStatus, WaitlistEntry } from "../../../lib/data/waitlist/entries";

import ServiceTag, { type ServiceTagInfo } from "../agenda/ServiceTag.astro";
interface Props {
  entries: WaitlistEntry[];
  offers: OfferHistoryItem[];
  timeZone: string;
  /** Tipo e cor de cada serviço, para a etiqueta do tipo (cliente, 19/out/2026). */
  tags: Map<string, ServiceTagInfo>;
  /** Para onde o "Tirar da lista" volta (CRM A1: a mesma aba no Relacionamento). */
  returnTo?: string;
}

const { entries, offers, timeZone, tags, returnTo = "/admin/consultas?tab=lista_espera" } = Astro.props;
const when = (d: Date) => formatInstant(d, timeZone, "EEE dd/MM 'às' HH:mm");
const groups = new Map<string, WaitlistEntry[]>();
for (const entry of entries) {
  const key = `${entry.appointment.agendaName} · ${entry.appointment.serviceName}`;
  groups.set(key, [...(groups.get(key) ?? []), entry]);
}
// Serviço de cada grupo, para a etiqueta do tipo no título (cliente, 19/out/2026).
const serviceOf = (list: WaitlistEntry[]) => list[0].appointment.serviceId;
const offerStatus: Record<OfferStatus, { label: string; tone: PillTone }> = {
  pending: { label: "Aguardando resposta", tone: "warning" },
  accepted: { label: "Aceitou", tone: "success" },
  declined: { label: "Recusou", tone: "neutral" },
  expired: { label: "Venceu", tone: "neutral" },
  withdrawn: { label: "Retirada", tone: "neutral" },
  skipped: { label: "Pulada", tone: "neutral" },
};
const BOX = "overflow-hidden rounded-xl border border-line bg-white";
const BOX_TITLE = "flex flex-wrap items-center justify-between gap-2 border-b border-line bg-[#f8faf9] px-4 py-3 text-[15px] font-bold text-ink";
---

<HowItWorks id="lista-espera" topic={resumo.comoFunciona.listaEspera} class="mt-4">
  <p class="text-[15px] text-ink-soft">Na ordem de entrada, por agenda e serviço.</p>
</HowItWorks>

<div class="mt-4 grid items-start gap-4 xl:grid-cols-2">
  <div class="flex min-w-0 flex-col gap-4">
    {
      [...groups].map(([title, list]) => (
        <section class={BOX} aria-label={title}>
          <h2 class={BOX_TITLE}>
            <span class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1">
              <ServiceTag info={tags.get(serviceOf(list))} />
              {title}
            </span>
            <span class="text-[13px] font-medium text-ink-soft">{list.length} na lista</span>
          </h2>
          <ol class="divide-y divide-[#e6ecea] px-4">
            {list.map((entry, index) => (
              <li class="flex flex-wrap items-start justify-between gap-3 py-3">
                <div class="flex min-w-0 gap-3">
                  <span class="w-7 shrink-0 font-display text-lg leading-tight font-bold text-brand">{index + 1}º</span>
                  <div class="flex min-w-0 flex-col gap-0.5">
                    <a href={withReturn(`/admin/pacientes/${entry.patient.id}`, currentPath(Astro.url))} class="text-base font-semibold text-ink no-underline hover:text-brand hover:underline">
                      {entry.patient.fullName}
                    </a>
                    <span class="text-sm text-ink-soft">
                      Marcado para {when(entry.appointment.scheduledAt)} · {entry.appointment.locationName}
                    </span>
                    <span class="text-sm text-ink-soft">
                      <PhoneLinks phone={entry.contact.phone} plain />
                    </span>
                    {entry.pendingOffer && (
                      <Signal tone="warning" icon="clock">
                        Oferta: {when(entry.pendingOffer.slotStart)} (vence {formatInstant(entry.pendingOffer.expiresAt, timeZone, "dd/MM HH:mm")})
                      </Signal>
                    )}
                  </div>
                </div>
                <form method="POST" action={`/api/admin/agenda/atendimentos/${entry.appointment.id}`} class="contents">
                  <input type="hidden" name="acao" value="sair_lista_espera" />
                  <input type="hidden" name="return_to" value={returnTo} />
                  <Button
                    type="submit"
                    size="sm"
                    variant="danger-quiet"
                    class="js-confirm-delete"
                    data-confirm-title="Tirar da lista de espera?"
                    data-confirm-message={`${entry.patient.fullName}: deixa de receber oferta de horário antes.`}
                    data-confirm-label="Tirar da lista"
                  >
                    Tirar da lista
                  </Button>
                </form>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
    {entries.length === 0 && <EmptyState variant="dashed" title={resumo.vazios.listaEspera.titulo} text={resumo.vazios.listaEspera.texto} />}
  </div>

  <section class={BOX} aria-labelledby="ultimas-ofertas">
    <h2 id="ultimas-ofertas" class={BOX_TITLE}>Últimas ofertas</h2>
    <ul class="divide-y divide-[#e6ecea] px-4">
      {
        offers.map((offer) => (
          <li class="flex flex-wrap items-center justify-between gap-2 py-3">
            <span class="flex min-w-0 flex-col gap-0.5">
              <span class="text-[15px] font-semibold text-ink">{offer.patientName}</span>
              <span class="text-sm text-ink-soft">
                Vaga de {when(offer.slotStart)} · oferecida {formatInstant(offer.offeredAt, timeZone, "dd/MM HH:mm")}
                {offer.reason ? ` · ${offer.reason}` : ""}
              </span>
            </span>
            <Pill tone={offerStatus[offer.status].tone}>{offerStatus[offer.status].label}</Pill>
          </li>
        ))
      }
      {offers.length === 0 && <li class="py-3 text-sm text-ink-soft">Nenhuma oferta ainda.</li>}
    </ul>
  </section>
</div>

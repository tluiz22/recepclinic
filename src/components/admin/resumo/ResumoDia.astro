---
// Resumo do Dia › Resumo do dia (F4.8): só informação, como no piloto desde
// 03/out/2026 (as ações ficam na Agenda): hora, paciente, idade, responsável,
// telefone, serviço, local, agenda, presença confirmada e quem marcou.
// Redesign R3 (cliente, 15/out/2026): legenda com contadores e, no
// computador, uma linha por atendimento; no celular, um cartão por atendimento.
import { currentPath, withReturn } from "../../../lib/returnPath";
import { CANCELED_TEXT, appointmentSituation } from "../agenda/situationStyle";
import HowItWorks from "../ui/HowItWorks.astro";
import { agenda as ajudaAgenda } from "../../../lib/ajuda/agenda";
import StatusPill from "../ui/StatusPill.astro";
import ServiceTag, { type ServiceTagInfo } from "../agenda/ServiceTag.astro";
import { serviceBesideCategory } from "../agenda/categoryStyle";
import { formatInstant } from "../../../lib/clinicTime";
import type { AgendaAppointment } from "../../../lib/data/agenda/view";
import { actorText, type ActorLabel } from "../../../lib/data/agenda/trail";
import { confirmedByReminder } from "../../../lib/reminderResponse";
import type { Vocabulary } from "../../../lib/vocabulary";

interface Props {
  appointments: AgendaAppointment[];
  actors: Map<string, ActorLabel>;
  date: string;
  timeZone: string;
  vocabulary: Vocabulary;
  showAgenda: boolean;
  /** Tipo e cor de cada serviço, para a etiqueta do tipo (cliente, 19/out/2026). */
  tags: Map<string, ServiceTagInfo>;
}

const { appointments, actors, timeZone, tags } = Astro.props;
const now = new Date();
const VIA: Record<string, string> = { admin: "pelo painel", whatsapp_bot: "pelo WhatsApp", booking_link: "pelo link" };
const bookedBy = (a: AgendaAppointment) => {
  if (a.imported) return "Importado na implantação";
  const who = a.createdBy ? actorText(actors.get(a.createdBy)) : null;
  return `Marcado ${VIA[a.bookingChannel] ?? ""}${who ? ` por ${who}` : ""}`;
};
const active = appointments.filter((a) => a.status !== "canceled");
const canceled = appointments.filter((a) => a.status === "canceled");
// Presença: o "confirmo" do lembrete também grava a presença, por isso vem primeiro.
const presence = (a: AgendaAppointment) => {
  const isActive = a.status === "scheduled" || a.status === "confirmed";
  if (!isActive) return null;
  if (confirmedByReminder(a.reminderResponse)) return { label: "Confirmou pelo lembrete", tone: "success" as const, icon: "check" as const };
  if (a.patientConfirmedAt) return { label: "Presença confirmada", tone: "success" as const, icon: "check" as const };
  if (a.scheduledAt > now) return { label: "Presença não confirmada", tone: "warning" as const, icon: "clock" as const };
  return null;
};
const here = currentPath(Astro.url);
---

<HowItWorks id="situacoes" topic={ajudaAgenda.comoFunciona.situacoes} class="mt-1">
  <p class="text-[14.5px] text-ink-soft">Só informação: as ações de cada atendimento ficam na Agenda.</p>
</HowItWorks>
{
  appointments.length > 0 && (
    // Opção C do redesign do Relatório do dia (cliente, 02/nov/2026): uma linha curta por atendimento.
    <ul aria-label="Atendimentos do dia" class="mt-3 overflow-hidden rounded-xl border border-line bg-white">
      {[...active, ...canceled].map((a) => {
        const situation = appointmentSituation(a);
        const p = presence(a);
        const canceledRow = a.status === "canceled";
        return (
          <li class="flex flex-wrap items-center gap-x-3.5 gap-y-1.5 border-t border-[#e7eeeb] px-4 py-2.5 first:border-t-0 sm:px-[18px]">
            <strong class={`min-w-[52px] text-[15px] tabular-nums ${canceledRow ? CANCELED_TEXT : "text-ink"}`}>{formatInstant(a.scheduledAt, timeZone, "HH:mm")}</strong>
            <span class="min-w-0 flex-[1_1_240px] text-[15px]">
              <a href={withReturn(`/admin/pacientes/${a.patientId}`, here)} class={`font-bold no-underline hover:text-brand hover:underline ${canceledRow ? CANCELED_TEXT : "text-ink"}`}>{a.patientName}</a>
              <span class="text-ink-mid">
                {" · "}
                <ServiceTag info={tags.get(a.serviceId)} />
                {serviceBesideCategory(a.serviceName, a.category) && ` ${a.serviceName}`}
                {` · ${a.agendaName}`}
              </span>
              {p && p.tone === "success" && <span class="sr-only"> · {p.label}</span>}
            </span>
            <span class="min-w-[160px] text-[13.5px] text-ink-soft">{bookedBy(a).replace(/^Marcado /, "")}</span>
            <StatusPill situation={situation} />
          </li>
        );
      })}
    </ul>
  )
}
{
  appointments.length === 0 && (
    <p class="mt-3 rounded-xl border border-dashed border-line-strong px-3 py-5 text-center text-[15px] text-ink-soft">Nenhum atendimento neste dia.</p>
  )
}

---
// Escolha do serviço no Marcar (C6; cliente, 28/out/2026, opção B do canvas):
// botões do tipo (com quantos serviços tem cada um) e, do tipo aberto, os
// serviços em cartões com nome e duração (sem valor, decisão do cliente). Cada
// escolha é um link que recarrega a tela, como o resto do Marcar. A busca
// filtra os cartões no navegador e só aparece com mais de SEARCH_FROM serviços.
import { CATEGORY_LABELS } from "../../../lib/serviceLabels";
import { SEARCH_FROM, serviceTypes, type ServiceCategory } from "../../../lib/servicePicker";
import { CONTROL } from "../ui/styles";

type PickerService = { id: string; name: string; category: ServiceCategory; durationMinutes: number; schedulingMode: string };

interface Props {
  services: PickerService[];
  open: ServiceCategory | null;
  selectedId: string | null;
  typeHref: (category: ServiceCategory) => string;
  serviceHref: (service: PickerService) => string;
}

const { services, open, selectedId, typeHref, serviceHref } = Astro.props;
const types = serviceTypes(services);
const shown = open ? services.filter((s) => s.category === open) : [];
const plural: Record<ServiceCategory, string> = { consultation: "consultas", return_visit: "retornos", exam: "exames" };
const chip = (active: boolean) =>
  `inline-flex min-h-11 items-center gap-1 rounded-lg border px-3.5 text-[15px] font-semibold no-underline sm:min-h-10 ${
    active ? "border-brand bg-brand text-white" : "border-line-strong bg-white text-ink hover:border-brand"
  }`;
const card = (active: boolean) =>
  `flex min-h-11 flex-col gap-0.5 rounded-[10px] border no-underline hover:border-brand ${
    active ? "border-2 border-brand bg-[#e7f4ef] px-[13px] py-[9px]" : "border-line-strong bg-white px-3.5 py-2.5"
  }`;
---

<div class="flex flex-col gap-3" data-service-picker>
  <div role="group" aria-label="Tipo de atendimento" class="flex flex-wrap gap-2">
    {
      types.map((t) => (
        <a href={typeHref(t.category)} class={chip(t.category === open)} aria-current={t.category === open ? "true" : undefined}>
          {CATEGORY_LABELS[t.category]}
          <span class="font-medium opacity-80">· {t.count}</span>
        </a>
      ))
    }
  </div>
  {!open && <p class="text-[15px] text-ink-soft">Escolha o tipo de atendimento para ver os serviços.</p>}
  {
    open && shown.length > SEARCH_FROM && (
      <label class="flex flex-col gap-1 text-sm font-semibold text-ink">
        Buscar em {plural[open]}
        <input type="search" data-service-search placeholder="Digite parte do nome" class={`${CONTROL} w-full font-normal sm:max-w-[420px]`} />
      </label>
    )
  }
  {
    open && (
      <ul class="grid grid-cols-1 gap-2 sm:grid-cols-2" aria-label={`Serviços: ${plural[open]}`}>
        {shown.map((s) => (
          <li data-service-name={s.name.toLocaleLowerCase("pt-BR")}>
            <a href={serviceHref(s)} class={card(s.id === selectedId)} aria-current={s.id === selectedId ? "true" : undefined}>
              <span class="text-base leading-snug font-bold text-ink">{s.name}</span>
              <span class="text-sm text-ink-soft">
                {s.durationMinutes} min{s.schedulingMode === "group" ? " · turma" : ""}
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
  <p class="text-[15px] text-ink-soft" data-service-none hidden>Nenhum serviço com esse nome.</p>
</div>

<script>
  // Busca dentro do tipo: esconde os cartões que não têm o texto no nome.
  document.querySelectorAll<HTMLElement>("[data-service-picker]").forEach((picker) => {
    const input = picker.querySelector<HTMLInputElement>("[data-service-search]");
    const none = picker.querySelector<HTMLElement>("[data-service-none]");
    if (!input) return;
    input.addEventListener("input", () => {
      const term = input.value.trim().toLocaleLowerCase("pt-BR");
      let visible = 0;
      picker.querySelectorAll<HTMLElement>("[data-service-name]").forEach((item) => {
        item.hidden = !!term && !(item.dataset.serviceName ?? "").includes(term);
        if (!item.hidden) visible += 1;
      });
      if (none) none.hidden = visible > 0;
    });
  });
</script>

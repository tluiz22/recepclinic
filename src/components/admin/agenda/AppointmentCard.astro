---
// Cartão de um atendimento na Agenda (F4.5). Formato escolhido pelo cliente
// (05/out/2026): em cima, a informação e os selos da situação (nunca
// clicáveis); embaixo, uma fileira de botões iguais, com ícone. Toda ação
// pede confirmação antes (cliente, 05/out: cliques sem querer); Remarcar só
// abre a tela, e a confirmação fica no botão final de lá. Todas as ações vão
// para a mesma rota, com `acao`, e voltam para a tela de onde saíram.
import Badge, { type BadgeVariant } from "../Badge.astro";
import Card from "../Card.astro";
import Icon, { type IconName } from "../Icon.astro";
import PhoneLinks from "../PhoneLinks.astro";
import { CANCELED_CARD, CANCELED_TEXT } from "./canceledStyle";
import { formatInstant } from "../../../lib/clinicTime";
import type { AgendaAppointment, NoShowStats, OriginInfo } from "../../../lib/data/agenda/view";
import type { ReminderAction } from "../../../lib/data/whatsapp/reminders";
import { capitalize, type Vocabulary } from "../../../lib/vocabulary";

interface Props {
  appointment: AgendaAppointment;
  timeZone: string;
  now: Date;
  showAgenda: boolean;
  vocabulary: Vocabulary;
  returnTo: string;
  reminderAction?: ReminderAction;
  preparationResendable: boolean;
  waitlistOn: boolean;
  onWaitlist: boolean;
  noShow?: NoShowStats;
  /** Dentro do cartão da turma: sem o horário e mais compacto. */
  compact?: boolean;
  /** Retorno: a consulta de origem (data e situação). */
  origin?: OriginInfo;
  /** Caixinha do cancelamento em massa (F4.6), ligada ao formulário da tela. */
  massCancelForm?: string;
}

const { appointment: a, timeZone, now, showAgenda, vocabulary, returnTo, reminderAction, preparationResendable, waitlistOn, onWaitlist, noShow, compact = false, massCancelForm, origin } =
  Astro.props;
const action = `/api/admin/agenda/atendimentos/${a.id}`;
const time = (d: Date) => formatInstant(d, timeZone, "HH:mm");
const isActive = a.status === "scheduled" || a.status === "confirmed";
const isPast = a.scheduledAt.getTime() <= now.getTime();
const who = `${a.patientName}, ${formatInstant(a.scheduledAt, timeZone, "dd/MM 'às' HH:mm")}`;

const categoryVariant: Record<string, BadgeVariant> = { consultation: "info", return_visit: "accent", exam: "warning" };
const statusBadge: Record<string, { label: string; variant: BadgeVariant } | undefined> = {
  canceled: { label: "Cancelado", variant: "danger" },
  completed: { label: "Compareceu", variant: "success" },
  no_show: { label: "Faltou", variant: "danger" },
};
const status = statusBadge[a.status];
const isCanceled = a.status === "canceled";

// Selos da situação (só informação).
const reminderBadge: Record<ReminderAction, { label: string; variant: BadgeVariant }> = {
  send: { label: "Sem lembrete automático", variant: "neutral" },
  resend: { label: "Lembrete não entregue", variant: "warning" },
  resend_unanswered: { label: "Lembrete sem resposta", variant: "warning" },
};
const situation: { label: string; variant: BadgeVariant }[] = [];
if (isActive && !isPast && a.patientConfirmedAt) situation.push({ label: "Presença confirmada ✓", variant: "success" });
else if (isActive && !isPast && a.reminderResponse === "confirm") situation.push({ label: "Confirmou pelo lembrete", variant: "success" });
if (reminderAction) situation.push(reminderBadge[reminderAction]);
if (preparationResendable) situation.push({ label: "Preparo não entregue", variant: "warning" });
if (onWaitlist) situation.push({ label: "Na lista de espera", variant: "accent" });
if (isActive && isPast) situation.push({ label: "Já passou: registre o comparecimento", variant: "warning" });

// Botões (todos no mesmo formato; vermelho para o que desfaz).
type Button = { acao: string; label: string; icon: IconName; danger?: boolean; title: string; message: string; confirm: string };
const buttons: Button[] = [];
if (isActive && !isPast) {
  buttons.push(
    a.patientConfirmedAt
      ? { acao: "desfazer_presenca", label: "Desfazer presença", icon: "x-mark", title: "Desfazer a presença confirmada?", message: who, confirm: "Desfazer" }
      : {
          acao: "confirmar_presenca",
          label: "Confirmar presença",
          icon: "check",
          title: "Confirmar a presença?",
          message: `${who}. Use quando o ${vocabulary.contact} confirmou por mensagem ou ligação.`,
          confirm: "Confirmar presença",
        },
  );
}
if (reminderAction) {
  const label = reminderAction === "send" ? "Enviar lembrete" : "Reenviar lembrete";
  buttons.push({ acao: "lembrete", label, icon: "paper-airplane", title: `${label}?`, message: `${who}. O lembrete vai pelo WhatsApp.`, confirm: label });
}
if (preparationResendable) {
  buttons.push({
    acao: "preparo",
    label: "Reenviar preparo",
    icon: "paper-airplane",
    title: "Reenviar o preparo do exame?",
    message: `${who}. O preparo vai pelo WhatsApp.`,
    confirm: "Reenviar preparo",
  });
}
if (waitlistOn && isActive && !isPast && a.seriesId === null) {
  buttons.push(
    onWaitlist
      ? {
          acao: "sair_lista_espera",
          label: "Tirar da lista de espera",
          icon: "clock",
          danger: true,
          title: "Tirar da lista de espera?",
          message: `${who}. Deixa de receber oferta de horário antes.`,
          confirm: "Tirar da lista",
        }
      : {
          acao: "entrar_lista_espera",
          label: "Lista de espera",
          icon: "clock",
          title: "Pôr na lista de espera?",
          message: `${who}. Se abrir um horário antes, o ${vocabulary.contact} recebe a oferta para antecipar.`,
          confirm: "Pôr na lista",
        },
  );
}
if (isPast && (isActive || a.status === "completed" || a.status === "no_show")) {
  if (a.status !== "completed") {
    buttons.push({ acao: "compareceu", label: isActive ? "Compareceu" : "Corrigir: compareceu", icon: "check", title: "Registrar que compareceu?", message: who, confirm: "Compareceu" });
  }
  if (a.status !== "no_show") {
    buttons.push({ acao: "faltou", label: isActive ? "Faltou" : "Corrigir: faltou", icon: "x-mark", danger: true, title: "Registrar a falta?", message: who, confirm: "Faltou" });
  }
}
// Sessão de série: "esta e as próximas" (D9).
if (a.seriesId !== null && isActive && !isPast) {
  buttons.push({
    acao: "encerrar_serie",
    label: "Encerrar a série",
    icon: "x-mark",
    danger: true,
    title: "Encerrar a série a partir desta sessão?",
    message: `${who}. Esta sessão e as próximas são canceladas; as que já passaram ficam como estão. O paciente é avisado pelo WhatsApp do cancelamento da primeira.`,
    confirm: "Encerrar a série",
  });
}
const canReschedule = isActive && !isPast;
const BUTTON = "inline-flex items-center gap-1 rounded-md border bg-white px-2.5 py-1.5 text-xs font-semibold";
const tone = (danger?: boolean) => (danger ? "border-red-300 text-red-700 hover:bg-red-50" : "border-slate-300 text-slate-700 hover:bg-slate-50");
---

<Card class={`${compact ? "p-3 shadow-none" : ""} ${isCanceled ? CANCELED_CARD : ""}`}>
  {
    !compact && (
      <div class="flex flex-wrap items-center justify-between gap-2">
        <label class="flex items-center gap-2">
          {massCancelForm && isActive && !isPast && (
            <input
              type="checkbox"
              form={massCancelForm}
              name="ids"
              value={a.id}
              class="js-mass-cancel h-4 w-4 rounded border-slate-300"
              aria-label={`Selecionar ${a.patientName} para cancelar`}
            />
          )}
          <span class={`text-base font-semibold ${isCanceled ? CANCELED_TEXT : "text-slate-900"}`}>
            {time(a.scheduledAt)} – {time(a.endsAt)}
          </span>
        </label>
        {status && <Badge variant={status.variant}>{status.label}</Badge>}
      </div>
    )
  }
  <div class={`${compact ? "" : "mt-2"} text-sm text-slate-700`}>
    <p class="flex flex-wrap items-center gap-x-2 gap-y-1 font-medium text-slate-900">
      <a href={`/admin/pacientes/${a.patientId}`} class="hover:text-sky-700 hover:underline">{a.patientName}</a>
      {noShow && <Badge variant="danger">Faltou {noShow.noShows} de {noShow.total}</Badge>}
      {compact && status && <Badge variant={status.variant}>{status.label}</Badge>}
    </p>
    <p class="mt-0.5 text-slate-500">
      {!a.isContactSelf && `${capitalize(vocabulary.contact)}: ${a.contactName} · `}
      <PhoneLinks phone={a.contactPhone} plain class="text-slate-600" />
    </p>
    {
      !compact && (
        <div class="mt-2 flex flex-wrap items-center gap-1.5">
          <Badge variant={categoryVariant[a.category] ?? "info"}>{a.serviceName}</Badge>
          <Badge variant="neutral">{a.locationName}</Badge>
          {showAgenda && <Badge variant="neutral">{a.agendaName}</Badge>}
          {a.seriesId && <Badge variant="accent">Série</Badge>}
        </div>
      )
    }
    {a.homeVisitAddress && <p class="mt-1.5 text-slate-500">Endereço: {a.homeVisitAddress}</p>}
    {
      a.category === "return_visit" && (
        <p class="mt-1.5 text-slate-500">
          {origin
            ? `Retorno da consulta de ${formatInstant(origin.scheduledAt, timeZone, "dd/MM/yyyy")}${origin.status === "canceled" ? " (cancelada)" : ""}`
            : a.originAppointmentId
              ? "Retorno ligado a uma consulta"
              : "Retorno sem consulta de origem"}
        </p>
      )
    }

    {
      situation.length > 0 && (
        <div class="mt-2 flex flex-wrap items-center gap-1.5">
          {situation.map((s) => (
            <Badge variant={s.variant}>{s.label}</Badge>
          ))}
        </div>
      )
    }

    <div class="mt-3 flex flex-wrap gap-2 border-t border-slate-100 pt-3">
          {buttons.map((b) => (
            <form method="POST" action={action}>
              <input type="hidden" name="acao" value={b.acao} />
              <input type="hidden" name="return_to" value={returnTo} />
              <button
                type="submit"
                class={`${BUTTON} ${tone(b.danger)} js-confirm-delete`}
                data-confirm-title={b.title}
                data-confirm-message={b.message}
                data-confirm-label={b.confirm}
                data-confirm-tone={b.danger ? undefined : "primary"}
              >
                <Icon name={b.icon} class="h-3.5 w-3.5" />
                {b.label}
              </button>
            </form>
          ))}
          {canReschedule && (
            <>
              <a href={`/admin/agenda/remarcar?id=${a.id}&return_to=${encodeURIComponent(returnTo)}`} class={`${BUTTON} ${tone()}`}>
                <Icon name="arrow-path" class="h-3.5 w-3.5" />
                Remarcar
              </a>
              <form method="POST" action={action}>
                <input type="hidden" name="acao" value="cancelar" />
                <input type="hidden" name="return_to" value={returnTo} />
                <button
                  type="submit"
                  class={`${BUTTON} ${tone(true)} js-confirm-delete`}
                  data-confirm-title={a.seriesId ? "Cancelar só esta sessão?" : "Cancelar o atendimento?"}
                  data-confirm-message={`${who}. O horário fica livre de novo.${a.seriesId ? " A série continua nas próximas." : ""} O paciente é avisado pelo WhatsApp.`}
                  data-confirm-label={a.seriesId ? "Cancelar só esta" : "Cancelar atendimento"}
                >
                  <Icon name="x-mark" class="h-3.5 w-3.5" />
                  {a.seriesId ? "Cancelar só esta" : "Cancelar"}
                </button>
              </form>
            </>
          )}
          {a.seriesId && (
            <a href={`/admin/agenda/serie/${a.seriesId}`} class={`${BUTTON} ${tone()}`}>
              Ver série
            </a>
          )}
          <a href={`/admin/agenda/trilha/${a.id}?volta=${encodeURIComponent(returnTo)}`} class={`${BUTTON} ${tone()}`}>
            Trilha
          </a>
    </div>
  </div>
</Card>

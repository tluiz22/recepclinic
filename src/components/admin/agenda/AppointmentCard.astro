---
// Cartão de um atendimento na Agenda (F4.5), redesenhado na R2 (cliente,
// 15/out/2026): horário e selo da situação, paciente, contato, etiquetas
// neutras e sinais (nunca clicáveis); embaixo, uma ação principal cheia, as
// frequentes com borda, as raras no "Mais" e o cancelamento à parte, à
// direita (ver cardActions.ts). Toda ação pede confirmação (05/out); Remarcar
// e Pagamento só abrem a tela, e a confirmação fica lá. As ações vão para a
// mesma rota, com `acao`, e voltam para a tela de onde saíram. Redesign de
// 19/out/2026 (proposta 1C): o tipo (Consulta, Retorno, Exame) numa faixa no
// alto, com o serviço e, no Retorno, a consulta de origem.
import Icon from "../Icon.astro";
import { withReturn } from "../../../lib/returnPath";
import PhoneLinks from "../PhoneLinks.astro";
import MoreMenu from "../ui/MoreMenu.astro";
import Signal, { type SignalTone } from "../ui/Signal.astro";
import StatusPill from "../ui/StatusPill.astro";
import Tag from "../ui/Tag.astro";
import type { IconName } from "../Icon.astro";
import CardActionButton from "./CardActionButton.astro";
import { serviceBesideCategory, serviceLook, type ServiceTint } from "./categoryStyle";
import { cardActions } from "./cardActions";
import { CANCELED_TEXT, SITUATIONS, appointmentSituation } from "./situationStyle";
import { formatInstant } from "../../../lib/clinicTime";
import type { AgendaAppointment, NoShowStats, OriginInfo } from "../../../lib/data/agenda/view";
import type { PaymentState } from "../../../lib/data/payments";
import type { ReturnReady } from "../../../lib/data/agenda/returnReady";
import type { ReminderAction } from "../../../lib/data/whatsapp/reminders";
import { confirmedByReminder } from "../../../lib/reminderResponse";
import { capitalize, type Vocabulary } from "../../../lib/vocabulary";
import HelpTip from "../ui/HelpTip.astro";
import { agenda as ajudaAgenda } from "../../../lib/ajuda/agenda";

interface Props {
  appointment: AgendaAppointment;
  timeZone: string;
  now: Date;
  showAgenda: boolean;
  /** Nome da agenda só no celular (lista única do dia; cliente, 15/out/2026). */
  agendaOnPhone?: boolean;
  vocabulary: Vocabulary;
  returnTo: string;
  reminderAction?: ReminderAction;
  preparationResendable: boolean;
  /** Orientações gerais da consulta não entregues (cliente, 08/out/2026). */
  guidanceResendable?: boolean;
  waitlistOn: boolean;
  onWaitlist: boolean;
  noShow?: NoShowStats;
  /** Dentro do cartão da turma: sem o horário e mais compacto. */
  compact?: boolean;
  /** Retorno: a consulta de origem (data e situação). */
  origin?: OriginInfo;
  /**
   * Módulo financeiro (F11.2): situação dos pagamentos; sem ela (item
   * desligado ou papel sem acesso), nem o selo nem o botão "Pagamento".
   */
  payment?: PaymentState;
  /** Posição na lista única do celular (ordem por horário). */
  order?: number;
  /** Listas de vários dias (Resumo › A registrar e Registradas): o dia antes do horário. */
  withDate?: boolean;
  /** Cor do serviço (automática; cliente, 19/out/2026). Sem ela, a do tipo. */
  tint?: ServiceTint;
  /** Consulta apta a retorno: botão "Marcar retorno" (cliente, 19/out/2026). */
  returnReady?: ReturnReady;
}

const {
  appointment: a,
  timeZone,
  now,
  showAgenda,
  agendaOnPhone = false,
  vocabulary,
  returnTo,
  reminderAction,
  preparationResendable,
  guidanceResendable = false,
  waitlistOn,
  onWaitlist,
  noShow,
  compact = false,
  origin,
  payment,
  order,
  withDate = false,
  tint,
  returnReady,
} = Astro.props;
const endpoint = `/api/admin/agenda/atendimentos/${a.id}`;
const time = (d: Date) => formatInstant(d, timeZone, "HH:mm");
const isActive = a.status === "scheduled" || a.status === "confirmed";
const isPast = a.scheduledAt.getTime() <= now.getTime();
const isCanceled = a.status === "canceled";
const situation = appointmentSituation(a);
const category = serviceLook(a.category, tint);
const serviceBeside = serviceBesideCategory(a.serviceName, a.category);
const originText =
  a.category !== "return_visit"
    ? null
    : origin
      ? `da consulta de ${formatInstant(origin.scheduledAt, timeZone, "dd/MM/yyyy")}${origin.status === "canceled" ? " (cancelada)" : ""}`
      : a.originAppointmentId
        ? "ligado a uma consulta"
        : "sem consulta de origem";
const who = `${a.patientName}, ${formatInstant(a.scheduledAt, timeZone, "dd/MM 'às' HH:mm")}`;

// Sinais (só informação): cor quando pedem ação.
const reminderSignal: Record<ReminderAction, { label: string; tone: SignalTone }> = {
  send: { label: "Sem lembrete automático", tone: "neutral" },
  resend: { label: "Lembrete não entregue", tone: "warning" },
  resend_unanswered: { label: "Lembrete sem resposta", tone: "warning" },
};
const signals: { label: string; tone: SignalTone; icon: IconName }[] = [];
// O "confirmo" do lembrete também grava a presença: ele vem primeiro.
if (isActive && !isPast && confirmedByReminder(a.reminderResponse)) signals.push({ label: "Confirmou pelo lembrete", tone: "success", icon: "check" });
else if (isActive && !isPast && a.patientConfirmedAt) signals.push({ label: "Presença confirmada", tone: "success", icon: "check" });
if (reminderAction) signals.push({ ...reminderSignal[reminderAction], icon: "paper-airplane" });
if (preparationResendable) signals.push({ label: "Preparo não entregue", tone: "warning", icon: "paper-airplane" });
if (guidanceResendable) signals.push({ label: "Orientações não entregues", tone: "warning", icon: "paper-airplane" });
if (onWaitlist) signals.push({ label: "Na lista de espera", tone: "info", icon: "clock" });
if (isActive && isPast) signals.push({ label: "Já passou: registre o comparecimento", tone: "warning", icon: "clock" });
if (payment === "paid") signals.push({ label: "Pago", tone: "success", icon: "banknotes" });
else if (payment === "partial") signals.push({ label: "Pago em parte", tone: "warning", icon: "banknotes" });

const actions = cardActions({
  appointment: a,
  now,
  who,
  contact: vocabulary.contact,
  returnTo,
  reminderAction,
  preparationResendable,
  guidanceResendable,
  waitlistOn,
  onWaitlist,
  payment,
  returnReady,
});
// Na turma, o cartão é menor: Remarcar e Pagamento também vão para o "Mais"
// e as ações ficam numa linha só.
if (compact) {
  const links = actions.visible.filter((x) => x.kind === "link");
  actions.visible = actions.visible.filter((x) => x.kind !== "link");
  actions.more = [...links, ...actions.more];
}
const hasActions = Boolean(actions.primary || actions.visible.length || actions.more.length || actions.aside);
const moreLabel = `Mais ações de ${a.patientName}, ${time(a.scheduledAt)}`;
const variantOf = (x: (typeof actions.visible)[number]) => (x.kind === "form" && x.danger ? "danger" : "secondary");
---

<article
  class={`flex min-w-0 flex-col gap-1.5 rounded-xl border ${SITUATIONS[situation].edge} ${SITUATIONS[situation].card} ${compact ? "rounded-lg px-2.5 py-2" : "px-3 pb-2.5 pt-3"}`}
  style={order !== undefined ? `order: ${order}` : undefined}
>
  {
    compact ? (
      <div class="flex flex-wrap items-center justify-between gap-x-2 gap-y-1">
        <a href={withReturn(`/admin/pacientes/${a.patientId}`, returnTo)} class="max-w-full shrink-0 text-[15px] font-semibold text-ink no-underline hover:text-brand hover:underline">
          {a.patientName}
        </a>
        <StatusPill situation={situation} />
      </div>
    ) : (
      <>
        <div class={`-mx-3 -mt-3 mb-0.5 flex flex-wrap items-center gap-x-2 gap-y-0.5 rounded-tr-[11px] border-b px-3 py-2 ${category.band}`}>
          <span class={`inline-flex items-center gap-1.5 font-display text-[17px] leading-tight font-bold ${category.text}`}>
            <Icon name={category.icon} class="h-[18px] w-[18px] shrink-0" strokeWidth={2.2} />
            {category.label}
          </span>
          {serviceBeside && <span class={`text-[15px] leading-snug sm:text-sm ${category.detail}`}>{serviceBeside}</span>}
          {originText && <span class={`text-[15px] leading-snug sm:text-sm ${category.detail}`}>{originText}</span>}
        </div>
        <div class="flex items-center justify-between gap-2">
          <span class={`whitespace-nowrap text-base leading-tight font-bold tabular-nums sm:text-base ${isCanceled ? CANCELED_TEXT : "text-ink"}`}>
            {withDate && <span class="capitalize">{formatInstant(a.scheduledAt, timeZone, "EEE dd/MM")} · </span>}
            {time(a.scheduledAt)} – {time(a.endsAt)}
          </span>
          <StatusPill situation={situation} />
        </div>
        <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
          <a href={withReturn(`/admin/pacientes/${a.patientId}`, returnTo)} class="text-[17px] leading-snug font-semibold text-ink no-underline hover:text-brand hover:underline sm:text-base">
            {a.patientName}
          </a>
          {noShow && (
            <span class="inline-flex items-center gap-1">
              <Signal tone="alert" icon="warning">
                Faltou {noShow.noShows} de {noShow.total}
              </Signal>
              <HelpTip variant="pop" subject={`Faltou ${noShow.noShows} de ${noShow.total}`} text={ajudaAgenda.dicas.seloFaltas} id={`faltas-${a.id}`} />
            </span>
          )}
        </div>
      </>
    )
  }

  <p class={`flex flex-wrap items-center gap-x-1.5 gap-y-1 leading-snug text-ink-soft ${compact ? "text-[13px]" : "text-[15px] sm:text-sm"}`}>
    {!a.isContactSelf && `${capitalize(vocabulary.contact)}: ${a.contactName} · `}
    <PhoneLinks phone={a.contactPhone} plain />
  </p>

  {/* Na turma não há faixa: o Retorno segue dizendo a origem numa linha. */}
  {compact && originText && <p class="text-[13px] leading-snug text-ret-800">Retorno {originText}</p>}

  {compact && noShow && (
    <span class="inline-flex items-center gap-1">
      <Signal tone="alert" icon="warning">
        Faltou {noShow.noShows} de {noShow.total}
      </Signal>
      <HelpTip variant="pop" subject={`Faltou ${noShow.noShows} de ${noShow.total}`} text={ajudaAgenda.dicas.seloFaltas} id={`faltas-${a.id}`} />
    </span>
  )}

  {
    !compact && (
      <div class="flex flex-wrap gap-1.5">
        {(showAgenda || agendaOnPhone) && (
          <Tag strong class={showAgenda ? "" : "sm:hidden"}>
            {a.agendaName}
          </Tag>
        )}
        <Tag>{a.locationName}</Tag>
        {a.seriesId && <Tag>Série</Tag>}
      </div>
    )
  }
  {a.homeVisitAddress && <p class="text-sm leading-snug text-ink-soft sm:text-[13px]">Endereço: {a.homeVisitAddress}</p>}

  {
    signals.length > 0 && (
      <div class="flex flex-wrap gap-x-3.5 gap-y-1">
        {signals.map((s) => (
          <Signal tone={s.tone} icon={s.icon}>
            {s.label}
          </Signal>
        ))}
      </div>
    )
  }

  {
    hasActions &&
      (actions.primary && !compact ? (
        <>
          <div class="mt-0.5 flex flex-wrap gap-2 border-t border-ink/10 pt-2.5 sm:gap-1.5 sm:pt-2">
            <CardActionButton action={actions.primary} endpoint={endpoint} returnTo={returnTo} variant="primary" />
            {actions.visible.map((x) => (
              <CardActionButton action={x} endpoint={endpoint} returnTo={returnTo} variant={variantOf(x)} />
            ))}
          </div>
          {(actions.more.length > 0 || actions.aside) && (
            <div class="flex items-center justify-between gap-1.5">
              {actions.more.length > 0 ? (
                <MoreMenu id={`mais-${a.id}`} label={moreLabel}>
                  {actions.more.map((x) => (
                    <CardActionButton action={x} endpoint={endpoint} returnTo={returnTo} inMenu />
                  ))}
                </MoreMenu>
              ) : (
                <span />
              )}
              {actions.aside && <CardActionButton action={actions.aside} endpoint={endpoint} returnTo={returnTo} variant="danger-quiet" />}
            </div>
          )}
        </>
      ) : (
        <div class="mt-0.5 flex flex-wrap items-center gap-2 border-t border-ink/10 pt-2.5 sm:gap-1.5 sm:pt-2">
          {(actions.primary || actions.visible.length > 0) && (
            <div class="flex min-w-0 flex-wrap gap-2 sm:gap-1.5">
              {actions.primary && <CardActionButton action={actions.primary} endpoint={endpoint} returnTo={returnTo} variant="primary" />}
              {actions.visible.map((x) => (
                <CardActionButton action={x} endpoint={endpoint} returnTo={returnTo} variant={variantOf(x)} />
              ))}
            </div>
          )}
          {/* "Mais" e Cancelar andam juntos: cabendo, ficam na mesma linha; na coluna estreita
              (paciente da turma), descem para a linha de baixo, "Mais" à esquerda e Cancelar à
              direita, como no cartão aprovado no redesign. */}
          {(actions.more.length > 0 || actions.aside) && (
            <div class="flex flex-1 items-center justify-between gap-1.5">
              {actions.more.length > 0 ? (
                <MoreMenu id={`mais-${a.id}`} label={moreLabel}>
                  {actions.more.map((x) => (
                    <CardActionButton action={x} endpoint={endpoint} returnTo={returnTo} inMenu />
                  ))}
                </MoreMenu>
              ) : (
                <span />
              )}
              {actions.aside && <CardActionButton action={actions.aside} endpoint={endpoint} returnTo={returnTo} variant="danger-quiet" />}
            </div>
          )}
        </div>
      ))
  }
</article>

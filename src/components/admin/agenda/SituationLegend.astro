---
// Legenda das cores da situação (cliente, 10/out/2026). Na Agenda do dia, com
// quantos atendimentos há em cada situação (15/out): só contagem, sem filtro.
import StatusPill from "../ui/StatusPill.astro";
import { SITUATIONS, type Situation } from "./situationStyle";

interface Props {
  counts?: Record<Situation, number>;
  /** Sem "Bloqueio" onde não há bloqueios (Resumo do Dia). */
  withBlock?: boolean;
  class?: string;
}

const { counts, withBlock = true, class: className = "mt-3" } = Astro.props;
const situations = (Object.keys(SITUATIONS) as Situation[]).filter((s) => withBlock || s !== "block");
---

<ul
  class={`-mx-4 flex gap-1.5 overflow-x-auto px-4 pb-0.5 sm:mx-0 sm:flex-wrap sm:gap-2 sm:overflow-visible sm:px-0 ${className}`}
  aria-label={counts ? "Situação dos atendimentos do dia" : "Legenda das cores"}
>
  {
    situations.map((s) => (
      <li class="shrink-0">
        <StatusPill situation={s} count={counts?.[s]} />
      </li>
    ))
  }
</ul>

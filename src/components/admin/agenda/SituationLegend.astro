---
// Legenda das cores da situação (cliente, 10/out/2026).
import { SITUATIONS } from "./situationStyle";
---

<ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1.5 text-xs text-slate-600" aria-label="Legenda das cores">
  {
    Object.values(SITUATIONS).map((s) => (
      <li class="flex items-center gap-1.5">
        <span class={`inline-block h-3.5 w-4 rounded-sm border border-slate-200 border-l-4 ${s.swatch}`} aria-hidden="true" />
        {s.label}
      </li>
    ))
  }
</ul>

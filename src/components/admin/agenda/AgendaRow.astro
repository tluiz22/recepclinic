---
// Linha de um atendimento na Agenda › Dia (RX7 do redesign da Recepção, RX-D6 opção C; cliente, 02/nov/2026): uma
// linha curta (hora, paciente, tipo e situação) que abre, na própria linha, o cartão com o telefone, os sinais e as
// mesmas ações do cartão de antes (cardActions.ts). Uma linha aberta por vez (`name` do <details>; o script da
// Agenda cobre os navegadores sem ele). Sem JavaScript, o <details> também abre e fecha.
import Icon from "../Icon.astro";
import StatusPill from "../ui/StatusPill.astro";
import { serviceLook, type ServiceTint } from "./categoryStyle";
import { CANCELED_TEXT, SITUATIONS, appointmentSituation } from "./situationStyle";
import { formatInstant } from "../../../lib/clinicTime";
import type { AgendaAppointment } from "../../../lib/data/agenda/view";

interface Props {
  appointment: AgendaAppointment;
  timeZone: string;
  tint?: ServiceTint;
  /** Algum sinal que pede ação (lembrete sem resposta, já passou...): um ponto âmbar na linha. */
  attention?: boolean;
  /** Posição na lista única do celular (ordem por horário). */
  order?: number;
}

const { appointment: a, timeZone, tint, attention = false, order } = Astro.props;
const situation = appointmentSituation(a);
const category = serviceLook(a.category, tint);
const canceled = a.status === "canceled";
---

<article class={`min-w-0 rounded-xl border ${SITUATIONS[situation].edge} ${SITUATIONS[situation].card}`} style={order !== undefined ? `order: ${order}` : undefined}>
  <details name="agenda-linha" data-agenda-row class="group">
    <summary
      class="flex min-h-14 cursor-pointer list-none flex-col justify-center gap-0.5 rounded-xl px-3 py-2 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-brand [&::-webkit-details-marker]:hidden"
    >
      <span class="flex items-center gap-2">
        <span class={`text-base leading-tight font-bold whitespace-nowrap tabular-nums ${canceled ? CANCELED_TEXT : "text-ink"}`}>{formatInstant(a.scheduledAt, timeZone, "HH:mm")}</span>
        <span class={`min-w-0 flex-1 truncate text-[16px] leading-tight font-semibold ${canceled ? CANCELED_TEXT : "text-ink"}`}>{a.patientName}</span>
        {attention && <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-pend-500" role="img" aria-label="Pede atenção"></span>}
        <Icon name="chevron-down" class="h-4 w-4 shrink-0 text-ink-soft transition-transform group-open:rotate-180" strokeWidth={2.4} />
      </span>
      <span class="flex flex-wrap items-center gap-x-2 gap-y-1">
        <span class={`inline-flex items-center gap-1 text-[14px] leading-tight font-semibold ${category.text}`}>
          <Icon name={category.icon} class="h-[15px] w-[15px] shrink-0" strokeWidth={2.2} />
          {category.label}
        </span>
        <StatusPill situation={situation} />
      </span>
    </summary>
    <div class="border-t border-ink/10">
      <slot />
    </div>
  </details>
</article>

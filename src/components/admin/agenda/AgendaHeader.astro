---
// Cabeçalho da Agenda (F4.5): Dia, Semana e Mês, a escolha da agenda (todas
// ou uma; cliente, 05/out/2026), marcar e, desde a F4.6, bloquear e a
// lista de bloqueios. Busca dos atendimentos marcados de um paciente
// (cliente, 10/out/2026).
import Icon from "../Icon.astro";
import { INPUT, PRIMARY_BUTTON, SECONDARY_BUTTON } from "../fieldStyles";
import { ALL_AGENDAS } from "../../../lib/agendaChoice";

interface Props {
  /** "busca": a tela da busca de paciente (nenhuma aba marcada). */
  view: "dia" | "semana" | "mes" | "busca";
  /** Texto da busca de paciente, na tela da busca. */
  query?: string;
  date: string;
  agendas: { id: string; name: string }[];
  selectedAgendaId: string | null;
}

const { view, date, agendas, selectedAgendaId, query = "" } = Astro.props;
const views = [
  { id: "dia", label: "Dia", href: "/admin/agenda" },
  { id: "semana", label: "Semana", href: "/admin/agenda/semana" },
  { id: "mes", label: "Mês", href: "/admin/agenda/mes" },
] as const;
const current = views.find((v) => v.id === view) ?? views[0];
---

<div class="flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold text-slate-900">Agenda</h1>
    <nav class="mt-3 flex gap-x-5 border-b border-slate-200 text-sm font-medium">
      {
        views.map((v) =>
          v.id === view ? (
            <span class="-mb-px border-b-2 border-sky-700 pb-2 text-sky-700">{v.label}</span>
          ) : (
            <a href={`${v.href}?date=${date}`} class="-mb-px border-b-2 border-transparent pb-2 text-slate-600 hover:text-sky-700">
              {v.label}
            </a>
          ),
        )
      }
    </nav>
  </div>
  <div class="flex flex-wrap gap-2">
    <a href={`/admin/agenda/marcar?date=${date}${selectedAgendaId ? `&agenda_id=${selectedAgendaId}` : ""}`} class={`${PRIMARY_BUTTON} inline-flex items-center gap-1.5`}>
      <Icon name="plus" class="h-4 w-4" /> Marcar
    </a>
    <a href={`/admin/agenda/bloquear?date=${date}${selectedAgendaId ? `&agenda=${selectedAgendaId}` : ""}`} class={SECONDARY_BUTTON}>Bloquear</a>
    <a href="/admin/agenda/bloqueios" class={SECONDARY_BUTTON}>Bloqueios</a>
  </div>
</div>

<form method="GET" action="/admin/agenda/buscar" role="search" class="mt-4 sm:max-w-md">
  <label for="patient_search" class="block text-sm font-medium text-slate-700">Atendimentos marcados de um paciente</label>
  <div class="mt-1 flex gap-2">
    <input id="patient_search" type="search" name="q" value={query} placeholder="Nome ou telefone do paciente" class={`${INPUT} mt-0`} />
    <button type="submit" class={`${SECONDARY_BUTTON} inline-flex shrink-0 items-center gap-1.5`}>
      <Icon name="magnifying-glass" class="h-4 w-4" /> Buscar
    </button>
  </div>
</form>

{
  agendas.length > 1 && (
    <form method="GET" action={current.href} class="mt-4">
      <input type="hidden" name="date" value={date} />
      <label for="agenda_choice" class="sr-only">
        Agenda
      </label>
      <select id="agenda_choice" name="agenda" class={`${INPUT} mt-0 sm:w-72`} data-autosubmit>
        <option value={ALL_AGENDAS} selected={!selectedAgendaId}>
          Todas as agendas
        </option>
        {agendas.map((agenda) => (
          <option value={agenda.id} selected={agenda.id === selectedAgendaId}>
            {agenda.name}
          </option>
        ))}
      </select>
      <noscript>
        <button type="submit" class="ml-2 text-sm text-sky-700">
          Ver
        </button>
      </noscript>
    </form>
  )
}

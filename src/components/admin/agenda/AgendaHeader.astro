---
// Cabeçalho da Agenda (F4.5): Dia, Semana e Mês, a escolha da agenda (todas
// ou uma; cliente, 05/out/2026), marcar e, desde a F4.6, bloquear e a
// lista de bloqueios. Busca dos atendimentos marcados de um paciente
// (cliente, 10/out/2026). Redesign R2 (15/out): título com o resumo do dia e
// uma barra só com a visualização, a navegação da data (slot "nav"), a agenda
// e a busca; no celular, a agenda e a busca ficam recolhidas. De 640 a
// 1279px, a agenda e a busca vão para a segunda linha da barra (regressão de
// 18/out, REG-01; cliente, 19/out/2026); numa linha só a partir de 1280px.
import { currentPath, withReturn } from "../../../lib/returnPath";
import Icon from "../Icon.astro";
import Button from "../ui/Button.astro";
import SegmentedControl from "../ui/SegmentedControl.astro";
import { CONTROL } from "../ui/styles";
import { ALL_AGENDAS } from "../../../lib/agendaChoice";

interface Props {
  /** "busca": a tela da busca de paciente (nenhuma aba marcada). */
  view: "dia" | "semana" | "mes" | "busca";
  /** Texto da busca de paciente, na tela da busca. */
  query?: string;
  date: string;
  agendas: { id: string; name: string }[];
  selectedAgendaId: string | null;
  /** Linha abaixo do título (ex.: a data por extenso e quantos atendimentos). */
  subtitle?: string;
  /** Na tela da busca: a tela da Agenda de onde a busca saiu (o "Voltar" dela). */
  returnTo?: string | null;
}

const { view, date, agendas, selectedAgendaId, query = "", subtitle, returnTo = null } = Astro.props;
const views = [
  { id: "dia", label: "Dia", href: "/admin/agenda" },
  { id: "semana", label: "Semana", href: "/admin/agenda/semana" },
  { id: "mes", label: "Mês", href: "/admin/agenda/mes" },
] as const;
const current = views.find((v) => v.id === view) ?? views[0];
// Marcar, Bloquear e Bloqueios voltam para esta tela (cliente, 10/out/2026).
const here = currentPath(Astro.url);
// A busca volta para a tela de onde saiu (teste do redesign, NAV-07, 16/out/2026);
// uma busca nova feita na própria tela da busca mantém essa origem.
const searchReturn = view === "busca" ? returnTo : here;
const selectedName = agendas.find((agenda) => agenda.id === selectedAgendaId)?.name;
const filtersLabel = agendas.length > 1 ? `${selectedName ?? "Todas as agendas"} · buscar paciente` : "Buscar paciente";
---

<div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-3">
  <div class="min-w-0">
    <h1 class="font-display text-[28px] leading-[1.1] font-bold text-ink sm:text-[30px]">Agenda</h1>
    {subtitle && <p class="mt-1 text-[15px] text-ink-soft first-letter:uppercase sm:text-base">{subtitle}</p>}
  </div>
  <div class="flex flex-wrap gap-2">
    <Button variant="primary" href={withReturn(`/admin/agenda/marcar?date=${date}${selectedAgendaId ? `&agenda_id=${selectedAgendaId}` : ""}`, here)}>
      <Icon name="plus" class="h-4 w-4" strokeWidth={2.4} /> Marcar
    </Button>
    <Button href={withReturn(`/admin/agenda/bloquear?date=${date}${selectedAgendaId ? `&agenda=${selectedAgendaId}` : ""}`, here)}>Bloquear</Button>
    <Button variant="quiet" href={withReturn("/admin/agenda/bloqueios", here)}>Bloqueios</Button>
  </div>
</div>

<div class="mt-4 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-3 sm:gap-y-2.5 sm:rounded-xl sm:border sm:border-line sm:bg-white sm:px-3 sm:py-2.5">
  <SegmentedControl
    label="Visualização"
    current={view === "busca" ? undefined : view}
    items={views.map((v) => ({ id: v.id, label: v.label, href: `${v.href}?date=${date}` }))}
  />
  <slot name="nav" />

  <details data-agenda-filters open class="group rounded-xl border border-line bg-white sm:w-full sm:rounded-none sm:border-0 sm:bg-transparent xl:w-auto xl:min-w-0 xl:flex-1">
    <summary class="flex h-12 cursor-pointer list-none items-center justify-between gap-2 px-3.5 text-[15px] font-semibold text-ink sm:hidden [&::-webkit-details-marker]:hidden">
      <span class="inline-flex min-w-0 items-center gap-2">
        <Icon name="adjustments" class="h-[18px] w-[18px] shrink-0" strokeWidth={2.2} />
        <span class="truncate">{filtersLabel}</span>
      </span>
      <Icon name="chevron-down" class="h-4 w-4 shrink-0 transition-transform group-open:rotate-180" strokeWidth={2.4} />
    </summary>
    <div class="flex flex-col gap-3 border-t border-line p-3.5 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-3 sm:gap-y-2.5 sm:border-0 sm:p-0">
      {
        agendas.length > 1 && (
          <form method="GET" action={current.href}>
            <input type="hidden" name="date" value={date} />
            <label for="agenda_choice" class="sr-only">
              Agenda
            </label>
            <select id="agenda_choice" name="agenda" class={`${CONTROL} w-full sm:w-52`} data-autosubmit>
              <option value={ALL_AGENDAS} selected={!selectedAgendaId}>
                Todas as agendas
              </option>
              {agendas.map((agenda) => (
                <option value={agenda.id} selected={agenda.id === selectedAgendaId}>
                  {agenda.name}
                </option>
              ))}
            </select>
            <noscript>
              <button type="submit" class="ml-2 text-sm text-brand">
                Ver
              </button>
            </noscript>
          </form>
        )
      }
      <form method="GET" action="/admin/agenda/buscar" role="search" class="flex min-w-0 gap-2 sm:ml-auto sm:min-w-56 sm:max-w-md sm:flex-1 sm:gap-1.5">
        {searchReturn && <input type="hidden" name="volta" value={searchReturn} />}
        <label for="patient_search" class="sr-only">Atendimentos marcados de um paciente</label>
        <div class="relative min-w-0 flex-1">
          <Icon name="magnifying-glass" class="pointer-events-none absolute top-1/2 left-3 h-[17px] w-[17px] -translate-y-1/2 text-ink-soft" strokeWidth={2.2} />
          <input id="patient_search" type="search" name="q" value={query} placeholder="Nome, telefone ou nascimento" class={`${CONTROL} w-full pl-9`} />
        </div>
        <Button type="submit">Buscar</Button>
      </form>
    </div>
  </details>
</div>

<script>
  // Celular: agenda e busca recolhidas (abertas na tela da busca); a partir
  // de 640px ficam sempre à vista, na barra.
  const filters = document.querySelector<HTMLDetailsElement>("[data-agenda-filters]");
  if (filters) {
    const wide = window.matchMedia("(min-width: 640px)");
    const searching = Boolean(filters.querySelector<HTMLInputElement>("#patient_search")?.value);
    const sync = () => {
      if (wide.matches) filters.open = true;
    };
    if (!wide.matches && !searching) filters.open = false;
    wide.addEventListener("change", sync);
  }
</script>

---
// Agenda no celular (F5a; M4, cliente, 08/nov/2026): uma agenda por vez, até 639px (a partir daí, a grade). Setas
// para a anterior e a próxima, o nome abre a lista com busca e especialidades, e deslizar para o lado troca de agenda.
// As linhas são as de hoje (hora, paciente, serviço, situação; "Livre" com Marcar; reserva do portal; bloqueio); tocar
// numa linha abre o atendimento embaixo (o mesmo painel da grade).
import Icon from "../Icon.astro";
import StatusPill from "../ui/StatusPill.astro";
import ColumnPicker from "./ColumnPicker.astro";
import type { GridItem } from "./AgendaGrid.astro";

interface Props {
  column: { id: string; name: string; group: string; countText: string; items: GridItem[] } | null;
  /** Posição (1 de 18) e os vizinhos. */
  position: number;
  total: number;
  prevHref: string | null;
  nextHref: string | null;
  pickerGroups: { name: string | null; options: { label: string; hint?: string; terms?: string; href: string; current: boolean }[] }[];
  /** Com filtro de agenda ou especialidade (vindo do computador ou de "Ver mais dias"): o link para ver todas. */
  clearHref?: string | null;
  allHref: string;
  selectedKey: string;
}

const { column, position, total, prevHref, nextHref, pickerGroups, allHref, selectedKey, clearHref = null } = Astro.props;
const arrow = "inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-lg border border-line-strong bg-white text-ink no-underline aria-disabled:opacity-40";
const row = "flex min-h-14 items-center gap-3 border-t border-[#e7eeeb] px-4 py-2 no-underline first:border-t-0";
const sorted = column ? [...column.items].sort((a, b) => a.top - b.top) : [];
---

<section aria-label="Agenda de um profissional" data-phone-agenda class="sm:hidden">
  {
    clearHref && (
      <a href={clearHref} class="mb-2 inline-flex min-h-11 items-center gap-1 text-[15px] font-semibold text-brand no-underline">
        Ver todas as agendas
      </a>
    )
  }
  {
    total > 1 && column && (
      <div class="flex items-center gap-1.5">
        {prevHref ? (
          <a href={prevHref} data-phone-prev aria-label="Agenda anterior" class={arrow}>
            <Icon name="chevron-left" class="h-5 w-5" strokeWidth={2.2} />
          </a>
        ) : (
          <span aria-disabled="true" class={arrow}>
            <Icon name="chevron-left" class="h-5 w-5" strokeWidth={2.2} />
          </span>
        )}
        <button
          type="button"
          popovertarget="agenda-celular-lista"
          class="flex min-h-12 min-w-0 flex-1 items-center justify-between gap-2 rounded-lg border border-line-strong bg-white px-3 text-left text-ink"
          aria-label={`${column.name}, ${position} de ${total}. Trocar de agenda`}
        >
          <span class="flex min-w-0 flex-col leading-tight">
            <b class="truncate text-[16px]">{column.name}</b>
            <span class="text-[13.5px] text-ink-soft">{column.group} · {position} de {total}</span>
          </span>
          <Icon name="chevron-down" class="h-4 w-4 shrink-0" strokeWidth={2.2} />
        </button>
        {nextHref ? (
          <a href={nextHref} data-phone-next aria-label="Próxima agenda" class={arrow}>
            <Icon name="chevron-right" class="h-5 w-5" strokeWidth={2.2} />
          </a>
        ) : (
          <span aria-disabled="true" class={arrow}>
            <Icon name="chevron-right" class="h-5 w-5" strokeWidth={2.2} />
          </span>
        )}
      </div>
    )
  }
  {
    total > 1 && (
      <ColumnPicker
          trigger={false}
          showAll={false}
          id="agenda-celular-lista"
          label="Profissional"
          allText="todos"
          allHref={allHref}
          groups={pickerGroups}
          currentText={column?.name ?? null}
          searchPlaceholder="Nome ou especialidade"
        />
    )
  }

  <div data-phone-rows class="mt-3 overflow-hidden rounded-xl border border-line bg-white">
    {
      sorted.map((item) => {
        if (item.kind === "free") {
          return (
            <a href={item.href} aria-label={`Livre às ${item.time}${item.detail ? `, ${item.detail}` : ""}: marcar`} class={`${row} bg-conf-50 text-[15px] font-semibold text-brand-ink`}>
              <span class="w-12 tabular-nums">{item.time}</span>
              <span class="flex-1">Livre{item.detail ? ` · ${item.detail}` : ""}</span>
              <span>+ Marcar</span>
            </a>
          );
        }
        if (item.kind === "hold") {
          return (
            <div class={`${row} bg-att-50 text-att-800`}>
              <b class="w-12 tabular-nums">{item.time}</b>
              <span class="flex-1 text-[14.5px] leading-tight">
                <b>Em reserva até {item.until}</b>
                <span class="block">alguém escolhendo no portal</span>
              </span>
            </div>
          );
        }
        const selected = item.key === selectedKey;
        return (
          <a
            href={item.href}
            data-select={item.key}
            data-selected={selected || undefined}
            aria-current={selected ? "true" : undefined}
            class={`${row} text-ink data-[selected]:bg-conf-50 data-[selected]:shadow-[inset_3px_0_0_var(--color-brand)] ${item.kind === "block" ? "bg-blk-50" : ""}`}
          >
            <b class={`w-12 text-[15px] tabular-nums ${item.kind === "appointment" && item.situation === "canceled" ? "text-ink-soft line-through" : ""}`}>{item.time}</b>
            <span class="flex min-w-0 flex-1 flex-col">
              <span class={`truncate text-[15.5px] font-bold ${item.kind === "appointment" && item.situation === "canceled" ? "text-ink-soft line-through" : ""}`}>{item.title}</span>
              <span class="truncate text-[13.5px] text-ink-soft">{item.detail}</span>
            </span>
            {item.kind === "appointment" && <StatusPill situation={item.situation} />}
            {item.kind === "block" && <StatusPill situation="block" />}
            {item.kind === "group" && <span class="inline-flex items-center rounded-md bg-[#f6e6da] px-1.5 text-[12px] font-semibold text-[#7a3d12]">Turma</span>}
          </a>
        );
      })
    }
    {sorted.length === 0 && <p class="px-4 py-5 text-[15px] text-ink-soft">Nenhum atendimento nem horário livre neste dia.</p>}
  </div>
  {total > 1 && <p class="mt-2 text-[13.5px] text-ink-soft">Deslize para o lado para trocar de agenda. O nome abre a lista com busca.</p>}
</section>

<script>
  // Deslizar para o lado troca de agenda (como as setas).
  const list = document.querySelector<HTMLElement>("[data-phone-rows]");
  if (list) {
    let x = 0;
    let y = 0;
    list.addEventListener("touchstart", (e) => ((x = e.touches[0].clientX), (y = e.touches[0].clientY)), { passive: true });
    list.addEventListener(
      "touchend",
      (e) => {
        const dx = e.changedTouches[0].clientX - x;
        const dy = e.changedTouches[0].clientY - y;
        if (Math.abs(dx) < 70 || Math.abs(dx) < Math.abs(dy) * 1.5) return;
        const link = document.querySelector<HTMLAnchorElement>(dx < 0 ? "[data-phone-next]" : "[data-phone-prev]");
        if (link) location.href = link.href;
      },
      { passive: true },
    );
  }
</script>

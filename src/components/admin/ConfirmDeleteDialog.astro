---
// Modal de confirmação reutilizado por qualquer botão "Excluir" do admin —
// não usa window.confirm() (mostra a URL da página no título, o que não
// fica bom). Qualquer botão com a classe "js-confirm-delete" dentro de um
// <form> passa a abrir este modal antes de enviar; a mensagem vem do
// atributo data-confirm-message do próprio botão (título e texto do botão de
// confirmar podem mudar com data-confirm-title/data-confirm-label, ex.:
// "Retirar da lista de espera"). Ver src/scripts/confirmDelete.ts.
// Marcar e Alterar (cliente, 28/out/2026): a lista dos dados
// (data-confirm-details) e o aviso do WhatsApp (data-confirm-notice).
// Conferência do WhatsApp (cliente, 05/nov/2026, opção A2): com `data-confirm-whatsapp` (o número, formatado), o
// número aparece em destaque e o botão de confirmar só libera com "Conferi o número com o paciente" marcado.
// `data-confirm-whatsapp-label`: o título do quadro; `data-confirm-whatsapp-fix`: o link "Corrigir o número".
---

<dialog
  id="delete_dialog"
  aria-labelledby="delete_dialog_title"
  aria-describedby="delete_dialog_message"
  class="m-auto w-[calc(100%-2rem)] max-w-[400px] rounded-[14px] border border-line bg-white p-0 text-ink shadow-[0_20px_50px_rgba(18,48,42,.22)] backdrop:bg-ink/40"
>
  <div class="flex flex-col gap-3 p-[22px]">
    <h2 id="delete_dialog_title" class="font-display text-xl leading-tight font-bold text-ink">Excluir?</h2>
    <p id="delete_dialog_message" class="text-[15px] leading-normal text-ink-mid"></p>
    <dl
      id="delete_dialog_details"
      hidden
      class="grid grid-cols-[88px_minmax(0,1fr)] gap-x-3 gap-y-1.5 rounded-[10px] border border-line bg-canvas px-3 py-2.5 text-[15px] leading-snug"
    >
    </dl>
    <div id="delete_dialog_whatsapp" hidden class="flex flex-col gap-2 rounded-xl border-2 border-conf-500 bg-conf-50 px-3.5 py-3">
      <span id="delete_dialog_whatsapp_label" class="text-[13px] font-bold tracking-wide text-conf-800 uppercase">WhatsApp que recebe a confirmação</span>
      <span id="delete_dialog_whatsapp_number" class="font-display text-[26px] leading-tight font-bold text-ink tabular-nums"></span>
      <label class="flex min-h-11 cursor-pointer items-center gap-2.5 rounded-lg border border-conf-200 bg-white px-2.5 text-[15.5px] font-semibold text-ink">
        <input id="delete_dialog_whatsapp_ok" type="checkbox" class="h-5 w-5 flex-none accent-brand" />
        Conferi o número com o paciente
      </label>
      <a id="delete_dialog_whatsapp_fix" hidden href="#" class="self-start text-[14.5px] font-semibold text-brand-ink hover:underline">Corrigir o número</a>
    </div>
    <p id="delete_dialog_notice" hidden class="flex items-start gap-2 rounded-[10px] border border-conf-200 bg-conf-100/60 px-3 py-2.5 text-[14.5px] leading-snug text-conf-800">
    </p>
    <div class="mt-1 flex flex-wrap justify-end gap-2">
      <button
        type="button"
        id="delete_dialog_dismiss"
        class="h-11 rounded-lg border border-line-strong bg-white px-4 text-[15px] font-semibold text-ink hover:bg-canvas sm:h-10"
      >
        Voltar
      </button>
      <button
        type="button"
        id="delete_dialog_accept"
        class="h-11 rounded-lg bg-danger-solid px-4 text-[15px] font-semibold text-white hover:bg-danger-solid-strong disabled:cursor-not-allowed disabled:opacity-50 sm:h-10"
      >
        Excluir
      </button>
    </div>
  </div>
</dialog>

<script src="../../scripts/confirmDelete.ts"></script>

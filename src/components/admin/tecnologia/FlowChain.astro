---
// Tecnologia › Jornada do bot: uma sequência do fluxograma, de cima para
// baixo, com setas entre as caixas. Uma ramificação abre colunas lado a lado
// (empilhadas no celular), cada uma com a própria sequência (Astro.self).
import { NODE_STYLES, type FlowItem } from "./botJourney";

interface Props {
  items: FlowItem[];
}

const { items } = Astro.props;
const ARROW = "mx-auto h-4 w-0.5 bg-line-strong";
---

<div class="flex flex-col items-stretch">
  {
    items.map((item, index) => (
      <>
        {index > 0 && <span aria-hidden="true" class={ARROW} />}
        {item.kind === "branch" ? (
          <div class={`grid items-start gap-3 ${item.options.length >= 3 ? "lg:grid-cols-3" : ""} ${item.options.length >= 2 ? "sm:grid-cols-2" : ""}`}>
            {item.options.map((option) => (
              <div class="flex flex-col rounded-xl border border-dashed border-line-strong p-2.5">
                <p class="mb-2 self-center rounded-full bg-canvas-deep px-2.5 py-0.5 text-center text-[12.5px] font-semibold text-ink-mid">{option.label}</p>
                <Astro.self items={option.flow} />
              </div>
            ))}
          </div>
        ) : (
          <div class={`rounded-lg border px-3 py-2 text-[14.5px] leading-snug ${NODE_STYLES[item.kind].box}`}>
            <span class={`block text-[11px] font-bold uppercase tracking-[.06em] ${NODE_STYLES[item.kind].tag}`}>{NODE_STYLES[item.kind].label}</span>
            <span class="text-ink">{item.text}</span>
            {item.note && <span class="mt-0.5 block text-[13px] text-ink-soft">{item.note}</span>}
          </div>
        )}
      </>
    ))
  }
</div>

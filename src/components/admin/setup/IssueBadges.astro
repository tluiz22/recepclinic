---
// Selos das pendências de um cadastro nas listas de Configurações (F6.3b);
// no padrão do redesign (R9): âmbar, com ícone e a explicação ao passar o mouse.
import Pill from "../ui/Pill.astro";
import { ISSUE_HINTS, ISSUE_LABELS, type Issue } from "../../../lib/data/config/setup";

interface Props {
  issues?: Issue[];
  /** Explicação própria (ex.: agenda sem horário). */
  hints?: Partial<Record<Issue, string>>;
}

const { issues = [], hints = {} } = Astro.props;
---

{
  issues.map((issue) => (
    <span title={hints[issue] ?? ISSUE_HINTS[issue]}>
      <Pill tone="warning" icon="warning">
        {ISSUE_LABELS[issue]}
      </Pill>
    </span>
  ))
}

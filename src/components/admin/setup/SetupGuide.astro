---
// Guia de configuração (F6.3b): os passos em ordem, com a situação e o link
// para corrigir. Completo, vira uma linha; `compact` (nas outras abas) só
// avisa que há pendências e leva ao guia.
import Badge from "../Badge.astro";
import type { SetupStatus, StepStatus } from "../../../lib/data/config/setup";

interface Props {
  status: SetupStatus;
  compact?: boolean;
}

const { status, compact = false } = Astro.props;
const pending = status.steps.filter((s) => s.status !== "done");
const pendingCount = status.steps.reduce((total, s) => total + (s.status === "missing" ? 1 : s.items.length), 0);
const LABELS: Record<StepStatus, { text: string; variant: "success" | "warning" | "danger" }> = {
  done: { text: "Feito", variant: "success" },
  attention: { text: "Atenção", variant: "warning" },
  missing: { text: "Falta", variant: "danger" },
};
const MAX_ITEMS = 4;
---

{
  compact ? (
    pending.length > 0 && (
      <p class="mt-4 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">
        A configuração tem {pendingCount} pendência{pendingCount === 1 ? "" : "s"}.{" "}
        <a href="/admin/configuracoes#guia" class="font-medium underline">
          Ver o guia
        </a>
      </p>
    )
  ) : status.complete ? (
    <p id="guia" class="mt-4 rounded-md border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-800">
      Configuração completa: os serviços aparecem no bot e no link de agendar.
    </p>
  ) : (
    <section id="guia" class="mt-4 max-w-3xl rounded-lg border border-amber-200 bg-white p-4 shadow-sm">
      <h2 class="font-semibold text-slate-900">Guia de configuração</h2>
      <p class="mt-1 text-sm text-slate-600">Siga os passos em ordem. Cada pendência leva direto para onde corrigir.</p>
      <ol class="mt-3 divide-y divide-slate-100">
        {status.steps.map((step, index) => (
          <li class="py-2">
            <div class="flex flex-wrap items-center gap-2 text-sm">
              <span class="font-medium text-slate-900">
                {index + 1}.{" "}
                <a href={step.href} class="hover:underline">
                  {step.title}
                </a>
              </span>
              <Badge variant={LABELS[step.status].variant}>{LABELS[step.status].text}</Badge>
              {step.status === "missing" && (
                <a href={step.href} class="text-sky-700 hover:underline">
                  Cadastrar
                </a>
              )}
            </div>
            {step.items.length > 0 && (
              <ul class="mt-1 space-y-0.5 pl-4 text-sm text-slate-700">
                {step.items.slice(0, MAX_ITEMS).map((item) => (
                  <li>
                    <a href={item.href} class="hover:underline">
                      {item.text}
                    </a>
                  </li>
                ))}
                {step.items.length > MAX_ITEMS && (
                  <li class="text-slate-500">
                    e mais {step.items.length - MAX_ITEMS}.{" "}
                    <a href={step.href} class="text-sky-700 hover:underline">
                      Ver todos
                    </a>
                  </li>
                )}
              </ul>
            )}
          </li>
        ))}
      </ol>
    </section>
  )
}

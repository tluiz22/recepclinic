---
import ConfirmDeleteDialog from "./ConfirmDeleteDialog.astro";
import { buttonClass } from "./ui/styles";
// Botão de desativar/reativar de um cadastro (F4.3): mesmo formulário da
// rota de salvar, com o campo `acao`. Desativar pede confirmação no diálogo
// do painel (não no window.confirm, que mostra o endereço da página).
// Redesign R9 (cliente, 17/out/2026): numa área própria, separada do
// formulário, com o que acontece ao desativar.
interface Props {
  action: string;
  isActive: boolean;
  /** Ex.: "o profissional" — entra no título, no botão e na confirmação. */
  what: string;
}
const { action, isActive, what } = Astro.props;
const message = "Sai das telas de marcação; o histórico fica. Dá para reativar depois.";
---
<section class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-line bg-white p-4 sm:px-5" aria-labelledby="ativar-titulo">
  <div class="min-w-0">
    <h2 id="ativar-titulo" class="font-display text-base leading-tight font-bold text-ink">{isActive ? `Desativar ${what}` : `Reativar ${what}`}</h2>
    <p class="mt-1 text-sm text-ink-soft">{isActive ? message : "Está desativado: não aparece nas telas de marcação. Reativar traz de volta."}</p>
  </div>
  <form method="POST" action={action}>
    <input type="hidden" name="acao" value={isActive ? "desativar" : "reativar"} />
    <button
      type="submit"
      class={`${buttonClass(isActive ? "danger" : "secondary")} ${isActive ? "js-confirm-delete" : ""}`}
      data-confirm-title={`Desativar ${what}?`}
      data-confirm-message={message}
      data-confirm-label="Desativar"
    >
      {isActive ? "Desativar" : "Reativar"}
    </button>
  </form>
</section>
{isActive && <ConfirmDeleteDialog />}

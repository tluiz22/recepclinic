---
// Situação da conexão do WhatsApp da clínica: abas Lembretes (só leitura) e
// WhatsApp. Na aba WhatsApp (F8.1, `manage`), o Administrador e o Suporte
// conectam pela janela da Meta e, na coexistência, refazem a sincronização
// que a Meta exige em até 24 horas. F8.2: a situação das mensagens
// automáticas (templates) na conta, com o envio das que faltam. F8.3: forma de
// pagamento (o Suporte confere), "Desconectar WhatsApp" (trocar de número =
// desconectar e conectar de novo), o aviso da Meta de desconexão e o que muda
// no app na coexistência (documentação da Meta conferida em 25/out/2026).
import Badge from "./config/Badge.astro";
import ConfirmDeleteDialog from "./ConfirmDeleteDialog.astro";
import Card from "./config/Panel.astro";
import Notice from "./ui/Notice.astro";
import WhatsappSignupButton from "./WhatsappSignupButton.astro";
import { HINT, SECONDARY_BUTTON } from "./config/formStyles";
import { formatInstant } from "../../lib/clinicTime";
import type { WhatsappConnection } from "../../lib/data/whatsapp/connection";
import { describeTemplateApproval, type TemplateApproval } from "../../lib/data/whatsapp/templates";

interface Props {
  connection: WhatsappConnection | null;
  timeZone: string;
  /** Aba WhatsApp: botão "Conectar WhatsApp" (null = a conexão pela Meta não está ligada no sistema). */
  manage?: {
    signup: { appId: string; configId: string; graphVersion: string } | null;
    pendingSync: boolean;
    /** Templates em uso na conta da clínica (F8.2). */
    templates: TemplateApproval | null;
    /** Suporte: marca a forma de pagamento conferida (F8.3). */
    isSupport: boolean;
  };
}

const { connection, timeZone, manage } = Astro.props;
const status = {
  connected: { label: "Conectado", variant: "success" },
  pending: { label: "Em configuração", variant: "warning" },
  disconnected: { label: "Desconectado", variant: "danger" },
} as const;
const canConnect = !connection || connection.status === "disconnected";
const templates = connection?.status === "connected" ? (manage?.templates ?? null) : null;
const templatesText = templates ? describeTemplateApproval(templates) : null;
const connected = connection?.status === "connected";
const LINK = "font-semibold text-brand-ink underline-offset-2 hover:underline";
---

<Card>
  <h2 class="font-display text-[17px] leading-tight font-bold text-ink sm:text-lg">Conexão</h2>
  {
    connection ? (
      <p class="mt-2 text-sm text-ink-mid">
        <Badge variant={status[connection.status].variant}>{status[connection.status].label}</Badge>
        {connection.displayPhone && <span class="ml-1 font-medium">{connection.displayPhone}</span>}
        {connection.status === "connected" && connection.connectedAt && (
          <span class="text-ink-soft"> · desde {formatInstant(connection.connectedAt, timeZone, "dd/MM/yyyy")}</span>
        )}
      </p>
    ) : (
      <p class="mt-2 text-sm text-ink-mid">
        <Badge>Não conectado</Badge>
      </p>
    )
  }
  {
    connection?.status === "connected" && (
      <p class="mt-2 text-sm text-ink-mid">
        {connection.coexistence
          ? "A recepção continua no app WhatsApp Business deste número, e o bot atende pelo sistema."
          : "O número fica só no sistema, sem o app WhatsApp Business."}
      </p>
    )
  }

  {
    !manage ? (
      <p class={HINT}>
        A conexão do número fica em <a href="/admin/configuracoes/whatsapp" class="font-semibold text-brand-ink underline-offset-2 hover:underline">Configurações › WhatsApp</a>.
      </p>
    ) : canConnect ? (
      <div class="mt-3">
        <p class="text-sm text-ink-mid">
          Na janela da Meta, entre com o seu Facebook, escolha o portfólio da clínica e o número. Se a recepção já usa o número no app WhatsApp Business,
          escolha conectar o app: ela continua atendendo por ele (tenha o celular à mão para o código). Ou cadastre um número novo, só para o sistema.
        </p>
        {manage.signup ? (
          <div class="mt-3">
            <WhatsappSignupButton {...manage.signup} />
          </div>
        ) : (
          <p class="mt-3 text-sm text-pend-800">A conexão pela Meta ainda não está ligada no sistema. Fale com o suporte do RecepClinic.</p>
        )}
      </div>
    ) : null
  }

  {
    manage && connection?.status === "disconnected" && connection.disconnectedVia === "meta" && connection.disconnectedAt && (
      <Notice tone="warning" class="mt-3">
        A Meta avisou em {formatInstant(connection.disconnectedAt, timeZone, "dd/MM/yyyy 'às' HH:mm")} que o WhatsApp da clínica foi desconectado (pelo app
        WhatsApp Business ou na conta da Meta): o bot, os avisos e os lembretes pararam. Conecte de novo pelo botão acima.
      </Notice>
    )
  }

  {
    manage && canConnect && (
      <details class="mt-3 text-sm text-ink-mid">
        <summary class="cursor-pointer font-medium text-ink">O que muda no app WhatsApp Business ao conectar o app</summary>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          <li>As conversas individuais seguem no app e no sistema; os grupos continuam no app, mas não passam pelo sistema.</li>
          <li>Mensagens temporárias, de visualização única e a localização em tempo real ficam desligadas nas conversas individuais.</li>
          <li>Listas de transmissão: não dá para criar novas, e as que existem ficam só para leitura.</li>
          <li>Os aparelhos conectados (WhatsApp Web, computador) são desconectados e podem ser conectados de novo, menos o WhatsApp para Windows.</li>
          <li>As mensagens que a recepção manda pelo app continuam sem custo.</li>
        </ul>
      </details>
    )
  }

  {
    templates && (
      <div class="mt-3 border-t border-line pt-3 text-sm text-ink-mid">
        <p>
          <span class="font-medium text-ink">Mensagens automáticas na Meta:</span> {templatesText ?? "todas aprovadas."}
        </p>
        {templates.pending > 0 && <p class={HINT}>A análise da Meta leva de minutos a algumas horas e a aprovação chega sozinha. Até lá, esses envios não saem.</p>}
        {templates.rejected > 0 && <p class={HINT}>Recusada pela Meta: o suporte do RecepClinic ajusta o texto e reenvia.</p>}
        {templates.missing > 0 && (
          <form method="POST" action="/api/admin/configuracoes/whatsapp-templates" class="mt-2">
            <input type="hidden" name="acao" value="criar" />
            <button type="submit" class={SECONDARY_BUTTON}>Enviar à Meta as que faltam</button>
          </form>
        )}
      </div>
    )
  }

  {
    manage && connected && (
      <div class="mt-3 border-t border-line pt-3 text-sm text-ink-mid">
        <p>
          <span class="font-medium text-ink">Forma de pagamento na Meta:</span>{" "}
          {connection!.paymentCheckedAt
            ? `conferida pelo suporte do RecepClinic em ${formatInstant(connection!.paymentCheckedAt, timeZone, "dd/MM/yyyy")}.`
            : "ainda não conferida."}
        </p>
        {!connection!.paymentCheckedAt && (
          <p class={HINT}>
            A Meta cobra da clínica, direto, as mensagens automáticas (lembretes e avisos); sem a forma de pagamento elas não saem, e o bot continua
            respondendo quem escreve. Adicione em{" "}
            <a href="https://business.facebook.com/wa/manage/home/" target="_blank" rel="noopener noreferrer" class={LINK}>
              Gerenciador do WhatsApp
            </a>{" "}
            › Visão geral › Adicionar forma de pagamento, e avise o suporte do RecepClinic para conferir.
          </p>
        )}
        {manage.isSupport && (
          <form method="POST" action="/api/admin/configuracoes/whatsapp-pagamento" class="mt-2">
            <input type="hidden" name="conferida" value={connection!.paymentCheckedAt ? "nao" : "sim"} />
            <button type="submit" class={SECONDARY_BUTTON}>
              {connection!.paymentCheckedAt ? "Desmarcar a forma de pagamento" : "Forma de pagamento conferida (Suporte)"}
            </button>
          </form>
        )}
      </div>
    )
  }

  {
    manage && connected && (
      <div class="mt-3 border-t border-line pt-3">
        <form method="POST" action="/api/admin/configuracoes/whatsapp-desconectar">
          <button
            type="submit"
            class={`${SECONDARY_BUTTON} js-confirm-delete text-danger`}
            data-confirm-title="Desconectar o WhatsApp?"
            data-confirm-message={
              connection!.coexistence
                ? "O bot, os avisos e os lembretes param. A recepção continua no app WhatsApp Business; para terminar, desconecte também no app (Configurações › Conta › Plataforma comercial)."
                : "O bot, os avisos e os lembretes param, e o número sai do sistema."
            }
            data-confirm-label="Desconectar"
          >
            Desconectar WhatsApp
          </button>
        </form>
        <p class={HINT}>Para trocar de número: desconecte e conecte de novo com o número novo.</p>
        <ConfirmDeleteDialog />
      </div>
    )
  }

  {
    manage?.pendingSync && (
      <Notice tone="warning" class="mt-3">
        Falta uma etapa pedida pela Meta para o app WhatsApp Business (sincronização). Ela precisa ser feita nas primeiras 24 horas da conexão.
        <form method="POST" action="/api/admin/configuracoes/whatsapp-sincronizar" class="mt-2">
          <button type="submit" class={SECONDARY_BUTTON}>Sincronizar de novo</button>
        </form>
      </Notice>
    )
  }
</Card>

---
import { pageFlash } from "../../lib/flash";
import FormMessage from "./FormMessage.astro";

// Aviso deixado pela rota de formulário (salvo ou erro), mostrado uma vez.
// `data-flash` diz ao src/scripts/keepFormValues.ts se a tela voltou com erro;
// `data-fields`, quais campos falharam.
// `flash`: já lido pela moldura antes de uma espera (depois dela, a resposta
// já saiu e o cookie não é mais apagado: QA-02 da R9).
import type { Flash } from "../../lib/flash";

interface Props {
  flash?: Flash | null;
}

const flash = Astro.props.flash !== undefined ? Astro.props.flash : pageFlash(Astro);
---

{
  flash && (
    <div data-flash={flash.tone} data-fields={flash.fields?.join(" ")}>
      <FormMessage tone={flash.tone}>{flash.text}</FormMessage>
    </div>
  )
}

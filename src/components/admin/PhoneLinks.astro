---
// Telefone do admin com o atalho para o WhatsApp ao lado (Fase 23, pedido do
// cliente): o botão abre a conversa no WhatsApp do aparelho de quem está
// usando o painel. O número é texto simples, sem link de ligação (cliente,
// 05/out/2026: tudo se resolve pelo WhatsApp; no computador o `tel:` abria
// outro aplicativo e atrapalhava copiar o número).
import { formatPhoneBR, whatsappHref } from "../../lib/phone";

interface Props {
  phone: string;
  // Sem sublinhado/negrito, para tabelas e linhas de texto.
  plain?: boolean;
  class?: string;
}

const { phone, plain = false, class: className = "" } = Astro.props;
---

<span class={`inline-flex flex-wrap items-center gap-x-2 gap-y-1 ${className}`}>
  <span class={plain ? "" : "font-semibold text-slate-900"}>{formatPhoneBR(phone)}</span>
  <a
    href={whatsappHref(phone)}
    target="_blank"
    rel="noopener"
    aria-label={`Abrir conversa no WhatsApp com ${formatPhoneBR(phone)}`}
    class="rounded-md border border-emerald-600 px-2 py-0.5 text-xs font-semibold text-emerald-700 no-underline hover:bg-emerald-50"
  >
    WhatsApp
  </a>
</span>

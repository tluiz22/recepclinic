---
// Selo "Faltou X de Y" (Fase 23 · etapa 7) — só para paciente faltoso
// (`isFrequentNoShow`); não bloqueia nada, é um aviso para a equipe (por
// exemplo, ligar para confirmar).
import Badge from "./Badge.astro";
import { isFrequentNoShow, noShowLabel, type NoShowStats } from "../../lib/noShow";

interface Props {
  stats: NoShowStats | undefined;
}

const { stats } = Astro.props;
---

{
  stats && isFrequentNoShow(stats) && (
    <span title="Paciente com faltas frequentes: 2 ou mais faltas, em pelo menos metade dos atendimentos registrados">
      <Badge variant="danger">{noShowLabel(stats)}</Badge>
    </span>
  )
}

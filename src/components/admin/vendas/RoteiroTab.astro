const escape = (value: string) => value.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
// Campos [entre colchetes] em destaque.
const highlight = (text: string) => escape(text).replace(/\[([^\]]+)\]/g, '<mark class="rounded bg-amber-100 px-0.5 text-amber-900">[$1]</mark>');

const SECTIONS = [
  { id: "antes", label: "Antes de abordar" },
  { id: "dia", label: "O dia a dia" },
  { id: "sozinho", label: "O que roda sozinho" },
  { id: "desempenho", label: "Desempenho" },
  { id: "complemento", label: "Ao lado de quem" },
  { id: "ganhos", label: "Ganhos" },
  { id: "passos", label: "Passo a passo" },
  { id: "imagens", label: "Imagens" },
  { id: "mensagens", label: "Mensagens" },
  { id: "objecoes", label: "Objeções" },
];
---

<div class="mt-4 flex flex-col gap-4" id="roteiro">
  <Card class="border-conf-200 bg-[#f2faf7]">
    <p class={EYEBROW}>A frase de 15 segundos</p>
    <p class="mt-1 text-base text-ink">
      O RecepClinic tira a agenda das costas da equipe: no WhatsApp que a clínica já usa, o paciente marca, confirma, remarca
      e cancela sozinho, a qualquer hora. A secretária, ou o próprio profissional quando atende sozinho, fica livre para quem
      está na frente dele. E o dono acompanha, mês a mês, se a clínica está indo melhor.
    </p>
    <nav class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-[15px]" aria-label="Seções do roteiro">
      {SECTIONS.map((section) => <a href={`#${section.id}`} class="font-semibold text-brand hover:underline">{section.label}</a>)}
    </nav>
  </Card>

  <Card id="antes" class="scroll-mt-16">
    <p class={EYEBROW}>Antes de abordar</p>
    <h2 class={H2}>O que precisa estar pronto antes da primeira mensagem.</h2>
    <p class={MUTED}>Marque conforme for resolvendo. A marcação fica salva só neste navegador.</p>
    <ul class="mt-3 flex flex-col gap-3">
      {checklist.map((item) => (
        <li>
          <label class="flex items-start gap-3 text-[15px] text-ink-mid">
            <input type="checkbox" data-check={item.id} class="mt-0.5 h-[18px] w-[18px] accent-brand" />
            <span><strong class="text-ink">{item.title}</strong> {item.text}</span>
          </label>
        </li>
      ))}
    </ul>
  </Card>

  <Card id="dia" class="scroll-mt-16">
    <p class={EYEBROW}>O dia a dia com o RecepClinic</p>
    <h2 class={H2}>O tempo que volta para a equipe.</h2>
    <p class={MUTED}>
      Comece pelo perfil da clínica: tem secretária ou o profissional atende sozinho? Mostre o "hoje" que ela reconhece e o
      que muda.
    </p>
    <div class="mt-3 grid gap-4 lg:grid-cols-2">
      {days.map((profile) => (
        <section class="flex flex-col rounded-lg border border-line p-3">
          <h3 class="text-[15px] font-semibold text-ink">{profile.who}</h3>
          <ul class="mt-2 flex flex-col divide-y divide-[#e6ecea]">
            {profile.moments.map((moment) => (
              <li class="py-2.5 text-[15px]">
                <p class="text-xs font-bold uppercase tracking-[.06em] text-ink-soft">{moment.when}</p>
                <div class="mt-1.5 grid gap-2 sm:grid-cols-2">
                  <p class="rounded-lg bg-amber-50 px-2.5 py-2 text-ink-mid"><span class="block text-xs font-semibold text-amber-900">Hoje</span>{moment.today}</p>
                  <p class="rounded-lg bg-[#f2faf7] px-2.5 py-2 text-ink-mid"><span class="block text-xs font-semibold text-conf-800">Com o RecepClinic</span>{moment.with}</p>
                </div>
              </li>
            ))}
          </ul>
          <p class="mt-auto pt-2 text-[15px] font-medium text-ink">{profile.gain}</p>
        </section>
      ))}
    </div>
  </Card>

  <Card id="sozinho" class="scroll-mt-16">
    <p class={EYEBROW}>O que roda sozinho</p>
    <h2 class={H2}>Não é só um bot de WhatsApp. É a recepção inteira.</h2>
    <p class={MUTED}>
      Um bot sozinho responde mensagem. O RecepClinic junta a conversa, a agenda, as rotinas automáticas e os números da
      clínica, e cada parte tira um trabalho manual da equipe.
    </p>
    <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {layers.map((layer) => (
        <div class="rounded-lg border border-line p-3">
          <span class="text-xs font-bold uppercase tracking-[.06em] text-brand">{layer.tag}</span>
          <h3 class="mt-1 text-[15px] font-semibold text-ink">{layer.title}</h3>
          <ul class="mt-2 flex list-disc flex-col gap-1 pl-4 text-[15px] text-ink-mid">
            {layer.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </Card>

  <Card id="desempenho" class="scroll-mt-16">
    <p class={EYEBROW}>Acompanhe o desempenho da clínica</p>
    <h2 class={H2}>O dono para de adivinhar: as Métricas respondem.</h2>
    <p class={MUTED}>
      As perguntas que o dono faz e onde está a resposta no painel. Na demonstração, abra as Métricas da Clínica Vida Plena.
      A comparação com o mês anterior só aparece depois de um mês de uso (na demonstração, a partir de meados de novembro);
      até lá, mostre-a pela imagem ao lado.
    </p>
    <div class="mt-3 grid gap-4 lg:grid-cols-[1fr_minmax(0,22rem)]">
      <ul class="flex flex-col divide-y divide-[#e6ecea]">
        {questions.map((item) => (
          <li class="py-2.5 text-[15px]">
            <p class="font-semibold text-ink">{item.q} <span class="font-normal text-ink-soft">· {item.tab}</span></p>
            <p class="mt-0.5 text-ink-mid">{item.a}</p>
          </li>
        ))}
      </ul>
      <a href={metricas.src} target="_blank" rel="noopener" class="block self-start overflow-hidden rounded-lg border border-line bg-canvas">
        <img src={metricas.src} alt="Métricas › Desempenho com a comparação com o mês anterior (dados fictícios)" loading="lazy" class="w-full" />
      </a>
    </div>
    <p class="mt-3 rounded-lg border border-line bg-canvas p-3 text-[15px] text-ink-mid">
      <strong class="text-ink">As Métricas são adicionais</strong> ({metricsPrice} por mês) e vêm no Completo. No Básico, a
      clínica tem a agenda, o bot, o lembrete e o resumo do dia, sem os números.
    </p>
  </Card>

  <Card id="complemento" class="scroll-mt-16">
    <p class={EYEBROW}>Ao lado do que a clínica já usa</p>
    <h2 class={H2}>Concorre com a secretária sobrecarregada, não com o prontuário.</h2>
    <p class={MUTED}>
      Ferramentas como iClinic e Doctoralia são fortes no que fazem. O argumento não é "o meu é melhor": é mostrar o pedaço
      que elas não cobrem bem e que pesa na rotina. Antes de comparar, pergunte o que a clínica usa e quanto paga.
    </p>
    <div class="mt-3 overflow-x-auto rounded-xl border border-line">
      <table class="w-full min-w-[52rem] text-[15px]">
        <thead><tr><th class={TH}>A clínica já usa</th><th class={TH}>O que essa ferramenta faz bem</th><th class={TH}>O que o RecepClinic acrescenta</th><th class={TH}>Como dizer</th></tr></thead>
        <tbody class="divide-y divide-[#e6ecea]">
          {complements.map((row) => (
            <tr>
              <td class={`${TD} font-medium text-ink`}>{row.uses}{row.examples && <span class="block text-xs font-normal text-ink-soft">{row.examples}</span>}</td>
              <td class={`${TD} text-ink-soft`}>{row.good}</td>
              <td class={`${TD} text-ink-mid`}>{row.adds}</td>
              <td class={`${TD} italic text-ink-mid`}>"{row.say}"</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="mt-3 rounded-lg border border-line bg-canvas p-3 text-[15px] text-ink-mid">
      <strong class="text-ink">Seja claro sobre o limite.</strong> Hoje o RecepClinic não sincroniza com a agenda de outros
      sistemas. Se a clínica marca no iClinic (ou similar), a agenda de marcação passa a ser a do RecepClinic, e o prontuário
      segue no sistema dela. Dizer isso na primeira conversa evita frustração.
    </div>
  </Card>

  <Card id="ganhos" class="scroll-mt-16">
    <p class={EYEBROW}>Ganhos para a clínica</p>
    <h2 class={H2}>Mostre o ganho em reais e em horas, com os números dela.</h2>
    <p class={MUTED}>
      Preencha com a clínica na conversa. Os valores iniciais são um exemplo; a redução de faltas e o quanto o bot resolve
      sozinho são hipóteses para ajustar, não promessas.
    </p>
    <div class="mt-3 grid gap-4 md:grid-cols-2">
      <div class="grid gap-3 sm:grid-cols-2" id="ganho-campos">
        {fields.map((field) => (
          <label class="text-[15px] text-ink-mid">
            {field.label}
            <input type="number" min="0" max={field.max} step={field.step} value={field.value} data-field={field.id} class={`mt-1 block w-full ${INPUT_INLINE} py-1.5`} />
          </label>
        ))}
      </div>
      <div>
        <ul class="flex flex-col divide-y divide-[#e6ecea] text-[15px]" aria-live="polite">
          {results.map((result) => (
            <li class="flex items-center justify-between py-2">
              <span class="text-ink-soft">{result.label}</span>
              <strong class="text-ink" data-result={result.id}>—</strong>
            </li>
          ))}
        </ul>
        <p class="mt-2 text-xs text-ink-soft">
          Compare a receita recuperada com a mensalidade (Básico a partir de {basic}) e o custo das mensagens da Meta. Em geral,
          um ou dois atendimentos recuperados por mês já pagam a conta. Depois de começar, os números reais aparecem em
          Métricas › Desempenho, comparados com o mês anterior.
        </p>
      </div>
    </div>
  </Card>

  <Card id="passos" class="scroll-mt-16">
    <p class={EYEBROW}>Passo a passo</p>
    <h2 class={H2}>Da lista de clínicas à clínica funcionando.</h2>
    <ol class="mt-3 flex flex-col gap-3">
      {steps.map((step, i) => (
        <li class="flex gap-3">
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand text-sm font-bold text-white">{i + 1}</span>
          <div class="text-[15px]">
            <p class="font-semibold text-ink">{step.title} <span class="font-normal text-ink-soft">· {step.when}</span></p>
            <p class="mt-0.5 text-ink-mid">{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </Card>

  <Card id="imagens" class="scroll-mt-16">
    <p class={EYEBROW}>Imagens</p>
    <h2 class={H2}>Para mandar junto das mensagens.</h2>
    <p class={MUTED}>Tiradas das clínicas de demonstração, com dados fictícios. Toque em "Baixar" para salvar no celular ou no computador.</p>
    <div class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {images.map((image) => (
        <figure class="flex flex-col gap-2">
          <a href={image.src} target="_blank" rel="noopener" class="block overflow-hidden rounded-lg border border-line bg-canvas">
            <img src={image.src} alt={image.title} loading="lazy" class="h-64 w-full object-cover object-top" />
          </a>
          <figcaption class="text-[15px]">
            <span class="font-semibold text-ink">{image.title}</span>
            <span class="block text-xs text-ink-soft">{image.use}</span>
          </figcaption>
          <a href={image.src} download={image.file} class={`${buttonClass("secondary", "sm")} self-start`}>Baixar</a>
        </figure>
      ))}
    </div>
  </Card>

  <Card id="mensagens" class="scroll-mt-16">
    <p class={EYEBROW}>Mensagens prontas</p>
    <h2 class={H2}>Para copiar, trocar os campos em destaque e enviar.</h2>
    <p class={MUTED}>
      Mande uma por vez, de um número seu (nunca em massa) e só para o WhatsApp comercial da clínica. Um "não tenho interesse"
      encerra a conversa.
    </p>
    <div class="mt-3 grid gap-4 lg:grid-cols-2">
      {messages.map((message, i) => (
        <article class="flex flex-col gap-2 rounded-lg border border-line p-3">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="text-[15px] font-semibold text-ink">{message.title}</h3>
            <span class="text-xs text-ink-soft">{message.when}</span>
          </div>
          <div class="whitespace-pre-line rounded-lg rounded-tl-none bg-[#dcf8c6] px-3 py-2 text-[15px] text-ink" id={`msg-${i + 1}`} data-text={message.text} set:html={highlight(message.text)} />
          <div class="flex flex-wrap items-center gap-3">
            <button type="button" data-copy={`msg-${i + 1}`} class={buttonClass("secondary", "sm")}>Copiar mensagem</button>
            <span class="text-xs text-conf-800" role="status" data-copied={`msg-${i + 1}`}></span>
            {message.tip && <span class="text-xs text-ink-soft">{message.tip}</span>}
          </div>
        </article>
      ))}
    </div>
  </Card>

  <Card id="objecoes" class="scroll-mt-16">
    <p class={EYEBROW}>Objeções</p>
    <h2 class={H2}>O que a clínica costuma dizer, e como responder.</h2>
    <div class="mt-2 flex flex-col divide-y divide-[#e6ecea]">
      {objections.map((objection) => (
        <details class="py-2">
          <summary class="cursor-pointer text-[15px] font-medium text-ink">{objection.q}</summary>
          <div class="mt-2 flex flex-col gap-2 text-[15px] text-ink-mid">
            {objection.a.map((paragraph) => <p set:html={highlight(paragraph)} />)}
            {objection.note && <p class="text-xs text-ink-soft">{objection.note}</p>}
          </div>
        </details>
      ))}
    </div>
  </Card>

  <Card>
    <p class={EYEBROW}>Notas</p>
    <h2 class={H2}>De onde vêm os números e o que conferir.</h2>
    <ul class="mt-2 flex list-disc flex-col gap-1 pl-5 text-[15px] text-ink-mid">
      <li>Preços de iClinic, Doctoralia, Feegow, Amplimed e de secretárias virtuais não estão aqui de propósito: não há tabela oficial e atual pública. Pergunte ao cliente quanto ele paga.</li>
      <li>Redução de faltas com lembrete: os "30 a 40%" que circulam vêm de fornecedores, sem metodologia. Use a calculadora como hipótese, nunca como promessa.</li>
      <li>Custo das mensagens: dentro da janela de 24h, respostas e templates de utilidade não são cobrados; fora dela, só template, cobrado.</li>
      {sources.map((source) => <li><a href={source.href} target="_blank" rel="noopener" class="font-semibold text-brand hover:underline">{source.label}</a></li>)}
    </ul>
  </Card>
</div>

<script>
  // Lista "Antes de abordar": lembrada só neste navegador.
  document.querySelectorAll<HTMLInputElement>("#roteiro [data-check]").forEach((box) => {
    const key = `vendas-roteiro-${box.dataset.check}`;
    try {
      box.checked = localStorage.getItem(key) === "1";
    } catch {
      /* sem armazenamento: a lista começa desmarcada */
    }
    box.addEventListener("change", () => {
      try {
        localStorage.setItem(key, box.checked ? "1" : "0");
      } catch {
        /* sem armazenamento */
      }
    });
  });

  // Copiar mensagem: área de transferência; se recusar, seleciona o texto.
  document.querySelectorAll<HTMLButtonElement>("#roteiro [data-copy]").forEach((button) => {
    button.addEventListener("click", () => {
      const id = button.dataset.copy!;
      const bubble = document.getElementById(id)!;
      const status = document.querySelector<HTMLElement>(`[data-copied="${id}"]`)!;
      const selectText = () => {
        const range = document.createRange();
        range.selectNodeContents(bubble);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
        status.textContent = "Texto selecionado: use Copiar do seu aparelho.";
      };
      if (!navigator.clipboard) return selectText();
      navigator.clipboard.writeText(bubble.dataset.text ?? bubble.innerText).then(() => {
        status.textContent = "Copiada.";
        setTimeout(() => (status.textContent = ""), 2500);
      }, selectText);
    });
  });

  // Calculadora de ganho.
  const value = (id: string, max = Infinity) =>
    Math.min(max, Math.max(0, Number(document.querySelector<HTMLInputElement>(`[data-field="${id}"]`)?.value) || 0));
  const show = (id: string, text: string) => {
    const el = document.querySelector<HTMLElement>(`[data-result="${id}"]`);
    if (el) el.textContent = text;
  };
  const money = (v: number) => v.toLocaleString("pt-BR", { style: "currency", currency: "BRL", maximumFractionDigits: 0 });
  function calc() {
    const missed = value("consultas") * (value("faltas", 100) / 100);
    const recovered = missed * (value("reducao", 100) / 100);
    const price = value("valor");
    show("faltas", Math.round(missed).toLocaleString("pt-BR"));
    show("perda", money(missed * price));
    show("recuperados", Math.round(recovered).toLocaleString("pt-BR"));
    show("receita", money(recovered * price));
    const hours = (value("conversas") * value("minutos") * (value("bot", 100) / 100) * value("dias", 31)) / 60;
    show("horas", `${hours.toLocaleString("pt-BR", { maximumFractionDigits: 0 })} h`);
  }
  document.querySelectorAll("#ganho-campos input").forEach((input) => input.addEventListener("input", calc));
  calc();
</script>

---
// Vendas › Demonstração (cliente, 11/out/2026): as clínicas de demonstração
// (uma por plano), os logins, como criar ou atualizar pelo script, o chip de
// testes e o roteiro da apresentação. Os dados das clínicas ficam em
// scripts/demo-clinicas.mjs: atualizar esta aba junto com o script.
import Card from "../Card.astro";
import { formatInstant, DEFAULT_TIMEZONE } from "../../../lib/clinicTime";
import { createUserClient } from "../../../lib/data/clients";
import { unwrap } from "../../../lib/data/errors";

const DEMO_CLINICS = [
  {
    id: "de000000-0000-4000-8000-000000000001",
    name: "Pediatria Sol Nascente",
    plan: "Básico",
    login: "demo.basico@recepclinic.com.br",
    team: "Dra. Laura Mendes (pediatra)",
    shows: "O essencial: agenda com as cores, bot marcando consulta e retorno, lembrete e resumo do dia ao profissional.",
  },
  {
    id: "de000000-0000-4000-8000-000000000002",
    name: "Odonto Sorriso Leve",
    plan: "Básico + Exames e procedimentos + Lista de espera",
    login: "demo.odonto@recepclinic.com.br",
    team: "Dr. Felipe Andrade (dentista)",
    shows: "Procedimentos (limpeza, restauração, clareamento com preparo), lista de espera e as mensagens chamando de \"o consultório\".",
  },
  {
    id: "de000000-0000-4000-8000-000000000003",
    name: "Clínica Vida Plena",
    plan: "Completo",
    login: "demo.completo@recepclinic.com.br",
    team: "Dr. Marcos Ribeiro (clínico geral), Dra. Camila Torres (pediatra), Dra. Renata Lopes (cardiologista)",
    shows: "Tudo: 3 agendas, eletrocardiograma, consulta domiciliar, convênios, bloqueio, lista de espera, Aguardando remarcação e as Métricas com 3 semanas de histórico (inclusive o funil do bot).",
  },
];

const db = createUserClient(Astro.request, Astro.cookies);
const ids = DEMO_CLINICS.map((clinic) => clinic.id);
const [clinics, connections] = await Promise.all([
  db.from("clinics").select("id, created_at").in("id", ids),
  db.from("whatsapp_connections").select("clinic_id, display_phone").in("clinic_id", ids),
]);
const builtAt = new Map(unwrap(clinics, "Clínicas de demonstração").map((row) => [row.id, new Date(row.created_at)]));
const chip = unwrap(connections, "Conexões das demos")[0] ?? null;
const when = (date: Date) => formatInstant(date, DEFAULT_TIMEZONE, "dd/MM/yyyy 'às' HH:mm");

const CMD = "mt-2 overflow-x-auto rounded-lg bg-slate-900 px-3 py-2 font-mono text-xs text-slate-100";
const TH = "py-2 pr-4 text-left font-medium text-slate-500";
const TD = "py-2 pr-4 align-top";

const script = [
  { time: "2 min", what: "Pergunte como é a agenda hoje: quem responde o WhatsApp, quantas faltas, o que acontece à noite.", line: "Me conta como é um dia normal da recepção." },
  { time: "5 min", what: "Com o chip na Vida Plena, o cliente manda \"Oi\" no número de testes pelo celular dele e marca uma consulta até escolher o horário no link. Sem o chip, mostre a Agenda e os cartões marcados pelo WhatsApp.", line: "Isso aconteceu sem ninguém da equipe." },
  { time: "3 min", what: "Agenda do dia na Vida Plena: as cores da situação, \"Presença confirmada\" vinda do lembrete, o selo WhatsApp.", line: "A secretária abre a agenda e já sabe quem vem." },
  { time: "3 min", what: "Bloquear um dia (Agenda › Bloquear) e mostrar o \"Aguardando remarcação\" no Resumo do Dia: cada paciente recebe o aviso com o link para remarcar.", line: "Imprevisto não vira tarde de ligações." },
  { time: "2 min", what: "Lista de espera (Resumo do Dia › Lista de espera): a vaga cancelada é oferecida para quem quer antecipar.", line: "A falta de um vira o encaixe de outro." },
  { time: "2 min", what: "Métricas da Vida Plena, período Personalizado das últimas semanas: faltas, origem das marcações e o Funil do bot.", line: "Você vê quanto o bot resolveu sozinho." },
  { time: "3 min", what: "Próximos passos: plano (aba Planos, simule ali mesmo), implantação, data de início e o que a clínica precisa mandar.", line: "Posso te mandar a proposta hoje?" },
];
---

<div class="mt-4 flex flex-col gap-4">
  <p class="text-sm text-slate-600">
    Três clínicas fictícias no staging, uma por plano, para mostrar o RecepClinic com a cara de quem está assistindo.
    Nomes, pacientes e telefones são inventados; sem WhatsApp conectado, nada é enviado.
  </p>

  <Card>
    <h2 class="font-semibold text-slate-900">Clínicas e logins</h2>
    <div class="mt-2 overflow-x-auto">
      <table class="w-full min-w-[44rem] text-sm">
        <thead><tr><th class={TH}>Clínica</th><th class={TH}>Plano</th><th class={TH}>Equipe</th><th class={TH}>Login (Administrador)</th><th class={TH}>Situação</th></tr></thead>
        <tbody class="divide-y divide-slate-100">
          {DEMO_CLINICS.map((clinic) => (
            <tr>
              <td class={TD}>
                <span class="font-medium text-slate-900">{clinic.name}</span>
                <span class="block text-xs text-slate-500">{clinic.shows}</span>
              </td>
              <td class={TD}>{clinic.plan}</td>
              <td class={`${TD} text-slate-600`}>{clinic.team}</td>
              <td class={`${TD} font-mono text-xs`}>{clinic.login}</td>
              <td class={`${TD} text-xs`}>
                {builtAt.has(clinic.id) ? (
                  <span class="text-slate-600">Montada em {when(builtAt.get(clinic.id)!)}</span>
                ) : (
                  <span class="text-amber-700">Ainda não criada</span>
                )}
                {chip?.clinic_id === clinic.id && <span class="block font-medium text-emerald-700">Com o chip de testes</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-2 text-xs text-slate-500">
      Os atendimentos começam no dia em que o script rodou: atualize as demos na véspera de cada apresentação.
    </p>
  </Card>

  <Card>
    <h2 class="font-semibold text-slate-900">Criar ou atualizar as demos</h2>
    <p class="mt-1 text-sm text-slate-600">
      No Terminal, na pasta do projeto. O mesmo comando cria (na primeira vez) e atualiza: apaga e monta de novo só estas 3
      clínicas, com os atendimentos a partir de hoje, e mantém os logins e as senhas. Nenhuma outra clínica é tocada.
    </p>
    <ol class="mt-3 flex list-decimal flex-col gap-3 pl-5 text-sm text-slate-700">
      <li>
        Simular (mostra o que vai fazer, sem mudar nada):
        <pre class={CMD}>node --env-file=.env.staging scripts/demo-clinicas.mjs</pre>
      </li>
      <li>
        Aplicar:
        <pre class={CMD}>node --env-file=.env.staging scripts/demo-clinicas.mjs --confirmar</pre>
      </li>
      <li>Conferir aqui: a coluna Situação mostra a hora em que cada clínica foi montada.</li>
    </ol>
    <p class="mt-3 text-xs text-slate-500">
      Atualizar apaga o que foi feito nas demos (marcações, bloqueios, conversas da demonstração anterior). Com o chip na Vida
      Plena, o script não roda: devolva o chip antes.
    </p>
  </Card>

  <Card>
    <h2 class="font-semibold text-slate-900">Senha dos logins</h2>
    <p class="mt-1 text-sm text-slate-600">
      Só na primeira vez (a senha continua valendo depois de atualizar as demos) ou se esquecer. O comando mostra um link que
      vale 1 hora; abra, crie a senha e entre em app.recepclinic.com.br.
    </p>
    <pre class={CMD}>{DEMO_CLINICS.map((clinic) => `node --env-file=.env.staging scripts/link-de-senha.mjs ${clinic.login}`).join("\n")}</pre>
    <p class="mt-2 text-xs text-slate-500">
      Na demonstração, entre com o login da clínica (não com o do Suporte): o cliente vê a tela como a clínica dele veria.
    </p>
  </Card>

  <Card>
    <h2 class="font-semibold text-slate-900">Chip de testes (conversa ao vivo)</h2>
    <p class="mt-1 text-sm text-slate-600">
      O número de testes atende uma clínica de cada vez e fica na <strong>Consultorio Tluiz22</strong>. Para o cliente conversar
      com o bot da Vida Plena, passe o chip antes da apresentação e devolva depois. Com o chip, a Vida Plena fica com os envios
      automáticos desligados (os telefones dos pacientes são fictícios).
    </p>
    <p class="mt-2 text-sm">
      Agora: <strong>{chip ? `na Clínica Vida Plena (${chip.display_phone ?? "número de testes"})` : "fora das demos"}</strong>.
    </p>
    <p class="mt-3 text-sm text-slate-700">Passar para a Vida Plena:</p>
    <pre class={CMD}>node --env-file=.env.staging scripts/demo-clinicas.mjs --chip-para-demo --confirmar</pre>
    <p class="mt-3 text-sm text-slate-700">Devolver para a Consultorio Tluiz22:</p>
    <pre class={CMD}>node --env-file=.env.staging scripts/demo-clinicas.mjs --chip-devolver --confirmar</pre>
    <p class="mt-2 text-xs text-slate-500">Sem o --confirmar, os dois só mostram o que fariam.</p>
  </Card>

  <Card>
    <h2 class="font-semibold text-slate-900">Roteiro da apresentação</h2>
    <p class="mt-1 text-sm text-slate-600">
      Vinte minutos, nesta ordem, com o login da Vida Plena (ou da clínica com o perfil de quem assiste). Deixe o cliente pegar
      o próprio celular.
    </p>
    <div class="mt-2 overflow-x-auto">
      <table class="w-full min-w-[40rem] text-sm">
        <thead><tr><th class={TH}>Tempo</th><th class={TH}>O que mostrar</th><th class={TH}>A frase que fica</th></tr></thead>
        <tbody class="divide-y divide-slate-100">
          {script.map((step) => (
            <tr>
              <td class={`${TD} whitespace-nowrap font-medium text-slate-900`}>{step.time}</td>
              <td class={`${TD} text-slate-700`}>{step.what}</td>
              <td class={`${TD} italic text-slate-600`}>"{step.line}"</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <h3 class="mt-4 text-sm font-semibold uppercase tracking-wide text-slate-500">Antes de cada apresentação</h3>
    <ul class="mt-2 flex list-disc flex-col gap-1 pl-5 text-sm text-slate-700">
      <li>Na véspera: atualizar as demos (acima).</li>
      <li>Se for mostrar a conversa ao vivo: passar o chip para a Vida Plena e testar mandando um "Oi".</li>
      <li>Escolher a demo pelo perfil do cliente: pediatra → Pediatria Sol Nascente; dentista → Odonto Sorriso Leve; clínica com vários profissionais → Vida Plena.</li>
      <li>Depois: devolver o chip.</li>
    </ul>
  </Card>
</div>

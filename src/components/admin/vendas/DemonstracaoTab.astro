---
// Vendas › Demonstração (cliente, 11/out/2026; carga completa e senhas em
// 02/nov/2026): as 4 clínicas de demonstração, os logins com a senha, como
// criar ou atualizar pelo script, onde está cada cenário, o chip de testes e o
// roteiro da apresentação. Os dados das clínicas ficam em
// scripts/demo-clinicas.mjs: atualizar esta aba junto com o script. As senhas
// ficam no login (app_metadata), nunca no código: o repositório é público.
import Card from "../config/Panel.astro";
import { formatInstant, DEFAULT_TIMEZONE } from "../../../lib/clinicTime";
import { createUserClient } from "../../../lib/data/clients";
import { unwrap } from "../../../lib/data/errors";
import { loadDemoPasswords } from "../../../lib/data/platform";
import { logError } from "../../../lib/log";

const DEMO_CLINICS = [
  {
    id: "4dbeccc6-61da-4e7f-84d7-e42f5a95b071",
    name: "Clínica Demonstração RecepClinic",
    plan: "Tudo ligado (menos o Financeiro)",
    login: "demo.recepclinic@recepclinic.com.br",
    team: "Dra. Helena Duarte (clínica médica), Dr. Rafael Moreira (ortopedia), Dra. Paula Sena (pediatria), Bianca Freitas (psicóloga) e a agenda de Exames",
    shows: "A vitrine completa: 5 agendas, eletrocardiograma e ultrassom com preparo, domiciliar, 4 convênios, séries semanais da psicóloga, lista de espera, Para contatar com anotações e lembretes da equipe, e as Métricas.",
  },
  {
    id: "de000000-0000-4000-8000-000000000003",
    name: "Clínica Vida Plena",
    plan: "Completo",
    login: "demo.completo@recepclinic.com.br",
    team: "Dr. Marcos Ribeiro (clínico geral), Dra. Camila Torres (pediatra), Dra. Renata Lopes (cardiologista) e a agenda de Exames",
    shows: "Clínica médica com vários profissionais: eletrocardiograma, consulta domiciliar, 3 convênios, bloqueio, lista de espera e as Métricas. É a demo que recebe o chip para a conversa ao vivo.",
  },
  {
    id: "de000000-0000-4000-8000-000000000002",
    name: "Odonto Sorriso Leve",
    plan: "Básico + Exames e procedimentos + Lista de espera",
    login: "demo.odonto@recepclinic.com.br",
    team: "Dr. Felipe Andrade (dentista)",
    shows: "Procedimentos (limpeza, restauração, clareamento com preparo), lista de espera e as mensagens chamando de \"o consultório\".",
  },
  {
    id: "de000000-0000-4000-8000-000000000001",
    name: "Pediatria Sol Nascente",
    plan: "Básico",
    login: "demo.basico@recepclinic.com.br",
    team: "Dra. Laura Mendes (pediatra)",
    shows: "O essencial: agenda, bot marcando consulta e retorno, lembrete, resumo do dia e o limite de idade da pediatria.",
  },
];

const db = createUserClient(Astro.request, Astro.cookies);
const ids = DEMO_CLINICS.map((clinic) => clinic.id);
const [clinics, connections, passwords] = await Promise.all([
  db.from("clinics").select("id, created_at").in("id", ids),
  db.from("whatsapp_connections").select("clinic_id, display_phone").in("clinic_id", ids),
  loadDemoPasswords(DEMO_CLINICS.map((clinic) => clinic.login)).catch((error) => {
    logError("vendas: senhas das demos", error);
    return null;
  }),
]);
const builtAt = new Map(unwrap(clinics, "Clínicas de demonstração").map((row) => [row.id, new Date(row.created_at)]));
const chip = unwrap(connections, "Conexões das demos")[0] ?? null;
const when = (date: Date) => formatInstant(date, DEFAULT_TIMEZONE, "dd/MM/yyyy 'às' HH:mm");

const CMD = "mt-2 overflow-x-auto rounded-lg bg-ink px-3 py-2 font-mono text-xs text-white";
const TH = "border-b border-line bg-[#f8faf9] px-3 py-2.5 text-left text-[13px] leading-snug font-semibold text-ink-soft";
const TD = "px-3 py-2.5 align-top";

// Onde mostrar cada cenário (os nomes das telas são os do menu da clínica).
const scenarios = [
  { what: "Agenda do dia e da semana com horários livres", where: "Agenda", clinics: "Todas" },
  { what: "Agendado, atendido, faltou, cancelado e remarcado", where: "Agenda (cores e selos) e Relatório do dia", clinics: "Todas" },
  { what: "Marcado pelo bot × pela recepção", where: "Agenda (selo WhatsApp) e Métricas", clinics: "Todas" },
  { what: "Lembrete: presença confirmada, sem resposta e não entregue (botão Reenviar)", where: "Agenda e Pacientes › Para contatar › Lembretes", clinics: "Todas (amanhã, depois das 18h do dia anterior)" },
  { what: "Retorno ligado à consulta de origem e quem ainda tem direito", where: "Agenda e Para contatar › Retorno", clinics: "Todas" },
  { what: "Exame e procedimento com orientação de preparo", where: "Agenda e Configurações › Serviços", clinics: "Demonstração, Vida Plena, Odonto" },
  { what: "Consulta domiciliar com endereço", where: "Agenda (quinta à tarde)", clinics: "Demonstração, Vida Plena" },
  { what: "Convênio com carteirinha", where: "Pacientes (ficha) e Agenda", clinics: "Demonstração, Vida Plena" },
  { what: "Bloqueio com cancelamento em massa", where: "Agenda e Para contatar › Aguardando remarcação", clinics: "Todas" },
  { what: "Bloqueio sem ninguém marcado (congresso)", where: "Agenda", clinics: "Demonstração, Vida Plena" },
  { what: "Feriado da clínica (recesso)", where: "Agenda e Configurações › Feriados", clinics: "Todas" },
  { what: "Lista de espera: na fila e um antecipado por oferta aceita", where: "Para contatar › Lista de espera", clinics: "Demonstração, Vida Plena, Odonto" },
  { what: "Séries semanais (sessões de psicoterapia)", where: "Agenda (agenda da Bianca)", clinics: "Demonstração" },
  { what: "Conversas que pedem a recepção: aguardando e em atendimento", where: "Meu dia (faixa) e Para contatar › Atendimento", clinics: "Todas" },
  { what: "Tentativas do bot que pararam no meio", where: "Para contatar › Retomar contato e Métricas", clinics: "Todas" },
  { what: "Faltosos (2 faltas ou mais)", where: "Para contatar › Faltosos e Métricas", clinics: "Todas" },
  { what: "Contato que atingiu o limite do bot", where: "Para contatar › Contatos para revisar", clinics: "Demonstração, Vida Plena" },
  { what: "Família no mesmo contato (irmãos, mãe e filho)", where: "Pacientes", clinics: "Todas" },
  { what: "Anotações e lembretes da equipe (vencidos, de hoje e futuros)", where: "Pacientes (ficha) e Para contatar › Lembretes da equipe", clinics: "Demonstração" },
  { what: "Histórico de 3 semanas: faltas, origem das marcações, funil do bot", where: "Métricas (período das últimas semanas)", clinics: "Demonstração, Vida Plena" },
];

const script = [
  { time: "2 min", what: "Pergunte como é a agenda hoje: quem responde o WhatsApp, quantas faltas, o que acontece à noite.", line: "Me conta como é um dia normal da recepção." },
  { time: "5 min", what: "Com o chip na Vida Plena, o cliente manda \"Oi\" no número de testes pelo celular dele e marca uma consulta até escolher o horário no link. Sem o chip, mostre a Agenda e os cartões marcados pelo WhatsApp.", line: "Isso aconteceu sem ninguém da equipe." },
  { time: "3 min", what: "Meu dia e Agenda: as cores da situação, \"Presença confirmada\" vinda do lembrete, o selo WhatsApp e a conversa aguardando a recepção.", line: "A secretária abre a agenda e já sabe quem vem." },
  { time: "3 min", what: "Bloqueio já feito na agenda e o \"Aguardando remarcação\" em Pacientes › Para contatar: cada paciente recebe o aviso com o link para remarcar.", line: "Imprevisto não vira tarde de ligações." },
  { time: "2 min", what: "Para contatar › Lista de espera: a vaga cancelada é oferecida para quem quer antecipar (veja o antecipado).", line: "A falta de um vira o encaixe de outro." },
  { time: "2 min", what: "Para contatar › Retomar contato, Faltosos e Retorno: quem a equipe deve procurar hoje.", line: "Ninguém fica esquecido." },
  { time: "2 min", what: "Métricas, período das últimas semanas: faltas, origem das marcações e o Agendamento digital (funil do bot).", line: "Você vê quanto o bot resolveu sozinho." },
  { time: "3 min", what: "Próximos passos: plano (aba Planos, simule ali mesmo), implantação, data de início e o que a clínica precisa mandar.", line: "Posso te mandar a proposta hoje?" },
];
---

<div class="mt-4 flex flex-col gap-4">
  <p class="text-[15px] text-ink-soft">
    Quatro clínicas fictícias no staging, para mostrar o RecepClinic com a cara de quem está assistindo. Cada uma tem a agenda
    das 3 últimas semanas até 2 semanas à frente, com todos os cenários do plano dela. Nomes, pacientes e telefones são
    inventados; sem WhatsApp conectado, nada é enviado. O módulo Financeiro fica de fora (ainda não está pronto).
  </p>

  <Card>
    <h2 class="font-display text-[17px] leading-tight font-bold text-ink sm:text-lg">Clínicas, logins e senhas</h2>
    <p class="mt-1 text-[15px] text-ink-soft">Entre em <strong>teste.recepclinic.com.br</strong> (as demos ficam no staging) com o login de Administrador da clínica.</p>
    <div class="mt-3 overflow-x-auto rounded-xl border border-line">
      <table class="w-full min-w-[52rem] text-[15px]">
        <thead><tr><th class={TH}>Clínica</th><th class={TH}>Plano</th><th class={TH}>Equipe</th><th class={TH}>Login e senha</th><th class={TH}>Situação</th></tr></thead>
        <tbody class="divide-y divide-[#e6ecea]">
          {DEMO_CLINICS.map((clinic) => (
            <tr>
              <td class={TD}>
                <span class="font-medium text-ink">{clinic.name}</span>
                <span class="block text-xs text-ink-soft">{clinic.shows}</span>
              </td>
              <td class={TD}>{clinic.plan}</td>
              <td class={`${TD} text-ink-soft`}>{clinic.team}</td>
              <td class={`${TD} font-mono text-xs`}>
                <span class="block">{clinic.login}</span>
                {passwords?.get(clinic.login) ? (
                  <span class="mt-1 block font-semibold text-ink">{passwords.get(clinic.login)}</span>
                ) : (
                  <span class="mt-1 block font-sans text-pend-800">{passwords ? "Sem senha: rode o script (abaixo)" : "Não foi possível ler a senha"}</span>
                )}
              </td>
              <td class={`${TD} text-xs`}>
                {builtAt.has(clinic.id) ? (
                  <span class="text-ink-soft">Montada em {when(builtAt.get(clinic.id)!)}</span>
                ) : (
                  <span class="text-pend-800">Ainda não criada</span>
                )}
                {chip?.clinic_id === clinic.id && <span class="block font-medium text-conf-800">Com o chip de testes</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-2 text-xs text-ink-soft">
      Os atendimentos contam a partir do dia em que o script rodou: atualize as demos na véspera de cada apresentação. A senha
      continua a mesma depois de atualizar.
    </p>
  </Card>

  <Card>
    <h2 class="font-display text-[17px] leading-tight font-bold text-ink sm:text-lg">Criar ou atualizar as demos</h2>
    <p class="mt-1 text-[15px] text-ink-soft">
      No Terminal, na pasta do projeto. O mesmo comando cria (na primeira vez) e atualiza: apaga e monta de novo só estas 4
      clínicas, com a agenda a partir de hoje, e mantém os logins e as senhas. Nenhuma outra clínica é tocada.
    </p>
    <ol class="mt-3 flex list-decimal flex-col gap-3 pl-5 text-[15px] text-ink-mid">
      <li>
        Simular (monta e desfaz, mostrando os números de cada clínica):
        <pre class={CMD}>node --env-file=.env.staging scripts/demo-clinicas.mjs</pre>
      </li>
      <li>
        Aplicar:
        <pre class={CMD}>node --env-file=.env.staging scripts/demo-clinicas.mjs --confirmar</pre>
      </li>
      <li>Conferir aqui: a coluna Situação mostra a hora em que cada clínica foi montada.</li>
    </ol>
    <p class="mt-3 text-xs text-ink-soft">
      Atualizar apaga o que foi feito nas demos (marcações, bloqueios, conversas da demonstração anterior). Com o chip na Vida
      Plena, o script não roda: devolva o chip antes.
    </p>
  </Card>

  <Card>
    <h2 class="font-display text-[17px] leading-tight font-bold text-ink sm:text-lg">Senhas</h2>
    <p class="mt-1 text-[15px] text-ink-soft">
      O script cria a senha de cada login que ainda não tem e guarda no próprio login (fora do código, que é público); esta
      página mostra a senha só ao Suporte. Para trocar todas (por exemplo, depois de passar a senha a um cliente):
    </p>
    <pre class={CMD}>node --env-file=.env.staging scripts/demo-clinicas.mjs --confirmar --trocar-senhas</pre>
    <p class="mt-2 text-xs text-ink-soft">
      Não troque a senha pelo "Esqueci minha senha" nem pelo scripts/link-de-senha.mjs: a senha nova não aparece aqui. Na
      demonstração, entre com o login da clínica (não com o do Suporte): o cliente vê a tela como a clínica dele veria.
    </p>
  </Card>

  <Card>
    <h2 class="font-display text-[17px] leading-tight font-bold text-ink sm:text-lg">Onde está cada cenário</h2>
    <div class="mt-3 overflow-x-auto rounded-xl border border-line">
      <table class="w-full min-w-[44rem] text-[15px]">
        <thead><tr><th class={TH}>Cenário</th><th class={TH}>Onde mostrar</th><th class={TH}>Clínicas</th></tr></thead>
        <tbody class="divide-y divide-[#e6ecea]">
          {scenarios.map((s) => (
            <tr>
              <td class={`${TD} text-ink`}>{s.what}</td>
              <td class={`${TD} text-ink-mid`}>{s.where}</td>
              <td class={`${TD} text-xs text-ink-soft`}>{s.clinics}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-2 text-xs text-ink-soft">
      Cerca de 65% dos horários ficam ocupados (menos nos dias mais distantes), para sobrar horário livre na hora de marcar ao
      vivo. Em feriado nacional, o dia fica sem atendimentos, como na agenda real.
    </p>
  </Card>

  <Card>
    <h2 class="font-display text-[17px] leading-tight font-bold text-ink sm:text-lg">Chip de testes (conversa ao vivo)</h2>
    <p class="mt-1 text-[15px] text-ink-soft">
      O número de testes atende uma clínica de cada vez e fica na <strong>Consultorio Tluiz22</strong>. Para o cliente conversar
      com o bot da Vida Plena, passe o chip antes da apresentação e devolva depois. Com o chip, a Vida Plena fica com os envios
      automáticos desligados (os telefones dos pacientes são fictícios).
    </p>
    <p class="mt-2 text-[15px]">
      Agora: <strong>{chip ? `na Clínica Vida Plena (${chip.display_phone ?? "número de testes"})` : "fora das demos"}</strong>.
    </p>
    <p class="mt-3 text-[15px] text-ink-mid">Passar para a Vida Plena:</p>
    <pre class={CMD}>node --env-file=.env.staging scripts/demo-clinicas.mjs --chip-para-demo --confirmar</pre>
    <p class="mt-3 text-[15px] text-ink-mid">Devolver para a Consultorio Tluiz22:</p>
    <pre class={CMD}>node --env-file=.env.staging scripts/demo-clinicas.mjs --chip-devolver --confirmar</pre>
    <p class="mt-2 text-xs text-ink-soft">Sem o --confirmar, os dois só mostram o que fariam.</p>
  </Card>

  <Card>
    <h2 class="font-display text-[17px] leading-tight font-bold text-ink sm:text-lg">Roteiro da apresentação</h2>
    <p class="mt-1 text-[15px] text-ink-soft">
      Vinte minutos, nesta ordem, com o login da clínica com o perfil de quem assiste. Deixe o cliente pegar o próprio celular.
    </p>
    <div class="mt-3 overflow-x-auto rounded-xl border border-line">
      <table class="w-full min-w-[40rem] text-[15px]">
        <thead><tr><th class={TH}>Tempo</th><th class={TH}>O que mostrar</th><th class={TH}>A frase que fica</th></tr></thead>
        <tbody class="divide-y divide-[#e6ecea]">
          {script.map((step) => (
            <tr>
              <td class={`${TD} whitespace-nowrap font-medium text-ink`}>{step.time}</td>
              <td class={`${TD} text-ink-mid`}>{step.what}</td>
              <td class={`${TD} italic text-ink-soft`}>"{step.line}"</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <h3 class="mt-4 text-[12.5px] font-bold uppercase tracking-[.06em] text-ink-soft">Antes de cada apresentação</h3>
    <ul class="mt-2 flex list-disc flex-col gap-1 pl-5 text-[15px] text-ink-mid">
      <li>Na véspera: atualizar as demos (acima).</li>
      <li>Se for mostrar a conversa ao vivo: passar o chip para a Vida Plena e testar mandando um "Oi".</li>
      <li>
        Escolher a demo pelo perfil do cliente: clínica com várias especialidades ou que quer ver tudo → Demonstração RecepClinic;
        clínica médica → Vida Plena; dentista → Odonto Sorriso Leve; pediatra → Pediatria Sol Nascente.
      </li>
      <li>Depois: devolver o chip e, se passou a senha ao cliente, trocar as senhas.</li>
    </ul>
  </Card>
</div>

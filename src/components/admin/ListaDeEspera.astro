---
// Consultas › Lista de espera (Fase 25 · etapa 5), para a secretária e a
// médica: quem está na fila para antecipar, por tipo e local, na ordem em
// que a vaga é oferecida (ordem de entrada), com o horário atual, a oferta em
// andamento (vaga e prazo) e o botão para retirar da lista; abaixo, o
// histórico das últimas ofertas.
import Card from "./Card.astro";
import Badge from "./Badge.astro";
import PhoneLinks from "./PhoneLinks.astro";
import type { BadgeVariant } from "./Badge.astro";
import { createClient } from "../../lib/supabase/server";
import { formatWhen } from "../../lib/whatsapp/formatDateTime";
import { formatDateTime } from "../../lib/metrics/data";

const RETURN_TO = "/admin/consultas?tab=lista_espera";
const HISTORY_LIMIT = 30;

const supabase = createClient(Astro.request, Astro.cookies);

interface EntryRow {
  id: string;
  created_at: string;
  created_via: string;
  appointments: {
    id: string;
    scheduled_at: string;
    appointment_type: "first_visit" | "return_visit" | "exam";
    exam_types: { name: string } | null;
    clinic_locations: { name: string; type: string } | null;
    patients: {
      id: string;
      full_name: string;
      guardian_id: string;
      guardians: { full_name: string; phone: string | null } | null;
    } | null;
  };
}

interface OfferRow {
  id: string;
  appointment_id: string;
  status: string;
  offered_at: string;
  expires_at: string;
  responded_at: string | null;
  slot_scheduled_at: string;
  details: Record<string, unknown> | null;
  clinic_locations: { name: string; type: string } | null;
  appointments: { patients: { full_name: string } | null } | null;
}

const [{ data: entryData }, { data: offerData }] = await Promise.all([
  supabase
    .from("waitlist_entries")
    .select(
      "id, created_at, created_via, appointments!inner ( id, scheduled_at, appointment_type, exam_types ( name ), clinic_locations ( name, type ), patients ( id, full_name, guardian_id, guardians ( full_name, phone ) ) )"
    )
    .eq("status", "active")
    .order("created_at"),
  supabase
    .from("waitlist_offers")
    .select(
      "id, appointment_id, status, offered_at, expires_at, responded_at, slot_scheduled_at, details, clinic_locations ( name, type ), appointments!waitlist_offers_appointment_id_fkey ( patients ( full_name ) )"
    )
    .order("offered_at", { ascending: false })
    .limit(HISTORY_LIMIT),
]);

const entries = (entryData ?? []) as unknown as EntryRow[];
const offers = (offerData ?? []) as unknown as OfferRow[];

// Oferta em aberto de cada atendimento da fila (lida à parte: pode ser mais
// antiga que as últimas do histórico).
const pendingByAppointment = new Map<string, OfferRow>();
const entryAppointmentIds = entries.map((entry) => entry.appointments.id);
if (entryAppointmentIds.length) {
  const { data } = await supabase
    .from("waitlist_offers")
    .select("id, appointment_id, status, offered_at, expires_at, responded_at, slot_scheduled_at, details, clinic_locations ( name, type ), appointments!waitlist_offers_appointment_id_fkey ( patients ( full_name ) )")
    .eq("status", "pending")
    .in("appointment_id", entryAppointmentIds);
  for (const offer of (data ?? []) as unknown as OfferRow[]) pendingByAppointment.set(offer.appointment_id, offer);
}

function locationText(location: { name: string; type: string } | null): string {
  if (!location) return "";
  if (location.type === "home_visit") return "Domiciliar";
  if (location.type === "exam") return "";
  return location.name;
}

// Fila por tipo e local — a mesma separação que a oferta usa (consultório =
// qualquer clínica; domiciliar à parte; cada exame à parte).
function groupLabel(entry: EntryRow): string {
  const appointment = entry.appointments;
  if (appointment.appointment_type === "exam") return `Exame (${appointment.exam_types?.name ?? "—"})`;
  const place = appointment.clinic_locations?.type === "home_visit" ? "Domiciliar" : "Consultório";
  return `${appointment.appointment_type === "return_visit" ? "Retorno" : "Consulta"} – ${place}`;
}

const groups = new Map<string, EntryRow[]>();
for (const entry of entries) {
  const label = groupLabel(entry);
  groups.set(label, [...(groups.get(label) ?? []), entry]);
}
const groupList = [...groups.entries()].sort(([a], [b]) => a.localeCompare(b, "pt-BR"));

function hourMinute(iso: string): string {
  return formatDateTime(iso).split(" às ")[1] ?? "";
}

const REASON_LABELS: Record<string, string> = {
  outside_24h_no_template: "fora da janela de 24h e sem template aprovado",
  no_phone: "sem telefone",
  send_failed: "falha no envio",
  slot_taken: "a vaga foi ocupada antes",
  appointment_changed: "o atendimento mudou",
  removed_from_list: "retirado da lista",
  appointment_canceled: "atendimento cancelado",
  appointment_completed: "atendimento realizado",
  appointment_no_show: "falta registrada",
};

function offerStatus(offer: OfferRow): { label: string; variant: BadgeVariant } {
  const reason = REASON_LABELS[String(offer.details?.reason ?? "")];
  switch (offer.status) {
    case "pending":
      return { label: `Aguardando resposta (até ${hourMinute(offer.expires_at)})`, variant: "warning" };
    case "accepted":
      return { label: "Aceitou — antecipado", variant: "success" };
    case "declined":
      return { label: "Recusou", variant: "neutral" };
    case "expired":
      return { label: "Sem resposta em 60 min", variant: "neutral" };
    case "withdrawn":
      return { label: reason ? `Retirada — ${reason}` : "Retirada", variant: "neutral" };
    case "skipped":
      return { label: reason ? `Pulado — ${reason}` : "Pulado", variant: "danger" };
    default:
      return { label: offer.status, variant: "neutral" };
  }
}

function slotText(offer: OfferRow): string {
  const place = locationText(offer.clinic_locations);
  return `${formatWhen(new Date(offer.slot_scheduled_at))}${place ? ` · ${place}` : ""}`;
}
---

<p class="mt-4 text-sm text-slate-600">
  Pacientes que pediram para antecipar pelo WhatsApp ("Encaixe ou antecipar"). Quando um horário abre, a vaga é
  oferecida a um por vez, na ordem abaixo, com 60 minutos para responder. Só entram vagas de mesmo tipo e local que
  começam daqui a mais de 2 horas e sem outro horário livre antes.
</p>

{
  entries.length === 0 ? (
    <p class="mt-4 rounded-lg border border-slate-200 bg-white p-4 text-sm text-slate-500 shadow-sm">
      Ninguém na lista de espera agora.
    </p>
  ) : (
    groupList.map(([label, groupEntries]) => (
      <section class="mt-6">
        <h2 class="text-base font-semibold text-slate-900">
          {label} <span class="font-normal text-slate-500">· {groupEntries.length}</span>
        </h2>
        <div class="mt-3 space-y-3">
          {groupEntries.map((entry, index) => {
            const appointment = entry.appointments;
            const patient = appointment.patients;
            const guardian = patient?.guardians;
            const pending = pendingByAppointment.get(appointment.id);
            const place = locationText(appointment.clinic_locations);
            return (
              <Card>
                <div class="flex items-start gap-3">
                  <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-sky-100 text-sm font-semibold text-sky-800">
                    {index + 1}
                  </span>
                  <div class="min-w-0 flex-1 text-sm text-slate-700">
                    <p class="font-medium text-slate-900">
                      {patient ? (
                        <a
                          href={`/admin/pacientes/${patient.guardian_id}/criancas/${patient.id}/historico#card-${appointment.id}`}
                          class="hover:text-sky-700 hover:underline"
                        >
                          {patient.full_name}
                        </a>
                      ) : (
                        "Paciente"
                      )}
                    </p>
                    <p class="mt-0.5 text-slate-500">
                      Resp.: {guardian?.full_name ?? "—"}
                      {guardian?.phone && <PhoneLinks phone={guardian.phone} plain class="ml-1" />}
                    </p>
                    <p class="mt-1">
                      Marcado para <span class="font-medium">{formatWhen(new Date(appointment.scheduled_at))}</span>
                      {place && <span class="text-slate-500"> · {place}</span>}
                    </p>
                    <p class="text-xs text-slate-500">
                      Na lista desde {formatDateTime(entry.created_at)}
                      {entry.created_via === "booking_link" ? " (entrou ao marcar pelo link)" : ""}
                    </p>
                    {pending && (
                      <p class="mt-2 rounded-md bg-amber-50 px-2 py-1.5 text-xs text-amber-800">
                        Vaga oferecida: <span class="font-medium">{slotText(pending)}</span> — responde até{" "}
                        {hourMinute(pending.expires_at)}
                      </p>
                    )}
                  </div>
                </div>
                <form method="POST" action={`/api/admin/agenda/appointments/${appointment.id}/waitlist`} class="mt-3">
                  <input type="hidden" name="return_to" value={RETURN_TO} />
                  <button
                    type="submit"
                    class="js-confirm-delete w-full rounded-md border border-slate-300 px-4 py-1.5 text-sm font-semibold text-slate-600 hover:bg-slate-50 sm:w-auto"
                    data-confirm-title="Retirar da lista de espera?"
                    data-confirm-label="Retirar"
                    data-confirm-message={`${patient?.full_name ?? "O paciente"} deixa de receber ofertas de vaga. O atendimento continua marcado.`}
                  >
                    Retirar da lista
                  </button>
                </form>
              </Card>
            );
          })}
        </div>
      </section>
    ))
  )
}

<h2 class="mt-8 text-base font-semibold text-slate-900">Últimas ofertas</h2>
{
  offers.length === 0 ? (
    <p class="mt-2 text-sm text-slate-500">Nenhuma vaga oferecida ainda.</p>
  ) : (
    <ul class="mt-3 divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white shadow-sm">
      {offers.map((offer) => {
        const status = offerStatus(offer);
        return (
          <li class="flex flex-col gap-1 px-3 py-2.5 text-sm sm:flex-row sm:items-center sm:justify-between">
            <div class="min-w-0">
              <p class="font-medium text-slate-900">{offer.appointments?.patients?.full_name ?? "Paciente"}</p>
              <p class="text-xs text-slate-500">
                Vaga {slotText(offer)} · oferecida em {formatDateTime(offer.offered_at)}
              </p>
            </div>
            <Badge variant={status.variant} class="self-start sm:self-center">
              {status.label}
            </Badge>
          </li>
        );
      })}
    </ul>
  )
}

---
// Campo de senha das telas de acesso (R10, cliente, 17/out/2026) com o botão
// "Mostrar" dentro (src/scripts/passwordToggle.ts). `error`: a mensagem
// embaixo do campo, com a borda vermelha e o foco nele.
import Icon from "../Icon.astro";
import { AUTH_INPUT, AUTH_LABEL } from "./styles";

interface Props {
  id: string;
  name: string;
  label: string;
  autocomplete: "current-password" | "new-password";
  minlength?: number;
  error?: string | null;
  autofocus?: boolean;
}

const { id, name, label, autocomplete, minlength, error, autofocus = false } = Astro.props;
const errorId = `${id}-erro`;
---

<div>
  <label for={id} class={AUTH_LABEL}>{label}</label>
  <div class="relative">
    <input
      type="password"
      name={name}
      id={id}
      required
      minlength={minlength}
      autocomplete={autocomplete}
      autofocus={autofocus || Boolean(error)}
      aria-invalid={error ? "true" : undefined}
      aria-describedby={error ? errorId : undefined}
      class={`${AUTH_INPUT} pr-24`}
    />
    <button
      type="button"
      hidden
      data-password-toggle
      aria-controls={id}
      class="absolute top-[calc(0.375rem+6px)] right-1.5 h-8 rounded-md bg-canvas-deep px-2.5 text-sm font-semibold text-brand-ink hover:bg-brand-soft focus-visible:outline-2 focus-visible:outline-brand"
    >
      Mostrar
    </button>
  </div>
  {
    error && (
      <p id={errorId} class="mt-1.5 flex items-start gap-1.5 text-[14.5px] leading-snug text-danger">
        <Icon name="information-circle" class="mt-0.5 h-4 w-4 shrink-0" strokeWidth={2.2} />
        {error}
      </p>
    )
  }
</div>

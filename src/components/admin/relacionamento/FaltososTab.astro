---
// Relacionamento › Faltosos (CRM A2): a mesma lista dos Faltosos das Métricas.
import { currentPath, withReturn } from "../../../lib/returnPath";
import ContactRow from "./ContactRow.astro";
import ListCard from "./ListCard.astro";
import { relacionamento } from "../../../lib/ajuda/relacionamento";
import { formatInstant } from "../../../lib/clinicTime";
import type { FrequentNoShow } from "../../../lib/data/metrics";
import { capitalize, type Vocabulary } from "../../../lib/vocabulary";

interface Props {
  patients: FrequentNoShow[];
  timeZone: string;
  vocabulary: Vocabulary;
}

const { patients, timeZone, vocabulary } = Astro.props;
const here = currentPath(Astro.url);
---

<ListCard title="Faltosos" description="Quem tem 2 ou mais faltas e faltou em pelo menos metade dos atendimentos. Mais faltas primeiro." help={{ id: "relacionamento-faltosos", topic: relacionamento.comoFunciona.faltosos }}>
  {patients.map((f) => (
    <ContactRow
      name={f.patientName}
      href={withReturn(`/admin/pacientes/${f.patientId}`, here)}
      phone={f.contactPhone}
      contactNote={f.isContactSelf ? null : `${capitalize(vocabulary.contact)}: ${f.contactName}`}
    >
      <strong class="text-ink">{f.noShows} faltas</strong> em {f.total} registrados · última em {formatInstant(f.lastNoShow, timeZone, "dd/MM/yyyy")}
    </ContactRow>
  ))}
  {patients.length === 0 && <p class="border-t border-[#e7eeeb] px-4 py-4 text-[15px] text-ink-soft sm:px-[18px]"><strong class="text-ink">{relacionamento.vazios.faltosos.titulo}.</strong> {relacionamento.vazios.faltosos.texto}</p>}
</ListCard>

---
// Relacionamento › Faltosos (CRM A2): a mesma lista dos Faltosos das Métricas.
// C2: a última tentativa e o "Registrar contato"; quem sai volta com uma falta nova.
import ContactLogLine from "./ContactLogLine.astro";
import { registerHref } from "./registerHref";
import type { ActorLabel } from "../../../lib/data/agenda/trail";
import type { PendencyLog } from "../../../lib/data/contactInteractions";
import { currentPath, withReturn } from "../../../lib/returnPath";
import PhoneLinks from "../PhoneLinks.astro";
import Button from "../ui/Button.astro";
import EmptyState from "../ui/EmptyState.astro";
import HowItWorks from "../ui/HowItWorks.astro";
import { relacionamento } from "../../../lib/ajuda/relacionamento";
import { formatInstant } from "../../../lib/clinicTime";
import type { FrequentNoShow } from "../../../lib/data/metrics";
import { capitalize, type Vocabulary } from "../../../lib/vocabulary";

interface Props {
  patients: FrequentNoShow[];
  timeZone: string;
  vocabulary: Vocabulary;
  logs: Map<string, PendencyLog>;
  actors: Map<string, ActorLabel>;
  returnTo: string;
}

const { patients, timeZone, vocabulary, logs, actors, returnTo } = Astro.props;
const here = currentPath(Astro.url);
---

<HowItWorks id="relacionamento-faltosos" topic={relacionamento.comoFunciona.faltosos} class="mt-4 max-w-4xl">
  <p class="text-[15px] text-ink-soft">Mais faltas primeiro, em todo o histórico.</p>
</HowItWorks>
{
  patients.length > 0 && (
    <ul class="mt-3 max-w-4xl divide-y divide-[#e6ecea] rounded-xl border border-line bg-white px-4">
      {patients.map((f) => (
        <li class="flex flex-col gap-1 py-3.5 sm:flex-row sm:items-start sm:justify-between sm:gap-3">
          <div class="flex min-w-0 flex-col gap-0.5">
            <a href={withReturn(`/admin/pacientes/${f.patientId}`, here)} class="text-base font-semibold text-ink no-underline hover:text-brand hover:underline">
              {f.patientName}
            </a>
            <span class="flex flex-wrap items-center gap-x-1.5 text-[15px] text-ink-soft sm:text-sm">
              {!f.isContactSelf && `${capitalize(vocabulary.contact)}: ${f.contactName} · `}
              <PhoneLinks phone={f.contactPhone} plain />
            </span>
            <ContactLogLine log={logs.get(f.patientId)} actors={actors} timeZone={timeZone} />
          </div>
          <div class="flex shrink-0 flex-col gap-2 sm:items-end">
            <span class="text-[15px] text-ink-soft tabular-nums sm:text-right sm:text-sm">
              <span class="font-semibold text-ink">{f.noShows} faltas</span> em {f.total} registrados
              <span class="block text-[13px]">última em {formatInstant(f.lastNoShow, timeZone, "dd/MM/yyyy")}</span>
            </span>
            <Button size="sm" class="self-start sm:self-end" href={registerHref({ source: "faltosos", patientId: f.patientId, since: f.lastNoShow }, returnTo)}>
              Registrar contato
            </Button>
          </div>
        </li>
      ))}
    </ul>
  )
}
{patients.length === 0 && <div class="mt-3 max-w-4xl"><EmptyState variant="dashed" title={relacionamento.vazios.faltosos.titulo} text={relacionamento.vazios.faltosos.texto} /></div>}

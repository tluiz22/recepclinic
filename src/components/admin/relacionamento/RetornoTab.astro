---
// Relacionamento › Retorno (CRM A2): a Oportunidade agora das Métricas, com
// "Marcar retorno" (abre o Marcar com o paciente e a agenda, como no cartão).
import { currentPath, withReturn } from "../../../lib/returnPath";
import ContactRow from "./ContactRow.astro";
import ListCard from "./ListCard.astro";
import Button from "../ui/Button.astro";
import { relacionamento } from "../../../lib/ajuda/relacionamento";
import { formatCalendarDate, formatInstant } from "../../../lib/clinicTime";
import type { ReturnOpportunity } from "../../../lib/data/relationship";
import { capitalize, type Vocabulary } from "../../../lib/vocabulary";

interface Props {
  opportunities: ReturnOpportunity[];
  timeZone: string;
  vocabulary: Vocabulary;
  returnTo: string;
}

const { opportunities, timeZone, vocabulary, returnTo } = Astro.props;
const here = currentPath(Astro.url);
---

<ListCard title="Retorno" description="Consultas realizadas com o prazo de retorno aberto e sem retorno marcado. O prazo que acaba primeiro vem antes." help={{ id: "relacionamento-retorno", topic: relacionamento.comoFunciona.retorno }}>
  {opportunities.map((o) => (
    <ContactRow
      name={o.person?.fullName ?? capitalize(vocabulary.patient)}
      href={withReturn(`/admin/pacientes/${o.patientId}`, here)}
      phone={o.person?.phone}
      contactNote={o.person?.contactName && o.person.contactName !== o.person.fullName ? `${capitalize(vocabulary.contact)}: ${o.person.contactName}` : null}
    >
      Consulta em {formatInstant(o.scheduledAt, timeZone, "dd/MM/yyyy")} · retorno até <strong class="text-ink">{formatCalendarDate(o.lastDate, "dd/MM/yyyy")}</strong>
      <Button slot="actions" variant="quiet" href={withReturn(`/admin/agenda/marcar?${new URLSearchParams({ patient_id: o.patientId, agenda_id: o.agendaId })}`, returnTo)}>
        Marcar retorno
      </Button>
    </ContactRow>
  ))}
  {opportunities.length === 0 && <p class="border-t border-[#e7eeeb] px-4 py-4 text-[15px] text-ink-soft sm:px-[18px]"><strong class="text-ink">{relacionamento.vazios.retorno.titulo}.</strong> {relacionamento.vazios.retorno.texto}</p>}
</ListCard>

---
// Relacionamento › Lembretes da equipe (CRM P3, Q22): os lembretes da ficha
// com data até hoje, o mais antigo primeiro, com "Feito" (com confirmação),
// que volta para esta aba. O lembrete é criado e corrigido na ficha.
import { currentPath, withReturn } from "../../../lib/returnPath";
import ContactRow from "./ContactRow.astro";
import ListCard from "./ListCard.astro";
import Button from "../ui/Button.astro";
import Pill from "../ui/Pill.astro";
import { relacionamento } from "../../../lib/ajuda/relacionamento";
import { formatCalendarDate } from "../../../lib/clinicTime";
import type { DueReminder } from "../../../lib/data/patientReminders";
import { capitalize, type Vocabulary } from "../../../lib/vocabulary";

interface Props {
  reminders: DueReminder[];
  today: string;
  vocabulary: Vocabulary;
  returnTo: string;
}

const { reminders, today, vocabulary, returnTo } = Astro.props;
const here = currentPath(Astro.url);
---

<ListCard title="Lembretes da equipe" description="Os de hoje e os atrasados. O lembrete é criado na ficha do paciente." help={{ id: "relacionamento-lembretes-equipe", topic: relacionamento.comoFunciona.lembretesEquipe }}>
  {reminders.map((r) => {
    const name = r.person?.fullName ?? capitalize(vocabulary.patient);
    return (
      <ContactRow
        name={name}
        href={withReturn(`/admin/pacientes/${r.patientId}?aba=lembretes`, here)}
        phone={r.person?.phone}
        contactNote={r.person?.contactName && r.person.contactName !== r.person.fullName ? `${capitalize(vocabulary.contact)}: ${r.person.contactName}` : null}
      >
        {r.dueOn < today ? <Pill tone="warning">Atrasado · {formatCalendarDate(r.dueOn, "dd/MM")}</Pill> : <Pill tone="info">Hoje</Pill>}{" "}
        <span class="whitespace-pre-line break-words text-ink">{r.body}</span>
        <form slot="actions" method="POST" action={`/api/admin/pacientes/${r.patientId}/lembretes`} class="contents">
          <input type="hidden" name="acao" value="feito" />
          <input type="hidden" name="lembrete" value={r.id} />
          <input type="hidden" name="return_to" value={returnTo} />
          <Button
            type="submit"
            variant="quiet"
            class="js-confirm-delete"
            data-confirm-title="Marcar como feito?"
            data-confirm-message={`O lembrete de ${name} sai desta lista e fica como feito na ficha.`}
            data-confirm-label="Feito"
          >
            Feito
          </Button>
        </form>
      </ContactRow>
    );
  })}
  {reminders.length === 0 && <p class="border-t border-[#e7eeeb] px-4 py-4 text-[15px] text-ink-soft sm:px-[18px]"><strong class="text-ink">{relacionamento.vazios.lembretesEquipe.titulo}.</strong> {relacionamento.vazios.lembretesEquipe.texto}</p>}
</ListCard>

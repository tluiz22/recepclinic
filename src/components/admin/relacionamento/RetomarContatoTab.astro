---
// Relacionamento › Retomar contato (CRM A2, Q3): quem não concluiu pelo
// WhatsApp nos últimos 14 dias, uma linha por telefone e fluxo. "Retirar da
// lista" (cliente, 31/out/2026), com confirmação: uma tentativa nova traz de volta.
import { currentPath, withReturn } from "../../../lib/returnPath";
import Button from "../ui/Button.astro";
import ContactRow from "./ContactRow.astro";
import ListCard from "./ListCard.astro";
import { relacionamento } from "../../../lib/ajuda/relacionamento";
import { formatInstant } from "../../../lib/clinicTime";
import type { RecallGroup } from "../../../lib/data/relationship";
import { capitalize, type Vocabulary } from "../../../lib/vocabulary";

interface Props {
  groups: RecallGroup[];
  timeZone: string;
  vocabulary: Vocabulary;
}

const { groups, timeZone, vocabulary } = Astro.props;
const here = currentPath(Astro.url);
---

<ListCard title="Retomar contato" description="Começaram a marcar pelo WhatsApp nos últimos 14 dias e não terminaram. Uma linha por número e fluxo." help={{ id: "relacionamento-retomar", topic: relacionamento.comoFunciona.retomar }}>
  {groups.map((g) => (
    <ContactRow
      name={g.contactName ?? `${capitalize(vocabulary.contact)} sem cadastro`}
      href={g.contactId && g.contactName ? withReturn(`/admin/pacientes/contato/${g.contactId}`, here) : undefined}
      phone={g.phone}
    >
      {g.flowLabel}: parou em {g.latest.lastStage} · {formatInstant(g.latest.startedAt, timeZone, "dd/MM 'às' HH:mm")}
      {g.attempts > 1 && ` · ${g.attempts} tentativas`}
      <form slot="actions" method="POST" action="/api/admin/relacionamento/retomar" class="contents">
        <input type="hidden" name="telefone" value={g.phone} />
        <input type="hidden" name="fluxo" value={g.flowLabel} />
        <input type="hidden" name="return_to" value={here} />
        <Button
          type="submit"
          variant="quiet"
          class="js-confirm-delete"
          data-confirm-title="Retirar da lista?"
          data-confirm-message={`${g.contactName ?? `${capitalize(vocabulary.contact)} sem cadastro`} (${g.flowLabel}) sai do Retomar contato, aqui e nas Métricas. Se começar de novo pelo WhatsApp e não concluir, volta para a lista.`}
          data-confirm-label="Retirar"
        >
          Retirar da lista
        </Button>
      </form>
    </ContactRow>
  ))}
  {groups.length === 0 && <p class="border-t border-[#e7eeeb] px-4 py-4 text-[15px] text-ink-soft sm:px-[18px]"><strong class="text-ink">{relacionamento.vazios.retomar.titulo}.</strong> {relacionamento.vazios.retomar.texto}</p>}
</ListCard>

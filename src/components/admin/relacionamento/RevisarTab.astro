---
// Relacionamento › Contatos para revisar (CRM A2): a lista do Início, com o
// "Revisado" (com confirmação), que volta para esta aba. A central é só do
// Administrador e da Recepção, os mesmos papéis do "Revisado".
import { currentPath, withReturn } from "../../../lib/returnPath";
import PhoneLinks from "../PhoneLinks.astro";
import Button from "../ui/Button.astro";
import EmptyState from "../ui/EmptyState.astro";
import { relacionamento } from "../../../lib/ajuda/relacionamento";
import { formatInstant } from "../../../lib/clinicTime";
import { BOT_LIMIT_LABELS, REVIEW_WINDOW_DAYS, type ContactToReview } from "../../../lib/data/whatsapp/botLimits";

interface Props {
  contacts: ContactToReview[];
  timeZone: string;
  returnTo: string;
}

const { contacts, timeZone, returnTo } = Astro.props;
const here = currentPath(Astro.url);
---

<p class="mt-4 max-w-4xl text-[15px] text-ink-soft">Nos últimos {REVIEW_WINDOW_DAYS} dias, o bot deixou de marcar para estes números por um limite do contato.</p>
{
  contacts.length > 0 && (
    <ul class="mt-3 max-w-4xl divide-y divide-[#e6ecea] rounded-xl border border-line bg-white px-4">
      {contacts.map((item) => (
        <li class="flex flex-col gap-3 py-3.5 sm:flex-row sm:items-start sm:justify-between">
          <div class="flex min-w-0 flex-col gap-0.5">
            <a href={withReturn(`/admin/pacientes/contato/${item.contactId}`, here)} class="text-base font-semibold text-ink no-underline hover:text-brand hover:underline">
              {item.name}
            </a>
            {item.phone && (
              <span class="text-[15px] text-ink-soft sm:text-sm">
                <PhoneLinks phone={item.phone} plain />
              </span>
            )}
            <span class="text-[15px] text-ink-soft sm:text-sm">
              {BOT_LIMIT_LABELS[item.last.reason]} · {formatInstant(item.last.at, timeZone, "dd/MM 'às' HH:mm")}
              {item.hits > 1 && ` · ${item.hits} vezes`}
            </span>
          </div>
          <form method="POST" action={`/api/admin/pacientes/contato/${item.contactId}`} class="contents">
            <input type="hidden" name="acao" value="revisado" />
            <input type="hidden" name="return_to" value={returnTo} />
            <Button
              type="submit"
              size="sm"
              class="js-confirm-delete shrink-0 self-start"
              data-confirm-title="Marcar como revisado?"
              data-confirm-message={`${item.name} sai desta lista. Se atingir um limite de novo, volta.`}
              data-confirm-label="Revisado"
            >
              Revisado
            </Button>
          </form>
        </li>
      ))}
    </ul>
  )
}
{contacts.length === 0 && <div class="mt-3 max-w-4xl"><EmptyState variant="dashed" title={relacionamento.vazios.revisar.titulo} text={relacionamento.vazios.revisar.texto} /></div>}

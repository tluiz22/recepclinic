---
// A tentativa mais recente de uma pendência (CRM C2): o resultado, quando e
// quem registrou, e quantos registros ela tem; "link enviado em dd/mm" (Q10).
import { actorText, type ActorLabel } from "../../../lib/data/agenda/trail";
import { formatInstant } from "../../../lib/clinicTime";
import { OUTCOME_LABEL, type PendencyLog } from "../../../lib/data/contactInteractions";

interface Props {
  log: PendencyLog | undefined;
  actors: Map<string, ActorLabel>;
  timeZone: string;
}

const { log, actors, timeZone } = Astro.props;
const when = log ? formatInstant(log.last.createdAt, timeZone, "dd/MM 'às' HH:mm") : "";
const what = log ? (log.last.outcome === "link_sent" ? `Link enviado em ${when}` : `${OUTCOME_LABEL[log.last.outcome]} em ${when}`) : "";
const by = log?.last.createdBy ? actorText(actors.get(log.last.createdBy)) : null;
---

{
  log && (
    <span class="flex flex-col text-[13.5px] text-pend-800">
      <span>
        <span class="font-semibold">{what}</span>
        {by && ` · por ${by}`}
        {log.attempts > 1 && ` · ${log.attempts} registros`}
      </span>
      {log.last.note && <span class="line-clamp-2 break-words text-ink-soft">“{log.last.note}”</span>}
    </span>
  )
}

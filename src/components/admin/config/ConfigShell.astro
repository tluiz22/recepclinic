---
// Moldura de Configurações (redesign R9, proposta aprovada pelo cliente em
// 17/out/2026): no computador, o menu lateral em 4 grupos, com o número de
// pendências do guia ao lado da seção; no celular, o botão "Seção: <nome>"
// abre a mesma lista (sem JavaScript, <details>). O título é o da seção ou do
// cadastro (U-06), com "Configurações" pequeno acima; nos formulários, o link
// para a lista (`back`). Aberta de outra tela (S-01 da R8), `back` é a origem.
// Substitui as abas em pílulas (ConfiguracoesTabs, F4.3). Redesign 2B (cliente,
// 19/out/2026): cada seção com um ícone e o grupo como um título pequeno, sem
// maiúsculas, com uma linha ao lado (computador); no celular, os mesmos ícones.
// Menu lateral (M5; cliente, 30/out/2026): no computador, as seções vão para a
// lateral do AdminLayout (slot "side"), no lugar do menu principal.
import AdminLayout from "../../../layouts/AdminLayout.astro";
import FlashMessage from "../FlashMessage.astro";
import Icon from "../Icon.astro";
import { createUserClient } from "../../../lib/data/clients";
import { pageFlash } from "../../../lib/flash";
import { loadSetupStatus, type SetupStatus } from "../../../lib/data/config/setup";
import { configSections, type SectionId } from "./sections";

interface Props {
  current: SectionId;
  title: string;
  subtitle?: string;
  /** Título da aba do navegador (padrão: o título). */
  pageTitle?: string;
  /** "‹ Profissionais" nos formulários; a origem quando veio de outra tela. */
  back?: { href: string; label: string };
  /** Já carregado pela tela (evita buscar duas vezes). */
  setup?: SetupStatus;
}

const { current, title, subtitle, pageTitle, back, setup: given } = Astro.props;
// O aviso é lido (e o cookie apagado) antes de esperar o guia: depois da espera
// a resposta já começou a sair e o cookie ficava, repetindo o aviso nas telas
// seguintes (QA-02 do teste da R9).
const flash = pageFlash(Astro);
const clinic = Astro.locals.clinic!;
const setup = given ?? (await loadSetupStatus(createUserClient(Astro.request, Astro.cookies), clinic.clinicId, clinic.features));
const groups = configSections(clinic.features, clinic.isPlatformStaff, setup);
const all = groups.flatMap((g) => g.items);
const active = all.find((s) => s.id === current);
const totalPending = all.reduce((sum, s) => sum + s.pending, 0);
const pendingLabel = (n: number) => `${n} ${n === 1 ? "pendência" : "pendências"}`;
const count = "rounded-full bg-pend-100 px-2 text-[12.5px] leading-normal font-semibold text-pend-800";
const support = "rounded-md bg-blk-100 px-1.5 text-[11.5px] leading-normal font-semibold text-blk-800";
---

<AdminLayout title={pageTitle ?? title} sideTitle="Configurações">
    <nav slot="side" aria-label="Seções de Configurações" class="flex flex-col gap-4">
      <span class="flex items-center gap-2.5 px-2.5 font-display text-lg font-bold text-ink">
        <Icon name="settings" class="h-5 w-5 shrink-0 text-brand" strokeWidth={1.8} /> Configurações
      </span>
      {
        groups.map((group) => (
          <div class="flex flex-col gap-0.5">
            <span class="flex items-center gap-2 px-2.5 pb-1">
              <span class="text-[13px] leading-none font-semibold whitespace-nowrap text-ink-soft">{group.title}</span>
              <span class="h-px flex-1 bg-line-strong" aria-hidden="true" />
            </span>
            {group.items.map((s) => (
              <a
                href={s.href}
                aria-current={s.id === current ? "page" : undefined}
                class={`group/item flex h-[38px] items-center gap-2.5 rounded-lg px-2.5 text-[15px] no-underline ${
                  s.id === current ? "bg-brand-soft font-bold text-brand-ink" : "font-semibold text-ink hover:bg-canvas"
                }`}
              >
                <Icon name={s.icon} class={`h-[19px] w-[19px] shrink-0 ${s.id === current ? "text-brand" : "text-ink-soft group-hover/item:text-ink"}`} strokeWidth={1.8} />
                <span class="min-w-0 flex-1 truncate">{s.label}</span>
                {s.pending > 0 ? (
                  <span class={count} aria-label={pendingLabel(s.pending)}>
                    {s.pending}
                  </span>
                ) : (
                  s.supportOnly && <span class={support}>Suporte</span>
                )}
              </a>
            ))}
          </div>
        ))
      }
    </nav>

    <div class="flex min-w-0 flex-col">
      {
        back && (
          <a href={back.href} class="mb-2 inline-flex min-h-8 items-center gap-1 self-start text-[15px] font-semibold text-brand no-underline hover:underline">
            <Icon name="chevron-left" class="h-[18px] w-[18px]" strokeWidth={2.2} /> {back.label}
          </a>
        )
      }
      <div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-3">
        <div class="min-w-0">
          <span class="text-[12.5px] font-bold tracking-[.06em] text-ink-soft uppercase">Configurações</span>
          <h1 class="mt-1 font-display text-[26px] leading-[1.1] font-bold break-words text-ink sm:text-[30px]">{title}</h1>
          {subtitle && <p class="mt-1.5 text-[15px] text-ink-soft">{subtitle}</p>}
        </div>
        {
          Astro.slots.has("actions") && (
            <div class="flex flex-wrap gap-2">
              <slot name="actions" />
            </div>
          )
        }
      </div>

      <details data-config-sections class="group/sec mt-3 lg:hidden">
        <summary class="flex h-12 cursor-pointer list-none items-center justify-between gap-2 rounded-[10px] border border-line-strong bg-white px-3.5 text-base text-ink [&::-webkit-details-marker]:hidden">
          <span>
            Seção: <strong>{active?.label ?? title}</strong>
          </span>
          <span class="flex items-center gap-2">
            {totalPending > 0 && <span class={count}>{pendingLabel(totalPending)}</span>}
            <Icon name="chevron-down" class="h-[18px] w-[18px] transition-transform group-open/sec:rotate-180" strokeWidth={2.2} />
          </span>
        </summary>
        {/* Revisão do teste no celular (cliente, 17/out): o nome do grupo fica fora
            do cartão e cada seção é uma linha com a seta, para não confundir o
            grupo com uma seção tocável. Ao tocar, a linha mostra "Abrindo…" e não
            aceita outro toque (script abaixo). */}
        <nav aria-label="Seções de Configurações" class="mt-4 flex flex-col gap-4">
          {
            groups.map((group) => (
              <div class="flex flex-col gap-1.5">
                <span class="px-1 text-[13px] leading-none font-semibold text-ink-soft">{group.title}</span>
                <div class="flex flex-col overflow-hidden rounded-xl border border-line bg-white">
                  {group.items.map((s, i) => (
                    <a
                      href={s.href}
                      data-config-link
                      aria-current={s.id === current ? "page" : undefined}
                      class={`group/link flex min-h-[50px] items-center justify-between gap-2 pr-3 pl-3.5 text-base no-underline data-busy:bg-canvas-deep data-busy:text-ink-soft ${
                        i > 0 ? "border-t border-line" : ""
                      } ${s.id === current ? "bg-brand-soft font-bold text-brand-ink" : "font-semibold text-ink"}`}
                    >
                      <span class="flex min-w-0 items-center gap-2.5">
                        <Icon name={s.icon} class={`h-5 w-5 shrink-0 ${s.id === current ? "text-brand" : "text-ink-soft"}`} strokeWidth={1.8} />
                        {s.label}
                      </span>
                      <span class="flex shrink-0 items-center gap-2 group-data-busy/link:hidden">
                        {s.pending > 0 ? (
                          <span class={count} aria-label={pendingLabel(s.pending)}>
                            {s.pending}
                          </span>
                        ) : (
                          s.supportOnly && <span class={support}>Suporte</span>
                        )}
                        {s.id === current ? (
                          <span class="text-[13px] font-bold text-brand-ink">Aqui</span>
                        ) : (
                          <Icon name="chevron-right" class="h-[18px] w-[18px] text-ink-soft" strokeWidth={2.2} />
                        )}
                      </span>
                      <span class="hidden shrink-0 items-center gap-1.5 text-sm font-semibold text-brand-ink group-data-busy/link:flex">
                        <Icon name="arrow-path" class="h-[18px] w-[18px] animate-spin" strokeWidth={2.2} /> Abrindo…
                      </span>
                    </a>
                  ))}
                </div>
              </div>
            ))
          }
        </nav>
      </details>

      <FlashMessage flash={flash} />
      <div class="mt-4 flex min-w-0 flex-col gap-4">
        <slot />
      </div>
    </div>
</AdminLayout>

<script>
  // Seção tocada no menu do celular: "Abrindo…" na linha e os toques seguintes
  // ignorados até a tela nova chegar (cliente, 17/out: sem retorno, tocava de
  // novo). A barra do topo é a do AdminLayout.
  document.addEventListener("click", (event) => {
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>("a[data-config-link]");
    if (!link) return;
    if (link.hasAttribute("data-busy")) {
      event.preventDefault();
      return;
    }
    // A seção já aberta só fecha a lista, sem recarregar.
    if (link.getAttribute("aria-current") === "page") {
      event.preventDefault();
      link.closest("details")?.removeAttribute("open");
      return;
    }
    link.setAttribute("data-busy", "");
    link.setAttribute("aria-disabled", "true");
  });

  // Voltar pelo navegador pode reabrir a página do cache com a linha presa.
  window.addEventListener("pageshow", () => {
    for (const link of document.querySelectorAll("a[data-config-link][data-busy]")) {
      link.removeAttribute("data-busy");
      link.removeAttribute("aria-disabled");
    }
  });
</script>

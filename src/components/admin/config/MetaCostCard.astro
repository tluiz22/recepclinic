---
// Custo da Meta no mês (CU4; tela W2, cliente, 05/nov/2026): para todas as clínicas, em Configurações › WhatsApp.
// O valor do mês em destaque, a barra das mensagens de serviço grátis e três cartões (modelos; assistente, avisos e
// Central; pelo app, grátis), com "Ver detalhes" por origem. Contagem lida a cada abertura da tela; é estimativa pelos
// Preços da Meta (Sistema), a fatura oficial fica no Gerenciador do WhatsApp da clínica.
import Panel from "./Panel.astro";
import { SECTION_TITLE } from "./formStyles";
import { estimateMonth, type MessageCounts, type MetaPriceVersion, type ServiceSplit } from "../../../lib/data/metaPricing";
import { formatCalendarDate } from "../../../lib/clinicTime";

interface Props {
  /** "YYYY-MM-01" e "YYYY-MM-DD" (hoje), no fuso da clínica. */
  month: string;
  today: string;
  counts: Pick<MessageCounts, "templates" | "service" | "appReplies">;
  split: ServiceSplit;
  price: MetaPriceVersion | null;
}

const { month, today, counts, split, price } = Astro.props;
const estimate = estimateMonth(counts, price);
const money = (value: number) => value.toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
const number = (value: number) => value.toLocaleString("pt-BR");
// Preço de uma mensagem: com 4 casas (R$ 0,0350).
const unit = (value: number) => value.toLocaleString("pt-BR", { style: "currency", currency: "BRL", minimumFractionDigits: 4 });
const monthName = formatCalendarDate(month, "MMMM");
const period = `de ${formatCalendarDate(month, "dd")} a ${formatCalendarDate(today, "dd/MMM")}`;
const free = price?.freeServicePerMonth ?? 0;
const freeUsed = Math.min(counts.service, free);
const barPercent = free > 0 ? Math.round((freeUsed / free) * 100) : 100;
const templatesBrl = price ? counts.templates * price.utilityBrl : null;
const serviceBrl = price ? estimate.chargedService * price.serviceBrl : null;
const freeOver = free > 0 && counts.service >= free;
const rows = [
  { label: "Confirmações, lembretes e outros modelos", count: counts.templates, note: "cada um cobrado" },
  { label: "Assistente (bot)", count: split.assistant, note: "serviço" },
  { label: "Avisos de texto", count: split.notices, note: "serviço" },
  { label: "Central de atendimento", count: split.central, note: "serviço" },
  { label: "Respostas pelo app do WhatsApp", count: counts.appReplies, note: "grátis" },
];
---

<Panel id="custo-meta">
  <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
    <h2 class={SECTION_TITLE}>Custo da Meta em {monthName}</h2>
    <span class="text-sm text-ink-soft">{period}</span>
  </div>

  {
    !price ? (
      <p class="mt-3 text-[15px] text-ink-mid">Sem a tabela de preços da Meta para este mês. O suporte do RecepClinic atualiza a tabela.</p>
    ) : (
      <>
        <div class="mt-3 flex flex-wrap gap-4">
          <div class="flex flex-[1_1_200px] flex-col gap-1">
            <span class="text-sm text-ink-mid">Estimativa até hoje</span>
            <strong class="font-display text-[34px] leading-tight font-bold text-ink tabular-nums">{money(estimate.totalBrl ?? 0)}</strong>
          </div>
          <div class="flex flex-[2_1_300px] flex-col gap-1.5">
            <span id="custo-meta-franquia" class="text-sm text-ink-mid">Mensagens de serviço grátis do mês</span>
            <div
              class="h-3 overflow-hidden rounded-md bg-canvas-deep"
              role="progressbar"
              aria-labelledby="custo-meta-franquia"
              aria-valuemin="0"
              aria-valuemax={free}
              aria-valuenow={freeUsed}
            >
              <div class={`h-3 ${freeOver ? "bg-pend-500" : "bg-brand"}`} style={`width: ${barPercent}%`} />
            </div>
            <span class="text-sm text-ink-mid">
              <strong class="text-ink">{number(freeUsed)} de {number(free)} usadas</strong>
              {freeOver ? " · a partir daqui, cada mensagem de serviço é cobrada" : ` · faltam ${number(free - freeUsed)}`}
            </span>
          </div>
        </div>

        <div class="mt-3 grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-2.5">
          <div class="flex flex-col rounded-[10px] border border-canvas-deep px-3 py-2.5">
            <span class="text-[13px] text-ink-soft">Confirmações e lembretes</span>
            <strong class="text-lg text-ink tabular-nums">{money(templatesBrl ?? 0)}</strong>
            <span class="text-[13px] text-ink-soft">{number(counts.templates)} {counts.templates === 1 ? "modelo" : "modelos"}</span>
          </div>
          <div class="flex flex-col rounded-[10px] border border-canvas-deep px-3 py-2.5">
            <span class="text-[13px] text-ink-soft">Assistente, avisos e Central</span>
            <strong class="text-lg text-ink tabular-nums">{money(serviceBrl ?? 0)}</strong>
            <span class="text-[13px] text-ink-soft">
              {number(counts.service)} {counts.service === 1 ? "mensagem" : "mensagens"}
              {estimate.chargedService > 0 && ` · ${number(estimate.chargedService)} cobradas`}
            </span>
          </div>
          <div class="flex flex-col rounded-[10px] border border-canvas-deep px-3 py-2.5">
            <span class="text-[13px] text-ink-soft">Pelo app do WhatsApp</span>
            <strong class="text-lg text-ink">grátis</strong>
            <span class="text-[13px] text-ink-soft">{number(counts.appReplies)} {counts.appReplies === 1 ? "resposta" : "respostas"}</span>
          </div>
        </div>

        <details class="mt-3">
          <summary class="cursor-pointer text-[15px] font-semibold text-brand-ink hover:underline">Ver detalhes por tipo de mensagem</summary>
          <table class="mt-2 w-full text-[15px]">
            <caption class="sr-only">Mensagens enviadas em {monthName}, por tipo</caption>
            <thead>
              <tr class="border-b border-line text-left text-[13px] text-ink-soft">
                <th scope="col" class="py-1.5 pr-2 font-semibold">Tipo</th>
                <th scope="col" class="py-1.5 pr-2 text-right font-semibold">Mensagens</th>
                <th scope="col" class="py-1.5 font-semibold">Cobrança</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-canvas-deep">
              {rows.map((row) => (
                <tr>
                  <td class="py-1.5 pr-2 text-ink">{row.label}</td>
                  <td class="py-1.5 pr-2 text-right text-ink tabular-nums">{number(row.count)}</td>
                  <td class="py-1.5 text-ink-soft">{row.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="mt-2 text-sm text-ink-soft">
            Modelos: {unit(price.utilityBrl)} cada. Serviço (assistente, avisos e Central): as primeiras {number(free)} do mês são grátis, depois
            {` ${unit(price.serviceBrl)}`} cada. Mensagens que falharam não contam.
          </p>
        </details>

        <p class="mt-3 text-sm text-ink-soft">
          Estimativa pela tabela de preços da Meta (vigente desde {formatCalendarDate(price.validFrom, "dd/MM/yyyy")}). O valor oficial fica no Gerenciador do
          WhatsApp da clínica.
        </p>
      </>
    )
  }
</Panel>

---
// Lista vazia de Configurações (R9): nada cadastrado, com o botão de cadastrar
// o primeiro; só desativados (em "Ativos"), com "Ver desativados"; ou nenhum
// desativado (em "Desativados", cliente 21/out/2026), com "Ver ativos".
// Moldura no EmptyState (ajuda contextual, 23/out/2026).
import Button from "../ui/Button.astro";
import EmptyState from "../ui/EmptyState.astro";

interface Props {
  /** Há cadastros, mas todos desativados. */
  onlyInactive: boolean;
  /** Aba "Desativados" aberta. */
  showingInactive?: boolean;
  /** "Nenhuma agenda desativada", "Ver ativas". */
  feminine?: boolean;
  /** Ex.: "Nenhum serviço". */
  none: string;
  /** Ex.: "cadastrado"; "ativo". */
  createdWord?: string;
  activeWord?: string;
  /** Por que importa, ex.: "Sem serviço, nada aparece para marcar." */
  text?: string;
  href?: string;
  label?: string;
}

const { onlyInactive, showingInactive = false, feminine = false, none, createdWord = "cadastrado", activeWord = "ativo", text, href, label } = Astro.props;
const a = feminine ? "a" : "o";
---

{
  showingInactive ? (
    <EmptyState title={`${none} desativad${a}`}>
      <Button href="?">Ver ativ{a}s</Button>
    </EmptyState>
  ) : onlyInactive ? (
    <EmptyState title={`${none} ${activeWord}`} text={`Os cadastros desativados aparecem em "Desativad${a}s".`}>
      <Button href="?todos=1">Ver desativad{a}s</Button>
    </EmptyState>
  ) : (
    <EmptyState title={`${none} ${createdWord}`} text={text}>
      {href && label && (
        <Button href={href} variant="primary">
          {label}
        </Button>
      )}
    </EmptyState>
  )
}

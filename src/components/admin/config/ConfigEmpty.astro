---
// Lista vazia de Configurações (R9): nada cadastrado, com o botão de cadastrar
// o primeiro; ou só desativados (em "Ativos"), com "Ver todos".
import Button from "../ui/Button.astro";

interface Props {
  /** Há cadastros, mas todos desativados. */
  onlyInactive: boolean;
  /** Ex.: "Nenhum serviço". */
  none: string;
  /** Ex.: "cadastrado"; "ativo". */
  createdWord?: string;
  activeWord?: string;
  /** Por que importa, ex.: "Sem serviço, nada aparece para marcar." */
  text?: string;
  href?: string;
  label?: string;
}

const { onlyInactive, none, createdWord = "cadastrado", activeWord = "ativo", text, href, label } = Astro.props;
---

<section class="flex flex-col items-center gap-2.5 rounded-xl border border-line bg-white px-6 py-7 text-center">
  <p class="text-[17px] font-bold text-ink">{none} {onlyInactive ? activeWord : createdWord}</p>
  {onlyInactive ? <p class="text-sm text-ink-soft">Os cadastros desativados aparecem em "Todos".</p> : text && <p class="text-sm text-ink-soft">{text}</p>}
  {onlyInactive ? <Button href="?todos=1">Ver todos</Button> : href && label && <Button href={href} variant="primary">{label}</Button>}
</section>

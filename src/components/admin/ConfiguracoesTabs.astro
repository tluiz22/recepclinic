---
import TabBar from "./TabBar.astro";
import SetupGuide from "./setup/SetupGuide.astro";
import { createUserClient } from "../../lib/data/clients";
import { loadSetupStatus } from "../../lib/data/config/setup";

// Abas de Configurações (F4.3 e F4.4b). Convênios só com o item liberado (D11).
// Jornada de configuração (F6.3b): o guia completo na aba Clínica; nas
// outras, só o aviso de que há pendências.
type TabId = "clinica" | "profissionais" | "locais" | "agendas" | "servicos" | "horarios" | "feriados" | "convenios" | "equipe" | "whatsapp" | "mensagens";

interface Props {
  current: TabId;
}

const { current } = Astro.props;
const features = Astro.locals.clinic?.features ?? [];
const clinicId = Astro.locals.clinic?.clinicId;
const setup = clinicId ? await loadSetupStatus(createUserClient(Astro.request, Astro.cookies), clinicId, features) : null;

const tabs: { id: TabId; label: string; href: string; show?: boolean }[] = [
  { id: "clinica", label: "Clínica", href: "/admin/configuracoes" },
  { id: "profissionais", label: "Profissionais", href: "/admin/configuracoes/profissionais" },
  { id: "locais", label: "Locais", href: "/admin/configuracoes/locais" },
  { id: "agendas", label: "Agendas", href: "/admin/configuracoes/agendas" },
  { id: "servicos", label: "Serviços", href: "/admin/configuracoes/servicos" },
  { id: "horarios", label: "Horários", href: "/admin/configuracoes/horarios" },
  { id: "feriados", label: "Feriados", href: "/admin/configuracoes/feriados" },
  { id: "convenios", label: "Convênios", href: "/admin/configuracoes/convenios", show: features.includes("insurance") },
  { id: "equipe", label: "Equipe", href: "/admin/configuracoes/equipe" },
  { id: "whatsapp", label: "WhatsApp", href: "/admin/configuracoes/whatsapp" },
  { id: "mensagens", label: "Mensagens", href: "/admin/configuracoes/mensagens" },
];
---

<TabBar
  label="Seções de Configurações"
  class="mt-4"
  tabs={tabs.filter((tab) => tab.show !== false).map((tab) => ({ label: tab.label, href: tab.href, active: tab.id === current }))}
/>
{setup && <SetupGuide status={setup} compact={current !== "clinica"} />}

---
import TabBar from "./TabBar.astro";

interface Props {
  current: "disponibilidade" | "duracao" | "valores" | "exames" | "contatos";
}

const { current } = Astro.props;

const tabs = [
  { id: "disponibilidade", label: "Disponibilidade", href: "/admin/configuracoes" },
  { id: "duracao", label: "Duração e intervalo", href: "/admin/configuracoes/duracao" },
  { id: "valores", label: "Valores", href: "/admin/configuracoes/valores" },
  { id: "exames", label: "Tipos de exame", href: "/admin/configuracoes/exames" },
  { id: "contatos", label: "Contatos", href: "/admin/configuracoes/contatos" },
] as const;
---

<TabBar
  label="Seções de Configurações"
  class="mt-4"
  tabs={tabs.map((tab) => ({ label: tab.label, href: tab.href, active: tab.id === current }))}
/>

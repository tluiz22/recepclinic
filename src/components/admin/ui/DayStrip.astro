---
// Faixa de dias livres (R4): 7 por vez, setas para os 7 antes e os 7 depois e
// "Outra data" (calendário). No celular os dias rolam de lado e as setas vão
// para a linha de baixo. A regra da faixa fica em src/lib/dayStrip.ts.
import type { DayStrip } from "../../../lib/dayStrip";
import { formatCalendarDate } from "../../../lib/clinicTime";
import Icon from "../Icon.astro";
import { buttonClass, CONTROL } from "./styles";

interface Props {
  strip: DayStrip;
  /** Endereço de um dia, com o começo da faixa. */
  href: (date: string, start: string) => string;
  /** Formulário do "Outra data": rota e campos que ele mantém. */
  action: string;
  hidden: Record<string, string>;
  /** Primeiro dia aceito no calendário (hoje). */
  min: string;
}

const { strip, href, action, hidden, min } = Astro.props;
const start = strip.days[0] ?? "";
const day = (date: string) => ({
  weekday: formatCalendarDate(date, "EEE").slice(0, 3),
  number: formatCalendarDate(date, "dd"),
  month: formatCalendarDate(date, "MMM"),
  label: formatCalendarDate(date, "EEEE, dd/MM"),
});
const arrow = "flex w-11 shrink-0 items-center justify-center rounded-[10px] border border-line-strong bg-white text-ink no-underline hover:bg-canvas sm:w-10";
const arrowOff = "flex w-11 shrink-0 items-center justify-center rounded-[10px] border border-line bg-canvas text-line-strong sm:w-10";
---

<div class="flex flex-col gap-2">
  <div class="flex items-stretch gap-2">
    {
      strip.prevStart ? (
        <a href={href(strip.prevStart, strip.prevStart)} class={`hidden sm:flex ${arrow}`} aria-label="7 dias livres antes">
          <Icon name="chevron-left" class="h-5 w-5" strokeWidth={2.2} />
        </a>
      ) : (
        <span class={`hidden sm:flex ${arrowOff}`} aria-hidden="true">
          <Icon name="chevron-left" class="h-5 w-5" strokeWidth={2.2} />
        </span>
      )
    }
    <ul class="-mx-3.5 flex flex-1 gap-2 overflow-x-auto px-3.5 pb-0.5 [scrollbar-width:none] sm:mx-0 sm:px-0" aria-label="Dias com horário livre">
      {
        strip.days.map((date) => {
          const d = day(date);
          const active = date === strip.selected;
          return (
            <li class="flex shrink-0 basis-[58px] sm:min-w-0 sm:flex-1 sm:basis-0">
              <a
                href={href(date, start)}
                aria-current={active ? "date" : undefined}
                aria-label={d.label}
                class={`flex w-full flex-col items-center gap-0.5 rounded-[10px] border px-1 py-2 no-underline ${
                  active ? "border-brand bg-brand text-white" : "border-line-strong bg-white text-ink hover:border-brand"
                }`}
              >
                <span class={`text-[13px] leading-tight font-semibold ${active ? "text-brand-soft" : "text-ink-soft"}`}>{d.weekday}</span>
                <span class="font-display text-[21px] leading-[1.1] font-bold tabular-nums sm:text-[22px]">{d.number}</span>
                <span class={`text-[12.5px] leading-tight font-medium ${active ? "text-brand-soft" : "text-ink-soft"}`}>{d.month}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
    {
      strip.nextStart ? (
        <a href={href(strip.nextStart, strip.nextStart)} class={`hidden sm:flex ${arrow}`} aria-label="7 dias livres depois">
          <Icon name="chevron-right" class="h-5 w-5" strokeWidth={2.2} />
        </a>
      ) : (
        <span class={`hidden sm:flex ${arrowOff}`} aria-hidden="true">
          <Icon name="chevron-right" class="h-5 w-5" strokeWidth={2.2} />
        </span>
      )
    }
  </div>
  <div class="flex flex-wrap items-center gap-2 sm:justify-between">
    {
      strip.prevStart ? (
        <a href={href(strip.prevStart, strip.prevStart)} class={`flex-1 sm:hidden ${buttonClass("secondary")}`} aria-label="7 dias livres antes">
          <Icon name="chevron-left" class="h-5 w-5" strokeWidth={2.2} />
          Antes
        </a>
      ) : null
    }
    <span class="hidden text-sm text-ink-soft sm:inline">Só aparecem os dias com horário livre.</span>
    <form method="GET" action={action} class="flex flex-[1.4] items-center gap-2 sm:flex-none">
      {Object.entries(hidden).map(([name, value]) => value && <input type="hidden" name={name} value={value} />)}
      <label for="outra-data" class="text-[15px] font-semibold whitespace-nowrap text-ink sm:text-sm">Outra data</label>
      <input id="outra-data" type="date" name="date" min={min} value="" data-autosubmit class={`${CONTROL} min-w-0 flex-1 sm:h-8 sm:w-40 sm:flex-none sm:text-sm`} />
    </form>
    {
      strip.nextStart ? (
        <a href={href(strip.nextStart, strip.nextStart)} class={`flex-1 sm:hidden ${buttonClass("secondary")}`} aria-label="7 dias livres depois">
          Depois
          <Icon name="chevron-right" class="h-5 w-5" strokeWidth={2.2} />
        </a>
      ) : null
    }
  </div>
</div>

---
// Etiqueta neutra (R0): descreve o atendimento (serviço, local, série,
// agenda) e nunca é clicável. `strong`: o nome da agenda na lista do celular.
interface Props {
  strong?: boolean;
  class?: string;
}

const { strong = false, class: className = "" } = Astro.props;
---

<span class={`inline-flex items-center rounded-md px-1.5 text-[13px] leading-normal font-semibold ${strong ? "bg-ink text-white" : "bg-ink/[0.07] text-ink-mid"} ${className}`}>
  <slot />
</span>

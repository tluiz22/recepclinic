---
// Cancelamento em massa (Fase 12): "Selecionar todos/nenhum", "Cancelar
// selecionados" e o modal de confirmação. Vivia na aba Resumo do dia de
// Consultas; foi para a Agenda (dia) em 03/out/2026, quando o cliente decidiu
// deixar todas as ações na Agenda e o Resumo do dia só com informação.
// As caixinhas ficam nos cards (classe `mass-cancel-checkbox`); o valor pode
// trazer vários ids separados por vírgula (turma de exame = todos os
// pacientes ativos da turma).
---

<div class="mt-6 flex flex-wrap items-center justify-between gap-3">
  <div class="flex gap-3 text-sm">
    <button type="button" id="select_all_btn" class="text-sky-700 hover:underline">Selecionar todos</button>
    <button type="button" id="select_none_btn" class="text-sky-700 hover:underline">Selecionar nenhum</button>
  </div>
  <button
    type="button"
    id="mass_cancel_open_btn"
    class="rounded-md border border-red-300 px-3 py-2 text-sm font-semibold text-red-700 hover:bg-red-50 disabled:cursor-not-allowed disabled:opacity-50"
  >
    Cancelar selecionados (<span id="mass_cancel_count">0</span>)
  </button>
</div>

<dialog
  id="mass_cancel_dialog"
  class="w-[calc(100%-2rem)] max-w-sm rounded-lg border border-slate-200 bg-white p-0 shadow-xl backdrop:bg-slate-900/40"
>
  <div class="p-5">
    <h2 class="text-base font-semibold text-slate-900">Cancelar atendimentos selecionados?</h2>
    <p class="mt-2 text-sm text-slate-600">
      <span id="mass_cancel_dialog_count">0</span> atendimento(s) serão cancelados. Cada responsável recebe um aviso
      por WhatsApp (motivo: imprevisto da médica) com um link novo pra remarcar, válido por 2 dias.
    </p>
    <p id="mass_cancel_dialog_error" class="mt-2 hidden text-sm text-red-700">
      Não foi possível cancelar. Tente novamente.
    </p>
    <div class="mt-5 flex justify-end gap-2">
      <button
        type="button"
        id="mass_cancel_dialog_dismiss"
        class="rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50"
      >
        Voltar
      </button>
      <button
        type="button"
        id="mass_cancel_dialog_accept"
        class="rounded-md bg-red-600 px-3 py-2 text-sm font-medium text-white hover:bg-red-700 disabled:cursor-not-allowed disabled:opacity-50"
      >
        Cancelar atendimentos
      </button>
    </div>
  </div>
</dialog>

<script>
  const checkboxes = document.querySelectorAll<HTMLInputElement>(".mass-cancel-checkbox");
  const openBtn = document.getElementById("mass_cancel_open_btn") as HTMLButtonElement | null;
  const countLabel = document.getElementById("mass_cancel_count");
  const dialog = document.getElementById("mass_cancel_dialog") as HTMLDialogElement | null;
  const dialogCount = document.getElementById("mass_cancel_dialog_count");
  const dialogError = document.getElementById("mass_cancel_dialog_error");
  const dismissBtn = document.getElementById("mass_cancel_dialog_dismiss") as HTMLButtonElement | null;
  const acceptBtn = document.getElementById("mass_cancel_dialog_accept") as HTMLButtonElement | null;
  const selectAllBtn = document.getElementById("select_all_btn") as HTMLButtonElement | null;
  const selectNoneBtn = document.getElementById("select_none_btn") as HTMLButtonElement | null;

  if (checkboxes.length && openBtn && countLabel && dialog && dialogCount && dismissBtn && acceptBtn) {
    function selectedIds(): string[] {
      return Array.from(checkboxes)
        .filter((cb) => cb.checked)
        .flatMap((cb) => cb.value.split(",").filter(Boolean));
    }

    function refreshCount(): void {
      const n = selectedIds().length;
      countLabel!.textContent = String(n);
      openBtn!.disabled = n === 0;
    }

    checkboxes.forEach((cb) => cb.addEventListener("change", refreshCount));
    selectAllBtn?.addEventListener("click", () => {
      checkboxes.forEach((cb) => (cb.checked = true));
      refreshCount();
    });
    selectNoneBtn?.addEventListener("click", () => {
      checkboxes.forEach((cb) => (cb.checked = false));
      refreshCount();
    });
    refreshCount();

    openBtn.addEventListener("click", () => {
      dialogCount!.textContent = String(selectedIds().length);
      dialogError?.classList.add("hidden");
      acceptBtn!.disabled = false;
      acceptBtn!.textContent = "Cancelar atendimentos";
      dialog!.showModal();
    });

    dismissBtn.addEventListener("click", () => dialog!.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog!.close();
    });

    acceptBtn.addEventListener("click", async () => {
      const ids = selectedIds();
      if (!ids.length) return;

      acceptBtn!.disabled = true;
      acceptBtn!.textContent = "Cancelando…";
      dialogError?.classList.add("hidden");

      const response = await fetch("/api/admin/consultas/cancelar-em-massa", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ appointmentIds: ids }),
      });

      if (response.ok) {
        window.location.reload();
      } else {
        acceptBtn!.disabled = false;
        acceptBtn!.textContent = "Cancelar atendimentos";
        dialogError?.classList.remove("hidden");
      }
    });
  }
</script>

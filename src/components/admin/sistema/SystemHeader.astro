---
// Cabeçalho das telas do sistema (R10, cliente, 17/out/2026): "Sistema"
// pequeno acima do título (como "Configurações" na R9), linha de apoio e as
// ações à direita (slot "actions"); `back`: o link de volta acima.
import Icon from "../Icon.astro";

interface Props {
  title: string;
  subtitle?: string;
  /** Texto pequeno acima do título (padrão: "Sistema"). */
  kicker?: string;
  back?: { href: string; label: string };
}

const { title, subtitle, kicker = "Sistema", back } = Astro.props;
---

{
  back && (
    <a href={back.href} class="mb-2 inline-flex min-h-8 items-center gap-1 self-start text-[15px] font-semibold text-brand no-underline hover:underline">
      <Icon name="chevron-left" class="h-[18px] w-[18px]" strokeWidth={2.2} /> {back.label}
    </a>
  )
}
<div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-3">
  <div class="min-w-0">
    <span class="text-[12.5px] font-bold tracking-[.06em] text-ink-soft uppercase">{kicker}</span>
    <h1 class="mt-1 font-display text-[26px] leading-[1.1] font-bold break-words text-ink sm:text-[30px]">{title}</h1>
    {subtitle && <p class="mt-1.5 max-w-[820px] text-[15px] text-ink-soft">{subtitle}</p>}
  </div>
  {
    Astro.slots.has("actions") && (
      <div class="flex flex-wrap gap-2">
        <slot name="actions" />
      </div>
    )
  }
</div>

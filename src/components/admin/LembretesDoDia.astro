---
// Consultas › Lembretes (Fase 19 · etapa 5; aba de Métricas na Fase 23 ·
// etapa 4, movida para Consultas a pedido do cliente para a secretária usar
// no dia a dia): lembretes com botões enviados no dia escolhido (abre em
// hoje) e o que cada responsável tocou. Tocar num quadro mostra, logo
// abaixo, os pacientes daquele grupo com o responsável, o telefone e o
// atalho para o WhatsApp. O cartão "Presença não confirmada" do Início abre
// esta aba com "Não responderam".
import Card from "./Card.astro";
import Badge from "./Badge.astro";
import Icon from "./Icon.astro";
import PhoneLinks from "./PhoneLinks.astro";
import type { BadgeVariant } from "./Badge.astro";
import { createClient } from "../../lib/supabase/server";
import { formatWhen } from "../../lib/whatsapp/formatDateTime";
import { buildAppointmentTypeLabel } from "../../lib/whatsapp/notifications";
import type { ReminderOutcome } from "../../lib/metrics/reminderResponses";
import { fetchReminderResponseReport, formatPercent } from "../../lib/metrics/data";
import { addDays, todayFortaleza } from "../../lib/metrics/period";

interface Props {
  // Dia do envio, "AAAA-MM-DD" (Fortaleza).
  date: string;
}

const { date } = Astro.props;
const supabase = createClient(Astro.request, Astro.cookies);
const today = todayFortaleza();

const report = await fetchReminderResponseReport(
  supabase,
  new Date(`${date}T00:00:00-03:00`),
  new Date(`${addDays(date, 1)}T00:00:00-03:00`)
);

function lembretesUrl(params: { date?: string; lista?: string }): string {
  const search = new URLSearchParams({ tab: "lembretes" });
  if (params.date && params.date !== today) search.set("date", params.date);
  if (params.lista) search.set("lista", params.lista);
  return `/admin/consultas?${search.toString()}`;
}

type GroupId = "enviados" | "confirmaram" | "remarcar" | "cancelar" | "sem_resposta";

const OUTCOME_LABELS: Record<ReminderOutcome, { label: string; variant: BadgeVariant }> = {
  confirmed: { label: "Confirmou presença", variant: "success" },
  reschedule: { label: "Pediu para remarcar", variant: "info" },
  cancel: { label: "Pediu para cancelar", variant: "danger" },
  noResponse: { label: "Não respondeu", variant: "warning" },
};

const cards: {
  id: GroupId;
  label: string;
  value: number;
  color: string;
  ring: string;
  share: boolean;
  outcome: ReminderOutcome | null;
}[] = [
  { id: "enviados", label: "Lembretes enviados", value: report.sent, color: "text-sky-700", ring: "ring-sky-600", share: false, outcome: null },
  { id: "confirmaram", label: "Confirmaram presença", value: report.confirmed, color: "text-emerald-600", ring: "ring-emerald-600", share: true, outcome: "confirmed" },
  { id: "remarcar", label: "Pediram para remarcar", value: report.reschedule, color: "text-indigo-600", ring: "ring-indigo-600", share: true, outcome: "reschedule" },
  { id: "cancelar", label: "Pediram para cancelar", value: report.cancel, color: "text-red-600", ring: "ring-red-600", share: true, outcome: "cancel" },
  { id: "sem_resposta", label: "Não responderam", value: report.noResponse, color: "text-amber-600", ring: "ring-amber-600", share: true, outcome: "noResponse" },
];

const listParam = Astro.url.searchParams.get("lista");
const selected = cards.find((card) => card.id === listParam) ?? null;
const cardHref = (id: GroupId) => lembretesUrl({ date, lista: selected?.id === id ? undefined : id });

// Lista do cartão escolhido: paciente, responsável e atendimento.
interface ListRow {
  key: string;
  patientName: string;
  guardianName: string;
  phone: string | null;
  whenLabel: string;
  typeLabel: string;
  canceled: boolean;
  outcome: ReminderOutcome;
  historyHref: string | null;
}

let listRows: ListRow[] = [];
if (selected) {
  const items = report.items.filter((item) => selected.outcome === null || item.outcome === selected.outcome);
  const ids = [...new Set(items.map((item) => item.appointmentId))];
  const appointments = new Map<string, Record<string, unknown>>();
  // Lotes pequenos: a lista de ids vai na URL da consulta.
  for (let index = 0; index < ids.length; index += 150) {
    const { data } = await supabase
      .from("appointments")
      .select(
        "id, scheduled_at, status, appointment_type, exam_types ( name ), patients ( id, full_name, guardian_id, guardians ( full_name, phone ) )"
      )
      .in("id", ids.slice(index, index + 150));
    for (const row of data ?? []) appointments.set(row.id as string, row as Record<string, unknown>);
  }

  listRows = items
    .map((item, index): ListRow & { sortAt: number } => {
      const appointment = appointments.get(item.appointmentId);
      const patient = (appointment?.patients ?? null) as {
        id: string;
        full_name: string;
        guardian_id: string;
        guardians: { full_name: string; phone: string | null } | null;
      } | null;
      const examType = (appointment?.exam_types ?? null) as { name: string } | null;
      const scheduledAt = appointment ? new Date(appointment.scheduled_at as string) : null;
      return {
        key: `${item.appointmentId}-${index}`,
        patientName: patient?.full_name ?? "Paciente não encontrado",
        guardianName: patient?.guardians?.full_name ?? "—",
        phone: patient?.guardians?.phone ?? null,
        whenLabel: scheduledAt ? formatWhen(scheduledAt) : "—",
        typeLabel: appointment
          ? buildAppointmentTypeLabel(appointment.appointment_type as string, examType?.name)
          : "",
        canceled: appointment?.status === "canceled",
        outcome: item.outcome,
        historyHref: patient
          ? `/admin/pacientes/${patient.guardian_id}/criancas/${patient.id}/historico#card-${item.appointmentId}`
          : null,
        sortAt: scheduledAt?.getTime() ?? 0,
      };
    })
    .sort((a, b) => a.sortAt - b.sortAt);
}

---

<form method="GET" action="/admin/consultas" class="mt-4 flex items-center gap-1 sm:gap-2">
  <input type="hidden" name="tab" value="lembretes" />
  <a
    href={lembretesUrl({ date: addDays(date, -1) })}
    aria-label="Dia anterior"
    class="rounded-md p-2 text-slate-500 hover:bg-slate-100 hover:text-sky-700"
  >
    <Icon name="chevron-left" class="h-5 w-5" />
  </a>
  <input
    type="date"
    name="date"
    value={date}
    onchange="this.form.submit()"
    class="min-w-0 flex-1 rounded-md border border-slate-300 px-3 py-2 text-sm sm:flex-none"
  />
  <a
    href={lembretesUrl({ date: addDays(date, 1) })}
    aria-label="Próximo dia"
    class="rounded-md p-2 text-slate-500 hover:bg-slate-100 hover:text-sky-700"
  >
    <Icon name="chevron-right" class="h-5 w-5" />
  </a>
  {
    date !== today && (
      <a
        href={lembretesUrl({})}
        class="ml-1 shrink-0 rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50"
      >
        Hoje
      </a>
    )
  }
</form>

<p class="mt-3 text-sm text-slate-500">
  Atendimentos que receberam lembrete neste dia e o botão que o responsável tocou. Cada atendimento aparece uma vez,
  com a última resposta, mesmo que o lembrete tenha sido enviado mais de uma vez. "Pediram para
  remarcar/cancelar" conta o toque no botão, mesmo que não tenham concluído. Quem confirmou por ligação e foi marcado à
  mão não entra aqui. Toque num quadro para ver os pacientes.
</p>
<div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-5">
  {
    cards.map((card) => (
      <a
        href={cardHref(card.id)}
        aria-current={selected?.id === card.id ? "true" : undefined}
        class={`block rounded-lg border bg-white p-4 text-center shadow-sm hover:border-sky-400 ${
          selected?.id === card.id ? `border-transparent ring-2 ${card.ring}` : "border-slate-200"
        }`}
      >
        <p class={`text-3xl font-bold ${card.color}`}>{card.value}</p>
        <p class="mt-1 text-sm text-slate-600">{card.label}</p>
        {card.share && (
          <p class="mt-0.5 text-xs text-slate-400">
            {formatPercent(report.sent > 0 ? card.value / report.sent : null)}
          </p>
        )}
      </a>
    ))
  }
</div>

{
  selected && (
    <section class="mt-6">
      <div class="flex items-center justify-between gap-2">
        <h2 class="text-base font-semibold text-slate-900">
          {selected.label} ({listRows.length})
        </h2>
        <a href={cardHref(selected.id)} class="text-sm text-slate-500 hover:text-sky-700 hover:underline">
          Fechar lista
        </a>
      </div>
      {listRows.length === 0 ? (
        <p class="mt-3 text-sm text-slate-500">Ninguém nesse grupo neste dia.</p>
      ) : (
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          {listRows.map((row) => (
            <Card>
              <div class="flex items-start justify-between gap-2">
                <div>
                  <p class="font-medium text-slate-900">{row.patientName}</p>
                  <p class="text-sm text-slate-600">Responsável: {row.guardianName}</p>
                </div>
                {selected.outcome === null && (
                  <Badge variant={OUTCOME_LABELS[row.outcome].variant}>{OUTCOME_LABELS[row.outcome].label}</Badge>
                )}
              </div>
              <p class="mt-2 text-sm text-slate-600">
                {row.typeLabel} · {row.whenLabel}
                {row.canceled && <span class="ml-1 text-red-600">(cancelado)</span>}
              </p>
              {row.phone ? (
                <PhoneLinks phone={row.phone} class="mt-3 text-sm" />
              ) : (
                <p class="mt-3 text-sm text-slate-500">Sem telefone cadastrado.</p>
              )}
              {row.historyHref && (
                <a
                  href={row.historyHref}
                  class="mt-3 block border-t border-slate-100 pt-2 text-xs text-slate-500 hover:text-sky-700 hover:underline"
                >
                  Ver histórico do atendimento
                </a>
              )}
            </Card>
          ))}
        </div>
      )}
    </section>
  )
}

---
// Cartão base reutilizado pelas telas do admin (Agenda, e as próximas do
// redesenho visual — Pacientes, Configurações). Ver plano, "Redesenho visual
// do admin".
interface Props {
  class?: string;
  muted?: boolean;
  /** Âncora (ex.: seções do roteiro de vendas). */
  id?: string;
}

const { class: className = "", muted = false, id } = Astro.props;
// Fundo próprio (ex.: cor da situação na Agenda) no lugar do branco; `hover:bg-` não conta.
const ownBackground = /(^|\s)bg-/.test(className);
---

<div id={id} class={`rounded-lg border border-slate-200 ${ownBackground ? "" : "bg-white"} p-4 shadow-sm ${muted ? "opacity-60" : ""} ${className}`}>
  <slot />
</div>

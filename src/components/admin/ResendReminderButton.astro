---
// Botão do lembrete (Fase 22 · etapa 6) — só renderizado para atendimento
// com ação (`fetchReminderActions`): "Enviar lembrete" quando ainda não houve
// tentativa, "Reenviar lembrete" depois de uma que não foi entregue (Fase 23 ·
// etapa 3).
import type { ReminderAction } from "../../lib/reminderResend";

interface Props {
  appointmentId: string;
  action: ReminderAction;
  // Tela pra onde voltar depois do reenvio.
  returnTo: string;
}

const { appointmentId, action, returnTo } = Astro.props;
---

<form
  method="POST"
  action={`/api/admin/agenda/appointments/${appointmentId}/resend-reminder`}
  class="resend-reminder-form"
>
  <input type="hidden" name="return_to" value={returnTo} />
  <button
    type="submit"
    class="rounded-md border border-amber-300 px-2.5 py-1 text-xs font-semibold text-amber-700 hover:bg-amber-50 disabled:opacity-60"
  >
    {action === "send" ? "Enviar lembrete" : "Reenviar lembrete"}
  </button>
</form>

<script>
  // Evita dois lembretes num clique duplo.
  document.querySelectorAll<HTMLFormElement>(".resend-reminder-form").forEach((form) => {
    form.addEventListener("submit", () => {
      const button = form.querySelector("button");
      if (button) {
        button.disabled = true;
        button.textContent = "Enviando…";
      }
    });
  });
</script>

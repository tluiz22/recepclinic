---
// Botão "Reenviar lembrete" (Fase 22 · etapa 6) — só renderizado para
// atendimento que pode reenviar (`fetchReminderResendable`).
interface Props {
  appointmentId: string;
  // Tela pra onde voltar depois do reenvio.
  returnTo: string;
}

const { appointmentId, returnTo } = Astro.props;
---

<form
  method="POST"
  action={`/api/admin/agenda/appointments/${appointmentId}/resend-reminder`}
  class="resend-reminder-form"
>
  <input type="hidden" name="return_to" value={returnTo} />
  <button
    type="submit"
    class="rounded-md border border-amber-300 px-2.5 py-1 text-xs font-semibold text-amber-700 hover:bg-amber-50 disabled:opacity-60"
  >
    Reenviar lembrete
  </button>
</form>

<script>
  // Evita dois lembretes num clique duplo.
  document.querySelectorAll<HTMLFormElement>(".resend-reminder-form").forEach((form) => {
    form.addEventListener("submit", () => {
      const button = form.querySelector("button");
      if (button) {
        button.disabled = true;
        button.textContent = "Enviando…";
      }
    });
  });
</script>

---
// Assinatura em passo a passo (F12.2e; opção B do desenho de 03/nov/2026;
// F12.2i, 04/nov/2026): Contrato → Cartão (ou Pagamento, no Pix) → WhatsApp
// (opcional) → Pronto. O passo atual em destaque; os já feitos com o visto; o
// pagamento pendente (a clínica fechou o Asaas sem pagar) em laranja.
import type { Step, StepKey } from "../../../lib/billingSteps";

interface Props {
  steps: Step[];
  current: StepKey;
  /** O passo atual está pendente (cartão não informado ao voltar à tela). */
  late?: boolean;
}

const { steps, current, late = false } = Astro.props;
---

<ol class="flex flex-wrap items-center gap-x-3 gap-y-2 text-[15px]" aria-label="Passos da assinatura">
  {
    steps.map((step, index) => (
      <>
        {index > 0 && <li aria-hidden="true" class={`hidden h-0.5 min-w-6 flex-1 sm:block ${steps[index - 1].done ? "bg-brand" : "bg-line"}`} />}
        <li class={`flex items-center gap-2 ${step.key === current ? "font-semibold text-ink" : step.done ? "text-brand" : "text-ink-soft"}`} aria-current={step.key === current ? "step" : undefined}>
          {step.done ? (
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-soft text-brand">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12l5 5L20 7" />
              </svg>
            </span>
          ) : (
            <span
              class={`flex h-8 w-8 items-center justify-center rounded-full font-bold ${
                step.key === current ? (late ? "bg-pend-800 text-white" : "bg-brand text-white") : "border-2 border-line text-ink-soft"
              }`}
            >
              {index + 1}
            </span>
          )}
          {step.key === current && late ? `${step.label} (pendente)` : step.label}
        </li>
      </>
    ))
  }
</ol>

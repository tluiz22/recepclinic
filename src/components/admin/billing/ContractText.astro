---
// Faturamento (F12.2b): o texto do contrato (provisório até o do advogado),
// com a versão. Aberto na tela de aceite; recolhido nos demais lugares.
import { billingContractTerms } from "../../../lib/billingContractText";

interface Props {
  /** Versão do texto que o contrato guardou; outra que não a atual mostra só o aviso. */
  version: string;
  open?: boolean;
}

const { version, open = false } = Astro.props;
// Com nota fiscal ou sem (cliente, 03/nov/2026): o texto da versão guardada.
const sections = billingContractTerms(version);
---

<details class="rounded-lg border border-line text-sm text-ink-mid" open={open}>
  <summary class="cursor-pointer px-3 py-2 font-medium text-ink">Texto do contrato</summary>
  <div class="max-h-80 overflow-y-auto border-t border-line px-3 py-2">
    {
      sections ? (
        sections.map((section) => (
          <section class="mt-2 first:mt-0">
            <h3 class="font-semibold text-ink">{section.title}</h3>
            {section.paragraphs.map((p) => (
              <p class="mt-1">{p}</p>
            ))}
          </section>
        ))
      ) : (
        <p>Este contrato usa um texto anterior. Para recebê-lo, fale com o Suporte do RecepClinic.</p>
      )
    }
    <p class="mt-3 text-xs text-ink-soft">Versão do texto: {version}.</p>
  </div>
</details>

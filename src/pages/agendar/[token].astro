---
// Página pública de agendar ou remarcar pelo link (F5.2), com a marca da
// clínica (F5.1). A clínica vem do link (plataforma) e todo o resto usa a
// credencial limitada a ela (D1). Cada horário mostra o profissional e o
// local quando houver mais de um (cliente, 05/out/2026). A confirmação pelo
// WhatsApp vem na F6.
import "../../styles/global.css";
import PublicFooter from "../../components/PublicFooter.astro";
import PublicHeader from "../../components/public/PublicHeader.astro";
import { formatCalendarDate, formatInstant } from "../../lib/clinicTime";
import { createClinicServiceClient } from "../../lib/data/clinicService";
import {
  listLinkDates,
  listLinkGroupSessions,
  listLinkSlots,
  loadBookingPage,
  logBookingPageStep,
  slotChoiceValue,
  slotDetails,
  type BookingPage,
  type PublicSlot,
} from "../../lib/data/agenda/publicBooking";
import { DEFAULT_BRAND_COLOR, getPublicClinicBrand, type PublicClinicBrand } from "../../lib/data/config/brand";
import { DataError } from "../../lib/data/errors";
import { resolveClinicByBookingLink } from "../../lib/data/platform";
import { readableTextColor } from "../../lib/brandColor";
import { formatPhoneBR } from "../../lib/phone";
import { capitalize, vocabularyFor } from "../../lib/vocabulary";

const token = Astro.params.token ?? "";
const clinicId = await resolveClinicByBookingLink(token);
const db = clinicId ? createClinicServiceClient(clinicId) : null;

let page: BookingPage | null = null;
let brand: PublicClinicBrand | null = null;
if (clinicId && db) {
  [page, brand] = await Promise.all([
    loadBookingPage(db, clinicId, token).catch((error) => {
      if (error instanceof DataError && error.code === "not_found") return null;
      throw error;
    }),
    getPublicClinicBrand(db, clinicId),
  ]);
}
if (!page) Astro.response.status = 404;

let dates: { date: string }[] = [];
let slots: PublicSlot[] = [];
let sessions: PublicSlot[] = [];
let selectedDate = "";
if (page?.state === "form" && db && clinicId) {
  if (page.service.isGroup) {
    sessions = await listLinkGroupSessions(db, clinicId, page);
  } else {
    dates = await listLinkDates(db, clinicId, page);
    const asked = Astro.url.searchParams.get("date");
    selectedDate = asked && dates.some((d) => d.date === asked) ? asked : (dates[0]?.date ?? "");
    if (selectedDate) slots = await listLinkSlots(db, clinicId, page, selectedDate);
  }
}

// Funil do bot: a volta depois de uma confirmação que falhou (?error=) não conta de novo.
if (page && db && clinicId && !Astro.url.searchParams.has("error")) {
  if (page.state === "form") {
    await logBookingPageStep(db, clinicId, page, "page_opened", { available_dates: page.service.isGroup ? sessions.length : dates.length });
  } else if (page.state === "expired") {
    await logBookingPageStep(db, clinicId, page, "link_expired");
  }
}

const words = vocabularyFor(page?.profile ?? "mixed");
const timeZone = page?.timeZone ?? "America/Fortaleza";
const isReschedule = page?.link.mode === "reschedule";
const serviceName = page?.service.name ?? "";

const errorMessages: Record<string, string> = {
  slot_taken: "Esse horário acabou de deixar de estar livre. Escolha outro.",
  return_used: "O retorno dessa consulta já foi marcado. Para um novo atendimento, fale com a clínica pelo WhatsApp.",
  duplicate: `${capitalize(words.patient)} já tem um atendimento marcado. Para mudar, fale com a clínica pelo WhatsApp.`,
  failed: "Não foi possível confirmar. Tente de novo.",
};
const errorParam = Astro.url.searchParams.get("error");
const errorMessage = errorParam ? (errorMessages[errorParam] ?? errorMessages.failed) : null;

const pageTitle = !page
  ? "Link inválido"
  : page.state === "expired"
    ? "Link expirado"
    : page.state === "used"
      ? "Atendimento marcado"
      : `${isReschedule ? "Remarcar" : "Agendar"}: ${serviceName}`;

const formatDay = (date: string) => capitalize(formatCalendarDate(date, "EEEE, dd/MM/yyyy"));
const formatWhen = (instant: Date) => formatInstant(instant, timeZone, "dd/MM/yyyy 'às' HH'h'mm");
const slotExtra = (slot: PublicSlot) => (page ? slotDetails(page.candidates, slot) : "");
const confirmed = page?.state === "used" ? page.appointment : null;
const confirmedActive = confirmed && (confirmed.status === "scheduled" || confirmed.status === "confirmed");
const buttonColor = brand?.brandColor ?? DEFAULT_BRAND_COLOR;
const SLOT_LABEL = "cursor-pointer rounded-md border border-slate-300 bg-white px-3 py-2 text-sm has-[:checked]:border-slate-900 has-[:checked]:ring-1 has-[:checked]:ring-slate-900";
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle} | {brand?.name ?? "RecepClinic"}</title>
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50 text-slate-900">
    {brand && <PublicHeader brand={brand} />}
    <main class="mx-auto w-full max-w-xl flex-1 px-4 py-10">
      {
        !page && (
          <div class="rounded-md border border-slate-200 bg-white p-6 text-center">
            <h1 class="text-lg font-bold text-slate-900">Link inválido</h1>
            <p class="mt-2 text-sm text-slate-600">Este link de agendamento não existe. Volte à conversa no WhatsApp e peça um novo.</p>
          </div>
        )
      }

      {
        page?.state === "expired" && (
          <div class="rounded-md border border-slate-200 bg-white p-6 text-center">
            <h1 class="text-lg font-bold text-slate-900">Link expirado</h1>
            <p class="mt-2 text-sm text-slate-600">Este link de agendamento venceu. Volte à conversa no WhatsApp e peça um novo link.</p>
          </div>
        )
      }

      {
        page?.state === "used" && confirmed && confirmedActive && (
          <div class="rounded-md border border-emerald-200 bg-emerald-50 p-6 text-center">
            <h1 class="text-lg font-bold text-emerald-900">{isReschedule ? "Atendimento remarcado!" : "Atendimento confirmado!"}</h1>
            <p class="mt-2 text-sm text-emerald-800">
              {serviceName} · {page.patient.fullName} · {formatWhen(confirmed.scheduledAt)}
            </p>
            <p class="mt-1 text-sm text-emerald-800">{[confirmed.agendaName, confirmed.locationName].filter(Boolean).join(" · ")}</p>
            {confirmed.address && <p class="mt-1 text-sm text-emerald-800">{confirmed.address}</p>}
            {
              page.service.hasPreparation && (
                <a
                  href={`/preparo/${page.service.id}`}
                  class="mt-4 inline-block rounded-md border border-emerald-300 bg-white px-4 py-2 text-sm font-medium text-emerald-800 hover:bg-emerald-100"
                >
                  Ver o preparo do exame
                </a>
              )
            }
          </div>
        )
      }

      {
        page?.state === "used" && !(confirmed && confirmedActive) && (
          <div class="rounded-md border border-slate-200 bg-white p-6 text-center">
            <h1 class="text-lg font-bold text-slate-900">{confirmed ? "Atendimento cancelado" : "Link já usado"}</h1>
            <p class="mt-2 text-sm text-slate-600">
              {confirmed
                ? "Este atendimento foi cancelado. Para marcar de novo, fale com a clínica pelo WhatsApp."
                : "Este link já foi usado. Para marcar ou mudar um atendimento, fale com a clínica pelo WhatsApp."}
            </p>
          </div>
        )
      }

      {
        page?.state === "form" && (
          <>
            <h1 class="text-2xl font-bold text-slate-900">{isReschedule ? "Remarcar" : "Agendar"}: {serviceName}</h1>
            {page.candidates.agendas.length === 1 && <p class="mt-1 text-sm text-slate-600">{page.candidates.agendas[0].name}</p>}
            {
              isReschedule && page.appointment && (
                <p class="mt-2 text-sm text-slate-600">Atendimento atual: {formatWhen(page.appointment.scheduledAt)}</p>
              )
            }

            {errorMessage && <p class="mt-4 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">{errorMessage}</p>}

            <div class="mt-6 rounded-md border border-slate-200 bg-white p-4 text-sm text-slate-700">
              <p class="font-medium text-slate-900">{capitalize(words.patient)}</p>
              <p>
                {page.patient.fullName} · nascimento em {formatCalendarDate(page.patient.birthdate, "dd/MM/yyyy")}
              </p>
              {
                page.contact.fullName && page.contact.fullName !== page.patient.fullName && (
                  <>
                    <p class="mt-2 font-medium text-slate-900">{capitalize(words.contact)}</p>
                    <p>
                      {page.contact.fullName} · {formatPhoneBR(page.contact.phone)}
                    </p>
                  </>
                )
              }
            </div>

            {
              page.link.homeVisitAddress && page.link.locationCategory === "home_visit" && (
                <div class="mt-3 rounded-md border border-slate-200 bg-white p-4 text-sm text-slate-700">
                  <p class="font-medium text-slate-900">Endereço do atendimento</p>
                  <p>{page.link.homeVisitAddress}</p>
                </div>
              )
            }

            <form method="POST" action={`/api/agendar/${page.link.id}/confirmar`} class="mt-6 flex flex-col gap-6">
              {
                page.service.isGroup ? (
                  <div>
                    <span class="block text-sm font-medium text-slate-700">Dia e horário</span>
                    {sessions.length ? (
                      <div class="mt-1 flex flex-col gap-2">
                        {sessions.map((session) => (
                          <label class={SLOT_LABEL}>
                            <input type="radio" name="start" value={slotChoiceValue(session)} required class="mr-2" />
                            {formatInstant(session.start, timeZone, "EEEE, dd/MM 'às' HH:mm").replace(/^./, (c) => c.toUpperCase())}
                            {slotExtra(session) && <span class="text-slate-500"> · {slotExtra(session)}</span>}
                            <span class="text-slate-500">
                              {" "}
                              · {session.remaining} {session.remaining === 1 ? "vaga" : "vagas"}
                            </span>
                          </label>
                        ))}
                      </div>
                    ) : (
                      <p class="mt-1 text-sm text-slate-500">Não encontramos vaga nos próximos dias. Fale com a clínica pelo WhatsApp.</p>
                    )}
                  </div>
                ) : (
                  <>
                    <div>
                      <label for="date" class="block text-sm font-medium text-slate-700">
                        Data
                      </label>
                      {dates.length ? (
                        <select id="date" name="date" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm">
                          {dates.map((d) => (
                            <option value={d.date} selected={d.date === selectedDate}>
                              {formatDay(d.date)}
                            </option>
                          ))}
                        </select>
                      ) : (
                        <p class="mt-1 text-sm text-slate-500">
                          Não encontramos horários livres nos próximos dias. Fale com a clínica pelo WhatsApp.
                        </p>
                      )}
                    </div>
                    <div>
                      <span class="block text-sm font-medium text-slate-700">Horário</span>
                      <div id="slots_container" data-slot-class={SLOT_LABEL} class="mt-1 flex flex-wrap gap-2">
                        {slots.length ? (
                          slots.map((slot) => (
                            <label class={SLOT_LABEL}>
                              <input type="radio" name="start" value={slotChoiceValue(slot)} required class="mr-1" />
                              {formatInstant(slot.start, timeZone, "HH:mm")}
                              {slotExtra(slot) && <span class="text-slate-500"> · {slotExtra(slot)}</span>}
                            </label>
                          ))
                        ) : (
                          dates.length > 0 && <p class="text-sm text-slate-500">Nenhum horário livre nesse dia. Escolha outra data.</p>
                        )}
                      </div>
                    </div>
                  </>
                )
              }

              <button
                id="submit_btn"
                type="submit"
                disabled={page.service.isGroup ? !sessions.length : !slots.length}
                class="w-fit rounded-md px-4 py-2 text-sm font-medium hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
                style={`background-color: ${buttonColor}; color: ${readableTextColor(buttonColor)};`}
              >
                {isReschedule ? "Confirmar remarcação" : "Confirmar"}
              </button>
            </form>
          </>
        )
      }
    </main>
    <PublicFooter />
  </body>
</html>

<script>
  // Trocar a data busca os horários do dia sem recarregar a página.
  const dateSelect = document.getElementById("date") as HTMLSelectElement | null;
  const container = document.getElementById("slots_container") as HTMLDivElement | null;
  const submit = document.getElementById("submit_btn") as HTMLButtonElement | null;
  const form = dateSelect?.form;

  if (dateSelect && container && submit && form) {
    const slotClass = container.dataset.slotClass ?? "";
    const message = (text: string, tone = "text-slate-500") => {
      container.replaceChildren();
      const p = document.createElement("p");
      p.className = `text-sm ${tone}`;
      p.textContent = text;
      container.append(p);
    };

    dateSelect.addEventListener("change", async () => {
      message("Buscando horários…");
      submit.disabled = true;
      const confirmUrl = form.getAttribute("action") ?? "";
      const response = await fetch(`${confirmUrl.replace(/\/confirmar$/, "/slots")}?date=${encodeURIComponent(dateSelect.value)}`);
      if (!response.ok) {
        message("Não foi possível buscar os horários. Tente de novo.", "text-red-700");
        return;
      }
      const { slots } = (await response.json()) as { slots: { value: string; time: string; extra: string }[] };
      if (!slots.length) {
        message("Nenhum horário livre nesse dia. Escolha outra data.");
        return;
      }
      container.replaceChildren();
      for (const slot of slots) {
        const label = document.createElement("label");
        label.className = slotClass;
        const input = document.createElement("input");
        input.type = "radio";
        input.name = "start";
        input.value = slot.value;
        input.required = true;
        input.className = "mr-1";
        label.append(input, slot.time);
        if (slot.extra) {
          const extra = document.createElement("span");
          extra.className = "text-slate-500";
          extra.textContent = ` · ${slot.extra}`;
          label.append(extra);
        }
        container.append(label);
      }
      submit.disabled = false;
    });
  }
</script>

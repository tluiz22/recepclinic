---
// Página pública de agendar ou remarcar pelo link (F5.2), com a marca da
// clínica (F5.1). A clínica vem do link (plataforma) e todo o resto usa a
// credencial limitada a ela (D1). Cada horário mostra o profissional e o
// local quando houver mais de um (cliente, 05/out/2026). A confirmação pelo
// WhatsApp vem na F6.
//
// Redesign R11 (cliente, 17/out/2026): faixa de dias com setas e horários por
// turno (como o Marcar do painel), barra fixa com o escolhido e o "Confirmar"
// no celular e o resumo ao lado no computador, a confirmação em linhas e os
// avisos do link num padrão, com "Falar com a clínica no WhatsApp".
import { DEFAULT_DESIGNATION, designationText } from "../../lib/designation";
import LinkNotice from "../../components/public/LinkNotice.astro";
import PatientDayStrip from "../../components/public/PatientDayStrip.astro";
import PatientSlots, { type PatientSlot } from "../../components/public/PatientSlots.astro";
import { PATIENT_BUTTON, PATIENT_CARD, PATIENT_LABEL, PATIENT_STEP } from "../../components/public/styles";
import PatientLayout from "../../layouts/PatientLayout.astro";
import { formatCalendarDate, formatInstant, isCalendarDate } from "../../lib/clinicTime";
import { createClinicServiceClient } from "../../lib/data/clinicService";
import {
  listLinkDates,
  listLinkGroupSessions,
  listLinkSlots,
  loadBookingPage,
  logBookingPageStep,
  slotChoiceValue,
  slotDetails,
  type BookingPage,
  type PublicSlot,
} from "../../lib/data/agenda/publicBooking";
import { getPublicClinicBrand, type PublicClinicBrand } from "../../lib/data/config/brand";
import { DataError } from "../../lib/data/errors";
import { resolveClinicByBookingLink } from "../../lib/data/platform";
import { buildDayStrip, type DayStrip } from "../../lib/dayStrip";
import { formatPhoneBR } from "../../lib/phone";
import { capitalize, vocabularyFor } from "../../lib/vocabulary";

const token = Astro.params.token ?? "";
const clinicId = await resolveClinicByBookingLink(token);
const db = clinicId ? createClinicServiceClient(clinicId) : null;

let page: BookingPage | null = null;
let brand: PublicClinicBrand | null = null;
if (clinicId && db) {
  [page, brand] = await Promise.all([
    loadBookingPage(db, clinicId, token).catch((error) => {
      if (error instanceof DataError && error.code === "not_found") return null;
      throw error;
    }),
    getPublicClinicBrand(db, clinicId),
  ]);
}
if (!page) Astro.response.status = 404;

const param = (name: string) => {
  const value = Astro.url.searchParams.get(name);
  return value && isCalendarDate(value) ? value : null;
};
let strip: DayStrip | null = null;
let slots: PublicSlot[] = [];
let sessions: PublicSlot[] = [];
let availableDays = 0;
if (page?.state === "form" && db && clinicId) {
  if (page.service.isGroup) {
    sessions = await listLinkGroupSessions(db, clinicId, page);
  } else {
    const dates = (await listLinkDates(db, clinicId, page)).map((d) => d.date);
    availableDays = dates.length;
    strip = buildDayStrip(dates, param("date"), param("start"));
    if (strip.selected) slots = await listLinkSlots(db, clinicId, page, strip.selected);
  }
}

// Funil do bot: a volta depois de uma confirmação que falhou (?error=) não conta de novo; um
// dia ou uma seta da faixa (?date=, ?start=) conta como troca de data, não como página aberta.
const picked = Astro.url.searchParams.has("date") || Astro.url.searchParams.has("start");
if (page && db && clinicId && !Astro.url.searchParams.has("error")) {
  if (page.state === "form" && picked && strip) {
    await logBookingPageStep(db, clinicId, page, "date_changed", { date: strip.selected, slots: slots.length });
  } else if (page.state === "form") {
    await logBookingPageStep(db, clinicId, page, "page_opened", { available_dates: page.service.isGroup ? sessions.length : availableDays });
  } else if (page.state === "expired") {
    await logBookingPageStep(db, clinicId, page, "link_expired");
  }
}

const words = vocabularyFor(page?.profile ?? "mixed");
// "fale com o consultório": como a clínica é chamada (cliente, 11/out/2026).
const clinicWord = designationText(brand?.designation ?? DEFAULT_DESIGNATION);
const whatsappPhone = brand?.whatsappPhone ?? null;
const timeZone = page?.timeZone ?? "America/Fortaleza";
const isReschedule = page?.link.mode === "reschedule";
const serviceName = page?.service.name ?? "";

const errorMessages: Record<string, string> = {
  slot_taken: "Esse horário acabou de deixar de estar livre. Escolha outro.",
  return_used: `O retorno dessa consulta já foi marcado. Para um novo atendimento, fale com ${clinicWord} pelo WhatsApp.`,
  duplicate: `${capitalize(words.patient)} já tem um atendimento marcado. Para mudar, fale com ${clinicWord} pelo WhatsApp.`,
  failed: "Não foi possível confirmar. Tente de novo.",
};
const errorParam = Astro.url.searchParams.get("error");
const errorMessage = errorParam ? (errorMessages[errorParam] ?? errorMessages.failed) : null;

const formatDay = (date: string) => capitalize(formatCalendarDate(date, "EEEE, dd/MM/yyyy"));
const formatWhen = (instant: Date) => formatInstant(instant, timeZone, "dd/MM/yyyy 'às' HH'h'mm");
const formatLongWhen = (instant: Date) => capitalize(formatInstant(instant, timeZone, "EEEE, dd/MM/yyyy 'às' HH'h'mm"));
// "Qui, 23/10 às 09:30": o escolhido na barra e no resumo.
const summaryOf = (instant: Date) =>
  `${capitalize(formatInstant(instant, timeZone, "EEE").slice(0, 3))}, ${formatInstant(instant, timeZone, "dd/MM 'às' HH:mm")}`;
const slotExtra = (slot: PublicSlot) => (page ? slotDetails(page.candidates, slot) : "");
const slotOptions: PatientSlot[] = slots.map((slot) => ({
  value: slotChoiceValue(slot),
  label: formatInstant(slot.start, timeZone, "HH:mm"),
  detail: slotExtra(slot),
  summary: summaryOf(slot.start),
}));
const sessionOptions: PatientSlot[] = sessions.map((session) => ({
  value: slotChoiceValue(session),
  label: capitalize(formatInstant(session.start, timeZone, "EEEE, dd/MM 'às' HH:mm")),
  detail: slotExtra(session),
  summary: summaryOf(session.start),
  remaining: session.remaining ?? undefined,
}));
const hasChoice = page?.service.isGroup ? sessionOptions.length > 0 : slotOptions.length > 0;
const dayHref = (date: string, start: string) => `?${new URLSearchParams({ date, start })}`;
const confirmed = page?.state === "used" ? page.appointment : null;
const confirmedActive = confirmed && (confirmed.status === "scheduled" || confirmed.status === "confirmed");
// O título da aba é o da página (teste da R11, QA-02): confirmado, remarcado, cancelado ou já usado.
const pageTitle = !page
  ? "Link inválido"
  : page.state === "expired"
    ? "Link expirado"
    : page.state === "used"
      ? confirmedActive
        ? isReschedule
          ? "Atendimento remarcado"
          : "Atendimento confirmado"
        : confirmed
          ? "Atendimento cancelado"
          : "Link já usado"
      : `${isReschedule ? "Remarcar" : "Agendar"}: ${serviceName}`;
const submitLabel = isReschedule ? "Confirmar remarcação" : "Confirmar";
const showContact = !!page && !!page.contact.fullName && page.contact.fullName !== page.patient.fullName;
const notice = "rounded-[10px] border px-3.5 py-3 text-base leading-snug";
---

<PatientLayout title={pageTitle} brand={brand} width={page?.state === "form" ? "wide" : "reading"}>
  {
    !page && (
      <LinkNotice icon="warning" title="Link inválido">
        Este link de agendamento não existe. Volte à conversa no WhatsApp e peça um novo.
      </LinkNotice>
    )
  }

  {
    page?.state === "expired" && (
      <LinkNotice icon="clock" title="Link expirado" tone="warning" whatsappPhone={whatsappPhone} clinicWord={clinicWord}>
        Este link de agendamento venceu. Volte à conversa no WhatsApp e peça um novo link.
      </LinkNotice>
    )
  }

  {
    page?.state === "used" && confirmed && confirmedActive && (
      <section class={`${PATIENT_CARD} flex flex-col gap-4 rounded-2xl px-[18px] py-6 sm:px-7`} role="status">
        <div class="flex items-center gap-3">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-emerald-50 text-emerald-700">
            <svg aria-hidden="true" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10" /></svg>
          </span>
          <h1 class="text-2xl leading-tight font-bold text-gray-900">{isReschedule ? "Atendimento remarcado!" : "Atendimento confirmado!"}</h1>
        </div>
        <dl class="flex flex-col border-t border-gray-100">
          <div class="flex flex-col gap-px border-b border-gray-100 py-2.5">
            <dt class={PATIENT_LABEL}>Quando</dt>
            <dd class="text-[16.5px] font-bold text-gray-900">{formatLongWhen(confirmed.scheduledAt)}</dd>
          </div>
          <div class="flex flex-col gap-px border-b border-gray-100 py-2.5">
            <dt class={PATIENT_LABEL}>{page.service.category === "exam" ? "Exame" : "Serviço"}</dt>
            <dd class="text-[16.5px] text-gray-900">{serviceName}</dd>
          </div>
          <div class="flex flex-col gap-px border-b border-gray-100 py-2.5">
            <dt class={PATIENT_LABEL}>{capitalize(words.patient)}</dt>
            <dd class="text-[16.5px] text-gray-900">{page.patient.fullName}</dd>
          </div>
          {
            confirmed.agendaName && (
              <div class="flex flex-col gap-px border-b border-gray-100 py-2.5">
                <dt class={PATIENT_LABEL}>Com quem</dt>
                <dd class="text-[16.5px] text-gray-900">{confirmed.agendaName}</dd>
              </div>
            )
          }
          {
            (confirmed.locationName || confirmed.address) && (
              <div class="flex flex-col gap-px border-b border-gray-100 py-2.5">
                <dt class={PATIENT_LABEL}>Onde</dt>
                <dd class="text-[16.5px] text-gray-900">
                  {confirmed.locationName}
                  {confirmed.address && <span class="block text-gray-700">{confirmed.address}</span>}
                </dd>
              </div>
            )
          }
        </dl>
        {
          page.service.hasPreparation && (
            <a href={`/preparo/${page.service.id}`} class={`${PATIENT_BUTTON} w-full`}>
              Ver o preparo do exame
            </a>
          )
        }
      </section>
    )
  }

  {
    page?.state === "used" && !(confirmed && confirmedActive) && (
      <LinkNotice icon={confirmed ? "x-mark" : "check-circle"} title={confirmed ? "Atendimento cancelado" : "Link já usado"} whatsappPhone={whatsappPhone} clinicWord={clinicWord}>
        {confirmed
          ? `Este atendimento foi cancelado. Para marcar de novo, fale com ${clinicWord} pelo WhatsApp.`
          : `Este link já foi usado. Para marcar ou mudar um atendimento, fale com ${clinicWord} pelo WhatsApp.`}
      </LinkNotice>
    )
  }

  {
    page?.state === "form" && (
      <>
        <div>
          <p class="text-[15px] font-semibold text-clinic-ink">{isReschedule ? "Remarcar" : "Agendar"}</p>
          <h1 class="mt-0.5 text-[26px] leading-tight font-bold text-gray-900 sm:text-3xl">{serviceName}</h1>
          {page.candidates.agendas.length === 1 && <p class="mt-1 text-base text-gray-600">{page.candidates.agendas[0].name}</p>}
        </div>

        {
          isReschedule && page.appointment && (
            <p class={`${PATIENT_CARD} flex flex-wrap items-baseline gap-x-3 gap-y-0.5 px-4 py-3`}>
              <span class={PATIENT_LABEL}>Atendimento atual</span>
              <span class="text-[16.5px] font-bold text-gray-900">{formatWhen(page.appointment.scheduledAt)}</span>
            </p>
          )
        }

        {errorMessage && <p class={`${notice} border-red-200 bg-red-50 text-red-800`} role="alert">{errorMessage}</p>}

        <div class={`${PATIENT_CARD} flex flex-col gap-2.5 px-4 py-3.5 lg:hidden`}>
          <p class="flex flex-col">
            <span class={PATIENT_LABEL}>{capitalize(words.patient)}</span>
            <span class="text-[16.5px] text-gray-900">{page.patient.fullName} · nascimento em {formatCalendarDate(page.patient.birthdate, "dd/MM/yyyy")}</span>
          </p>
          {
            showContact && (
              <p class="flex flex-col">
                <span class={PATIENT_LABEL}>{capitalize(words.contact)}</span>
                <span class="text-[16.5px] text-gray-900">{page.contact.fullName} · {formatPhoneBR(page.contact.phone)}</span>
              </p>
            )
          }
        </div>

        {
          page.link.homeVisitAddress && page.link.locationCategory === "home_visit" && (
            <p class={`${PATIENT_CARD} flex flex-col px-4 py-3.5`}>
              <span class={PATIENT_LABEL}>Endereço do atendimento</span>
              <span class="text-[16.5px] text-gray-900">{page.link.homeVisitAddress}</span>
            </p>
          )
        }

        <form id="agendar" method="POST" action={`/api/agendar/${page.link.id}/confirmar`} class="flex flex-col gap-6">
          <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_300px]">
            <div id="agendar-escolha" class="flex min-w-0 flex-col gap-6" aria-live="polite">
              {
                page.service.isGroup ? (
                  <div class="flex flex-col gap-3">
                    <h2 class={PATIENT_STEP}>Escolha o dia e o horário</h2>
                    {sessionOptions.length ? (
                      <PatientSlots options={sessionOptions} sessions />
                    ) : (
                      <p class={`${notice} border-gray-200 bg-white text-gray-700`}>Não encontramos vaga nos próximos dias. Fale com {clinicWord} pelo WhatsApp.</p>
                    )}
                  </div>
                ) : strip && strip.selected ? (
                  <>
                    <input type="hidden" name="date" value={strip.selected} />
                    <div class="flex flex-col gap-2.5">
                      <h2 class={PATIENT_STEP}>Escolha o dia</h2>
                      <PatientDayStrip strip={strip} href={dayHref} />
                      <p class="text-[15.5px] font-semibold text-gray-700">{formatDay(strip.selected)}</p>
                    </div>
                    <div class="flex flex-col gap-3.5">
                      <h2 class={PATIENT_STEP}>Escolha o horário</h2>
                      {slotOptions.length ? (
                        <PatientSlots options={slotOptions} />
                      ) : (
                        <p class="text-base text-gray-600">Nenhum horário livre nesse dia. Escolha outra data.</p>
                      )}
                    </div>
                  </>
                ) : (
                  <p class={`${notice} border-gray-200 bg-white text-gray-700`}>
                    Não encontramos horários livres nos próximos dias. Fale com {clinicWord} pelo WhatsApp.
                  </p>
                )
              }
            </div>

            <aside class={`${PATIENT_CARD} sticky top-4 hidden flex-col gap-3 px-5 py-[18px] lg:flex`} aria-label="Seu atendimento">
              <p class="text-[13px] font-bold tracking-[.06em] text-gray-600 uppercase">Seu atendimento</p>
              <p class="flex flex-col">
                <span class={PATIENT_LABEL}>{capitalize(words.patient)}</span>
                <span class="text-[16.5px] text-gray-900">{page.patient.fullName}</span>
                <span class="text-[15px] text-gray-600">nascimento em {formatCalendarDate(page.patient.birthdate, "dd/MM/yyyy")}</span>
              </p>
              {
                showContact && (
                  <p class="flex flex-col">
                    <span class={PATIENT_LABEL}>{capitalize(words.contact)}</span>
                    <span class="text-[16.5px] text-gray-900">{page.contact.fullName}</span>
                    <span class="text-[15px] text-gray-600">{formatPhoneBR(page.contact.phone)}</span>
                  </p>
                )
              }
              <p class="flex flex-col border-t border-gray-100 pt-3">
                <span class={PATIENT_LABEL}>Dia e horário</span>
                <span class="text-[16.5px] font-bold text-gray-900" data-agendar-summary>Escolha um horário</span>
              </p>
              <button type="submit" class={`${PATIENT_BUTTON} w-full`} disabled={!hasChoice} data-agendar-submit data-sending-label="Confirmando…">
                {submitLabel}
              </button>
            </aside>
          </div>

          <div class="sticky bottom-0 -mx-4 flex items-center justify-between gap-3 border-t border-gray-200 bg-white px-4 pt-3 pb-[max(12px,env(safe-area-inset-bottom))] shadow-[0_-2px_8px_rgba(17,24,39,.06)] sm:-mx-6 sm:px-6 lg:hidden">
            <p class="flex min-w-0 flex-col">
              <span class="text-[13.5px] text-gray-600">Escolhido</span>
              <span class="truncate text-[16.5px] font-bold text-gray-900" data-agendar-summary>Escolha um horário</span>
            </p>
            <button type="submit" class={PATIENT_BUTTON} disabled={!hasChoice} data-agendar-submit data-sending-label="Confirmando…">
              {submitLabel}
            </button>
          </div>
        </form>
      </>
    )
  }
</PatientLayout>

<script>
  // O escolhido vai para a barra e o resumo. Um dia ou uma seta da faixa troca
  // os horários sem recarregar: busca a mesma página no dia novo e troca só a
  // parte da escolha (sem JavaScript, o link abre a página nesse dia).
  const area = document.getElementById("agendar-escolha");
  const summaries = () => document.querySelectorAll<HTMLElement>("[data-agendar-summary]");
  const submits = () => document.querySelectorAll<HTMLButtonElement>("[data-agendar-submit]");
  const EMPTY = "Escolha um horário";

  const refresh = () => {
    const chosen = area?.querySelector<HTMLInputElement>('input[name="start"]:checked');
    summaries().forEach((el) => (el.textContent = chosen?.dataset.summary ?? EMPTY));
    const hasOptions = !!area?.querySelector('input[name="start"]');
    submits().forEach((button) => (button.disabled = !hasOptions));
  };

  area?.addEventListener("change", (event) => {
    if (event.target instanceof HTMLInputElement && event.target.name === "start") refresh();
  });

  area?.addEventListener("click", async (event) => {
    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>("a[data-agendar-nav]");
    if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return;
    event.preventDefault();
    area.setAttribute("aria-busy", "true");
    area.classList.add("opacity-60");
    submits().forEach((button) => (button.disabled = true));
    try {
      const response = await fetch(link.href, { headers: { Accept: "text/html" } });
      if (!response.ok) throw new Error(String(response.status));
      const next = new DOMParser().parseFromString(await response.text(), "text/html").getElementById("agendar-escolha");
      if (!next) throw new Error("sem a escolha");
      area.replaceChildren(...Array.from(next.childNodes));
      history.replaceState(null, "", link.href);
      area.querySelector<HTMLElement>('[aria-current="date"]')?.scrollIntoView({ block: "nearest", inline: "nearest" });
    } catch {
      window.location.href = link.href;
      return;
    } finally {
      area.removeAttribute("aria-busy");
      area.classList.remove("opacity-60");
    }
    refresh();
  });

  refresh();
</script>

---
// Conversas (Central de Atendimento, CN3a; plano em docs/planejamento-central-atendimento.md, decisões 3, 4, 6 e 12,
// telas T1, T6 e T7, cliente, 05/nov/2026): a equipe vê as conversas do WhatsApp dentro do RecepClinic, com o
// histórico do assistente. Lista única com Abertas (com a clínica) e Finalizadas (com o bot), busca e "Mostrar"; ao
// lado, a conversa (só leitura nesta etapa: responder, assumir e transferir chegam no CN4) e o painel do paciente (CN3b,
// T1 opção C; abaixo de 1280px, a faixa da próxima consulta com "Ver paciente", T5). No celular, a lista, a conversa e o
// painel em telas separadas, com "Voltar". Administrador, Recepção e Suporte veem
// todas; o Profissional, só as que estão com ele. Notificações num botão no topo (N1). Responder (dentro das 24 h),
// Assumir e Transferir (CN4a; decisão 5 e R2): quem responde assume; com outra dona, a tela confirma antes. Conversas que
// não são atendimento (NA4; telas NA0, cliente, 06/nov/2026): aba "Pessoal e admin." com os números marcados e as
// mensagens novas; o Administrador e a Recepção marcam pelo menu ⋯ da conversa (com confirmação) e desfazem com "Voltar
// para atendimento". Em Abertas, o filtro é Todas ou Minhas.
import AdminLayout from "../../layouts/AdminLayout.astro";
import ConfirmDeleteDialog from "../../components/admin/ConfirmDeleteDialog.astro";
import FinishForm from "../../components/admin/FinishAttendanceForm.astro";
import FlashMessage from "../../components/admin/FlashMessage.astro";
import Icon from "../../components/admin/Icon.astro";
import NotificationsCard from "../../components/admin/NotificationsCard.astro";
import ConversationPanel from "../../components/admin/central/ConversationPanel.astro";
import { CONTROL } from "../../components/admin/ui/styles";
import { attachmentOf, bubbleOf, deliveryLabel } from "../../lib/centralBubbles";
import { formatInstant, localDateOf } from "../../lib/clinicTime";
import { createUserClient } from "../../lib/data/clients";
import {
  CLASSIFICATION_LABELS,
  filterConversations,
  isCentralActive,
  listConversationMedia,
  listConversationMessages,
  listConversations,
  ownerLabel,
  type CentralMessage,
  type ConversationFilter,
  type ConversationSummary,
  type MessageCursor,
} from "../../lib/data/central";
import { loadActorLabels } from "../../lib/data/agenda/trail";
import { describeHandoffEvent, firstNameOf, loadConversationPanel, type ConversationPanel as Panel } from "../../lib/data/centralPanel";
import { searchPatients, type PatientWithContact } from "../../lib/data/patients";
import { DataError } from "../../lib/data/errors";
import { handoffReasonLabel } from "../../lib/data/whatsapp/attention";
import { listMyDevices } from "../../lib/data/whatsapp/attentionPush";
import { CUSTOMER_SERVICE_WINDOW_MS } from "../../lib/data/whatsapp/messages";
import { listCentralTeam, resumeParams, resumeText, type TeamOption } from "../../lib/data/centralSend";
import { getClinicSettings } from "../../lib/data/config/clinic";
import { clinicLabel } from "../../lib/data/whatsapp/templates";
import { getApprovedTemplate, getWhatsappConnection } from "../../lib/data/whatsapp/connection";
import { ROLE_LABELS } from "../../lib/data/config/team";
import { platformEnv } from "../../lib/env";
import { formatPhoneBR, whatsappHref } from "../../lib/phone";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const allowed = clinic.isPlatformStaff || clinic.roles.some((role) => role === "admin" || role === "reception" || role === "professional");
if (!allowed || !clinic.features.includes("central_attendance") || !(await isCentralActive(db, clinic.clinicId))) {
  return Astro.redirect("/admin/dashboard?aviso=acesso_negado");
}

const params = Astro.url.searchParams;
const FILTERS: Record<ConversationFilter, string> = { todas: "Todas", minhas: "Minhas" };
const search = (params.get("busca") ?? "").trim().slice(0, 80);
const filter: ConversationFilter = (params.get("mostrar") as ConversationFilter) in FILTERS ? (params.get("mostrar") as ConversationFilter) : "todas";
const selectedPhone = /^\+\d{10,15}$/.test(params.get("conversa") ?? "") ? params.get("conversa")! : null;
const cursorParam = params.get("antes");
const cursor: MessageCursor | null = (() => {
  const [sortAt, id] = (cursorParam ?? "").split("_");
  return sortAt && id && !Number.isNaN(Date.parse(sortAt)) && /^[0-9a-f-]{36}$/.test(id) ? { sortAt, id } : null;
})();

// Aba "Pessoal e admin." (NA): Administrador, Recepção e Suporte (o Profissional não vê esses números).
const canEdit = clinic.isPlatformStaff || clinic.roles.some((role) => role === "admin" || role === "reception");
// Quem marca e desmarca: só Administrador e Recepção (decisão 3).
const canMark = clinic.roles.some((role) => role === "admin" || role === "reception");
const [openItems, devices, classifiedItems] = await Promise.all([
  listConversations(db, clinic.clinicId, { search }),
  listMyDevices(db, clinic.clinicId, clinic.userId),
  canEdit ? listConversations(db, clinic.clinicId, { classified: true, search: params.get("aba") === "pessoal" ? search : null }) : Promise.resolve([] as ConversationSummary[]),
]);
// Aba: a pedida; vindo de uma notificação ou de um link, a da conversa escolhida.
let personal = canEdit && params.get("aba") === "pessoal";
let finished = !personal && params.get("aba") === "finalizadas";
let finishedItems: ConversationSummary[] = finished ? await listConversations(db, clinic.clinicId, { finished: true, search }) : [];
if (selectedPhone && !personal && !finished && !openItems.some((item) => item.phone === selectedPhone)) {
  if (classifiedItems.some((item) => item.phone === selectedPhone)) personal = true;
  else {
    finishedItems = await listConversations(db, clinic.clinicId, { finished: true });
    if (finishedItems.some((item) => item.phone === selectedPhone)) finished = true;
  }
}
const shown = personal ? classifiedItems : finished ? finishedItems : filterConversations(openItems, filter, clinic.userId);
const selected = selectedPhone ? ([...openItems, ...finishedItems, ...classifiedItems].find((item) => item.phone === selectedPhone) ?? null) : null;
const marked = !!selected && selected.classification !== "patient";
// Mensagens novas nos números marcados (por pessoa), no rótulo da aba.
const classifiedUnread = classifiedItems.reduce((sum, item) => sum + item.unread, 0);

// A conversa: 50 mensagens (as mais novas, ou as anteriores ao cursor), em ordem de hora.
let thread: { messages: CentralMessage[]; next: MessageCursor | null } | null = null;
let threadError: string | null = null;
if (selected) {
  try {
    thread = await listConversationMessages(db, clinic.clinicId, selected.phone, cursor ? { before: cursor } : {});
  } catch (error) {
    if (!(error instanceof DataError)) throw error;
    threadError = error.code === "forbidden" ? "Esta conversa não está com você." : "Não foi possível abrir a conversa. Tente de novo.";
  }
} else if (selectedPhone) {
  threadError = "Esta conversa não está na sua lista.";
}
const chronological = thread ? [...thread.messages].reverse() : [];
// Anexos das mensagens mostradas (CN5) e se o número está também no app (o aviso da 8c leva "Abrir no WhatsApp").
const mediaIds = chronological.map((m) => m.mediaId).filter((id): id is string => !!id);
const [mediaOf, coexistence] =
  selected && mediaIds.length
    ? await Promise.all([
        listConversationMedia(db, clinic.clinicId, selected.phone, mediaIds),
        getWhatsappConnection(db, clinic.clinicId).then((c) => c?.coexistence ?? false).catch(() => false),
      ])
    : [new Map(), false];
const names = new Map(
  [...(await loadActorLabels(db, clinic.clinicId, chronological.map((m) => m.sentBy))).entries()].map(([id, label]) => [id, label.isSupport ? "Suporte" : firstNameOf(label.name)]),
);

// Painel do paciente (CN3b) e os eventos do atendimento na conversa.
const panel: Panel | null =
  selected && thread ? await loadConversationPanel(db, clinic.clinicId, { contactId: selected.contactId, phone: selected.phone }, { insurance: clinic.features.includes("insurance"), now: new Date() }) : null;
const showPanel = params.get("painel") === "1";
const linking = !!selected && !panel?.contact && canEdit && params.get("ligar") === "1";
// Responder, assumir e transferir (CN4a). O Profissional responde só na que está com ele; a janela de 24 h conta da
// última mensagem do paciente (fora dela, só o modelo "Retomar conversa", CN4b).
const isMine = !!selected?.assignedTo && selected.assignedTo === clinic.userId;
const otherOwner = !!selected?.assignedTo && !isMine;
const ownerFirst = selected?.assignedName ? firstNameOf(selected.assignedName) : "outra pessoa";
const canReply = !!selected && !!thread && (canEdit || (selected.open && isMine));
const windowOpen = !!selected?.lastPatientAt && Date.now() - selected.lastPatientAt.getTime() < CUSTOMER_SERVICE_WINDOW_MS;
const team: TeamOption[] = selected?.open && canEdit && thread ? (await listCentralTeam(db, clinic.clinicId)).filter((m) => m.userId !== selected.assignedTo && m.userId !== clinic.userId) : [];
const clientKey = crypto.randomUUID();
const rolesOf = (member: TeamOption) => member.roles.map((role) => ROLE_LABELS[role]).join(", ");
// Fora das 24 h (CN4b; decisão 7): o "Retomar conversa", com o texto que o paciente vai receber na confirmação. Já
// enviado depois da última mensagem do paciente (e não falhou): aguarda a resposta, sem outro envio.
const resume =
  canReply && !windowOpen && selected
    ? await (async () => {
        const [template, settings] = await Promise.all([getApprovedTemplate(db, clinic.clinicId, "conversation_resume"), getClinicSettings(db, clinic.clinicId)]);
        const sentAfter = chronological.findLast(
          (m) => m.messageType === "conversation_resume" && m.status !== "failed" && (!selected.lastPatientAt || m.sortAt > selected.lastPatientAt),
        );
        const params = resumeParams(
          { clinicLabel: clinicLabel(settings.name, settings.messageArticle) },
          { lastPatientAt: selected.lastPatientAt ?? selected.lastMessageAt, timeZone: clinic.timezone },
        );
        return { approved: !!template, text: resumeText(template, params), sentAt: sentAfter?.sortAt ?? null };
      })()
    : null;
const linkQuery = (params.get("paciente") ?? "").trim().slice(0, 80);
const linkResults: PatientWithContact[] = linking && linkQuery.length >= 2 ? await searchPatients(db, clinic.clinicId, linkQuery) : [];
const nextOfPanel = panel?.patients
  .map((p) => p.next)
  .filter((a): a is NonNullable<typeof a> => !!a)
  .sort((a, b) => a.scheduledAt.getTime() - b.scheduledAt.getTime())[0];
// Eventos (encaminhada, assumiu, transferida, finalizada) entre as mensagens mostradas.
const firstShown = chronological[0]?.sortAt ?? null;
const lastShown = cursor ? (chronological.at(-1)?.sortAt ?? null) : null;
type Line = { kind: "message"; message: CentralMessage } | { kind: "event"; at: Date; text: string };
const lines: Line[] = [
  ...chronological.map((message) => ({ kind: "message" as const, message })),
  ...(panel?.events ?? [])
    .filter((event) => (!firstShown || event.at >= firstShown || !thread?.next) && (!lastShown || event.at <= lastShown))
    .map((event) => {
      const text = describeHandoffEvent(event, panel!.names);
      const subject = event.kind === "status" && event.handoffId && event.handoffId === selected?.handoffId && selected?.subject ? ` · Assunto: ${selected.subject}` : "";
      return text ? { kind: "event" as const, at: event.at, text: `${text} · ${formatInstant(event.at, clinic.timezone, "HH:mm")}${subject}` } : null;
    })
    .filter((line): line is NonNullable<typeof line> => !!line),
].sort(
  // Na mesma hora, o evento antes da mensagem ("Ana assumiu" e a resposta dela).
  (a, b) => (a.kind === "message" ? a.message.sortAt : a.at).getTime() - (b.kind === "message" ? b.message.sortAt : b.at).getTime() || (a.kind === "event" ? -1 : 0) + (b.kind === "event" ? 1 : 0),
);
const lineAt = (line: Line) => (line.kind === "message" ? line.message.sortAt : line.at);

// Links: a tela guarda a aba, o "Mostrar" e a busca.
const hrefWith = (change: Record<string, string | null>) => {
  const next = new URLSearchParams();
  const base: Record<string, string | null> = { aba: personal ? "pessoal" : finished ? "finalizadas" : null, mostrar: filter === "todas" || finished || personal ? null : filter, busca: search || null, conversa: null, antes: null, painel: null, ligar: null, ...change };
  for (const [key, value] of Object.entries(base)) if (value) next.set(key, value);
  const query = next.toString();
  return `/admin/conversas${query ? `?${query}` : ""}`;
};
const conversationHref = (phone: string) => hrefWith({ conversa: phone });
// Depois de marcar: a conversa na aba "Pessoal e admin."; depois de voltar para atendimento, nas Finalizadas (com o bot).
const markedHref = (phone: string) => `/admin/conversas?aba=pessoal&conversa=${encodeURIComponent(phone)}`;
const unmarkedHref = (phone: string) => `/admin/conversas?aba=finalizadas&conversa=${encodeURIComponent(phone)}`;
const backHref = hrefWith({});
const threadHref = selected ? hrefWith({ conversa: selected.phone }) : backHref;
const linkParams: Record<string, string> = Object.fromEntries(new URL(hrefWith({ conversa: selected?.phone ?? null, ligar: "1", painel: showPanel ? "1" : null }), "http://x").searchParams);

const now = new Date();
const today = localDateOf(now, clinic.timezone);
const yesterday = localDateOf(new Date(now.getTime() - 24 * 60 * 60_000), clinic.timezone);
const ago = (instant: Date | null) => {
  if (!instant) return "";
  const minutes = Math.max(0, Math.floor((now.getTime() - instant.getTime()) / 60_000));
  if (minutes < 1) return "agora";
  if (minutes < 60) return `há ${minutes} min`;
  if (minutes < 24 * 60) return `há ${Math.floor(minutes / 60)} h`;
  return formatInstant(instant, clinic.timezone, localDateOf(instant, clinic.timezone).slice(0, 4) === today.slice(0, 4) ? "dd/MM" : "dd/MM/yy");
};
const dayLabel = (instant: Date) => {
  const day = localDateOf(instant, clinic.timezone);
  if (day === today) return "Hoje";
  if (day === yesterday) return "Ontem";
  return formatInstant(instant, clinic.timezone, "EEE, dd/MM/yyyy");
};
const displayName = (item: ConversationSummary) => item.name ?? formatPhoneBR(item.phone);
const previewOf = (item: ConversationSummary) => {
  const prefix = item.lastMessageAuthor === "agent_panel" ? "Equipe: " : item.lastMessageAuthor === "agent_app" ? "Pelo app: " : item.lastMessageAuthor === "bot" ? "Assistente: " : "";
  return item.preview ? `${prefix}${item.preview}` : item.lastMessageAt ? "Mensagem sem texto" : "Sem mensagens";
};
const STATUS = {
  waiting_clinic: { label: "Aguardando a clínica", tone: "bg-pend-100 text-pend-800" },
  in_progress: { label: "Em atendimento", tone: "bg-brand-soft text-brand-ink" },
} as const;
const statusOf = (item: ConversationSummary) => (item.status ? STATUS[item.status] : null);
const CLASSIFICATION_TONE = { personal: "bg-[#ece6f6] text-[#4b3680]", administrative: "bg-[#e3ecf7] text-[#1f4e86]" } as const;
const markOf = (item: ConversationSummary) =>
  item.classification === "patient" ? null : { label: CLASSIFICATION_LABELS[item.classification], tone: CLASSIFICATION_TONE[item.classification] };
const markedBy = (item: ConversationSummary) =>
  item.classifiedAt ? `Marcada${item.classifiedByName ? ` por ${firstNameOf(item.classifiedByName)}` : ""} · ${formatInstant(item.classifiedAt, clinic.timezone, "dd/MM 'às' HH:mm")}` : null;
const waitingFor = (item: ConversationSummary) => (item.status === "waiting_clinic" && item.statusAt ? `aguarda ${ago(item.statusAt)}` : null);

const BUBBLE_TONE = {
  patient: "self-start rounded-[12px_12px_12px_4px] border border-line bg-white",
  bot: "self-end rounded-[12px_12px_4px_12px] bg-canvas-deep",
  system: "self-end rounded-[12px_12px_4px_12px] border border-pend-200 bg-pend-50",
  app: "self-end rounded-[12px_12px_4px_12px] border border-dashed border-line-strong bg-white",
  panel: "self-end rounded-[12px_12px_4px_12px] bg-brand-soft",
} as const;
const ACTION =
  "inline-flex min-h-11 items-center justify-center rounded-lg border border-line-strong bg-white px-2.5 text-sm font-semibold whitespace-nowrap text-ink no-underline hover:bg-canvas sm:min-h-10";
const tabClass = (active: boolean) =>
  `flex min-h-12 flex-1 items-center justify-center border-b-[3px] text-[15px] no-underline ${active ? "border-brand font-semibold text-brand-ink" : "border-transparent text-ink-soft hover:text-ink"}`;
---

<AdminLayout title="Conversas" autoRefresh wide fill>
  <div class:list={["flex flex-wrap items-center justify-between gap-3", selected && "max-lg:hidden"]}>
    <h1 class="font-display text-[28px] leading-[1.1] font-bold text-ink sm:text-[30px]">Conversas</h1>
    <button
      type="button"
      class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-line-strong bg-white px-3 text-[15px] font-semibold text-ink hover:bg-canvas sm:min-h-10"
      data-notifications-open
    >
      <Icon name="bell" class="h-5 w-5" /> Notificações
    </button>
  </div>
  <FlashMessage />

  <div class:list={["mt-4 grid gap-4 lg:min-h-[480px] lg:flex-1 lg:grid-cols-[300px_minmax(0,1fr)]", panel && "xl:grid-cols-[280px_minmax(0,1fr)_280px]", panel && showPanel && "lg:max-xl:grid-cols-1"]}>
    <!-- Lista -->
    <section aria-label="Lista de conversas" class:list={["flex min-h-0 flex-col overflow-hidden rounded-xl border border-line bg-white", selected && "max-lg:hidden", selected && showPanel && "max-xl:hidden"]}>
      <nav class="flex border-b border-line" aria-label="Abertas ou finalizadas" data-live="tabs">
        <a href={hrefWith({ aba: null })} class={tabClass(!finished && !personal)} aria-current={!finished && !personal ? "page" : undefined}>Abertas ({openItems.length})</a>
        <a href={hrefWith({ aba: "finalizadas", mostrar: null })} class={tabClass(finished)} aria-current={finished ? "page" : undefined}>Finalizadas</a>
        {canEdit && (
          <a href={hrefWith({ aba: "pessoal", mostrar: null })} class={`${tabClass(personal)} gap-1.5 px-1 text-center leading-tight`} aria-current={personal ? "page" : undefined}>
            Pessoal e admin.
            {classifiedUnread > 0 && (
              <span class="inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-brand px-1.5 text-xs font-bold text-white" aria-label={`${classifiedUnread} mensagens novas`}>
                {classifiedUnread}
              </span>
            )}
          </a>
        )}
      </nav>
      <form method="get" action="/admin/conversas" class="flex flex-wrap items-end gap-2 border-b border-line p-3" data-conversations-filter>
        {finished && <input type="hidden" name="aba" value="finalizadas" />}
        {personal && <input type="hidden" name="aba" value="pessoal" />}
        {!finished && !personal && filter !== "todas" && <input type="hidden" name="mostrar" value={filter} />}
        <div class="flex min-w-0 flex-[3_1_160px] flex-col gap-1">
          <label for="conversas_busca" class="text-[13px] font-semibold text-ink-mid">Buscar</label>
          <input id="conversas_busca" name="busca" type="search" value={search} placeholder="Nome ou telefone" class={`${CONTROL} w-full`} />
        </div>
        <button type="submit" class="sr-only focus:not-sr-only">Buscar</button>
      </form>
      {
        !finished && !personal && (
          <nav class="flex gap-1.5 border-b border-line px-3 py-2.5" aria-label="Filtrar as abertas">
            {(Object.entries(FILTERS) as [ConversationFilter, string][]).map(([value, label]) => (
              <a
                href={hrefWith({ mostrar: value === "todas" ? null : value })}
                aria-current={value === filter ? "true" : undefined}
                class:list={[
                  "inline-flex min-h-9 items-center rounded-full border px-3.5 text-sm no-underline",
                  value === filter ? "border-ink bg-ink font-semibold text-white" : "border-line-strong bg-white text-ink hover:bg-canvas",
                ]}
              >
                {label}
              </a>
            ))}
          </nav>
        )
      }
      <ul class="min-h-0 flex-1 overflow-y-auto" data-live="list">
        {
          shown.length === 0 && (
            <li class="px-4 py-6 text-[15px] text-ink-soft">
              {search
                ? "Nenhuma conversa com esse nome ou telefone."
                : personal
                  ? "Nenhum número marcado. Conversa pessoal ou com fornecedor: abra a conversa e use o menu ⋯ para marcar."
                  : finished
                  ? "Nenhuma conversa finalizada ainda."
                  : filter === "todas"
                    ? "Nenhuma conversa aberta. Quando o paciente pedir para falar com a clínica, a conversa aparece aqui."
                    : "Nenhuma conversa neste filtro."}
            </li>
          )
        }
        {
          shown.map((item) => {
            const status = statusOf(item);
            const active = item.phone === selected?.phone;
            return (
              <li>
                <a
                  href={conversationHref(item.phone)}
                  aria-current={active ? "true" : undefined}
                  class:list={[
                    "flex flex-col gap-1 border-b border-canvas-deep px-3.5 py-3 text-ink no-underline hover:bg-canvas",
                    active && "bg-brand-soft hover:bg-brand-soft",
                  ]}
                >
                  <span class="flex items-baseline justify-between gap-2">
                    <strong class="min-w-0 truncate text-[15px]">{displayName(item)}</strong>
                    <span class="flex-none text-xs text-ink-soft">{ago(item.lastMessageAt)}</span>
                  </span>
                  <span class="truncate text-sm text-ink-mid">{previewOf(item)}</span>
                  <span class="flex flex-wrap items-center gap-2 text-xs">
                    {status && <span class={`rounded-full px-2 py-0.5 font-semibold ${status.tone}`}>{status.label}</span>}
                    {markOf(item) && <span class={`rounded-md px-2 py-0.5 font-semibold ${markOf(item)!.tone}`}>{markOf(item)!.label}</span>}
                    {!markOf(item) && <span class="text-ink-soft">{ownerLabel(item, clinic.userId)}</span>}
                    {item.unread > 0 && (
                      <span class="ml-auto inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-brand px-1.5 font-bold text-white" aria-label={`${item.unread} não lidas`}>
                        {item.unread}
                      </span>
                    )}
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
      {personal && <p class="flex-none border-t border-line px-3.5 py-2.5 text-xs text-ink-soft">Estes números não passam pelo bot e não contam nas métricas nem nos pendentes.</p>}
    </section>

    <!-- Conversa -->
    {/* No celular, a conversa aberta ocupa a tela toda, como no app do WhatsApp (cliente, 06/nov/2026): o cabeçalho no
        topo, as mensagens rolando no meio e a caixa de resposta fixa embaixo. A altura acompanha o teclado (script). */}
    <section
      aria-label="Conversa"
      class:list={[
        "flex min-h-0 flex-col overflow-hidden rounded-xl border border-line bg-white",
        !selected && !threadError && "max-lg:hidden",
        selected && "max-lg:fixed max-lg:inset-x-0 max-lg:top-[var(--app-top,0px)] max-lg:z-30 max-lg:h-[var(--app-height,100dvh)] max-lg:rounded-none max-lg:border-0",
        panel && showPanel && "max-xl:hidden",
      ]}
      data-conversation={selected ? "" : undefined}
    >
      {
        !selected ? (
          <div class="flex flex-1 flex-col items-center justify-center gap-2 p-8 text-center">
            <Icon name="chat-bubble" class="h-8 w-8 text-ink-soft" />
            <p class="text-[15px] text-ink-soft">{threadError ?? "Escolha uma conversa na lista."}</p>
            {threadError && (
              <a href={backHref} class="text-[15px] font-semibold text-brand-ink">
                Voltar para a lista
              </a>
            )}
          </div>
        ) : (
          <>
            <div class="flex-none bg-white pt-[env(safe-area-inset-top)] lg:pt-0">
            <header class="flex flex-wrap items-center justify-between gap-3 border-b border-line px-3 py-2.5 sm:px-4">
              <div class="flex min-w-0 items-center gap-1.5">
                <a href={backHref} aria-label="Voltar para a lista" class="inline-flex h-11 w-11 flex-none items-center justify-center rounded-lg text-ink hover:bg-canvas lg:hidden">
                  <Icon name="chevron-left" class="h-6 w-6" />
                </a>
                <div class="flex min-w-0 flex-col gap-1">
                  <span class="flex flex-wrap items-baseline gap-x-2.5">
                    <strong class="truncate text-[17px] text-ink">{displayName(selected)}</strong>
                    {selected.name && <span class="text-sm text-ink-soft tabular-nums">{formatPhoneBR(selected.phone)}</span>}
                  </span>
                  <span class="flex flex-wrap items-center gap-2 text-[13px]" data-live="status">
                    {statusOf(selected) && <span class={`rounded-full px-2 py-0.5 font-semibold ${statusOf(selected)!.tone}`}>{statusOf(selected)!.label}</span>}
                    {markOf(selected) ? (
                      <>
                        <span class={`rounded-md px-2 py-0.5 font-semibold ${markOf(selected)!.tone}`}>{markOf(selected)!.label}</span>
                        {markedBy(selected) && <span class="text-ink-soft">{markedBy(selected)}</span>}
                      </>
                    ) : (
                      <span class="text-ink-soft">
                        {ownerLabel(selected, clinic.userId)}
                        {waitingFor(selected) && ` · ${waitingFor(selected)}`}
                      </span>
                    )}
                  </span>
                </div>
              </div>
              {marked && canMark && (
                <form method="POST" action="/api/admin/classificar-conversa" class="flex max-sm:w-full">
                  <input type="hidden" name="telefone" value={selected.phone} />
                  <input type="hidden" name="classificacao" value="patient" />
                  <input type="hidden" name="return_to" value={threadHref} />
                  <input type="hidden" name="depois" value={unmarkedHref(selected.phone)} />
                  <button
                    type="submit"
                    class={`${ACTION} js-confirm-delete w-full`}
                    data-confirm-title="Voltar para atendimento?"
                    data-confirm-message={`O bot volta a responder ${formatPhoneBR(selected.phone)} na próxima mensagem, e a conversa volta a contar nas métricas. Nada é enviado agora.`}
                    data-confirm-label="Voltar para atendimento"
                  >
                    Voltar para atendimento
                  </button>
                </form>
              )}
              {!marked && (selected.open || canMark) && (
                <div class:list={["flex flex-wrap items-center gap-1.5", selected.open && "max-sm:w-full max-sm:[&>*]:flex-1"]}>
                  {selected.open && canEdit && !isMine && thread && (
                    <form method="POST" action="/api/admin/conversas/responsavel" class="flex">
                      <input type="hidden" name="acao" value="assumir" />
                      <input type="hidden" name="telefone" value={selected.phone} />
                      <input type="hidden" name="responsavel_visto" value={selected.assignedTo ?? ""} />
                      <input type="hidden" name="return_to" value={threadHref} />
                      <button
                        type="submit"
                        class:list={[ACTION, "w-full", otherOwner && "js-confirm-delete"]}
                        data-confirm-title={otherOwner ? `Está com ${ownerFirst}. Assumir a conversa?` : undefined}
                        data-confirm-message={otherOwner ? `Você passa a ser responsável pela conversa. ${ownerFirst} deixa de ser.` : undefined}
                        data-confirm-label={otherOwner ? "Assumir" : undefined}
                      >
                        Assumir
                      </button>
                    </form>
                  )}
                  {team.length > 0 && (
                    <button type="button" class={ACTION} data-transfer-open>
                      Transferir
                    </button>
                  )}
                  {selected.open && selected.statusAt && (
                    <FinishForm item={{ phone: selected.phone, name: displayName(selected), statusAt: selected.statusAt }} primary={false} returnTo={backHref} compact />
                  )}
                  {canMark && (
                    <button type="button" aria-label="Mais ações" title="Mais ações" aria-haspopup="dialog" class={`${ACTION} px-3.5 max-sm:flex-none!`} data-more-open>
                      ⋯
                    </button>
                  )}
                </div>
              )}
            </header>

            {panel && (
              <div class="flex items-center gap-2.5 border-b border-pend-200 bg-pend-50 px-3.5 py-2.5 xl:hidden">
                <span class="min-w-0 flex-1 text-sm text-ink">
                  {nextOfPanel ? (
                    <>
                      <strong>Próxima:</strong> {formatInstant(nextOfPanel.scheduledAt, clinic.timezone, "EEE, dd/MM, HH:mm")} · {nextOfPanel.agendaName}
                    </>
                  ) : panel.contact ? (
                    "Sem consulta marcada."
                  ) : (
                    "Número sem cadastro."
                  )}
                </span>
                <a href={hrefWith({ conversa: selected.phone, painel: "1" })} class="flex-none text-sm font-semibold whitespace-nowrap text-brand-ink">
                  Ver paciente
                </a>
              </div>
            )}
            </div>
            <div class="flex min-h-0 flex-1 flex-col gap-2.5 overflow-y-auto bg-canvas px-3 py-4 sm:px-4" data-thread data-live="thread">
              {thread?.next && (
                <a href={hrefWith({ conversa: selected.phone, antes: `${thread.next.sortAt}_${thread.next.id}` })} class="self-center text-sm font-semibold text-brand-ink">
                  Ver mensagens anteriores
                </a>
              )}
              {cursor && (
                <a href={hrefWith({ conversa: selected.phone })} class="self-center text-sm font-semibold text-brand-ink">
                  Ir para as mais recentes
                </a>
              )}
              {threadError && <p class="self-center text-[15px] text-danger">{threadError}</p>}
              {thread && chronological.length === 0 && <p class="self-center text-[15px] text-ink-soft">Nenhuma mensagem nesta conversa.</p>}
              {lines.map((line, index) => {
                const day = dayLabel(lineAt(line));
                const newDay = index === 0 || dayLabel(lineAt(lines[index - 1])) !== day;
                if (line.kind === "event") {
                  return (
                    <>
                      {newDay && <span class="self-center rounded-full bg-canvas-deep px-2.5 py-0.5 text-xs text-ink-soft">{day}</span>}
                      <span class="self-center rounded-lg border border-pend-200 bg-pend-50 px-3 py-1 text-center text-[13px] text-ink-mid">{line.text}</span>
                    </>
                  );
                }
                const message = line.message;
                const bubble = bubbleOf(message, names);
                const attachment = message.mediaId ? attachmentOf(message.messageType, mediaOf.get(message.mediaId), coexistence) : null;
                const delivery = message.direction === "outbound" ? deliveryLabel(message.status) : null;
                return (
                  <>
                    {newDay && <span class="self-center rounded-full bg-canvas-deep px-2.5 py-0.5 text-xs text-ink-soft">{day}</span>}
                    <div class={`flex max-w-[85%] flex-col gap-0.5 px-3 py-2 sm:max-w-[75%] ${BUBBLE_TONE[bubble.tone]}`}>
                      {bubble.label && <span class="text-xs font-bold text-ink-mid">{bubble.label}</span>}
                      {attachment?.kind === "image" && (
                        <a href={attachment.href} target="_blank" rel="noopener" class="block">
                          <img src={attachment.href} alt={bubble.side === "left" ? "Foto enviada pelo paciente" : "Foto enviada ao paciente"} class="max-h-72 max-w-full rounded-lg object-contain" />
                        </a>
                      )}
                      {attachment?.kind === "audio" && <audio controls preload="none" src={attachment.href} class="max-w-full" aria-label="Áudio enviado pelo paciente" />}
                      {attachment?.kind === "document" && (
                        <a href={attachment.href} download={attachment.name} class="flex items-center gap-2 rounded-lg border border-line bg-canvas px-3 py-2 text-ink no-underline hover:bg-canvas-deep">
                          <Icon name="arrow-down-tray" class="h-5 w-5 flex-none text-ink-mid" />
                          <span class="flex min-w-0 flex-col">
                            <strong class="truncate text-[15px]">{attachment.name}</strong>
                            <span class="text-[13px] text-ink-soft">{[attachment.size, "Baixar"].filter(Boolean).join(" · ")}</span>
                          </span>
                        </a>
                      )}
                      {(attachment?.kind === "notice" || attachment?.kind === "pending") && (
                        <span class:list={["text-[15px]", attachment.kind === "pending" ? "text-ink-soft italic" : "text-ink-mid"]}>{attachment.text}</span>
                      )}
                      {attachment?.kind === "notice" && attachment.openInApp && (
                        <a href={whatsappHref(selected.phone)} target="_blank" rel="noopener" class="self-start text-sm font-semibold text-brand-ink">
                          Abrir no WhatsApp
                        </a>
                      )}
                      {bubble.text ? (
                        <span class="text-[15px] whitespace-pre-wrap break-words text-ink">{bubble.text}</span>
                      ) : (
                        !attachment && <span class="text-[15px] text-ink-soft italic">{bubble.placeholder}</span>
                      )}
                      <span class="self-end text-[11px] text-ink-soft">
                        {formatInstant(message.sortAt, clinic.timezone, "HH:mm")}
                        {bubble.edited && " · editada"}
                        {delivery && !(bubble.failed && message.author === "agent_panel") && ` · ${delivery}`}
                      </span>
                      {bubble.failed && message.author === "agent_panel" && (
                        <span class="flex flex-wrap items-center justify-end gap-x-2 text-[13px] font-semibold text-danger">
                          Não enviada
                          {canReply && (windowOpen || message.messageType === "conversation_resume") && (
                            <form method="POST" action="/api/admin/conversas/enviar?tentar=1" class="inline">
                              <input type="hidden" name="acao" value="tentar" />
                              <input type="hidden" name="mensagem" value={message.id} />
                              <input type="hidden" name="return_to" value={threadHref} />
                              <button type="submit" class="min-h-9 font-semibold text-brand-ink underline">
                                Tentar de novo
                              </button>
                            </form>
                          )}
                        </span>
                      )}
                    </div>
                  </>
                );
              })}
            </div>

            {selected.open && (
              <p class="flex-none border-t border-line px-4 pt-2.5 text-[13px] text-ink-soft" data-live="reason">
                {handoffReasonLabel(selected.reason)}
                {selected.subject && ` · Assunto: ${selected.subject}`}
              </p>
            )}
            {canReply &&
              (windowOpen ? (
                <form method="POST" action="/api/admin/conversas/enviar" class:list={["flex flex-none items-end gap-2 px-3 pt-2.5 pb-[calc(0.625rem+env(safe-area-inset-bottom))] sm:px-4 lg:pb-2.5", !selected.open && "border-t border-line"]}
                  data-composer
                >
                  <input type="hidden" name="acao" value="enviar" />
                  <input type="hidden" name="telefone" value={selected.phone} />
                  <input type="hidden" name="chave" value={clientKey} />
                  <input type="hidden" name="responsavel_visto" value={selected.assignedTo ?? ""} />
                  <input type="hidden" name="return_to" value={threadHref} />
                  <button
                    type="button"
                    aria-label="Anexar foto ou PDF"
                    title="Anexar foto ou PDF"
                    class="inline-flex h-11 w-11 flex-none items-center justify-center rounded-lg border border-line-strong bg-white text-ink-mid hover:bg-canvas"
                    data-attach-open
                  >
                    <Icon name="paper-clip" class="h-5 w-5" />
                  </button>
                  <label for="resposta" class="sr-only">
                    Mensagem para o paciente
                  </label>
                  <textarea
                    id="resposta"
                    name="texto"
                    rows="1"
                    maxlength="4096"
                    required
                    placeholder={selected.open ? "Escreva a resposta" : marked ? "Escreva uma mensagem" : "Escreva para reabrir o atendimento"}
                    class="max-h-40 min-h-11 flex-1 resize-none rounded-lg border border-line-strong bg-white px-3 py-2.5 text-[15px] leading-snug text-ink"
                    data-composer-text></textarea>
                  <button
                    type="submit"
                    class:list={[
                      "inline-flex min-h-11 flex-none items-center justify-center rounded-lg bg-brand px-4 text-[15px] font-semibold text-white hover:bg-brand-ink",
                      otherOwner && "js-confirm-delete",
                    ]}
                    data-confirm-title={otherOwner ? `Está com ${ownerFirst}. Responder e assumir?` : undefined}
                    data-confirm-message={otherOwner ? `A mensagem sai e você passa a ser responsável pela conversa. ${ownerFirst} deixa de ser.` : undefined}
                    data-confirm-label={otherOwner ? "Responder e assumir" : undefined}
                  >
                    Enviar
                  </button>
                </form>
              ) : (
                <div class:list={["flex flex-none flex-col gap-2 px-4 pt-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] text-sm text-ink-mid lg:pb-3", !selected.open && "border-t border-line"]}>
                  {resume?.sentAt ? (
                    <p>
                      <strong class="text-ink">"Retomar conversa" enviado {dayLabel(resume.sentAt).toLowerCase()}, às {formatInstant(resume.sentAt, clinic.timezone, "HH:mm")}.</strong>{" "}
                      Quando o paciente responder, a caixa de mensagem volta.
                    </p>
                  ) : (
                    <p>
                      <strong class="text-ink">Sem mensagem do paciente nas últimas 24 horas.</strong> Pelo WhatsApp, a clínica só manda texto livre até 24
                      horas depois da última mensagem do paciente. Para voltar a falar, envie o "Retomar conversa": quando ele responder, a conversa reabre.
                    </p>
                  )}
                  {resume && !resume.sentAt && resume.approved && (
                    <form method="POST" action="/api/admin/conversas/enviar?retomar=1" class="flex">
                      <input type="hidden" name="acao" value="retomar" />
                      <input type="hidden" name="telefone" value={selected.phone} />
                      <input type="hidden" name="chave" value={clientKey} />
                      <input type="hidden" name="responsavel_visto" value={selected.assignedTo ?? ""} />
                      <input type="hidden" name="return_to" value={threadHref} />
                      <button
                        type="submit"
                        class="js-confirm-delete inline-flex min-h-11 items-center justify-center rounded-lg bg-brand px-4 text-[15px] font-semibold text-white hover:bg-brand-ink max-sm:w-full"
                        data-confirm-title={otherOwner ? `Está com ${ownerFirst}. Retomar e assumir?` : "Enviar o \"Retomar conversa\"?"}
                        data-confirm-message={`O paciente recebe:\n\n${resume.text}\n\nA Meta cobra este envio na conta da clínica.${otherOwner ? ` Você passa a ser responsável pela conversa.` : ""}`}
                        data-confirm-label="Enviar"
                      >
                        Retomar conversa
                      </button>
                    </form>
                  )}
                  {resume && !resume.sentAt && !resume.approved && (
                    <p class="rounded-lg bg-pend-50 px-3 py-2 text-ink">
                      O modelo "Retomar conversa" ainda não foi aprovado pela Meta para esta clínica. Peça ao suporte do RecepClinic para criar o modelo.
                    </p>
                  )}
                </div>
              ))}
          </>
        )
      }
    </section>

    <!-- Painel do paciente -->
    {
      panel && selected && (
        <aside aria-label="Paciente" class:list={["min-h-0 overflow-y-auto rounded-xl border border-line bg-white p-4", !showPanel && "max-xl:hidden"]}>
          <a href={threadHref} class="mb-3 inline-flex min-h-11 items-center gap-1 text-[15px] font-semibold text-brand-ink no-underline xl:hidden">
            <Icon name="chevron-left" class="h-5 w-5" /> Voltar para a conversa
          </a>
          {markOf(selected) && (
            <section aria-label="Classificação" class="mb-4 flex flex-col gap-1.5 border-b border-line pb-4">
              <span class="text-xs font-bold tracking-[.06em] text-ink-soft">CLASSIFICAÇÃO</span>
              <span class="text-sm text-ink">
                {selected.classification === "personal" ? "Pessoal" : "Administrativo/outros"}
                {selected.classifiedAt && `, desde ${formatInstant(selected.classifiedAt, clinic.timezone, "dd/MM 'às' HH:mm")}`}
                {selected.classifiedByName && `, por ${firstNameOf(selected.classifiedByName)}`}.
              </span>
              <span class="text-[13px] text-ink-soft">Sem bot, fora das métricas e dos pendentes. Os botões dos lembretes de consulta continuam valendo.</span>
            </section>
          )}
          <ConversationPanel
            panel={panel}
            phone={selected.phone}
            profileName={selected.profileName}
            timeZone={clinic.timezone}
            here={hrefWith({ conversa: selected.phone, painel: showPanel ? "1" : null })}
            canEdit={canEdit}
            link={{
              openHref: hrefWith({ conversa: selected.phone, ligar: "1", painel: showPanel ? "1" : null }),
              closeHref: hrefWith({ conversa: selected.phone, painel: showPanel ? "1" : null }),
              params: linkParams,
              open: linking ? { query: linkQuery, results: linkResults } : null,
            }}
          />
        </aside>
      )
    }
  </div>

  <dialog
    id="notifications_dialog"
    aria-label="Notificações"
    class="m-auto w-[calc(100%-2rem)] max-w-[480px] rounded-[14px] border border-line bg-white p-0 text-ink shadow-[0_20px_50px_rgba(18,48,42,.22)] backdrop:bg-ink/40"
  >
    <div class="flex items-center justify-between gap-2 px-4 pt-3">
      <strong class="font-display text-lg text-ink">Notificações</strong>
      <button type="button" aria-label="Fechar" class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-ink hover:bg-canvas" data-notifications-close>
        <Icon name="x-mark" class="h-5 w-5" />
      </button>
    </div>
    <div class="px-3 pb-3 [&>section]:mt-1 [&>section]:border-0">
      <NotificationsCard publicKey={platformEnv().webPush?.publicKey ?? null} devices={devices} timeZone={clinic.timezone} />
    </div>
  </dialog>

  {
    team.length > 0 && selected && (
      <dialog
        id="transfer_dialog"
        aria-labelledby="transfer_title"
        class="m-auto w-[calc(100%-2rem)] max-w-[440px] rounded-[14px] border border-line bg-white p-0 text-ink shadow-[0_20px_50px_rgba(18,48,42,.22)] backdrop:bg-ink/40"
      >
        <form method="POST" action="/api/admin/conversas/responsavel" class="flex flex-col gap-3 p-4">
          <strong id="transfer_title" class="font-display text-lg text-ink">
            Transferir conversa
          </strong>
          <p class="text-sm text-ink-mid">
            A conversa com {displayName(selected)} passa para a pessoa escolhida. Hoje: {ownerLabel(selected, clinic.userId).toLowerCase()}. Um Profissional vê só as
            conversas que estão com ele.
          </p>
          <input type="hidden" name="acao" value="transferir" />
          <input type="hidden" name="telefone" value={selected.phone} />
          <input type="hidden" name="responsavel_visto" value={selected.assignedTo ?? ""} />
          <input type="hidden" name="return_to" value={threadHref} />
          <label for="transfer_para" class="text-sm font-semibold text-ink">
            Para quem
          </label>
          <select id="transfer_para" name="para" required class={`${CONTROL} w-full`}>
            <option value="">Escolha</option>
            {team.map((member) => (
              <option value={member.userId}>
                {member.name} · {rolesOf(member)}
              </option>
            ))}
          </select>
          <div class="mt-1 flex justify-end gap-2">
            <button type="button" class={ACTION} data-transfer-close>
              Cancelar
            </button>
            <button type="submit" class="inline-flex min-h-11 items-center justify-center rounded-lg bg-brand px-4 text-sm font-semibold text-white hover:bg-brand-ink sm:min-h-10">
              Transferir
            </button>
          </div>
        </form>
      </dialog>
    )
  }

  {
    canReply && windowOpen && selected && (
      <dialog
        id="attach_dialog"
        aria-labelledby="attach_title"
        class="m-auto w-[calc(100%-2rem)] max-w-[440px] rounded-[14px] border border-line bg-white p-0 text-ink shadow-[0_20px_50px_rgba(18,48,42,.22)] backdrop:bg-ink/40"
      >
        <form class="flex flex-col gap-3 p-4" data-attach-form data-api="/api/admin/conversas/anexo">
          <strong id="attach_title" class="font-display text-lg text-ink">
            Enviar foto ou PDF
          </strong>
          <p class="text-sm text-ink-mid">
            Para {displayName(selected)}. Foto em JPG ou PNG até 5 MB; PDF até 10 MB.
            {otherOwner && ` A conversa está com ${ownerFirst}: ao enviar, você passa a ser responsável.`}
          </p>
          <input type="hidden" name="telefone" value={selected.phone} />
          <input type="hidden" name="responsavel_visto" value={selected.assignedTo ?? ""} />
          <input type="hidden" name="return_to" value={threadHref} />
          <label for="attach_file" class="text-sm font-semibold text-ink">
            Arquivo
          </label>
          <input
            id="attach_file"
            name="arquivo"
            type="file"
            required
            accept="image/jpeg,image/png,application/pdf"
            class="block w-full text-sm text-ink file:mr-3 file:min-h-11 file:rounded-lg file:border file:border-line-strong file:bg-white file:px-3 file:text-sm file:font-semibold file:text-ink"
          />
          <label for="attach_caption" class="text-sm font-semibold text-ink">
            Legenda <span class="font-normal text-ink-soft">(opcional)</span>
          </label>
          <textarea id="attach_caption" name="legenda" rows="2" maxlength="1024" class={`${CONTROL} w-full resize-none`}></textarea>
          <p class="hidden rounded-lg border border-danger-line bg-can-50 px-3 py-2 text-sm text-danger" role="alert" data-attach-error></p>
          <p class="text-sm text-ink-soft" aria-live="polite" data-attach-status></p>
          <div class="mt-1 flex justify-end gap-2">
            <button type="button" class={ACTION} data-attach-close>
              Cancelar
            </button>
            <button type="submit" class="inline-flex min-h-11 items-center justify-center rounded-lg bg-brand px-4 text-sm font-semibold text-white hover:bg-brand-ink sm:min-h-10">
              Enviar
            </button>
          </div>
        </form>
      </dialog>
    )
  }

  {
    canMark && selected && !marked && (
      <dialog
        id="more_dialog"
        aria-label="Mais ações"
        class="m-0 w-[290px] max-w-[calc(100vw-2rem)] rounded-xl border border-line-strong bg-white p-1.5 text-ink shadow-[0_10px_30px_rgba(20,40,30,.18)] backdrop:bg-transparent max-sm:m-auto"
      >
        <div class="flex flex-col">
          <span class="px-3 pt-2 pb-1 text-xs font-bold tracking-[.06em] text-ink-soft">NÃO É ATENDIMENTO</span>
          {(["personal", "administrative"] as const).map((value) => (
            <form method="POST" action="/api/admin/classificar-conversa" class="flex">
              <input type="hidden" name="telefone" value={selected.phone} />
              <input type="hidden" name="classificacao" value={value} />
              <input type="hidden" name="return_to" value={threadHref} />
              <input type="hidden" name="depois" value={markedHref(selected.phone)} />
              <button
                type="submit"
                class="js-confirm-delete min-h-11 w-full rounded-md px-3 text-left text-[15px] text-ink hover:bg-canvas"
                data-confirm-title={`Marcar como ${value === "personal" ? "Pessoal" : "Administrativo/outros"}?`}
                data-confirm-message={`O bot para de responder ${formatPhoneBR(selected.phone)}. A conversa sai dos pendentes e das métricas e vai para "Pessoal e admin.". Dá para desfazer depois.`}
                data-confirm-label="Marcar"
              >
                {value === "personal" ? "Marcar como Pessoal" : "Marcar como Administrativo/outros"}
              </button>
            </form>
          ))}
          <span class="border-t border-line px-3 pt-2 pb-1.5 text-xs text-ink-soft">Cada opção pede confirmação antes de marcar.</span>
        </div>
      </dialog>
    )
  }

  <ConfirmDeleteDialog />
</AdminLayout>

<script>
  // A conversa abre na mensagem mais nova (o fim da lista).
  const thread = document.querySelector<HTMLElement>("[data-thread]");
  // A conversa rola dentro do quadro, no computador e no celular.
  const toEnd = () => {
    if (thread) thread.scrollTop = thread.scrollHeight;
  };
  const atEnd = () => !!thread && thread.scrollHeight - thread.scrollTop - thread.clientHeight < 120;
  // Celular com a conversa aberta (tela cheia, como no WhatsApp): a página atrás não rola, e o quadro acompanha a área
  // visível, para a caixa de resposta ficar logo acima do teclado.
  if (document.querySelector("[data-conversation]")) {
    const root = document.documentElement;
    root.classList.add("max-lg:overflow-hidden");
    const viewport = window.visualViewport;
    const fit = () => {
      if (!viewport) return;
      const follow = atEnd();
      root.style.setProperty("--app-height", `${viewport.height}px`);
      root.style.setProperty("--app-top", `${viewport.offsetTop}px`);
      if (follow) toEnd();
    };
    viewport?.addEventListener("resize", fit);
    viewport?.addEventListener("scroll", fit);
    fit();
  }
  if (thread && !new URLSearchParams(location.search).has("antes")) {
    toEnd();
    // As fotos (CN5) carregam depois: a conversa segue no fim, se ninguém rolou.
    let moved = false;
    thread.addEventListener("wheel", () => (moved = true), { once: true, passive: true });
    thread.addEventListener("touchmove", () => (moved = true), { once: true, passive: true });
    thread.querySelectorAll("img").forEach((img) => img.addEventListener("load", () => !moved && toEnd(), { once: true }));
    window.addEventListener("load", () => !moved && toEnd(), { once: true });
  }
  // Mensagens novas (cliente, 06/nov/2026): a cada 10 s, com a aba à vista, a tela busca a própria página e troca só a
  // lista, a conversa e a situação. A caixa de resposta, as janelas abertas e os botões ficam como estão; quem estava no
  // fim da conversa segue no fim. Áudio tocando: a conversa espera. A recarga inteira de 1 minuto (autoRefresh) continua.
  const LIVE_MS = 10_000;
  let fetching = false;
  const live = async () => {
    if (fetching || document.visibilityState !== "visible" || document.getElementById("page-loading")?.hasAttribute("data-active")) return;
    fetching = true;
    try {
      const response = await fetch(location.href, { credentials: "same-origin", cache: "no-store" });
      if (!response.ok || response.redirected) return;
      const next = new DOMParser().parseFromString(await response.text(), "text/html");
      document.querySelectorAll<HTMLElement>("[data-live]").forEach((current) => {
        const fresh = next.querySelector<HTMLElement>(`[data-live="${current.dataset.live}"]`);
        if (!fresh || fresh.innerHTML === current.innerHTML) return;
        if (current === thread) {
          if ([...thread.querySelectorAll("audio")].some((audio) => !audio.paused)) return;
          const follow = atEnd();
          const top = thread.scrollTop;
          thread.innerHTML = fresh.innerHTML;
          if (follow) {
            toEnd();
            thread.querySelectorAll("img").forEach((img) => img.addEventListener("load", () => atEnd() || toEnd(), { once: true }));
          } else thread.scrollTop = top;
          return;
        }
        current.innerHTML = fresh.innerHTML;
      });
      // O que os botões guardam do que a tela mostrou (hora da situação, responsável): acompanha a atualização, senão
      // "Finalizar atendimento" recusava ("O paciente escreveu de novo") uma mensagem que já estava na tela.
      for (const name of ["situacao_em", "responsavel_visto"]) {
        const mine = document.querySelectorAll<HTMLInputElement>(`input[type=hidden][name="${name}"]`);
        const theirs = next.querySelectorAll<HTMLInputElement>(`input[type=hidden][name="${name}"]`);
        if (mine.length === theirs.length) mine.forEach((input, index) => (input.value = theirs[index].value));
      }
    } catch {
      // Sem internet: tenta de novo na próxima vez.
    } finally {
      fetching = false;
    }
  };
  if (document.querySelector("[data-live]")) {
    setInterval(live, LIVE_MS);
    document.addEventListener("visibilitychange", live);
  }
  // Menu ⋯ da conversa (NA): abre logo abaixo do botão (no celular, no meio da tela), por cima de tudo; fecha ao clicar
  // fora, com Esc ou ao escolher (a confirmação vem em seguida).
  const moreButton = document.querySelector<HTMLButtonElement>("[data-more-open]");
  const moreDialog = document.getElementById("more_dialog") as HTMLDialogElement | null;
  if (moreButton && moreDialog) {
    moreButton.addEventListener("click", () => {
      moreDialog.showModal();
      if (window.matchMedia("(min-width: 640px)").matches) {
        const rect = moreButton.getBoundingClientRect();
        const width = moreDialog.offsetWidth;
        moreDialog.style.position = "fixed";
        moreDialog.style.top = `${Math.min(rect.bottom + 4, window.innerHeight - moreDialog.offsetHeight - 8)}px`;
        moreDialog.style.left = `${Math.max(8, Math.min(rect.left, window.innerWidth - width - 8))}px`;
      }
    });
    moreDialog.addEventListener("click", (event) => {
      if (event.target === moreDialog) moreDialog.close();
    });
    moreDialog.querySelectorAll("button[type=submit]").forEach((button) => button.addEventListener("click", () => moreDialog.close()));
  }
  // Caixa de resposta: cresce com o texto; Ctrl+Enter (ou Cmd+Enter) envia; um envio por vez.
  const composer = document.querySelector<HTMLFormElement>("[data-composer]");
  const text = composer?.querySelector<HTMLTextAreaElement>("[data-composer-text]");
  const grow = () => {
    if (!text) return;
    text.style.height = "auto";
    text.style.height = `${Math.min(text.scrollHeight + 2, 160)}px`;
  };
  text?.addEventListener("input", grow);
  grow();
  text?.addEventListener("keydown", (event) => {
    if (event.key === "Enter" && (event.ctrlKey || event.metaKey)) {
      event.preventDefault();
      composer?.querySelector<HTMLButtonElement>("button[type=submit]")?.click();
    }
  });
  composer?.addEventListener("submit", () => {
    window.setTimeout(() => composer.querySelector<HTMLButtonElement>("button[type=submit]")?.setAttribute("disabled", ""), 0);
  });
  // Foto ou PDF (CN6): confere, sobe direto ao armazenamento pelo link de uso único e envia.
  const attach = document.getElementById("attach_dialog") as HTMLDialogElement | null;
  const attachForm = attach?.querySelector<HTMLFormElement>("[data-attach-form]");
  if (attach && attachForm) {
    const error = attachForm.querySelector<HTMLElement>("[data-attach-error]")!;
    const status = attachForm.querySelector<HTMLElement>("[data-attach-status]")!;
    const submit = attachForm.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const field = (name: string) => (attachForm.elements.namedItem(name) as HTMLInputElement).value;
    const LIMITS: Record<string, number> = { "image/jpeg": 5, "image/png": 5, "application/pdf": 10 };
    // Foto como o app do WhatsApp manda (cliente, 06/nov/2026): JPEG de 8 bits, até 2560 px no lado maior, fundo branco
    // no lugar da transparência. O WhatsApp recusa PNG de 16 bits (o print do iPhone, Display P3) com o erro 131053.
    // Sem como converter (navegador antigo), vai o arquivo original.
    const MAX_SIDE = 2560;
    const asJpeg = async (original: File): Promise<File> => {
      try {
        const bitmap = await createImageBitmap(original);
        const scale = Math.min(1, MAX_SIDE / Math.max(bitmap.width, bitmap.height));
        const canvas = document.createElement("canvas");
        canvas.width = Math.round(bitmap.width * scale);
        canvas.height = Math.round(bitmap.height * scale);
        const context = canvas.getContext("2d");
        if (!context) return original;
        context.fillStyle = "#fff";
        context.fillRect(0, 0, canvas.width, canvas.height);
        context.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
        bitmap.close();
        const blob = await new Promise<Blob | null>((done) => canvas.toBlob(done, "image/jpeg", 0.85));
        if (!blob) return original;
        return new File([blob], `${original.name.replace(/\.[^.]+$/, "") || "foto"}.jpg`, { type: "image/jpeg" });
      } catch {
        return original;
      }
    };
    const fail = (text: string) => {
      error.textContent = text;
      error.classList.remove("hidden");
      status.textContent = "";
      submit.disabled = false;
    };
    document.querySelector("[data-attach-open]")?.addEventListener("click", () => attach.showModal());
    attach.querySelector("[data-attach-close]")?.addEventListener("click", () => attach.close());
    const post = async (body: Record<string, unknown>) => {
      const response = await fetch(attachForm.dataset.api!, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
      const data = await response.json().catch(() => ({ error: "Não deu certo. Tente de novo." }));
      if (!response.ok) throw new Error(data.error ?? "Não deu certo. Tente de novo.");
      return data;
    };
    attachForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      error.classList.add("hidden");
      const chosen = (attachForm.elements.namedItem("arquivo") as HTMLInputElement).files?.[0];
      if (!chosen) return fail("Escolha o arquivo.");
      if (!LIMITS[chosen.type]) return fail("Envie uma foto (JPG ou PNG) ou um PDF.");
      submit.disabled = true;
      status.textContent = "Preparando…";
      const file = chosen.type === "application/pdf" ? chosen : await asJpeg(chosen);
      const limit = LIMITS[file.type];
      if (file.size > limit * 1024 * 1024) return fail(file.type === "application/pdf" ? "O PDF vai até 10 MB." : "A foto vai até 5 MB.");
      // Chave nova a cada tentativa: o arquivo vai para um caminho próprio (o anterior, recusado, não atrapalha); dentro
      // da tentativa, o mesmo envio não sai duas vezes.
      const base = { telefone: field("telefone"), chave: crypto.randomUUID(), tipo: file.type, tamanho: file.size, nome: file.name };
      submit.disabled = true;
      try {
        status.textContent = "Preparando…";
        const { uploadUrl } = await post({ acao: "preparar", ...base });
        status.textContent = "Enviando o arquivo…";
        const body = new FormData();
        body.append("cacheControl", "3600");
        body.append("", file);
        const upload = await fetch(uploadUrl, { method: "PUT", headers: { "x-upsert": "false" }, body });
        if (!upload.ok) throw new Error("O arquivo não foi enviado. Confira a internet e tente de novo.");
        status.textContent = "Enviando ao paciente…";
        const { redirectTo } = await post({
          acao: "enviar",
          ...base,
          legenda: field("legenda"),
          responsavel_visto: field("responsavel_visto"),
          return_to: field("return_to"),
        });
        window.location.href = redirectTo;
      } catch (e) {
        fail(e instanceof Error && e.message ? e.message : "Não deu certo. Tente de novo.");
      }
    });
  }
  const transfer = document.getElementById("transfer_dialog") as HTMLDialogElement | null;
  document.querySelector("[data-transfer-open]")?.addEventListener("click", () => transfer?.showModal());
  transfer?.querySelector("[data-transfer-close]")?.addEventListener("click", () => transfer.close());

  const dialog = document.getElementById("notifications_dialog") as HTMLDialogElement | null;
  document.querySelector("[data-notifications-open]")?.addEventListener("click", () => dialog?.showModal());
  dialog?.querySelector("[data-notifications-close]")?.addEventListener("click", () => dialog.close());
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>

---
import AuthLayout from "../../layouts/AuthLayout.astro";
import Pill from "../../components/admin/ui/Pill.astro";
import Notice from "../../components/admin/ui/Notice.astro";
import { AUTH_INPUT, AUTH_LABEL, AUTH_LINK } from "../../components/admin/auth/styles";
import { ACTIVE_CLINIC_COOKIE, roleLabel } from "../../lib/clinicAccess";
import { clinicInitials, filterClinicsByName, showClinicSearch } from "../../lib/clinicSearch";
import { createUserClient } from "../../lib/data/clients";
import { isPlatformStaff, listSelectableClinics } from "../../lib/data/clinicChoice";

// Escolha da clínica (F4.1): membro de várias clínicas ou Suporte. A troca é
// feita por /api/admin/clinica-ativa. R10 (cliente, 17/out/2026): cartões com
// as iniciais, o papel e os selos; para o Suporte, a busca pelo nome com mais
// de 6 clínicas e os links do sistema no pé.
const db = createUserClient(Astro.request, Astro.cookies);
const userId = Astro.locals.userId!;
const [allClinics, staff] = await Promise.all([listSelectableClinics(db, userId), isPlatformStaff(db, userId)]);
const current = Astro.cookies.get(ACTIVE_CLINIC_COOKIE)?.value;
const searchable = staff && showClinicSearch(allClinics.length);
const query = searchable ? (Astro.url.searchParams.get("busca")?.trim() ?? "") : "";
const clinics = filterClinicsByName(allClinics, query);
---

<AuthLayout title="Escolha a clínica" wide>
  {
    staff && (
      <Notice tone="warning">Você entra como Suporte RecepClinic: cada tela aberta fica registrada para a clínica.</Notice>
    )
  }
  {
    searchable && (
      <form method="get" role="search" class="flex items-end gap-2">
        <div class="min-w-0 flex-1">
          <label for="busca" class={AUTH_LABEL}>Buscar clínica</label>
          <input type="search" id="busca" name="busca" value={query} placeholder="Nome da clínica" autocomplete="off" class={AUTH_INPUT} />
        </div>
        <button type="submit" class="h-11 shrink-0 rounded-lg border border-line-strong bg-white px-4 text-[15px] font-semibold text-ink hover:bg-canvas">
          Buscar
        </button>
      </form>
    )
  }
  {
    clinics.length > 0 && (
      <ul class="flex flex-col gap-2">
        {clinics.map((clinic) => (
          <li>
            <form method="POST" action="/api/admin/clinica-ativa">
              <input type="hidden" name="clinicId" value={clinic.id} />
              <button
                type="submit"
                class={`flex min-h-[60px] w-full items-center gap-3 rounded-[10px] border px-3.5 py-3 text-left hover:border-brand hover:bg-[#f2faf7] focus-visible:outline-2 focus-visible:outline-brand disabled:opacity-60 ${
                  clinic.id === current ? "border-brand bg-[#f2faf7]" : "border-line bg-white"
                }`}
              >
                <span aria-hidden="true" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-[9px] bg-brand-soft text-[15px] font-bold text-brand-ink">
                  {clinicInitials(clinic.name)}
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block text-base leading-snug font-bold break-words text-ink">{clinic.name}</span>
                  <span class="block text-sm text-ink-soft">{roleLabel({ roles: clinic.roles, isPlatformStaff: staff })}</span>
                </span>
                <span class="flex shrink-0 flex-col items-end gap-1">
                  {clinic.id === current && <Pill tone="success">Aberta agora</Pill>}
                  {clinic.status === "suspended" && <Pill tone="warning">Suspensa</Pill>}
                  {clinic.status === "onboarding" && <Pill tone="warning">Em implantação</Pill>}
                </span>
              </button>
            </form>
          </li>
        ))}
      </ul>
    )
  }
  {
    clinics.length === 0 &&
      (query ? (
        <p class="text-[15px] text-ink-soft">
          Nenhuma clínica com "{query}". <a href="/admin/escolher-clinica" class="font-semibold text-brand">Limpar a busca</a>
        </p>
      ) : (
        <p class="text-[15px] text-ink-soft">Nenhuma clínica disponível.</p>
      ))
  }
  {
    staff && (
      <div class="flex flex-col gap-2 border-t border-[#e6ecea] pt-3.5">
        <span class="text-xs font-bold tracking-[.07em] text-ink-soft uppercase">Administração do sistema</span>
        <div class="flex flex-wrap gap-x-4 gap-y-1">
          <a href="/admin/sistema/clinicas" class="py-1 text-[15px] font-semibold text-brand no-underline hover:underline">
            Clínicas
          </a>
          <a href="/admin/sistema/matriz" class="py-1 text-[15px] font-semibold text-brand no-underline hover:underline">
            Matriz de acesso
          </a>
        </div>
      </div>
    )
  }
  <form method="POST" action="/api/admin/auth/logout" class="flex justify-center">
    <button type="submit" class={`${AUTH_LINK} cursor-pointer border-0 bg-transparent`}>Sair</button>
  </form>
</AuthLayout>

---
import Notice from "../../components/admin/ui/Notice.astro";
import PasswordField from "../../components/admin/auth/PasswordField.astro";
import { AUTH_INPUT, AUTH_LABEL, AUTH_LINK } from "../../components/admin/auth/styles";
import { buttonClass } from "../../components/admin/ui/styles";
import AuthLayout from "../../layouts/AuthLayout.astro";

const error = Astro.url.searchParams.get("error");
const ERRORS: Record<string, string> = {
  // Login certo, mas sem papel em nenhuma clínica (D6, F3.2).
  sem_acesso: "Este login não tem acesso a nenhuma clínica.",
};
const errorMessage = error === null ? null : (ERRORS[error] ?? "E-mail ou senha inválidos.");
// Senha errada (R10): o e-mail volta no campo (src/scripts/keepFormValues.ts;
// a senha nunca é guardada) e o foco vai para a senha.
const wrongPassword = error !== null && !(error in ERRORS);
---

<AuthLayout title="Entrar no painel">
  <p slot="subtitle" class="text-[15px] text-ink-soft">Acesso restrito à equipe da clínica.</p>
  {
    errorMessage && (
      <div data-flash="error" data-fields={wrongPassword ? "password" : undefined}>
        <div data-form-error tabindex="-1" class="outline-none">
          <Notice tone="danger">
            {errorMessage}
          </Notice>
        </div>
      </div>
    )
  }
  <form method="POST" action="/api/admin/auth/login" class="flex flex-col gap-4">
    <div>
      <label for="email" class={AUTH_LABEL}>E-mail</label>
      <input type="email" name="email" id="email" required autocomplete="email" class={AUTH_INPUT} />
    </div>
    <PasswordField id="password" name="password" label="Senha" autocomplete="current-password" />
    <button type="submit" data-sending-label="Entrando…" class={`${buttonClass("primary")} mt-1 h-[46px] w-full text-base sm:h-[46px]`}>Entrar</button>
  </form>
  <a href="/admin/esqueci-senha" class={AUTH_LINK}>Esqueci minha senha</a>
</AuthLayout>

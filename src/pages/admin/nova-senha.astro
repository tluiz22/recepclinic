---
import Notice from "../../components/admin/ui/Notice.astro";
import PasswordField from "../../components/admin/auth/PasswordField.astro";
import { buttonClass } from "../../components/admin/ui/styles";
import AuthLayout from "../../layouts/AuthLayout.astro";
import { isPasswordProblem, MIN_PASSWORD_LENGTH, PASSWORD_PROBLEMS } from "../../lib/data/auth";

// Senha nova depois do convite ou da recuperação (F4.1). A sessão foi aberta
// pelo link do e-mail (/api/admin/auth/confirmar).
const origem = Astro.url.searchParams.get("origem") === "convite" ? "convite" : "recuperacao";
const erro = Astro.url.searchParams.get("erro");
const problem = isPasswordProblem(erro) ? PASSWORD_PROBLEMS[erro] : null;
// R10: o erro vai embaixo do campo que precisa mudar; link vencido, no alto.
const onConfirmation = erro === "mismatch" ? problem : null;
const onPassword = problem && erro !== "mismatch" && erro !== "session" ? problem : null;
const onTop = erro === "session" ? problem : null;
---

<AuthLayout title={origem === "convite" ? "Bem-vindo! Crie a sua senha" : "Crie uma senha nova"}>
  <p slot="subtitle" class="text-[15px] text-ink-soft">Use pelo menos {MIN_PASSWORD_LENGTH} caracteres.</p>
  {
    onTop && (
      <Notice tone="danger" href="/admin/esqueci-senha" linkLabel="Pedir outro link">
        {onTop}
      </Notice>
    )
  }
  <form method="POST" action="/api/admin/auth/nova-senha" class="flex flex-col gap-4">
    <input type="hidden" name="origem" value={origem} />
    <PasswordField id="password" name="password" label="Senha nova" autocomplete="new-password" minlength={MIN_PASSWORD_LENGTH} error={onPassword} />
    <PasswordField
      id="confirmation"
      name="confirmation"
      label="Repita a senha"
      autocomplete="new-password"
      minlength={MIN_PASSWORD_LENGTH}
      error={onConfirmation}
    />
    <button type="submit" data-sending-label="Salvando…" class={`${buttonClass("primary")} mt-1 h-[46px] w-full text-base sm:h-[46px]`}>Salvar senha</button>
  </form>
</AuthLayout>

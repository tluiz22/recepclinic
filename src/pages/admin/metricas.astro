---
// Métricas (Fase 15; em abas desde a Fase 23 · etapa 4): seletor de período
// (abre em Hoje) e uma aba por assunto — cada aba busca só o que exibe. Só a
// médica (ver middleware). Relatórios virou a aba Atendimentos; Lembretes foi
// para Consultas (a secretária também usa); Envios virou aba (etapa 5), sem
// período — mostra os atendimentos futuros e as últimas execuções. Financeiro
// (Fase 24) usa período e filtro.
import AdminLayout from "../../layouts/AdminLayout.astro";
import TabBar from "../../components/admin/TabBar.astro";
import VisaoGeral from "../../components/admin/metricas/VisaoGeral.astro";
import Funil from "../../components/admin/metricas/Funil.astro";
import Atendimentos from "../../components/admin/metricas/Atendimentos.astro";
import RetomarContato from "../../components/admin/metricas/RetomarContato.astro";
import Envios from "../../components/admin/metricas/Envios.astro";
import Faltosos from "../../components/admin/metricas/Faltosos.astro";
import Financeiro from "../../components/admin/metricas/Financeiro.astro";
import { PERIOD_PRESETS, metricsUrl, parsePeriod, periodParams, todayFortaleza } from "../../lib/metrics/period";
import { filterParams, resolveFilter, searchPeople } from "../../lib/metrics/filter";
import { createClient } from "../../lib/supabase/server";

const TABS = [
  { id: "visao_geral", label: "Visão geral" },
  { id: "funil", label: "Funil" },
  { id: "atendimentos", label: "Atendimentos" },
  { id: "retomar_contato", label: "Retomar contato" },
  { id: "faltosos", label: "Faltosos" },
  { id: "financeiro", label: "Financeiro" },
  { id: "envios", label: "Envios" },
] as const;
type TabId = (typeof TABS)[number]["id"];

const tabParam = Astro.url.searchParams.get("tab");
const tab: TabId = TABS.some((item) => item.id === tabParam) ? (tabParam as TabId) : "visao_geral";

const period = parsePeriod(Astro.url.searchParams);
const today = todayFortaleza();

// Filtro por paciente ou responsável (etapa 8). Faltosos e Envios não usam
// período nem filtro.
const supabase = createClient(Astro.request, Astro.cookies);
const filter = await resolveFilter(supabase, Astro.url.searchParams);
const usesPeriodAndFilter = tab !== "envios" && tab !== "faltosos";
const searchTerm = (Astro.url.searchParams.get("busca") ?? "").trim();
const searchResults = !filter && usesPeriodAndFilter && searchTerm ? await searchPeople(supabase, searchTerm) : [];

// A aba padrão não vai na URL; o período "Hoje" também não.
const tabValue = (id: TabId) => (id === "visao_geral" ? undefined : id);
const tabs = TABS.map((item) => ({
  label: item.label,
  href: metricsUrl({ tab: tabValue(item.id), ...periodParams(period), ...filterParams(filter) }),
  active: item.id === tab,
}));
const presetHref = (preset: string) =>
  metricsUrl({ tab: tabValue(tab), periodo: preset === "hoje" ? undefined : preset, ...filterParams(filter) });
const clearFilterHref = metricsUrl({ tab: tabValue(tab), ...periodParams(period) });
const pickHref = (result: { kind: "patient" | "guardian"; id: string }) =>
  metricsUrl({
    tab: tabValue(tab),
    ...periodParams(period),
    ...(result.kind === "patient" ? { paciente: result.id } : { responsavel: result.id }),
  });
---

<AdminLayout title="Métricas">
  <h1 class="text-2xl font-bold text-slate-900">Métricas</h1>

  {
    // Faltosos (todo o histórico) e Envios (futuro + últimas execuções) não usam período.
    usesPeriodAndFilter && (
      <>
        <div class="mt-4 flex flex-wrap items-center gap-2">
          {
            PERIOD_PRESETS.map((preset) => (
              <a
                href={presetHref(preset.id)}
                aria-current={period.preset === preset.id ? "true" : undefined}
                class={`rounded-md border px-2.5 py-1 text-xs font-medium ${
                  period.preset === preset.id
                    ? "border-sky-700 bg-sky-50 text-sky-800"
                    : "border-slate-300 bg-white text-slate-600 hover:border-sky-700 hover:text-sky-700"
                }`}
              >
                {preset.label}
              </a>
            ))
          }
          <details class="custom-period group" open={period.preset === "personalizado" || period.invalid}>
            <summary
              class={`cursor-pointer list-none rounded-md border px-2.5 py-1 text-xs font-medium ${
                period.preset === "personalizado"
                  ? "border-sky-700 bg-sky-50 text-sky-800"
                  : "border-slate-300 bg-white text-slate-600 hover:border-sky-700 hover:text-sky-700"
              }`}
            >
              Personalizado
            </summary>
            <form method="GET" action="/admin/metricas" class="mt-2 flex flex-wrap items-end gap-2">
              {tab !== "visao_geral" && <input type="hidden" name="tab" value={tab} />}
              <input type="hidden" name="periodo" value="personalizado" />
              {Object.entries(filterParams(filter)).map(([name, value]) => (
                <input type="hidden" name={name} value={value} />
              ))}
              <label class="flex flex-col gap-1 text-xs text-slate-600">
                De
                <input
                  type="date"
                  name="de"
                  required
                  max={today}
                  value={period.from}
                  class="rounded-md border border-slate-300 px-2 py-1.5 text-sm"
                />
              </label>
              <label class="flex flex-col gap-1 text-xs text-slate-600">
                Até
                <input
                  type="date"
                  name="ate"
                  required
                  value={period.to}
                  class="rounded-md border border-slate-300 px-2 py-1.5 text-sm"
                />
              </label>
              <button type="submit" class="rounded-md bg-sky-700 px-3 py-1.5 text-sm font-medium text-white hover:bg-sky-800">
                Aplicar
              </button>
            </form>
          </details>
        </div>

        <p class="mt-2 text-sm text-slate-600">
          Período: <span class="font-medium text-slate-900">{period.label}</span>
        </p>
        {
          period.invalid && (
            <p class="mt-2 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">
              Período personalizado inválido (a data inicial deve vir antes da final, com até 1 ano). Mostrando hoje.
            </p>
          )
        }

        {
          filter ? (
            <div class="mt-3 flex flex-wrap items-center gap-2 rounded-lg border border-sky-200 bg-sky-50 px-3 py-2 text-sm text-sky-900">
              <span>
                Só de: <span class="font-semibold">{filter.label}</span>
              </span>
              <a href={clearFilterHref} class="ml-auto font-medium text-sky-700 hover:underline">
                ✕ Ver todos
              </a>
              {filter.kind === "patient" && (
                <p class="w-full text-xs text-sky-800">
                  Os números do WhatsApp são os do responsável, que é quem conversa com o bot.
                </p>
              )}
            </div>
          ) : (
            <form method="GET" action="/admin/metricas" class="mt-3 flex gap-2">
              {tab !== "visao_geral" && <input type="hidden" name="tab" value={tab} />}
              {Object.entries(periodParams(period)).map(([name, value]) => (
                <input type="hidden" name={name} value={value} />
              ))}
              <input
                type="search"
                name="busca"
                value={searchTerm}
                placeholder="Filtrar por paciente ou responsável"
                class="min-w-0 flex-1 rounded-md border border-slate-300 px-3 py-2 text-sm sm:max-w-sm"
              />
              <button
                type="submit"
                class="shrink-0 rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50"
              >
                Buscar
              </button>
            </form>
          )
        }
        {
          !filter && searchTerm && (
            <div class="mt-2 rounded-lg border border-slate-200 bg-white p-2 sm:max-w-md">
              {searchResults.length === 0 ? (
                <p class="px-2 py-1 text-sm text-slate-500">Ninguém encontrado para "{searchTerm}".</p>
              ) : (
                <ul class="divide-y divide-slate-100">
                  {searchResults.map((result) => (
                    <li>
                      <a href={pickHref(result)} class="block rounded-md px-2 py-2 hover:bg-slate-50">
                        <span class="block text-sm font-medium text-slate-900">{result.name}</span>
                        <span class="block text-xs text-slate-500">{result.detail}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          )
        }
      </>
    )
  }

  {
    !usesPeriodAndFilter && filter && (
      <p class="mt-3 text-sm text-slate-500">
        O filtro por {filter.kind === "patient" ? "paciente" : "responsável"} não vale para esta aba; ele volta ao abrir
        as outras.
      </p>
    )
  }

  <TabBar label="Assuntos de Métricas" class="mt-3" tabs={tabs} />

  {tab === "visao_geral" && <VisaoGeral period={period} filter={filter} />}
  {tab === "funil" && <Funil period={period} filter={filter} />}
  {tab === "atendimentos" && <Atendimentos period={period} filter={filter} />}
  {tab === "retomar_contato" && <RetomarContato period={period} filter={filter} />}
  {tab === "faltosos" && <Faltosos />}
  {tab === "financeiro" && <Financeiro period={period} filter={filter} />}
  {tab === "envios" && <Envios />}
</AdminLayout>

<style>
  .custom-period summary::-webkit-details-marker {
    display: none;
  }
</style>

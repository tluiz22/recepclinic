---
// Métricas (F4.9), no banco novo: período (abre em Hoje), seletor de agenda
// para o Administrador (cliente, 05/out/2026; o Profissional vê só as
// próprias, D11), filtro por paciente ou responsável e uma aba por item da
// matriz: Visão geral, Atendimentos, Faltosos e Financeiro; Funil do bot e
// Retomar contato (F6.7, como no piloto; a clínica toda, sem o seletor de
// agenda, porque os passos do bot não guardam a agenda). Envios foi para o
// Resumo do Dia (F4.8).
import AdminLayout from "../../layouts/AdminLayout.astro";
import Card from "../../components/admin/Card.astro";
import TabBar from "../../components/admin/TabBar.astro";
import Badge from "../../components/admin/Badge.astro";
import Stat from "../../components/admin/metricas/Stat.astro";
import PhoneLinks from "../../components/admin/PhoneLinks.astro";
import Table from "../../components/admin/metricas/Table.astro";
import { INPUT, SECONDARY_BUTTON } from "../../components/admin/fieldStyles";
import { isUuid } from "../../lib/clinicAccess";
import { formatInstant } from "../../lib/clinicTime";
import { createUserClient } from "../../lib/data/clients";
import { listAgendas } from "../../lib/data/config/agendas";
import { byOrigin, financial, listFrequentNoShows, listMetricsRows, noShowByCategory, overview, ownAgendaIds, volumeByService } from "../../lib/data/metrics";
import { getContact, getPatient, listContactPatients, searchContacts, searchPatients } from "../../lib/data/patients";
import { metricsScope, type FeatureKey } from "../../lib/features";
import { buildFunnelReport, listFunnelEvents } from "../../lib/data/botFunnel";
import { PERIOD_PRESETS, parsePeriod } from "../../lib/metricsPeriod";
import { formatCentsBRL } from "../../lib/money";
import { formatPhoneBR } from "../../lib/phone";
import { capitalize, vocabularyFor } from "../../lib/vocabulary";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const vocabulary = vocabularyFor(clinic.clinicProfile);
const params = Astro.url.searchParams;
const now = new Date();

const TABS: { id: string; label: string; feature: FeatureKey }[] = [
  { id: "visao_geral", label: "Visão geral", feature: "metrics_overview" },
  { id: "atendimentos", label: "Atendimentos", feature: "metrics_appointments" },
  { id: "faltosos", label: "Faltosos", feature: "metrics_no_shows" },
  { id: "financeiro", label: "Financeiro", feature: "metrics_financial" },
  { id: "funil", label: "Funil do bot", feature: "metrics_funnel" },
  { id: "retomar", label: "Retomar contato", feature: "metrics_recall" },
];
// Funil e Retomar contato são da clínica toda: o Profissional (só a própria agenda) não vê.
const BOT_TABS = ["funil", "retomar"];
const visible = TABS.filter((t) => clinic.features.includes(t.feature) && (!BOT_TABS.includes(t.id) || metricsScope(clinic) === "clinic"));
const tab = visible.find((t) => t.id === params.get("tab"))?.id ?? visible[0]?.id ?? null;

// Escopo: a clínica toda (Administrador, com o seletor) ou só as agendas do próprio Profissional.
const scope = metricsScope(clinic);
const agendas = await listAgendas(db, clinic.clinicId, { includeInactive: true });
const own = scope === "own_agenda" ? await ownAgendaIds(db, clinic.clinicId, clinic.userId) : null;
const selectable = own ? agendas.filter((a) => own.includes(a.id)) : agendas;
const agendaParam = params.get("agenda");
const selectedAgenda = selectable.find((a) => a.id === agendaParam) ?? null;
const agendaIds = selectedAgenda ? [selectedAgenda.id] : selectable.map((a) => a.id);

// Filtro por paciente ou responsável.
const patientParam = params.get("paciente");
const contactParam = params.get("responsavel");
const filterPatient = isUuid(patientParam) ? await getPatient(db, clinic.clinicId, patientParam).catch(() => null) : null;
const filterContact = !filterPatient && isUuid(contactParam) ? await getContact(db, clinic.clinicId, contactParam).catch(() => null) : null;
const patientIds = filterPatient
  ? [filterPatient.id]
  : filterContact
    ? (await listContactPatients(db, clinic.clinicId, filterContact.id, { includeInactive: true })).map((p) => p.id)
    : null;
const busca = (params.get("busca") ?? "").trim();
const [foundPatients, foundContacts] =
  busca && !filterPatient && !filterContact ? await Promise.all([searchPatients(db, clinic.clinicId, busca), searchContacts(db, clinic.clinicId, busca)]) : [[], []];

const period = parsePeriod(params, clinic.timezone, now);
const usesPeriod = tab !== "faltosos";
const botTab = !!tab && BOT_TABS.includes(tab);
const filterPhone = filterPatient
  ? (await getContact(db, clinic.clinicId, filterPatient.contactId).catch(() => null))?.phone ?? null
  : (filterContact?.phone ?? null);
const funnel = botTab ? buildFunnelReport(await listFunnelEvents(db, clinic.clinicId, period.start, period.end, filterPhone), period.start, period.end, now) : null;
const RECALL_LIMIT = 50;
const recall = tab === "retomar" && funnel ? funnel.incomplete.slice(0, RECALL_LIMIT) : [];
const recallContacts =
  recall.length > 0
    ? new Map(
        (
          (await db
            .from("contacts")
            .select("id, full_name")
            .eq("clinic_id", clinic.clinicId)
            .in("id", [...new Set(recall.map((r) => r.contactId).filter((id): id is string => !!id))])).data ?? []
        ).map((c) => [c.id, c.full_name]),
      )
    : new Map<string, string>();
const rows = tab && usesPeriod && !botTab ? await listMetricsRows(db, clinic.clinicId, { start: period.start, end: period.end, agendaIds, patientIds }) : [];
const frequent = tab === "faltosos" ? await listFrequentNoShows(db, clinic.clinicId, agendaIds) : [];

const keep = { tab: tab ?? "", periodo: period.preset === "hoje" ? "" : period.preset, de: period.preset === "personalizado" ? period.from : "", ate: period.preset === "personalizado" ? period.to : "", agenda: selectedAgenda?.id ?? "", paciente: filterPatient?.id ?? "", responsavel: filterContact?.id ?? "" };
const link = (changes: Partial<Record<keyof typeof keep | "busca", string>>) => {
  const next = new URLSearchParams();
  for (const [key, value] of Object.entries({ ...keep, ...changes })) if (value) next.set(key, value);
  return `/admin/metricas?${next}`;
};
const pct = (rate: number | null) => (rate === null ? "—" : `${Math.round(rate * 100)}%`);
const money = (cents: number) => formatCentsBRL(cents);
const chip = (active: boolean) =>
  `rounded-md border px-2.5 py-1 text-xs font-medium ${active ? "border-sky-700 bg-sky-50 text-sky-800" : "border-slate-300 bg-white text-slate-600 hover:border-sky-700 hover:text-sky-700"}`;
const ov = tab === "visao_geral" ? overview(rows, now) : null;
const fin = tab === "financeiro" ? financial(rows) : null;
---

<AdminLayout title="Métricas">
  <h1 class="text-2xl font-bold text-slate-900">Métricas</h1>
  {scope === "own_agenda" && <p class="mt-1 text-sm text-slate-600">Só da sua agenda.</p>}

  {
    !tab ? (
      <Card class="mt-4 text-sm text-slate-600">Nenhuma aba de métricas liberada para a clínica. Fale com o suporte.</Card>
    ) : (
      <>
        <TabBar label="Abas de Métricas" class="mt-4" tabs={visible.map((t) => ({ label: t.label, href: link({ tab: t.id }), active: t.id === tab }))} />

        <div class="mt-4 flex flex-col gap-3">
          {usesPeriod && (
            <div class="flex flex-wrap items-center gap-2">
              {PERIOD_PRESETS.map((p) => (
                <a href={link({ periodo: p.id === "hoje" ? "" : p.id, de: "", ate: "" })} class={chip(period.preset === p.id)}>
                  {p.label}
                </a>
              ))}
              <details class="group" open={period.preset === "personalizado" || period.invalid}>
                <summary class={`cursor-pointer list-none ${chip(period.preset === "personalizado")}`}>Personalizado</summary>
                <form method="GET" action="/admin/metricas" class="mt-2 flex flex-wrap items-end gap-2">
                  {Object.entries({ ...keep, periodo: "personalizado", de: "", ate: "" }).map(([name, value]) => value && <input type="hidden" name={name} value={value} />)}
                  <label class="flex flex-col gap-1 text-xs text-slate-600">
                    De
                    <input type="date" name="de" required value={period.from} class="rounded-md border border-slate-300 px-2 py-1.5 text-sm" />
                  </label>
                  <label class="flex flex-col gap-1 text-xs text-slate-600">
                    Até
                    <input type="date" name="ate" required value={period.to} class="rounded-md border border-slate-300 px-2 py-1.5 text-sm" />
                  </label>
                  <button type="submit" class={SECONDARY_BUTTON}>Ver</button>
                </form>
              </details>
              <span class="text-sm font-medium text-slate-700">{period.label}</span>
              {period.invalid && <span class="text-xs text-red-700">Período inválido (até 366 dias): mostrando hoje.</span>}
            </div>
          )}

          <div class="flex flex-wrap items-center gap-2">
            {selectable.length > 1 && !botTab && (
              <form method="GET" action="/admin/metricas">
                {Object.entries({ ...keep, agenda: "" }).map(([name, value]) => value && <input type="hidden" name={name} value={value} />)}
                <select name="agenda" class={`${INPUT} mt-0 sm:w-64`} onchange="this.form.submit()">
                  <option value="">Todas as agendas</option>
                  {selectable.map((a) => (
                    <option value={a.id} selected={a.id === selectedAgenda?.id}>
                      {a.name}
                    </option>
                  ))}
                </select>
              </form>
            )}
            {usesPeriod &&
              (filterPatient || filterContact ? (
                <span class="flex items-center gap-2 text-sm">
                  <Badge variant="info">
                    {filterPatient ? filterPatient.fullName : `${capitalize(vocabulary.contact)}: ${filterContact!.fullName}`}
                  </Badge>
                  <a href={link({ paciente: "", responsavel: "" })} class="text-sky-700 hover:underline">
                    Tirar filtro
                  </a>
                </span>
              ) : (
                <form method="GET" action="/admin/metricas" class="flex items-center gap-2">
                  {Object.entries(keep).map(([name, value]) => value && <input type="hidden" name={name} value={value} />)}
                  <input name="busca" value={busca} placeholder={`Filtrar por ${vocabulary.patient} ou ${vocabulary.contact}`} class={`${INPUT} mt-0 sm:w-72`} />
                  <button type="submit" class={SECONDARY_BUTTON}>Buscar</button>
                </form>
              ))}
          </div>
          {busca && !filterPatient && !filterContact && (
            <Card>
              <ul class="divide-y divide-slate-100 text-sm">
                {foundPatients.map((p) => (
                  <li>
                    <a href={link({ paciente: p.id, busca: "" })} class="block py-1.5 hover:text-sky-700">
                      {p.fullName} <span class="text-slate-500">({vocabulary.patient})</span>
                    </a>
                  </li>
                ))}
                {foundContacts.map((c) => (
                  <li>
                    <a href={link({ responsavel: c.id, busca: "" })} class="block py-1.5 hover:text-sky-700">
                      {c.fullName} <span class="text-slate-500">({vocabulary.contact} · {formatPhoneBR(c.phone)})</span>
                    </a>
                  </li>
                ))}
                {foundPatients.length + foundContacts.length === 0 && <li class="py-1.5 text-slate-500">Ninguém encontrado.</li>}
              </ul>
            </Card>
          )}
        </div>

        {ov && (
          <>
            <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
              <Stat label="Atendimentos" value={ov.total} hint="sem os cancelados" />
              <Stat label="Compareceram" value={ov.completed} />
              <Stat label="Faltaram" value={ov.noShow} hint={`${pct(ov.noShowRate)} dos registrados`} />
              <Stat label="Cancelados" value={ov.canceled} />
              <Stat label="A registrar" value={ov.pending} hint="já passaram, sem registro" />
              <Stat label="Por vir" value={ov.upcoming} />
            </div>
            <h2 class="mt-6 text-base font-semibold text-slate-900">Marcados por</h2>
            <Table
              headers={["Origem", "Atendimentos"]}
              rows={[
                ["WhatsApp (bot)", ov.byChannel.whatsapp],
                ["Painel (equipe)", ov.byChannel.panel],
                ["Link de agendamento", ov.byChannel.link],
              ]}
            />
          </>
        )}

        {funnel && tab === "funil" && (
          <>
            <p class="mt-4 text-sm text-slate-500">
              Tentativas iniciadas no período, da clínica toda. Cada barra é proporcional a quem iniciou; a porcentagem é a conversão em relação à etapa
              anterior. Sem resposta há mais de 30 minutos conta como abandono na última etapa alcançada.
            </p>
            <div class="mt-3 grid gap-4 lg:grid-cols-2">
              {funnel.flows.map((flow) => {
                const first = flow.stages[0]?.count ?? 0;
                return (
                  <Card>
                    <h3 class="font-semibold text-slate-900">{flow.label}</h3>
                    {first === 0 ? (
                      <p class="mt-3 text-sm text-slate-500">Nenhuma tentativa no período.</p>
                    ) : (
                      <>
                        <div class="mt-3 space-y-2">
                          {flow.stages.map((stage) => (
                            <div class="grid grid-cols-[8.5rem_1fr_4.5rem] items-center gap-2 text-xs sm:text-sm">
                              <span class="truncate text-slate-600">{stage.label}</span>
                              <div class="h-5 rounded bg-slate-100">
                                <div class="h-5 rounded bg-sky-500" style={`width: ${Math.max((stage.count / first) * 100, stage.count > 0 ? 2 : 0)}%`} />
                              </div>
                              <span class="text-right tabular-nums text-slate-900">
                                <span class="font-semibold">{stage.count}</span>
                                {stage.conversion !== null && <span class="ml-1 text-slate-500">{pct(stage.conversion)}</span>}
                              </span>
                            </div>
                          ))}
                        </div>
                        <div class="mt-4 flex flex-wrap gap-1.5">
                          <Badge variant="success">Concluídas: {flow.outcomes.concluded}</Badge>
                          <Badge variant="warning">Abandonaram: {flow.outcomes.abandoned}</Badge>
                          {flow.outcomes.blocked > 0 && <Badge variant="neutral">Barradas: {flow.outcomes.blocked}</Badge>}
                          {flow.outcomes.declined > 0 && <Badge variant="neutral">Desistiram: {flow.outcomes.declined}</Badge>}
                          {flow.outcomes.error > 0 && <Badge variant="danger">Erro: {flow.outcomes.error}</Badge>}
                          {flow.outcomes.in_progress > 0 && <Badge variant="info">Em andamento: {flow.outcomes.in_progress}</Badge>}
                        </div>
                        {flow.notes.length > 0 && (
                          <ul class="mt-3 space-y-0.5 text-xs text-slate-600">
                            {flow.notes.map((note) => (
                              <li>
                                {note.label}: <span class="font-semibold">{note.count}</span>
                              </li>
                            ))}
                          </ul>
                        )}
                        {flow.blockedReasons.length > 0 && (
                          <ul class="mt-3 space-y-0.5 text-xs text-slate-500">
                            {flow.blockedReasons.map((reason) => (
                              <li>
                                Barradas: {reason.label}: {reason.count}
                              </li>
                            ))}
                          </ul>
                        )}
                      </>
                    )}
                  </Card>
                );
              })}
              <Card>
                <h3 class="font-semibold text-slate-900">Atendimento humano</h3>
                <dl class="mt-3 space-y-2 text-sm">
                  <div class="flex items-baseline justify-between gap-3">
                    <dt class="text-slate-600">Pediram a recepção pelo menu</dt>
                    <dd class="font-semibold tabular-nums text-slate-900">{funnel.handoffRequests}</dd>
                  </div>
                  <div class="flex items-baseline justify-between gap-3">
                    <dt class="text-slate-600">
                      Recepção assumiu pelo app
                      {funnel.agentTookOver.total > 0 && (
                        <span class="block text-xs text-slate-500">{funnel.agentTookOver.midJourney} no meio de uma marcação, remarcação ou cancelamento</span>
                      )}
                    </dt>
                    <dd class="font-semibold tabular-nums text-slate-900">{funnel.agentTookOver.total}</dd>
                  </div>
                </dl>
              </Card>
            </div>
          </>
        )}

        {funnel && tab === "retomar" && (
          <>
            <p class="mt-4 text-sm text-slate-500">
              Quem começou pelo WhatsApp e não concluiu no período (abandono ou erro), para retomar o contato. Sai da lista quem concluiu o mesmo fluxo
              depois.{funnel.incomplete.length > RECALL_LIMIT && ` Mostrando os ${RECALL_LIMIT} mais recentes.`}
            </p>
            {recall.length === 0 ? (
              <p class="mt-3 text-sm text-slate-500">Ninguém nessa situação no período.</p>
            ) : (
              <div class="mt-3 grid gap-3 sm:grid-cols-2">
                {recall.map((row) => (
                  <Card>
                    <div class="flex items-start justify-between gap-2">
                      <div>
                        <p class="font-medium text-slate-900">{(row.contactId && recallContacts.get(row.contactId)) || `${capitalize(vocabulary.contact)} sem cadastro`}</p>
                        <PhoneLinks phone={row.phone} class="text-sm" />
                      </div>
                      <Badge variant="info">{row.flowLabel}</Badge>
                    </div>
                    <p class="mt-2 text-sm text-slate-600">
                      Última etapa: <span class="font-medium text-slate-800">{row.lastStage}</span>
                    </p>
                    <p class="text-sm text-slate-600">{row.detail}</p>
                    <p class="mt-1 text-xs text-slate-400">Iniciou em {formatInstant(row.startedAt, clinic.timezone, "dd/MM/yyyy 'às' HH:mm")}</p>
                  </Card>
                ))}
              </div>
            )}
          </>
        )}

        {tab === "atendimentos" && (
          <>
            <h2 class="mt-6 text-base font-semibold text-slate-900">Volume por serviço e local</h2>
            <Table headers={["Serviço · local", "Atendimentos"]} rows={volumeByService(rows).map((r) => [r.label, r.count])} />
            <h2 class="mt-6 text-base font-semibold text-slate-900">Não comparecimento</h2>
            <p class="text-xs text-slate-500">Só entre os já registrados (compareceu ou faltou).</p>
            <Table headers={["Tipo", "Compareceu", "Faltou", "Faltas"]} rows={noShowByCategory(rows).map((r) => [r.label, r.completed, r.noShow, pct(r.rate)])} boldLast />
            <h2 class="mt-6 text-base font-semibold text-slate-900">Por origem</h2>
            <Table headers={["Origem", "Marcados", "Cancelados"]} rows={byOrigin(rows).map((r) => [r.label, r.booked, r.canceled])} />
          </>
        )}

        {tab === "faltosos" && (
          <>
            <p class="mt-4 text-sm text-slate-600">2 ou mais faltas e em pelo menos metade dos atendimentos registrados, em todo o histórico. Mais faltas primeiro.</p>
            <Table
              headers={[capitalize(vocabulary.patient), "Faltas", "Registrados", "Última falta"]}
              rows={frequent.map((f) => [
                `${f.patientName}${f.isContactSelf ? "" : ` (${f.contactName})`} · ${formatPhoneBR(f.contactPhone)}`,
                f.noShows,
                f.total,
                formatInstant(f.lastNoShow, clinic.timezone, "dd/MM/yyyy"),
              ])}
              empty="Nenhum paciente com faltas frequentes."
            />
          </>
        )}

        {fin && (
          <>
            <p class="mt-4 text-sm text-slate-600">Valor da tabela gravado na marcação (não é o valor recebido). Retorno fica fora.</p>
            <Table
              headers={["Serviço · local", "Realizado", "Previsto", "Faltas"]}
              rows={[...fin.rows, fin.total].map((r) => [
                r.label,
                `${r.done.count} · ${money(r.done.cents)}`,
                `${r.expected.count} · ${money(r.expected.cents)}`,
                `${r.lost.count} · ${money(r.lost.cents)}`,
              ])}
              boldLast={fin.rows.length > 0}
            />
          </>
        )}
      </>
    )
  }
</AdminLayout>

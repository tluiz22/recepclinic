---
// Métricas (F4.9), no banco novo: período (abre em Hoje), seletor de agenda
// para o Administrador (cliente, 05/out/2026; o Profissional vê só as
// próprias, D11), filtro por paciente ou responsável e uma aba por item da
// matriz: Visão geral, Atendimentos, Faltosos e Financeiro; Funil do bot e
// Retomar contato (F6.7, como no piloto; a clínica toda, sem o seletor de
// agenda, porque os passos do bot não guardam a agenda). Envios foi para o
// Resumo do Dia (F4.8). R7 (cliente, 16/out/2026): abas sublinhadas na ordem
// Visão geral, Atendimentos, Funil do bot, Faltosos, Retomar contato e
// Financeiro; filtros numa barra (recolhível no celular); indicador e tabela
// únicos; "Marcados por" com Parte e Total; Faltosos e Retomar contato com o
// nome que abre a ficha (ou o contato) e o botão do WhatsApp.
//
// Redesign das Métricas (cliente, 22/out/2026; proposta e 10 decisões no
// plano): abas Desempenho (junta Visão geral e Atendimentos), Agendamento
// digital (o Funil do bot), Retomar contato (com a quantidade), Faltosos e
// Financeiro; abre em "Este mês", com a comparação contra o mesmo período do
// mês anterior ligada; filtros de serviço e local no Desempenho; o filtro por
// paciente ou responsável sai das abas de indicadores e fica nas listas
// (Retomar contato) e no Financeiro, que está fora do redesign.
import AdminLayout from "../../layouts/AdminLayout.astro";
import Icon from "../../components/admin/Icon.astro";
import PhoneLinks from "../../components/admin/PhoneLinks.astro";
import Button from "../../components/admin/ui/Button.astro";
import DataTable from "../../components/admin/ui/DataTable.astro";
import PageHeader from "../../components/admin/ui/PageHeader.astro";
import Pill from "../../components/admin/ui/Pill.astro";
import SegmentedControl from "../../components/admin/ui/SegmentedControl.astro";
import Tabs from "../../components/admin/ui/Tabs.astro";
import { CONTROL, TABLE } from "../../components/admin/ui/styles";
import { isUuid } from "../../lib/clinicAccess";
import { dayBounds, formatCalendarDate, formatInstant, todayIn } from "../../lib/clinicTime";
import { createUserClient } from "../../lib/data/clients";
import { listAgendas } from "../../lib/data/config/agendas";
import { financial, listFinancialTotals, listFrequentNoShows, ownAgendaIds } from "../../lib/data/metrics";
import { listLocations } from "../../lib/data/config/locations";
import { listServices } from "../../lib/data/config/services";
import PerformanceTab from "../../components/admin/metricas/PerformanceTab.astro";
import { defaultGrouping } from "../../lib/metricsRules";
import { getContact, getPatient, listContactPatients, searchContacts, searchPatients } from "../../lib/data/patients";
import { metricsScope, type FeatureKey } from "../../lib/features";
import { buildFunnelReportFromSessions, DIGITAL_OPERATIONS, listFunnelSessions, type DigitalOperation, type DigitalOrigin, type FunnelSession } from "../../lib/data/botFunnel";
import DigitalTab from "../../components/admin/metricas/DigitalTab.astro";
import { logError } from "../../lib/log";
import { INVALID_PERIOD_MESSAGES, PERIOD_PRESETS, parsePeriod } from "../../lib/metricsPeriod";
import { formatCentsBRL } from "../../lib/money";
import { formatPhoneBR } from "../../lib/phone";
import { currentPath, withReturn } from "../../lib/returnPath";
import { capitalize, vocabularyFor } from "../../lib/vocabulary";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const vocabulary = vocabularyFor(clinic.clinicProfile);
const params = Astro.url.searchParams;
const now = new Date();

const TABS: { id: string; label: string; feature: FeatureKey }[] = [
  { id: "desempenho", label: "Desempenho", feature: "metrics_performance" },
  { id: "digital", label: "Agendamento digital", feature: "metrics_funnel" },
  { id: "retomar_contato", label: "Retomar contato", feature: "metrics_recall" },
  { id: "faltosos", label: "Faltosos", feature: "metrics_no_shows" },
  { id: "financeiro", label: "Financeiro", feature: "metrics_financial" },
];
// Agendamento digital e Retomar contato são da clínica toda: o Profissional (só a própria agenda) não vê.
const BOT_TABS = ["digital", "retomar_contato"];
const visible = TABS.filter((t) => clinic.features.includes(t.feature) && (!BOT_TABS.includes(t.id) || metricsScope(clinic) === "clinic"));
const tab = visible.find((t) => t.id === params.get("tab"))?.id ?? visible[0]?.id ?? null;

// Escopo: a clínica toda (Administrador, com o seletor) ou só as agendas do próprio Profissional.
const scope = metricsScope(clinic);
const agendas = await listAgendas(db, clinic.clinicId, { includeInactive: true });
const own = scope === "own_agenda" ? await ownAgendaIds(db, clinic.clinicId, clinic.userId) : null;
const selectable = own ? agendas.filter((a) => own.includes(a.id)) : agendas;
const agendaParam = params.get("agenda");
const selectedAgenda = selectable.find((a) => a.id === agendaParam) ?? null;
const agendaIds = selectedAgenda ? [selectedAgenda.id] : selectable.map((a) => a.id);

// Filtro por paciente ou responsável: só em Retomar contato e no Financeiro (decisão 7).
const personFilterTabs = ["retomar_contato", "financeiro"];
const allowsPersonFilter = !!tab && personFilterTabs.includes(tab);
const patientParam = params.get("paciente");
const contactParam = params.get("responsavel");
const filterPatient = allowsPersonFilter && isUuid(patientParam) ? await getPatient(db, clinic.clinicId, patientParam).catch(() => null) : null;
const filterContact = allowsPersonFilter && !filterPatient && isUuid(contactParam) ? await getContact(db, clinic.clinicId, contactParam).catch(() => null) : null;
const patientIds = filterPatient
  ? [filterPatient.id]
  : filterContact
    ? (await listContactPatients(db, clinic.clinicId, filterContact.id, { includeInactive: true })).map((p) => p.id)
    : null;
const busca = (params.get("busca") ?? "").trim();
const [foundPatients, foundContacts] =
  allowsPersonFilter && busca && !filterPatient && !filterContact ? await Promise.all([searchPatients(db, clinic.clinicId, busca), searchContacts(db, clinic.clinicId, busca)]) : [[], []];

const period = parsePeriod(params, clinic.timezone, now, "mes");
const today = todayIn(clinic.timezone, now);
// Indicadores até hoje: "Este mês" mostra 1 a hoje e compara com os mesmos dias do mês anterior.
const indicatorRange = { from: period.from, to: period.to > today && period.from <= today ? today : period.to };
const compare = params.get("comparar") !== "0";
const grouping = params.get("agrupar") === "dia" ? "day" : params.get("agrupar") === "semana" ? "week" : defaultGrouping(indicatorRange);
const sortByNoShow = params.get("ordem") === "faltas";

// Serviço e local (Desempenho).
const performanceTab = tab === "desempenho";
const [services, locations] = performanceTab
  ? await Promise.all([listServices(db, clinic.clinicId, { includeInactive: true }), listLocations(db, clinic.clinicId, { includeInactive: true })])
  : [[], []];
const selectedService = services.find((s) => s.id === params.get("servico")) ?? null;
const selectedLocation = locations.find((l) => l.id === params.get("local")) ?? null;
const usesPeriod = tab !== "faltosos";
const botTab = !!tab && BOT_TABS.includes(tab);
const filterPhone = filterPatient
  ? (await getContact(db, clinic.clinicId, filterPatient.contactId).catch(() => null))?.phone ?? null
  : (filterContact?.phone ?? null);
// Tentativas do bot no período (até hoje), lidas uma vez: Agendamento digital, Retomar contato e a quantidade na aba.
const botVisible = visible.some((t) => BOT_TABS.includes(t.id));
let botSessions: FunnelSession[] | null = null;
if (botVisible) {
  try {
    botSessions = await listFunnelSessions(db, clinic.clinicId, dayBounds(indicatorRange.from, clinic.timezone).start, dayBounds(indicatorRange.to, clinic.timezone).end);
  } catch (error) {
    logError("métricas: tentativas do bot não carregaram", error, { clinica: clinic.clinicId });
  }
}
const recallVisible = visible.some((t) => t.id === "retomar_contato");
const recallCount = botSessions && recallVisible ? buildFunnelReportFromSessions(botSessions, now).incomplete.length : 0;
const funnel =
  botTab && botSessions ? buildFunnelReportFromSessions(filterPhone ? botSessions.filter((s) => s.phone === filterPhone) : botSessions, now) : null;
const operation: DigitalOperation = DIGITAL_OPERATIONS.find((o) => o.id === params.get("operacao"))?.id ?? "marcar";
const originParam = params.get("origem");
const digitalOrigin: DigitalOrigin = originParam === "menu" || originParam === "lembrete" ? originParam : "todas";
const RECALL_LIMIT = 50;
const recall = tab === "retomar_contato" && funnel ? funnel.incomplete.slice(0, RECALL_LIMIT) : [];
const recallContacts =
  recall.length > 0
    ? new Map(
        (
          (await db
            .from("contacts")
            .select("id, full_name")
            .eq("clinic_id", clinic.clinicId)
            .in("id", [...new Set(recall.map((r) => r.contactId).filter((id): id is string => !!id))])).data ?? []
        ).map((c) => [c.id, c.full_name]),
      )
    : new Map<string, string>();
const financialTotals = tab === "financeiro" ? await listFinancialTotals(db, clinic.clinicId, { start: period.start, end: period.end, agendaIds, patientIds }) : [];
const frequent = tab === "faltosos" ? await listFrequentNoShows(db, clinic.clinicId, agendaIds) : [];

const keep = {
  tab: tab ?? "",
  periodo: period.preset === "mes" ? "" : period.preset,
  de: period.preset === "personalizado" ? period.from : "",
  ate: period.preset === "personalizado" ? period.to : "",
  agenda: selectedAgenda?.id ?? "",
  servico: selectedService?.id ?? "",
  local: selectedLocation?.id ?? "",
  comparar: compare ? "" : "0",
  agrupar: params.get("agrupar") ?? "",
  ordem: sortByNoShow ? "faltas" : "",
  operacao: operation === "marcar" ? "" : operation,
  origem: digitalOrigin === "todas" ? "" : digitalOrigin,
  paciente: filterPatient?.id ?? "",
  responsavel: filterContact?.id ?? "",
};
const link = (changes: Partial<Record<keyof typeof keep | "busca", string>>) => {
  const next = new URLSearchParams();
  for (const [key, value] of Object.entries({ ...keep, ...changes })) if (value) next.set(key, value);
  return `/admin/metricas?${next}`;
};
const periodTitle = indicatorRange.from === period.from && indicatorRange.to === period.to ? period.label : `${formatCalendarDate(indicatorRange.from, "d")} a ${formatCalendarDate(indicatorRange.to, "d 'de' MMMM")}`;
const money = (cents: number) => formatCentsBRL(cents);
const here = currentPath(Astro.url);
const hasAgendaPicker = selectable.length > 1 && !botTab;
const filtered = !!(filterPatient || filterContact);
const showCustom = period.preset === "personalizado" || period.invalid;
// Período inválido (R7, QA-04): marca o campo a corrigir (os dois quando um depende do outro).
const badFrom = period.invalidReason === "missing" ? !period.requested?.from : period.invalidReason !== null;
const badTo = period.invalidReason === "missing" ? !period.requested?.to : period.invalidReason !== null;
const scopeText = scope === "own_agenda" ? "só da sua agenda" : botTab ? "a clínica toda" : (selectedAgenda?.name ?? "todas as agendas");
const extraFilters = performanceTab ? [selectedService?.name, selectedLocation?.name].filter(Boolean).join(" · ") : "";
const subtitle = tab
  ? `${!usesPeriod ? "Todo o histórico" : performanceTab || tab === "digital" ? periodTitle : period.label} · ${scopeText}${extraFilters ? ` · ${extraFilters}` : ""}`
  : undefined;
const filterSummary = [
  usesPeriod ? (PERIOD_PRESETS.find((p) => p.id === period.preset)?.label ?? "Personalizado") : null,
  hasAgendaPicker ? (selectedAgenda?.name ?? "todas as agendas") : null,
  selectedService?.name ?? null,
  selectedLocation?.name ?? null,
  filtered ? "com filtro" : null,
]
  .filter(Boolean)
  .join(" · ");
const sectionTitle = "font-display text-[17px] leading-tight font-bold text-ink sm:text-lg";
const card = "flex flex-col gap-3 rounded-xl border border-line bg-white p-3.5 sm:px-5 sm:py-[18px]";
const label = "text-[13.5px] font-semibold text-ink-soft";
const intro = "text-sm leading-relaxed text-ink-soft";
const hidden = (values: Record<string, string>) => Object.entries(values).filter(([, value]) => value);
// Retornos só fazem sentido sem filtro de serviço ou com Consulta/Retorno escolhido.
const returnsApply = !selectedService || selectedService.category === "consultation" || selectedService.category === "return_visit";
const hasFilters = !!(selectedAgenda || selectedService || selectedLocation);
const performanceLinks = {
  grouping: (g: "day" | "week") => link({ agrupar: g === "day" ? "dia" : "semana" }),
  sort: (byNoShow: boolean) => `${link({ ordem: byNoShow ? "faltas" : "" })}#por-servico`,
  clearFilters: hasFilters ? link({ agenda: "", servico: "", local: "" }) : null,
  wholeMonth: link({ periodo: "", de: "", ate: "" }),
  retry: link({}),
};
const fin = tab === "financeiro" ? financial(financialTotals) : null;
---

<AdminLayout title="Métricas">
  <PageHeader title="Métricas" subtitle={subtitle} />

  {
    !tab ? (
      <p class={`${card} mt-4 text-[15px] text-ink-soft`}>Nenhuma aba de métricas liberada para a clínica. Fale com o suporte.</p>
    ) : (
      <>
        <Tabs label="Abas de Métricas" class="mt-4" tabs={visible.map((t) => ({
            label: t.label,
            href: link({ tab: t.id }),
            active: t.id === tab,
            ...(t.id === "retomar_contato" && recallCount > 0 ? { count: recallCount, countTone: "warning" as const, countLabel: `${recallCount} para retomar` } : {}),
          }))} />

        <details data-metric-filters data-keep-open={showCustom || busca ? "" : undefined} open class="mt-4 rounded-xl border border-line bg-white">
          <summary class="flex min-h-[52px] cursor-pointer list-none items-center justify-between gap-3 px-3.5 font-display text-base font-bold text-ink sm:hidden">
            Filtros
            <span class="font-sans text-sm font-medium text-ink-soft">{filterSummary} ›</span>
          </summary>
          <div class="flex flex-col gap-3 px-3.5 pb-3.5 sm:p-4">
            <div class="flex flex-col gap-3.5 sm:flex-row sm:flex-wrap sm:items-end sm:gap-x-5">
              {usesPeriod && (
                <div class="flex min-w-0 flex-col gap-1.5">
                  <span class={label} aria-hidden="true">Período</span>
                  <div>
                    <SegmentedControl
                      label="Período"
                      class="!inline-flex flex-wrap [&>a]:grow sm:[&>a]:grow-0"
                      current={showCustom ? "personalizado" : period.preset}
                      items={[
                        ...PERIOD_PRESETS.map((p) => ({ id: p.id, label: p.label, href: link({ periodo: p.id === "mes" ? "" : p.id, de: "", ate: "" }) })),
                        { id: "personalizado", label: "Personalizado", href: link({ periodo: "personalizado", de: period.from, ate: period.to }) },
                      ]}
                    />
                  </div>
                </div>
              )}
              {hasAgendaPicker && (
                <form method="GET" action="/admin/metricas" class="flex flex-col gap-1.5">
                  {hidden({ ...keep, agenda: "" }).map(([name, value]) => <input type="hidden" name={name} value={value} />)}
                  <label for="metricas-agenda" class={label}>Agenda</label>
                  <select id="metricas-agenda" name="agenda" class={`${CONTROL} w-full sm:w-60`} data-autosubmit>
                    <option value="">Todas as agendas</option>
                    {selectable.map((a) => (
                      <option value={a.id} selected={a.id === selectedAgenda?.id}>
                        {a.name}
                      </option>
                    ))}
                  </select>
                </form>
              )}
              {performanceTab && (
                <form method="GET" action="/admin/metricas" class="flex flex-col gap-1.5">
                  {hidden({ ...keep, servico: "" }).map(([name, value]) => <input type="hidden" name={name} value={value} />)}
                  <label for="metricas-servico" class={label}>Serviço</label>
                  <select id="metricas-servico" name="servico" class={`${CONTROL} w-full sm:w-52`} data-autosubmit>
                    <option value="">Todos os serviços</option>
                    {services.map((sv) => (
                      <option value={sv.id} selected={sv.id === selectedService?.id}>
                        {sv.name}{sv.isActive ? "" : " (desativado)"}
                      </option>
                    ))}
                  </select>
                </form>
              )}
              {performanceTab && locations.length > 1 && (
                <form method="GET" action="/admin/metricas" class="flex flex-col gap-1.5">
                  {hidden({ ...keep, local: "" }).map(([name, value]) => <input type="hidden" name={name} value={value} />)}
                  <label for="metricas-local" class={label}>Local</label>
                  <select id="metricas-local" name="local" class={`${CONTROL} w-full sm:w-48`} data-autosubmit>
                    <option value="">Todos os locais</option>
                    {locations.map((l) => (
                      <option value={l.id} selected={l.id === selectedLocation?.id}>
                        {l.name}{l.isActive ? "" : " (desativado)"}
                      </option>
                    ))}
                  </select>
                </form>
              )}
              {tab === "digital" && (
                <form method="GET" action="/admin/metricas" class="flex flex-col gap-1.5">
                  {hidden({ ...keep, operacao: "" }).map(([name, value]) => <input type="hidden" name={name} value={value} />)}
                  <label for="metricas-operacao" class={label}>Operação</label>
                  <select id="metricas-operacao" name="operacao" class={`${CONTROL} w-full sm:w-64`} data-autosubmit>
                    {DIGITAL_OPERATIONS.map((o) => (
                      <option value={o.id === "marcar" ? "" : o.id} selected={o.id === operation}>
                        {o.label}
                      </option>
                    ))}
                  </select>
                </form>
              )}
              {tab === "digital" && (
                <form method="GET" action="/admin/metricas" class="flex flex-col gap-1.5">
                  {hidden({ ...keep, origem: "" }).map(([name, value]) => <input type="hidden" name={name} value={value} />)}
                  <label for="metricas-origem" class={label}>Origem</label>
                  <select id="metricas-origem" name="origem" class={`${CONTROL} w-full sm:w-48`} data-autosubmit>
                    <option value="">Menu e lembrete</option>
                    <option value="menu" selected={digitalOrigin === "menu"}>Só pelo menu</option>
                    <option value="lembrete" selected={digitalOrigin === "lembrete"}>Só pelo lembrete</option>
                  </select>
                </form>
              )}
              {(performanceTab || tab === "digital") && (
                <a
                  href={link({ comparar: compare ? "0" : "" })}
                  role="switch"
                  aria-checked={compare ? "true" : "false"}
                  class="inline-flex min-h-11 items-center gap-2 self-start text-sm font-semibold text-ink-mid no-underline sm:self-end"
                >
                  <span class:list={["flex h-5 w-5 items-center justify-center rounded border-2", compare ? "border-brand bg-brand text-white" : "border-line-strong bg-white"]} aria-hidden="true">
                    {compare && <Icon name="check" class="h-3.5 w-3.5" strokeWidth={3} />}
                  </span>
                  Comparar com o mês anterior
                </a>
              )}
              {allowsPersonFilter && usesPeriod && !filtered && (
                <form method="GET" action="/admin/metricas" role="search" class="flex min-w-0 flex-col gap-1.5 sm:min-w-[300px] sm:flex-1">
                  {hidden(keep).map(([name, value]) => <input type="hidden" name={name} value={value} />)}
                  <label for="metricas-busca" class={label}>Filtrar por {vocabulary.patient} ou {vocabulary.contact}</label>
                  <div class="flex gap-2">
                    <input id="metricas-busca" name="busca" value={busca} placeholder="Nome, telefone ou nascimento" class={`${CONTROL} min-w-0 flex-1`} />
                    <Button type="submit">Buscar</Button>
                  </div>
                </form>
              )}
            </div>
            {usesPeriod && showCustom && (
              <form method="GET" action="/admin/metricas" class="flex flex-wrap items-end gap-2.5 border-t border-[#e6ecea] pt-3">
                {hidden({ ...keep, periodo: "personalizado", de: "", ate: "" }).map(([name, value]) => <input type="hidden" name={name} value={value} />)}
                <label class="flex flex-col gap-1.5">
                  <span class={label}>De</span>
                  <input
                    type="date"
                    name="de"
                    required
                    value={period.requested?.from ?? period.from}
                    class={CONTROL}
                    aria-invalid={badFrom ? "true" : undefined}
                    aria-describedby={badFrom ? "periodo-erro" : undefined}
                  />
                </label>
                <label class="flex flex-col gap-1.5">
                  <span class={label}>Até</span>
                  <input
                    type="date"
                    name="ate"
                    required
                    value={period.requested?.to ?? period.to}
                    class={CONTROL}
                    aria-invalid={badTo ? "true" : undefined}
                    aria-describedby={badTo ? "periodo-erro" : undefined}
                  />
                </label>
                <Button type="submit">Ver</Button>
                {period.invalidReason && (
                  <p id="periodo-erro" class="basis-full text-sm font-semibold text-danger" role="alert" data-period-error>
                    {INVALID_PERIOD_MESSAGES[period.invalidReason]} Os números mostram hoje.
                  </p>
                )}
              </form>
            )}
          </div>
        </details>

        {usesPeriod && filtered && (
          <div class="mt-3 flex flex-wrap items-center gap-2.5 text-[15px]">
            <span class="font-semibold text-ink-soft">Com filtro:</span>
            <span class="inline-flex items-center gap-1 rounded-full bg-brand-soft py-0.5 pr-1 pl-3 font-semibold text-brand-ink">
              {filterPatient ? filterPatient.fullName : `${capitalize(vocabulary.contact)}: ${filterContact!.fullName}`}
              <a href={link({ paciente: "", responsavel: "" })} aria-label="Tirar o filtro" class="inline-flex h-8 w-8 items-center justify-center rounded-full text-brand-ink hover:bg-white/70">
                <Icon name="x-mark" class="h-4 w-4" strokeWidth={2.4} />
              </a>
            </span>
          </div>
        )}
        {busca && !filtered && (
          <section aria-label="Resultado da busca" class={`${card} mt-3 gap-0 py-1 sm:py-1`}>
            <ul>
              {foundPatients.map((p) => (
                <li class="border-t border-[#e6ecea] first:border-t-0">
                  <a href={link({ paciente: p.id, busca: "" })} class="flex min-h-11 items-center gap-1.5 py-1.5 font-semibold text-ink no-underline hover:text-brand">
                    {p.fullName} <span class="font-normal text-ink-soft">({vocabulary.patient})</span>
                  </a>
                </li>
              ))}
              {foundContacts.map((c) => (
                <li class="border-t border-[#e6ecea] first:border-t-0">
                  <a href={link({ responsavel: c.id, busca: "" })} class="flex min-h-11 items-center gap-1.5 py-1.5 font-semibold text-ink no-underline hover:text-brand">
                    {c.fullName} <span class="font-normal text-ink-soft">({vocabulary.contact} · {formatPhoneBR(c.phone)})</span>
                  </a>
                </li>
              ))}
              {foundPatients.length + foundContacts.length === 0 && <li class="py-2.5 text-ink-soft">Ninguém encontrado.</li>}
            </ul>
          </section>
        )}

        {performanceTab && (
          <PerformanceTab
            db={db}
            clinic={clinic}
            scope={{ agendaIds, serviceIds: selectedService ? [selectedService.id] : null, locationIds: selectedLocation ? [selectedLocation.id] : null }}
            range={indicatorRange}
            compare={compare}
            grouping={grouping}
            returnsApply={returnsApply}
            sortByNoShow={sortByNoShow}
            links={performanceLinks}
            here={here}
            now={now}
          />
        )}

        {tab === "digital" && (
          <DigitalTab
            db={db}
            clinic={clinic}
            sessions={botSessions}
            range={indicatorRange}
            compare={compare}
            operation={operation}
            origin={digitalOrigin}
            recallCount={recallCount}
            links={{ recall: link({ tab: "retomar_contato", operacao: "", origem: "" }), retry: link({}) }}
            now={now}
          />
        )}

        {tab === "faltosos" && (
          <section aria-labelledby="faltosos" class="mt-5 flex flex-col gap-2">
            <h2 id="faltosos" class={sectionTitle}>Faltam com frequência</h2>
            <p class={intro}>2 ou mais faltas e em pelo menos metade dos atendimentos registrados, em todo o histórico. Mais faltas primeiro.</p>
            <div data-scroll-region="Faltam com frequência" class={TABLE.box}>
              <table class={`${TABLE.table} min-w-[560px]`}>
                <thead>
                  <tr>
                    <th scope="col" class={TABLE.th}>{capitalize(vocabulary.patient)}</th>
                    <th scope="col" class={`${TABLE.th} text-right`}>Faltas</th>
                    <th scope="col" class={`${TABLE.th} text-right`}>Registrados</th>
                    <th scope="col" class={`${TABLE.th} text-right`}>Última falta</th>
                  </tr>
                </thead>
                <tbody class="[&>tr:last-child>td]:border-b-0">
                  {frequent.map((f) => (
                    <tr>
                      <td class={TABLE.td}>
                        <a href={withReturn(`/admin/pacientes/${f.patientId}`, here)} class="text-base font-semibold text-ink no-underline hover:text-brand hover:underline">
                          {f.patientName}
                        </a>
                        <span class="mt-0.5 flex flex-wrap items-center gap-x-1.5 gap-y-1 text-sm text-ink-soft">
                          {!f.isContactSelf && <span>{f.contactName} ·</span>}
                          <PhoneLinks phone={f.contactPhone} plain />
                        </span>
                      </td>
                      <td class={`${TABLE.td} ${TABLE.num}`}>{f.noShows}</td>
                      <td class={`${TABLE.td} ${TABLE.num}`}>{f.total}</td>
                      <td class={`${TABLE.td} ${TABLE.num}`}>{formatInstant(f.lastNoShow, clinic.timezone, "dd/MM/yyyy")}</td>
                    </tr>
                  ))}
                  {frequent.length === 0 && (
                    <tr>
                      <td colspan="4" class={`${TABLE.td} text-center text-ink-soft`}>
                        Nenhum {vocabulary.patient} com faltas frequentes.
                      </td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </section>
        )}

        {funnel && tab === "retomar_contato" && (
          <>
            <p class={`${intro} mt-4 max-w-4xl`}>
              Quem começou pelo WhatsApp e não concluiu no período (abandono ou erro), para retomar o contato. Sai da lista quem concluiu o mesmo fluxo
              depois.{funnel.incomplete.length > RECALL_LIMIT && ` Mostrando os ${RECALL_LIMIT} mais recentes.`}
            </p>
            {recall.length === 0 ? (
              <p class={`${card} mt-3 text-[15px] text-ink-soft`}>Ninguém nessa situação no período.</p>
            ) : (
              <>
                <div data-scroll-region="Retomar contato" class={`${TABLE.box} mt-3 max-sm:hidden`}>
                  <table class={TABLE.table}>
                    <thead>
                      <tr>
                        <th scope="col" class={TABLE.th}>{capitalize(vocabulary.contact)}</th>
                        <th scope="col" class={TABLE.th}>Fluxo</th>
                        <th scope="col" class={TABLE.th}>Onde parou</th>
                        <th scope="col" class={`${TABLE.th} text-right`}>Iniciou em</th>
                      </tr>
                    </thead>
                    <tbody class="[&>tr:last-child>td]:border-b-0">
                      {recall.map((row) => {
                        const name = (row.contactId && recallContacts.get(row.contactId)) || `${capitalize(vocabulary.contact)} sem cadastro`;
                        return (
                          <tr>
                            <td class={TABLE.td}>
                              {row.contactId && recallContacts.has(row.contactId) ? (
                                <a href={withReturn(`/admin/pacientes/contato/${row.contactId}`, here)} class="text-base font-semibold text-ink no-underline hover:text-brand hover:underline">
                                  {name}
                                </a>
                              ) : (
                                <span class="text-base font-semibold text-ink">{name}</span>
                              )}
                              <PhoneLinks phone={row.phone} plain class="mt-0.5 flex text-sm text-ink-soft" />
                            </td>
                            <td class={TABLE.td}>
                              <Pill tone="info">{row.flowLabel}</Pill>
                            </td>
                            <td class={TABLE.td}>
                              {row.lastStage}
                              <span class={TABLE.sub}>{row.detail}</span>
                            </td>
                            <td class={`${TABLE.td} ${TABLE.num}`}>{formatInstant(row.startedAt, clinic.timezone, "dd/MM/yyyy 'às' HH:mm")}</td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
                <ul class="mt-3 flex flex-col gap-2.5 sm:hidden">
                  {recall.map((row) => {
                    const name = (row.contactId && recallContacts.get(row.contactId)) || `${capitalize(vocabulary.contact)} sem cadastro`;
                    return (
                      <li class={`${card} gap-1.5`}>
                        <div class="flex items-start justify-between gap-2">
                          {row.contactId && recallContacts.has(row.contactId) ? (
                            <a href={withReturn(`/admin/pacientes/contato/${row.contactId}`, here)} class="text-base font-semibold text-ink no-underline">
                              {name}
                            </a>
                          ) : (
                            <span class="text-base font-semibold text-ink">{name}</span>
                          )}
                          <Pill tone="info">{row.flowLabel}</Pill>
                        </div>
                        <PhoneLinks phone={row.phone} plain class="text-[15px] text-ink" />
                        <p class="text-sm text-ink-soft">
                          Onde parou: <span class="font-semibold text-ink">{row.lastStage}</span>. {row.detail}
                        </p>
                        <p class="text-[13px] text-ink-soft">Iniciou em {formatInstant(row.startedAt, clinic.timezone, "dd/MM/yyyy 'às' HH:mm")}</p>
                      </li>
                    );
                  })}
                </ul>
              </>
            )}
          </>
        )}

        {fin && (
          <section aria-labelledby="valores" class="mt-5 flex max-w-4xl flex-col gap-2">
            <h2 id="valores" class={sectionTitle}>Valores por serviço</h2>
            <p class={intro}>Valor da tabela gravado na marcação (não é o valor recebido). Retorno fica fora.</p>
            <DataTable
              label="Valores por serviço"
              headers={["Serviço · local", "Realizado", "Previsto", "Faltas"]}
              rows={[...fin.rows, fin.total].map((r) => [
                r.label,
                { main: r.done.count, sub: money(r.done.cents) },
                { main: r.expected.count, sub: money(r.expected.cents) },
                { main: r.lost.count, sub: money(r.lost.cents) },
              ])}
              total={fin.rows.length > 0}
            />
          </section>
        )}
      </>
    )
  }
  <p
    data-metrics-loading
    role="status"
    hidden
    class="fixed bottom-24 left-1/2 z-40 -translate-x-1/2 rounded-full bg-ink px-4 py-2 text-sm font-semibold text-white shadow-lg sm:bottom-6"
  >
    Calculando os números…
  </p>
</AdminLayout>

<script>
  // Carregando (redesign das Métricas, estado 1): a troca de filtro, período ou
  // aba recarrega a página; enquanto isso, o aviso diz o que está acontecendo.
  const metricsLoading = document.querySelector<HTMLElement>("[data-metrics-loading]");
  const showMetricsLoading = () => {
    if (metricsLoading) metricsLoading.hidden = false;
  };
  document.addEventListener("click", (event) => {
    const link = (event.target as Element | null)?.closest("a");
    if (!link || event.defaultPrevented || link.target) return;
    const url = new URL(link.href, location.href);
    if (url.pathname === "/admin/metricas" && url.search !== location.search) showMetricsLoading();
  });
  document.addEventListener("submit", showMetricsLoading);
  for (const select of document.querySelectorAll("select[data-autosubmit]")) select.addEventListener("change", showMetricsLoading);
  // Voltar pelo navegador com a página guardada: o aviso não fica preso.
  window.addEventListener("pageshow", () => {
    if (metricsLoading) metricsLoading.hidden = true;
  });
  // Celular: os filtros abrem recolhidos (o resumo mostra o que vale), menos
  // com o período personalizado ou uma busca na tela. Sem JavaScript, ficam abertos.
  for (const box of document.querySelectorAll<HTMLDetailsElement>("details[data-metric-filters]")) {
    if (window.matchMedia("(max-width: 639px)").matches && !box.hasAttribute("data-keep-open")) box.open = false;
  }
  // Período inválido (R7, QA-04): o foco vai para o primeiro campo a corrigir.
  if (document.querySelector("[data-period-error]")) {
    const field = document.querySelector<HTMLInputElement>('input[aria-describedby="periodo-erro"]');
    field?.scrollIntoView({ block: "center" });
    field?.focus({ preventScroll: true });
  }
</script>

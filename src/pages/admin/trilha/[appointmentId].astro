---
// Trilha de um atendimento (Fase 22 · etapa 4): fragmento de HTML buscado
// pelo Histórico só quando o card é aberto ("Ver trilha").
import { createClient } from "../../../lib/supabase/server";
import { fetchAppointmentTrail, type TrailTone } from "../../../lib/appointmentTrail";

export const partial = true;

const supabase = createClient(Astro.request, Astro.cookies);
const { appointmentId } = Astro.params;
const entries = appointmentId ? await fetchAppointmentTrail(supabase, appointmentId) : [];

// "27/09/2026 14h30", no fuso de Fortaleza.
function formatAt(iso: string): string {
  const parts = new Intl.DateTimeFormat("pt-BR", {
    timeZone: "America/Fortaleza",
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
    hour12: false,
  }).formatToParts(new Date(iso));
  const get = (type: string) => parts.find((part) => part.type === type)?.value ?? "";
  return `${get("day")}/${get("month")}/${get("year")} ${get("hour")}h${get("minute")}`;
}

const toneClass: Record<TrailTone, string> = {
  neutral: "text-slate-600",
  success: "text-emerald-700",
  danger: "font-medium text-red-700",
};
---

{
  entries.length ? (
    <ol class="flex flex-col gap-1.5">
      {entries.map((entry) => (
        <li class="flex flex-col text-sm sm:flex-row sm:gap-3">
          <span class="shrink-0 tabular-nums text-xs text-slate-400 sm:w-32 sm:text-sm">{formatAt(entry.at)}</span>
          <span class={toneClass[entry.tone]}>{entry.text}</span>
        </li>
      ))}
    </ol>
  ) : (
    <p class="text-sm text-slate-500">Nenhum registro na trilha deste atendimento.</p>
  )
}

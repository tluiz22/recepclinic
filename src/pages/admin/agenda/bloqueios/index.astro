---
// Agenda › Bloqueios (F4.6): os que ainda não terminaram, das agendas que a
// pessoa vê, com editar e remover (com confirmação).
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import Card from "../../../../components/admin/Card.astro";
import ConfirmDeleteDialog from "../../../../components/admin/ConfirmDeleteDialog.astro";
import FlashMessage from "../../../../components/admin/FlashMessage.astro";
import Icon from "../../../../components/admin/Icon.astro";
import { PRIMARY_BUTTON, SECONDARY_BUTTON } from "../../../../components/admin/fieldStyles";
import { formatInstant } from "../../../../lib/clinicTime";
import { createUserClient } from "../../../../lib/data/clients";
import { listBlocks } from "../../../../lib/data/agenda/blocks";
import { listAgendas } from "../../../../lib/data/config/agendas";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const now = new Date();
const [agendas, blocks] = await Promise.all([
  listAgendas(db, clinic.clinicId, { includeInactive: true }),
  listBlocks(db, clinic.clinicId, { from: now, to: new Date(now.getTime() + 5 * 365 * 24 * 60 * 60_000) }),
]);
const agendaName = new Map(agendas.map((a) => [a.id, a.name]));
const when = (d: Date) => formatInstant(d, clinic.timezone, "EEE dd/MM/yyyy HH:mm");
---

<AdminLayout title="Bloqueios">
  <a href="/admin/agenda" class="inline-flex items-center gap-1 text-sm font-medium text-sky-700 hover:underline">
    <Icon name="chevron-left" class="h-4 w-4" /> Agenda
  </a>
  <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold text-slate-900">Bloqueios</h1>
    <a href="/admin/agenda/bloquear" class={PRIMARY_BUTTON}>Bloquear agenda</a>
  </div>
  <FlashMessage />

  <div class="mt-4 flex max-w-2xl flex-col gap-3">
    {
      blocks.map((block) => (
        <Card>
          <p class="font-medium text-slate-900">{agendaName.get(block.agendaId) ?? "Agenda"}</p>
          <p class="text-sm capitalize text-slate-600">
            {when(block.startsAt)} – {when(block.endsAt)}
          </p>
          <p class="text-sm text-slate-600">{block.reason}</p>
          <div class="mt-3 flex flex-wrap gap-2 border-t border-slate-100 pt-3">
            <a href={`/admin/agenda/bloqueios/${block.id}`} class={SECONDARY_BUTTON}>
              Editar
            </a>
            <form method="POST" action={`/api/admin/agenda/bloqueios/${block.id}`}>
              <input type="hidden" name="acao" value="remover" />
              <input type="hidden" name="return_to" value="/admin/agenda/bloqueios" />
              <button
                type="submit"
                class={`${SECONDARY_BUTTON} js-confirm-delete text-red-700`}
                data-confirm-title="Remover o bloqueio?"
                data-confirm-message={`${agendaName.get(block.agendaId) ?? "Agenda"}: ${block.reason}. Os horários voltam a ser oferecidos.`}
                data-confirm-label="Remover"
              >
                Remover
              </button>
            </form>
          </div>
        </Card>
      ))
    }
    {blocks.length === 0 && <p class="text-sm text-slate-600">Nenhum bloqueio ativo.</p>}
  </div>
  <ConfirmDeleteDialog />
</AdminLayout>

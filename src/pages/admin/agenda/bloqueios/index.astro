---
// Agenda › Bloqueios (F4.6): os que ainda não terminaram, das agendas que a
// pessoa vê, com editar e remover (com confirmação).
import { currentPath, receivedReturn, withReturn } from "../../../../lib/returnPath";
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import ConfirmDeleteDialog from "../../../../components/admin/ConfirmDeleteDialog.astro";
import FlashMessage from "../../../../components/admin/FlashMessage.astro";
import Icon from "../../../../components/admin/Icon.astro";
import { DANGER_BUTTON, PANEL, PRIMARY_BUTTON, SECONDARY_BUTTON } from "../../../../components/admin/config/formStyles";
import EmptyState from "../../../../components/admin/ui/EmptyState.astro";
import PageHeader from "../../../../components/admin/ui/PageHeader.astro";
import { formatInstant } from "../../../../lib/clinicTime";
import { createUserClient } from "../../../../lib/data/clients";
import { listBlocks } from "../../../../lib/data/agenda/blocks";
import { listAgendas } from "../../../../lib/data/config/agendas";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const now = new Date();
// Voltar: para a tela de onde veio (cliente, 10/out/2026).
const volta = receivedReturn(Astro.url);
const here = currentPath(Astro.url);
const [agendas, blocks] = await Promise.all([
  listAgendas(db, clinic.clinicId, { includeInactive: true }),
  listBlocks(db, clinic.clinicId, { from: now, to: new Date(now.getTime() + 5 * 365 * 24 * 60 * 60_000) }),
]);
const agendaName = new Map(agendas.map((a) => [a.id, a.name]));
const when = (d: Date) => formatInstant(d, clinic.timezone, "EEE dd/MM/yyyy HH:mm");
---

<AdminLayout title="Bloqueios">
  <a href={volta ?? "/admin/agenda"} class="inline-flex min-h-8 items-center gap-1 text-[15px] font-semibold text-brand no-underline hover:underline">
    <Icon name="chevron-left" class="h-[18px] w-[18px]" strokeWidth={2.2} />
    {volta ? "Voltar" : "Agenda"}
  </a>
  <PageHeader title="Bloqueios" subtitle="Os que ainda não terminaram." class="mt-2">
    <a slot="actions" href={withReturn("/admin/agenda/bloquear", here)} class={PRIMARY_BUTTON}>Bloquear agenda</a>
  </PageHeader>
  <FlashMessage />

  <div class="mt-4 flex max-w-2xl flex-col gap-3">
    {
      blocks.map((block) => (
        <div class={PANEL}>
          <p class="text-[16.5px] leading-snug font-bold text-ink">{agendaName.get(block.agendaId) ?? "Agenda"}</p>
          <p class="mt-0.5 text-[15px] text-ink first-letter:uppercase">
            {when(block.startsAt)} – {when(block.endsAt)}
          </p>
          <p class="text-[15px] text-ink-soft">{block.reason}</p>
          <div class="mt-3 flex flex-wrap gap-2 border-t border-[#e6ecea] pt-3">
            <a href={withReturn(`/admin/agenda/bloqueios/${block.id}`, here)} class={SECONDARY_BUTTON}>
              Editar
            </a>
            <form method="POST" action={`/api/admin/agenda/bloqueios/${block.id}`}>
              <input type="hidden" name="acao" value="remover" />
              <input type="hidden" name="return_to" value={here} />
              <button
                type="submit"
                class={`${DANGER_BUTTON} js-confirm-delete`}
                data-confirm-title="Remover o bloqueio?"
                data-confirm-message={`${agendaName.get(block.agendaId) ?? "Agenda"}: ${block.reason}. Os horários voltam a ser oferecidos.`}
                data-confirm-label="Remover"
              >
                Remover
              </button>
            </form>
          </div>
        </div>
      ))
    }
    {blocks.length === 0 && <EmptyState title="Nenhum bloqueio ativo." text="Os bloqueios que ainda não terminaram aparecem aqui, com editar e remover." />}
  </div>
  <ConfirmDeleteDialog />
</AdminLayout>

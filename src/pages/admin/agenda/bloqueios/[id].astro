---
// Agenda › Bloqueios › editar (F4.6): período e motivo. A agenda não muda
// (para outra agenda, remova e bloqueie de novo). Mudar o período não
// cancela atendimentos: para isso, use Bloquear ou cancele pela Agenda.
import { receivedReturn } from "../../../../lib/returnPath";
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import ConfirmDeleteDialog from "../../../../components/admin/ConfirmDeleteDialog.astro";
import FlashMessage from "../../../../components/admin/FlashMessage.astro";
import Icon from "../../../../components/admin/Icon.astro";
import { HINT, INPUT, PANEL, PRIMARY_BUTTON } from "../../../../components/admin/config/formStyles";
import Field from "../../../../components/admin/ui/Field.astro";
import PageHeader from "../../../../components/admin/ui/PageHeader.astro";
import { localDateOf, localTimeOf } from "../../../../lib/clinicTime";
import { createUserClient } from "../../../../lib/data/clients";
import { getBlock } from "../../../../lib/data/agenda/blocks";
import { listAgendas } from "../../../../lib/data/config/agendas";
import { isUuid } from "../../../../lib/clinicAccess";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const id = Astro.params.id!;
const block = isUuid(id) ? await getBlock(db, clinic.clinicId, id) : null;
if (!block) return Astro.redirect("/admin/agenda/bloqueios");
const agendaName = (await listAgendas(db, clinic.clinicId, { includeInactive: true })).find((a) => a.id === block.agendaId)?.name ?? "Agenda";
const tz = clinic.timezone;
// Voltar (e depois de salvar ou remover): para a tela de onde veio (cliente, 10/out/2026).
const volta = receivedReturn(Astro.url);
const lastMinute = new Date(block.endsAt.getTime() - 1);
---

<AdminLayout title="Editar bloqueio">
  <a href={volta ?? "/admin/agenda/bloqueios"} class="inline-flex min-h-8 items-center gap-1 text-[15px] font-semibold text-brand no-underline hover:underline">
    <Icon name="chevron-left" class="h-[18px] w-[18px]" strokeWidth={2.2} />
    {volta ? "Voltar" : "Bloqueios"}
  </a>
  <PageHeader title="Editar bloqueio" subtitle={`Agenda: ${agendaName}`} class="mt-2" />
  <FlashMessage />

  <div class={`${PANEL} mt-4 max-w-2xl`}>
    <form method="POST" action={`/api/admin/agenda/bloqueios/${block.id}`} class="flex flex-col gap-4">
      {volta && <input type="hidden" name="return_to" value={volta} />}
      <input type="hidden" name="acao" value="salvar" />
      <div class="grid grid-cols-2 gap-3">
        <Field id="start_date" label="Início">
          <input id="start_date" name="start_date" type="date" required value={localDateOf(block.startsAt, tz)} class={INPUT} />
        </Field>
        <Field id="start_time" label="Hora">
          <input id="start_time" name="start_time" type="time" required value={localTimeOf(block.startsAt, tz)} class={INPUT} />
        </Field>
        <Field id="end_date" label="Fim">
          <input id="end_date" name="end_date" type="date" required value={localDateOf(lastMinute, tz)} class={INPUT} />
        </Field>
        <Field id="end_time" label="Hora">
          <input id="end_time" name="end_time" type="time" required value={localTimeOf(block.endsAt, tz) === "00:00" ? "23:59" : localTimeOf(block.endsAt, tz)} class={INPUT} />
        </Field>
      </div>
      <Field id="reason" label="Motivo">
        <input id="reason" name="reason" required value={block.reason} class={INPUT} />
      </Field>
      <p class={HINT}>Mudar o período não cancela atendimentos. Para cancelar os que ficarem dentro, use a Agenda.</p>
      <div class="border-t border-[#e6ecea] pt-4">
        <button
          type="submit"
          class={`${PRIMARY_BUTTON} js-confirm-delete`}
          data-confirm-title="Salvar o bloqueio?"
          data-confirm-message="O período e o motivo novos passam a valer na hora."
          data-confirm-label="Salvar"
          data-confirm-tone="primary"
        >
          Salvar
        </button>
      </div>
    </form>
  </div>
  <ConfirmDeleteDialog />
</AdminLayout>

---
// Agenda › Mês (F4.5): grade de segunda a domingo com quantos atendimentos
// cada dia tem (e se há bloqueio). Tocar no dia abre o Dia.
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AgendaHeader from "../../../components/admin/agenda/AgendaHeader.astro";
import Icon from "../../../components/admin/Icon.astro";
import Button from "../../../components/admin/ui/Button.astro";
import { addDays, formatCalendarDate, isCalendarDate, localDateOf, todayIn } from "../../../lib/clinicTime";
import { createUserClient } from "../../../lib/data/clients";
import { loadAgendaScope } from "../../../lib/data/agenda/scope";
import { listAgendaAppointments, listAgendaBlocks, monthGrid } from "../../../lib/data/agenda/view";
import { isNationalHoliday } from "../../../lib/holidays";
import { listClinicHolidays } from "../../../lib/data/config/holidays";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const today = todayIn(clinic.timezone);
const dateParam = Astro.url.searchParams.get("date");
const date = dateParam && isCalendarDate(dateParam) ? dateParam : today;
const grid = monthGrid(date);

const scope = await loadAgendaScope(db, clinic.clinicId, Astro.url, Astro.cookies);
const range = { fromDate: grid.days[0], toDate: grid.days.at(-1)!, timeZone: clinic.timezone, agendaIds: scope.agendaIds };
const [appointments, blocks, clinicHolidays] = await Promise.all([
  listAgendaAppointments(db, clinic.clinicId, range),
  listAgendaBlocks(db, clinic.clinicId, { ...range, agendaNames: scope.agendaNames }),
  listClinicHolidays(db, clinic.clinicId, grid.days[0]),
]);
const counts = new Map<string, number>();
for (const a of appointments) {
  if (a.status === "canceled") continue;
  const day = localDateOf(a.scheduledAt, clinic.timezone);
  counts.set(day, (counts.get(day) ?? 0) + 1);
}
const blocked = (day: string) =>
  blocks.some((b) => localDateOf(b.startsAt, clinic.timezone) <= day && localDateOf(new Date(b.endsAt.getTime() - 1), clinic.timezone) >= day);
const holidayDates = new Set(clinicHolidays.map((h) => h.date));
const isHoliday = (day: string) => isNationalHoliday(day) || holidayDates.has(day);
const prevMonth = addDays(grid.first, -1);
const nextMonth = addDays(grid.last, 1);
---

<AdminLayout title="Agenda · Mês" wide>
  <AgendaHeader view="mes" date={date} agendas={scope.selectable} selectedAgendaId={scope.selectedAgendaId} subtitle={formatCalendarDate(grid.first, "MMMM 'de' yyyy")}>
    <div slot="nav" class="flex items-center gap-1.5 sm:gap-1">
      <Button href={`?date=${prevMonth}`} aria-label="Mês anterior" class="w-11 px-0 sm:w-10">
        <Icon name="chevron-left" class="h-5 w-5 shrink-0" strokeWidth={2.2} />
      </Button>
      <span class="min-w-0 flex-1 px-1 text-center text-[15px] font-semibold text-ink first-letter:uppercase sm:flex-none">{formatCalendarDate(grid.first, "MMMM 'de' yyyy")}</span>
      <Button href={`?date=${nextMonth}`} aria-label="Próximo mês" class="w-11 px-0 sm:w-10">
        <Icon name="chevron-right" class="h-5 w-5 shrink-0" strokeWidth={2.2} />
      </Button>
      {today.slice(0, 7) !== grid.first.slice(0, 7) && (
        <Button variant="quiet" href="?">
          Este mês
        </Button>
      )}
    </div>
  </AgendaHeader>

  <div class="mt-4 grid grid-cols-7 gap-1 text-center text-[13px] font-semibold text-ink-soft">
    {["Seg", "Ter", "Qua", "Qui", "Sex", "Sáb", "Dom"].map((d) => <span>{d}</span>)}
  </div>
  <div class="mt-1 grid grid-cols-7 gap-1">
    {
      grid.days.map((day) => {
        const inMonth = day.slice(0, 7) === grid.first.slice(0, 7);
        const count = counts.get(day) ?? 0;
        return (
          <a
            href={`/admin/agenda?date=${day}`}
            class={`flex min-h-16 flex-col rounded-lg border p-1.5 text-left no-underline hover:border-brand/40 hover:bg-brand-soft/40 ${day === today ? "border-brand ring-1 ring-brand" : "border-line"} ${inMonth ? "bg-white" : "bg-canvas opacity-60"}`}
          >
            <span class={`font-display text-sm font-bold tabular-nums ${day === today ? "text-brand" : "text-ink"}`}>{Number(day.slice(8))}</span>
            {count > 0 && <span class="mt-auto text-xs text-ink">{count} atend.</span>}
            {isHoliday(day) && <span class="text-[11px] text-pend-800">feriado</span>}
            {blocked(day) && <span class="text-[11px] text-blk-800">bloqueio</span>}
          </a>
        );
      })
    }
  </div>
</AdminLayout>

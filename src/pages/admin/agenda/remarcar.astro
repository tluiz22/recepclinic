---
// Agenda › Remarcar (F4.5): mesma agenda e mesmo serviço, outra data e
// horário (ou outra turma). Sessão de série (F4.6, D9): "só esta sessão" ou
// "esta e as próximas" (a série muda de dia e horário daqui em diante). Remarcar zera o lembrete e a presença confirmada
// (a data nova pede outros); o horário atual não conta como ocupado.
//
// Redesign R4 (cliente, 15/out/2026): o atendimento atual no alto, a faixa de
// 7 dias livres com setas, os horários por turno e o resumo "De → Para" com a
// escolha da série e o botão (no celular, uma barra fixa embaixo).
import { safeReturnPath } from "../../../lib/returnPath";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import ConfirmDeleteDialog from "../../../components/admin/ConfirmDeleteDialog.astro";
import FlashMessage from "../../../components/admin/FlashMessage.astro";
import Icon from "../../../components/admin/Icon.astro";
import Button from "../../../components/admin/ui/Button.astro";
import DayStrip from "../../../components/admin/ui/DayStrip.astro";
import PageHeader from "../../../components/admin/ui/PageHeader.astro";
import OtherTime from "../../../components/admin/ui/OtherTime.astro";
import SlotPicker, { type SlotOption } from "../../../components/admin/ui/SlotPicker.astro";
import StatusPill from "../../../components/admin/ui/StatusPill.astro";
import Tag from "../../../components/admin/ui/Tag.astro";
import { appointmentSituation, SITUATIONS } from "../../../components/admin/agenda/situationStyle";
import { slotValue } from "../../../lib/agendaSlot";
import { formatCalendarDate, formatInstant, isCalendarDate, todayIn, toInstant } from "../../../lib/clinicTime";
import { pickOne, readOtherTime } from "../../../lib/otherTime";
import { buildDayStrip } from "../../../lib/dayStrip";
import { createUserClient } from "../../../lib/data/clients";
import { checkFreeTime, getFreeSlots, getGroupSessions, getNextAvailableDates, isAgendaOpenOn } from "../../../lib/data/agenda/slots";
import { getAgendaAppointment } from "../../../lib/data/agenda/view";
import { listLocations } from "../../../lib/data/config/locations";
import { listServices } from "../../../lib/data/config/services";
import { setFlash } from "../../../lib/flash";
import { capitalize } from "../../../lib/vocabulary";
import { slotConfirmText } from "../../../lib/confirmText";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const params = Astro.url.searchParams;
const returnToParam = params.get("return_to") ?? "";
const returnTo = safeReturnPath(returnToParam, "/admin/agenda");
const appointment = await getAgendaAppointment(db, clinic.clinicId, params.get("id") ?? "").catch(() => null);
const now = new Date();
if (!appointment || !(appointment.status === "scheduled" || appointment.status === "confirmed") || appointment.scheduledAt <= now) {
  setFlash(Astro.cookies, { tone: "error", text: "Só atendimento marcado e ainda por vir pode ser remarcado." });
  return Astro.redirect(returnTo);
}

const FORM = "remarcar-form";
const today = todayIn(clinic.timezone, now);
const [services, locations] = await Promise.all([listServices(db, clinic.clinicId, { includeInactive: true }), listLocations(db, clinic.clinicId, { includeInactive: true })]);
const service = services.find((s) => s.id === appointment.serviceId);
const isGroup = service?.schedulingMode === "group";
const locationName = new Map(locations.map((l) => [l.id, l.name]));
const query = { serviceId: appointment.serviceId, agendaId: appointment.agendaId };
const dayLabel = (d: string) => capitalize(formatCalendarDate(d, "EEEE, dd/MM"));

let strip = buildDayStrip([], null, null);
let options: SlotOption[] = [];
if (isGroup) {
  options = (await getGroupSessions(db, clinic.clinicId, query))
    .filter((s) => s.start.getTime() !== appointment.scheduledAt.getTime())
    .map((s) => {
      const label = formatInstant(s.start, clinic.timezone, "EEE dd/MM 'às' HH:mm");
      return {
        value: slotValue({ agendaId: appointment.agendaId, start: s.start, locationId: s.locationId }),
        label,
        detail: `${locationName.get(s.locationId) ?? "Local"} · ${s.remaining} de ${s.capacity} vagas`,
        summary: capitalize(label),
        confirm: slotConfirmText(
          formatInstant(s.start, clinic.timezone, "EEEE, dd/MM 'às' HH:mm"),
          appointment.agendaName,
          locationName.get(s.locationId) ?? "Local",
        ),
      };
    });
} else {
  // Todos os dias livres da janela de busca (a faixa mostra 7 por vez).
  const dates = (await getNextAvailableDates(db, clinic.clinicId, { ...query, ignoreAppointmentId: appointment.id, count: 1000 })).map((d) => d.date);
  const wanted = params.get("date");
  const de = params.get("de");
  strip = buildDayStrip(dates, wanted && isCalendarDate(wanted) && wanted >= today ? wanted : null, de && isCalendarDate(de) ? de : null);
  const date = strip.selected;
  if (date) {
    options = (await getFreeSlots(db, clinic.clinicId, { ...query, date, ignoreAppointmentId: appointment.id }))
      .filter((s) => s.start.getTime() !== appointment.scheduledAt.getTime())
      .map((s) => ({
        value: slotValue({ agendaId: appointment.agendaId, start: s.start, locationId: s.locationId }),
        label: s.time,
        detail: locationName.get(s.locationId) ?? "Local",
        summary: `${dayLabel(date)} às ${s.time}`,
        confirm: slotConfirmText(`${dayLabel(date)} às ${s.time}`, appointment.agendaName, locationName.get(s.locationId) ?? "Local"),
      }));
  }
}
// Outro horário (cliente, 28/out/2026): qualquer dia e hora, conferido aqui
// (os avisos aparecem antes) e de novo ao remarcar.
const otherQuery = readOtherTime(params);
const otherLocations = (service?.locations ?? [])
  .filter((l) => locations.some((loc) => loc.id === l.locationId && loc.isActive))
  .map((l) => ({ id: l.locationId, name: locationName.get(l.locationId) ?? "Local" }));
let otherOption: SlotOption | null = null;
let otherError: string | null = null;
let otherWarnings: string[] = [];
if (!isGroup && otherQuery) {
  const locationId = pickOne(otherQuery.locationId, otherLocations.map((l) => l.id));
  const start = toInstant(otherQuery.date, otherQuery.time, clinic.timezone);
  if (!locationId) otherError = "Escolha o local.";
  else if (start.getTime() === appointment.scheduledAt.getTime()) otherError = "Esse já é o horário do atendimento.";
  else {
    const check = await checkFreeTime(db, clinic.clinicId, { ...query, locationId, start, ignoreAppointmentId: appointment.id }, now);
    if (!check.ok) otherError = check.reason;
    else {
      otherWarnings = check.warnings;
      const when = `${dayLabel(otherQuery.date)} às ${otherQuery.time}`;
      otherOption = {
        value: slotValue({ agendaId: appointment.agendaId, start, locationId }),
        label: capitalize(formatInstant(start, clinic.timezone, "EEE dd/MM 'às' HH:mm")),
        detail: locationName.get(locationId) ?? "Local",
        summary: when,
        confirm: slotConfirmText(when, appointment.agendaName, locationName.get(locationId) ?? "Local"),
        warnings: check.warnings.join(" "),
      };
    }
  }
}

// Dia pedido sem horário (S-02 do teste da R11, cliente, 17/out/2026): sem agenda aberta ou aberta e cheia.
const unavailableOpen = strip.unavailable ? await isAgendaOpenOn(db, clinic.clinicId, { ...query, date: strip.unavailable }) : false;
const link = (d: string, start: string) => `/admin/agenda/remarcar?id=${appointment.id}&date=${d}&de=${start}&return_to=${encodeURIComponent(returnTo)}`;
const current = capitalize(formatInstant(appointment.scheduledAt, clinic.timezone, "EEEE, dd/MM 'às' HH:mm"));
// A confirmação diz de onde sai e para onde vai (cliente, 17/out/2026): o
// script troca "{para}" pelo texto do horário escolhido.
const confirmTemplate = `${appointment.patientName} sai de ${current.charAt(0).toLowerCase()}${current.slice(1)} e vai para {para}. O lembrete e a presença confirmada recomeçam.${appointment.seriesId ? " Na opção 'esta e as próximas', a série inteira muda dali em diante." : ""} O paciente é avisado pelo WhatsApp.`;
const confirmMessage = confirmTemplate.replace("{para}", "o horário escolhido");
const situation = appointmentSituation(appointment);
const option =
  "flex cursor-pointer items-start gap-2.5 rounded-[9px] border border-line-strong px-3 py-2.5 text-[15px] leading-snug has-[:checked]:border-2 has-[:checked]:border-brand has-[:checked]:bg-[#e7f4ef] has-[:checked]:px-[11px] has-[:checked]:py-[9px]";
---

<AdminLayout title="Remarcar">
  <a href={returnTo} class="inline-flex min-h-8 items-center gap-1 text-[15px] font-semibold text-brand no-underline hover:underline">
    <Icon name="chevron-left" class="h-[18px] w-[18px]" strokeWidth={2.2} />
    {returnTo !== "/admin/agenda" ? "Voltar" : "Agenda"}
  </a>
  <PageHeader title="Remarcar" class="mt-2" />
  <FlashMessage />

  <div class="mt-4 flex flex-wrap items-start gap-5">
    <div class="flex min-w-0 flex-[999_1_560px] flex-col gap-3">
      <section aria-labelledby="atual" class={`flex flex-col gap-3 rounded-xl border ${SITUATIONS[situation].edge} ${SITUATIONS[situation].card} p-3.5 sm:px-5 sm:py-[18px]`}>
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div class="flex flex-col gap-1">
            <h2 id="atual" class="text-[13px] leading-tight font-semibold tracking-[.06em] text-ink-soft uppercase">Atendimento atual</h2>
            <p class="text-lg leading-snug font-semibold text-ink">{appointment.patientName}</p>
            <p class="text-base leading-snug font-bold text-ink">{current}</p>
          </div>
          <StatusPill situation={situation} />
        </div>
        <div class="flex flex-wrap gap-1.5">
          <Tag>{appointment.serviceName}</Tag>
          <Tag>{appointment.agendaName}</Tag>
          {appointment.seriesId && <Tag>Série</Tag>}
        </div>
        <p class="text-sm text-ink-soft">Mesma agenda e mesmo serviço. Remarcar zera o lembrete e a presença confirmada.</p>
      </section>

      <section aria-labelledby="nova" class="flex flex-col gap-4 rounded-xl border border-brand bg-white p-3.5 shadow-[0_0_0_1px_var(--color-brand)] sm:px-5 sm:py-[18px]">
        <h2 id="nova" class="font-display text-lg leading-tight font-bold text-ink">{isGroup ? "Outra turma" : "Nova data e horário"}</h2>
        {
          strip.unavailable && (
            <p class="flex items-start gap-2 rounded-[10px] border border-pend-200 bg-pend-100 px-3 py-2.5 text-[15px] leading-snug text-pend-800" role="status">
              <Icon name="warning" class="mt-0.5 h-[18px] w-[18px] shrink-0" />
              <span>
                <strong class="font-semibold">{unavailableOpen ? `${dayLabel(strip.unavailable)} não tem mais horário livre.` : "Não existe agenda aberta para esse dia."}</strong>{" "}
                {strip.selected
                  ? `Mostrando a partir de ${formatCalendarDate(strip.selected, "EEEE, dd/MM")}, o primeiro dia livre depois dele.`
                  : "Não há dia livre depois dele no período em que a clínica oferece horários."}
              </span>
            </p>
          )
        }
        {
          !isGroup && strip.days.length > 0 && (
            <DayStrip
              strip={strip}
              href={link}
              action="/admin/agenda/remarcar"
              hidden={{ id: appointment.id, return_to: returnTo }}
              min={today}
            />
          )
        }
        {!isGroup && !strip.selected && !strip.unavailable && <p class="text-[15px] text-ink-soft">Sem horários livres nos próximos 60 dias.</p>}
        {options.length > 0 && <SlotPicker options={options} form={FORM} byPeriod={!isGroup} />}
        {
          (isGroup || strip.selected) && options.length === 0 && (
            <p class="text-[15px] text-ink-soft">{isGroup ? "Nenhuma outra turma com vaga." : "Nenhum horário livre nesta data."}</p>
          )
        }
        {
          !isGroup && (
            <OtherTime
              action="/admin/agenda/remarcar"
              hidden={{ id: appointment.id, return_to: returnTo }}
              form={FORM}
              min={today}
              date={otherQuery?.date ?? strip.selected ?? today}
              time={otherQuery?.time ?? ""}
              locations={otherLocations}
              locationId={otherQuery?.locationId ?? ""}
              open={!!otherQuery}
              error={otherError}
              option={otherOption}
              warnings={otherWarnings}
            />
          )
        }
      </section>
    </div>

    <aside class="w-full min-w-0 flex-[1_1_320px] sm:sticky sm:top-6 sm:max-w-[380px]" aria-label="Resumo da remarcação">
      <form
        id={FORM}
        method="POST"
        action={`/api/admin/agenda/atendimentos/${appointment.id}`}
        class="flex flex-col gap-3.5 rounded-xl border border-line bg-white p-3.5 sm:px-5 sm:py-[18px]"
      >
        <input type="hidden" name="acao" value="remarcar" />
        <input type="hidden" name="return_to" value={returnTo} />
        <input type="hidden" name="back" value={`${Astro.url.pathname}${Astro.url.search}`} />
        <h2 class="font-display text-lg leading-tight font-bold text-ink">Resumo</h2>
        <dl class="grid grid-cols-[48px_minmax(0,1fr)] items-baseline gap-x-2.5 gap-y-1.5 text-[15px] leading-snug">
          <dt class="font-medium text-ink-soft">De</dt>
          <dd class="font-semibold text-ink">{current}</dd>
          <dt class="font-medium text-ink-soft">Para</dt>
          <dd class="font-semibold text-brand-ink" data-summary-when>Escolha um horário</dd>
          <dt class="font-medium text-ink-soft">Onde</dt>
          <dd class="font-semibold text-ink"><span data-summary-where>—</span> · {appointment.agendaName}</dd>
        </dl>
        {
          appointment.seriesId && (
            <fieldset class="flex flex-col gap-2 border-t border-line pt-3.5">
              <legend class="float-left mb-2 w-full text-[15px] font-semibold text-ink">Esta sessão é de uma série</legend>
              <label class={option}>
                <input type="radio" name="modo" value="sessao" checked class="mt-0.5 h-[18px] w-[18px] shrink-0 accent-brand" />
                <span>
                  Só esta sessão
                  <span class="block text-sm text-ink-soft">A série continua no dia e horário de sempre.</span>
                </span>
              </label>
              <label class={option}>
                <input type="radio" name="modo" value="serie" class="mt-0.5 h-[18px] w-[18px] shrink-0 accent-brand" />
                <span>
                  Esta e as próximas
                  <span class="block text-sm text-ink-soft">A série passa para o dia da semana e o horário escolhidos. As sessões passadas não mudam.</span>
                </span>
              </label>
            </fieldset>
          )
        }
        <p class="text-sm text-ink-soft">O paciente é avisado pelo WhatsApp. Antes, uma confirmação.</p>
        <div class="hidden sm:block">
          <Button
            type="submit"
            variant="primary"
            class="js-confirm-delete h-[46px] w-full text-base"
            disabled={options.length === 0 && !otherOption}
            data-needs-slot
            data-confirm-title="Remarcar o atendimento?"
            data-confirm-message={confirmMessage}
            data-confirm-template={confirmTemplate}
            data-confirm-label="Remarcar"
            data-confirm-tone="primary"
          >
            Remarcar
          </Button>
        </div>
      </form>
    </aside>
  </div>

  <div class="h-20 sm:hidden" aria-hidden="true"></div>
  <div class="fixed inset-x-0 bottom-[calc(61px+env(safe-area-inset-bottom))] z-10 flex items-center gap-3 border-t border-line bg-white px-4 py-2.5 shadow-[0_-4px_14px_rgba(18,48,42,.08)] sm:hidden">
    <div class="flex min-w-0 flex-1 flex-col">
      <span class="text-base leading-tight font-bold text-ink" data-summary-when>Escolha um horário</span>
      <span class="truncate text-sm text-ink-soft">{appointment.patientName} · antes: {current}</span>
    </div>
    <Button
      type="submit"
      variant="primary"
      form={FORM}
      class="js-confirm-delete h-12 px-[22px] text-base"
      disabled={options.length === 0 && !otherOption}
      data-needs-slot
      data-confirm-title="Remarcar o atendimento?"
      data-confirm-message={confirmMessage}
            data-confirm-template={confirmTemplate}
      data-confirm-label="Remarcar"
      data-confirm-tone="primary"
    >
      Remarcar
    </Button>
  </div>

  <script>
    // Resumo: o horário escolhido ("Para" e "Onde").
    // O botão só se habilita com o horário escolhido (proposta aprovada da R4;
    // teste do redesign, QA-07, 16/out/2026). Sem JavaScript, o navegador barra o envio.
    const needSlot = [...document.querySelectorAll<HTMLButtonElement>("button[data-needs-slot]")].filter((button) => !button.disabled);
    const sync = () => {
      const chosen = document.querySelector<HTMLInputElement>("input[name='slot']:checked");
      needSlot.forEach((button) => (button.disabled = !chosen));
      document.querySelectorAll<HTMLElement>("[data-summary-when]").forEach((el) => (el.textContent = chosen?.dataset.summary ?? "Escolha um horário"));
      document.querySelectorAll<HTMLElement>("[data-summary-where]").forEach((el) => (el.textContent = chosen?.dataset.where ?? "—"));
      // Texto da confirmação com o horário escolhido (cliente, 17/out/2026).
      if (chosen?.dataset.confirm) {
        const para = chosen.dataset.confirm;
        // Outro horário: os avisos na confirmação, e o botão diz "assim mesmo".
        const warnings = chosen.dataset.warnings ? ` Atenção: ${chosen.dataset.warnings}` : "";
        needSlot.forEach((button) => {
          if (button.dataset.confirmTemplate) button.dataset.confirmMessage = button.dataset.confirmTemplate.replace("{para}.", `${para}.${warnings}`);
          button.dataset.confirmLabel = warnings ? "Remarcar assim mesmo" : "Remarcar";
        });
      }
    };
    document.querySelectorAll("input[name='slot']").forEach((input) => input.addEventListener("change", sync));
    sync();
  </script>
  <ConfirmDeleteDialog />
</AdminLayout>

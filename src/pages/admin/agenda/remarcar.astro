---
// Agenda › Remarcar (F4.5): mesma agenda e mesmo serviço, outra data e
// horário (ou outra turma). Sessão de série (F4.6, D9): "só esta sessão" ou
// "esta e as próximas" (a série muda de dia e horário daqui em diante). Remarcar zera o lembrete e a presença confirmada
// (a data nova pede outros); o horário atual não conta como ocupado.
import { safeReturnPath } from "../../../lib/returnPath";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Card from "../../../components/admin/Card.astro";
import ConfirmDeleteDialog from "../../../components/admin/ConfirmDeleteDialog.astro";
import FlashMessage from "../../../components/admin/FlashMessage.astro";
import Icon from "../../../components/admin/Icon.astro";
import { PRIMARY_BUTTON } from "../../../components/admin/fieldStyles";
import { slotValue } from "../../../lib/agendaSlot";
import { formatCalendarDate, formatInstant, isCalendarDate } from "../../../lib/clinicTime";
import { createUserClient } from "../../../lib/data/clients";
import { getFreeSlots, getGroupSessions, getNextAvailableDates } from "../../../lib/data/agenda/slots";
import { getAgendaAppointment } from "../../../lib/data/agenda/view";
import { listLocations } from "../../../lib/data/config/locations";
import { listServices } from "../../../lib/data/config/services";
import { setFlash } from "../../../lib/flash";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const params = Astro.url.searchParams;
const returnToParam = params.get("return_to") ?? "";
const returnTo = safeReturnPath(returnToParam, "/admin/agenda");
const appointment = await getAgendaAppointment(db, clinic.clinicId, params.get("id") ?? "").catch(() => null);
const now = new Date();
if (!appointment || !(appointment.status === "scheduled" || appointment.status === "confirmed") || appointment.scheduledAt <= now) {
  setFlash(Astro.cookies, { tone: "error", text: "Só atendimento marcado e ainda por vir pode ser remarcado." });
  return Astro.redirect(returnTo);
}

const [services, locations] = await Promise.all([listServices(db, clinic.clinicId, { includeInactive: true }), listLocations(db, clinic.clinicId, { includeInactive: true })]);
const isGroup = services.find((s) => s.id === appointment.serviceId)?.schedulingMode === "group";
const locationName = new Map(locations.map((l) => [l.id, l.name]));
const query = { serviceId: appointment.serviceId, agendaId: appointment.agendaId };

let dates: string[] = [];
let date = "";
let options: { value: string; label: string; detail: string }[] = [];
if (isGroup) {
  options = (await getGroupSessions(db, clinic.clinicId, query))
    .filter((s) => s.start.getTime() !== appointment.scheduledAt.getTime())
    .map((s) => ({
      value: slotValue({ agendaId: appointment.agendaId, start: s.start, locationId: s.locationId }),
      label: formatInstant(s.start, clinic.timezone, "EEE dd/MM 'às' HH:mm"),
      detail: `${locationName.get(s.locationId) ?? "Local"} · ${s.remaining} de ${s.capacity} vagas`,
    }));
} else {
  dates = (await getNextAvailableDates(db, clinic.clinicId, { ...query, ignoreAppointmentId: appointment.id })).map((d) => d.date);
  const wanted = params.get("date");
  date = wanted && isCalendarDate(wanted) && dates.includes(wanted) ? wanted : (dates[0] ?? "");
  if (date) {
    options = (await getFreeSlots(db, clinic.clinicId, { ...query, date, ignoreAppointmentId: appointment.id }))
      .filter((s) => s.start.getTime() !== appointment.scheduledAt.getTime())
      .map((s) => ({
        value: slotValue({ agendaId: appointment.agendaId, start: s.start, locationId: s.locationId }),
        label: s.time,
        detail: locationName.get(s.locationId) ?? "Local",
      }));
  }
}
const link = (d: string) => `/admin/agenda/remarcar?id=${appointment.id}&date=${d}&return_to=${encodeURIComponent(returnTo)}`;
const chip = (active: boolean) =>
  `rounded-lg border px-3 py-2 text-sm font-medium ${active ? "border-sky-700 bg-sky-700 text-white" : "border-slate-300 bg-white text-slate-700 hover:border-sky-600"}`;
---

<AdminLayout title="Remarcar">
  <a href={returnTo} class="inline-flex items-center gap-1 text-sm font-medium text-sky-700 hover:underline">
    <Icon name="chevron-left" class="h-4 w-4" /> Agenda
  </a>
  <h1 class="mt-3 text-2xl font-bold text-slate-900">Remarcar</h1>
  <FlashMessage />

  <Card class="mt-4 max-w-2xl">
    <p class="font-medium text-slate-900">{appointment.patientName}</p>
    <p class="text-sm text-slate-600">
      {appointment.serviceName} · {appointment.agendaName} · hoje marcado para {formatInstant(appointment.scheduledAt, clinic.timezone, "EEE dd/MM 'às' HH:mm")}
    </p>
    <p class="mt-1 text-xs text-slate-500">Remarcar zera o lembrete e a presença confirmada.</p>
  </Card>

  <Card class="mt-4 max-w-2xl">
    <h2 class="font-semibold text-slate-900">{isGroup ? "Outra turma" : "Nova data e horário"}</h2>
    {
      !isGroup && (
        <div class="mt-2 flex flex-wrap gap-2">
          {dates.map((d) => (
            <a href={link(d)} class={chip(d === date)}>
              <span class="capitalize">{formatCalendarDate(d, "EEE dd/MM")}</span>
            </a>
          ))}
          {dates.length === 0 && <p class="text-sm text-slate-500">Sem horários livres nos próximos 60 dias.</p>}
        </div>
      )
    }
    <form method="POST" action={`/api/admin/agenda/atendimentos/${appointment.id}`} class="mt-4 flex flex-col gap-4">
      <input type="hidden" name="acao" value="remarcar" />
      {
        appointment.seriesId && (
          <fieldset class="rounded-lg border border-slate-200 p-3">
            <legend class="px-1 text-sm font-medium text-slate-700">Esta sessão é de uma série</legend>
            <div class="flex flex-col gap-2 text-sm text-slate-700">
              <label class="flex items-start gap-2">
                <input type="radio" name="modo" value="sessao" checked class="mt-0.5 h-4 w-4" />
                <span>Só esta sessão (a série continua no dia e horário de sempre)</span>
              </label>
              <label class="flex items-start gap-2">
                <input type="radio" name="modo" value="serie" class="mt-0.5 h-4 w-4" />
                <span>Esta e as próximas: a série passa para o dia da semana e o horário escolhidos (as sessões passadas não mudam)</span>
              </label>
            </div>
          </fieldset>
        )
      }
      <input type="hidden" name="return_to" value={returnTo} />
      <input type="hidden" name="back" value={`${Astro.url.pathname}${Astro.url.search}`} />
      <div class="flex flex-wrap gap-2">
        {
          options.map((o) => (
            <label class="cursor-pointer rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm has-[:checked]:border-sky-700 has-[:checked]:bg-sky-50">
              <input type="radio" name="slot" value={o.value} required class="mr-1" />
              <span class="font-medium capitalize">{o.label}</span>
              <span class="block text-xs text-slate-500">{o.detail}</span>
            </label>
          ))
        }
        {(isGroup || date) && options.length === 0 && <p class="text-sm text-slate-500">{isGroup ? "Nenhuma outra turma com vaga." : "Nenhum horário livre nesta data."}</p>}
      </div>
      <button
        type="submit"
        class={`${PRIMARY_BUTTON} js-confirm-delete self-start`}
        disabled={options.length === 0}
        data-confirm-title="Remarcar o atendimento?"
        data-confirm-message={`${appointment.patientName} vai para o horário escolhido. O lembrete e a presença confirmada recomeçam.${appointment.seriesId ? " Na opção 'esta e as próximas', a série inteira muda dali em diante." : ""} O paciente é avisado pelo WhatsApp.`}
        data-confirm-label="Remarcar"
        data-confirm-tone="primary"
      >
        Remarcar
      </button>
    </form>
  </Card>
  <ConfirmDeleteDialog />
</AdminLayout>

---
// Agenda › trilha do atendimento (F4.8): tudo o que aconteceu com ele, do
// mais antigo ao mais recente, com quem fez (nome na clínica, cliente,
// 05/out/2026) e as mensagens do WhatsApp.
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import Card from "../../../../components/admin/Card.astro";
import Icon from "../../../../components/admin/Icon.astro";
import { isUuid } from "../../../../lib/clinicAccess";
import { safeReturnPath } from "../../../../lib/returnPath";
import { formatInstant, localDateOf } from "../../../../lib/clinicTime";
import { createUserClient } from "../../../../lib/data/clients";
import { listTrail } from "../../../../lib/data/agenda/trail";
import { getAgendaAppointment } from "../../../../lib/data/agenda/view";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const id = Astro.params.id!;
const appointment = isUuid(id) ? await getAgendaAppointment(db, clinic.clinicId, id) : null;
if (!appointment) return Astro.redirect("/admin/agenda");
const entries = await listTrail(db, clinic.clinicId, appointment.id, clinic.timezone);
const back = Astro.url.searchParams.get("volta") ?? "";
const backTo = safeReturnPath(back, `/admin/agenda?date=${localDateOf(appointment.scheduledAt, clinic.timezone)}`);
const tone = { neutral: "text-slate-700", success: "text-emerald-700", danger: "font-medium text-red-700" };
---

<AdminLayout title="Trilha do atendimento">
  <a href={backTo} class="inline-flex items-center gap-1 text-sm font-medium text-sky-700 hover:underline">
    <Icon name="chevron-left" class="h-4 w-4" /> Voltar
  </a>
  <h1 class="mt-3 text-2xl font-bold text-slate-900">Trilha do atendimento</h1>
  <Card class="mt-4 max-w-2xl">
    <p class="font-medium text-slate-900">
      <a href={`/admin/pacientes/${appointment.patientId}`} class="hover:text-sky-700 hover:underline">{appointment.patientName}</a>
    </p>
    <p class="text-sm capitalize text-slate-600">{formatInstant(appointment.scheduledAt, clinic.timezone, "EEEE, dd/MM/yyyy 'às' HH:mm")}</p>
    <p class="text-sm text-slate-600">{appointment.serviceName} · {appointment.agendaName} · {appointment.locationName}</p>
  </Card>
  <Card class="mt-4 max-w-2xl">
    {
      entries.length ? (
        <ol class="flex flex-col gap-2">
          {entries.map((entry) => (
            <li class="flex flex-col text-sm sm:flex-row sm:gap-3">
              <span class="shrink-0 tabular-nums text-xs text-slate-400 sm:w-36 sm:text-sm">{formatInstant(entry.at, clinic.timezone, "dd/MM/yyyy HH:mm")}</span>
              <span class={tone[entry.tone]}>{entry.text}</span>
            </li>
          ))}
        </ol>
      ) : (
        <p class="text-sm text-slate-500">Nada registrado ainda.</p>
      )
    }
  </Card>
</AdminLayout>

---
// Agenda › Atendimentos marcados de um paciente (cliente, 10/out/2026): busca
// pelo nome ou pelo telefone (4+ dígitos), como em Pacientes, inclusive
// desativados. Um encontrado: já mostra os próximos atendimentos dele; mais de
// um: a pessoa escolhe qual. Só das agendas que a pessoa vê (o Profissional,
// só as próprias; D6). O histórico completo fica na ficha do paciente.
import { currentPath, receivedReturn, withReturn } from "../../../lib/returnPath";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AgendaHeader from "../../../components/admin/agenda/AgendaHeader.astro";
import SituationLegend from "../../../components/admin/agenda/SituationLegend.astro";
import { SITUATIONS, appointmentSituation } from "../../../components/admin/agenda/situationStyle";
import Icon from "../../../components/admin/Icon.astro";
import StatusPill from "../../../components/admin/ui/StatusPill.astro";
import PhoneLinks from "../../../components/admin/PhoneLinks.astro";
import { PANEL, SECONDARY_BUTTON } from "../../../components/admin/config/formStyles";
import EmptyState from "../../../components/admin/ui/EmptyState.astro";
import Pill from "../../../components/admin/ui/Pill.astro";
import { formatAgeAndBirth } from "../../../lib/age";
import { isUuid } from "../../../lib/clinicAccess";
import { formatInstant, isCalendarDate, localDateOf, todayIn } from "../../../lib/clinicTime";
import { createUserClient } from "../../../lib/data/clients";
import { listUpcomingByPatient, type AgendaAppointment } from "../../../lib/data/agenda/view";
import { getContact, getPatient, listPatientsPage } from "../../../lib/data/patients";
import { formatPhoneBR } from "../../../lib/phone";
import { capitalize, vocabularyFor } from "../../../lib/vocabulary";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const vocabulary = vocabularyFor(clinic.clinicProfile);
const now = new Date();
const today = todayIn(clinic.timezone, now);
const params = Astro.url.searchParams;
const q = (params.get("q") ?? "").trim();
const chosenId = params.get("paciente");
const fromList = params.get("lista") === "1";
// Voltar: para a tela da Agenda de onde a busca saiu, e os links Dia, Semana e
// Mês no dia dela (teste do redesign, NAV-07, 16/out/2026). A origem segue nos
// links internos da busca.
const volta = receivedReturn(Astro.url);
const voltaDate = volta?.startsWith("/admin/agenda") ? new URL(volta, Astro.url).searchParams.get("date") : null;
const headerDate = voltaDate && isCalendarDate(voltaDate) ? voltaDate : today;
const keep = (href: string) => withReturn(href, volta);
const searchHref = (patientId: string, list = false) => keep(`/admin/agenda/buscar?q=${encodeURIComponent(q)}&paciente=${patientId}${list ? "&lista=1" : ""}`);

// Paciente escolhido (ou o único encontrado).
let chosen = isUuid(chosenId) ? await getPatient(db, clinic.clinicId, chosenId).catch(() => null) : null;
let matches: Awaited<ReturnType<typeof listPatientsPage>> | null = null;
let counts = new Map<string, AgendaAppointment[]>();
if (!chosen && q) {
  matches = await listPatientsPage(db, clinic.clinicId, { query: q, includeInactive: true });
  if (matches.total === 1) return Astro.redirect(searchHref(matches.items[0].id));
  counts = await listUpcomingByPatient(db, clinic.clinicId, matches.items.map((p) => p.id), now);
}
const [contact, upcoming] = chosen
  ? await Promise.all([getContact(db, clinic.clinicId, chosen.contactId), listUpcomingByPatient(db, clinic.clinicId, [chosen.id], now)])
  : [null, new Map<string, AgendaAppointment[]>()];
const rows = chosen ? (upcoming.get(chosen.id) ?? []) : [];
const plural = (n: number) => `${n} ${n === 1 ? "atendimento marcado" : "atendimentos marcados"}`;
---

<AdminLayout title="Agenda · Atendimentos de um paciente">
  <a href={volta ?? `/admin/agenda?date=${headerDate}`} class="inline-flex min-h-8 items-center gap-1 text-[15px] font-semibold text-brand no-underline hover:underline">
    <Icon name="chevron-left" class="h-[18px] w-[18px]" strokeWidth={2.2} />
    {volta ? "Voltar" : "Agenda"}
  </a>
  <div class="mt-2">
    <AgendaHeader view="busca" date={headerDate} agendas={[]} selectedAgendaId={null} query={q} returnTo={volta} />
  </div>

  {!q && !chosen && <p class="mt-4 text-[15px] text-ink-soft">Digite o nome ou o telefone do {vocabulary.patient} para ver os atendimentos marcados dele.</p>}

  {
    matches && (
      <>
        {matches.total === 0 ? (
          <div class="mt-4">
            <EmptyState title={`Nenhum ${vocabulary.patient} encontrado.`} text="Confira o nome ou busque pelo telefone (4 dígitos ou mais). A busca inclui os desativados." />
          </div>
        ) : (
          <p class="mt-4 text-[15px] text-ink-soft">
            {`Encontramos ${matches.total} ${vocabulary.patients}. Escolha um para ver os atendimentos marcados${matches.total > matches.items.length ? ` (mostrando ${matches.items.length}; refine a busca para achar os outros)` : ""}:`}
          </p>
        )}
        <ul class="mt-3 flex flex-col gap-2">
          {matches.items.map((p) => {
            const n = counts.get(p.id)?.length ?? 0;
            return (
              <li>
                <a href={searchHref(p.id, true)} class="flex flex-wrap items-center justify-between gap-2 rounded-xl border border-line bg-white px-3.5 py-3 text-[15px] no-underline hover:border-brand/40 hover:bg-brand-soft/40">
                  <span>
                    <span class="font-bold text-ink">{p.fullName}</span> <span class="text-ink-soft">{formatAgeAndBirth(p.birthdate, today)}</span>
                    <span class="block text-ink-soft">
                      {!p.isContactSelf && `${capitalize(vocabulary.contact)}: ${p.contact.fullName} · `}
                      {formatPhoneBR(p.contact.phone)}
                    </span>
                  </span>
                  <span class="flex items-center gap-2">
                    {!p.isActive && <Pill>Desativado</Pill>}
                    <Pill tone={n > 0 ? "info" : "neutral"}>{n > 0 ? plural(n) : "Nada marcado"}</Pill>
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </>
    )
  }

  {
    chosen && contact && (
      <section class={`${PANEL} mt-4`}>
        <div class="flex flex-wrap items-start justify-between gap-2">
          <div class="text-[15px]">
            <p class="text-[13px] leading-tight font-semibold tracking-[.06em] text-ink-soft uppercase">Atendimentos marcados de</p>
            <a href={withReturn(`/admin/pacientes/${chosen.id}`, currentPath(Astro.url))} class="text-lg font-semibold text-ink no-underline hover:text-brand hover:underline">
              {chosen.fullName}
            </a>{" "}
            <span class="text-ink-soft">{formatAgeAndBirth(chosen.birthdate, today)}</span>
            <p class="text-ink-soft">
              {!chosen.isContactSelf && `${capitalize(vocabulary.contact)}: ${contact.fullName} · `}
              <PhoneLinks phone={contact.phone} plain class="text-ink-soft" />
            </p>
          </div>
          {!chosen.isActive && <Pill>Desativado</Pill>}
        </div>
        <h2 class="mt-4 text-[15px] font-bold text-ink">{rows.length > 0 ? `${plural(rows.length)}, do mais próximo ao mais distante` : "Nenhum atendimento marcado."}</h2>
        {rows.length > 0 && <SituationLegend />}
        <ul class="mt-3 flex flex-col gap-1.5">
          {rows.map((a) => (
            <li class={`rounded-lg border-l-4 px-3 py-2 text-[15px] ${SITUATIONS[appointmentSituation(a)].swatch}`}>
              <a href={`/admin/agenda?date=${localDateOf(a.scheduledAt, clinic.timezone)}`} class="flex flex-wrap items-start justify-between gap-x-3 gap-y-1 text-ink no-underline hover:text-brand">
                <span>
                  {/* Maiúscula só na primeira letra ("Segunda … às"; QA-10, 16/out/2026). */}
                  <span class="inline-block font-semibold first-letter:uppercase">{formatInstant(a.scheduledAt, clinic.timezone, "EEE dd/MM/yyyy 'às' HH:mm")}</span>
                  <span class="block text-ink-soft">
                    {a.serviceName} · {a.agendaName} · {a.locationName}
                  </span>
                </span>
                {/* A situação também em texto, não só na cor (decisão 4 da Agenda; QA-09). */}
                <StatusPill situation={appointmentSituation(a)} />
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-4 flex flex-wrap gap-2 border-t border-[#e6ecea] pt-3">
          <a href={withReturn(`/admin/pacientes/${chosen.id}`, currentPath(Astro.url))} class={SECONDARY_BUTTON}>Ver a ficha (histórico completo)</a>
          {q && fromList && <a href={keep(`/admin/agenda/buscar?q=${encodeURIComponent(q)}`)} class={SECONDARY_BUTTON}>Voltar à lista</a>}
          <a href={keep("/admin/agenda/buscar")} class={SECONDARY_BUTTON}>Buscar outro {vocabulary.patient}</a>
        </div>
      </section>
    )
  }
</AdminLayout>

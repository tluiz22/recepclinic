---
// Agenda › Semana (F4.5): segunda a domingo, os atendimentos de cada dia em
// resumo (hora, paciente, serviço). Tocar no dia abre o Dia, com as ações.
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AgendaHeader from "../../../components/admin/agenda/AgendaHeader.astro";
import Icon from "../../../components/admin/Icon.astro";
import { addDays, formatCalendarDate, formatInstant, isCalendarDate, localDateOf, todayIn } from "../../../lib/clinicTime";
import { createUserClient } from "../../../lib/data/clients";
import { loadAgendaScope } from "../../../lib/data/agenda/scope";
import { listAgendaAppointments, listAgendaBlocks, weekStart } from "../../../lib/data/agenda/view";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const today = todayIn(clinic.timezone);
const dateParam = Astro.url.searchParams.get("date");
const date = dateParam && isCalendarDate(dateParam) ? dateParam : today;
const monday = weekStart(date);
const days = Array.from({ length: 7 }, (_, i) => addDays(monday, i));

const scope = await loadAgendaScope(db, clinic.clinicId, Astro.url, Astro.cookies);
const range = { fromDate: days[0], toDate: days[6], timeZone: clinic.timezone, agendaIds: scope.agendaIds };
const [appointments, blocks] = await Promise.all([
  listAgendaAppointments(db, clinic.clinicId, range),
  listAgendaBlocks(db, clinic.clinicId, { ...range, agendaNames: scope.agendaNames }),
]);
const showAgenda = !scope.selectedAgendaId && scope.agendas.length > 1;
const ofDay = (day: string) => appointments.filter((a) => a.status !== "canceled" && localDateOf(a.scheduledAt, clinic.timezone) === day);
const blocksOf = (day: string) =>
  blocks.filter((b) => localDateOf(b.startsAt, clinic.timezone) <= day && localDateOf(new Date(b.endsAt.getTime() - 1), clinic.timezone) >= day);
const statusMark: Record<string, string> = { completed: "✓", no_show: "✗" };
---

<AdminLayout title="Agenda · Semana">
  <AgendaHeader view="semana" date={date} agendas={scope.selectable} selectedAgendaId={scope.selectedAgendaId} />

  <div class="mt-4 flex flex-wrap items-center gap-2">
    <a href={`?date=${addDays(monday, -7)}`} aria-label="Semana anterior" class="rounded-md border border-slate-200 bg-white p-2 text-slate-500 hover:text-sky-700">
      <Icon name="chevron-left" class="h-5 w-5" />
    </a>
    <span class="text-sm font-medium text-slate-700">
      {formatCalendarDate(days[0], "dd/MM")} a {formatCalendarDate(days[6], "dd/MM/yyyy")}
    </span>
    <a href={`?date=${addDays(monday, 7)}`} aria-label="Próxima semana" class="rounded-md border border-slate-200 bg-white p-2 text-slate-500 hover:text-sky-700">
      <Icon name="chevron-right" class="h-5 w-5" />
    </a>
    {
      !days.includes(today) && (
        <a href="?" class="rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50">
          Esta semana
        </a>
      )
    }
  </div>

  <div class="mt-4 grid gap-3 md:grid-cols-7">
    {
      days.map((day) => (
        <a
          href={`/admin/agenda?date=${day}`}
          class={`block rounded-lg border bg-white p-3 hover:border-sky-300 hover:bg-sky-50 ${day === today ? "border-sky-600" : "border-slate-200"}`}
        >
          <p class={`text-sm font-semibold capitalize ${day === today ? "text-sky-700" : "text-slate-900"}`}>{formatCalendarDate(day, "EEE dd/MM")}</p>
          <ul class="mt-2 flex flex-col gap-1.5 text-xs text-slate-700">
            {blocksOf(day).map((b) => (
              <li class="rounded bg-slate-100 px-1.5 py-1 text-slate-500">Bloqueio: {b.reason}</li>
            ))}
            {ofDay(day).map((a) => (
              <li>
                <span class="font-semibold">{formatInstant(a.scheduledAt, clinic.timezone, "HH:mm")}</span> {a.patientName}
                {statusMark[a.status] && <span class="ml-1">{statusMark[a.status]}</span>}
                <span class="block text-slate-500">
                  {a.serviceName}
                  {showAgenda ? ` · ${a.agendaName}` : ""}
                </span>
              </li>
            ))}
            {ofDay(day).length === 0 && blocksOf(day).length === 0 && <li class="text-slate-400">Livre</li>}
          </ul>
        </a>
      ))
    }
  </div>
</AdminLayout>

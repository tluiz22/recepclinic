---
// Agenda › Semana (F4.5): segunda a domingo, os atendimentos de cada dia em
// resumo (hora, paciente, serviço). Tocar no dia abre o Dia, com as ações.
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AgendaHeader from "../../../components/admin/agenda/AgendaHeader.astro";
import Icon from "../../../components/admin/Icon.astro";
import Button from "../../../components/admin/ui/Button.astro";
import StatusPill from "../../../components/admin/ui/StatusPill.astro";
import SituationLegend from "../../../components/admin/agenda/SituationLegend.astro";
import { SITUATIONS, appointmentSituation } from "../../../components/admin/agenda/situationStyle";
import { CATEGORY_STYLES, serviceBesideCategory, serviceLook, serviceTints } from "../../../components/admin/agenda/categoryStyle";
import { listServiceRefs } from "../../../lib/data/config/services";
import { addDays, formatCalendarDate, formatInstant, isCalendarDate, localDateOf, todayIn } from "../../../lib/clinicTime";
import { createUserClient } from "../../../lib/data/clients";
import { loadAgendaScope } from "../../../lib/data/agenda/scope";
import { listAgendaAppointments, listAgendaBlocks, weekStart } from "../../../lib/data/agenda/view";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const today = todayIn(clinic.timezone);
const dateParam = Astro.url.searchParams.get("date");
const date = dateParam && isCalendarDate(dateParam) ? dateParam : today;
const monday = weekStart(date);
const days = Array.from({ length: 7 }, (_, i) => addDays(monday, i));

const scope = await loadAgendaScope(db, clinic.clinicId, Astro.url, Astro.cookies);
const range = { fromDate: days[0], toDate: days[6], timeZone: clinic.timezone, agendaIds: scope.agendaIds };
const [appointments, blocks, serviceRefs] = await Promise.all([
  listAgendaAppointments(db, clinic.clinicId, range),
  listAgendaBlocks(db, clinic.clinicId, { ...range, agendaNames: scope.agendaNames }),
  listServiceRefs(db, clinic.clinicId),
]);
// Cor de cada serviço no tipo da primeira linha (cliente, 19/out/2026).
const tints = serviceTints(serviceRefs);
const showAgenda = !scope.selectedAgendaId && scope.agendas.length > 1;
const ofDay = (day: string) => appointments.filter((a) => a.status !== "canceled" && localDateOf(a.scheduledAt, clinic.timezone) === day);
const blocksOf = (day: string) =>
  blocks.filter((b) => localDateOf(b.startsAt, clinic.timezone) <= day && localDateOf(new Date(b.endsAt.getTime() - 1), clinic.timezone) >= day);
---

<AdminLayout title="Agenda · Semana">
  <AgendaHeader
    view="semana"
    date={date}
    agendas={scope.selectable}
    selectedAgendaId={scope.selectedAgendaId}
    subtitle={`${formatCalendarDate(days[0], "d 'de' MMMM")} a ${formatCalendarDate(days[6], "d 'de' MMMM 'de' yyyy")}`}
  >
    <div slot="nav" class="flex items-center gap-1.5 sm:gap-1">
      <Button href={`?date=${addDays(monday, -7)}`} aria-label="Semana anterior" class="w-11 px-0 sm:w-10">
        <Icon name="chevron-left" class="h-5 w-5 shrink-0" strokeWidth={2.2} />
      </Button>
      <span class="min-w-0 flex-1 px-1 text-center text-[15px] font-semibold text-ink tabular-nums sm:flex-none">
        {formatCalendarDate(days[0], "dd/MM")} a {formatCalendarDate(days[6], "dd/MM/yyyy")}
      </span>
      <Button href={`?date=${addDays(monday, 7)}`} aria-label="Próxima semana" class="w-11 px-0 sm:w-10">
        <Icon name="chevron-right" class="h-5 w-5 shrink-0" strokeWidth={2.2} />
      </Button>
      {!days.includes(today) && (
        <Button variant="quiet" href="?">
          Esta semana
        </Button>
      )}
    </div>
  </AgendaHeader>

  <SituationLegend class="mt-4" />

  <div class="mt-4 grid gap-3 md:grid-cols-7 md:gap-2">
    {
      days.map((day) => (
        <a
          href={`/admin/agenda?date=${day}`}
          class={`block min-w-0 rounded-xl border bg-white p-3 no-underline md:p-2.5 hover:border-brand/40 hover:bg-brand-soft/40 ${day === today ? "border-brand ring-1 ring-brand" : "border-line"}`}
        >
          <p class={`text-sm font-bold capitalize ${day === today ? "text-brand" : "text-ink"}`}>{formatCalendarDate(day, "EEE dd/MM")}</p>
          <ul class="mt-2 flex flex-col gap-1.5 text-[13px] text-ink">
            {blocksOf(day).map((b) => (
              <li class={`rounded border-l-4 px-1.5 py-1 text-blk-800 ${SITUATIONS.block.swatch}`}>Bloqueio: {b.reason}</li>
            ))}
            {ofDay(day).map((a) => (
              <li class={`rounded border-l-4 px-1.5 py-1 ${SITUATIONS[appointmentSituation(a)].swatch}`}>
                {/* O tipo na primeira linha (redesign de 19/out/2026, proposta 1C). */}
                {/* Etiqueta na cor do serviço (cliente, 19/out/2026): só o texto colorido ficava sutil demais na coluna. */}
                <span class={`-ml-0.5 inline-flex max-w-full items-center gap-1 rounded border px-1 py-px font-display text-[13.5px] leading-tight font-bold ${serviceLook(a.category, tints.get(a.serviceId)).band} ${serviceLook(a.category, tints.get(a.serviceId)).text}`}>
                  {a.category === "return_visit" && <Icon name="arrow-uturn-left" class="h-3.5 w-3.5 shrink-0" strokeWidth={2.4} />}
                  {CATEGORY_STYLES[a.category].label}
                </span>
                <span class="mt-0.5 block">
                  <span class="font-semibold tabular-nums">{formatInstant(a.scheduledAt, clinic.timezone, "HH:mm")}</span> {a.patientName}
                </span>
                {(serviceBesideCategory(a.serviceName, a.category) || showAgenda) && (
                  <span class="block text-ink-soft">{[serviceBesideCategory(a.serviceName, a.category), showAgenda ? a.agendaName : null].filter(Boolean).join(" · ")}</span>
                )}
                {/* A situação também em texto, não só na cor (decisão 4 da Agenda; QA-09, 16/out/2026).
                    Na largura única (1152px) a coluna do dia é estreita: o selo quebra a linha sem sair do atendimento. */}
                <StatusPill situation={appointmentSituation(a)} class="mt-1 max-w-full gap-0.5! pr-1.5! pl-1! text-xs! whitespace-normal!" />
              </li>
            ))}
            {ofDay(day).length === 0 && blocksOf(day).length === 0 && <li class="text-ink-soft">Livre</li>}
          </ul>
        </a>
      ))
    }
  </div>
</AdminLayout>

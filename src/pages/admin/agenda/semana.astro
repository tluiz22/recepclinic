---
// Agenda › Semana como quadro de ocupação (seção 16.3, opção C; cliente, 11/nov/2026). Uma linha por profissional,
// agrupada por especialidade, e uma coluna por dia: "N de M" marcados, os livres e a barra. Tocar no quadro abre o Dia
// daquele profissional; no cabeçalho, o dia com todos. Filtros do Dia: Especialidade e Profissional (a partir de 8
// agendas) ou Agenda; sem Situação (fica no Dia). Livres: a mesma conta da Marcar e dos "Próximos horários livres"
// (src/lib/weekOccupancy.ts). No celular, um dia por vez: a faixa dos 7 dias (com os livres de cada um) e, embaixo, os
// profissionais do dia escolhido.
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AgendaHeader from "../../../components/admin/agenda/AgendaHeader.astro";
import ColumnPicker from "../../../components/admin/agenda/ColumnPicker.astro";
import Icon from "../../../components/admin/Icon.astro";
import Button from "../../../components/admin/ui/Button.astro";
import { CONTROL } from "../../../components/admin/ui/styles";
import { withReturn } from "../../../lib/returnPath";
import { addDays, dayBounds, formatCalendarDate, isCalendarDate, localDateOf, todayIn } from "../../../lib/clinicTime";
import { createUserClient } from "../../../lib/data/clients";
import { loadAgendaScope } from "../../../lib/data/agenda/scope";
import { listPortalHolds, loadSpecialtiesByProfessional } from "../../../lib/data/agenda/grid";
import { listFreeGapsRange, loadClinicHolidays } from "../../../lib/data/agenda/slots";
import { listAgendaAppointments, weekStart } from "../../../lib/data/agenda/view";
import { listNationalHolidays } from "../../../lib/holidays";
import { buildColumns, filterColumns, MANY_AGENDAS, specialtyOptions } from "../../../lib/agendaGrid";
import { dayFree, freeText, occupancyCell, occupancyPercent, type OccupancyCell } from "../../../lib/weekOccupancy";
import { logError } from "../../../lib/log";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const now = new Date();
const today = todayIn(clinic.timezone, now);
const params = Astro.url.searchParams;
const dateParam = params.get("date");
const date = dateParam && isCalendarDate(dateParam) ? dateParam : today;
const monday = weekStart(date);
const days = Array.from({ length: 7 }, (_, i) => addDays(monday, i));

const [scope, specialtiesOf] = await Promise.all([
  loadAgendaScope(db, clinic.clinicId, Astro.url),
  loadSpecialtiesByProfessional(db, clinic.clinicId).catch((error: unknown) => {
    logError("semana: especialidades não carregaram", error, { clinica: clinic.clinicId });
    return new Map<string, string[]>();
  }),
]);
const many = scope.selectable.length >= MANY_AGENDAS;
const allColumns = buildColumns(scope.agendas, specialtiesOf);
const filtered = filterColumns(allColumns, { specialty: many ? params.get("esp") : null, agendaId: scope.selectedAgendaId });
const specialty = filtered.filter.specialty;
const chosenAgendaId = filtered.filter.agendaId;
const ids = filtered.columns.map((c) => c.id);

const range = { fromDate: days[0], toDate: days[6], timeZone: clinic.timezone, agendaIds: ids };
// Os horários livres contados desde o começo da semana: o dia que passou mantém o total (M) dele.
const weekBegin = dayBounds(days[0], clinic.timezone).start;
let failed = false;
const [appointments, gaps, holds, clinicHolidays] = await Promise.all([
  listAgendaAppointments(db, clinic.clinicId, range),
  listFreeGapsRange(db, clinic.clinicId, range, weekBegin).catch((error: unknown) => {
    logError("semana: horários livres não carregaram", error, { clinica: clinic.clinicId });
    failed = true;
    return [];
  }),
  listPortalHolds(db, clinic.clinicId, range, now).catch(() => []),
  loadClinicHolidays(db, clinic.clinicId, days[0], days[6]).catch(() => new Set<string>()),
]);
const years = [...new Set(days.map((d) => Number(d.slice(0, 4))))];
const holidayNames = new Map(years.flatMap((y) => listNationalHolidays(y)).map((h) => [h.date, h.name]));
const holidays = new Set([...days.filter((d) => holidayNames.has(d)), ...clinicHolidays]);
// Na agenda de Exames a reserva só segura o mesmo exame: lá os horários não ficam "em reserva".
const teamAgendas = new Set(scope.agendas.filter((a) => a.kind === "resource").map((a) => a.id));
const occupancy = {
  gaps,
  holds: holds.filter((h) => !teamAgendas.has(h.agendaId)),
  appointments: appointments.map((a) => ({ agendaId: a.agendaId, date: localDateOf(a.scheduledAt, clinic.timezone), status: a.status })),
  holidays,
  today,
  now,
};

// Agenda desativada só aparece se tiver atendimento na semana.
const rows = filtered.columns
  .map((column) => ({ column, cells: days.map((day) => occupancyCell(column.id, day, occupancy)) }))
  .filter(({ column, cells }) => column.isActive || cells.some((c) => c.kind === "open" && c.booked > 0));
const groups: { name: string; rows: typeof rows }[] = [];
for (const row of rows) {
  const last = groups[groups.length - 1];
  if (last?.name === row.column.group) last.rows.push(row);
  else groups.push({ name: row.column.group, rows: [row] });
}
const totals = days.map((_, i) => dayFree(rows.map((r) => r.cells[i])));

// Endereços: a mesma Semana com o filtro trocado.
type Link = { date?: string; agenda?: string | null; esp?: string | null };
const link = (change: Link = {}) => {
  const next = { date, agenda: chosenAgendaId, esp: specialty, ...change };
  const query = new URLSearchParams();
  query.set("date", next.date);
  if (next.agenda) query.set("agenda", next.agenda);
  if (next.esp) query.set("esp", next.esp);
  return `/admin/agenda/semana?${query}`;
};
const dayHref = (day: string, agendaId?: string) =>
  `/admin/agenda?date=${day}${agendaId ? `&agenda=${agendaId}` : specialty ? `&esp=${encodeURIComponent(specialty)}` : chosenAgendaId ? `&agenda=${chosenAgendaId}` : ""}`;
const groupsOf = (href: (id: string) => string) => {
  const list: { name: string | null; options: { label: string; terms?: string; href: string; current: boolean }[] }[] = [];
  for (const column of allColumns.filter((c) => c.isActive)) {
    let group = list.find((g) => g.name === column.group);
    if (!group) list.push((group = { name: column.group, options: [] }));
    group.options.push({ label: column.name, terms: column.specialties.join(" "), href: href(column.id), current: column.id === chosenAgendaId });
  }
  return list;
};
const freeHref = withReturn(`/admin/agenda/livres?date=${date < today ? today : date}${specialty ? `&esp=${encodeURIComponent(specialty)}` : ""}`, link());

const title = `${formatCalendarDate(days[0], "d 'de' MMMM")} a ${formatCalendarDate(days[6], days[6].slice(0, 4) === today.slice(0, 4) ? "d 'de' MMMM" : "d 'de' MMMM 'de' yyyy")}`;
const dayName = (day: string) => `${formatCalendarDate(day, "EEE").slice(0, 3)} ${formatCalendarDate(day, "dd/MM")}`;
const totalText = (t: (typeof totals)[number]) => (t === null ? "Sem atendimento" : t.holiday ? "Feriado" : `${t.free} ${t.free === 1 ? "livre" : "livres"}`);
const barClass = (cell: OccupancyCell) => {
  const pct = occupancyPercent(cell);
  return pct >= 100 ? "bg-att-800" : pct >= 75 ? "bg-att-500" : "bg-att-500/55";
};
const cellAria = (name: string, day: string, cell: OccupancyCell) =>
  `${name}, ${formatCalendarDate(day, "EEEE, dd/MM")}: ${
    cell.kind === "holiday" ? "feriado" : cell.kind === "closed" ? "sem atendimento" : `${cell.booked} de ${cell.total} marcados${freeText(cell) ? `, ${freeText(cell).toLowerCase()}` : ""}`
  }`;
const HATCH = "background-image:repeating-linear-gradient(135deg,var(--color-blk-50) 0 6px,#fff 6px 12px)";
// Celular: o dia escolhido (o da data aberta).
const phoneDay = days.includes(date) ? date : days[0];
const phoneIndex = days.indexOf(phoneDay);
---

<AdminLayout title="Agenda · Semana" edge>
  <AgendaHeader view="semana" date={date} agendas={scope.selectable} selectedAgendaId={chosenAgendaId}>
    <div slot="nav" class="flex items-center gap-1.5">
      <Button href={link({ date: addDays(monday, -7) })} aria-label="Semana anterior" class="w-9 px-0">
        <Icon name="chevron-left" class="h-5 w-5 shrink-0" strokeWidth={2.2} />
      </Button>
      <Button href={link({ date: today })} aria-current={days.includes(today) ? "date" : undefined} class="px-3">Hoje</Button>
      <Button href={link({ date: addDays(monday, 7) })} aria-label="Próxima semana" class="w-9 px-0">
        <Icon name="chevron-right" class="h-5 w-5 shrink-0" strokeWidth={2.2} />
      </Button>
    </div>
    <h1 slot="title" class="font-display text-[18px] leading-tight font-bold whitespace-nowrap text-ink xl:text-[19px]">{title}</h1>
    <Fragment slot="filters">
      {
        many ? (
          <>
            <ColumnPicker
              id="filtro-especialidade"
              label="Especialidade"
              allText="todas"
              allHref={link({ esp: null, agenda: null })}
              groups={[{ name: null, options: specialtyOptions(allColumns).map((name) => ({ label: name, href: link({ esp: name, agenda: null }), current: name === specialty })) }]}
              currentText={specialty}
              searchPlaceholder="Buscar especialidade"
            />
            <div class="contents max-sm:hidden">
              <ColumnPicker
                id="filtro-profissional"
                label="Profissional"
                allText="todos"
                allHref={link({ agenda: null, esp: null })}
                groups={groupsOf((id) => link({ agenda: id, esp: null }))}
                currentText={chosenAgendaId ? (scope.agendaNames.get(chosenAgendaId) ?? null) : null}
                searchPlaceholder="Nome ou especialidade"
              />
            </div>
          </>
        ) : (
          scope.selectable.length > 1 && (
            <form method="GET" action="/admin/agenda/semana">
              <input type="hidden" name="date" value={date} />
              <label for="agenda_choice" class="sr-only">
                Agenda
              </label>
              <select id="agenda_choice" name="agenda" class={`${CONTROL} w-full sm:w-56`} data-autosubmit>
                <option value="" selected={!chosenAgendaId}>
                  Todas as agendas
                </option>
                {scope.selectable.map((agenda) => (
                  <option value={agenda.id} selected={agenda.id === chosenAgendaId}>
                    {agenda.name}
                  </option>
                ))}
              </select>
              <noscript>
                <button type="submit" class="ml-2 text-sm text-brand">
                  Ver
                </button>
              </noscript>
            </form>
          )
        )
      }
      <Button href={freeHref} class="border-brand text-brand-ink sm:ml-auto max-sm:w-full max-sm:bg-conf-50">
        <Icon name="magnifying-glass" class="h-[18px] w-[18px]" strokeWidth={2.2} /> Próximos horários livres
      </Button>
    </Fragment>
  </AgendaHeader>

  <p class="mt-3 text-[14.5px] text-ink-soft max-md:hidden">Cada quadro mostra quanto da agenda do dia já está marcado. Toque num quadro para abrir o Dia daquele profissional.</p>
  {failed && <p class="mt-2 text-[14.5px] text-can-800">Os horários livres não carregaram agora. Os marcados aparecem; recarregue a página para ver os livres.</p>}

  <ul class="mt-2 flex flex-wrap gap-x-3.5 gap-y-1.5 text-[13.5px] text-ink-mid" aria-label="Legenda">
    <li class="flex items-center gap-1.5"><span class="h-1.5 w-6 rounded-sm bg-att-500/55"></span>Marcados</li>
    <li class="flex items-center gap-1.5"><span class="h-1.5 w-6 rounded-sm bg-att-500"></span>Quase cheio (75% ou mais)</li>
    <li class="flex items-center gap-1.5"><span class="h-1.5 w-6 rounded-sm bg-att-800"></span>Cheio</li>
    <li class="flex items-center gap-1.5"><span class="h-3.5 w-3.5 rounded border border-blk-200" style={HATCH}></span>Sem atendimento ou feriado</li>
  </ul>

  {
    rows.length === 0 ? (
      <p class="mt-4 rounded-xl border border-line bg-white p-4 text-ink-soft">Nenhuma agenda para mostrar.</p>
    ) : (
      <>
        {/* Computador: o quadro da semana. */}
        <section aria-label="Ocupação da semana" class="mt-3 overflow-hidden rounded-xl border border-line bg-white max-md:hidden">
          <div class="grid grid-cols-[minmax(150px,220px)_repeat(7,minmax(0,1fr))] border-b border-line">
            <div class="px-3 py-2 text-[13px] font-bold text-ink-soft">Profissional</div>
            {days.map((day, i) => (
              <a
                href={dayHref(day)}
                aria-current={day === today ? "date" : undefined}
                class={`block border-l border-line px-2.5 py-1.5 no-underline hover:bg-brand-soft/40 ${day === today ? "bg-brand-soft text-brand-ink shadow-[inset_0_-3px_0_var(--color-brand)]" : "text-ink"}`}
              >
                <span class="block text-[14.5px] font-bold capitalize">{dayName(day)}</span>
                <span class="block text-[12.5px] text-ink-soft">{day < today && totals[i] && !totals[i]!.holiday ? "—" : totalText(totals[i])}</span>
              </a>
            ))}
          </div>
          {groups.map((group) => (
            <>
              <div class="bg-canvas-deep px-3 py-0.5 text-[12.5px] font-bold text-ink-soft">{group.name}</div>
              {group.rows.map(({ column, cells }) => (
                <div class="grid grid-cols-[minmax(150px,220px)_repeat(7,minmax(0,1fr))] border-b border-line last:border-b-0">
                  <div class="truncate px-3 py-1.5 text-[14.5px] font-bold text-ink" title={column.name}>
                    {column.name}
                  </div>
                  {cells.map((cell, i) =>
                    cell.kind === "open" ? (
                      <a
                        href={dayHref(days[i], column.id)}
                        aria-label={cellAria(column.name, days[i], cell)}
                        class={`block border-l border-line px-2 py-1.5 text-ink no-underline hover:bg-brand-soft/40 ${days[i] === today ? "bg-conf-50/80" : ""}`}
                      >
                        <span class="flex justify-between gap-1 text-[12.5px]">
                          <b class="tabular-nums">
                            {cell.booked} de {cell.total}
                          </b>
                          <span class="font-semibold text-brand-ink">{freeText(cell)}</span>
                        </span>
                        <span class="mt-1 block h-1.5 overflow-hidden rounded-sm bg-blk-100">
                          <span class={`block h-full ${barClass(cell)}`} style={`width:${occupancyPercent(cell)}%`} />
                        </span>
                      </a>
                    ) : (
                      <a
                        href={dayHref(days[i], column.id)}
                        aria-label={cellAria(column.name, days[i], cell)}
                        class="flex items-center border-l border-line px-2 py-1.5 text-[12.5px] text-ink-soft no-underline"
                        style={HATCH}
                      >
                        {cell.kind === "holiday" ? "Feriado" : "—"}
                      </a>
                    ),
                  )}
                </div>
              ))}
            </>
          ))}
        </section>

        {/* Celular: um dia por vez. */}
        <div class="mt-3 md:hidden">
          <nav aria-label="Dias da semana" class="grid grid-cols-7 gap-1">
            {days.map((day, i) => (
              <a
                href={link({ date: day })}
                aria-current={day === phoneDay ? "page" : undefined}
                class={`block min-h-11 rounded-[10px] border py-1 text-center no-underline ${
                  day === phoneDay ? "border-brand bg-brand text-white" : totals[i] === null || totals[i]!.holiday ? "border-line bg-blk-50 text-ink-soft" : "border-line bg-white text-ink"
                }`}
              >
                <span class="block text-[12.5px]">{formatCalendarDate(day, "EEE").slice(0, 3)}</span>
                <b class="block text-base leading-tight">{day.slice(8)}</b>
                <span class="block text-[11.5px] leading-tight">
                  {totals[i] === null ? "fechado" : totals[i]!.holiday ? "feriado" : day < today ? "—" : `${totals[i]!.free} ${totals[i]!.free === 1 ? "livre" : "livres"}`}
                </span>
              </a>
            ))}
          </nav>
          <p class="mt-2 text-[14px] text-ink">
            <b class="capitalize">{formatCalendarDate(phoneDay, "EEEE, dd/MM").replace("-feira", "")}</b>
            {totals[phoneIndex] && !totals[phoneIndex]!.holiday && phoneDay >= today && ` · ${totalText(totals[phoneIndex])}`}. Toque num profissional para abrir o dia dele.
          </p>
          <div class="mt-2 overflow-hidden rounded-xl border border-line bg-white">
            {groups.map((group) => (
              <>
                <div class="bg-canvas-deep px-3 py-0.5 text-[12.5px] font-bold text-ink-soft">{group.name}</div>
                {group.rows.map(({ column, cells }) => {
                  const cell = cells[phoneIndex];
                  return (
                    <a
                      href={dayHref(phoneDay, column.id)}
                      aria-label={cellAria(column.name, phoneDay, cell)}
                      class="flex min-h-11 items-center gap-2.5 border-b border-line px-3 py-1.5 text-ink no-underline last:border-b-0"
                    >
                      <span class="min-w-0 flex-1">
                        <b class="block truncate text-[15px]">{column.name}</b>
                        {cell.kind === "open" && (
                          <span class="mt-1 block h-1.5 overflow-hidden rounded-sm bg-blk-100">
                            <span class={`block h-full ${barClass(cell)}`} style={`width:${occupancyPercent(cell)}%`} />
                          </span>
                        )}
                      </span>
                      <span class="w-24 text-right text-[13px] leading-tight">
                        {cell.kind === "open" ? (
                          <>
                            <b class="block tabular-nums">
                              {cell.booked} de {cell.total}
                            </b>
                            <span class="font-semibold text-brand-ink">{freeText(cell)}</span>
                          </>
                        ) : (
                          <span class="text-ink-soft">{cell.kind === "holiday" ? "Feriado" : "Sem atendimento"}</span>
                        )}
                      </span>
                    </a>
                  );
                })}
              </>
            ))}
          </div>
        </div>
      </>
    )
  }
</AdminLayout>

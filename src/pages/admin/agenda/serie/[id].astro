---
// Agenda › Série (F4.6, D9): o combinado (paciente, serviço, agenda, local,
// frequência, dia, horário e fim), as sessões (passadas e próximas) e as
// datas puladas com o motivo, para remarcar à mão se quiser. Encerrar fica
// no cartão de uma sessão ("esta e as próximas") e aqui, a partir da próxima.
import { receivedReturn } from "../../../../lib/returnPath";
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import ConfirmDeleteDialog from "../../../../components/admin/ConfirmDeleteDialog.astro";
import FlashMessage from "../../../../components/admin/FlashMessage.astro";
import Icon from "../../../../components/admin/Icon.astro";
import { DANGER_BUTTON, PANEL, SECTION_TITLE } from "../../../../components/admin/config/formStyles";
import PageHeader from "../../../../components/admin/ui/PageHeader.astro";
import Pill, { type PillTone } from "../../../../components/admin/ui/Pill.astro";
import { isUuid } from "../../../../lib/clinicAccess";
import { formatCalendarDate, formatInstant } from "../../../../lib/clinicTime";
import { createUserClient } from "../../../../lib/data/clients";
import { getSeries, listSeriesSkips } from "../../../../lib/data/agenda/series";
import { listSeriesAppointments } from "../../../../lib/data/agenda/view";
import { listLocations } from "../../../../lib/data/config/locations";
import { frequencyLabel, seriesEndLabel, SKIP_REASON_LABELS } from "../../../../lib/seriesLabels";
import { WEEKDAY_NAMES } from "../../../../lib/data/config/availability";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const id = Astro.params.id!;
const series = isUuid(id) ? await getSeries(db, clinic.clinicId, id).catch(() => null) : null;
if (!series) return Astro.redirect("/admin/agenda");
const [sessions, skips, locations] = await Promise.all([
  listSeriesAppointments(db, clinic.clinicId, series.id),
  listSeriesSkips(db, clinic.clinicId, series.id),
  listLocations(db, clinic.clinicId, { includeInactive: true }),
]);
// Voltar: para a tela de onde veio (cliente, 10/out/2026).
const volta = receivedReturn(Astro.url);
const now = new Date();
const first = sessions[0];
const next = sessions.find((s) => (s.status === "scheduled" || s.status === "confirmed") && s.scheduledAt > now);
const statusPill: Record<string, { label: string; tone: PillTone }> = {
  scheduled: { label: "Marcada", tone: "info" },
  confirmed: { label: "Marcada", tone: "info" },
  canceled: { label: "Cancelada", tone: "danger" },
  completed: { label: "Compareceu", tone: "success" },
  no_show: { label: "Faltou", tone: "alert" },
};
const locationName = locations.find((l) => l.id === series.locationId)?.name ?? "Local";
---

<AdminLayout title="Série">
  <a
    href={volta ?? (next ? `/admin/agenda?date=${formatInstant(next.scheduledAt, clinic.timezone, "yyyy-MM-dd")}` : "/admin/agenda")}
    class="inline-flex min-h-8 items-center gap-1 text-[15px] font-semibold text-brand no-underline hover:underline"
  >
    <Icon name="chevron-left" class="h-[18px] w-[18px]" strokeWidth={2.2} />
    {volta ? "Voltar" : "Agenda"}
  </a>
  <PageHeader title={series.endedAt ? "Série encerrada" : "Série"} class="mt-2" />
  <FlashMessage />

  <div class="mt-4 flex max-w-2xl flex-col gap-4">
    <section class={PANEL}>
      <p class="text-lg leading-snug font-semibold text-ink">{first?.patientName ?? "Paciente"}</p>
      <p class="text-[15px] text-ink-soft">
        {first?.serviceName ?? "Serviço"} · {first?.agendaName ?? "Agenda"} · {locationName}
      </p>
      <p class="mt-1.5 text-[15px] text-ink">
        {frequencyLabel(series.intervalWeeks)}, {WEEKDAY_NAMES[series.weekday].toLowerCase()} às {series.startTime}, desde{" "}
        {formatCalendarDate(series.startsOn, "dd/MM/yyyy")}, {seriesEndLabel(series)}.
      </p>
      {
        series.endedAt && (
          <p class="mt-1 text-[15px] text-ink-soft">Encerrada em {formatInstant(series.endedAt, clinic.timezone, "dd/MM/yyyy")}.</p>
        )
      }
      {
        !series.endedAt && next && (
          <form method="POST" action={`/api/admin/agenda/atendimentos/${next.id}`} class="mt-3 border-t border-[#e6ecea] pt-3">
            <input type="hidden" name="acao" value="encerrar_serie" />
            <input type="hidden" name="return_to" value={volta ?? "/admin/agenda"} />
            <button
              type="submit"
              class={`${DANGER_BUTTON} js-confirm-delete`}
              data-confirm-title="Encerrar a série?"
              data-confirm-message={`A próxima sessão (${formatInstant(next.scheduledAt, clinic.timezone, "dd/MM 'às' HH:mm")}) e as seguintes são canceladas. As que já passaram ficam como estão. O paciente é avisado pelo WhatsApp do cancelamento da primeira.`}
              data-confirm-label="Encerrar a série"
            >
              Encerrar a série
            </button>
          </form>
        )
      }
    </section>

    {
      skips.length > 0 && (
        <section aria-labelledby="puladas" class="rounded-xl border border-pend-200 bg-pend-50 p-4 text-pend-800 sm:px-5 sm:py-[18px]">
          <h2 id="puladas" class="font-display text-[17px] leading-tight font-bold sm:text-lg">Datas puladas</h2>
          <p class="mt-1 text-[15px]">Não viraram sessão. Se quiser, marque à mão em outro horário.</p>
          <ul class="mt-2 flex flex-col gap-0.5 text-[15px]">
            {skips.map((skip) => (
              <li>
                <span class="inline-block first-letter:uppercase">{formatCalendarDate(skip.date, "EEE dd/MM/yyyy")}</span>: {SKIP_REASON_LABELS[skip.reason]}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section aria-labelledby="sessoes" class={PANEL}>
      <h2 id="sessoes" class={SECTION_TITLE}>Sessões ({sessions.length})</h2>
      <ul class="mt-2 divide-y divide-[#e6ecea]">
        {
          sessions.map((s) => (
            <li class="flex min-h-11 items-center justify-between gap-2 py-1.5 text-[15px]">
              <a href={`/admin/agenda?date=${formatInstant(s.scheduledAt, clinic.timezone, "yyyy-MM-dd")}`} class="inline-block text-ink first-letter:uppercase hover:text-brand hover:underline">
                {formatInstant(s.scheduledAt, clinic.timezone, "EEE dd/MM/yyyy 'às' HH:mm")}
              </a>
              <Pill tone={statusPill[s.status].tone}>{statusPill[s.status].label}</Pill>
            </li>
          ))
        }
      </ul>
      {
        !series.endedAt && !series.endsOn && !series.maxSessions && (
          <p class="mt-2 text-sm text-ink-soft">Sem data para terminar: ficam marcadas as sessões dos próximos 3 meses; uma vez por dia, o sistema marca as que entram nesse prazo.</p>
        )
      }
    </section>
  </div>
  <ConfirmDeleteDialog />
</AdminLayout>

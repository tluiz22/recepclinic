---
// Relatórios virou a aba Atendimentos de Métricas (Fase 23 · etapa 4). Mantém
// links antigos: `?month=AAAA-MM` vira o período personalizado desse mês.
import { metricsUrl } from "../../lib/metrics/period";

function targetUrl(month: string | null): string {
  if (!month || !/^\d{4}-\d{2}$/.test(month)) return metricsUrl({ tab: "atendimentos", periodo: "mes" });
  const [year, monthNum] = month.split("-").map(Number);
  const last = new Date(Date.UTC(year, monthNum, 0)).toISOString().slice(0, 10);
  return metricsUrl({ tab: "atendimentos", periodo: "personalizado", de: `${month}-01`, ate: last });
}

return Astro.redirect(targetUrl(Astro.url.searchParams.get("month")));
---

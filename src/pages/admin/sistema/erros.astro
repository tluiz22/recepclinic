---
// Erros (F9.3, L45): o Suporte vê as rotinas do agendador (última execução) e
// os erros gravados pelo servidor, com a clínica de cada um. Tudo já sem dados
// pessoais (src/lib/log.ts); os erros ficam 90 dias. O aviso por e-mail vem do
// monitor externo (Better Stack), que olha /api/saude e /api/saude/erros.
// R10 (cliente, 17/out/2026): rotinas e erros em linhas, selo com ícone e
// texto, o resumo das atrasadas no título e o filtro com rótulo à vista.
import AdminLayout from "../../../layouts/AdminLayout.astro";
import SystemHeader from "../../../components/admin/sistema/SystemHeader.astro";
import Pill from "../../../components/admin/ui/Pill.astro";
import { CARD, LABEL, SECONDARY_BUTTON, SECTION_TITLE } from "../../../components/admin/config/formStyles";
import { CONTROL } from "../../../components/admin/ui/styles";
import { DEFAULT_TIMEZONE, formatInstant } from "../../../lib/clinicTime";
import { isUuid } from "../../../lib/clinicAccess";
import { createUserClient } from "../../../lib/data/clients";
import { listClinicsOverview } from "../../../lib/data/onboarding";
import { listCronHeartbeats, listSystemErrors } from "../../../lib/data/systemErrors";
import { CRON_JOBS, checkCronJobs } from "../../../lib/health";

const db = createUserClient(Astro.request, Astro.cookies);
const chosen = Astro.url.searchParams.get("clinica");
const clinicId = chosen && isUuid(chosen) ? chosen : null;
const [clinics, beats, errors] = await Promise.all([listClinicsOverview(db), listCronHeartbeats(db), listSystemErrors(db, { clinicId })]);
const checks = checkCronJobs(beats, new Date());
const beatOf = new Map(beats.map((beat) => [beat.job, beat]));
const when = (date: Date) => formatInstant(date, DEFAULT_TIMEZONE, "dd/MM/yyyy 'às' HH:mm:ss");
const late = checks.filter((check) => !check.ok).length;
const ROW = "border-t border-[#e6ecea] px-4 py-3 sm:px-5";
---

<AdminLayout title="Erros" platform>
  <SystemHeader title="Erros" subtitle="Rotinas automáticas e erros do servidor, sem dados de pacientes. Os erros ficam 90 dias. Horários de Brasília." />

  <div class="mt-5 flex flex-col gap-4">
    <section class={`${CARD} overflow-hidden`} aria-labelledby="t-rotinas">
      <div class="flex flex-wrap items-center justify-between gap-3 px-4 pt-4 pb-3 sm:px-5">
        <h2 id="t-rotinas" class={SECTION_TITLE}>Rotinas</h2>
        {
          late > 0 ? (
            <Pill tone="danger" icon="warning">
              {`${late} ${late === 1 ? "atrasada" : "atrasadas"}`}
            </Pill>
          ) : (
            <Pill tone="success" icon="check-circle">
              Todas em dia
            </Pill>
          )
        }
      </div>
      <ul>
        {
          checks.map((check) => {
            const beat = beatOf.get(check.job);
            return (
              <li class={`${ROW} grid gap-x-4 gap-y-1.5 text-[15px] sm:grid-cols-[minmax(0,1.2fr)_minmax(0,1.6fr)_auto] sm:items-center`}>
                <span>
                  <strong class="text-ink">{check.job}</strong>
                  <span class="block text-sm text-ink-soft">{CRON_JOBS[check.job].every}</span>
                </span>
                <span class="text-ink-soft">
                  {beat ? (
                    <>
                      {when(beat.lastFinishedAt)} · {beat.clinics} {beat.clinics === 1 ? "clínica" : "clínicas"}
                      {beat.errors > 0 && <strong class="text-danger">, {beat.errors} com erro</strong>}
                    </>
                  ) : (
                    "—"
                  )}
                </span>
                <span class="sm:justify-self-end">
                  {check.ok ? (
                    <Pill tone="success" icon="check-circle">
                      Em dia
                    </Pill>
                  ) : (
                    <Pill tone="danger" icon="warning">
                      {check.lastFinishedAt ? `Atrasada ${check.minutesLate} min` : "Sem execução"}
                    </Pill>
                  )}
                </span>
              </li>
            );
          })
        }
      </ul>
    </section>

    <section class={`${CARD} overflow-hidden`} aria-labelledby="t-erros">
      <div class="flex flex-wrap items-end justify-between gap-3 px-4 pt-4 pb-3 sm:px-5">
        <h2 id="t-erros" class={SECTION_TITLE}>Erros recentes</h2>
        <form method="get" class="flex items-end gap-2">
          <div>
            <label for="clinica" class={LABEL}>Clínica</label>
            <select id="clinica" name="clinica" class={`mt-1.5 w-full sm:w-72 ${CONTROL}`} data-autosubmit>
              <option value="">Todas</option>
              {clinics.map((clinic) => <option value={clinic.id} selected={clinic.id === clinicId}>{clinic.name}</option>)}
            </select>
          </div>
          <noscript><button type="submit" class={SECONDARY_BUTTON}>Mostrar</button></noscript>
        </form>
      </div>
      {
        errors.length === 0 ? (
          <p class={`${ROW} text-[15px] text-ink-soft`}>Nenhum erro registrado{clinicId ? " para esta clínica" : ""}.</p>
        ) : (
          <ul>
            {errors.map((error) => (
              <li class={`${ROW} flex flex-col gap-1.5 text-[15px]`}>
                <p class="flex flex-wrap items-center gap-2">
                  <span class="text-ink-soft">{when(error.occurredAt)}</span>
                  <strong class="break-all text-ink">{error.scope}</strong>
                  {error.clinicName ? <Pill tone="info">{error.clinicName}</Pill> : <Pill>Sem clínica</Pill>}
                </p>
                {error.message && <p class="font-mono text-[13.5px] leading-relaxed break-words text-ink-mid">{error.message}</p>}
                {Object.keys(error.ids).length > 0 && (
                  <p class="font-mono text-[13px] break-all text-ink-soft">
                    {Object.entries(error.ids)
                      .map(([key, value]) => `${key}=${value}`)
                      .join(" · ")}
                  </p>
                )}
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>
</AdminLayout>

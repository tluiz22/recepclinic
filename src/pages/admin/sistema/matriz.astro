---
// Matriz de acesso por clínica (F4.2, D11): o Administrador do sistema
// (Suporte RecepClinic) escolhe a clínica, marca o que ela tem liberado e vê o
// histórico de mudanças. Clínica nova começa com tudo desligado; o básico do
// consultório é sempre ligado.
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Card from "../../../components/admin/Card.astro";
import FormMessage from "../../../components/admin/FormMessage.astro";
import { formatInstant, DEFAULT_TIMEZONE } from "../../../lib/clinicTime";
import { createUserClient } from "../../../lib/data/clients";
import { listClinicsAccess, listFeatureChanges, listPlatformStaffNames, listProfessionalLimitChanges } from "../../../lib/data/features";
import { featureLabel } from "../../../lib/features";
import { formatCentsBRL } from "../../../lib/money";
import { ADDONS, ALL_ITEMS, BASIC_ITEMS, OFF_TABLE, PLAN_ITEM_IDS, PLAN_LABELS, PRICES, clinicPlan, itemDependsOn, itemIsOn } from "../../../lib/plans";

const db = createUserClient(Astro.request, Astro.cookies);
const [clinics, staffNames] = await Promise.all([listClinicsAccess(db), listPlatformStaffNames(db)]);
const selectedId = Astro.url.searchParams.get("clinica");
const selected = clinics.find((clinic) => clinic.id === selectedId) ?? null;

let timeZone = DEFAULT_TIMEZONE;
// Histórico: itens liberados e desligados, e mudanças do limite de profissionais.
let history: { at: Date; actorId: string; text: string; strong: string }[] = [];
if (selected) {
  const [settings, changes, limitChanges] = await Promise.all([
    db.from("clinic_settings").select("timezone").eq("clinic_id", selected.id).maybeSingle(),
    listFeatureChanges(db, selected.id, 50),
    listProfessionalLimitChanges(db, selected.id, 50),
  ]);
  timeZone = settings.data?.timezone ?? DEFAULT_TIMEZONE;
  history = [
    ...changes.map((c) => ({ at: c.at, actorId: c.actorId, text: c.enabled ? "liberou" : "desligou", strong: featureLabel(c.feature) })),
    ...limitChanges.map((c) => ({ at: c.at, actorId: c.actorId, text: `mudou o limite de profissionais de ${c.from} para`, strong: String(c.to) })),
  ]
    .sort((a, b) => b.at.getTime() - a.at.getTime())
    .slice(0, 50);
}
const grants = new Map((selected?.features ?? []).map((grant) => [grant.key, grant]));
const when = (date: Date) => formatInstant(date, timeZone, "dd/MM/yyyy 'às' HH:mm");
// Pessoa que saiu da lista do Suporte continua no histórico, sem o nome.
const who = (userId: string) => staffNames.get(userId) ?? "ex-integrante do Suporte";
// Sem pessoa: liberado pela plataforma (ex.: dados de teste).
const grantedBy = (userId: string | null) => (userId ? `por ${who(userId)}` : "pela plataforma");

// Itens agrupados como são vendidos (planos, cliente, 11/out/2026): as
// métricas e as mensagens personalizadas ligam juntas.
const groups = [
  { label: "Incluído no Básico", items: BASIC_ITEMS },
  { label: "Adicionais", items: ADDONS },
  { label: "Fora da tabela de preços", items: OFF_TABLE },
];
const enabledKeys = (selected?.features ?? []).map((grant) => grant.key);
const plan = selected ? clinicPlan(enabledKeys, selected.maxProfessionals) : null;
const PLAN_OPTIONS = [
  { value: "basic", label: "Básico", hint: `${formatCentsBRL(PRICES.basicCents)} com 1 profissional` },
  { value: "complete", label: "Completo", hint: `${formatCentsBRL(PRICES.completeCents)} com 1 profissional` },
  { value: "custom", label: "Básico + adicionais", hint: "marque os adicionais abaixo" },
];

const erro = Astro.url.searchParams.get("erro");
const ERRORS: Record<string, string> = {
  dependencia: "Algum item ficou sem o item de que depende (ex.: lista de espera sem o bot). Nada foi salvo.",
  limite: "O limite de profissionais precisa ser de pelo menos 1. Nada foi salvo.",
  clinica: "Clínica não encontrada.",
  falha: "Não foi possível salvar. Tente de novo.",
};
const saved = Astro.url.searchParams.get("salvo") === "1";
---

<AdminLayout title="Matriz de acesso" platform>
  <h1 class="text-2xl font-bold text-slate-900">Matriz de acesso</h1>
  <p class="mt-2 text-slate-600">
    O que cada clínica tem liberado. Sempre ligado em toda clínica: agenda (dia, semana, mês), bloqueios e trilha;
    marcar, remarcar e cancelar consulta e retorno; pacientes; Resumo do dia e comparecimento; configurações básicas.
  </p>

  {erro && ERRORS[erro] && <FormMessage tone="error">{ERRORS[erro]}</FormMessage>}
  {saved && <FormMessage tone="success">Matriz salva.</FormMessage>}

  {
    !selected ? (
      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {clinics.map((clinic) => (
          <li>
            <a href={`/admin/sistema/matriz?clinica=${clinic.id}`}>
              <Card class="hover:border-sky-300 hover:bg-sky-50">
                <p class="font-medium text-slate-900">{clinic.name}</p>
                <p class="mt-1 text-sm text-slate-600">
                  {clinic.features.length === 0
                    ? "Nada liberado (só o básico)"
                    : `${clinic.features.length} ${clinic.features.length === 1 ? "item liberado" : "itens liberados"}`}
                  {` · ${clinic.activeProfessionals} de ${clinic.maxProfessionals} profissionais`}
                  {clinic.status === "suspended" ? " · suspensa" : ""}
                </p>
              </Card>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <>
        <a href="/admin/sistema/matriz" class="mt-6 inline-block text-sm text-sky-700 hover:underline">
          ← Todas as clínicas
        </a>
        <h2 class="mt-2 text-xl font-semibold text-slate-900">{selected.name}</h2>

        <form method="POST" action="/api/admin/sistema/matriz" class="mt-4 flex flex-col gap-4" id="matriz">
          <input type="hidden" name="clinicId" value={selected.id} />
          <Card>
            <label for="max_professionals" class="text-sm font-semibold uppercase tracking-wide text-slate-500">
              Limite de profissionais ativos
            </label>
            <div class="mt-2 flex items-center gap-3">
              <input
                type="number"
                id="max_professionals"
                name="max_professionals"
                min="1"
                required
                value={selected.maxProfessionals}
                class="w-24 rounded-lg border border-slate-300 px-3 py-2 text-sm"
              />
              <span class="text-sm text-slate-600">{selected.activeProfessionals} ativos agora</span>
            </div>
            {selected.activeProfessionals > selected.maxProfessionals && (
              <p class="mt-2 text-xs text-amber-700">
                A clínica está acima do limite: ninguém é desativado, mas ela não cadastra nem reativa profissional até ficar abaixo.
              </p>
            )}
            <p class="mt-2 text-xs text-slate-500">Desativar um profissional libera a vaga.</p>
          </Card>
          <Card>
            <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Plano</h3>
            <p class="mt-1 text-xs text-slate-500">
              Escolher o Básico ou o Completo marca os itens abaixo; nada é salvo até "Salvar matriz". Valores na tela{" "}
              <a href="/admin/sistema/planos" class="text-sky-700 hover:underline">Planos</a>.
            </p>
            <div class="mt-3 flex flex-col gap-2 sm:flex-row sm:gap-6">
              {PLAN_OPTIONS.map((option) => (
                <label class="flex items-start gap-2">
                  <input type="radio" name="plan" value={option.value} checked={plan?.kind === option.value} class="mt-1 h-4 w-4" />
                  <span>
                    <span class="block text-sm font-medium text-slate-900">{option.label}</span>
                    <span class="block text-xs text-slate-500">{option.hint}</span>
                  </span>
                </label>
              ))}
            </div>
            <p class="mt-3 text-sm text-slate-700" id="plan-summary" data-basic={PRICES.basicCents} data-complete={PRICES.completeCents} data-extra={PRICES.extraProfessionalCents}>
              {plan?.kind === "none" || !plan
                ? "Fora dos planos: falta algum item do Básico."
                : `${PLAN_LABELS[plan.kind]} · mensalidade de referência ${formatCentsBRL(plan.monthlyCents)} com ${selected.maxProfessionals} ${selected.maxProfessionals === 1 ? "profissional" : "profissionais"}`}
            </p>
            <p class="mt-1 text-xs text-amber-700" id="plan-cheaper" hidden={!(plan && plan.kind !== "none" && plan.completeIsCheaper)}>
              A soma passou do Completo: ofereça o Completo.
            </p>
            <p class="mt-1 text-xs text-slate-500">Mensagens da Meta à parte, cobradas direto da clínica. Profissionais pelo limite contratado.</p>
          </Card>
          {groups.map(({ label, items }) => (
            <Card>
              <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500">{label}</h3>
              <ul class="mt-3 flex flex-col gap-3">
                {items.map((item) => {
                  const grant = item.features.map((key) => grants.get(key)).find(Boolean);
                  const deps = itemDependsOn(item);
                  return (
                    <li>
                      <label class="flex items-start gap-3">
                        <input
                          type="checkbox"
                          name="item"
                          value={item.id}
                          checked={itemIsOn(item, enabledKeys)}
                          data-depends={deps.join(" ")}
                          data-price={item.priceCents ?? ""}
                          data-addon={ADDONS.includes(item) ? "1" : ""}
                          class="mt-1 h-4 w-4 rounded border-slate-300"
                        />
                        <span>
                          <span class="block text-sm font-medium text-slate-900">
                            {item.label}
                            {item.priceCents !== null && <span class="font-normal text-slate-500"> · {formatCentsBRL(item.priceCents)}/mês</span>}
                          </span>
                          {deps.length > 0 && (
                            <span class="block text-xs text-slate-500">Depende de: {deps.map((id) => ALL_ITEMS.find((other) => other.id === id)?.label ?? id).join(", ")}</span>
                          )}
                          {grant && (
                            <span class="block text-xs text-slate-500">
                              Liberado em {when(grant.enabledAt)} {grantedBy(grant.enabledBy)}
                            </span>
                          )}
                        </span>
                      </label>
                    </li>
                  );
                })}
              </ul>
            </Card>
          ))}
          <button type="submit" class="self-start rounded-md bg-sky-700 px-4 py-2 text-sm font-medium text-white hover:bg-sky-800">
            Salvar matriz
          </button>
        </form>

        <h2 class="mt-8 text-sm font-semibold uppercase tracking-wide text-slate-500">Histórico de mudanças</h2>
        {history.length === 0 ? (
          <p class="mt-2 text-sm text-slate-600">Nenhuma mudança registrada.</p>
        ) : (
          <ul class="mt-2 flex flex-col gap-1 text-sm text-slate-700">
            {history.map((change) => (
              <li>
                {when(change.at)} · {who(change.actorId)} {change.text} <strong>{change.strong}</strong>
              </li>
            ))}
          </ul>
        )}
      </>
    )
  }

  <script is:inline define:vars={{ planIds: PLAN_ITEM_IDS }}>
    // Marcar um item marca o de que ele depende; desmarcar desmarca os que
    // dependem dele (o servidor confere de novo). O plano marca os itens e a
    // mensalidade de referência acompanha (a tela Planos tem a regra).
    const boxes = [...document.querySelectorAll("#matriz input[name=item]")];
    const radios = [...document.querySelectorAll("#matriz input[name=plan]")];
    const limit = document.querySelector("#max_professionals");
    const summary = document.querySelector("#plan-summary");
    const cheaper = document.querySelector("#plan-cheaper");
    const byKey = new Map(boxes.map((box) => [box.value, box]));
    const dependsOn = (box) => (box.dataset.depends ?? "").split(" ").filter(Boolean);
    const check = (box) => {
      box.checked = true;
      dependsOn(box).forEach((key) => {
        const dep = byKey.get(key);
        if (dep && !dep.checked) check(dep);
      });
    };
    const uncheck = (box) => {
      box.checked = false;
      boxes.filter((other) => other.checked && dependsOn(other).includes(box.value)).forEach(uncheck);
    };
    const brl = (cents) => (cents / 100).toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
    const refresh = () => {
      const on = new Set(boxes.filter((box) => box.checked).map((box) => box.value));
      const addons = boxes.filter((box) => box.dataset.addon);
      const professionals = Math.max(1, Number(limit?.value) || 1);
      const extra = (professionals - 1) * Number(summary.dataset.extra);
      let kind = "none";
      if (planIds.basic.every((id) => on.has(id))) {
        const chosen = addons.filter((box) => box.checked);
        const offTable = boxes.filter((box) => box.checked && !box.dataset.addon && !planIds.basic.includes(box.value));
        kind = chosen.length === addons.length ? "complete" : chosen.length || offTable.length ? "custom" : "basic";
        const sum = Number(summary.dataset.basic) + chosen.reduce((total, box) => total + Number(box.dataset.price || 0), 0);
        const monthly = (kind === "complete" ? Number(summary.dataset.complete) : sum) + extra;
        const label = { basic: "Básico", complete: "Completo", custom: "Básico + adicionais" }[kind];
        summary.textContent = `${label} · mensalidade de referência ${brl(monthly)} com ${professionals} ${professionals === 1 ? "profissional" : "profissionais"}`;
        cheaper.hidden = !(kind !== "complete" && sum > Number(summary.dataset.complete));
      } else {
        summary.textContent = "Fora dos planos: falta algum item do Básico.";
        cheaper.hidden = true;
      }
      radios.forEach((radio) => (radio.checked = radio.value === kind));
    };
    boxes.forEach((box) =>
      box.addEventListener("change", () => {
        box.checked ? check(box) : uncheck(box);
        refresh();
      }),
    );
    radios.forEach((radio) =>
      radio.addEventListener("change", () => {
        if (radio.value === "custom") {
          planIds.basic.forEach((id) => byKey.get(id) && check(byKey.get(id)));
        } else {
          const ids = radio.value === "basic" ? planIds.basic : planIds.complete;
          boxes.forEach((box) => (box.checked = ids.includes(box.value)));
        }
        refresh();
        if (radio.value === "custom") radio.checked = true;
      }),
    );
    limit?.addEventListener("input", refresh);
  </script>
</AdminLayout>

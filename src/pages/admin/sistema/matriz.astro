---
// Matriz de acesso por clínica (F4.2, D11): o Administrador do sistema
// (Suporte RecepClinic) escolhe a clínica, marca o que ela tem liberado e vê o
// histórico de mudanças. Clínica nova começa com tudo desligado; o básico do
// consultório é sempre ligado. R10 (cliente, 17/out/2026): lista em linhas; na
// clínica, os itens à esquerda por grupo e o plano, o limite, a mensalidade e
// "Salvar matriz" à direita, acompanhando a rolagem (no celular, na barra fixa).
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Badge from "../../../components/admin/config/Badge.astro";
import FormMessage from "../../../components/admin/FormMessage.astro";
import Icon from "../../../components/admin/Icon.astro";
import SystemHeader from "../../../components/admin/sistema/SystemHeader.astro";
import { CARD, CHECK, HEAD_ROW, INPUT_INLINE, LABEL, LIST, ROW, ROW_GO, ROW_NAME, PRIMARY_BUTTON, SECTION_TITLE } from "../../../components/admin/config/formStyles";
import { TABLE } from "../../../components/admin/ui/styles";
import { formatInstant, DEFAULT_TIMEZONE } from "../../../lib/clinicTime";
import { createUserClient } from "../../../lib/data/clients";
import { listClinicsAccess, listFeatureChanges, listPlatformStaffNames, listProfessionalLimitChanges } from "../../../lib/data/features";
import { featureLabel } from "../../../lib/features";
import { formatCentsBRL } from "../../../lib/money";
import { ADDONS, ALL_ITEMS, BASIC_ITEMS, OFF_TABLE, PLAN_ITEM_IDS, PLAN_LABELS, PRICES, clinicPlan, itemDependsOn, itemIsOn } from "../../../lib/plans";
import HelpTip from "../../../components/admin/ui/HelpTip.astro";
import { itensDaMatriz } from "../../../lib/ajuda/sistema";

const db = createUserClient(Astro.request, Astro.cookies);
const [clinics, staffNames] = await Promise.all([listClinicsAccess(db), listPlatformStaffNames(db)]);
const selectedId = Astro.url.searchParams.get("clinica");
const selected = clinics.find((clinic) => clinic.id === selectedId) ?? null;

let timeZone = DEFAULT_TIMEZONE;
// Histórico: itens liberados e desligados, e mudanças do limite de profissionais.
let history: { at: Date; actorId: string; text: string; strong: string }[] = [];
if (selected) {
  const [settings, changes, limitChanges] = await Promise.all([
    db.from("clinic_settings").select("timezone").eq("clinic_id", selected.id).maybeSingle(),
    listFeatureChanges(db, selected.id, 50),
    listProfessionalLimitChanges(db, selected.id, 50),
  ]);
  timeZone = settings.data?.timezone ?? DEFAULT_TIMEZONE;
  history = [
    ...changes.map((c) => ({ at: c.at, actorId: c.actorId, text: c.enabled ? "liberou" : "desligou", strong: featureLabel(c.feature) })),
    ...limitChanges.map((c) => ({ at: c.at, actorId: c.actorId, text: `mudou o limite de profissionais de ${c.from} para`, strong: String(c.to) })),
  ]
    .sort((a, b) => b.at.getTime() - a.at.getTime())
    .slice(0, 50);
}
const grants = new Map((selected?.features ?? []).map((grant) => [grant.key, grant]));
const when = (date: Date) => formatInstant(date, timeZone, "dd/MM/yyyy 'às' HH:mm");
// Pessoa que saiu da lista do Suporte continua no histórico, sem o nome.
const who = (userId: string) => staffNames.get(userId) ?? "ex-integrante do Suporte";
// Sem pessoa: liberado pela plataforma (ex.: dados de teste).
const grantedBy = (userId: string | null) => (userId ? `por ${who(userId)}` : "pela plataforma");

// Itens agrupados como são vendidos (planos, cliente, 11/out/2026): as
// métricas e as mensagens personalizadas ligam juntas.
const groups = [
  { label: "Incluído no Básico", items: BASIC_ITEMS },
  { label: "Adicionais", items: ADDONS },
  { label: "Fora da tabela de preços", items: OFF_TABLE },
];
const enabledKeys = (selected?.features ?? []).map((grant) => grant.key);
const plan = selected ? clinicPlan(enabledKeys, selected.maxProfessionals) : null;
const PLAN_OPTIONS = [
  { value: "basic", label: "Básico", hint: `${formatCentsBRL(PRICES.basicCents)} com 1 profissional` },
  { value: "complete", label: "Completo", hint: `${formatCentsBRL(PRICES.completeCents)} com 1 profissional` },
  { value: "custom", label: "Básico + adicionais", hint: "marque os adicionais na lista" },
];

const erro = Astro.url.searchParams.get("erro");
const ERRORS: Record<string, string> = {
  dependencia: "Algum item ficou sem o item de que depende (ex.: lista de espera sem o bot). Nada foi salvo.",
  limite: "O limite de profissionais precisa ser de pelo menos 1. Nada foi salvo.",
  clinica: "Clínica não encontrada.",
  falha: "Não foi possível salvar. Tente de novo.",
};
const saved = Astro.url.searchParams.get("salvo") === "1";
// Aberta pela tela da clínica (teste da R10, NAV-06): o "Voltar" leva de volta
// a ela, também depois de salvar ou de um erro (a rota devolve o `de`).
const fromClinic = Astro.url.searchParams.get("de") === "clinica";
const itemsOn = (features: { key: string }[]) => {
  const keys = features.map((grant) => grant.key) as typeof enabledKeys;
  return ALL_ITEMS.filter((item) => itemIsOn(item, keys)).length;
};
const planLine = (features: { key: string }[], max: number) => {
  const kind = clinicPlan(features.map((grant) => grant.key) as typeof enabledKeys, max).kind;
  return kind;
};
const monthly = plan && plan.kind !== "none" ? formatCentsBRL(plan.monthlyCents) : "—";
const planText =
  plan?.kind === "none" || !plan
    ? "Fora dos planos: falta algum item do Básico."
    : `${PLAN_LABELS[plan.kind]} com ${selected!.maxProfessionals} ${selected!.maxProfessionals === 1 ? "profissional" : "profissionais"}.`;
const COLS = "lg:grid-cols-[minmax(0,2fr)_minmax(0,1.3fr)_150px_36px]";
---

<AdminLayout title={selected ? `Matriz de acesso · ${selected.name}` : "Matriz de acesso"} platform>
  {
    !selected ? (
      <>
        <SystemHeader
          title="Matriz de acesso"
          subtitle="O que cada clínica tem liberado. Sempre ligado em toda clínica: agenda (dia, semana, mês), bloqueios e trilha; marcar, remarcar e cancelar consulta e retorno; pacientes; Resumo do dia e comparecimento; configurações básicas."
        />
        {erro && ERRORS[erro] && <FormMessage tone="error">{ERRORS[erro]}</FormMessage>}
        <section aria-label="Clínicas" class={`mt-5 ${LIST}`}>
          <div aria-hidden="true" class={`${HEAD_ROW} ${COLS}`}>
            <span>Clínica</span>
            <span>Plano</span>
            <span>Profissionais</span>
            <span />
          </div>
          {clinics.map((clinic) => {
            const kind = planLine(clinic.features, clinic.maxProfessionals);
            const count = itemsOn(clinic.features);
            return (
              <div class={`${ROW} ${COLS}`}>
                <span class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1">
                  <a href={`/admin/sistema/matriz?clinica=${clinic.id}`} class={ROW_NAME}>
                    {clinic.name}
                  </a>
                  {kind === "none" && <Badge variant="warning">Fora dos planos</Badge>}
                  {clinic.status === "suspended" && <Badge variant="warning">Suspensa</Badge>}
                  {clinic.status === "onboarding" && <Badge variant="warning">Em implantação</Badge>}
                </span>
                <a href={`/admin/sistema/matriz?clinica=${clinic.id}`} class={ROW_GO} aria-label={`Abrir a matriz da ${clinic.name}`}>
                  <Icon name="chevron-right" class="h-5 w-5" strokeWidth={2.2} />
                </a>
                <span class="col-span-2 text-[15px] text-ink lg:col-span-1">
                  {clinic.features.length === 0 ? (
                    <span class="text-ink-soft">Nada liberado (só o básico)</span>
                  ) : (
                    `${kind === "none" ? "" : `${PLAN_LABELS[kind]} · `}${count} ${count === 1 ? "item" : "itens"}`
                  )}
                </span>
                <span class="col-span-2 text-[15px] text-ink tabular-nums lg:col-span-1">
                  {clinic.activeProfessionals} de {clinic.maxProfessionals}
                  <span class="text-ink-soft lg:hidden"> profissionais</span>
                </span>
              </div>
            );
          })}
        </section>
      </>
    ) : (
      <>
        <div class="flex flex-col">
          <SystemHeader
            title={selected.name}
            kicker="Matriz de acesso"
            back={fromClinic ? { href: `/admin/sistema/clinicas/${selected.id}`, label: selected.name } : { href: "/admin/sistema/matriz", label: "Todas as clínicas" }}
          >
            {
              !fromClinic && (
                <a slot="actions" href={`/admin/sistema/clinicas/${selected.id}`} class="inline-flex min-h-8 items-center text-[15px] font-semibold text-brand no-underline hover:underline">
                  Ver a clínica ›
                </a>
              )
            }
          </SystemHeader>
        </div>
        {/* `data-flash`: o keepFormValues devolve as marcações enviadas (teste da R10, FORM-09). */}
        {
          erro && ERRORS[erro] && (
            <div data-flash="error" data-fields={erro === "limite" ? "max_professionals" : undefined}>
              <FormMessage tone="error">{ERRORS[erro]}</FormMessage>
            </div>
          )
        }
        {saved && <FormMessage tone="success">Matriz salva.</FormMessage>}

        <form method="POST" action="/api/admin/sistema/matriz" id="matriz" class="mt-5 grid items-start gap-4 lg:grid-cols-[minmax(0,1fr)_340px] lg:gap-5">
          <input type="hidden" name="clinicId" value={selected.id} />
          {fromClinic && <input type="hidden" name="de" value="clinica" />}

          <aside class={`${CARD} flex flex-col gap-4 p-4 sm:p-5 lg:sticky lg:top-4 lg:col-start-2 lg:row-start-1`} aria-labelledby="t-plano">
            <h2 id="t-plano" class={SECTION_TITLE}>Plano</h2>
            <fieldset class="flex flex-col gap-2">
              <legend class="sr-only">Plano</legend>
              {PLAN_OPTIONS.map((option) => (
                <label class="flex cursor-pointer items-start gap-2.5 rounded-[10px] border border-line px-3 py-2.5 has-checked:border-brand has-checked:bg-[#f2faf7] has-checked:ring-1 has-checked:ring-brand">
                  <input type="radio" name="plan" value={option.value} checked={plan?.kind === option.value} class={`${CHECK} mt-0.5`} />
                  <span>
                    <span class="block text-[15.5px] font-bold text-ink">{option.label}</span>
                    <span class="block text-sm text-ink-soft">{option.hint}</span>
                  </span>
                </label>
              ))}
            </fieldset>
            <div>
              <label for="max_professionals" class={LABEL}>
                Limite de profissionais ativos
              </label>
              <div class="mt-1.5 flex items-center gap-3">
                <input type="number" id="max_professionals" name="max_professionals" min="1" required value={selected.maxProfessionals} class={`${INPUT_INLINE} w-24`} />
                <span class="text-[15px] text-ink-soft">
                  {selected.activeProfessionals} {selected.activeProfessionals === 1 ? "ativo" : "ativos"} agora
                </span>
              </div>
              {selected.activeProfessionals > selected.maxProfessionals && (
                <p class="mt-2 text-sm text-pend-800">
                  A clínica está acima do limite: ninguém é desativado, mas ela não cadastra nem reativa profissional até ficar abaixo.
                </p>
              )}
              <p class="mt-1.5 text-sm text-ink-soft">Desativar um profissional libera a vaga.</p>
            </div>
            <div class="flex flex-col gap-1 border-t border-[#e6ecea] pt-3.5">
              <span class="text-sm text-ink-soft">Mensalidade de referência</span>
              <span data-plan-total class="font-display text-[28px] leading-tight font-bold text-ink tabular-nums">
                {monthly}
              </span>
              <span class="text-sm text-ink-soft">
                <span id="plan-summary" data-basic={PRICES.basicCents} data-complete={PRICES.completeCents} data-extra={PRICES.extraProfessionalCents}>
                  {planText}
                </span>{" "}
                Mensagens da Meta à parte, cobradas direto da clínica. Profissionais pelo limite contratado.
              </span>
            </div>
            <p id="plan-cheaper" hidden={!(plan && plan.kind !== "none" && plan.completeIsCheaper)} class="rounded-lg bg-pend-100 px-2.5 py-1.5 text-sm font-semibold text-pend-800">
              A soma passou do Completo: ofereça o Completo.
            </p>
            <button type="submit" data-sending-label="Salvando…" class={`${PRIMARY_BUTTON} w-full max-sm:hidden sm:h-[46px]`}>
              Salvar matriz
            </button>
            <p class="text-[13.5px] text-ink-soft">
              Escolher o Básico ou o Completo marca os itens; nada é salvo até "Salvar matriz". Valores em{" "}
              <a href="/admin/sistema/vendas?tab=planos" class="font-semibold text-brand">
                Vendas › Planos
              </a>
              .
            </p>
          </aside>

          <div class="flex min-w-0 flex-col gap-4 lg:col-start-1 lg:row-start-1">
            {groups.map(({ label, items }, g) => (
              <section data-group class={`${CARD} overflow-hidden`} aria-labelledby={`grupo-${g}`}>
                <div class="flex items-center justify-between gap-3 px-4 pt-4 pb-3 sm:px-5">
                  <h2 id={`grupo-${g}`} class={SECTION_TITLE}>
                    {label}
                  </h2>
                  <Badge>
                    <span>
                      <span data-group-count>{items.filter((item) => itemIsOn(item, enabledKeys)).length}</span>{` de ${items.length}`}
                    </span>
                  </Badge>
                </div>
                <ul>
                  {items.map((item) => {
                    const grant = item.features.map((key) => grants.get(key)).find(Boolean);
                    const deps = itemDependsOn(item);
                    return (
                      <li class="border-t border-[#e6ecea]">
                        <label class="flex cursor-pointer items-start gap-3 px-4 py-3 hover:bg-[#fbfcfc] sm:px-5">
                          <input
                            type="checkbox"
                            name="item"
                            value={item.id}
                            checked={itemIsOn(item, enabledKeys)}
                            data-depends={deps.join(" ")}
                            data-price={item.priceCents ?? ""}
                            data-addon={ADDONS.includes(item) ? "1" : ""}
                            class={`${CHECK} mt-0.5 h-5 w-5`}
                          />
                          <span class="min-w-0 flex-1">
                            <span class="flex items-center gap-1.5 text-base leading-snug font-semibold text-ink">
                              {item.label}
                              {itensDaMatriz[item.id] && <HelpTip subject={item.label} text={itensDaMatriz[item.id]} id={`item-${item.id}`} variant="pop" />}
                            </span>
                            {deps.length > 0 && (
                              <span class="block text-sm text-ink-soft">
                                Depende de: {deps.map((id) => ALL_ITEMS.find((other) => other.id === id)?.label ?? id).join(", ")}
                              </span>
                            )}
                            {grant && (
                              <span class="block text-sm text-ink-soft">
                                Liberado em {when(grant.enabledAt)} {grantedBy(grant.enabledBy)}
                              </span>
                            )}
                          </span>
                          {item.priceCents !== null && <span class="shrink-0 text-[15px] font-semibold whitespace-nowrap text-ink-mid tabular-nums">{formatCentsBRL(item.priceCents)}/mês</span>}
                        </label>
                      </li>
                    );
                  })}
                </ul>
              </section>
            ))}

            <section aria-labelledby="t-historico" class="flex flex-col gap-3">
              <h2 id="t-historico" class={SECTION_TITLE}>
                Histórico de mudanças
              </h2>
              {history.length === 0 ? (
                <p class="text-[15px] text-ink-soft">Nenhuma mudança registrada.</p>
              ) : (
                <div data-scroll-region="Histórico de mudanças" class={TABLE.box}>
                  <table class={TABLE.table}>
                    <thead>
                      <tr>
                        <th scope="col" class={TABLE.th}>Quando</th>
                        <th scope="col" class={TABLE.th}>Quem</th>
                        <th scope="col" class={TABLE.th}>O que mudou</th>
                      </tr>
                    </thead>
                    <tbody class="[&>tr:last-child>td]:border-b-0">
                      {history.map((change) => (
                        <tr>
                          <td class={`${TABLE.td} whitespace-nowrap text-ink-soft`}>{when(change.at)}</td>
                          <td class={TABLE.td}>{who(change.actorId)}</td>
                          <td class={TABLE.td}>
                            {change.text} <strong>{change.strong}</strong>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </section>
          </div>

          <div class="h-16 sm:hidden" aria-hidden="true" />
          <div class="fixed inset-x-0 bottom-[calc(61px+env(safe-area-inset-bottom))] z-10 flex items-center gap-3 border-t border-line bg-white px-4 py-2.5 shadow-[0_-4px_14px_rgba(18,48,42,.08)] sm:hidden">
            <span class="flex min-w-0 flex-1 flex-col">
              <span class="truncate text-[13.5px] text-ink-soft" data-plan-label>{plan && plan.kind !== "none" ? PLAN_LABELS[plan.kind] : "Fora dos planos"}</span>
              <span data-plan-total class="font-display text-xl leading-tight font-bold text-ink tabular-nums">{monthly}</span>
            </span>
            <button type="submit" data-sending-label="Salvando…" class={`${PRIMARY_BUTTON} shrink-0`}>
              Salvar matriz
            </button>
          </div>
        </form>
      </>
    )
  }

  <script is:inline define:vars={{ planIds: PLAN_ITEM_IDS }}>
    // Marcar um item marca o de que ele depende; desmarcar desmarca os que
    // dependem dele (o servidor confere de novo). O plano marca os itens e a
    // mensalidade de referência acompanha (a tela Planos tem a regra).
    const boxes = [...document.querySelectorAll("#matriz input[name=item]")];
    const radios = [...document.querySelectorAll("#matriz input[name=plan]")];
    const limit = document.querySelector("#max_professionals");
    const summary = document.querySelector("#plan-summary");
    const cheaper = document.querySelector("#plan-cheaper");
    // R10: a mensalidade em destaque (ao lado e na barra do celular), o nome do
    // plano na barra e o "2 de 5" de cada grupo acompanham as marcações.
    const totals = [...document.querySelectorAll("[data-plan-total]")];
    const labels = [...document.querySelectorAll("[data-plan-label]")];
    const groups = [...document.querySelectorAll("#matriz [data-group]")];
    const byKey = new Map(boxes.map((box) => [box.value, box]));
    const dependsOn = (box) => (box.dataset.depends ?? "").split(" ").filter(Boolean);
    const check = (box) => {
      box.checked = true;
      dependsOn(box).forEach((key) => {
        const dep = byKey.get(key);
        if (dep && !dep.checked) check(dep);
      });
    };
    const uncheck = (box) => {
      box.checked = false;
      boxes.filter((other) => other.checked && dependsOn(other).includes(box.value)).forEach(uncheck);
    };
    const brl = (cents) => (cents / 100).toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
    const refresh = () => {
      const on = new Set(boxes.filter((box) => box.checked).map((box) => box.value));
      const addons = boxes.filter((box) => box.dataset.addon);
      const professionals = Math.max(1, Number(limit?.value) || 1);
      const extra = (professionals - 1) * Number(summary.dataset.extra);
      let kind = "none";
      if (planIds.basic.every((id) => on.has(id))) {
        const chosen = addons.filter((box) => box.checked);
        const offTable = boxes.filter((box) => box.checked && !box.dataset.addon && !planIds.basic.includes(box.value));
        kind = chosen.length === addons.length ? "complete" : chosen.length || offTable.length ? "custom" : "basic";
        const sum = Number(summary.dataset.basic) + chosen.reduce((total, box) => total + Number(box.dataset.price || 0), 0);
        const monthly = (kind === "complete" ? Number(summary.dataset.complete) : sum) + extra;
        const label = { basic: "Básico", complete: "Completo", custom: "Básico + adicionais" }[kind];
        summary.textContent = `${label} com ${professionals} ${professionals === 1 ? "profissional" : "profissionais"}.`;
        totals.forEach((total) => (total.textContent = brl(monthly)));
        labels.forEach((text) => (text.textContent = label));
        cheaper.hidden = !(kind !== "complete" && sum > Number(summary.dataset.complete));
      } else {
        summary.textContent = "Fora dos planos: falta algum item do Básico.";
        totals.forEach((total) => (total.textContent = "—"));
        labels.forEach((text) => (text.textContent = "Fora dos planos"));
        cheaper.hidden = true;
      }
      groups.forEach((group) => {
        const count = group.querySelector("[data-group-count]");
        if (count) count.textContent = String(group.querySelectorAll("input[name=item]:checked").length);
      });
      radios.forEach((radio) => (radio.checked = radio.value === kind));
    };
    boxes.forEach((box) =>
      box.addEventListener("change", () => {
        box.checked ? check(box) : uncheck(box);
        refresh();
      }),
    );
    radios.forEach((radio) =>
      radio.addEventListener("change", () => {
        // Só o rádio marcado manda: ao devolver os valores depois de um erro, o
        // keepFormValues avisa também o que foi desmarcado.
        if (!radio.checked) return;
        if (radio.value === "custom") {
          planIds.basic.forEach((id) => byKey.get(id) && check(byKey.get(id)));
        } else {
          const ids = radio.value === "basic" ? planIds.basic : planIds.complete;
          boxes.forEach((box) => (box.checked = ids.includes(box.value)));
        }
        refresh();
        if (radio.value === "custom") radio.checked = true;
      }),
    );
    limit?.addEventListener("input", refresh);
  </script>
</AdminLayout>

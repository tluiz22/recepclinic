---
// Matriz de acesso por clínica (F4.2, D11): o Administrador do sistema
// (Suporte RecepClinic) escolhe a clínica, marca o que ela tem liberado e vê o
// histórico de mudanças. Clínica nova começa com tudo desligado; o básico do
// consultório é sempre ligado.
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Card from "../../../components/admin/Card.astro";
import FormMessage from "../../../components/admin/FormMessage.astro";
import { formatInstant, DEFAULT_TIMEZONE } from "../../../lib/clinicTime";
import { createUserClient } from "../../../lib/data/clients";
import { listClinicsAccess, listFeatureChanges, listPlatformStaffNames, listProfessionalLimitChanges } from "../../../lib/data/features";
import { AREA_LABELS, FEATURES, featureLabel, type FeatureArea } from "../../../lib/features";

const db = createUserClient(Astro.request, Astro.cookies);
const [clinics, staffNames] = await Promise.all([listClinicsAccess(db), listPlatformStaffNames(db)]);
const selectedId = Astro.url.searchParams.get("clinica");
const selected = clinics.find((clinic) => clinic.id === selectedId) ?? null;

let timeZone = DEFAULT_TIMEZONE;
// Histórico: itens liberados e desligados, e mudanças do limite de profissionais.
let history: { at: Date; actorId: string; text: string; strong: string }[] = [];
if (selected) {
  const [settings, changes, limitChanges] = await Promise.all([
    db.from("clinic_settings").select("timezone").eq("clinic_id", selected.id).maybeSingle(),
    listFeatureChanges(db, selected.id, 50),
    listProfessionalLimitChanges(db, selected.id, 50),
  ]);
  timeZone = settings.data?.timezone ?? DEFAULT_TIMEZONE;
  history = [
    ...changes.map((c) => ({ at: c.at, actorId: c.actorId, text: c.enabled ? "liberou" : "desligou", strong: featureLabel(c.feature) })),
    ...limitChanges.map((c) => ({ at: c.at, actorId: c.actorId, text: `mudou o limite de profissionais de ${c.from} para`, strong: String(c.to) })),
  ]
    .sort((a, b) => b.at.getTime() - a.at.getTime())
    .slice(0, 50);
}
const grants = new Map((selected?.features ?? []).map((grant) => [grant.key, grant]));
const when = (date: Date) => formatInstant(date, timeZone, "dd/MM/yyyy 'às' HH:mm");
// Pessoa que saiu da lista do Suporte continua no histórico, sem o nome.
const who = (userId: string) => staffNames.get(userId) ?? "ex-integrante do Suporte";
// Sem pessoa: liberado pela plataforma (ex.: dados de teste).
const grantedBy = (userId: string | null) => (userId ? `por ${who(userId)}` : "pela plataforma");

const areas = (Object.keys(AREA_LABELS) as FeatureArea[]).map((area) => ({
  area,
  label: AREA_LABELS[area],
  items: FEATURES.filter((feature) => feature.area === area),
}));

const erro = Astro.url.searchParams.get("erro");
const ERRORS: Record<string, string> = {
  dependencia: "Algum item ficou sem o item de que depende (ex.: lista de espera sem o bot). Nada foi salvo.",
  limite: "O limite de profissionais precisa ser de pelo menos 1. Nada foi salvo.",
  clinica: "Clínica não encontrada.",
  falha: "Não foi possível salvar. Tente de novo.",
};
const saved = Astro.url.searchParams.get("salvo") === "1";
---

<AdminLayout title="Matriz de acesso" platform>
  <h1 class="text-2xl font-bold text-slate-900">Matriz de acesso</h1>
  <p class="mt-2 text-slate-600">
    O que cada clínica tem liberado. Sempre ligado em toda clínica: agenda (dia, semana, mês), bloqueios e trilha;
    marcar, remarcar e cancelar consulta e retorno; pacientes; Resumo do dia e comparecimento; configurações básicas.
  </p>

  {erro && ERRORS[erro] && <FormMessage tone="error">{ERRORS[erro]}</FormMessage>}
  {saved && <FormMessage tone="success">Matriz salva.</FormMessage>}

  {
    !selected ? (
      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {clinics.map((clinic) => (
          <li>
            <a href={`/admin/sistema/matriz?clinica=${clinic.id}`}>
              <Card class="hover:border-sky-300 hover:bg-sky-50">
                <p class="font-medium text-slate-900">{clinic.name}</p>
                <p class="mt-1 text-sm text-slate-600">
                  {clinic.features.length === 0
                    ? "Nada liberado (só o básico)"
                    : `${clinic.features.length} ${clinic.features.length === 1 ? "item liberado" : "itens liberados"}`}
                  {` · ${clinic.activeProfessionals} de ${clinic.maxProfessionals} profissionais`}
                  {clinic.status === "suspended" ? " · suspensa" : ""}
                </p>
              </Card>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <>
        <a href="/admin/sistema/matriz" class="mt-6 inline-block text-sm text-sky-700 hover:underline">
          ← Todas as clínicas
        </a>
        <h2 class="mt-2 text-xl font-semibold text-slate-900">{selected.name}</h2>

        <form method="POST" action="/api/admin/sistema/matriz" class="mt-4 flex flex-col gap-4" id="matriz">
          <input type="hidden" name="clinicId" value={selected.id} />
          <Card>
            <label for="max_professionals" class="text-sm font-semibold uppercase tracking-wide text-slate-500">
              Limite de profissionais ativos
            </label>
            <div class="mt-2 flex items-center gap-3">
              <input
                type="number"
                id="max_professionals"
                name="max_professionals"
                min="1"
                required
                value={selected.maxProfessionals}
                class="w-24 rounded-lg border border-slate-300 px-3 py-2 text-sm"
              />
              <span class="text-sm text-slate-600">{selected.activeProfessionals} ativos agora</span>
            </div>
            {selected.activeProfessionals > selected.maxProfessionals && (
              <p class="mt-2 text-xs text-amber-700">
                A clínica está acima do limite: ninguém é desativado, mas ela não cadastra nem reativa profissional até ficar abaixo.
              </p>
            )}
            <p class="mt-2 text-xs text-slate-500">Desativar um profissional libera a vaga.</p>
          </Card>
          {areas.map(({ label, items }) => (
            <Card>
              <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500">{label}</h3>
              <ul class="mt-3 flex flex-col gap-3">
                {items.map((feature) => {
                  const grant = grants.get(feature.key);
                  return (
                    <li>
                      <label class="flex items-start gap-3">
                        <input
                          type="checkbox"
                          name="feature"
                          value={feature.key}
                          checked={!!grant}
                          data-depends={feature.dependsOn.join(" ")}
                          class="mt-1 h-4 w-4 rounded border-slate-300"
                        />
                        <span>
                          <span class="block text-sm font-medium text-slate-900">{feature.label}</span>
                          {feature.dependsOn.length > 0 && (
                            <span class="block text-xs text-slate-500">
                              Depende de: {feature.dependsOn.map(featureLabel).join(", ")}
                            </span>
                          )}
                          {grant && (
                            <span class="block text-xs text-slate-500">
                              Liberado em {when(grant.enabledAt)} {grantedBy(grant.enabledBy)}
                            </span>
                          )}
                        </span>
                      </label>
                    </li>
                  );
                })}
              </ul>
            </Card>
          ))}
          <button type="submit" class="self-start rounded-md bg-sky-700 px-4 py-2 text-sm font-medium text-white hover:bg-sky-800">
            Salvar matriz
          </button>
        </form>

        <h2 class="mt-8 text-sm font-semibold uppercase tracking-wide text-slate-500">Histórico de mudanças</h2>
        {history.length === 0 ? (
          <p class="mt-2 text-sm text-slate-600">Nenhuma mudança registrada.</p>
        ) : (
          <ul class="mt-2 flex flex-col gap-1 text-sm text-slate-700">
            {history.map((change) => (
              <li>
                {when(change.at)} · {who(change.actorId)} {change.text} <strong>{change.strong}</strong>
              </li>
            ))}
          </ul>
        )}
      </>
    )
  }

  <script>
    // Marcar um item marca o de que ele depende; desmarcar desmarca os que
    // dependem dele (o servidor confere de novo).
    const boxes = [...document.querySelectorAll<HTMLInputElement>("#matriz input[name=feature]")];
    const byKey = new Map(boxes.map((box) => [box.value, box]));
    const dependsOn = (box: HTMLInputElement) => (box.dataset.depends ?? "").split(" ").filter(Boolean);
    const check = (box: HTMLInputElement) => {
      box.checked = true;
      dependsOn(box).forEach((key) => {
        const dep = byKey.get(key);
        if (dep && !dep.checked) check(dep);
      });
    };
    const uncheck = (box: HTMLInputElement) => {
      box.checked = false;
      boxes.filter((other) => other.checked && dependsOn(other).includes(box.value)).forEach(uncheck);
    };
    boxes.forEach((box) => box.addEventListener("change", () => (box.checked ? check(box) : uncheck(box))));
  </script>
</AdminLayout>

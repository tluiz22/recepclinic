---
// Clínicas (F4.4a): o Suporte cria clínicas, acompanha os convites e os
// pedidos de informações. R10 (cliente, 17/out/2026): lista em linhas, com o
// plano, a data e o que falta; "Abrir" entra na clínica direto e a seta leva à
// tela dela; busca pelo nome com mais de 6 clínicas.
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Badge from "../../../components/admin/config/Badge.astro";
import FlashMessage from "../../../components/admin/FlashMessage.astro";
import Icon from "../../../components/admin/Icon.astro";
import SystemHeader from "../../../components/admin/sistema/SystemHeader.astro";
import Button from "../../../components/admin/ui/Button.astro";
import { CONTROL } from "../../../components/admin/ui/styles";
import { HEAD_ROW, LABEL, LIST, ROW, ROW_GO, ROW_NAME, SECONDARY_BUTTON } from "../../../components/admin/config/formStyles";
import { DEFAULT_TIMEZONE, formatInstant } from "../../../lib/clinicTime";
import { filterClinicsByName, showClinicSearch } from "../../../lib/clinicSearch";
import { createUserClient } from "../../../lib/data/clients";
import { listClinicsAccess } from "../../../lib/data/features";
import { listClinicsOverview } from "../../../lib/data/onboarding";
import { REQUEST_STATUS } from "../../../lib/onboardingLabels";
import { PLAN_LABELS, clinicPlan } from "../../../lib/plans";

const db = createUserClient(Astro.request, Astro.cookies);
const [overview, access] = await Promise.all([listClinicsOverview(db), listClinicsAccess(db)]);
const accessById = new Map(access.map((clinic) => [clinic.id, clinic]));
const searchable = showClinicSearch(overview.length);
const query = searchable ? (Astro.url.searchParams.get("busca")?.trim() ?? "") : "";
const clinics = filterClinicsByName(overview, query);
const suspended = overview.filter((clinic) => clinic.status === "suspended").length;
const planOf = (id: string) => {
  const clinic = accessById.get(id);
  return clinic ? PLAN_LABELS[clinicPlan(clinic.features.map((grant) => grant.key), clinic.maxProfessionals).kind] : null;
};
const count = `${overview.length} ${overview.length === 1 ? "clínica" : "clínicas"}${suspended ? ` · ${suspended} ${suspended === 1 ? "suspensa" : "suspensas"}` : ""}`;
const COLS = "lg:grid-cols-[minmax(0,2.2fr)_120px_minmax(0,2fr)_116px]";
---

<AdminLayout title="Clínicas" platform>
  <SystemHeader title="Clínicas" subtitle="Clínicas do RecepClinic, convites e pedidos de informações.">
    <Button slot="actions" variant="primary" href="/admin/sistema/clinicas/nova" class="sm:h-11">
      <Icon name="plus" class="h-[18px] w-[18px]" strokeWidth={2.4} /> Nova clínica
    </Button>
  </SystemHeader>
  <FlashMessage />

  <div class="mt-4 flex flex-wrap items-end justify-between gap-3">
    {
      searchable && (
        <form method="get" role="search" class="flex w-full max-w-[420px] items-end gap-2">
          <div class="min-w-0 flex-1">
            <label for="busca" class={LABEL}>Buscar clínica</label>
            <input type="search" id="busca" name="busca" value={query} placeholder="Nome da clínica" autocomplete="off" class={`mt-1.5 w-full ${CONTROL}`} />
          </div>
          <button type="submit" class={SECONDARY_BUTTON}>Buscar</button>
        </form>
      )
    }
    <p class="text-[15px] text-ink-soft sm:ml-auto">{count}</p>
  </div>

  {
    clinics.length === 0 ? (
      <div class="mt-3 rounded-xl border border-line bg-white px-6 py-7 text-center">
        <p class="text-base font-bold text-ink">{query ? `Nenhuma clínica com "${query}"` : "Nenhuma clínica cadastrada"}</p>
        {query && (
          <a href="/admin/sistema/clinicas" class="mt-2 inline-block font-semibold text-brand">
            Limpar a busca
          </a>
        )}
      </div>
    ) : (
      <section aria-label="Clínicas" class={`mt-3 ${LIST}`}>
        <div aria-hidden="true" class={`${HEAD_ROW} ${COLS}`}>
          <span>Clínica</span>
          <span>Criada em</span>
          <span>O que falta</span>
          <span />
        </div>
        {clinics.map((clinic) => {
          const plan = planOf(clinic.id);
          const off = clinic.status === "suspended";
          const request = clinic.latestRequest && clinic.latestRequest !== "reviewed" ? REQUEST_STATUS[clinic.latestRequest] : null;
          return (
            <div class={`${ROW} ${COLS} ${off ? "bg-[#fbfcfc]" : ""}`}>
              <div class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1">
                <a href={`/admin/sistema/clinicas/${clinic.id}`} class={`${ROW_NAME} ${off ? "text-ink-soft" : ""}`}>
                  {clinic.name}
                </a>
                {off ? <Badge variant="warning">Suspensa</Badge> : plan && <Badge>{plan}</Badge>}
              </div>
              <div class="flex items-center gap-1 justify-self-end lg:order-last">
                <form method="POST" action="/api/admin/clinica-ativa">
                  <input type="hidden" name="clinicId" value={clinic.id} />
                  <Button type="submit" size="sm" data-sending-label="Abrindo…" aria-label={`Abrir ${clinic.name}`}>
                    Abrir
                  </Button>
                </form>
                <a href={`/admin/sistema/clinicas/${clinic.id}`} class={ROW_GO} aria-label={`Ver ${clinic.name}: convites e pedidos`}>
                  <Icon name="chevron-right" class="h-5 w-5" strokeWidth={2.2} />
                </a>
              </div>
              <span class="col-span-2 text-[15px] text-ink-soft lg:col-span-1">
                <span class="lg:hidden">Criada em </span>
                {formatInstant(clinic.createdAt, DEFAULT_TIMEZONE, "dd/MM/yyyy")}
              </span>
              <div class="col-span-2 flex flex-wrap gap-1.5 lg:col-span-1">
                {clinic.pendingInvitations > 0 && (
                  <Badge variant="warning">
                    {`${clinic.pendingInvitations} ${clinic.pendingInvitations === 1 ? "convite sem resposta" : "convites sem resposta"}`}
                  </Badge>
                )}
                {request && <Badge variant={request.variant}>{request.label}</Badge>}
                {clinic.pendingInvitations === 0 && !request && <span class="text-[15px] text-ink-soft">Nada pendente</span>}
              </div>
            </div>
          );
        })}
      </section>
    )
  }
</AdminLayout>

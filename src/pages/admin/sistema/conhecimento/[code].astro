---
// Entrada da Base de Conhecimento (BC 3.3): pergunta, sinônimos, palavras-chave,
// orientação, tipo de resposta, fontes de dados e situação, com o histórico
// dela. "nova" cria uma entrada em rascunho. Nada vai ao bot até "Publicar".
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import Badge from "../../../../components/admin/config/Badge.astro";
import ConfirmDeleteDialog from "../../../../components/admin/ConfirmDeleteDialog.astro";
import FlashMessage from "../../../../components/admin/FlashMessage.astro";
import SystemHeader from "../../../../components/admin/sistema/SystemHeader.astro";
import { CHECK, CHOICE, HINT, INPUT, LABEL, LEGEND, PANEL, PRIMARY_BUTTON, SECONDARY_BUTTON, SECTION_TITLE } from "../../../../components/admin/config/formStyles";
import { DEFAULT_TIMEZONE, formatInstant } from "../../../../lib/clinicTime";
import { createUserClient } from "../../../../lib/data/clients";
import { getEntry, listCategories, listRevisions } from "../../../../lib/data/knowledge/admin";
import { ANSWER_TYPE_LABELS, FLOW_LABELS, REQUIRED_TERM_LABELS, SOURCE_LABELS, STATUS_BADGE } from "../../../../lib/knowledge/labels";
import { KB_ANSWER_TYPES, KB_FLOWS, KB_REQUIRED_TERMS, KB_SOURCE_VARIABLES, KB_SOURCES, KB_STATUS_LABELS, KB_STATUSES } from "../../../../lib/knowledge/lists";

const code = Astro.params.code ?? "";
const isNew = code === "nova";
const db = createUserClient(Astro.request, Astro.cookies);
const [categories, entry] = await Promise.all([listCategories(db), isNew ? Promise.resolve(null) : getEntry(db, code)]);
if (!isNew && !entry) return Astro.redirect("/admin/sistema/conhecimento", 303);
const revisions = entry ? await listRevisions(db, { entryId: entry.id, limit: 30 }) : [];
const ACTION = "/api/admin/sistema/conhecimento/entrada";
const variables = KB_SOURCES.filter((s) => KB_SOURCE_VARIABLES[s]?.length).map((s) => `${SOURCE_LABELS[s]}: ${KB_SOURCE_VARIABLES[s]!.map((v) => `{${v}}`).join(", ")}`);
const title = entry ? `${entry.code} · ${entry.question}` : "Nova entrada";
---

<AdminLayout title={entry ? `Base: ${entry.code}` : "Nova entrada da base"} platform>
  <SystemHeader title={title} kicker="Base de conhecimento" back={{ href: "/admin/sistema/conhecimento", label: "Base de conhecimento" }}>
    {entry && <Badge slot="actions" variant={STATUS_BADGE[entry.status]}>{`${KB_STATUS_LABELS[entry.status]} · versão ${entry.version}`}</Badge>}
  </SystemHeader>
  <FlashMessage />

  <form method="POST" action={ACTION} class={`mt-4 ${PANEL} grid gap-4`}>
    <input type="hidden" name="acao" value={isNew ? "criar" : "salvar"} />
    {entry && <input type="hidden" name="codigo" value={entry.code} />}
    <h2 class={SECTION_TITLE}>Pergunta e reconhecimento</h2>
    <div class="grid gap-4 sm:grid-cols-[160px_minmax(0,1fr)]">
      {
        isNew ? (
          <div>
            <label for="code" class={LABEL}>Código</label>
            <input id="code" name="code" required maxlength="4" placeholder="F2" class={INPUT} />
          </div>
        ) : (
          <div>
            <span class={LABEL}>Código</span>
            <p class="mt-1.5 font-mono text-[16px] font-bold text-ink">{entry!.code}</p>
          </div>
        )
      }
      <div>
        <label for="category" class={LABEL}>Categoria</label>
        <select id="category" name="category" required class={INPUT}>
          {categories.map((c) => <option value={c.key} selected={c.key === entry?.categoryKey}>{c.label}</option>)}
        </select>
      </div>
    </div>
    <div>
      <label for="question" class={LABEL}>Pergunta principal</label>
      <input id="question" name="question" required value={entry?.question ?? ""} class={INPUT} />
    </div>
    <div>
      <label for="keywords" class={LABEL}>Palavras-chave</label>
      <textarea id="keywords" name="keywords" rows="2" class={INPUT}>{entry?.keywords.join(", ") ?? ""}</textarea>
      <p class={HINT}>Separadas por vírgula. Pelo menos uma precisa estar na mensagem do paciente para a entrada valer.</p>
    </div>
    <div>
      <label for="required_term" class={LABEL}>Só vale com</label>
      <select id="required_term" name="required_term" class={INPUT}>
        <option value="">Nada exigido</option>
        {KB_REQUIRED_TERMS.map((t) => <option value={t} selected={t === entry?.requiredTerm}>{REQUIRED_TERM_LABELS[t]}</option>)}
      </select>
    </div>
    <div>
      <label for="guidance" class={LABEL}>Orientação de resposta (só o Suporte vê)</label>
      <textarea id="guidance" name="guidance" rows="3" class={INPUT}>{entry?.guidance ?? ""}</textarea>
      <p class={HINT}>Como responder e quando encaminhar. Nunca vai ao paciente nem vira instrução para o bot.</p>
    </div>

    <h2 class={`${SECTION_TITLE} mt-2`}>Resposta</h2>
    <div>
      <label for="answer_type" class={LABEL}>Tipo de resposta</label>
      <select id="answer_type" name="answer_type" required class={INPUT}>
        {KB_ANSWER_TYPES.map((t) => <option value={t} selected={t === entry?.answerType}>{ANSWER_TYPE_LABELS[t]}</option>)}
      </select>
    </div>
    <div>
      <label for="template" class={LABEL}>Texto da resposta</label>
      <textarea id="template" name="template" rows="3" class={INPUT}>{entry?.template ?? ""}</textarea>
      <p class={HINT}>Para "Modelo com dados", "Texto fixo" e "Oferece a recepção". Variáveis de cada fonte: {variables.join(" · ")}.</p>
    </div>
    <fieldset>
      <legend class={LEGEND}>Fontes de dados da clínica</legend>
      <div class="mt-1.5 grid gap-x-4 sm:grid-cols-2">
        {
          KB_SOURCES.map((s) => (
            <label class={CHOICE}>
              <input type="checkbox" name="sources" value={s} checked={entry?.sources.includes(s)} class={CHECK} />
              {SOURCE_LABELS[s]}
            </label>
          ))
        }
      </div>
      <p class={HINT}>Em "Montada pela fonte", a primeira marcada (na ordem da lista) monta a resposta. Sem o dado na clínica, a entrada não responde.</p>
    </fieldset>
    <div>
      <label for="flow" class={LABEL}>Fluxo do bot (para "Abre um fluxo")</label>
      <select id="flow" name="flow" class={INPUT}>
        <option value="">Nenhum</option>
        {KB_FLOWS.map((f) => <option value={f} selected={f === entry?.flow}>{FLOW_LABELS[f]}</option>)}
      </select>
    </div>
    <label class={CHOICE}>
      <input type="checkbox" name="offers_reception" checked={entry?.offersReception} class={CHECK} />
      Depois da resposta, perguntar se quer falar com a recepção (com a recepção no app)
    </label>
    <div>
      <button type="submit" class={PRIMARY_BUTTON} data-sending-label="Salvando…">{isNew ? "Criar como rascunho" : "Salvar"}</button>
    </div>
  </form>

  {
    entry && (
      <>
        <section aria-label="Situação" class={`mt-4 ${PANEL}`}>
          <h2 class={SECTION_TITLE}>Situação</h2>
          <p class={HINT}>Rascunho e Aprovado não vão ao bot. Ativo vai na próxima publicação; Inativo sai na próxima publicação.</p>
          <form method="POST" action={ACTION} class="mt-3 flex flex-wrap items-end gap-2">
            <input type="hidden" name="acao" value="situacao" />
            <input type="hidden" name="codigo" value={entry.code} />
            <select name="status" aria-label="Situação" class={INPUT.replace("mt-1.5 w-full ", "")}>
              {KB_STATUSES.map((s) => <option value={s} selected={s === entry.status}>{KB_STATUS_LABELS[s]}</option>)}
            </select>
            <button type="submit" class={SECONDARY_BUTTON}>Mudar situação</button>
          </form>
        </section>

        <section id="sinonimos" aria-label="Sinônimos" class={`mt-4 ${PANEL}`}>
          <h2 class={SECTION_TITLE}>{`Sinônimos (${entry.synonyms.length})`}</h2>
          <p class={HINT}>Outras formas de o paciente fazer a mesma pergunta.</p>
          <ul class="mt-3 grid gap-1.5">
            {entry.synonyms.map((synonym) => (
              <li class="flex items-center justify-between gap-3 rounded-lg border border-line px-3 py-2 text-[15px] text-ink">
                <span class="min-w-0 break-words">{synonym.text}</span>
                <form method="POST" action={ACTION}>
                  <input type="hidden" name="acao" value="tirar_sinonimo" />
                  <input type="hidden" name="codigo" value={entry.code} />
                  <input type="hidden" name="synonym_id" value={synonym.id} />
                  <button
                    type="submit"
                    class="js-confirm-delete text-sm font-semibold text-danger-solid hover:underline"
                    data-confirm-title="Tirar o sinônimo?"
                    data-confirm-message={`"${synonym.text}" deixa de valer para ${entry.code} na próxima publicação.`}
                    data-confirm-label="Tirar"
                  >
                    Tirar
                  </button>
                </form>
              </li>
            ))}
          </ul>
          <form method="POST" action={ACTION} class="mt-3 flex flex-wrap items-end gap-2">
            <input type="hidden" name="acao" value="sinonimo" />
            <input type="hidden" name="codigo" value={entry.code} />
            <div class="min-w-0 flex-1">
              <label for="text" class={LABEL}>Novo sinônimo</label>
              <input id="text" name="text" required maxlength="200" class={INPUT} />
            </div>
            <button type="submit" class={SECONDARY_BUTTON}>Incluir</button>
          </form>
        </section>

        <section aria-label="Histórico da entrada" class={`mt-4 ${PANEL}`}>
          <h2 class={SECTION_TITLE}>Histórico</h2>
          {revisions.length === 0 ? (
            <p class={HINT}>Sem alterações registradas.</p>
          ) : (
            <ul class="mt-3 grid gap-1.5 text-[15px]">
              {revisions.map((r) => (
                <li class="text-ink">
                  <span class="text-ink-soft">{formatInstant(new Date(r.occurredAt), DEFAULT_TIMEZONE, "dd/MM/yyyy HH:mm")}</span>
                  {` · ${r.actor ?? "Migração"} · ${r.tableName} ${r.subject}: `}
                  {r.operation === "INSERT" ? "criado" : r.operation === "DELETE" ? "retirado" : `alterado (${r.changed.join(", ") || "sem mudança visível"})`}
                </li>
              ))}
            </ul>
          )}
        </section>
      </>
    )
  }
  <ConfirmDeleteDialog />
</AdminLayout>

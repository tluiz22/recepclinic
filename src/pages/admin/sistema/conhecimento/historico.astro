---
// Histórico da Base de Conhecimento (BC 3.3): as últimas alterações de
// entradas, sinônimos, especialidades e termos, com quem fez.
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import KnowledgeTabs from "../../../../components/admin/sistema/KnowledgeTabs.astro";
import SystemHeader from "../../../../components/admin/sistema/SystemHeader.astro";
import { HEAD_ROW, LIST, ROW } from "../../../../components/admin/config/formStyles";
import { DEFAULT_TIMEZONE, formatInstant } from "../../../../lib/clinicTime";
import { createUserClient } from "../../../../lib/data/clients";
import { listRevisions } from "../../../../lib/data/knowledge/admin";

const db = createUserClient(Astro.request, Astro.cookies);
const revisions = await listRevisions(db, { limit: 200 });
const COLS = "lg:grid-cols-[140px_minmax(0,1.2fr)_minmax(0,3fr)]";
const what = (r: (typeof revisions)[number]) =>
  r.operation === "INSERT" ? "criado" : r.operation === "DELETE" ? "retirado" : `alterado: ${r.changed.join(", ") || "sem mudança visível"}`;
---

<AdminLayout title="Histórico da base" platform>
  <SystemHeader title="Base de conhecimento" subtitle="Últimas 200 alterações. Cada mudança vale no bot depois de publicar." />
  <KnowledgeTabs active="historico" />
  <section aria-label="Histórico" class={`mt-4 ${LIST}`}>
    <div aria-hidden="true" class={`${HEAD_ROW} ${COLS}`}>
      <span>Quando</span>
      <span>Quem</span>
      <span>O quê</span>
    </div>
    {
      revisions.map((r) => (
        <div class={`${ROW} ${COLS}`}>
          <span class="text-[15px] text-ink-soft">{formatInstant(new Date(r.occurredAt), DEFAULT_TIMEZONE, "dd/MM/yyyy HH:mm")}</span>
          <span class="text-[15px] text-ink">{r.actor ?? "Migração"}</span>
          <span class="col-span-2 text-[15px] break-words text-ink lg:col-span-1">{`${r.tableName} ${r.subject}: ${what(r)}`}</span>
        </div>
      ))
    }
  </section>
</AdminLayout>

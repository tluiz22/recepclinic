---
// Clínica, pelo Suporte (F4.4a): convites (com "Reenviar convite"), pedido de
// informações por e-mail e as respostas do formulário para revisar. Para
// configurar, o Suporte abre a clínica (escolha de clínica). R10 (cliente,
// 17/out/2026): resumo embaixo do nome, as duas ações no cabeçalho, convites em
// linhas e os pedidos num cartão, o mais novo em cima. F10.1a (cliente,
// 20/out/2026): "Agenda atual", o pedido do link para a importação. F8.2b
// (cliente, 25/out/2026): "Situação", com "Ativar a clínica" em implantação
// e o que conferir antes (WhatsApp e templates). F12.1 (faturamento do SaaS):
// abas Implantação (o de antes) e Faturamento (conta de cobrança e trilha);
// F12.3: aba Suspensão (motivos e liberação; cliente, 03/nov/2026).
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import Badge from "../../../../components/admin/config/Badge.astro";
import ConfirmDeleteDialog from "../../../../components/admin/ConfirmDeleteDialog.astro";
import FlashMessage from "../../../../components/admin/FlashMessage.astro";
import OnboardingAnswersView from "../../../../components/admin/OnboardingAnswersView.astro";
import SupportBillingTab from "../../../../components/admin/billing/SupportBillingTab.astro";
import SupportSuspensionCard from "../../../../components/admin/billing/SupportSuspensionCard.astro";
import SystemHeader from "../../../../components/admin/sistema/SystemHeader.astro";
import Tabs from "../../../../components/admin/ui/Tabs.astro";
import Button from "../../../../components/admin/ui/Button.astro";
import { CARD, INPUT, LABEL, PANEL, PRIMARY_BUTTON, SECTION_TITLE } from "../../../../components/admin/config/formStyles";
import { countAppointments, IMPORT_STATUS, isImportOpen } from "../../../../lib/agendaImport";
import { isUuid } from "../../../../lib/clinicAccess";
import { formatInstant } from "../../../../lib/clinicTime";
import { getLatestAgendaImport } from "../../../../lib/data/agendaImport";
import { createUserClient } from "../../../../lib/data/clients";
import { listInfoRequests, listInvitations } from "../../../../lib/data/onboarding";
import { getWhatsappConnection, listWhatsappTemplates } from "../../../../lib/data/whatsapp/connection";
import { CHECKLIST_GROUPS, loadOnboardingChecklist } from "../../../../lib/data/onboardingChecklist";
import { getSupportWhatsapp } from "../../../../lib/data/platformSettings";
import { describeTemplateApproval, templateApproval, templatesInUse } from "../../../../lib/data/whatsapp/templates";
import { isFeatureKey } from "../../../../lib/features";
import { REQUEST_STATUS, ROLE_NAMES } from "../../../../lib/onboardingLabels";
import { PLAN_LABELS, clinicPlan } from "../../../../lib/plans";
import { GUIDE_BEFORE_CONNECT_PATH, GUIDE_META_PAYMENT_PATH } from "../../../../lib/guides";
import { portalPublicUrl, suggestPortalSlug } from "../../../../lib/portal";

const { id } = Astro.params;
if (!isUuid(id)) return Astro.redirect("/admin/sistema/clinicas");
const db = createUserClient(Astro.request, Astro.cookies);
const [{ data: clinic }, { data: settings }, invitations, requests, agendaImport, connection, templates, supportPhone] = await Promise.all([
  db
    .from("clinics")
    .select("id, name, status, created_at, max_professionals, portal_slug, clinic_features ( feature_key ), professionals ( is_active )")
    .eq("id", id)
    .maybeSingle(),
  db.from("clinic_settings").select("timezone").eq("clinic_id", id).maybeSingle(),
  listInvitations(db, id),
  listInfoRequests(db, id),
  getLatestAgendaImport(db, id),
  getWhatsappConnection(db, id),
  listWhatsappTemplates(db, id),
  getSupportWhatsapp(db).catch(() => null),
]);
if (!clinic || !settings) return Astro.redirect("/admin/sistema/clinicas");
const when = (date: Date) => formatInstant(date, settings.timezone, "dd/MM/yyyy 'às' HH:mm");
const firstAdmin = invitations.find((i) => i.roles.includes("admin"))?.email ?? "";
const action = `/api/admin/sistema/clinicas/${id}`;
const now = Date.now();
// Vencido sem ter sido enviado ao Suporte.
const expired = (request: (typeof requests)[number]) => (request.status === "sent" || request.status === "draft") && request.expiresAt.getTime() < now;
const features = clinic.clinic_features.map((grant) => grant.feature_key).filter(isFeatureKey);
const planInfo = clinicPlan(features, clinic.max_professionals);
const plan = PLAN_LABELS[planInfo.kind];
const active = clinic.professionals.filter((p) => p.is_active).length;
const summary = [
  `Criada em ${formatInstant(new Date(clinic.created_at), settings.timezone, "dd/MM/yyyy")}`,
  plan,
  `${active} de ${clinic.max_professionals} ${clinic.max_professionals === 1 ? "profissional" : "profissionais"}`,
  ...(clinic.status === "suspended" ? ["suspensa"] : clinic.status === "onboarding" ? ["em implantação"] : []),
].join(" · ");
// Situação (F8.2b): o que conferir antes de ativar.
const CONNECTION_LABEL = { connected: "conectado", pending: "em configuração", disconnected: "desconectado" } as const;
const whatsappLine = connection ? `WhatsApp ${CONNECTION_LABEL[connection.status]}${connection.displayPhone ? ` (${connection.displayPhone})` : ""}` : "WhatsApp não conectado";
const templatesLine =
  connection?.status === "connected"
    ? `Mensagens automáticas na Meta: ${describeTemplateApproval(templateApproval(templatesInUse(features), templates)) ?? "todas aprovadas"}`
    : null;
// Guias para o dono da clínica (IS1, 03/nov/2026).
const guideUrl = `${Astro.url.origin}${GUIDE_BEFORE_CONNECT_PATH}`;
const paymentGuideUrl = `${Astro.url.origin}${GUIDE_META_PAYMENT_PATH}`;
const guideWhatsapp = `https://wa.me/?text=${encodeURIComponent(`Olá! Antes de conectarmos o WhatsApp da ${clinic.name} ao RecepClinic, veja o que preparar: ${guideUrl}`)}`;
// Checklist de implantação (IS3, cliente, 03/nov/2026): obrigatórios bloqueiam "Ativar a clínica" (também na rota e no banco).
const checklist = await loadOnboardingChecklist(db, id, features, { supportPhone });
const canActivate = checklist.missingRequired.length === 0;
const doneCount = checklist.items.filter((i) => i.done).length;
const ordered = [...requests].sort((a, b) => b.requestedAt.getTime() - a.requestedAt.getTime());
// Agenda atual (F10.1a): pedido em andamento, ou nenhum (pode pedir).
const importOpen = !!agendaImport && isImportOpen(agendaImport.status);
const importActive = importOpen || agendaImport?.status === "submitted";
const importExpired = importOpen && agendaImport!.expiresAt.getTime() < now;
const importPatients = agendaImport?.entries.length ?? 0;
const importAppointments = agendaImport ? countAppointments(agendaImport.entries) : 0;
const TABS = [
  { key: "implantacao", label: "Implantação" },
  { key: "faturamento", label: "Faturamento" },
  { key: "suspensao", label: "Suspensão" },
] as const;
const requestedTab = Astro.url.searchParams.get("tab");
// Endereço do portal de agendamento (RD1, F2a): só o Suporte dá e troca (o dos profissionais é automático).
const portalUrl = clinic.portal_slug ? portalPublicUrl(Astro.url, clinic.portal_slug) : null;
const portalOn = features.includes("portal");
const tab = TABS.find((t) => t.key === requestedTab)?.key ?? "implantacao";
---

<AdminLayout title={clinic.name} platform>
  <div class="flex flex-col">
    <SystemHeader title={clinic.name} kicker="Clínica" subtitle={summary} back={{ href: "/admin/sistema/clinicas", label: "Clínicas" }}>
      <Fragment slot="actions">
        <Button href={`/admin/sistema/matriz?clinica=${clinic.id}&de=clinica`}>Matriz de acesso</Button>
        <form method="POST" action="/api/admin/clinica-ativa">
          <input type="hidden" name="clinicId" value={clinic.id} />
          <input type="hidden" name="destino" value="configuracoes" />
          <button type="submit" data-sending-label="Abrindo…" class={PRIMARY_BUTTON}>Abrir a clínica para configurar</button>
        </form>
      </Fragment>
    </SystemHeader>
  </div>
  <FlashMessage />
  <Tabs class="mt-4" label="Abas da clínica" tabs={TABS.map((t) => ({ label: t.label, href: `/admin/sistema/clinicas/${clinic.id}?tab=${t.key}`, active: t.key === tab }))} />
  {tab === "faturamento" && <SupportBillingTab db={db} clinicId={clinic.id} timezone={settings.timezone} suggestedEmail={firstAdmin} reference={{ label: plan, monthlyCents: planInfo.kind === "none" ? null : planInfo.monthlyCents }} invoicing={features.includes("finance")} />}
  {tab === "suspensao" && (
    <div class="mt-4 max-w-3xl">
      <SupportSuspensionCard db={db} clinicId={clinic.id} timezone={settings.timezone} />
    </div>
  )}

  {tab === "implantacao" && (
  <div class="mt-5 grid items-start gap-4 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)]">
    <div class="flex min-w-0 flex-col gap-4">
      <section class={`${CARD} overflow-hidden`} aria-labelledby="t-convites">
        <h2 id="t-convites" class={`${SECTION_TITLE} px-4 pt-4 pb-3 sm:px-5`}>Convites</h2>
        <ul>
          {
            invitations.map((invitation) => (
              <li class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-t border-[#e6ecea] px-4 py-3 sm:px-5">
                <span class="flex min-w-0 flex-col gap-1">
                  <strong class="text-[15px] break-all text-ink">{invitation.email}</strong>
                  <span class="flex flex-wrap items-center gap-1.5">
                    <Badge>{invitation.roles.map((r) => ROLE_NAMES[r]).join(" + ")}</Badge>
                    {invitation.acceptedAt ? (
                      <Badge variant="success">Aceito em {when(invitation.acceptedAt)}</Badge>
                    ) : (
                      <Badge variant="warning">Sem resposta</Badge>
                    )}
                    {!invitation.acceptedAt && invitation.lastSentAt && <span class="text-sm text-ink-soft">último envio {when(invitation.lastSentAt)}</span>}
                  </span>
                </span>
                {!invitation.acceptedAt && (
                  <form method="POST" action={action}>
                    <input type="hidden" name="acao" value="reenviar_convite" />
                    <input type="hidden" name="invitation_id" value={invitation.id} />
                    <Button type="submit" size="sm" data-sending-label="Reenviando…">
                      Reenviar convite
                    </Button>
                  </form>
                )}
              </li>
            ))
          }
          {invitations.length === 0 && <li class="border-t border-[#e6ecea] px-4 py-3 text-[15px] text-ink-soft sm:px-5">Nenhum convite registrado.</li>}
        </ul>
      </section>

      {
        ordered.length > 0 && (
          <section class={`${CARD} overflow-hidden`} aria-labelledby="t-pedidos">
            <h2 id="t-pedidos" class={`${SECTION_TITLE} px-4 pt-4 pb-3 sm:px-5`}>
              Pedidos de informações
            </h2>
            {ordered.map((request, index) => (
              <div class={`flex flex-col gap-2 border-t border-[#e6ecea] px-4 py-3.5 sm:px-5 ${index > 0 ? "bg-[#fbfcfc]" : ""}`}>
                <div class="flex flex-wrap items-start justify-between gap-x-3 gap-y-2">
                  <span class="flex min-w-0 flex-col gap-1">
                    <span class="text-[15px] text-ink">
                      Pedido de {when(request.requestedAt)} para <strong class="break-all">{request.email}</strong>
                    </span>
                    <span class="text-sm text-ink-soft">
                      {request.submittedAt
                        ? `Enviado em ${when(request.submittedAt)}`
                        : request.savedAt
                          ? `Rascunho salvo em ${when(request.savedAt)}`
                          : "Ainda não aberto ou não salvo"}
                      {` · link vale até ${when(request.expiresAt)}`}
                      {request.reviewedAt ? ` · revisado em ${when(request.reviewedAt)}` : ""}
                    </span>
                  </span>
                  <span class="flex flex-wrap items-center gap-1.5">
                    <Badge variant={REQUEST_STATUS[request.status].variant}>{REQUEST_STATUS[request.status].label}</Badge>
                    {expired(request) && <Badge variant="danger">Vencido</Badge>}
                  </span>
                </div>
                {(request.submittedAt || request.savedAt || request.status === "submitted") && (
                  <div class="flex flex-wrap items-start justify-between gap-3">
                    {(request.submittedAt || request.savedAt) && (
                      <details class="min-w-0 flex-1" open={request.status === "submitted"}>
                        <summary class="inline-flex min-h-8 cursor-pointer items-center text-[15px] font-semibold text-brand">Ver respostas</summary>
                        <OnboardingAnswersView answers={request.answers} />
                      </details>
                    )}
                    {request.status === "submitted" && (
                      <form method="POST" action={action}>
                        <input type="hidden" name="acao" value="marcar_revisado" />
                        <input type="hidden" name="request_id" value={request.id} />
                        <Button type="submit" size="sm" data-sending-label="Salvando…">
                          Marcar como revisado
                        </Button>
                      </form>
                    )}
                  </div>
                )}
              </div>
            ))}
          </section>
        )
      }
    </div>

    <div class="flex min-w-0 flex-col gap-4">
      {
        clinic.status === "suspended" && (
          <section class={`${PANEL} flex flex-col gap-3`} aria-labelledby="t-situacao">
            <div class="flex flex-wrap items-center gap-2">
              <h2 id="t-situacao" class={SECTION_TITLE}>
                Situação
              </h2>
              <Badge variant="danger">Suspensa</Badge>
            </div>
            <p class="text-[15px] text-ink-soft">
              Painel da clínica restrito à Assinatura, bot calado, links para os pacientes indisponíveis e nada sai pelo WhatsApp. Os motivos e a liberação ficam na aba Suspensão.
            </p>
            <a href={`/admin/sistema/clinicas/${clinic.id}?tab=suspensao`} class="self-start text-[15px] font-semibold text-brand">
              Ver os motivos
            </a>
          </section>
        )
      }
      {
        clinic.status !== "suspended" && (
          <section class={`${PANEL} flex flex-col gap-3`} aria-labelledby="t-situacao">
            <div class="flex flex-wrap items-center gap-2">
              <h2 id="t-situacao" class={SECTION_TITLE}>
                Situação
              </h2>
              {clinic.status === "onboarding" ? <Badge variant="warning">Em implantação</Badge> : <Badge variant="success">Ativa</Badge>}
            </div>
            <p class="text-[15px] text-ink-soft">
              {clinic.status === "onboarding"
                ? "Nada sai para os pacientes pelo WhatsApp: o bot não responde e não há avisos nem envios automáticos. A recepção segue no app WhatsApp Business. Configure, carregue a agenda atual e conecte o WhatsApp; com os templates aprovados, ative."
                : "A clínica fala com os pacientes pelo WhatsApp: bot, avisos e envios automáticos."}
            </p>
            <ul class="flex flex-col gap-1 text-sm text-ink">
              <li>{whatsappLine}</li>
              {templatesLine && <li>{templatesLine}</li>}
            </ul>
            <div class="flex flex-col gap-3 border-t border-line pt-3" id="checklist">
              <p class="text-[15px] font-bold text-ink">
                Checklist de implantação <span class="font-normal text-ink-soft">· {doneCount} de {checklist.items.length}</span>
              </p>
              {CHECKLIST_GROUPS.map((group) => (
                <div class="flex flex-col gap-1.5">
                  <p class="text-[12.5px] font-bold tracking-[.06em] text-ink-soft uppercase">{group}</p>
                  <ul class="flex flex-col gap-2">
                    {checklist.items
                      .filter((item) => item.group === group)
                      .map((item) => (
                        <li class="flex items-start gap-2 text-sm">
                          <span
                            aria-hidden="true"
                            class:list={[
                              "mt-0.5 flex h-[18px] w-[18px] flex-none items-center justify-center rounded border text-[12px] font-bold",
                              item.done ? "border-conf-500 bg-conf-500 text-white" : "border-line-strong bg-white",
                            ]}
                          >
                            {item.done ? "✓" : ""}
                          </span>
                          <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                            <span class:list={["text-ink", !item.done && item.required && "font-semibold"]}>
                              <span class="sr-only">{item.done ? "Feito: " : "Falta: "}</span>
                              {item.label}
                              {!item.required && <span class="font-normal text-ink-soft"> (recomendado)</span>}
                              {item.link && (
                                <>
                                  {" "}
                                  <a href={item.link.href} target="_blank" rel="noopener" class="font-semibold text-brand">
                                    {item.link.label}
                                  </a>
                                </>
                              )}
                            </span>
                            <span class="text-[13px] text-ink-soft">
                              {item.kind === "auto"
                                ? `Conferido pelo sistema${item.detail ? `: ${item.detail}` : ""}`
                                : item.done && item.checkedAt
                                  ? `Marcado pelo Suporte em ${formatInstant(item.checkedAt, settings.timezone, "dd/MM/yyyy")}`
                                  : "O Suporte marca"}
                            </span>
                          </span>
                          {item.kind === "manual" && (
                            <form method="POST" action={action}>
                              <input type="hidden" name="acao" value={item.done ? "desmarcar_item" : "marcar_item"} />
                              <input type="hidden" name="item" value={item.key} />
                              <Button type="submit" size="sm" data-sending-label="Salvando…">
                                {item.done ? "Desmarcar" : "Marcar"}
                              </Button>
                            </form>
                          )}
                        </li>
                      ))}
                  </ul>
                </div>
              ))}
            </div>
            {clinic.status === "onboarding" && !canActivate && (
              <p class="text-sm text-pend-800">
                Para ativar, falta: {checklist.missingRequired.map((i) => i.label.split(" (")[0].split(";")[0].toLowerCase()).join("; ")}.
              </p>
            )}
            <form method="POST" action={action}>
              {clinic.status === "onboarding" ? (
                <>
                  <input type="hidden" name="acao" value="ativar_clinica" />
                  <button
                    type="submit"
                    disabled={!canActivate}
                    class={`${PRIMARY_BUTTON} js-confirm-delete`}
                    data-confirm-title="Ativar a clínica?"
                    data-confirm-message={`${clinic.name} passa a falar com os pacientes pelo WhatsApp: o bot responde, e os avisos e os envios automáticos (lembretes, resumo do dia) começam a sair.`}
                    data-confirm-label="Ativar"
                    data-confirm-tone="primary"
                  >
                    Ativar a clínica
                  </button>
                </>
              ) : (
                <>
                  <input type="hidden" name="acao" value="voltar_implantacao" />
                  <Button
                    type="submit"
                    size="sm"
                    class="js-confirm-delete"
                    data-confirm-title="Voltar para em implantação?"
                    data-confirm-message={`Até ativar de novo, nada sai para os pacientes de ${clinic.name} pelo WhatsApp: o bot para de responder, e os avisos e os envios automáticos param.`}
                    data-confirm-label="Voltar para em implantação"
                  >
                    Voltar para em implantação
                  </Button>
                </>
              )}
            </form>
            <ConfirmDeleteDialog />
          </section>
        )
      }
      <section class={`${PANEL} flex flex-col gap-4`} aria-labelledby="t-portal">
        <div class="flex flex-col gap-1">
          <h2 id="t-portal" class={SECTION_TITLE}>Portal de agendamento</h2>
          <p class="text-[15px] text-ink-soft">
            O endereço da clínica no portal (agendar.recepclinic.com.br/endereço). Trocar o endereço quebra os links já divulgados.
            {portalOn ? " O item está ligado na Matriz." : " O item está desligado na Matriz: o endereço mostra \"Agendamento indisponível\"."}
          </p>
          {portalUrl && (
            <p class="text-[15px]">
              <a href={portalUrl} target="_blank" rel="noopener" class="font-semibold break-all text-brand">{portalUrl}</a>
            </p>
          )}
        </div>
        <form method="POST" action={action} class="flex flex-col gap-4">
          <input type="hidden" name="acao" value="portal_endereco" />
          <div>
            <label for="portal-endereco" class={LABEL}>Endereço</label>
            <input
              id="portal-endereco"
              name="endereco"
              type="text"
              value={clinic.portal_slug ?? suggestPortalSlug(clinic.name)}
              pattern="[a-z0-9]+(-[a-z0-9]+)*"
              minlength="3"
              maxlength="60"
              autocomplete="off"
              spellcheck="false"
              aria-describedby="portal-endereco-ajuda"
              class={INPUT}
            />
            <p id="portal-endereco-ajuda" class="mt-1 text-sm text-ink-soft">De 3 a 60 letras minúsculas, números e hífen, sem acento. Vazio tira a clínica do portal.</p>
          </div>
          <button type="submit" data-sending-label="Salvando…" class={`${PRIMARY_BUTTON} self-start`}>Salvar endereço</button>
        </form>
      </section>
      <section class={`${PANEL} flex flex-col gap-4`} aria-labelledby="t-guia">
        <div class="flex flex-col gap-1">
          <h2 id="t-guia" class={SECTION_TITLE}>Guia para o Administrador</h2>
          <p class="text-[15px] text-ink-soft">
            O que a clínica prepara antes de conectar o WhatsApp: login do Facebook, WhatsApp Business, mensagens automáticas do app desligadas e cartão na
            Meta, com o motivo e o passo a passo. O convite do primeiro Administrador já leva o link.
          </p>
          <p class="flex flex-wrap gap-x-4 gap-y-1 text-[15px]">
            <a href={guideUrl} target="_blank" rel="noopener" class="font-semibold text-brand">Abrir o guia</a>
            <a href={paymentGuideUrl} target="_blank" rel="noopener" class="font-semibold text-brand">Guia do pagamento na Meta</a>
            <a href={guideWhatsapp} target="_blank" rel="noopener" class="font-semibold text-brand">Enviar pelo WhatsApp</a>
          </p>
        </div>
        <form method="POST" action={action} class="flex flex-col gap-4">
          <input type="hidden" name="acao" value="enviar_guia" />
          <div>
            <label for="guia-email" class={LABEL}>E-mail</label>
            <input id="guia-email" name="email" type="email" required value={firstAdmin} class={INPUT} />
          </div>
          <button type="submit" data-sending-label="Enviando…" class={`${PRIMARY_BUTTON} self-start`}>Enviar o guia por e-mail</button>
        </form>
      </section>
      <section class={`${PANEL} flex flex-col gap-4`} aria-labelledby="t-pedir">
        <div class="flex flex-col gap-1">
          <h2 id="t-pedir" class={SECTION_TITLE}>Pedir as informações ao Administrador</h2>
          <p class="text-[15px] text-ink-soft">
            Para quando o Administrador prefere que o Suporte configure: ele recebe um e-mail com o link do formulário (vale 30 dias), e as respostas aparecem
            aqui. Nada entra sozinho na clínica.
          </p>
        </div>
        <form method="POST" action={action} class="flex flex-col gap-4">
          <input type="hidden" name="acao" value="pedir_informacoes" />
          <div>
            <label for="email" class={LABEL}>E-mail</label>
            <input id="email" name="email" type="email" required value={firstAdmin} class={INPUT} />
          </div>
          <button type="submit" data-sending-label="Enviando…" class={`${PRIMARY_BUTTON} self-start`}>Enviar pedido</button>
        </form>
      </section>
      <section class={`${PANEL} flex flex-col gap-4`} aria-labelledby="t-agenda-atual">
        <div class="flex flex-col gap-1">
          <h2 id="t-agenda-atual" class={SECTION_TITLE}>Agenda atual</h2>
          <p class="text-[15px] text-ink-soft">
            Na implantação: a clínica recebe por e-mail um link (vale 15 dias, sem login) para cadastrar os pacientes e as consultas já marcadas, de hoje em
            diante. O Suporte confere e faz a carga, sem o aviso de marcação.
          </p>
        </div>
        {
          agendaImport && importActive && (
            <div class="flex flex-col gap-1.5 rounded-[10px] border border-[#e6ecea] bg-[#fbfcfc] px-3.5 py-3">
              <span class="flex flex-wrap items-center gap-1.5">
                <Badge variant={IMPORT_STATUS[agendaImport.status].variant}>{IMPORT_STATUS[agendaImport.status].label}</Badge>
                {importExpired && <Badge variant="danger">Link vencido</Badge>}
              </span>
              <span class="text-sm text-ink-soft">
                {agendaImport.status === "submitted"
                  ? `Enviada em ${when(agendaImport.submittedAt ?? agendaImport.linkSentAt)}`
                  : `Link enviado em ${when(agendaImport.linkSentAt)} para `}
                {agendaImport.status !== "submitted" && <strong class="break-all text-ink">{agendaImport.email}</strong>}
                {agendaImport.status !== "submitted" && ` · vale até ${when(agendaImport.expiresAt)}`}
              </span>
              {agendaImport.savedAt && (
                <span class="text-sm text-ink">
                  {importPatients} {importPatients === 1 ? "paciente" : "pacientes"} e {importAppointments} {importAppointments === 1 ? "consulta" : "consultas"}
                  {agendaImport.status === "submitted" ? "" : `, salvo em ${when(agendaImport.savedAt)}`}
                </span>
              )}
              {importOpen && agendaImport.returnComment && (
              <span class="text-sm text-ink">
                <strong>Devolvida com o comentário:</strong> {agendaImport.returnComment}
              </span>
            )}
            {agendaImport.status === "submitted" && (
              <Button href={`/admin/sistema/clinicas/${clinic.id}/agenda-atual`} size="sm" class="mt-1 self-start">
                Conferir a agenda atual
              </Button>
            )}
            </div>
          )
        }
        {
          agendaImport?.status === "undone" && (
            <p class="flex flex-wrap items-center gap-1.5 text-sm text-ink-soft">
              <Badge>Desfeita</Badge> A última carga foi desfeita. Dá para pedir a agenda atual de novo.
            </p>
          )
        }
        {
          agendaImport?.status === "loaded" && agendaImport.loadedAt && (
            <p class="flex flex-wrap items-center gap-1.5 text-sm text-ink-soft">
              <Badge variant="success">Carregada</Badge> em {when(agendaImport.loadedAt)}: {importPatients} {importPatients === 1 ? "paciente" : "pacientes"} e{" "}
              {importAppointments} {importAppointments === 1 ? "consulta" : "consultas"} no link.
              <Button href={`/admin/sistema/clinicas/${clinic.id}/agenda-atual`} size="sm">
                Ver a carga ou desfazer
              </Button>
            </p>
          )
        }
        {
          agendaImport?.status !== "submitted" && (
            <form method="POST" action={action} class="flex flex-col gap-4">
              <input type="hidden" name="acao" value="pedir_agenda" />
              <div>
                <label for="agenda-email" class={LABEL}>
                  E-mail
                </label>
                <input id="agenda-email" name="email" type="email" required value={importOpen ? agendaImport!.email : firstAdmin} class={INPUT} />
                {importOpen && <p class="mt-1.5 text-sm text-ink-soft">O link anterior para de funcionar; o que a clínica já digitou continua.</p>}
              </div>
              <button type="submit" data-sending-label="Enviando…" class={`${PRIMARY_BUTTON} self-start`}>
                {importOpen ? "Mandar link novo" : "Pedir a agenda atual"}
              </button>
            </form>
          )
        }
      </section>
    </div>
  </div>
  )}
</AdminLayout>

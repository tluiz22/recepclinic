---
// Configurações › Profissionais (F4.3).
// Redesign R9 (cliente, 17/out/2026): uma linha por profissional, "Ativos | Todos".
import ConfigShell from "../../../components/admin/config/ConfigShell.astro";
import { withAllFilter } from "../../../lib/returnPath";
import ActiveFilter from "../../../components/admin/config/ActiveFilter.astro";
import ConfigEmpty from "../../../components/admin/config/ConfigEmpty.astro";
import { HEAD_ROW, LIST, ROW, ROW_CELL, ROW_GO, ROW_NAME, SOFT } from "../../../components/admin/config/formStyles";
import Icon from "../../../components/admin/Icon.astro";
import PhoneLinks from "../../../components/admin/PhoneLinks.astro";
import IssueBadges from "../../../components/admin/setup/IssueBadges.astro";
import Button from "../../../components/admin/ui/Button.astro";
import Notice from "../../../components/admin/ui/Notice.astro";
import Pill from "../../../components/admin/ui/Pill.astro";
import { buttonClass } from "../../../components/admin/ui/styles";
import { createUserClient } from "../../../lib/data/clients";
import { listProfessionals, professionalRegistry } from "../../../lib/data/config/professionals";
import { loadSetupStatus } from "../../../lib/data/config/setup";
import { getProfessionalLimit } from "../../../lib/data/features";

const clinic = Astro.locals.clinic!;
const showInactive = Astro.url.searchParams.get("todos") === "1";
const db = createUserClient(Astro.request, Astro.cookies);
const [all, limit, setup] = await Promise.all([
  listProfessionals(db, clinic.clinicId, { includeInactive: true }),
  getProfessionalLimit(db, clinic.clinicId),
  // Pendências da jornada de configuração (F6.3b), nos selos.
  loadSetupStatus(db, clinic.clinicId, clinic.features),
]);
const active = all.filter((p) => p.isActive);
// Aba "Desativados" (cliente, 21/out/2026): só os desativados.
const professionals = showInactive ? all.filter((p) => !p.isActive) : active;
// Limite de profissionais ativos (D11): definido pelo Suporte.
const atLimit = limit.active >= limit.max;
const cols = "lg:grid-cols-[minmax(0,2fr)_minmax(0,1.6fr)_minmax(0,1.4fr)_36px]";
---

<ConfigShell current="profissionais" title="Profissionais" subtitle="Quem atende na clínica, com o registro e o WhatsApp do resumo do dia." setup={setup}>
  {
    atLimit ? (
      <span slot="actions" class={`${buttonClass("primary")} cursor-not-allowed opacity-50`} aria-disabled="true">
        <Icon name="plus" class="h-[18px] w-[18px]" strokeWidth={2.2} /> Novo profissional
      </span>
    ) : (
      <Button slot="actions" href="/admin/configuracoes/profissionais/novo" variant="primary">
        <Icon name="plus" class="h-[18px] w-[18px]" strokeWidth={2.2} /> Novo profissional
      </Button>
    )
  }

  {atLimit && <Notice tone="warning">A clínica atingiu o limite de profissionais ativos. Para cadastrar outro, desative um ou fale com o suporte.</Notice>}

  <div class="flex flex-wrap items-center justify-between gap-3">
    <p class="text-sm text-ink-soft" role="status">
      {limit.active} de {limit.max} {limit.max === 1 ? "profissional ativo" : "profissionais ativos"}
    </p>
    <ActiveFilter showInactive={showInactive} active={active.length} inactive={all.length - active.length} />
  </div>

  {
    professionals.length > 0 ? (
      <section aria-label="Profissionais" class={LIST}>
        <div aria-hidden="true" class={`${HEAD_ROW} ${cols}`}>
          <span>Profissional</span>
          <span>Registro</span>
          <span>WhatsApp</span>
          <span />
        </div>
        <ul>
          {professionals.map((p) => {
            const href = withAllFilter(`/admin/configuracoes/profissionais/${p.id}`, showInactive);
            const registry = professionalRegistry(p);
            return (
              <li class={`${ROW} ${cols} ${p.isActive ? "" : "opacity-60"}`}>
                <div class="flex min-w-0 flex-col gap-1">
                  <span class="flex flex-wrap items-center gap-x-2 gap-y-1">
                    <a href={href} class={ROW_NAME}>
                      {p.displayName}
                    </a>
                    {!p.isActive && <Pill>Desativado</Pill>}
                  </span>
                  <span class="text-sm text-ink-soft">{[p.profession, p.specialty].filter(Boolean).join(" · ")}</span>
                  {p.isActive && (
                    <span class="flex flex-wrap gap-1.5 empty:hidden">
                      <IssueBadges issues={setup.issues.professionals.get(p.id)} />
                    </span>
                  )}
                </div>
                <a href={href} aria-label={`Abrir ${p.displayName}`} class={ROW_GO}>
                  <Icon name="chevron-right" class="h-5 w-5" strokeWidth={2.2} />
                </a>
                <span class={ROW_CELL}>{registry || <span class={SOFT}>Sem registro</span>}</span>
                <span class={`${ROW_CELL} flex flex-col gap-0.5`}>
                  {p.phone ? <PhoneLinks phone={p.phone} plain class="text-[15px] text-ink" /> : <span class={SOFT}>Sem WhatsApp</span>}
                  {p.phone && p.receivesDailySummary && <span class="text-sm text-ink-soft">Recebe o resumo do dia</span>}
                </span>
              </li>
            );
          })}
        </ul>
      </section>
    ) : (
      <ConfigEmpty
        onlyInactive={all.length > 0}
        showingInactive={showInactive}
        none="Nenhum profissional"
        text="Sem profissional, não há agenda para marcar."
        href={atLimit ? undefined : "/admin/configuracoes/profissionais/novo"}
        label="Cadastrar o primeiro profissional"
      />
    )
  }
</ConfigShell>

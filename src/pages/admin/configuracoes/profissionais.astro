---
// Configurações › Profissionais (F4.3).
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Badge from "../../../components/admin/Badge.astro";
import IssueBadges from "../../../components/admin/setup/IssueBadges.astro";
import { loadSetupStatus } from "../../../lib/data/config/setup";
import Card from "../../../components/admin/Card.astro";
import ConfiguracoesTabs from "../../../components/admin/ConfiguracoesTabs.astro";
import FlashMessage from "../../../components/admin/FlashMessage.astro";
import { PRIMARY_BUTTON } from "../../../components/admin/fieldStyles";
import { createUserClient } from "../../../lib/data/clients";
import { listProfessionals, professionalRegistry } from "../../../lib/data/config/professionals";
import { getProfessionalLimit } from "../../../lib/data/features";
import { formatPhoneBR } from "../../../lib/phone";

const clinic = Astro.locals.clinic!;
const showInactive = Astro.url.searchParams.get("todos") === "1";
const db = createUserClient(Astro.request, Astro.cookies);
const [professionals, limit] = await Promise.all([
  listProfessionals(db, clinic.clinicId, { includeInactive: showInactive }),
  getProfessionalLimit(db, clinic.clinicId),
]);
// Limite de profissionais ativos (D11): definido pelo Suporte.
const atLimit = limit.active >= limit.max;
// Pendências da jornada de configuração (F6.3b), nos selos.
const setup = await loadSetupStatus(createUserClient(Astro.request, Astro.cookies), clinic.clinicId, clinic.features);
---

<AdminLayout title="Profissionais">
  <h1 class="text-2xl font-bold text-slate-900">Configurações</h1>
  <ConfiguracoesTabs current="profissionais" />
  <FlashMessage />

  <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap items-center gap-3">
      {atLimit ? (
        <span class={`${PRIMARY_BUTTON} cursor-not-allowed opacity-50`} aria-disabled="true">
          Novo profissional
        </span>
      ) : (
        <a href="/admin/configuracoes/profissionais/novo" class={PRIMARY_BUTTON}>
          Novo profissional
        </a>
      )}
      <span class="text-sm text-slate-600">
        {limit.active} de {limit.max} {limit.max === 1 ? "profissional ativo" : "profissionais ativos"}
      </span>
    </div>
    <a href={showInactive ? "?" : "?todos=1"} class="text-sm text-sky-700 hover:underline">
      {showInactive ? "Esconder desativados" : "Mostrar desativados"}
    </a>
  </div>

  {
    atLimit && (
      <p class="mt-3 text-sm text-amber-700">
        A clínica atingiu o limite de profissionais ativos. Para cadastrar outro, desative um ou fale com o suporte.
      </p>
    )
  }

  <ul class="mt-4 grid gap-3 sm:grid-cols-2">
    {
      professionals.map((p) => (
        <li>
          <a href={`/admin/configuracoes/profissionais/${p.id}`}>
            <Card class="h-full hover:border-sky-300 hover:bg-sky-50" muted={!p.isActive}>
              <p class="font-medium text-slate-900">
                {p.displayName} {!p.isActive && <Badge>desativado</Badge>} <IssueBadges issues={setup.issues.professionals.get(p.id)} />
              </p>
              <p class="mt-1 text-sm text-slate-600">{[p.profession, p.specialty].filter(Boolean).join(" · ")}</p>
              {professionalRegistry(p) && <p class="text-sm text-slate-500">{professionalRegistry(p)}</p>}
              {p.phone && (
                <p class="text-sm text-slate-500">
                  {formatPhoneBR(p.phone)}
                  {p.receivesDailySummary ? " · recebe o resumo do dia" : ""}
                </p>
              )}
            </Card>
          </a>
        </li>
      ))
    }
  </ul>
  {professionals.length === 0 && <p class="mt-4 text-sm text-slate-600">Nenhum profissional cadastrado.</p>}
</AdminLayout>

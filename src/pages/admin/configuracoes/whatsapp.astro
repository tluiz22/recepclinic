---
// Configurações › WhatsApp (cliente, 08/out/2026; o lembrete, o resumo do dia
// e a situação da conexão para a clínica ficam na aba Lembretes). F8.1: o
// Administrador também entra, para o "Conectar WhatsApp" (janela da Meta); o
// resto da tela continua só do Suporte (cliente, 25/out). F6.1: o cadastro da conexão (com o token só para gravar), o
// "Testar conexão" e as últimas mensagens da clínica. F6.2: os templates
// padrão na conta da clínica e a situação deles. F8a.1: "Reenviar à Meta" do
// padrão recusado. F8a.2: templates do RecepClinic sem uso na conta, para
// excluir (a busca na Meta só roda com "Procurar", para a tela não esperar).
// F8.2: no cartão Conexão, a situação dos templates em uso, para todos.
// CU4 (tela W2, cliente, 05/nov/2026): "Custo da Meta" do mês para todas as clínicas e a Central de atendimento
// (ligar e desligar pelo Administrador), quando o Suporte libera o item.
import ConfigShell from "../../../components/admin/config/ConfigShell.astro";
import Badge from "../../../components/admin/config/Badge.astro";
import Card from "../../../components/admin/config/Panel.astro";
import ConfirmDeleteDialog from "../../../components/admin/ConfirmDeleteDialog.astro";
import WhatsappConnectionCard from "../../../components/admin/WhatsappConnectionCard.astro";
import { HINT, INPUT, INPUT_INLINE, LABEL, PRIMARY_BUTTON, SECONDARY_BUTTON } from "../../../components/admin/config/formStyles";
import { dayBounds, formatInstant, todayIn } from "../../../lib/clinicTime";
import { createClinicServiceClient } from "../../../lib/data/clinicService";
import { createUserClient } from "../../../lib/data/clients";
import { platformEnv } from "../../../lib/env";
import { getWhatsappConnection, listWhatsappTemplates, pendingCoexistenceSync } from "../../../lib/data/whatsapp/connection";
import { GRAPH_API_VERSION } from "../../../lib/data/whatsapp/graph";
import { DEFAULT_TEMPLATES, PORTAL_CODE_TEMPLATE, templateApproval, templatesInUse, templateStatusFromMeta } from "../../../lib/data/whatsapp/templates";
import { listUnusedTemplates, namesInWaba } from "../../../lib/data/whatsapp/templateSync";
import { portalCodeTemplateState } from "../../../lib/data/whatsapp/codeSender";
import { listLatestWhatsappMessages } from "../../../lib/data/whatsapp/messages";
import { getLatestConnectionTest } from "../../../lib/data/whatsapp/connectionTest";
import { latestAutomaticEcho } from "../../../lib/data/whatsapp/conversations";
import { formatPhoneBR } from "../../../lib/phone";
import CentralCard from "../../../components/admin/config/CentralCard.astro";
import MetaCostCard from "../../../components/admin/config/MetaCostCard.astro";
import { getCentralSwitch } from "../../../lib/data/central";
import { countServiceByOrigin, listMessageCounts, listMetaPriceVersions, priceForMonth } from "../../../lib/data/metaPricing";
import { lastMonths } from "../../../lib/data/usage";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const isSupport = clinic.isPlatformStaff;
// Custo da Meta (CU4): do dia 1º do mês até agora, no fuso da clínica.
const today = todayIn(clinic.timezone);
const [month] = lastMonths(today, 1);
const centralOffered = clinic.features.includes("central_attendance");
const [monthCounts, serviceSplit, prices, centralState] = await Promise.all([
  listMessageCounts(db, month, clinic.clinicId),
  countServiceByOrigin(db, clinic.clinicId, dayBounds(month, clinic.timezone).start, new Date()),
  listMetaPriceVersions(db),
  centralOffered ? getCentralSwitch(db, clinic.clinicId) : Promise.resolve(null),
]);
const monthRow = monthCounts.find((row) => row.month === month);
const counts = { templates: monthRow?.templates ?? 0, service: monthRow?.service ?? 0, appReplies: monthRow?.appReplies ?? 0 };
const currentPrice = priceForMonth(prices, month);
const [connection, latest, templates, lastTest, autoReplyAt] = await Promise.all([
  getWhatsappConnection(db, clinic.clinicId),
  isSupport ? listLatestWhatsappMessages(db, clinic.clinicId, 10) : Promise.resolve([]),
  listWhatsappTemplates(db, clinic.clinicId),
  // Mensagem de teste (IS2): o último envio, para o Administrador e o Suporte.
  getLatestConnectionTest(db, clinic.clinicId),
  // IS4: mensagem automática do app nos últimos 7 dias.
  latestAutomaticEcho(db, clinic.clinicId),
]);
// Janela da Meta (F8.1): com o App ID, o App Secret e a configuração do Embedded Signup.
const env = platformEnv();
const signup =
  env.whatsapp && env.whatsappAppId && env.whatsappSignupConfigId
    ? { appId: env.whatsappAppId, configId: env.whatsappSignupConfigId, graphVersion: GRAPH_API_VERSION }
    : null;
const canConnect = !connection || connection.status === "disconnected";
if (signup && canConnect && Astro.csp) {
  // Só nesta tela: o SDK do Facebook e as molduras e chamadas dele (no `npm run dev` não há CSP).
  Astro.csp.insertScriptResource("'self'");
  Astro.csp.insertScriptResource("https://connect.facebook.net");
  Astro.csp.insertDirective("frame-src https://*.facebook.com");
  Astro.csp.insertDirective("connect-src 'self' https://*.facebook.com https://graph.facebook.com");
}
const CONNECTION_STATUS = { pending: "Em configuração", connected: "Conectado", disconnected: "Desconectado" } as const;
const templateStatus = {
  approved: { label: "Aprovado", variant: "success" },
  pending: { label: "Em análise", variant: "warning" },
  rejected: { label: "Recusado", variant: "danger" },
  disabled: { label: "Desativado", variant: "danger" },
} as const;
const TEMPLATE_LABELS: Record<string, string> = {
  confirmation: "Confirmação",
  reschedule: "Remarcação",
  cancellation: "Cancelamento",
  rescheduled_by_other: "Remarcada por outro responsável",
  canceled_by_other: "Cancelada por outro responsável",
  clinic_cancellation: "Cancelamento pela clínica (com link)",
  reminder: "Lembrete",
  exam_preparation: "Preparo do exame",
  consultation_guidance: "Orientações gerais da consulta",
  connection_test: "Mensagem de teste",
};
// Só o token pela credencial da clínica (como na rota dos templates).
const unused = connection && Astro.url.searchParams.has("sem-uso")
  ? await listUnusedTemplates(createClinicServiceClient(clinic.clinicId), clinic.clinicId, namesInWaba())
  : null;
// Código do portal (seção 14 do plano): sai do número do RecepClinic; o Suporte vê a situação na conta dele.
const portalCode = isSupport && clinic.features.includes("portal") ? await portalCodeTemplateState().catch(() => null) : null;
const templateRows = DEFAULT_TEMPLATES.map((template) => ({ template, saved: templates.find((t) => t.key === template.key && t.version === 1) ?? null }));
import HowItWorks from "../../../components/admin/ui/HowItWorks.astro";
import { configuracoes } from "../../../lib/ajuda/configuracoes";
---

<ConfigShell
  current="whatsapp"
  title="WhatsApp"
  subtitle={isSupport ? "Conexão com a Meta, templates e as últimas mensagens." : "Conexão do número de WhatsApp da clínica com o sistema."}
>

  <HowItWorks id="whatsapp" topic={configuracoes.comoFunciona.whatsapp} class="mb-3">
    <p class="text-[15px] text-ink-soft">A conexão e o que depende dela.</p>
  </HowItWorks>

  <div class="flex max-w-2xl flex-col gap-4">
    <WhatsappConnectionCard connection={connection} timeZone={clinic.timezone} manage={{ signup, pendingSync: pendingCoexistenceSync(connection), templates: templateApproval(templatesInUse(clinic.features), templates), isSupport, canTest: isSupport || clinic.roles.includes("admin"), test: lastTest, autoReplyAt }} />

    <MetaCostCard month={month} today={today} counts={counts} split={serviceSplit} price={currentPrice} />

    {centralState && <CentralCard state={centralState} price={currentPrice} canSwitch={clinic.roles.includes("admin")} timeZone={clinic.timezone} />}

    {
      isSupport && (
        <Card>
          <h2 class="font-display text-[17px] leading-tight font-bold text-ink sm:text-lg">Cadastro da conexão (Suporte)</h2>
          <p class="mt-1 text-sm text-ink-soft">De reserva: a clínica conecta pelo "Conectar WhatsApp", acima.</p>
          <form method="POST" action="/api/admin/configuracoes/whatsapp-conexao" class="mt-3 flex flex-col gap-4">
            <div>
              <label for="phone_number_id" class={LABEL}>Identificador do número (Phone number ID)</label>
              <input id="phone_number_id" name="phone_number_id" required value={connection?.phoneNumberId ?? ""} class={INPUT} />
            </div>
            <div>
              <label for="waba_id" class={LABEL}>Conta do WhatsApp Business (WABA ID)</label>
              <input id="waba_id" name="waba_id" required value={connection?.wabaId ?? ""} class={INPUT} />
            </div>
            <div>
              <label for="display_phone" class={LABEL}>Número exibido</label>
              <input id="display_phone" name="display_phone" placeholder="+55 84 99999-0000" value={connection?.displayPhone ?? ""} class={INPUT} />
            </div>
            <div>
              <label for="status" class={LABEL}>Situação</label>
              <select id="status" name="status" class={INPUT}>
                {(["pending", "connected", "disconnected"] as const).map((value) => (
                  <option value={value} selected={(connection?.status ?? "pending") === value}>
                    {CONNECTION_STATUS[value]}
                  </option>
                ))}
              </select>
              <p class={HINT}>Só "Conectado" recebe as mensagens no webhook e envia.</p>
            </div>
            <div>
              <label class="flex items-center gap-2 text-sm font-medium text-ink-mid">
                <input type="checkbox" name="coexistence" checked={connection?.coexistence ?? false} class="h-[18px] w-[18px] shrink-0 accent-brand" />
                Coexistência (a recepção também usa o app WhatsApp Business neste número)
              </label>
              <p class={HINT}>Só com ela o bot oferece "Falar com a recepção": sem o app, ninguém responderia o paciente.</p>
            </div>
            <div>
              <label for="access_token" class={LABEL}>Token da Meta</label>
              <input id="access_token" name="access_token" type="password" autocomplete="off" placeholder="em branco = mantém o atual" class={INPUT} />
              <p class={HINT}>Token permanente do usuário do sistema do app RecepClinic. Fica guardado no cofre e não é mostrado de volta.</p>
            </div>
            <button type="submit" class={`${PRIMARY_BUTTON} self-start`}>Salvar conexão</button>
          </form>
          <form method="POST" action="/api/admin/configuracoes/whatsapp-registrar" class="mt-4 flex flex-wrap items-end gap-3 border-t border-line pt-4">
            <div>
              <label for="pin" class={LABEL}>PIN de 6 números</label>
              <input id="pin" name="pin" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="off" required class={`${INPUT_INLINE} mt-1.5 w-32`} />
            </div>
            <button type="submit" class={SECONDARY_BUTTON} disabled={!connection}>
              Registrar o número
            </button>
            <p class={`${HINT} basis-full`}>
              Uma vez, para o número posto direto na Cloud API (sem o app do celular). O PIN vira a verificação em duas etapas do número: guarde-o.
            </p>
          </form>
          <form method="POST" action="/api/admin/configuracoes/whatsapp-testar" class="mt-4 border-t border-line pt-4">
            <button type="submit" class={SECONDARY_BUTTON} disabled={!connection}>
              Testar conexão
            </button>
            <p class={HINT}>Pergunta à Meta pelo número com o token gravado e inscreve o app na conta, para as mensagens chegarem.</p>
          </form>
        </Card>
      )
    }

    {
      isSupport && (
        <Card>
          <h2 class="font-display text-[17px] leading-tight font-bold text-ink sm:text-lg">Templates (Suporte)</h2>
          <p class="mt-1 text-sm text-ink-soft">
            Textos padrão do RecepClinic. Só o aprovado pela Meta é enviado; sem ele, o envio fica registrado como "não enviado".
          </p>
          {portalCode && (
            <div class="mt-3 rounded border border-line bg-canvas p-3 text-sm">
              <div class="flex flex-wrap items-center gap-2">
                <span class="font-medium text-ink">Código do portal</span>
                <span class="text-ink-soft">{PORTAL_CODE_TEMPLATE.name}</span>
                {portalCode.status === "unconfigured" ? (
                  <Badge variant="danger">Número não configurado</Badge>
                ) : portalCode.status === "error" ? (
                  <Badge variant="warning">Sem resposta da Meta</Badge>
                ) : portalCode.status === "missing" ? (
                  <Badge variant="danger">Não criado</Badge>
                ) : (
                  <Badge variant={templateStatus[portalCode.status].variant}>{templateStatus[portalCode.status].label}</Badge>
                )}
              </div>
              <p class="mt-0.5 text-ink-soft">
                Sai do número do RecepClinic, para todas as clínicas: não depende do WhatsApp da clínica nem do "Criar na Meta".
              </p>
              {portalCode.status === "unconfigured" && <p class="mt-0.5 text-danger">Faltam as variáveis WHATSAPP_CODE_* na Vercel: o portal fica sem a entrada pelo celular.</p>}
              {portalCode.status === "error" && <p class="mt-0.5 text-pend-800">{portalCode.message}</p>}
              {"rejectionReason" in portalCode && portalCode.rejectionReason && <p class="mt-0.5 text-danger">Motivo da recusa: {portalCode.rejectionReason}</p>}
            </div>
          )}
          <ul class="mt-3 divide-y divide-[#e6ecea] text-sm">
            {templateRows.map(({ template, saved }) => (
              <li class="py-2">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="font-medium text-ink">{TEMPLATE_LABELS[template.key] ?? template.key}</span>
                  <span class="text-ink-soft">{template.name}</span>
                  {/* Texto novo do RecepClinic (outro nome) ainda não criado na Meta: o gravado é a versão anterior. */}
                  {saved && saved.name === template.name ? (
                    <Badge variant={templateStatus[saved.status].variant}>{templateStatus[saved.status].label}</Badge>
                  ) : (
                    <Badge>Não criado</Badge>
                  )}
                </div>
                {saved && saved.name !== template.name && (
                  <p class="mt-0.5 text-pend-800">
                    Versão nova do texto: falta "Criar na Meta". Até lá, vale a anterior ({saved.name}: {templateStatus[saved.status].label.toLowerCase()}).
                  </p>
                )}
                {saved?.name === template.name && saved.rejectionReason && <p class="mt-0.5 text-danger">Motivo da recusa: {saved.rejectionReason}</p>}
                {saved?.name === template.name && saved.status === "rejected" && (
                  <form method="POST" action="/api/admin/configuracoes/whatsapp-templates" class="mt-1">
                    <input type="hidden" name="acao" value="reenviar" />
                    <input type="hidden" name="chave" value={template.key} />
                    <button type="submit" class={SECONDARY_BUTTON} disabled={!connection}>
                      Reenviar à Meta
                    </button>
                    <p class={HINT}>Reenvia com o texto atual do RecepClinic (o de "Ver o texto"), com o mesmo nome. Ele volta para a análise da Meta.</p>
                  </form>
                )}
                <details class="mt-1">
                  <summary class="cursor-pointer text-ink-soft">Ver o texto</summary>
                  <p class="mt-1 whitespace-pre-line rounded bg-canvas p-2 text-ink-mid">{template.body}</p>
                  {template.quickReplies && <p class="mt-1 text-ink-soft">Botões: {template.quickReplies.join(" · ")}</p>}
                </details>
              </li>
            ))}
          </ul>
          <div class="mt-3 flex flex-wrap gap-3 border-t border-line pt-3">
            <form method="POST" action="/api/admin/configuracoes/whatsapp-templates">
              <input type="hidden" name="acao" value="criar" />
              <button type="submit" class={SECONDARY_BUTTON} disabled={!connection}>
                Criar na Meta
              </button>
            </form>
            <form method="POST" action="/api/admin/configuracoes/whatsapp-templates">
              <input type="hidden" name="acao" value="atualizar" />
              <button type="submit" class={SECONDARY_BUTTON} disabled={!connection}>
                Atualizar situação
              </button>
            </form>
          </div>
          <p class={HINT}>
            "Criar na Meta" cria na conta da clínica os que faltam (categoria Utilidade, português). A análise da Meta leva de minutos a algumas horas; a
            situação chega sozinha pelo webhook ou pelo "Atualizar situação".
          </p>
        </Card>
      )
    }

    {
      isSupport && (
        <Card>
          <h2 id="sem-uso" class="font-semibold text-ink">Templates sem uso na Meta (Suporte)</h2>
          <p class="mt-1 text-sm text-ink-soft">
            Templates do RecepClinic (nome começando por "rc_") na conta da Meta que nenhuma clínica da conta usa, como versões antigas. Os templates
            criados pela própria clínica nunca aparecem aqui.
          </p>
          {!connection ? (
            <p class="mt-3 text-sm text-ink-soft">Cadastre a conexão antes.</p>
          ) : unused === null ? (
            <a href="?sem-uso=1#sem-uso" class={`${SECONDARY_BUTTON} mt-3 inline-block`}>
              Procurar templates sem uso
            </a>
          ) : !unused.ok ? (
            <p class="mt-3 text-sm text-danger">{unused.message}</p>
          ) : unused.templates.length === 0 ? (
            <p class="mt-3 text-sm text-ink-soft">Nenhum template sem uso na conta.</p>
          ) : (
            <ul class="mt-3 divide-y divide-[#e6ecea] text-sm">
              {unused.templates.map((t) => (
                <li class="flex flex-wrap items-center justify-between gap-2 py-2">
                  <span class="flex flex-wrap items-center gap-2">
                    <span class="font-medium text-ink">{t.name}</span>
                    <Badge variant={templateStatus[templateStatusFromMeta(t.status)].variant}>{templateStatus[templateStatusFromMeta(t.status)].label}</Badge>
                  </span>
                  <form method="POST" action="/api/admin/configuracoes/whatsapp-templates">
                    <input type="hidden" name="acao" value="excluir" />
                    <input type="hidden" name="nome" value={t.name} />
                    <button
                      type="submit"
                      class={`${SECONDARY_BUTTON} js-confirm-delete text-danger`}
                      data-confirm-title="Excluir da Meta?"
                      data-confirm-message={`${t.name} sai da conta da Meta. Não dá para desfazer, e o nome fica bloqueado por 30 dias.`}
                      data-confirm-label="Excluir"
                    >
                      Excluir da Meta
                    </button>
                  </form>
                </li>
              ))}
            </ul>
          )}
          {/* Conectado, o cartão Conexão já traz a confirmação (Desconectar). */}
          {unused?.ok && unused.templates.length > 0 && connection?.status !== "connected" && <ConfirmDeleteDialog />}
        </Card>
      )
    }

    {
      isSupport && (
        <Card>
          <h2 class="font-display text-[17px] leading-tight font-bold text-ink sm:text-lg">Últimas mensagens (Suporte)</h2>
          {latest.length ? (
            <ul class="mt-2 divide-y divide-[#e6ecea] text-sm">
              {latest.map((m) => (
                <li class="py-2">
                  <span class="text-ink-soft">{formatInstant(m.createdAt, clinic.timezone, "dd/MM HH:mm")}</span>{" "}
                  <span class="font-medium">{m.direction === "inbound" ? "Recebida" : "Enviada"}</span>
                  {m.phone && <span class="text-ink-soft"> · {formatPhoneBR(m.phone)}</span>}
                  <span class="text-ink-soft"> · {m.status ?? m.messageType}</span>
                  {m.body && <p class="mt-0.5 truncate text-ink-mid">{m.body}</p>}
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-2 text-sm text-ink-soft">Nenhuma mensagem registrada ainda.</p>
          )}
        </Card>
      )
    }

  </div>
</ConfigShell>

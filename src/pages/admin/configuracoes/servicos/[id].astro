---
// Configurações › Serviços › novo ou editar (F4.3, D4c): dados do serviço,
// agendas que atendem (D2) e locais em que é oferecido, com preço próprio
// opcional por local. Exame só com o item "Exames e procedimentos" (D11); a
// categoria não muda depois de criado. Os dias e horários entram na F4.4.
import ConfigShell from "../../../../components/admin/config/ConfigShell.astro";
import { allFilterOn, withAllFilter } from "../../../../lib/returnPath";
import ActiveToggle from "../../../../components/admin/ActiveToggle.astro";
import NextStep from "../../../../components/admin/setup/NextStep.astro";
import { loadSetupStatus } from "../../../../lib/data/config/setup";
import PreparationField from "../../../../components/admin/PreparationField.astro";
import Field from "../../../../components/admin/ui/Field.astro";
import { describedBy } from "../../../../components/admin/ui/field";
import { configuracoes } from "../../../../lib/ajuda/configuracoes";
import { CARD, CHECK, CHOICE, HINT, INPUT, INPUT_INLINE, LABEL, PRIMARY_BUTTON, SECONDARY_BUTTON, SECTION_TITLE } from "../../../../components/admin/config/formStyles";
import { createUserClient } from "../../../../lib/data/clients";
import { listAgendas } from "../../../../lib/data/config/agendas";
import { listLocations } from "../../../../lib/data/config/locations";
import { listServices } from "../../../../lib/data/config/services";
import { centsToInput } from "../../../../lib/forms";
import { CATEGORY_LABELS } from "../../../../lib/serviceLabels";
import { originPage, setupOrigin, setupParam } from "../../../../lib/setupFlow";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const { id } = Astro.params;
const isNew = id === "novo";
const [services, agendas, locations] = await Promise.all([
  isNew ? Promise.resolve([]) : listServices(db, clinic.clinicId, { includeInactive: true }),
  listAgendas(db, clinic.clinicId, { includeInactive: true }),
  listLocations(db, clinic.clinicId, { includeInactive: true }),
]);
const service = isNew ? null : (services.find((s) => s.id === id) ?? null);
if (!isNew && !service) return Astro.redirect("/admin/configuracoes/servicos");

const examsOn = clinic.features.includes("exams");
const categories = (["consultation", "return_visit", "exam"] as const).filter((c) => c !== "exam" || examsOn);
// Vindo do aviso "Cadastrar o retorno" da lista, o tipo já vem como Retorno.
// Aberto pela agenda da equipe, já como Exame (ela só atende exames, cliente 21/out/2026).
const fromTeamAgenda = isNew && examsOn && agendas.some((a) => a.kind === "resource" && a.id === setupParam(Astro.url, "agenda"));
const presetCategory = isNew && Astro.url.searchParams.get("tipo") === "retorno" ? "return_visit" : fromTeamAgenda ? "exam" : null;
// Desativados só aparecem se já estão ligados ao serviço.
const agendaOptions = agendas.filter((a) => a.isActive || service?.agendaIds.includes(a.id));
const offered = new Map((service?.locations ?? []).map((l) => [l.locationId, l.priceCents]));
// Domiciliar só com o item liberado (D11); sem ele, as ligações já gravadas ficam guardadas.
const homeVisitOn = clinic.features.includes("home_visit");
const locationOptions = locations.filter((l) => (l.isActive || offered.has(l.id)) && (homeVisitOn || l.type !== "home_visit"));
const hiddenHomeVisit = !homeVisitOn && locations.some((l) => l.type === "home_visit" && offered.has(l.id));
// Aberto da lista em "Todos": o filtro vai e volta (teste da R9, NAV-06).
const all = allFilterOn(Astro.url);
const list = withAllFilter("/admin/configuracoes/servicos", all);
const action = withAllFilter(`/api/admin/configuracoes/servicos/${id}`, all);
// Próximo passo da jornada de configuração (F6.3b).
const setup = isNew ? null : await loadSetupStatus(createUserClient(Astro.request, Astro.cookies), clinic.clinicId, clinic.features);
const serviceIssues = setup?.issues.services.get(id!) ?? [];
const hoursAgenda = service?.agendaIds.find((agendaId) => agendas.some((a) => a.id === agendaId && a.isActive)) ?? null;
// Jornada revista (cliente, 21/out/2026): aberto pelo próximo passo do local
// ou da agenda, o novo serviço já vem com eles marcados e "Voltar" leva para
// lá; a agenda ou o local criados a partir daqui voltam já marcados.
const origin = isNew ? setupOrigin(Astro.url, ["local", "agenda"]) : null;
const back = origin ? { href: originPage(origin), label: "Voltar" } : { href: list, label: "Serviços" };
const markAgendas = new Set([setupParam(Astro.url, "agenda"), setupParam(Astro.url, "marcar_agenda")].filter(Boolean));
const markLocations = new Set([setupParam(Astro.url, "local"), setupParam(Astro.url, "marcar_local")].filter(Boolean));
const noLocation = !locations.some((l) => l.isActive && (homeVisitOn || l.type !== "home_visit"));
const noAgenda = !agendas.some((a) => a.isActive);
---

<ConfigShell current="servicos" title={isNew ? "Novo serviço" : service!.name} back={back}>
  {
    noLocation ? (
      <NextStep text="Antes do serviço, cadastre onde a clínica atende." href={`/admin/configuracoes/locais/novo?servico=${id}`} label="Cadastrar o local" />
    ) : noAgenda ? (
      <NextStep text="Antes do serviço, crie a agenda que vai atendê-lo." href={`/admin/configuracoes/agendas/novo?servico=${id}`} label="Criar a agenda" />
    ) : serviceIssues.includes("no_agenda") || serviceIssues.includes("no_location") ? (
      <NextStep text="Marque abaixo a agenda e o local deste serviço e salve. Depois, cadastre os horários." />
    ) : (
      serviceIssues.includes("no_hours") &&
      hoursAgenda && (
        <NextStep
          text={`${service!.name} ainda não tem horário de atendimento: não aparece no bot nem no link de agendar.`}
          href={`/admin/configuracoes/horarios?agenda=${hoursAgenda}&servico=${service!.id}`}
          label="Cadastrar os horários"
        />
      )
    )
  }

  <div class="flex max-w-3xl flex-col gap-4">
    <form method="POST" action={action} class={`${CARD} flex flex-col gap-5 p-4 sm:p-5`} data-service-form data-category={service?.category ?? ""}>
      <input type="hidden" name="acao" value="salvar" />
      <h2 class={SECTION_TITLE}>O serviço</h2>
      <Field
        id="category"
        label="Tipo"
        kind={isNew ? "label" : "text"}
        help={examsOn ? configuracoes.dicas.servicoTipo : configuracoes.dicas.servicoTipoSemExame}
        hint={isNew ? "O tipo não muda depois de criado." : undefined}
      >
        {
          isNew ? (
            <select id="category" name="category" class={INPUT} aria-describedby={describedBy("category", { hint: true })}>
              {categories.map((c) => (
                <option value={c} selected={c === presetCategory}>
                  {CATEGORY_LABELS[c]}
                </option>
              ))}
            </select>
          ) : (
            <p class="mt-1 text-sm text-ink">{CATEGORY_LABELS[service!.category]}</p>
          )
        }
      </Field>
      <div>
        <label for="name" class={LABEL}>Nome</label>
        <input id="name" name="name" required placeholder="Consulta, Retorno, Espirometria…" value={service?.name ?? ""} class={INPUT} />
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        <div>
          <label for="duration_minutes" class={LABEL}>Duração (min)</label>
          <input id="duration_minutes" name="duration_minutes" type="number" min="1" required value={service?.durationMinutes ?? 30} class={INPUT} />
        </div>
        <div>
          <label for="price" class={LABEL}>Valor (R$)</label>
          <input id="price" name="price" inputmode="decimal" required placeholder="0,00" value={centsToInput(service?.priceCents ?? null)} class={INPUT} />
        </div>
        <div data-only="return_visit">
          <label for="return_deadline_days" class={LABEL}>Prazo do retorno (dias)</label>
          <input id="return_deadline_days" name="return_deadline_days" type="number" min="1" value={service?.returnDeadlineDays ?? ""} class={INPUT} />
          <p class={HINT}>Contado da última consulta na mesma agenda. Vazio = sem prazo.</p>
        </div>
      </div>

      <div data-only="exam">
        <Field id="scheduling_mode" label="Como é marcado" kind="group" help={configuracoes.dicas.servicoModo}>
          <div class="mt-1.5 flex flex-wrap gap-x-5 gap-y-1">
            <label class={CHOICE}>
              <input type="radio" name="scheduling_mode" value="individual" checked={service?.schedulingMode !== "group"} class={CHECK} /> Individual
            </label>
            <label class={CHOICE}>
              <input type="radio" name="scheduling_mode" value="group" checked={service?.schedulingMode === "group"} class={CHECK} /> Em turma (vagas por horário)
            </label>
          </div>
        </Field>
      </div>
      <div data-only="exam">
        <PreparationField value={service?.preparationInstructions} help={configuracoes.dicas.servicoPreparo} />
      </div>

      <fieldset class="min-w-0 border-t border-[#e6ecea] pt-5">
        <legend class={`${SECTION_TITLE} float-left w-full`}>Agendas que atendem</legend>
        <p class={HINT}>O serviço só aparece para marcar nas agendas marcadas aqui.</p>
        <div class="mt-2 flex flex-col gap-2">
          {
            agendaOptions.map((agenda) => (
              // A agenda da equipe só atende exames (cliente, 21/out/2026): some nos outros tipos.
              <label class={CHOICE} data-only={agenda.kind === "resource" ? "exam" : undefined}>
                <input type="checkbox" name="agenda_id" value={agenda.id} checked={service?.agendaIds.includes(agenda.id) || markAgendas.has(agenda.id)} class={CHECK} />
                {agenda.name}
                {agenda.kind === "resource" && " (equipe)"}
                {!agenda.isActive && " (desativada)"}
              </label>
            ))
          }
          {agendaOptions.length === 0 && <p class="text-sm text-ink-soft">Nenhuma agenda cadastrada ainda.</p>}
        </div>
      </fieldset>

      <fieldset class="min-w-0 border-t border-[#e6ecea] pt-5">
        <legend class={`${SECTION_TITLE} float-left w-full`}>Locais em que é oferecido</legend>
        <p class={HINT}>Sem valor próprio, vale o valor do serviço.</p>
        <div class="mt-2 flex flex-col gap-3">
          {
            locationOptions.map((location) => {
              const own = offered.get(location.id) ?? null;
              return (
                <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-ink-mid">
                  <label class="flex min-w-48 items-center gap-2">
                    <input type="checkbox" name="location_id" value={location.id} checked={offered.has(location.id) || markLocations.has(location.id)} class={CHECK} />
                    {location.name}
                    {location.type === "home_visit" && " (domiciliar)"}
                    {!location.isActive && " (desativado)"}
                  </label>
                  <label class="flex items-center gap-2">
                    <input type="checkbox" name={`own_price_${location.id}`} checked={own !== null} class={CHECK} />
                    valor próprio
                  </label>
                  <input
                    name={`price_${location.id}`}
                    inputmode="decimal"
                    aria-label={`Valor em ${location.name}`}
                    placeholder="0,00"
                    value={centsToInput(own)}
                    class={`${INPUT_INLINE} w-28`}
                  />
                </div>
              );
            })
          }
          {locationOptions.length === 0 && <p class="text-sm text-ink-soft">Nenhum local cadastrado ainda.</p>}
          {hiddenHomeVisit && (
            <p class={HINT}>O atendimento domiciliar não está liberado para a clínica. A ligação deste serviço com ele fica guardada e volta se o item for liberado.</p>
          )}
        </div>
      </fieldset>

      <div class="flex flex-wrap gap-2 border-t border-[#e6ecea] pt-4">
        <button type="submit" class={PRIMARY_BUTTON} data-sending-label="Salvando…">{isNew ? "Cadastrar" : "Salvar"}</button>
        <a href={back.href} class={SECONDARY_BUTTON}>Cancelar</a>
      </div>
    </form>
    {!isNew && <ActiveToggle action={action} isActive={service!.isActive} what="o serviço" />}
  </div>

  <script>
    // Mostra só os campos do tipo escolhido (prazo do retorno; turma e preparo do exame).
    const form = document.querySelector<HTMLFormElement>("[data-service-form]");
    const select = document.getElementById("category") as HTMLSelectElement | null;
    const sync = () => {
      const category = select?.value ?? form?.dataset.category ?? "";
      form?.querySelectorAll<HTMLElement>("[data-only]").forEach((el) => {
        el.hidden = el.dataset.only !== category;
        // Agenda da equipe escondida não vai junto (só atende exames).
        if (el.hidden) el.querySelectorAll<HTMLInputElement>('input[name="agenda_id"]').forEach((box) => (box.checked = false));
      });
    };
    select?.addEventListener("change", sync);
    sync();
  </script>
</ConfigShell>

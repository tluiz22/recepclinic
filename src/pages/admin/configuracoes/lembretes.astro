---
// Configurações › Lembretes (cliente, 08 e 09/out/2026): a situação da
// conexão (só leitura; quem cadastra é o Suporte) e um lembrete por público,
// cada um com o próprio item da matriz, a opção de enviar, véspera ou no dia
// e o horário (6h às 20h):
// - ao paciente (item "Lembrete automático");
// - ao profissional, o resumo do dia dos atendimentos dele (item "Lembrete
//   ao profissional"), com quem recebe (antes, no cadastro do profissional);
// - à equipe, o resumo do dia da clínica para os outros contatos (item
//   "Lembrete à equipe").
// O cadastro da conexão, os templates e as últimas mensagens ficam na aba
// WhatsApp, só do Suporte.
import ConfigShell from "../../../components/admin/config/ConfigShell.astro";
import Badge from "../../../components/admin/config/Badge.astro";
import Card from "../../../components/admin/config/Panel.astro";
import { HINT, INPUT_INLINE, PRIMARY_BUTTON, SECONDARY_BUTTON } from "../../../components/admin/config/formStyles";
import WhatsappConnectionCard from "../../../components/admin/WhatsappConnectionCard.astro";
import { createUserClient } from "../../../lib/data/clients";
import { getClinicSettings, REMINDER_HOUR_MAX, REMINDER_HOUR_MIN, type ReminderTiming } from "../../../lib/data/config/clinic";
import { listNotificationRecipients } from "../../../lib/data/config/notificationRecipients";
import { listProfessionals } from "../../../lib/data/config/professionals";
import { getWhatsappConnection } from "../../../lib/data/whatsapp/connection";
import { formatPhoneBR } from "../../../lib/phone";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const patientOn = clinic.features.includes("reminders");
const professionalOn = clinic.features.includes("daily_summary");
const teamOn = clinic.features.includes("team_summary");
const examsOn = clinic.features.includes("exams");
const [connection, settings, recipients, professionals] = await Promise.all([
  getWhatsappConnection(db, clinic.clinicId),
  getClinicSettings(db, clinic.clinicId),
  teamOn ? listNotificationRecipients(db, clinic.clinicId, { includeInactive: true }) : Promise.resolve([]),
  professionalOn ? listProfessionals(db, clinic.clinicId) : Promise.resolve([]),
]);
const hours = Array.from({ length: REMINDER_HOUR_MAX - REMINDER_HOUR_MIN + 1 }, (_, i) => REMINDER_HOUR_MIN + i);
const TIMINGS: { value: ReminderTiming; label: string }[] = [
  { value: "eve", label: "Na véspera" },
  { value: "same_day", label: "No dia do atendimento" },
];
const receives = (r: { receivesConsultations: boolean; receivesExams: boolean }) =>
  [r.receivesConsultations && "consultas", examsOn && r.receivesExams && "exames"].filter(Boolean).join(" e ") || "nada marcado";

// Os três cartões têm a mesma linha de opções.
const cards = {
  patient: { enabled: settings.reminderEnabled, timing: settings.reminderTiming, hour: settings.reminderHour },
  professional: { enabled: settings.professionalSummaryEnabled, timing: settings.professionalSummaryTiming, hour: settings.professionalSummaryHour },
  team: { enabled: settings.teamSummaryEnabled, timing: settings.teamSummaryTiming, hour: settings.teamSummaryHour },
};
---

<ConfigShell current="lembretes" title="Lembretes" subtitle="Os lembretes pelo WhatsApp ao paciente, ao profissional e à equipe.">

  <div class="flex max-w-2xl flex-col gap-4">
    <WhatsappConnectionCard connection={connection} timeZone={clinic.timezone} />

    {
      patientOn && (
        <Card>
          <h2 class="font-display text-[17px] leading-tight font-bold text-ink sm:text-lg">Lembrete ao paciente</h2>
          <p class="mt-1 text-sm text-ink-soft">O paciente recebe um lembrete e pode confirmar a presença, remarcar ou cancelar.</p>
          <form method="POST" action="/api/admin/configuracoes/lembrete" class="mt-3 flex flex-col gap-3">
            <label class="flex items-center gap-2 text-sm font-medium text-ink-mid">
              <input type="checkbox" name="reminder_enabled" checked={cards.patient.enabled} class="h-[18px] w-[18px] shrink-0 accent-brand" />
              Enviar o lembrete
            </label>
            <div class="flex flex-wrap items-center gap-3">
              <select name="reminder_timing" aria-label="Quando enviar o lembrete ao paciente" class={`${INPUT_INLINE} w-56`}>
                {TIMINGS.map((t) => (
                  <option value={t.value} selected={t.value === cards.patient.timing}>
                    {t.label}
                  </option>
                ))}
              </select>
              <span class="text-sm text-ink-soft">às</span>
              <select name="reminder_hour" aria-label="Horário do lembrete ao paciente" class={`${INPUT_INLINE} w-28`}>
                {hours.map((hour) => (
                  <option value={hour} selected={hour === cards.patient.hour}>
                    {String(hour).padStart(2, "0")}:00
                  </option>
                ))}
              </select>
              <button type="submit" class={SECONDARY_BUTTON}>
                Salvar
              </button>
            </div>
          </form>
          <p class={HINT}>
            No fuso da clínica. Na véspera: os atendimentos do dia seguinte. No dia: os atendimentos do dia que começam depois do horário. Os que ficam de
            fora (marcados depois do envio ou antes do horário) têm o botão "Enviar lembrete" na Agenda.
          </p>
        </Card>
      )
    }

    {
      professionalOn && (
        <Card>
          <h2 class="font-display text-[17px] leading-tight font-bold text-ink sm:text-lg">Lembrete ao profissional (resumo do dia)</h2>
          <p class="mt-1 text-sm text-ink-soft">Cada profissional marcado recebe, pelo WhatsApp, a lista dos atendimentos das agendas dele.</p>
          <form method="POST" action="/api/admin/configuracoes/resumo" class="mt-3 flex flex-col gap-3">
            <input type="hidden" name="publico" value="profissional" />
            <label class="flex items-center gap-2 text-sm font-medium text-ink-mid">
              <input type="checkbox" name="enabled" checked={cards.professional.enabled} class="h-[18px] w-[18px] shrink-0 accent-brand" />
              Enviar o resumo do dia
            </label>
            <div class="flex flex-wrap items-center gap-3">
              <select name="timing" aria-label="Quando enviar o resumo ao profissional" class={`${INPUT_INLINE} w-56`}>
                {TIMINGS.map((t) => (
                  <option value={t.value} selected={t.value === cards.professional.timing}>
                    {t.label}
                  </option>
                ))}
              </select>
              <span class="text-sm text-ink-soft">às</span>
              <select name="hour" aria-label="Horário do resumo ao profissional" class={`${INPUT_INLINE} w-28`}>
                {hours.map((hour) => (
                  <option value={hour} selected={hour === cards.professional.hour}>
                    {String(hour).padStart(2, "0")}:00
                  </option>
                ))}
              </select>
            </div>
            <fieldset>
              <legend class="text-sm font-semibold text-ink">Quem recebe</legend>
              {professionals.length ? (
                <ul class="mt-1 flex flex-col gap-1">
                  {professionals.map((p) => (
                    <li>
                      <label class="flex items-center gap-2 text-sm text-ink-mid">
                        <input
                          type="checkbox"
                          name="professional_ids"
                          value={p.id}
                          checked={p.receivesDailySummary}
                          disabled={!p.phone}
                          class="h-[18px] w-[18px] shrink-0 accent-brand"
                        />
                        {p.displayName}
                        <span class="text-ink-soft">{p.phone ? formatPhoneBR(p.phone) : "sem WhatsApp no cadastro"}</span>
                      </label>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="mt-1 text-sm text-ink-soft">Nenhum profissional ativo.</p>
              )}
            </fieldset>
            <button type="submit" class={`${SECONDARY_BUTTON} self-start`}>Salvar</button>
          </form>
          <p class={HINT}>No fuso da clínica. Na véspera: os atendimentos do dia seguinte. No dia: os atendimentos do dia. Um envio só por dia.</p>
        </Card>
      )
    }

    {
      teamOn && (
        <Card>
          <h2 class="font-display text-[17px] leading-tight font-bold text-ink sm:text-lg">Lembrete à equipe (resumo do dia)</h2>
          <p class="mt-1 text-sm text-ink-soft">Os contatos abaixo recebem, pelo WhatsApp, a lista dos atendimentos da clínica.</p>
          <form method="POST" action="/api/admin/configuracoes/resumo" class="mt-3 flex flex-col gap-3">
            <input type="hidden" name="publico" value="equipe" />
            <label class="flex items-center gap-2 text-sm font-medium text-ink-mid">
              <input type="checkbox" name="enabled" checked={cards.team.enabled} class="h-[18px] w-[18px] shrink-0 accent-brand" />
              Enviar o resumo do dia
            </label>
            <div class="flex flex-wrap items-center gap-3">
              <select name="timing" aria-label="Quando enviar o resumo à equipe" class={`${INPUT_INLINE} w-56`}>
                {TIMINGS.map((t) => (
                  <option value={t.value} selected={t.value === cards.team.timing}>
                    {t.label}
                  </option>
                ))}
              </select>
              <span class="text-sm text-ink-soft">às</span>
              <select name="hour" aria-label="Horário do resumo à equipe" class={`${INPUT_INLINE} w-28`}>
                {hours.map((hour) => (
                  <option value={hour} selected={hour === cards.team.hour}>
                    {String(hour).padStart(2, "0")}:00
                  </option>
                ))}
              </select>
              <button type="submit" class={SECONDARY_BUTTON}>
                Salvar
              </button>
            </div>
          </form>
          <p class={HINT}>No fuso da clínica. Na véspera: os atendimentos do dia seguinte. No dia: os atendimentos do dia. Um envio só por dia.</p>

          <div class="mt-4 flex flex-wrap items-center justify-between gap-2">
            <h3 class="text-sm font-semibold text-ink">Contatos da equipe</h3>
            <a href="/admin/configuracoes/contatos/novo" class={PRIMARY_BUTTON}>
              Novo contato
            </a>
          </div>
          <ul class="mt-2 divide-y divide-[#e6ecea]">
            {recipients.map((r) => (
              <li class={r.isActive ? "" : "opacity-60"}>
                <a href={`/admin/configuracoes/contatos/${r.id}`} class="flex flex-wrap items-center justify-between gap-2 py-2 text-sm hover:bg-canvas">
                  <span class="font-medium text-ink">
                    {r.label} {!r.isActive && <Badge>desativado</Badge>}
                  </span>
                  <span class="text-ink-soft">
                    {formatPhoneBR(r.phone)} · {receives(r)}
                  </span>
                </a>
              </li>
            ))}
          </ul>
          {recipients.length === 0 && <p class="mt-1 text-sm text-ink-soft">Nenhum contato cadastrado.</p>}
        </Card>
      )
    }

    {
      !patientOn && !professionalOn && !teamOn && (
        <p class="text-sm text-ink-soft">Os lembretes não estão liberados para a clínica. Fale com o suporte.</p>
      )
    }
  </div>
</ConfigShell>

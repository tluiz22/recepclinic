---
// Configurações › Profissionais › novo ou editar (F4.3, D4b): nome,
// profissão, especialidades (uma ou mais da lista do Suporte, obrigatória; ME,
// cliente, 07/nov/2026), conselho (número e UF) e o WhatsApp para o resumo
// do dia dos próprios atendimentos (D2 revista, 05/out/2026).
// Redesenho (cliente, 13/nov/2026, Opção A): cabeçalho com foto, nome e situação; abas Perfil,
// Atendimento, Convênios e Bot (`?aba=`); cada parte em leitura com "Editar" (`?editar=`), o
// formulário só aberto quando pedido. Especialidades por busca, marcadas como etiquetas, e a
// estrela escolhe a principal. Foto num botão só: escolher o arquivo já envia.
import ConfigShell from "../../../../components/admin/config/ConfigShell.astro";
import { allFilterOn, withAllFilter } from "../../../../lib/returnPath";
import ActiveToggle from "../../../../components/admin/ActiveToggle.astro";
import ConfirmDeleteDialog from "../../../../components/admin/ConfirmDeleteDialog.astro";
import NextStep from "../../../../components/admin/setup/NextStep.astro";
import PhoneLinks from "../../../../components/admin/PhoneLinks.astro";
import { loadSetupStatus } from "../../../../lib/data/config/setup";
import { CARD, HINT, INPUT, LABEL, LEGEND, SECTION_TITLE, PRIMARY_BUTTON, SECONDARY_BUTTON, DANGER_BUTTON } from "../../../../components/admin/config/formStyles";
import { BRAZIL_STATES, COUNCIL_SUGGESTIONS } from "../../../../lib/brazilStates";
import { createUserClient } from "../../../../lib/data/clients";
import { listProfessionals, listSpecialtyOptions, professionalRegistry } from "../../../../lib/data/config/professionals";
import { listInsurancePlans, listProfessionalPlanNotes, listProfessionalPlans } from "../../../../lib/data/config/insurance";
import { EMPTY_BOT_INFO, getProfessionalBotInfo } from "../../../../lib/data/config/professionalBotInfo";
import { formatPhoneBR } from "../../../../lib/phone";
import HelpTip from "../../../../components/admin/ui/HelpTip.astro";
import { configuracoes } from "../../../../lib/ajuda/configuracoes";
import { ownSettingsOnly } from "../../../../lib/clinicAccess";
import { PHOTO_TYPES, profilePhotoLink } from "../../../../lib/data/config/profilePhotos";
import AttendanceCard from "../../../../components/admin/config/AttendanceCard.astro";
import CoverageForm from "../../../../components/admin/config/CoverageForm.astro";
import PortalLinkActions from "../../../../components/admin/config/PortalLinkActions.astro";
import PortalLinkTools from "../../../../components/admin/config/PortalLinkTools.astro";
import { loadPortalSettings } from "../../../../lib/data/config/portal";
import { portalLinksOf } from "../../../../lib/data/config/portalLinks";
import { agendaOfProfessional } from "../../../../lib/data/config/agendas";
import { PROFILE_LABELS } from "../../../../lib/vocabulary";
import { professionalPage, professionalTabs, type ProfessionalEdit, type ProfessionalTab } from "../../../../lib/professionalTabs";
import { loadProfessionalAccess } from "../../../../lib/data/config/professionalAccess";
import { formatInstant } from "../../../../lib/clinicTime";

const clinic = Astro.locals.clinic!;
const { id } = Astro.params;
// Profissional com login (MS, S1): só o próprio cadastro, sem desativar nem criar outro.
const ownOnly = ownSettingsOnly(clinic);
if (ownOnly && id !== clinic.ownProfessionalId) return Astro.redirect(`/admin/configuracoes/profissionais/${clinic.ownProfessionalId}`);
const isNew = id === "novo";
const professional = isNew
  ? null
  : ((await listProfessionals(createUserClient(Astro.request, Astro.cookies), clinic.clinicId, { includeInactive: true })).find((p) => p.id === id) ?? null);
if (!isNew && !professional) return Astro.redirect("/admin/configuracoes/profissionais");
// Aberto da lista em "Todos": o filtro vai e volta (teste da R9, NAV-06).
const all = allFilterOn(Astro.url);
const list = withAllFilter("/admin/configuracoes/profissionais", all);
const action = withAllFilter(`/api/admin/configuracoes/profissionais/${id}`, all);
// Próximo passo da jornada de configuração (F6.3b).
const setup = isNew ? null : await loadSetupStatus(createUserClient(Astro.request, Astro.cookies), clinic.clinicId, clinic.features);
const subtitle = professional ? [professional.profession, professional.specialty, professionalRegistry(professional)].filter(Boolean).join(" · ") || undefined : undefined;
const professionalIssues = setup?.issues.professionals.get(id!) ?? [];
// Especialidades: as do profissional primeiro (na ordem, a principal na frente),
// depois as outras da lista; desativada pelo Suporte só aparece se já está ligada.
const chosen = professional?.specialties ?? [];
const chosenIds = new Set(chosen.map((s) => s.id));
const specialtyOptions = [...chosen, ...(await listSpecialtyOptions(createUserClient(Astro.request, Astro.cookies))).filter((s) => !chosenIds.has(s.id))];
// Particular e convênios (MC; F1 da recepção digital): só com o item "Convênios".
const insuranceOn = clinic.features.includes("insurance") && !isNew;
// Informações que o bot responde (MI, M5): só por profissional, com o bot.
const botOn = clinic.features.includes("whatsapp_bot") && !isNew;

// Abas e a parte aberta para edição (o cadastro novo é só o formulário).
// Acesso ao painel (cliente, 13/nov/2026): o Administrador convida pelo próprio cadastro.
const canInvite = !isNew && !ownOnly;
const { tabs, tab, edit } = professionalTabs(Astro.url, { insurance: insuranceOn, bot: botOn, access: canInvite });
const pageHref = (t: ProfessionalTab, e?: ProfessionalEdit) => professionalPage(id!, t, e ?? null, all);
const editing = (part: ProfessionalEdit) => isNew || edit === part;

const db = createUserClient(Astro.request, Astro.cookies);
const [plans, acceptedPlans, planNotes] =
  insuranceOn && tab === "convenios"
    ? await Promise.all([listInsurancePlans(db, clinic.clinicId), listProfessionalPlans(db, clinic.clinicId, id!), listProfessionalPlanNotes(db, clinic.clinicId, id!)])
    : [[], [] as string[], new Map<string, string>()];
const planName = new Map(plans.map((p) => [p.id, p.name]));
const acceptsPrivate = professional?.acceptsPrivate ?? true;
const botInfo = botOn && tab === "bot" ? await getProfessionalBotInfo(db, clinic.clinicId, id!) : EMPTY_BOT_INFO;
// Foto (cliente, 08/nov/2026): no cabeçalho e na linha "Foto" do Perfil.
const photoUrl = isNew ? null : await profilePhotoLink(db, clinic.clinicId, { kind: "professional", id: id! });
const agenda = isNew || tab !== "atendimento" ? null : await agendaOfProfessional(db, clinic.clinicId, id!);
const access = canInvite ? await loadProfessionalAccess(db, clinic.clinicId, professional!) : null;
// E-mail de quem já é da Equipe: a aba pede a confirmação de ligar ao login dessa pessoa.
const linkEmail = tab === "acesso" && access?.state === "none" ? Astro.url.searchParams.get("ligar") : null;
// Link de agendamento (F5b): só com o Portal, e quando o profissional aparece nele.
const portalLink =
  !isNew && clinic.features.includes("portal")
    ? await loadPortalSettings(db, clinic.clinicId)
        .then((settings) => {
          const mine = settings.professionals.find((p) => p.id === id);
          const link = portalLinksOf(Astro.url, settings).professionals.get(id!);
          return mine && link ? { link, shown: mine.showInPortal } : null;
        })
        .catch(() => null)
    : null;
const searchKey = (text: string) => text.normalize("NFD").replace(/\p{Diacritic}/gu, "").toLowerCase();
const initials =
  (professional?.displayName ?? "")
    .replace(/^(dra?|dr)\.?\s+/i, "")
    .split(/\s+/)
    .filter(Boolean)
    .map((w) => w[0])
    .filter((_, i, all) => i === 0 || i === all.length - 1)
    .join("")
    .toLocaleUpperCase("pt-BR") || "?";
const chip = (tone: "ok" | "off" | "pend") =>
  `inline-flex items-center rounded-full px-2.5 py-0.5 text-[13.5px] font-semibold ${
    tone === "ok" ? "bg-conf-100 text-conf-800" : tone === "pend" ? "bg-pend-100 text-pend-800" : "bg-canvas-deep text-ink-mid"
  }`;
const tabClass = (on: boolean) =>
  `inline-flex min-h-11 shrink-0 items-center whitespace-nowrap border-b-[3px] px-1 text-base font-semibold no-underline ${on ? "border-brand text-brand-ink" : "border-transparent text-ink-soft hover:text-ink"}`;
const EDIT_LINK = `${SECONDARY_BUTTON} shrink-0`;
const DT = "text-sm text-ink-soft";
const DD = "mt-0.5 font-semibold break-words text-ink";
const registry = professional ? professionalRegistry(professional) : "";
// Diálogo de confirmação: o do Desativar já vem com o ActiveToggle.
const needsDialog =
  (!!photoUrl && tab === "perfil" && (ownOnly || !professional?.isActive)) || (tab === "acesso" && access?.state !== "none");
---

<ConfigShell
  current="profissionais"
  title={isNew ? "Novo profissional" : professional!.displayName}
  pageTitle={isNew ? "Novo profissional" : professional!.displayName}
  back={ownOnly ? undefined : { href: list, label: "Profissionais" }}
  subtitle={isNew ? undefined : subtitle}
  hideTitle={!isNew}
>
  {
    professionalIssues.includes("no_specialty") && (
      <NextStep text={`Falta a especialidade de ${professional!.displayName}: em Perfil, clique em Editar e marque ao menos uma.`} />
    )
  }
  {
    professionalIssues.includes("no_agenda") &&
      (ownOnly ? (
        <NextStep text="Sua agenda ainda não está ativa: sem ela, não recebe atendimentos. Fale com o Administrador da clínica." />
      ) : setup!.inactiveAgendaOf.has(id!) ? (
        <NextStep
          text={`A agenda de ${professional!.displayName} está desativada: sem ela, não recebe atendimentos.`}
          href={`/admin/configuracoes/agendas/${setup!.inactiveAgendaOf.get(id!)}?todos=1`}
          label="Abrir a agenda para reativar"
        />
      ) : setup!.hasLocations ? (
        <NextStep
          text={`${professional!.displayName} ainda não tem agenda: sem ela, não recebe atendimentos.`}
          href={`/admin/configuracoes/agendas/novo?profissional=${id}`}
          label="Criar a agenda"
        />
      ) : (
        <NextStep
          text={`${professional!.displayName} ainda não tem agenda. Antes dela, cadastre onde a clínica atende.`}
          href={`/admin/configuracoes/locais/novo?profissional=${id}`}
          label="Cadastrar o local"
        />
      ))
  }

  <div class="flex max-w-3xl min-w-0 flex-col gap-4">
    {
      !isNew && (
        <>
          <section class={`${CARD} flex min-w-0 flex-wrap items-center gap-4 p-4 sm:p-5`} aria-label="Resumo do profissional">
            {photoUrl ? (
              <img src={photoUrl} alt={`Foto de ${professional!.displayName}`} class="h-16 w-16 shrink-0 rounded-full border border-line object-cover sm:h-[76px] sm:w-[76px]" />
            ) : (
              <span
                class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-brand-soft font-display text-[22px] font-bold text-brand-ink sm:h-[76px] sm:w-[76px] sm:text-[26px]"
                role="img"
                aria-label="Sem foto"
              >
                {initials}
              </span>
            )}
            <div class="flex min-w-0 flex-1 flex-col gap-1">
              <h1 class="font-display text-[22px] leading-tight font-bold break-words text-ink sm:text-[26px]">{professional!.displayName}</h1>
              {subtitle && <p class="text-[15px] text-ink-soft">{subtitle}</p>}
              <div class="mt-1 flex flex-wrap gap-2">
                <span class={chip(professional!.isActive ? "ok" : "off")}>{professional!.isActive ? "Ativo" : "Desativado"}</span>
                {portalLink && <span class={chip(portalLink.shown ? "ok" : "off")}>{portalLink.shown ? "No portal" : "Fora do portal"}</span>}
                {access?.state === "none" && (
                  <a href={pageHref("acesso")} class={`${chip("pend")} no-underline hover:underline`}>
                    Sem acesso ao painel · convidar
                  </a>
                )}
                {access?.state === "invited" && (
                  <a href={pageHref("acesso")} class="inline-flex items-center rounded-full bg-att-100 px-2.5 py-0.5 text-[13.5px] font-semibold text-att-800 no-underline hover:underline">
                    Convite enviado
                  </a>
                )}
              </div>
            </div>
          </section>

          <nav aria-label="Partes do cadastro" class="-mx-4 overflow-x-auto border-b border-line px-4 sm:mx-0 sm:px-0">
            <div class="flex gap-x-5">
              {tabs.map((t) => (
                <a href={pageHref(t.id)} aria-current={t.id === tab ? "page" : undefined} class={tabClass(t.id === tab)}>
                  {t.label}
                </a>
              ))}
            </div>
          </nav>
        </>
      )
    }

    {
      (isNew || tab === "perfil") &&
        (editing("dados") ? (
          <form method="POST" action={action} class={`${CARD} flex flex-col gap-5 p-4 sm:p-5 ${isNew ? "" : "border-2 border-brand"}`} aria-labelledby="dados-titulo">
            <input type="hidden" name="acao" value="salvar" />
            <h2 id="dados-titulo" class={SECTION_TITLE}>{isNew ? "Dados do profissional" : "Editar dados do profissional"}</h2>
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="display_name" class={LABEL}>Nome (como aparece para o paciente)</label>
                <input id="display_name" name="display_name" required value={professional?.displayName ?? ""} class={INPUT} />
              </div>
              <div>
                <label for="profession" class={LABEL}>Profissão</label>
                <input id="profession" name="profession" required placeholder="Médica, Dentista, Psicóloga…" value={professional?.profession ?? ""} class={INPUT} />
              </div>
            </div>
            <fieldset class="min-w-0" data-specialties>
              <legend class={LEGEND}>Especialidades</legend>
              <p id="specialties-orientacao" class={HINT}>
                No WhatsApp, o paciente escolhe a especialidade antes do profissional. Falta alguma na lista? Peça ao Suporte.
              </p>
              <ul class="mt-2 flex flex-wrap gap-2" aria-label="Especialidades marcadas" data-chosen hidden></ul>
              <p class={`${HINT} mt-1`} data-star-hint hidden>
                A estrela marca a principal: aparece primeiro ao lado do nome.
              </p>
              <div class="mt-2 flex flex-wrap items-center gap-2" data-filter-row hidden>
                <input
                  type="search"
                  aria-label="Buscar especialidade para incluir"
                  aria-controls="specialties-list"
                  aria-describedby="specialties-orientacao"
                  placeholder="Buscar e incluir: pediatria, ortodontia…"
                  autocomplete="off"
                  class={`${INPUT} mt-0 min-w-0 flex-1 sm:max-w-sm`}
                  data-specialty-filter
                />
                <button type="button" class={SECONDARY_BUTTON} aria-controls="specialties-list" aria-expanded="false" data-show-all>
                  Ver a lista
                </button>
              </div>
              <div id="specialties-list" class="mt-2 grid max-h-72 overflow-y-auto rounded-lg border border-line-strong px-3 py-2 sm:grid-cols-2 sm:gap-x-6">
                {specialtyOptions.map((s) => (
                  <label class="flex min-h-10 items-center gap-2.5 py-1 text-[15px] text-ink" data-specialty-option data-key={searchKey(s.name)} data-name={s.name}>
                    <input type="checkbox" name="specialties" value={s.id} checked={chosenIds.has(s.id)} class="h-[18px] w-[18px] shrink-0 accent-brand" />
                    <span>
                      {s.name}
                      {!s.isActive && <span class="text-sm text-ink-soft"> (saiu da lista)</span>}
                    </span>
                  </label>
                ))}
                <p class={`${HINT} col-span-full mt-0 py-1`} data-specialty-empty hidden>
                  Nenhuma especialidade com esse nome. Peça ao Suporte para incluir.
                </p>
              </div>
              <div class="mt-3" data-principal hidden={chosen.length < 2}>
                <label for="principal" class={LABEL}>Especialidade principal</label>
                <select id="principal" name="principal" class={`${INPUT} sm:max-w-sm`}>
                  {specialtyOptions.map((s, i) => (
                    <option value={s.id} selected={i === 0 && chosen.length > 0} hidden={!chosenIds.has(s.id)}>
                      {s.name}
                    </option>
                  ))}
                </select>
                <p class={HINT}>Aparece primeiro ao lado do nome.</p>
              </div>
            </fieldset>
            <div class="grid gap-4 sm:grid-cols-4">
              <div>
                <label for="council" class={LABEL}>Conselho</label>
                <input id="council" name="council" list="councils" value={professional?.council ?? ""} class={INPUT} />
                <datalist id="councils">{COUNCIL_SUGGESTIONS.map((c) => <option value={c} />)}</datalist>
              </div>
              <div>
                <label for="council_number" class={LABEL}>Número</label>
                <input id="council_number" name="council_number" value={professional?.councilNumber ?? ""} class={INPUT} />
              </div>
              <div>
                <label for="council_state" class={LABEL}>UF</label>
                <select id="council_state" name="council_state" class={INPUT}>
                  <option value="">—</option>
                  {BRAZIL_STATES.map((uf) => <option value={uf} selected={uf === professional?.councilState}>{uf}</option>)}
                </select>
              </div>
              <div>
                <HelpTip subject="RQE" text={configuracoes.dicas.profissionalRqe} id="rqe">
                  <label for="rqe" class={LABEL}>RQE (opcional)</label>
                </HelpTip>
                <input id="rqe" name="rqe" inputmode="numeric" placeholder="6271" value={professional?.rqe ?? ""} class={INPUT} />
              </div>
            </div>
            <p class={`${HINT} -mt-3`}>Mais de um RQE: separe por vírgula (ex.: 6271, 8890).</p>
            <div class="sm:max-w-xs">
              <HelpTip subject="WhatsApp do profissional" text={configuracoes.dicas.profissionalWhatsapp} id="phone">
                <label for="phone" class={LABEL}>WhatsApp</label>
              </HelpTip>
              <input
                id="phone"
                name="phone"
                type="tel"
                required
                placeholder="(84) 99999-9999"
                value={professional?.phone ? formatPhoneBR(professional.phone) : ""}
                class={INPUT}
              />
            </div>
            {isNew && !ownOnly && (
              <div class="border-t border-[#e6ecea] pt-5 sm:max-w-md">
                <label for="email" class={LABEL}>E-mail para acessar o painel (opcional)</label>
                <input id="email" name="email" type="email" autocomplete="off" placeholder="nome@email.com" aria-describedby="email-hint" class={INPUT} />
                <p id="email-hint" class={HINT}>
                  Preenchido, o convite sai ao cadastrar: o profissional cria a senha e vê a própria agenda. Dá para convidar depois, na aba Acesso ao painel.
                </p>
              </div>
            )}
            <div class="flex flex-wrap gap-2 border-t border-[#e6ecea] pt-4">
              <button type="submit" class={PRIMARY_BUTTON} data-sending-label="Salvando…">{isNew ? "Cadastrar" : "Salvar"}</button>
              <a href={isNew ? list : pageHref("perfil")} class={SECONDARY_BUTTON}>Cancelar</a>
            </div>
          </form>
        ) : (
          <section class={`${CARD} min-w-0 p-4 sm:p-5`} aria-labelledby="dados-titulo">
            <div class="flex items-center justify-between gap-3">
              <h2 id="dados-titulo" class={SECTION_TITLE}>Dados do profissional</h2>
              <a href={pageHref("perfil", "dados")} class={EDIT_LINK} aria-label="Editar dados do profissional">Editar</a>
            </div>
            <dl class="mt-4 grid gap-x-6 gap-y-4 text-[15.5px] sm:grid-cols-2">
              <div>
                <dt class={DT}>Nome para o paciente</dt>
                <dd class={DD}>{professional!.displayName}</dd>
              </div>
              <div>
                <dt class={DT}>Profissão</dt>
                <dd class={DD}>{professional!.profession || "—"}</dd>
              </div>
              <div>
                <dt class={DT}>Especialidades</dt>
                <dd class={DD}>
                  {chosen.length === 0
                    ? "Nenhuma"
                    : chosen.map((s, i) => (
                        <>
                          {i > 0 && ", "}
                          {s.name}
                          {i === 0 && chosen.length > 1 && <span class="font-normal text-ink-soft"> (principal)</span>}
                        </>
                      ))}
                </dd>
              </div>
              <div>
                <dt class={DT}>Registro</dt>
                <dd class={DD}>{registry ? registry.split(" | ").join(" · ") : "—"}</dd>
              </div>
              <div>
                <dt class={DT}>WhatsApp</dt>
                <dd class={DD}>{professional!.phone ? <PhoneLinks phone={professional!.phone} /> : "—"}</dd>
              </div>
              <div>
                <dt class={DT}>Foto</dt>
                <dd class="mt-1 flex flex-wrap items-center gap-2">
                  {photoUrl && <img src={photoUrl} alt="" class="h-11 w-11 rounded-full border border-line object-cover" />}
                  {!photoUrl && <span class="font-semibold text-ink">Sem foto</span>}
                  <form method="POST" action={action} enctype="multipart/form-data" class="flex flex-wrap items-center gap-2" data-photo-form>
                    <input type="hidden" name="acao" value="foto" />
                    <label for="photo" class="sr-only">{photoUrl ? "Trocar a foto" : "Enviar a foto"}</label>
                    <input
                      type="file"
                      id="photo"
                      name="photo"
                      required
                      accept={Object.keys(PHOTO_TYPES).join(",")}
                      aria-describedby="photo-hint"
                      class="w-full min-w-0 text-[15px] text-ink file:mr-3 file:h-10 file:rounded-lg file:border file:border-line-strong file:bg-white file:px-3 file:font-semibold"
                      data-photo-input
                    />
                    <button type="submit" class={SECONDARY_BUTTON} data-sending-label="Enviando…" data-photo-button>
                      {photoUrl ? "Trocar foto" : "Enviar foto"}
                    </button>
                  </form>
                  {photoUrl && (
                    <form method="POST" action={action}>
                      <input type="hidden" name="acao" value="remover_foto" />
                      <button
                        type="submit"
                        class={`${DANGER_BUTTON} js-confirm-delete`}
                        data-confirm-title="Remover a foto?"
                        data-confirm-message="O cadastro fica sem foto. Dá para enviar outra depois."
                        data-confirm-label="Remover"
                      >
                        Remover foto
                      </button>
                    </form>
                  )}
                  <p id="photo-hint" class={`${HINT} mt-0 w-full`}>PNG, JPG ou WebP, até 4 MB. De preferência quadrada, com o rosto no centro.</p>
                </dd>
              </div>
            </dl>
          </section>
        ))
    }
    {isNew && <p class="text-sm text-ink-soft">Depois de cadastrar, você inclui aqui mesmo a foto, o atendimento e os convênios.</p>}

    {
      !isNew && tab === "perfil" && portalLink && (
        <section class={`${CARD} min-w-0 p-4 sm:p-5`} aria-labelledby="link-agendamento-titulo">
          <h2 id="link-agendamento-titulo" class={SECTION_TITLE}>Link de agendamento</h2>
          {portalLink.shown ? (
            <>
              <p class="mt-1 text-sm text-ink-soft">O paciente marca direto com {professional!.displayName}. Para pôr no Instagram, no site, no Google ou mandar em mensagem.</p>
              <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1">
                <span class="min-w-0 break-all text-[15px] font-semibold text-brand-ink">{portalLink.link.url}</span>
                <a href={portalLink.link.url} target="_blank" rel="noopener" class="inline-flex min-h-10 items-center text-[15px] font-semibold text-brand underline">
                  Ver como o paciente vê
                </a>
              </p>
              <div class="mt-3">
                <PortalLinkActions id="link-perfil" url={portalLink.link.url} label={professional!.displayName} qrKey={id!} posterUrl={portalLink.link.posterUrl} />
              </div>
            </>
          ) : (
            <p class="mt-1 text-sm text-ink-soft">
              Fora do portal: o paciente não vê este profissional e o link não abre.{" "}
              {ownOnly ? "Para mostrar, fale com o Administrador da clínica." : 'Para mostrar, use "Mostrar no portal" em Configurações › Portal.'}
            </p>
          )}
        </section>
      )
    }
    {!isNew && !ownOnly && tab === "perfil" && <ActiveToggle action={action} isActive={professional!.isActive} what="o profissional" />}

    {
      !isNew && tab === "atendimento" &&
        (editing("atendimento") || !agenda ? (
          <AttendanceCard
            action={action}
            attendance={agenda}
            who="do profissional"
            createAgendaHref={ownOnly ? undefined : `/admin/configuracoes/agendas/novo?profissional=${encodeURIComponent(id!)}`}
            cancelHref={agenda ? pageHref("atendimento") : undefined}
          />
        ) : (
          <section class={`${CARD} min-w-0 p-4 sm:p-5`} aria-labelledby="atendimento-titulo">
            <div class="flex items-center justify-between gap-3">
              <h2 id="atendimento-titulo" class={SECTION_TITLE}>Atendimento</h2>
              <a href={pageHref("atendimento", "atendimento")} class={EDIT_LINK} aria-label="Editar atendimento">Editar</a>
            </div>
            <p class={HINT}>Valem para o bot e o link de agendar nos serviços do profissional.</p>
            <dl class="mt-4 grid gap-x-6 gap-y-4 text-[15.5px] sm:grid-cols-3">
              <div>
                <dt class={DT}>Perfil</dt>
                <dd class={DD}>{PROFILE_LABELS[agenda.profile]}</dd>
              </div>
              <div>
                <dt class={DT}>Oferece horários até</dt>
                <dd class={DD}>{agenda.bookingHorizonDays} dias à frente</dd>
              </div>
              <div>
                <dt class={DT}>Idade limite para consulta</dt>
                <dd class={DD}>{agenda.consultationAgeLimitYears === null ? "Sem limite" : `${agenda.consultationAgeLimitYears} anos`}</dd>
              </div>
            </dl>
          </section>
        ))
    }

    {
      insuranceOn && tab === "convenios" &&
        (editing("convenios") ? (
          <CoverageForm
            action={action}
            plans={plans}
            acceptedIds={acceptedPlans}
            notes={planNotes}
            acceptsPrivate={acceptsPrivate}
            privateLabel="Atende particular"
            privateHint="Desmarcado: atende só pelos convênios abaixo."
            legend="Convênios atendidos"
            canRegisterPlans={!ownOnly}
            cancelHref={pageHref("convenios")}
          />
        ) : (
          <section class={`${CARD} min-w-0 p-4 sm:p-5`} aria-labelledby="convenios-titulo">
            <div class="flex items-center justify-between gap-3">
              <h2 id="convenios-titulo" class={SECTION_TITLE}>Particular e convênios</h2>
              <a href={pageHref("convenios", "convenios")} class={EDIT_LINK} aria-label="Editar particular e convênios">Editar</a>
            </div>
            <p class={HINT}>No WhatsApp e no agendamento online, o paciente só vê o que estiver aqui.</p>
            <ul class="mt-4 flex flex-col gap-2.5 text-[15.5px] text-ink">
              <li>
                <strong>Particular</strong> · {acceptsPrivate ? "atende" : "não atende"}
              </li>
              {acceptedPlans
                .filter((pid) => planName.has(pid))
                .map((pid) => (
                  <li>
                    <strong>{planName.get(pid)}</strong>
                    {planNotes.get(pid) && <span class="text-ink-soft"> · “{planNotes.get(pid)}”</span>}
                  </li>
                ))}
              {acceptedPlans.filter((pid) => planName.has(pid)).length === 0 && <li class="text-ink-soft">Nenhum convênio marcado.</li>}
            </ul>
          </section>
        ))
    }

    {
      botOn && tab === "bot" &&
        (editing("bot") ? (
          <form method="POST" action={action} class={`${CARD} flex flex-col gap-4 border-2 border-brand p-4 sm:p-5`} aria-labelledby="bot-info-titulo">
            <input type="hidden" name="acao" value="bot_info" />
            <div>
              <h2 id="bot-info-titulo" class={SECTION_TITLE}>Editar o que o bot responde</h2>
              <p class={HINT}>
                No WhatsApp, o paciente vê estas respostas em <strong>Informações gerais</strong> (com mais de um profissional, depois de escolher{" "}
                {professional!.displayName}). Vazio: a opção não aparece.
              </p>
            </div>
            <div>
              <label for="payment_info" class={LABEL}>Formas de pagamento</label>
              <textarea id="payment_info" name="payment_info" rows="2" maxlength="1000" placeholder="Pix, cartão de débito e crédito em até 3x" class={INPUT}>{botInfo.paymentInfo ?? ""}</textarea>
              <p class={HINT}>Aparece depois dos valores dos serviços.</p>
            </div>
            <div>
              <label for="insurance_info" class={LABEL}>Sobre convênios</label>
              <textarea id="insurance_info" name="insurance_info" rows="2" maxlength="1000" placeholder="Traga a carteirinha e um documento com foto." class={INPUT}>{botInfo.insuranceInfo ?? ""}</textarea>
              <p class={HINT}>
                {insuranceOn ? "A lista de convênios sai da aba Convênios; aqui vai o que ela não diz." : "É a resposta de Informações gerais › Convênios, do jeito que estiver escrito."}
              </p>
            </div>
            <div>
              <label for="notes" class={LABEL}>Observações</label>
              <textarea id="notes" name="notes" rows="2" maxlength="1000" placeholder="Chegue 10 minutos antes." class={INPUT}>{botInfo.notes ?? ""}</textarea>
            </div>
            <div class="flex flex-wrap gap-2 border-t border-[#e6ecea] pt-4">
              <button type="submit" class={PRIMARY_BUTTON} data-sending-label="Salvando…">Salvar</button>
              <a href={pageHref("bot")} class={SECONDARY_BUTTON}>Cancelar</a>
            </div>
          </form>
        ) : (
          <section class={`${CARD} min-w-0 p-4 sm:p-5`} aria-labelledby="bot-info-titulo">
            <div class="flex items-center justify-between gap-3">
              <h2 id="bot-info-titulo" class={SECTION_TITLE}>O que o bot responde</h2>
              <a href={pageHref("bot", "bot")} class={EDIT_LINK} aria-label="Editar o que o bot responde">Editar</a>
            </div>
            <p class={HINT}>Em Informações gerais, depois de o paciente escolher {professional!.displayName}. Vazio: a opção não aparece.</p>
            <dl class="mt-4 flex flex-col gap-3 text-[15.5px]">
              {[
                ["Formas de pagamento", botInfo.paymentInfo],
                ["Sobre convênios", botInfo.insuranceInfo],
                ["Observações", botInfo.notes],
              ].map(([label, value]) => (
                <div>
                  <dt class={DT}>{label}</dt>
                  <dd class={value ? "mt-0.5 break-words whitespace-pre-line text-ink" : "mt-0.5 text-ink-soft"}>{value || "Vazio: não aparece no bot"}</dd>
                </div>
              ))}
            </dl>
          </section>
        ))
    }

    {
      canInvite && tab === "acesso" && access && (
        <>
          {linkEmail && (
            <section class="flex flex-col gap-3 rounded-xl border-2 border-pend-200 bg-pend-50 p-4 sm:p-5" aria-labelledby="ligar-titulo">
              <h2 id="ligar-titulo" class={SECTION_TITLE}>Ligar ao login de quem já é da Equipe?</h2>
              <p class="text-[15px] text-ink">
                <strong>{linkEmail}</strong> já entra no painel desta clínica. Ligado, este cadastro passa a usar esse login: a pessoa ganha o papel
                Profissional e vê também a agenda de {professional!.displayName}. Sem convite novo.
              </p>
              <div class="flex flex-wrap gap-2">
                <form method="POST" action={action}>
                  <input type="hidden" name="acao" value="ligar_login" />
                  <input type="hidden" name="email" value={linkEmail} />
                  <button type="submit" class={PRIMARY_BUTTON} data-sending-label="Ligando…">Ligar ao login</button>
                </form>
                <a href={pageHref("acesso")} class={SECONDARY_BUTTON}>Cancelar</a>
              </div>
            </section>
          )}
          <section class={`${CARD} flex min-w-0 flex-col gap-4 p-4 sm:p-5`} aria-labelledby="acesso-titulo">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h2 id="acesso-titulo" class={SECTION_TITLE}>Acesso ao painel</h2>
              {access.state === "none" && <span class={chip("pend")}>Sem acesso</span>}
              {access.state === "invited" && <span class="inline-flex items-center rounded-full bg-att-100 px-2.5 py-0.5 text-[13.5px] font-semibold text-att-800">Convite enviado</span>}
              {access.state === "active" && <span class={chip("ok")}>Com acesso</span>}
            </div>

            {access.state === "none" && (
              <form method="POST" action={action} class="flex flex-col gap-4">
                <input type="hidden" name="acao" value="convidar" />
                <p class="text-[15px] text-ink-soft">
                  Com o acesso, {professional!.displayName} entra no RecepClinic com e-mail e senha e vê a própria agenda e o próprio cadastro.
                </p>
                <div class="sm:max-w-md">
                  <label for="email" class={LABEL}>E-mail do profissional</label>
                  <input id="email" name="email" type="email" required autocomplete="off" placeholder="nome@email.com" aria-describedby="email-hint" class={INPUT} />
                  <p id="email-hint" class={HINT}>Ele recebe o convite para criar a senha. Se já tiver login no RecepClinic, entra direto e recebe um aviso.</p>
                </div>
                <button type="submit" class={`${PRIMARY_BUTTON} self-start`} data-sending-label="Enviando…">Enviar convite</button>
              </form>
            )}

            {access.state === "invited" && (
              <>
                <p class="text-[15.5px] text-ink">
                  Enviado para <strong class="break-all">{access.email}</strong>
                  {access.sentAt && ` em ${formatInstant(access.sentAt, clinic.timezone, "dd/MM/yyyy 'às' HH:mm")}`}.
                </p>
                <p class="-mt-2 text-[15px] text-ink-soft">Ainda não criou a senha. O link do e-mail vale 24 horas; depois, reenvie.</p>
                <div class="flex flex-wrap gap-2">
                  <form method="POST" action={action}>
                    <input type="hidden" name="acao" value="reenviar" />
                    <button type="submit" class={SECONDARY_BUTTON} data-sending-label="Reenviando…">Reenviar convite</button>
                  </form>
                  <form method="POST" action={action}>
                    <input type="hidden" name="acao" value="cancelar_convite" />
                    <button
                      type="submit"
                      class={`${DANGER_BUTTON} js-confirm-delete`}
                      data-confirm-title="Cancelar o convite?"
                      data-confirm-message={`O link enviado para ${access.email} deixa de valer. Dá para convidar de novo depois.`}
                      data-confirm-label="Cancelar o convite"
                    >
                      Cancelar o convite
                    </button>
                  </form>
                </div>
                <details class="group rounded-lg border border-line-strong">
                  <summary class="flex min-h-11 cursor-pointer list-none items-center px-3 text-[15px] font-semibold text-brand [&::-webkit-details-marker]:hidden">
                    Trocar o e-mail
                  </summary>
                  <form method="POST" action={action} class="flex flex-col gap-3 border-t border-line p-3">
                    <input type="hidden" name="acao" value="trocar_email" />
                    <div class="sm:max-w-md">
                      <label for="email" class={LABEL}>E-mail novo</label>
                      <input id="email" name="email" type="email" required autocomplete="off" class={INPUT} />
                      <p class={HINT}>O convite antigo deixa de valer e um novo sai para este e-mail.</p>
                    </div>
                    <button type="submit" class={`${PRIMARY_BUTTON} self-start`} data-sending-label="Enviando…">Enviar para o e-mail novo</button>
                  </form>
                </details>
              </>
            )}

            {access.state === "active" && (
              <>
                <dl class="grid gap-x-6 gap-y-4 text-[15.5px] sm:grid-cols-2">
                  <div>
                    <dt class={DT}>E-mail de login</dt>
                    <dd class={`${DD} break-all`}>{access.email ?? "—"}</dd>
                  </div>
                  <div>
                    <dt class={DT}>Papel na clínica</dt>
                    <dd class={DD}>{access.roles.join(" e ")}</dd>
                  </div>
                </dl>
                <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                  <a href={`/admin/configuracoes/equipe/${access.userId}`} class="inline-flex min-h-10 items-center text-[15px] font-semibold text-brand underline">
                    Mudar o que vê e faz (Equipe)
                  </a>
                  {access.onlyProfessional && (
                    <form method="POST" action={action}>
                      <input type="hidden" name="acao" value="tirar_acesso" />
                      <button
                        type="submit"
                        class={`${DANGER_BUTTON} js-confirm-delete`}
                        data-confirm-title="Tirar o acesso?"
                        data-confirm-message={`${professional!.displayName} deixa de entrar no painel desta clínica. O cadastro, a agenda e o histórico ficam. Dá para convidar de novo.`}
                        data-confirm-label="Tirar o acesso"
                      >
                        Tirar o acesso
                      </button>
                    </form>
                  )}
                </div>
                {!access.onlyProfessional && <p class={`${HINT} mt-0`}>Esta pessoa também é {access.roles.filter((r) => r !== "Profissional").join(" e ")}: o acesso muda pela Equipe.</p>}
              </>
            )}
          </section>
          <p class="text-sm text-ink-soft">O que ele vê e faz no painel (agendas e permissões) continua em Configurações › Equipe.</p>
        </>
      )
    }
  </div>
  {needsDialog && <ConfirmDeleteDialog />}
  {tab === "perfil" && portalLink?.shown && <PortalLinkTools />}
</ConfigShell>

<script>
  // Foto num botão só (cliente, 13/nov/2026): o botão abre a escolha do arquivo e a escolha já envia.
  for (const form of document.querySelectorAll<HTMLFormElement>("[data-photo-form]")) {
    const input = form.querySelector<HTMLInputElement>("[data-photo-input]")!;
    const button = form.querySelector<HTMLButtonElement>("[data-photo-button]")!;
    // O campo some (o botão o abre); sem script, ficam o campo e o botão de enviar.
    input.hidden = true;
    form.querySelector<HTMLLabelElement>("label[for='photo']")!.hidden = true;
    button.type = "button";
    button.addEventListener("click", () => input.click());
    input.addEventListener("change", () => {
      if (!input.files?.length) return;
      button.disabled = true;
      button.textContent = "Enviando…";
      form.submit();
    });
  }

  // Especialidades: as marcadas viram etiquetas (a estrela marca a principal); a busca
  // mostra só as que batem e ainda não estão marcadas. Sem script, fica a lista de sempre.
  const box = document.querySelector<HTMLElement>("[data-specialties]");
  if (box) {
    const filter = box.querySelector<HTMLInputElement>("[data-specialty-filter]")!;
    const showAll = box.querySelector<HTMLButtonElement>("[data-show-all]")!;
    const list = box.querySelector<HTMLElement>("#specialties-list")!;
    const chosenList = box.querySelector<HTMLUListElement>("[data-chosen]")!;
    const starHint = box.querySelector<HTMLElement>("[data-star-hint]")!;
    const options = [...box.querySelectorAll<HTMLLabelElement>("[data-specialty-option]")];
    const empty = box.querySelector<HTMLElement>("[data-specialty-empty]")!;
    const principal = box.querySelector<HTMLSelectElement>("#principal")!;
    const key = (text: string) => text.normalize("NFD").replace(/\p{Diacritic}/gu, "").toLowerCase().trim();
    const checkOf = (o: HTMLLabelElement) => o.querySelector<HTMLInputElement>("input")!;
    let listOpen = false;
    box.querySelector<HTMLElement>("[data-filter-row]")!.hidden = false;
    box.querySelector<HTMLElement>("[data-principal]")!.hidden = true;

    const renderList = () => {
      const q = key(filter.value);
      const open = listOpen || q !== "";
      list.hidden = !open;
      showAll.setAttribute("aria-expanded", String(open));
      showAll.textContent = listOpen ? "Fechar a lista" : "Ver a lista";
      let found = 0;
      for (const o of options) {
        const match = !checkOf(o).checked && (!q || (o.dataset.key ?? "").includes(q));
        o.hidden = !match;
        if (match) found++;
      }
      empty.hidden = found > 0;
    };

    const renderChosen = () => {
      const marked = options.filter((o) => checkOf(o).checked);
      const ids = new Set(marked.map((o) => checkOf(o).value));
      for (const option of principal.options) option.disabled = !ids.has(option.value);
      if (!ids.has(principal.value) && marked.length) principal.value = checkOf(marked[0]).value;
      chosenList.replaceChildren(
        ...marked.map((o) => {
          const value = checkOf(o).value;
          const name = o.dataset.name ?? "";
          const isMain = marked.length > 1 && principal.value === value;
          const li = document.createElement("li");
          li.className = "inline-flex min-h-10 items-center gap-1 rounded-full bg-brand-soft py-1 pr-1 pl-1 text-[15px] font-semibold text-brand-ink";
          if (marked.length > 1) {
            const star = document.createElement("button");
            star.type = "button";
            star.className = "flex h-8 w-8 items-center justify-center rounded-full hover:bg-white/60";
            star.setAttribute("aria-pressed", String(isMain));
            star.setAttribute("aria-label", isMain ? `${name} é a principal` : `Tornar ${name} a principal`);
            star.textContent = isMain ? "★" : "☆";
            star.addEventListener("click", () => {
              principal.value = value;
              renderChosen();
            });
            li.append(star);
          } else {
            li.classList.replace("pl-1", "pl-3");
          }
          const label = document.createElement("span");
          label.textContent = name;
          const remove = document.createElement("button");
          remove.type = "button";
          remove.className = "flex h-8 w-8 items-center justify-center rounded-full hover:bg-white/60";
          remove.setAttribute("aria-label", `Tirar ${name}`);
          remove.textContent = "✕";
          remove.addEventListener("click", () => {
            checkOf(o).checked = false;
            sync();
            filter.focus();
          });
          li.append(label, remove);
          return li;
        }),
      );
      chosenList.hidden = marked.length === 0;
      starHint.hidden = marked.length < 2;
    };

    const sync = () => {
      renderChosen();
      renderList();
    };
    filter.addEventListener("input", renderList);
    showAll.addEventListener("click", () => {
      listOpen = !listOpen;
      renderList();
    });
    box.addEventListener("change", (event) => {
      if (!(event.target as HTMLElement).matches("input[name='specialties']")) return;
      filter.value = "";
      sync();
      filter.focus();
    });
    // Valores devolvidos depois de um erro (keepFormValues) também contam.
    sync();
    window.addEventListener("load", sync);
  }
</script>

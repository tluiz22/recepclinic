---
// Configurações › Nota fiscal (N2b; planejamento-nfse-asaas.md, seção 14.7):
// os emissores da clínica. O da clínica (CNPJ da clínica) e, por profissional,
// como ele emite: pelo próprio CNPJ (emissor dele, com subconta no Asaas),
// pelo emissor da clínica ou não emite pelo sistema (N-P1, o Administrador
// escolhe). Lista pensada para clínica grande: busca, especialidade e forma
// de emitir. O profissional com login vai direto para o emissor dele.
import ConfigShell from "../../../components/admin/config/ConfigShell.astro";
import HowItWorks from "../../../components/admin/ui/HowItWorks.astro";
import { configuracoes } from "../../../lib/ajuda/configuracoes";
import Badge from "../../../components/admin/config/Badge.astro";
import Card from "../../../components/admin/config/Panel.astro";
import Icon from "../../../components/admin/Icon.astro";
import { HEAD_ROW, INPUT, INPUT_INLINE, LABEL, LIST, PRIMARY_BUTTON, ROW_NAME, SECONDARY_BUTTON } from "../../../components/admin/config/formStyles";
import { ownSettingsOnly } from "../../../lib/clinicAccess";
import { formatCnpj } from "../../../lib/cnpj";
import { createUserClient } from "../../../lib/data/clients";
import { listProfessionals } from "../../../lib/data/config/professionals";
import { getFiscalIssuerOverview, issuerMissing, issuerState, MISSING_LABEL, type FiscalIssuer } from "../../../lib/data/fiscalIssuers";
import { ASAAS_PROVIDER_NOTICE, ASAAS_SEAL, ASAAS_SITE, ASAAS_SUPPORT } from "../../../lib/asaas/brand";
import { receivedReturn, returnLabel, withReturn } from "../../../lib/returnPath";

const clinic = Astro.locals.clinic!;
if (ownSettingsOnly(clinic)) return Astro.redirect(`/admin/configuracoes/nota-fiscal/emissor?profissional=${clinic.ownProfessionalId}`);
const db = createUserClient(Astro.request, Astro.cookies);
const [overview, professionalList] = await Promise.all([getFiscalIssuerOverview(db, clinic.clinicId), listProfessionals(db, clinic.clinicId)]);
// Especialidades da frente multiprofissional (um profissional pode ter várias).
const specialtiesOf = new Map(professionalList.map((p) => [p.id, p.specialties.map((s) => s.name)]));
const volta = receivedReturn(Astro.url);
const action = withReturn("/api/admin/configuracoes/nota-fiscal", volta);
const issuerHref = (professionalId: string | null) => withReturn(`/admin/configuracoes/nota-fiscal/emissor${professionalId ? `?profissional=${professionalId}` : ""}`, volta);
const TONE = { ok: "success", wait: "info", todo: "warning", stop: "danger" } as const;
const badge = (i: FiscalIssuer) => {
  const s = issuerState(i);
  return { variant: TONE[s.tone], label: s.label };
};
const clinicIssuer = overview.clinicIssuer;
const pros = overview.professionals.filter((p) => p.isActive);
const specsOf = (id: string, profession: string) => (specialtiesOf.get(id)?.length ? specialtiesOf.get(id)! : [profession]);
const specialties = [...new Set(pros.flatMap((p) => specsOf(p.professionalId, p.profession)))].sort((a, b) => a.localeCompare(b, "pt-BR"));
const counts = { own: pros.filter((p) => p.route === "own").length, clinic: pros.filter((p) => p.route === "clinic").length, none: pros.filter((p) => p.route === "none").length };
const ROUTE_LABEL = { own: "CNPJ próprio", clinic: "Pelo emissor da clínica", none: "Não emite pelo sistema" } as const;
const missing = clinicIssuer ? issuerMissing(clinicIssuer) : [];
const cols = "lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)_minmax(0,1.3fr)]";
---

<ConfigShell current="nota_fiscal" title="Nota fiscal" subtitle="Quem emite a nota de cada atendimento: a clínica ou o próprio profissional." back={volta ? { href: volta, label: returnLabel(volta) } : undefined}>
  <HowItWorks id="nota-fiscal" topic={configuracoes.comoFunciona.notaFiscal} class="mb-4">
    <p class="text-[15px] text-ink-soft">O que a clínica precisa para emitir a nota.</p>
  </HowItWorks>

  <div class="grid items-start gap-4 lg:grid-cols-[minmax(0,1fr)_320px]">
    <Card>
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0">
          <h2 class="flex flex-wrap items-center gap-2 font-display text-[17px] leading-tight font-bold text-ink sm:text-lg">
            Emissor da clínica
            {clinicIssuer ? <Badge variant={badge(clinicIssuer).variant}>{badge(clinicIssuer).label}</Badge> : <Badge>não cadastrado</Badge>}
          </h2>
          {
            clinicIssuer ? (
              <p class="mt-1 text-[15px] text-ink">
                {clinicIssuer.legalName} <span class="whitespace-nowrap text-ink-soft">CNPJ {formatCnpj(clinicIssuer.cnpj)}</span>
              </p>
            ) : (
              <p class="mt-1 text-[15px] text-ink-soft">O CNPJ da clínica. Emite as notas dos atendimentos sem profissional (exames) e dos profissionais que emitem pela clínica.</p>
            )
          }
        </div>
        <a href={issuerHref(null)} class={PRIMARY_BUTTON}>{clinicIssuer ? "Abrir emissor" : "Cadastrar emissor"}</a>
      </div>
      {
        clinicIssuer && missing.length > 0 && !clinicIssuer.issuingEnabled && (
          <div class="mt-3 rounded-lg bg-canvas px-3 py-2.5">
            <p class="text-sm font-semibold text-ink">Falta para emitir</p>
            <ul class="mt-1 flex flex-col gap-0.5 text-sm text-ink-mid">
              {missing.map((m) => (
                <li class="flex items-center gap-1.5">
                  <Icon name="clock" class="h-3.5 w-3.5 text-ink-soft" />
                  {MISSING_LABEL[m]}
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </Card>

    {/* Selo do Asaas (BaaS, playbook): em toda tela de habilitação fiscal, com link e sem no-referrer (13.8 e 13.10). */}
    <Card class="flex flex-col">
      <h2 class="font-display text-[17px] leading-tight font-bold text-ink">Emissão pelo Asaas</h2>
      <p class="mt-1 text-sm text-ink-mid">{ASAAS_PROVIDER_NOTICE}</p>
      <a href={ASAAS_SITE} target="_blank" rel="noopener noreferrer" class="mt-3 inline-block self-start">
        <img src={ASAAS_SEAL.positive} alt="Selo Serviços financeiros Asaas" width="160" height="48" style="display: inline-block;" />
      </a>
      <p class="mt-2 text-sm text-ink-soft">Suporte do Asaas: {ASAAS_SUPPORT.phone}, {ASAAS_SUPPORT.email}</p>
    </Card>
  </div>

  <section aria-labelledby="pros-titulo" class="mt-6">
    <div class="flex flex-wrap items-end justify-between gap-2">
      <div>
        <h2 id="pros-titulo" class="font-display text-[19px] font-bold text-ink">Profissionais</h2>
        <p class="text-[15px] text-ink-soft">Quem tem CNPJ próprio emite pelo próprio emissor. Sem CNPJ: pela clínica ou não emite pelo sistema.</p>
      </div>
    </div>

    {
      pros.length === 0 ? (
        <p class="mt-3 rounded-xl border border-line bg-white px-4 py-5 text-[15px] text-ink-soft">Nenhum profissional ativo.</p>
      ) : (
        <>
          <div class="mt-3 grid gap-3 rounded-xl border border-line bg-white p-3 sm:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)_minmax(0,1fr)] sm:p-4" data-filtros>
            <div>
              <label for="busca" class={LABEL}>Buscar</label>
              <input id="busca" type="search" placeholder="Nome do profissional" autocomplete="off" class={INPUT} data-busca />
            </div>
            <div>
              <label for="especialidade" class={LABEL}>Especialidade</label>
              <select id="especialidade" class={INPUT} data-especialidade>
                <option value="">Todas</option>
                {specialties.map((s) => <option value={s}>{s}</option>)}
              </select>
            </div>
            <div>
              <label for="forma" class={LABEL}>Como emite</label>
              <select id="forma" class={INPUT} data-forma>
                <option value="">Todas ({pros.length})</option>
                <option value="own">CNPJ próprio ({counts.own})</option>
                <option value="clinic">Pela clínica ({counts.clinic})</option>
                <option value="none">Não emite ({counts.none})</option>
              </select>
            </div>
          </div>
          <p class="mt-3 text-sm text-ink-soft" role="status" data-contagem>
            {pros.length} {pros.length === 1 ? "profissional" : "profissionais"}
          </p>
          <section aria-label="Profissionais e como emitem" class={`mt-2 ${LIST}`}>
            <div aria-hidden="true" class={`${HEAD_ROW} ${cols}`}>
              <span>Profissional</span>
              <span>Situação</span>
              <span>Como emite</span>
            </div>
            <ul>
              {pros.map((p) => {
                const specs = specsOf(p.professionalId, p.profession);
                const label = specs.join(", ");
                return (
                  <li
                    class={`grid grid-cols-1 items-center gap-x-4 gap-y-2 border-t border-line px-4 py-3 first:border-t-0 ${cols}`}
                    data-pro
                    data-nome={p.name.toLocaleLowerCase("pt-BR")}
                    data-esp={specs.join("|")}
                    data-rota={p.route}
                  >
                    <div class="min-w-0">
                      <a href={issuerHref(p.professionalId)} class={ROW_NAME}>
                        {p.name}
                      </a>
                      <p class="text-sm text-ink-soft">{label}</p>
                    </div>
                    <div class="flex flex-wrap items-center gap-1.5 text-sm">
                      {p.issuer ? (
                        <>
                          <Badge variant={badge(p.issuer).variant}>{badge(p.issuer).label}</Badge>
                          <span class="text-ink-soft">{p.issuer.payer === "professional" ? "paga as próprias notas" : "notas pagas pela clínica"}</span>
                        </>
                      ) : p.route === "clinic" ? (
                        <span class="text-ink-mid">Sai com o CNPJ da clínica</span>
                      ) : (
                        <span class="text-ink-soft">Emite por fora do sistema</span>
                      )}
                    </div>
                    <div>
                      {p.route === "own" ? (
                        <a href={issuerHref(p.professionalId)} class={SECONDARY_BUTTON}>
                          Abrir emissor
                        </a>
                      ) : (
                        <form method="POST" action={action} class="flex flex-wrap items-center gap-2">
                          <input type="hidden" name="acao" value="rota" />
                          <input type="hidden" name="profissional" value={p.professionalId} />
                          <label for={`modo_${p.professionalId}`} class="sr-only">
                            Como {p.name} emite
                          </label>
                          <select id={`modo_${p.professionalId}`} name="modo" class={`${INPUT_INLINE} min-w-0 flex-1`}>
                            <option value="clinic" selected={p.route === "clinic"}>
                              {ROUTE_LABEL.clinic}
                            </option>
                            <option value="none" selected={p.route === "none"}>
                              {ROUTE_LABEL.none}
                            </option>
                            <option value="own">Cadastrar CNPJ próprio</option>
                          </select>
                          <button type="submit" class={SECONDARY_BUTTON}>
                            Salvar
                          </button>
                        </form>
                      )}
                    </div>
                  </li>
                );
              })}
            </ul>
            <p class="hidden border-t border-line px-4 py-5 text-[15px] text-ink-soft" data-vazio>
              Nenhum profissional com esse filtro.
            </p>
          </section>
        </>
      )
    }
  </section>
</ConfigShell>

<script>
  // Filtro na própria página (a lista vem inteira: clínicas com dezenas de profissionais).
  const busca = document.querySelector<HTMLInputElement>("[data-busca]");
  const esp = document.querySelector<HTMLSelectElement>("[data-especialidade]");
  const forma = document.querySelector<HTMLSelectElement>("[data-forma]");
  const rows = [...document.querySelectorAll<HTMLElement>("[data-pro]")];
  const contagem = document.querySelector<HTMLElement>("[data-contagem]");
  const vazio = document.querySelector<HTMLElement>("[data-vazio]");
  const normalize = (t: string) => t.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
  const apply = () => {
    const q = normalize(busca?.value.trim() ?? "");
    let shown = 0;
    for (const row of rows) {
      const ok =
        (!q || normalize(row.dataset.nome ?? "").includes(q)) && (!esp?.value || (row.dataset.esp ?? "").split("|").includes(esp.value)) && (!forma?.value || row.dataset.rota === forma.value);
      row.hidden = !ok;
      if (ok) shown++;
    }
    if (contagem) contagem.textContent = `${shown} ${shown === 1 ? "profissional" : "profissionais"}${shown === rows.length ? "" : ` de ${rows.length}`}`;
    if (vazio) vazio.classList.toggle("hidden", shown > 0);
  };
  busca?.addEventListener("input", apply);
  esp?.addEventListener("change", apply);
  forma?.addEventListener("change", apply);
</script>

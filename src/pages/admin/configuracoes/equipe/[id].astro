---
// Configurações › Equipe › convidar ou editar (F4.4b, D6): papéis, cadastro
// de profissional ligado ao login (obrigatório para o papel Profissional,
// cliente, 05/out/2026) e acesso às agendas. O convite usa o mesmo envio da
// F4.4a; quem já tem login entra direto e recebe um aviso.
import ConfigShell from "../../../../components/admin/config/ConfigShell.astro";
import ConfirmDeleteDialog from "../../../../components/admin/ConfirmDeleteDialog.astro";
import { CARD, CHECK, DANGER_BUTTON, SECTION_TITLE, CHOICE, HINT, INPUT, LABEL, PRIMARY_BUTTON, SECONDARY_BUTTON } from "../../../../components/admin/config/formStyles";
import { formatInstant } from "../../../../lib/clinicTime";
import { createUserClient } from "../../../../lib/data/clients";
import { listAgendas } from "../../../../lib/data/config/agendas";
import { listProfessionals } from "../../../../lib/data/config/professionals";
import { listTeam, ROLE_LABELS, ROLES } from "../../../../lib/data/config/team";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const { id } = Astro.params;
const isNew = id === "novo";
const [team, professionals, agendas] = await Promise.all([
  listTeam(db, clinic.clinicId),
  listProfessionals(db, clinic.clinicId),
  listAgendas(db, clinic.clinicId),
]);
const member = isNew ? null : (team.find((m) => m.userId === id) ?? null);
if (!isNew && !member) return Astro.redirect("/admin/configuracoes/equipe");

const isSelf = member?.userId === Astro.locals.userId;
const roles = member?.roles ?? [];
// Cadastros livres (e o já ligado a esta pessoa).
const professionalOptions = professionals.filter((p) => !p.userId || p.userId === member?.userId);
const scope = member?.agendaScope ?? "all";
const pending = member?.invitation && !member.invitation.acceptedAt;
const action = `/api/admin/configuracoes/equipe/${id}`;
const roleHints: Record<string, string> = {
  admin: "tudo, inclusive Configurações e a equipe",
  professional: "agenda, pacientes e, se liberadas, as métricas da própria agenda",
  reception: "agenda, pacientes, envios e lista de espera",
};
---

<ConfigShell current="equipe" title={isNew ? "Convidar pessoa" : (member!.displayName ?? member!.email ?? "Equipe")} back={{ href: "/admin/configuracoes/equipe", label: "Equipe" }} subtitle={!isNew && member!.displayName ? (member!.email ?? undefined) : undefined}>

  {
    pending && (
      <div class="flex max-w-3xl flex-wrap items-center justify-between gap-3 rounded-xl border border-pend-200 bg-pend-50 px-4 py-3 text-pend-800">
        <p class="min-w-0 flex-1 text-[15px] leading-snug">
          <strong>Convite pendente:</strong> a pessoa ainda não criou a senha.
          {member!.invitation!.lastSentAt && ` Último envio em ${formatInstant(member!.invitation!.lastSentAt, clinic.timezone, "dd/MM/yyyy 'às' HH:mm")}.`} O
          link vale 24 horas.
        </p>
        <form method="POST" action={action}>
          <input type="hidden" name="acao" value="reenviar" />
          <button type="submit" class={SECONDARY_BUTTON} data-sending-label="Reenviando…">Reenviar convite</button>
        </form>
      </div>
    )
  }

  <div class="flex max-w-3xl flex-col gap-4">
    <form method="POST" action={action} class={`${CARD} flex flex-col gap-5 p-4 sm:p-5`}>
      <input type="hidden" name="acao" value={isNew ? "convidar" : "salvar"} />
      <h2 class={SECTION_TITLE}>Quem é</h2>
      {
        isNew && (
          <div>
            <label for="email" class={LABEL}>
              E-mail
            </label>
            <input id="email" name="email" type="email" required autocomplete="off" class={INPUT} />
            <p class={HINT}>A pessoa recebe o convite para criar a senha. Se já tiver login no RecepClinic, entra direto e recebe um aviso.</p>
          </div>
        )
      }

      <div>
        <label for="display_name" class={LABEL}>Nome</label>
        <input id="display_name" name="display_name" value={member?.displayName ?? ""} placeholder="Maria" class={INPUT} />
        <p class={HINT}>Como a pessoa aparece na trilha dos atendimentos ("Marcado por Maria"). Sem nome, aparece o e-mail.</p>
      </div>

      <h2 class={`${SECTION_TITLE} border-t border-[#e6ecea] pt-5`}>O que faz no painel</h2>
      <fieldset>
        <legend class={LABEL}>Papéis</legend>
        <div class="mt-1 flex flex-col gap-2">
          {
            ROLES.map((role) => (
              <label class={`${CHOICE} items-start`}>
                <input type="checkbox" name="role" value={role} checked={roles.includes(role)} class={`${CHECK} mt-0.5`} />
                <span>
                  <span class="font-medium">{ROLE_LABELS[role]}</span>: {roleHints[role]}
                </span>
              </label>
            ))
          }
        </div>
        {isSelf && <p class={HINT}>Você não pode tirar o seu próprio papel de Administrador.</p>}
      </fieldset>

      <div data-professional data-is-new={isNew ? "true" : "false"}>
        <label for="professional_id" class={LABEL}>Cadastro de profissional</label>
        <select id="professional_id" name="professional_id" class={INPUT}>
          <option value="">Escolha…</option>
          {
            professionalOptions.map((p) => (
              <option value={p.id} selected={p.id === member?.professionalId}>
                {p.displayName}
              </option>
            ))
          }
        </select>
        <p class={HINT}>
          Obrigatório para o papel Profissional: é o que mostra a ele a própria agenda. Não está na lista? Cadastre em{" "}
          <a href="/admin/configuracoes/profissionais" class="text-brand hover:underline">Profissionais</a>.
        </p>
      </div>

      <h2 class={`${SECTION_TITLE} border-t border-[#e6ecea] pt-5`}>Agendas que vê</h2>
      <fieldset>
        <legend class={LABEL}>Acesso às agendas</legend>
        <div class="mt-1 flex flex-col gap-2">
          <label class={CHOICE}>
            <input type="radio" name="agenda_scope" value="all" checked={scope === "all"} class={CHECK} />
            Todas as agendas
          </label>
          <label class={CHOICE}>
            <input type="radio" name="agenda_scope" value="restricted" checked={scope === "restricted"} class={CHECK} />
            Só a do profissional ligado e as marcadas abaixo
          </label>
        </div>
        <div data-agendas class="mt-2 flex flex-col gap-2 border-l-2 border-line pl-4">
          {
            agendas.map((agenda) => (
              <label class={CHOICE}>
                <input type="checkbox" name="agenda_id" value={agenda.id} checked={member?.grantedAgendaIds.includes(agenda.id)} class={CHECK} />
                {agenda.name}
              </label>
            ))
          }
        </div>
        <p class={HINT}>
          Novo convite: Administrador e Recepção começam com todas; o Profissional, só com a própria. O Administrador sempre vê todas.
        </p>
      </fieldset>

      <div class="flex flex-wrap gap-2 border-t border-[#e6ecea] pt-4">
        <button type="submit" class={PRIMARY_BUTTON} data-sending-label="Salvando…">{isNew ? "Convidar" : "Salvar"}</button>
        <a href={"/admin/configuracoes/equipe"} class={SECONDARY_BUTTON}>Cancelar</a>
      </div>
    </form>

    {
      !isNew && !isSelf && (
        <section class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-line bg-white p-4 sm:px-5" aria-labelledby="remover-titulo">
          <div class="min-w-0">
            <h2 id="remover-titulo" class="font-display text-base leading-tight font-bold text-ink">Remover da equipe</h2>
            <p class="mt-1 text-sm text-ink-soft">A pessoa perde o acesso a esta clínica. O histórico fica, e dá para convidar de novo depois.</p>
          </div>
          <form method="POST" action={action}>
            <input type="hidden" name="acao" value="remover" />
            <button
              type="submit"
              class={`${DANGER_BUTTON} js-confirm-delete`}
              data-confirm-title="Remover da equipe?"
              data-confirm-message="A pessoa perde o acesso a esta clínica. O histórico fica, e dá para convidar de novo depois."
              data-confirm-label="Remover"
            >
              Remover
            </button>
          </form>
        </section>
      )
    }
  </div>
  <ConfirmDeleteDialog />

  <script>
    // Profissional: escolhe o cadastro. Acesso restrito: escolhe as agendas.
    // Num convite novo, o acesso segue o papel (D6) até a pessoa mudar à mão.
    const form = document.querySelector<HTMLInputElement>("form input[name='role']")!.form!;
    const professional = document.querySelector<HTMLElement>("[data-professional]")!;
    const agendaList = document.querySelector<HTMLElement>("[data-agendas]")!;
    let scopeTouched = professional.dataset.isNew !== "true";
    const checkedRoles = () => [...form.querySelectorAll<HTMLInputElement>("input[name='role']:checked")].map((input) => input.value);
    const setScope = (value: string) => {
      const radio = form.querySelector<HTMLInputElement>(`input[name='agenda_scope'][value='${value}']`);
      if (radio) radio.checked = true;
    };
    const sync = () => {
      const roles = checkedRoles();
      professional.hidden = !roles.includes("professional");
      if (!scopeTouched) setScope(roles.includes("admin") || roles.includes("reception") || !roles.length ? "all" : "restricted");
      agendaList.hidden = form.querySelector<HTMLInputElement>("input[name='agenda_scope']:checked")?.value !== "restricted";
    };
    form.addEventListener("change", (event) => {
      if ((event.target as HTMLInputElement).name === "agenda_scope") scopeTouched = true;
      sync();
    });
    sync();
  </script>
</ConfigShell>

---
// Configurações › Agendas › nova ou editar (F4.3, D2).
import ConfigShell from "../../../../components/admin/config/ConfigShell.astro";
import { allFilterOn, withAllFilter } from "../../../../lib/returnPath";
import ActiveToggle from "../../../../components/admin/ActiveToggle.astro";
import NextStep from "../../../../components/admin/setup/NextStep.astro";
import { loadSetupStatus } from "../../../../lib/data/config/setup";
import { CARD, HINT, INPUT, INPUT_INLINE, LABEL, PRIMARY_BUTTON, SECONDARY_BUTTON } from "../../../../components/admin/config/formStyles";
import { createUserClient } from "../../../../lib/data/clients";
import { listAgendas, professionalsWithoutAgenda, TEAM_AGENDA_NAME } from "../../../../lib/data/config/agendas";
import { listProfessionals } from "../../../../lib/data/config/professionals";
import { originPage, setupOrigin, setupParam, withParams } from "../../../../lib/setupFlow";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const { id } = Astro.params;
const isNew = id === "novo";
const [agendas, professionals] = await Promise.all([
  listAgendas(db, clinic.clinicId, { includeInactive: true }),
  listProfessionals(db, clinic.clinicId, { includeInactive: true }),
]);
const agenda = isNew ? null : (agendas.find((a) => a.id === id) ?? null);
if (!isNew && !agenda) return Astro.redirect("/admin/configuracoes/agendas");
// Vinda do "próximo passo" do profissional ou do local (F6.3b): já escolhido,
// com o nome dele.
// Uma agenda por profissional e no máximo uma da equipe, só com o item "Exames
// e procedimentos" (cliente, 21/out/2026; a desativada conta: reativa-se a
// antiga). Só aparecem os profissionais sem agenda; o link "Criar a agenda da
// equipe" da lista já vem nela, com o nome "Exames".
const available = isNew ? professionalsWithoutAgenda(professionals, agendas) : [];
const teamAllowed = isNew && clinic.features.includes("exams") && !agendas.some((a) => a.kind === "resource");
const onlyTeam = isNew && available.length === 0 && teamAllowed;
const nothingToCreate = isNew && available.length === 0 && !teamAllowed;
const prefill = isNew ? (available.find((p) => p.id === Astro.url.searchParams.get("profissional")) ?? null) : null;
const startTeam = onlyTeam || (teamAllowed && !prefill && Astro.url.searchParams.get("tipo") === "equipe");
const professionalName = agenda?.professionalId ? professionals.find((p) => p.id === agenda.professionalId)?.displayName : null;
// Aberto da lista em "Todos": o filtro vai e volta (teste da R9, NAV-06).
const all = allFilterOn(Astro.url);
const list = withAllFilter("/admin/configuracoes/agendas", all);
// Aberto pelo próximo passo do serviço, do local ou do profissional (jornada
// revista, cliente 21/out/2026): "Voltar" leva para lá; a origem vai junto no salvar.
const origin = setupOrigin(Astro.url, ["servico", "local", "profissional"]);
const back = origin ? { href: originPage(origin), label: "Voltar" } : { href: list, label: "Agendas" };
const flow = { servico: setupParam(Astro.url, "servico"), local: setupParam(Astro.url, "local"), profissional: setupParam(Astro.url, "profissional") };
const action = withParams(withAllFilter(`/api/admin/configuracoes/agendas/${id}`, all), flow);
// Próximo passo da jornada de configuração (F6.3b).
const setup = isNew ? null : await loadSetupStatus(createUserClient(Astro.request, Astro.cookies), clinic.clinicId, clinic.features);
const agendaIssues = setup?.issues.agendas.get(id!) ?? [];
---

<ConfigShell current="agendas" title={isNew ? "Nova agenda" : agenda!.name} back={back}>
  {
    agendaIssues.includes("no_service") ? (
      setup!.hasLocations ? (
        <NextStep
          text="Nenhum serviço usa esta agenda ainda. Cadastre um serviço ou, em Serviços, marque esta agenda nos que ela atende."
          href={withParams(`/admin/configuracoes/servicos/novo?agenda=${id}`, { marcar_local: flow.local })}
          label="Cadastrar um serviço"
        />
      ) : (
        // Jornada revista (cliente, 21/out/2026): Local antes dos Serviços.
        <NextStep text="Nenhum serviço usa esta agenda ainda. Antes dos serviços, cadastre onde a clínica atende." href={`/admin/configuracoes/locais/novo?agenda=${id}`} label="Cadastrar o local" />
      )
    ) : (
      agendaIssues.includes("no_hours") && (
        <NextStep text="Esta agenda ainda não tem horário de atendimento." href={`/admin/configuracoes/horarios?agenda=${id}`} label="Cadastrar os horários" />
      )
    )
  }

  <div class="flex max-w-3xl flex-col gap-4">
    {
      nothingToCreate && (
        <p class={`${CARD} p-4 text-[15px] text-ink sm:p-5`}>
          Não há agenda para criar: cada profissional ativo já tem a sua
          {clinic.features.includes("exams") ? " e a clínica já tem a agenda da equipe." : "."} Para um profissional novo, cadastre-o antes em Profissionais.
        </p>
      )
    }
    <form method="POST" action={action} class={`${CARD} flex flex-col gap-5 p-4 sm:p-5`} hidden={nothingToCreate}>
      <input type="hidden" name="acao" value="salvar" />
      <div>
        <label for="name" class={LABEL}>Nome</label>
        <input id="name" name="name" required placeholder="Dra. Ana, Exames…" value={agenda?.name ?? prefill?.displayName ?? (startTeam ? TEAM_AGENDA_NAME : "")} class={INPUT} />
      </div>
      {
        isNew ? (
          <>
            <div>
              <label for="kind" class={LABEL}>
                De quem é
              </label>
              <select id="kind" name="kind" class={INPUT}>
                {available.length > 0 && <option value="professional">De um profissional</option>}
                {teamAllowed && (
                  <option value="resource" selected={startTeam}>
                    Da equipe (exames)
                  </option>
                )}
              </select>
              <p class="mt-2 rounded-lg bg-canvas px-3 py-2.5 text-sm text-ink" data-team-note>
                Esta agenda será usada para os <strong>exames que não são realizados por um dos profissionais cadastrados</strong>. A
                clínica só pode ter uma agenda da equipe, e ela só atende serviços do tipo exame.
              </p>
            </div>
            <div data-professional>
              <label for="professional_id" class={LABEL}>
                Profissional
              </label>
              <select id="professional_id" name="professional_id" class={INPUT}>
                <option value="">Escolha…</option>
                {available.map((p) => (
                    <option value={p.id} selected={prefill?.id === p.id}>
                      {p.displayName}
                    </option>
                ))}
              </select>
              <p class={HINT}>Só aparecem os profissionais sem agenda. O tipo e o profissional não mudam depois de criada.</p>
            </div>
          </>
        ) : (
          <p class="text-sm text-ink-mid">
            {agenda!.kind === "professional" ? `Agenda de ${professionalName ?? "profissional"}` : "Agenda da equipe: exames que não são realizados por um dos profissionais cadastrados"}
          </p>
        )
      }
      <div>
        <label for="buffer_minutes" class={LABEL}>Intervalo entre atendimentos (min)</label>
        <input id="buffer_minutes" name="buffer_minutes" type="number" min="0" required value={agenda?.bufferMinutes ?? 0} class={`${INPUT_INLINE} mt-1.5 w-28`} />
        <p class={HINT}>Tempo livre deixado depois de cada atendimento desta agenda.</p>
      </div>
      <div class="flex flex-wrap gap-2 border-t border-[#e6ecea] pt-4">
        <button type="submit" class={PRIMARY_BUTTON} data-sending-label="Salvando…">{isNew ? "Cadastrar" : "Salvar"}</button>
        <a href={back.href} class={SECONDARY_BUTTON}>Cancelar</a>
      </div>
    </form>
    {!isNew && <ActiveToggle action={action} isActive={agenda!.isActive} what="a agenda" />}
  </div>

  <script>
    // A agenda da equipe não tem profissional e já vem com o nome "Exames".
    const kind = document.getElementById("kind") as HTMLSelectElement | null;
    const professional = document.querySelector<HTMLElement>("[data-professional]");
    const note = document.querySelector<HTMLElement>("[data-team-note]");
    const name = document.getElementById("name") as HTMLInputElement | null;
    const sync = () => {
      if (!kind) return;
      const team = kind.value === "resource";
      if (professional) professional.hidden = team;
      if (note) note.hidden = !team;
      if (name && team && !name.value.trim()) name.value = "Exames";
      if (name && !team && name.value === "Exames") name.value = "";
    };
    kind?.addEventListener("change", sync);
    sync();
  </script>
</ConfigShell>

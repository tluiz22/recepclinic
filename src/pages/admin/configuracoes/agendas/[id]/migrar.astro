---
// Configurações › Agendas › Migrar para outra agenda (cliente, 02/nov/2026): passa os horários e os atendimentos
// futuros de uma agenda para outra (ex.: ao trocar a agenda de exames). O histórico fica na antiga. Prévia antes.
import ConfigShell from "../../../../../components/admin/config/ConfigShell.astro";
import Notice from "../../../../../components/admin/ui/Notice.astro";
import { CARD, PRIMARY_BUTTON, SECONDARY_BUTTON } from "../../../../../components/admin/config/formStyles";
import { createUserClient } from "../../../../../lib/data/clients";
import { listAgendas, migrateAgenda, type AgendaMigration } from "../../../../../lib/data/config/agendas";
import { DataError } from "../../../../../lib/data/errors";
import { describeDataError } from "../../../../../lib/data/formAction";
import { formatInstant } from "../../../../../lib/clinicTime";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const { id } = Astro.params;
const agendas = await listAgendas(db, clinic.clinicId, { includeInactive: true });
const from = agendas.find((a) => a.id === id);
if (!from) return Astro.redirect("/admin/configuracoes/agendas");
const targets = agendas.filter((a) => a.isActive && a.id !== from.id);
const to = targets.find((a) => a.id === Astro.url.searchParams.get("para"));
const back = { href: `/admin/configuracoes/agendas/${from.id}`, label: from.name };

// Por serviço (cliente, 02/nov/2026): a nova agenda pode não atender todos os serviços da antiga. A pessoa marca os que
// migram (já vêm marcados os que a nova atende); o resto fica na antiga.
let services: AgendaMigration["services"] = [];
let selected: string[] | undefined;
let preview: AgendaMigration | null = null;
let problem = "";
if (to) {
  try {
    services = (await migrateAgenda(db, from.id, to.id, false, [])).services;
    const asked = Astro.url.searchParams.getAll("servico");
    const chosen = Astro.url.searchParams.has("ver") ? asked : services.filter((x) => x.target_attends).map((x) => x.id);
    selected = services.length > 0 ? chosen : undefined;
    if (selected === undefined || (Astro.url.searchParams.has("ver") && selected.length > 0)) {
      preview = await migrateAgenda(db, from.id, to.id, false, selected);
    } else if (Astro.url.searchParams.has("ver")) {
      problem = "Marque pelo menos um serviço para migrar.";
    }
  } catch (error) {
    if (!(error instanceof DataError)) throw error;
    problem = describeDataError(error);
  }
}
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
---

<ConfigShell current="agendas" title={`Migrar ${from.name}`} back={back}>
  <div class="flex max-w-3xl flex-col gap-4">
    <p class="text-[15px] text-ink">
      Passa os <strong>horários de atendimento</strong> e os <strong>atendimentos de hoje em diante</strong> desta agenda para outra, dos serviços que você escolher. Cada serviço vai para o serviço de mesmo nome do novo profissional; se ele não tiver, a migração cria a cópia, com as mesmas características. O histórico
      (atendimentos que já passaram ou foram cancelados) fica nesta agenda. O paciente não recebe aviso: dia, hora e local não mudam.
    </p>

    {
      targets.length === 0 ? (
        <Notice tone="info">Não há outra agenda ativa para receber a migração.</Notice>
      ) : (
        <form method="GET" class={`${CARD} flex flex-col gap-3 p-4 sm:p-5`}>
          <label for="para" class="text-[15px] font-semibold text-ink">Migrar para qual agenda?</label>
          <select id="para" name="para" required class="min-h-11 rounded-lg border border-line-strong bg-white px-3 text-[15px] sm:max-w-sm">
            <option value="">Escolha…</option>
            {targets.map((a) => (
              <option value={a.id} selected={a.id === to?.id}>{a.name}</option>
            ))}
          </select>
          <div><button type="submit" class={SECONDARY_BUTTON}>Escolher os serviços</button></div>
        </form>
      )
    }

    {
      to && services.length > 0 && (
        <form method="GET" class={`${CARD} flex flex-col gap-3 p-4 sm:p-5`} aria-label="Serviços a migrar">
          <input type="hidden" name="para" value={to.id} />
          <input type="hidden" name="ver" value="1" />
          <fieldset class="flex flex-col gap-2">
            <legend class="text-[15px] font-semibold text-ink">Quais serviços migram?</legend>
            {services.map((x) => (
              <label class="flex min-h-11 items-start gap-2.5 text-[15px] text-ink">
                <input type="checkbox" name="servico" value={x.id} checked={selected?.includes(x.id)} disabled={!x.target_attends} class="mt-1 h-5 w-5" />
                <span>
                  <strong>{x.name}</strong>
                  <span class="block text-sm text-ink-soft">
                    {plural(x.windows, "horário", "horários")}, {plural(x.appointments, "atendimento futuro", "atendimentos futuros")}
                    {!x.target_attends
                      ? ` · ${to.name} não atende este serviço; fica em ${from.name}`
                      : x.creates_copy
                        ? ` · ${to.name} ainda não tem este serviço: a migração cria a cópia, com as mesmas características`
                        : x.target_service && x.target_service !== x.name
                          ? ` · vai para "${x.target_service}" de ${to.name}`
                          : ""}
                  </span>
                </span>
              </label>
            ))}
          </fieldset>
          <p class="text-sm text-ink-soft">O horário "de todos os serviços" só migra quando todos os serviços migram; o que fica continua em {from.name}.</p>
          <div><button type="submit" class={SECONDARY_BUTTON}>Ver o que será migrado</button></div>
        </form>
      )
    }

    {problem && <Notice tone="danger">{problem}</Notice>}

    {
      preview && to && (
        <section class={`${CARD} flex flex-col gap-3 p-4 sm:p-5`} aria-label="O que será migrado">
          <h2 class="font-display text-[19px] font-bold text-ink">De {from.name} para {to.name}</h2>
          <ul class="list-disc pl-5 text-[15px] text-ink">
            <li>{plural(preview.windows, "horário de atendimento", "horários de atendimento")}</li>
            <li>{plural(preview.appointments, "atendimento futuro", "atendimentos futuros")}</li>
            {preview.series > 0 && <li>{plural(preview.series, "série em andamento", "séries em andamento")}</li>}
          </ul>
          {preview.conflicts.length > 0 && (
            <Notice tone="warning">
              {plural(preview.conflicts.length, "atendimento cairia", "atendimentos cairiam")} sobre outro já marcado em {to.name} e {preview.conflicts.length === 1 ? "não migra" : "não migram"}; fica
              {preview.conflicts.length === 1 ? "" : "m"} em {from.name} para você resolver (remarcar ou alterar):
              <ul class="mt-1 list-disc pl-5">
                {preview.conflicts.map((c) => (
                  <li>{c.patient}, {formatInstant(new Date(c.scheduled_at), clinic.timezone, "dd/MM HH:mm")}</li>
                ))}
              </ul>
            </Notice>
          )}
          <p class="text-sm text-ink-soft">Para desfazer, migre de volta. Cada atendimento guarda a troca no Histórico.</p>
          <form method="POST" action={`/api/admin/configuracoes/agendas/${from.id}/migrar`} class="flex flex-wrap gap-2 border-t border-[#e6ecea] pt-4">
            <input type="hidden" name="para" value={to.id} />
            {selected?.map((id) => <input type="hidden" name="servico" value={id} />)}
            <button type="submit" class={PRIMARY_BUTTON} data-sending-label="Migrando…">Migrar para {to.name}</button>
            <a href={back.href} class={SECONDARY_BUTTON}>Cancelar</a>
          </form>
        </section>
      )
    }
  </div>
</ConfigShell>

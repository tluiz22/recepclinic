---
// Configurações › Envios automáticos (Fase 23 · etapa 2): horário do lembrete
// (antes na tela Envios, Fase 22 · etapa 7) e os horários do resumo do dia,
// só leitura — calculados pela Disponibilidade. Separado por quem recebe
// (pedido do cliente): o lembrete vai para o responsável do paciente; o
// resumo, para os contatos da equipe.
import AdminLayout from "../../../layouts/AdminLayout.astro";
import ConfiguracoesTabs from "../../../components/admin/ConfiguracoesTabs.astro";
import Card from "../../../components/admin/Card.astro";
import { createClient } from "../../../lib/supabase/server";
import { REMINDER_HOUR_MAX, REMINDER_HOUR_MIN, fetchReminderHour } from "../../../lib/automaticSends";
import { describeSummarySchedule, fetchFirstWindowStarts } from "../../../lib/dailySummarySchedule";

const supabase = createClient(Astro.request, Astro.cookies);

const [reminderHour, windowStarts, { data: recipients }] = await Promise.all([
  fetchReminderHour(supabase),
  fetchFirstWindowStarts(supabase),
  supabase
    .from("notification_recipients")
    .select("label, receives_consultas, receives_exames")
    .eq("is_active", true)
    .order("label"),
]);

// Horas cheias das 7h às 20h.
const reminderHourOptions = Array.from(
  { length: REMINDER_HOUR_MAX - REMINDER_HOUR_MIN + 1 },
  (_, index) => REMINDER_HOUR_MIN + index
);
const hourSaved = Astro.url.searchParams.get("horario");

function recipientNames(filter: (row: { receives_consultas: boolean; receives_exames: boolean }) => boolean): string {
  const names = (recipients ?? []).filter(filter).map((row) => row.label as string);
  return names.length > 0 ? names.join(", ") : "ninguém (cadastre em Contatos)";
}
const consultasRecipients = recipientNames((row) => row.receives_consultas);
const examesRecipients = recipientNames((row) => row.receives_exames);
---

<AdminLayout title="Configurações">
  <h1 class="text-2xl font-bold text-slate-900">Configurações</h1>
  <p class="mt-2 text-slate-600">Parâmetros usados pela agenda e pelo bot de WhatsApp.</p>

  <ConfiguracoesTabs current="envios" />

  <section class="mt-6">
    <h2 class="text-lg font-semibold text-slate-900">Para os pacientes</h2>
    <p class="mt-1 text-sm text-slate-600">Mensagem que o responsável recebe no WhatsApp.</p>

    <Card class="mt-3">
      <h3 class="font-semibold text-slate-900">Lembrete do atendimento</h3>
      <p class="mt-1 text-sm text-slate-600">
        Lembra o atendimento de amanhã e pede para o responsável confirmar a presença, remarcar ou cancelar.
      </p>
      <form method="POST" action="/api/admin/envios/reminder-hour" class="mt-3 flex flex-wrap items-end gap-3">
        <label class="flex flex-col gap-1 text-sm">
          <span class="font-medium text-slate-700">Horário de envio</span>
          <select name="reminder_hour" class="rounded-md border border-slate-300 px-3 py-2 text-sm">
            {
              reminderHourOptions.map((hour) => (
                <option value={hour} selected={hour === reminderHour}>
                  {String(hour).padStart(2, "0")}:00
                </option>
              ))
            }
          </select>
        </label>
        <button type="submit" class="rounded-md bg-sky-700 px-4 py-2 text-sm font-medium text-white hover:bg-sky-800">
          Salvar
        </button>
      </form>
      {hourSaved === "ok" && <p class="mt-2 text-sm text-emerald-700">Horário salvo.</p>}
      {hourSaved === "erro" && <p class="mt-2 text-sm text-red-700">Não foi possível salvar o horário. Tente novamente.</p>}
      <p class="mt-3 text-xs text-slate-500">
        Sai todo dia nesse horário (inclusive fim de semana e feriado) para todos os atendimentos do dia seguinte.
        Atendimento marcado depois do envio, ou para o próprio dia, não recebe o lembrete automático — use o botão
        de lembrete na Agenda, se precisar.
      </p>
    </Card>
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-semibold text-slate-900">Para a equipe</h2>
    <p class="mt-1 text-sm text-slate-600">
      Lista dos atendimentos, enviada no WhatsApp de quem está em
      <a href="/admin/configuracoes/contatos" class="text-sky-700 hover:underline">Contatos</a>.
    </p>

    <Card class="mt-3">
      <h3 class="font-semibold text-slate-900">Resumo do dia</h3>
      <dl class="mt-3 grid gap-x-4 gap-y-3 text-sm sm:grid-cols-[10rem_1fr]">
        <dt class="font-medium text-slate-700">Na véspera</dt>
        <dd class="text-slate-600">Todo dia às 18h, com os atendimentos de amanhã.</dd>

        <dt class="font-medium text-slate-700">No próprio dia</dt>
        <dd class="text-slate-600">
          1h antes do início dos atendimentos pela aba
          <a href="/admin/configuracoes" class="text-sky-700 hover:underline">Disponibilidade</a> (ou do primeiro
          atendimento, se for antes):
          <span class="mt-1 block">Consultas: {describeSummarySchedule(windowStarts.consultas)}</span>
          <span class="block">Exames: {describeSummarySchedule(windowStarts.exames)}</span>
          <span class="mt-1 block text-xs text-slate-500">
            Dia sem horário na Disponibilidade: 6h30. Se for marcado um atendimento antes do primeiro horário já
            informado, o resumo é enviado de novo.
          </span>
        </dd>

        <dt class="font-medium text-slate-700">Quem recebe</dt>
        <dd class="text-slate-600">
          <span class="block">Consultas: {consultasRecipients}</span>
          <span class="block">Exames: {examesRecipients}</span>
        </dd>
      </dl>
    </Card>
  </section>
</AdminLayout>

---
// Configurações › Convênios › novo ou editar (F4.4b, D10): nome, outros nomes
// (para a busca do bot), código ANS e quais profissionais atendem o plano
// (por padrão, todos; desmarcar vira exceção).
import ConfigShell from "../../../../components/admin/config/ConfigShell.astro";
import { allFilterOn, withAllFilter } from "../../../../lib/returnPath";
import ActiveToggle from "../../../../components/admin/ActiveToggle.astro";
import { CARD, CHECK, CHOICE, HINT, INPUT, INPUT_INLINE, LABEL, PRIMARY_BUTTON, SECONDARY_BUTTON } from "../../../../components/admin/config/formStyles";
import { createUserClient } from "../../../../lib/data/clients";
import { listInsurancePlans, listPlanExclusions } from "../../../../lib/data/config/insurance";
import { listProfessionals } from "../../../../lib/data/config/professionals";
import HelpTip from "../../../../components/admin/ui/HelpTip.astro";
import { configuracoes } from "../../../../lib/ajuda/configuracoes";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const { id } = Astro.params;
const isNew = id === "novo";
const [plans, professionals, exclusions] = await Promise.all([
  isNew ? Promise.resolve([]) : listInsurancePlans(db, clinic.clinicId, { includeInactive: true }),
  listProfessionals(db, clinic.clinicId),
  isNew ? Promise.resolve([] as string[]) : listPlanExclusions(db, clinic.clinicId, id!),
]);
const plan = isNew ? null : (plans.find((p) => p.id === id) ?? null);
if (!isNew && !plan) return Astro.redirect("/admin/configuracoes/convenios");
// Aberto da lista em "Todos": o filtro vai e volta (teste da R9, NAV-06).
const all = allFilterOn(Astro.url);
const list = withAllFilter("/admin/configuracoes/convenios", all);
const action = withAllFilter(`/api/admin/configuracoes/convenios/${id}`, all);
---

<ConfigShell current="convenios" title={isNew ? "Novo plano" : plan!.name} back={{ href: list, label: "Convênios" }}>

  <div class="flex max-w-3xl flex-col gap-4">
    <form method="POST" action={action} class={`${CARD} flex flex-col gap-5 p-4 sm:p-5`}>
      <input type="hidden" name="acao" value="salvar" />
      <div>
        <label for="name" class={LABEL}>Nome</label>
        <input id="name" name="name" required placeholder="Unimed" value={plan?.name ?? ""} class={INPUT} />
      </div>
      <div>
        <label for="alternative_names" class={LABEL}>Outros nomes</label>
        <textarea id="alternative_names" name="alternative_names" rows="3" placeholder={"Unimed Natal\nUnimed Nacional"} class={INPUT}>{plan?.alternativeNames.join("\n") ?? ""}</textarea>
        <p class={HINT}>Um por linha. Como o paciente pode escrever o plano no WhatsApp.</p>
      </div>
      <div>
        <HelpTip subject="Código ANS" text={configuracoes.dicas.convenioAns} id="ans_code">
          <label for="ans_code" class={LABEL}>Código ANS (opcional)</label>
        </HelpTip>
        <input id="ans_code" name="ans_code" value={plan?.ansCode ?? ""} class={`${INPUT_INLINE} mt-1.5 w-40`} />
      </div>
      <fieldset>
        <legend class={LABEL}>Profissionais que atendem este plano</legend>
        {
          professionals.length === 0 ? (
            <p class={HINT}>Nenhum profissional ativo.</p>
          ) : (
            <div class="mt-1 flex flex-col gap-2">
              {professionals.map((p) => (
                <label class={CHOICE}>
                  <input type="checkbox" name="accepts" value={p.id} checked={!exclusions.includes(p.id)} class={CHECK} />
                  {p.displayName}
                </label>
              ))}
            </div>
          )
        }
        <p class={HINT}>Desmarque quem não atende este plano.</p>
      </fieldset>
      <div class="flex flex-wrap gap-2 border-t border-[#e6ecea] pt-4">
        <button type="submit" class={PRIMARY_BUTTON} data-sending-label="Salvando…">{isNew ? "Cadastrar" : "Salvar"}</button>
        <a href={list} class={SECONDARY_BUTTON}>Cancelar</a>
      </div>
    </form>
    {!isNew && <ActiveToggle action={action} isActive={plan!.isActive} what="o plano" />}
  </div>
</ConfigShell>

---
// Configurações › Lembretes › contato do resumo do dia, novo ou editar
// (F4.4b; só com o item "Lembrete à equipe (resumo do dia)", D11). Exames só com o item.
import ConfigShell from "../../../../components/admin/config/ConfigShell.astro";
import ActiveToggle from "../../../../components/admin/ActiveToggle.astro";
import { CARD, CHECK, CHOICE, HINT, INPUT, LABEL, PRIMARY_BUTTON, SECONDARY_BUTTON } from "../../../../components/admin/config/formStyles";
import { createUserClient } from "../../../../lib/data/clients";
import { listNotificationRecipients } from "../../../../lib/data/config/notificationRecipients";
import { formatPhoneBR } from "../../../../lib/phone";

const clinic = Astro.locals.clinic!;
const { id } = Astro.params;
const isNew = id === "novo";
const recipient = isNew
  ? null
  : ((await listNotificationRecipients(createUserClient(Astro.request, Astro.cookies), clinic.clinicId, { includeInactive: true })).find((r) => r.id === id) ??
    null);
if (!isNew && !recipient) return Astro.redirect("/admin/configuracoes/lembretes");
const examsOn = clinic.features.includes("exams");
const action = `/api/admin/configuracoes/contatos/${id}`;
---

<ConfigShell current="lembretes" title={isNew ? "Novo contato da equipe" : recipient!.label} pageTitle={isNew ? "Novo contato" : recipient!.label} back={{ href: "/admin/configuracoes/lembretes", label: "Lembretes" }}>

  <div class="flex max-w-3xl flex-col gap-4">
    <form method="POST" action={action} class={`${CARD} flex flex-col gap-5 p-4 sm:p-5`}>
      <input type="hidden" name="acao" value="salvar" />
      <div>
        <label for="label" class={LABEL}>Nome</label>
        <input id="label" name="label" required placeholder="Recepção, Maria…" value={recipient?.label ?? ""} class={INPUT} />
      </div>
      <div>
        <label for="phone" class={LABEL}>WhatsApp</label>
        <input id="phone" name="phone" type="tel" required placeholder="(84) 99999-9999" value={recipient ? formatPhoneBR(recipient.phone) : ""} class={INPUT} />
      </div>
      <fieldset>
        <legend class={LABEL}>Recebe</legend>
        <div class="mt-1 flex flex-col gap-2">
          <label class={CHOICE}>
            <input type="checkbox" name="receives_consultations" checked={recipient?.receivesConsultations ?? true} class={CHECK} />
            Consultas e retornos (de todas as agendas)
          </label>
          {
            examsOn && (
              <label class={CHOICE}>
                <input type="checkbox" name="receives_exams" checked={recipient?.receivesExams ?? false} class={CHECK} />
                Exames e procedimentos
              </label>
            )
          }
        </div>
        <p class={HINT}>Para quem não é profissional (ex.: recepção, gerente). Cada profissional recebe os próprios pelo cadastro dele.</p>
      </fieldset>
      <div class="flex flex-wrap gap-2 border-t border-[#e6ecea] pt-4">
        <button type="submit" class={PRIMARY_BUTTON} data-sending-label="Salvando…">{isNew ? "Cadastrar" : "Salvar"}</button>
        <a href={"/admin/configuracoes/lembretes"} class={SECONDARY_BUTTON}>Cancelar</a>
      </div>
    </form>
    {!isNew && <ActiveToggle action={action} isActive={recipient!.isActive} what="o contato" />}
  </div>
</ConfigShell>

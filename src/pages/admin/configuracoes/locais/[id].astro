---
// Configurações › Locais › novo ou editar (F4.3). Domiciliar só com o item
// "Atendimento domiciliar" liberado (D11); o tipo não muda depois de criado.
import ConfigShell from "../../../../components/admin/config/ConfigShell.astro";
import { allFilterOn, withAllFilter } from "../../../../lib/returnPath";
import ActiveToggle from "../../../../components/admin/ActiveToggle.astro";
import NextStep from "../../../../components/admin/setup/NextStep.astro";
import { loadSetupStatus } from "../../../../lib/data/config/setup";
import { CARD, HINT, INPUT, LABEL, PRIMARY_BUTTON, SECONDARY_BUTTON } from "../../../../components/admin/config/formStyles";
import { createUserClient } from "../../../../lib/data/clients";
import { listLocations } from "../../../../lib/data/config/locations";
import { listAgendas } from "../../../../lib/data/config/agendas";
import { listProfessionals } from "../../../../lib/data/config/professionals";
import { originPage, setupOrigin, withParams } from "../../../../lib/setupFlow";
import HelpTip from "../../../../components/admin/ui/HelpTip.astro";
import { configuracoes } from "../../../../lib/ajuda/configuracoes";

const clinic = Astro.locals.clinic!;
const { id } = Astro.params;
const isNew = id === "novo";
const location = isNew
  ? null
  : ((await listLocations(createUserClient(Astro.request, Astro.cookies), clinic.clinicId, { includeInactive: true })).find((l) => l.id === id) ?? null);
if (!isNew && !location) return Astro.redirect("/admin/configuracoes/locais");
const homeVisitOn = clinic.features.includes("home_visit");
// Aberto da lista em "Todos": o filtro vai e volta (teste da R9, NAV-06).
const all = allFilterOn(Astro.url);
const list = withAllFilter("/admin/configuracoes/locais", all);
// Aberto pelo próximo passo do profissional, da agenda ou do serviço (jornada
// revista, cliente 21/out/2026): volta para lá e o próximo passo segue dali.
const origin = setupOrigin(Astro.url, ["profissional", "agenda", "servico"]);
const originParams = origin ? { [origin.kind]: origin.id } : {};
const back = origin ? { href: originPage(origin), label: "Voltar" } : { href: list, label: "Locais" };
const action = withParams(withAllFilter(`/api/admin/configuracoes/locais/${id}`, all), originParams);
// Próximo passo da jornada de configuração (F6.3b).
const db = createUserClient(Astro.request, Astro.cookies);
const [setup, professionals, agendas] = isNew
  ? [null, [], []]
  : await Promise.all([loadSetupStatus(db, clinic.clinicId, clinic.features), listProfessionals(db, clinic.clinicId), listAgendas(db, clinic.clinicId)]);
const locationIssues = setup?.issues.locations.get(id!) ?? [];
// Ordem da jornada: a agenda do profissional antes dos serviços.
// Quem tem a agenda desativada reativa a antiga (uma por profissional, cliente 21/out/2026): fica de fora daqui.
const withoutAgenda = (p: { id: string }) => !!setup?.issues.professionals.get(p.id)?.includes("no_agenda") && !setup?.inactiveAgendaOf.has(p.id);
const nextProfessional =
  (origin?.kind === "profissional" ? professionals.find((p) => p.id === origin.id && withoutAgenda(p)) : undefined) ??
  (locationIssues.includes("no_service") && origin?.kind !== "agenda" ? professionals.find(withoutAgenda) : undefined);
const originAgenda =
  origin?.kind === "agenda" ? agendas.find((a) => a.id === origin.id && setup?.issues.agendas.get(a.id)?.includes("no_service")) : undefined;
---

<ConfigShell current="locais" title={isNew ? "Novo local" : location!.name} back={back}>
  {locationIssues.includes("no_address") && <NextStep text="Preencha o endereço abaixo: o bot e as mensagens mostram ao paciente onde é o atendimento." />}
  {
    nextProfessional ? (
      <NextStep
        text={`Agora crie a agenda de ${nextProfessional.displayName}.`}
        href={`/admin/configuracoes/agendas/novo?profissional=${nextProfessional.id}&local=${id}`}
        label="Criar a agenda"
      />
    ) : originAgenda ? (
      <NextStep
        text={`Agora cadastre um serviço para a agenda ${originAgenda.name}.`}
        href={`/admin/configuracoes/servicos/novo?local=${id}&marcar_agenda=${originAgenda.id}`}
        label="Cadastrar um serviço"
      />
    ) : (
      locationIssues.includes("no_service") && (
        <NextStep
          text="Nenhum serviço é atendido neste local ainda. Cadastre um serviço ou, em Serviços, marque este local nos que já existem."
          href={`/admin/configuracoes/servicos/novo?local=${id}`}
          label="Cadastrar um serviço"
        />
      )
    )
  }

  <div class="flex max-w-3xl flex-col gap-4">
    <form method="POST" action={action} class={`${CARD} flex flex-col gap-5 p-4 sm:p-5`}>
      <input type="hidden" name="acao" value="salvar" />
      <div>
        <label for="name" class={LABEL}>Nome</label>
        <input id="name" name="name" required placeholder="Consultório Centro" value={location?.name ?? ""} class={INPUT} />
      </div>
      <div>
        {
          homeVisitOn ? (
            <HelpTip subject="Tipo do local" text={configuracoes.dicas.localTipo} id="type">
              <label for="type" class={LABEL}>Tipo</label>
            </HelpTip>
          ) : (
            <label for="type" class={LABEL}>Tipo</label>
          )
        }
        {
          isNew ? (
            <select id="type" name="type" class={INPUT}>
              <option value="clinic">Consultório</option>
              {homeVisitOn && <option value="home_visit">Domiciliar (a equipe vai até o paciente)</option>}
            </select>
          ) : (
            <p class="mt-1 text-sm text-ink">{location!.type === "home_visit" ? "Domiciliar" : "Consultório"}</p>
          )
        }
        {isNew && <p class={HINT}>O tipo não muda depois de criado.</p>}
      </div>
      <div data-address data-fixed-type={location?.type ?? ""}>
        <label for="address" class={LABEL}>Endereço</label>
        <input id="address" name="address" placeholder="Rua, número – bairro, cidade" value={location?.address ?? ""} class={INPUT} />
        <p class={HINT}>Vai no lembrete e na confirmação, com o link do mapa.</p>
      </div>
      <div class="flex flex-wrap gap-2 border-t border-[#e6ecea] pt-4">
        <button type="submit" class={PRIMARY_BUTTON} data-sending-label="Salvando…">{isNew ? "Cadastrar" : "Salvar"}</button>
        <a href={back.href} class={SECONDARY_BUTTON}>Cancelar</a>
      </div>
    </form>
    {!isNew && <ActiveToggle action={action} isActive={location!.isActive} what="o local" />}
  </div>

  <script>
    // Domiciliar não tem endereço fixo: o campo some.
    const select = document.getElementById("type") as HTMLSelectElement | null;
    const address = document.querySelector<HTMLElement>("[data-address]")!;
    const sync = () => {
      const type = select ? select.value : address.dataset.fixedType;
      address.hidden = type === "home_visit";
    };
    select?.addEventListener("change", sync);
    sync();
  </script>
</ConfigShell>

---
// Configurações › Clínica (F4.3, D4b): nome ("da" ou "do" nas mensagens do
// WhatsApp, F6.2), perfil (vocabulário e regras de
// idade), fuso, idade limite da consulta, cor e, com o bot liberado, as
// informações que o bot responde e os limites por contato (F9.6a). Marca das
// páginas públicas (F5.1): logo, cor e site da clínica, com "Ver como fica".
//
// Redesign R9 (cliente, 17/out/2026; U-11): o guia com o progresso e 5 blocos
// em modo leitura com "Editar" (EditCard, R6), cada um com o próprio "Salvar"
// (`bloco` na gravação). Os campos e as regras são os de antes.
import ConfigShell from "../../../components/admin/config/ConfigShell.astro";
import { CHECK, CHOICE, DD, DT, HINT, INPUT, INPUT_INLINE, KV, LABEL, LEGEND, SOFT } from "../../../components/admin/config/formStyles";
import SetupGuide from "../../../components/admin/setup/SetupGuide.astro";
import Button from "../../../components/admin/ui/Button.astro";
import EditCard from "../../../components/admin/ui/EditCard.astro";
import { createUserClient } from "../../../lib/data/clients";
import { BRAND_COLOR_OPTIONS, DEFAULT_BRAND_COLOR, LOGO_TYPES } from "../../../lib/data/config/brand";
import { getClinicSettings } from "../../../lib/data/config/clinic";
import { getReceptionHours } from "../../../lib/data/config/receptionHours";
import { loadSetupStatus } from "../../../lib/data/config/setup";
import { describeReceptionHours, WEEKDAY_NAMES } from "../../../lib/receptionHours";
import { BOT_LIMIT_RANGES, DEFAULT_BOT_LIMITS, NEW_PATIENTS_WINDOW_DAYS, NO_SHOWS_WINDOW_DAYS } from "../../../lib/data/whatsapp/botLimits";
import { MESSAGE_ARTICLES } from "../../../lib/data/whatsapp/templates";
import { DESIGNATION_NOUN_MAX, DESIGNATION_PRESETS, designationText, designationTitle, NOUN_ARTICLES } from "../../../lib/designation";
import { BRAZIL_TIME_ZONES } from "../../../lib/timeZones";
import { PROFILE_LABELS, vocabularyFor } from "../../../lib/vocabulary";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const [settings, setup] = await Promise.all([getClinicSettings(db, clinic.clinicId), loadSetupStatus(db, clinic.clinicId, clinic.features)]);
const hasBot = clinic.features.includes("whatsapp_bot");
// Horário da recepção (F8.5b): com o bot; enquanto não salvo, a sugestão das agendas.
const reception = hasBot ? await getReceptionHours(db, clinic.clinicId) : null;
// Segunda primeiro, domingo no fim.
const receptionDays = [1, 2, 3, 4, 5, 6, 0];
const designation = { noun: settings.messageNoun, article: settings.messageNounArticle };
const isPreset = DESIGNATION_PRESETS.some((d) => d.noun === designation.noun && d.article === designation.article);
const zones = BRAZIL_TIME_ZONES.some((zone) => zone.value === settings.timezone)
  ? BRAZIL_TIME_ZONES
  : [{ value: settings.timezone, label: settings.timezone }, ...BRAZIL_TIME_ZONES];
const zoneLabel = zones.find((zone) => zone.value === settings.timezone)?.label ?? settings.timezone;
const currentColor = settings.brandColor ?? DEFAULT_BRAND_COLOR;
const colorLabel = BRAND_COLOR_OPTIONS.find((option) => option.value.toLowerCase() === currentColor.toLowerCase())?.label ?? currentColor.toUpperCase();
const limitFields = [
  {
    name: "bot_max_future_appointments",
    label: "Atendimentos futuros",
    value: settings.botMaxFutureAppointments,
    ...BOT_LIMIT_RANGES.maxFutureAppointments,
    hint: `Marcados pelo bot ou pela equipe. De ${BOT_LIMIT_RANGES.maxFutureAppointments.min} a ${BOT_LIMIT_RANGES.maxFutureAppointments.max}; padrão ${DEFAULT_BOT_LIMITS.maxFutureAppointments}.`,
  },
  {
    name: "bot_max_new_patients",
    label: `Pacientes novos cadastrados pelo bot em ${NEW_PATIENTS_WINDOW_DAYS} dias`,
    value: settings.botMaxNewPatients,
    ...BOT_LIMIT_RANGES.maxNewPatients,
    hint: `Cadastros da equipe não contam. De ${BOT_LIMIT_RANGES.maxNewPatients.min} a ${BOT_LIMIT_RANGES.maxNewPatients.max}; padrão ${DEFAULT_BOT_LIMITS.maxNewPatients}.`,
  },
  {
    name: "bot_max_no_shows",
    label: `Faltas em ${NO_SHOWS_WINDOW_DAYS} dias`,
    value: settings.botMaxNoShows,
    ...BOT_LIMIT_RANGES.maxNoShows,
    hint: `0 desliga. Até ${BOT_LIMIT_RANGES.maxNoShows.max}; padrão ${DEFAULT_BOT_LIMITS.maxNoShows}.`,
  },
];
const words = vocabularyFor(settings.profile);
const action = "/api/admin/configuracoes/clinica";
const here = "/admin/configuracoes";
const field = "flex flex-col";
const actions = "flex flex-wrap gap-2 border-t border-[#e6ecea] pt-4";
import HowItWorks from "../../../components/admin/ui/HowItWorks.astro";
import { configuracoes } from "../../../lib/ajuda/configuracoes";
---

<ConfigShell current="clinica" title="Clínica" subtitle="Como a clínica se apresenta ao paciente, nas mensagens e nas páginas de agendar." setup={setup}>
  <SetupGuide status={setup} />

  <HowItWorks id="clinica" topic={configuracoes.comoFunciona.clinica}>
    <p class="text-[15px] text-ink-soft">O que cada bloco muda e a ordem da jornada de configuração.</p>
  </HowItWorks>

  <EditCard id="identificacao" title="Identificação" summary={settings.name}>
    <dl class={KV}>
      <dt class={DT}>Nome da clínica</dt>
      <dd class={DD}>{settings.name}</dd>
      <dt class={DT}>Começo das mensagens</dt>
      <dd class={DD}>"Aqui é {settings.messageArticle} {settings.name}"</dd>
      <dt class={DT}>Sem o nome, é chamada de</dt>
      <dd class={DD}>
        "{designationText(designation)}" <span class={SOFT}>(ex.: "{designationTitle(designation)} responderá sua mensagem em breve.")</span>
      </dd>
    </dl>
    <form slot="edit" method="POST" action={action} class="flex flex-col gap-5">
      <input type="hidden" name="bloco" value="identificacao" />
      <div class={field}>
        <label for="name" class={LABEL}>Nome da clínica</label>
        <input id="name" name="name" required value={settings.name} class={INPUT} />
      </div>

      <fieldset class="min-w-0">
        <legend class={LEGEND}>Nas mensagens do WhatsApp</legend>
        <div class="mt-1.5 flex flex-wrap gap-x-5 gap-y-1">
          {MESSAGE_ARTICLES.map((article) => (
            <label class={CHOICE}>
              <input type="radio" name="message_article" value={article} checked={settings.messageArticle === article} class={CHECK} />
              "Aqui é {article} {settings.name}"
            </label>
          ))}
        </div>
        <p class={HINT}>Como a clínica se apresenta no começo das mensagens ao paciente.</p>
      </fieldset>

      <fieldset class="min-w-0">
        <legend class={LEGEND}>Como a clínica é chamada nas mensagens</legend>
        <div class="mt-1.5 flex flex-col gap-1">
          {DESIGNATION_PRESETS.map((d) => (
            <label class={CHOICE}>
              <input type="radio" name="designation" value={d.noun} checked={isPreset && designation.noun === d.noun} class={CHECK} />
              "{designationText(d)}"
            </label>
          ))}
          <div class="flex flex-wrap items-center gap-2">
            <label class={CHOICE}>
              <input type="radio" name="designation" value="outro" checked={!isPreset} class={CHECK} />
              Outro:
            </label>
            <select name="designation_article" aria-label="Artigo" class={`${INPUT_INLINE} w-20`}>
              {NOUN_ARTICLES.map((article) => <option value={article} selected={!isPreset && designation.article === article}>{article}</option>)}
            </select>
            <input
              name="designation_noun"
              aria-label="Como a clínica é chamada"
              maxlength={DESIGNATION_NOUN_MAX}
              value={isPreset ? "" : designation.noun}
              placeholder="ex.: espaço"
              class={`${INPUT_INLINE} w-48`}
            />
          </div>
        </div>
        <p class={HINT}>Nos textos que falam da clínica sem o nome, como "{designationTitle(designation)} responderá sua mensagem em breve."</p>
      </fieldset>
      <div class={actions}>
        <Button type="submit" variant="primary" data-sending-label="Salvando…">Salvar identificação</Button>
        <Button href={here} data-edit-cancel>Cancelar</Button>
      </div>
    </form>
  </EditCard>

  <EditCard id="atendimento" title="Atendimento" summary={zoneLabel}>
    <dl class={KV}>
      <dt class={DT}>Fuso horário</dt>
      <dd class={DD}>{zoneLabel}</dd>
      <dt class={DT}>Palavras das telas</dt>
      <dd class={DD}>
        "{words.patient}" e "{words.contact}" <span class={SOFT}>(pelo perfil dos profissionais: {PROFILE_LABELS[settings.profile]})</span>
      </dd>
    </dl>
    <p class={`${HINT} mt-3`}>
      Perfil, prazo para oferecer horários e idade limite da consulta são de cada profissional: no cartão Atendimento do cadastro em{" "}
      <a href="/admin/configuracoes/profissionais" class="font-semibold text-brand hover:underline">Profissionais</a>.
    </p>
    <form slot="edit" method="POST" action={action} class="flex flex-col gap-5">
      <input type="hidden" name="bloco" value="atendimento" />
      <div class={field}>
        <label for="timezone" class={LABEL}>Fuso horário</label>
        <select id="timezone" name="timezone" class={INPUT}>
          {zones.map((zone) => <option value={zone.value} selected={zone.value === settings.timezone}>{zone.label}</option>)}
        </select>
        <p class={HINT}>Horários da agenda, lembretes e resumos seguem este fuso.</p>
      </div>
      <div class={actions}>
        <Button type="submit" variant="primary" data-sending-label="Salvando…">Salvar atendimento</Button>
        <Button href={here} data-edit-cancel>Cancelar</Button>
      </div>
    </form>
  </EditCard>

  <EditCard id="paginas" title="Páginas públicas" summary={settings.logoUrl ? "Com logo" : "Sem logo"}>
    <p class="text-sm text-ink-soft">
      Topo das páginas de agendamento e de preparo que o paciente abre pelo link.{" "}
      <a href="/admin/configuracoes/previa" target="_blank" class="font-bold text-brand no-underline hover:underline">Ver como fica ›</a>
    </p>
    <dl class={KV}>
      <dt class={DT}>Logo</dt>
      <dd class={DD}>
        {
          settings.logoUrl ? (
            <img src={settings.logoUrl} alt="Logo atual" class="h-14 w-14 rounded-lg border border-line bg-white object-contain p-1" />
          ) : (
            <span class={SOFT}>Sem logo: aparece só o nome da clínica</span>
          )
        }
      </dd>
      <dt class={DT}>Cor da clínica</dt>
      <dd class={`${DD} flex items-center gap-2`}>
        <span aria-hidden="true" class="h-5 w-5 shrink-0 rounded-full border border-line" style={`background-color: ${currentColor};`}></span>
        {colorLabel}
      </dd>
      <dt class={DT}>Site da clínica</dt>
      <dd class={DD}>{settings.websiteUrl ?? <span class={SOFT}>Sem site</span>}</dd>
    </dl>
    {/* min-w-0: sem ele, o campo de arquivo estica a tela no celular (F-04). */}
    <form slot="edit" method="POST" action={action} enctype="multipart/form-data" class="flex min-w-0 flex-col gap-5">
      <input type="hidden" name="bloco" value="paginas" />
      <p class="text-sm text-ink-soft">
        Topo das páginas de agendamento e de preparo que o paciente abre pelo link.{" "}
        <a href="/admin/configuracoes/previa" target="_blank" class="font-bold text-brand no-underline hover:underline">Ver como fica ›</a>
      </p>
      <div class="min-w-0">
        <span class={LABEL}>Logo</span>
        <div class="mt-1.5 flex items-center gap-4">
          {
            settings.logoUrl ? (
              <img src={settings.logoUrl} alt="Logo atual" class="h-16 w-16 shrink-0 rounded-lg border border-line bg-white object-contain p-1" />
            ) : (
              <span class="flex h-16 w-16 shrink-0 items-center justify-center rounded-lg border border-dashed border-line-strong text-xs text-ink-soft">Sem logo</span>
            )
          }
          <div class="flex min-w-0 flex-1 flex-col gap-2">
            <input
              type="file"
              id="logo"
              name="logo"
              accept={Object.keys(LOGO_TYPES).join(",")}
              aria-label={settings.logoUrl ? "Trocar o logo" : "Enviar o logo"}
              class="w-full min-w-0 text-[15px] text-ink file:mr-3 file:h-10 file:rounded-lg file:border file:border-line-strong file:bg-white file:px-3 file:text-[15px] file:font-semibold file:text-ink"
            />
            {
              settings.logoUrl && (
                <label class={CHOICE}>
                  <input type="checkbox" name="remove_logo" class={CHECK} />
                  Remover o logo
                </label>
              )
            }
          </div>
        </div>
        <p class={HINT}>PNG, JPG ou WebP, até 1 MB. De preferência quadrado. Sem logo, aparece só o nome da clínica.</p>
      </div>

      <div>
        <label for="brand_color" class={LABEL}>Cor da clínica</label>
        <div class="mt-1.5 flex flex-wrap items-center gap-2" data-brand-swatches>
          {
            BRAND_COLOR_OPTIONS.map((option) => (
              <button
                type="button"
                data-color={option.value}
                title={option.label}
                aria-label={option.label}
                aria-pressed={option.value === currentColor ? "true" : "false"}
                class="h-9 w-9 rounded-full border-2 border-white shadow ring-1 ring-line-strong aria-pressed:ring-2 aria-pressed:ring-ink"
                style={`background-color: ${option.value};`}
              />
            ))
          }
          <label class="ml-1 flex items-center gap-2 text-[15px] text-ink-soft">
            Outra:
            <input type="color" id="brand_color" name="brand_color" value={currentColor} class="h-9 w-14 rounded border border-line-strong" />
          </label>
        </div>
        <p class={HINT}>Fundo do topo, com o nome e o logo. Escolha uma das cores ou outra em "Outra".</p>
      </div>

      <div class={field}>
        <label for="website_url" class={LABEL}>Site da clínica <span class={SOFT}>(opcional)</span></label>
        <input id="website_url" name="website_url" inputmode="url" placeholder="www.suaclinica.com.br" value={settings.websiteUrl ?? ""} class={`${INPUT} sm:max-w-md`} />
        <p class={HINT}>Com site, as páginas mostram o botão "Voltar para o site".</p>
      </div>
      <div class={actions}>
        <Button type="submit" variant="primary" data-sending-label="Salvando…">Salvar páginas públicas</Button>
        <Button href={here} data-edit-cancel>Cancelar</Button>
      </div>
    </form>
  </EditCard>

  {
    hasBot && (
      // MI (cliente, 07/nov/2026, M5): as informações passaram a ser de cada profissional.
      <section id="bot-info" class="rounded-xl border border-line bg-white p-4 sm:px-5 sm:py-[18px]" aria-labelledby="bot-info-titulo">
        <h2 id="bot-info-titulo" class="font-display text-[17px] leading-tight font-bold text-ink sm:text-lg">Informações que o bot responde</h2>
        <p class="mt-1.5 text-[15px] text-ink-soft">
          Formas de pagamento, convênios e observações agora são de cada profissional: abra o cadastro dele em{" "}
          <a href="/admin/configuracoes/profissionais" class="font-semibold text-brand hover:underline">Profissionais</a>.
        </p>
      </section>
    )
  }

  {
    reception && (
      <EditCard
        id="recepcao"
        title="Horário da recepção"
        summary={reception.saved ? describeReceptionHours(reception.hours) : "Sugerido pelas agendas"}
      >
        <p class="text-sm text-ink-soft">
          Quando a clínica atende pelo WhatsApp. Fora dele, as conversas que precisam da clínica entram em <strong>Atendimento</strong> sem notificação, e o
          paciente fica sabendo quando a clínica responde. Feriados (nacionais e da clínica) contam como fechado.
        </p>
        {!reception.saved && (
          <p class="rounded-lg border border-pend-200 bg-pend-50 px-3.5 py-2.5 text-sm text-pend-800">
            Ainda não salvo: o horário abaixo foi sugerido pelos horários das agendas (o primeiro e o último de cada dia). Confira e salve.
          </p>
        )}
        <dl class={KV}>
          {receptionDays.map((day) => (
            <>
              <dt class={DT}>{WEEKDAY_NAMES[day]}</dt>
              <dd class={DD}>{reception.hours[day] ? `${reception.hours[day]!.open} às ${reception.hours[day]!.close}` : <span class={SOFT}>Fechada</span>}</dd>
            </>
          ))}
        </dl>
        <form slot="edit" method="POST" action={action} class="flex flex-col gap-4">
          <input type="hidden" name="bloco" value="recepcao" />
          <p class="text-sm text-ink-soft">Marque os dias em que a recepção atende e o horário de cada um.</p>
          <fieldset class="min-w-0">
            <legend class="sr-only">Dias e horários da recepção</legend>
            <div class="flex flex-col divide-y divide-[#e6ecea]">
              {receptionDays.map((day) => {
                const hours = reception.hours[day];
                return (
                  <div class="flex flex-wrap items-center gap-x-4 gap-y-2 py-2.5">
                    <label class={`${CHOICE} w-32`}>
                      <input type="checkbox" name={`aberta_${day}`} checked={!!hours} class={CHECK} data-reception-day={day} />
                      {WEEKDAY_NAMES[day]}
                    </label>
                    <span class="flex flex-wrap items-center gap-2" data-reception-times={day}>
                      <label for={`abre_${day}`} class="sr-only">{`${WEEKDAY_NAMES[day]}: abre às`}</label>
                      <input id={`abre_${day}`} name={`abre_${day}`} type="time" value={hours?.open ?? "08:00"} class={`${INPUT_INLINE} w-32`} />
                      <span class="text-sm text-ink-soft">às</span>
                      <label for={`fecha_${day}`} class="sr-only">{`${WEEKDAY_NAMES[day]}: fecha às`}</label>
                      <input id={`fecha_${day}`} name={`fecha_${day}`} type="time" value={hours?.close ?? "18:00"} class={`${INPUT_INLINE} w-32`} />
                    </span>
                  </div>
                );
              })}
            </div>
          </fieldset>
          <div class={actions}>
            <Button type="submit" variant="primary" data-sending-label="Salvando…">Salvar horário</Button>
            <Button href={here} data-edit-cancel>Cancelar</Button>
          </div>
        </form>
      </EditCard>
    )
  }

  {
    hasBot && (
      <EditCard
        id="bot-limites"
        title="Limites do bot por contato"
        summary={`${settings.botMaxFutureAppointments} · ${settings.botMaxNewPatients} · ${settings.botMaxNoShows}`}
      >
        <HowItWorks id="limites-bot" topic={configuracoes.comoFunciona.limitesBot}>
          <p class="text-sm text-ink-soft">Contra abuso no agendamento pelo WhatsApp. A equipe marca sem limite pelo painel.</p>
        </HowItWorks>
        <dl class={KV}>
          {limitFields.map((limit) => (
            <>
              <dt class={DT}>{limit.label}</dt>
              <dd class={DD}>{limit.name === "bot_max_no_shows" && limit.value === 0 ? <span class={SOFT}>Desligado</span> : limit.value}</dd>
            </>
          ))}
        </dl>
        <form slot="edit" method="POST" action={action} class="flex flex-col gap-5">
          <input type="hidden" name="bloco" value="bot_limites" />
          {limitFields.map((limit) => (
            <div class={field}>
              <label for={limit.name} class={LABEL}>
                {limit.label}
              </label>
              <input id={limit.name} name={limit.name} type="number" required min={limit.min} max={limit.max} value={limit.value} class={`${INPUT_INLINE} mt-1.5 w-24`} />
              <p class={HINT}>{limit.hint}</p>
            </div>
          ))}
          <div class={actions}>
            <Button type="submit" variant="primary" data-sending-label="Salvando…">Salvar limites</Button>
            <Button href={here} data-edit-cancel>Cancelar</Button>
          </div>
        </form>
      </EditCard>
    )
  }
</ConfigShell>

<script>
  // Horário da recepção: dia desmarcado esconde (e desliga) os horários dele.
  document.querySelectorAll<HTMLInputElement>("[data-reception-day]").forEach((box) => {
    const times = document.querySelector<HTMLElement>(`[data-reception-times="${box.dataset.receptionDay}"]`)!;
    const sync = () => {
      times.hidden = !box.checked;
      times.querySelectorAll("input").forEach((input) => (input.disabled = !box.checked));
    };
    box.addEventListener("change", sync);
    box.form?.addEventListener("reset", () => setTimeout(sync));
    sync();
  });

  // Cores prontas: clicar marca a bolinha e passa a cor para o campo "Outra",
  // que é o que vai no formulário; escolher em "Outra" desmarca as bolinhas.
  document.querySelectorAll<HTMLElement>("[data-brand-swatches]").forEach((group) => {
    const input = group.querySelector<HTMLInputElement>("input[type=color]")!;
    const swatches = [...group.querySelectorAll<HTMLButtonElement>("button[data-color]")];
    const mark = () =>
      swatches.forEach((swatch) =>
        swatch.setAttribute("aria-pressed", String(swatch.dataset.color!.toLowerCase() === input.value.toLowerCase())),
      );
    swatches.forEach((swatch) =>
      swatch.addEventListener("click", () => {
        input.value = swatch.dataset.color!;
        mark();
      }),
    );
    input.addEventListener("input", mark);
    // "Cancelar" do bloco desfaz o formulário: as bolinhas acompanham.
    input.addEventListener("change", mark);
  });
</script>

---
// Configurações › Clínica (F4.3, D4b): nome ("da" ou "do" nas mensagens do
// WhatsApp, F6.2), perfil (vocabulário e regras de
// idade), fuso, idade limite da consulta, cor e, com o bot liberado, as
// informações que o bot responde. Marca das páginas públicas (F5.1): logo,
// cor e site da clínica, com "Ver como fica".
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Card from "../../../components/admin/Card.astro";
import ConfiguracoesTabs from "../../../components/admin/ConfiguracoesTabs.astro";
import FlashMessage from "../../../components/admin/FlashMessage.astro";
import { HINT, INPUT, LABEL, PRIMARY_BUTTON } from "../../../components/admin/fieldStyles";
import { createUserClient } from "../../../lib/data/clients";
import { BRAND_COLOR_OPTIONS, DEFAULT_BRAND_COLOR, LOGO_TYPES } from "../../../lib/data/config/brand";
import { CLINIC_PROFILES, getClinicSettings } from "../../../lib/data/config/clinic";
import { MESSAGE_ARTICLES } from "../../../lib/data/whatsapp/templates";
import { BRAZIL_TIME_ZONES } from "../../../lib/timeZones";
import { PROFILE_LABELS, vocabularyFor } from "../../../lib/vocabulary";

const clinic = Astro.locals.clinic!;
const settings = await getClinicSettings(createUserClient(Astro.request, Astro.cookies), clinic.clinicId);
const hasBot = clinic.features.includes("whatsapp_bot");
const zones = BRAZIL_TIME_ZONES.some((zone) => zone.value === settings.timezone)
  ? BRAZIL_TIME_ZONES
  : [{ value: settings.timezone, label: settings.timezone }, ...BRAZIL_TIME_ZONES];
const currentColor = settings.brandColor ?? DEFAULT_BRAND_COLOR;
const profileHint = (profile: (typeof CLINIC_PROFILES)[number]) => {
  const words = vocabularyFor(profile);
  return `${PROFILE_LABELS[profile]}: "${words.patient}" e "${words.contact}"`;
};
---

<AdminLayout title="Configurações">
  <h1 class="text-2xl font-bold text-slate-900">Configurações</h1>
  <ConfiguracoesTabs current="clinica" />
  <FlashMessage />

  <Card class="mt-4 max-w-3xl">
    <form method="POST" action="/api/admin/configuracoes/clinica" enctype="multipart/form-data" class="flex flex-col gap-5">
      <div>
        <label for="name" class={LABEL}>Nome da clínica</label>
        <input id="name" name="name" required value={settings.name} class={INPUT} />
      </div>

      <fieldset>
        <legend class={LABEL}>Nas mensagens do WhatsApp</legend>
        <div class="mt-1 flex flex-wrap gap-4 text-sm text-slate-700">
          {MESSAGE_ARTICLES.map((article) => (
            <label class="flex items-center gap-2">
              <input type="radio" name="message_article" value={article} checked={settings.messageArticle === article} class="h-4 w-4 border-slate-300" />
              "Aqui é {article} {settings.name}"
            </label>
          ))}
        </div>
        <p class={HINT}>Como a clínica se apresenta no começo das mensagens ao paciente.</p>
      </fieldset>

      <div>
        <label for="profile" class={LABEL}>Perfil</label>
        <select id="profile" name="profile" class={INPUT}>
          {CLINIC_PROFILES.map((profile) => <option value={profile} selected={profile === settings.profile}>{PROFILE_LABELS[profile]}</option>)}
        </select>
        <p class={HINT}>Define as palavras das telas e do bot: {CLINIC_PROFILES.map(profileHint).join("; ")}.</p>
      </div>

      <div>
        <label for="timezone" class={LABEL}>Fuso horário</label>
        <select id="timezone" name="timezone" class={INPUT}>
          {zones.map((zone) => <option value={zone.value} selected={zone.value === settings.timezone}>{zone.label}</option>)}
        </select>
        <p class={HINT}>Horários da agenda, lembretes e resumos seguem este fuso.</p>
      </div>

      <div>
        <label class="flex items-center gap-2 text-sm font-medium text-slate-700">
          <input type="checkbox" name="age_limit_on" checked={settings.consultationAgeLimitYears !== null} class="h-4 w-4 rounded border-slate-300" />
          Idade limite para consulta
        </label>
        <div class="mt-1 flex items-center gap-2">
          <input
            type="number"
            min="1"
            name="age_limit"
            aria-label="Idade limite em anos"
            value={settings.consultationAgeLimitYears ?? ""}
            class={`${INPUT} mt-0 w-24`}
          />
          <span class="text-sm text-slate-600">anos</span>
        </div>
        <p class={HINT}>A partir desta idade, o bot não marca Consulta (só Retorno e Exame) e a tela avisa.</p>
      </div>

      <fieldset class="flex flex-col gap-4 border-t border-slate-200 pt-4">
        <legend class="text-sm font-semibold uppercase tracking-wide text-slate-500">Páginas públicas</legend>
        <p class={HINT}>
          Topo das páginas de agendamento e de preparo que o paciente abre pelo link.
          <a href="/admin/configuracoes/previa" target="_blank" class="font-medium text-sky-700 underline">Ver como fica</a>
        </p>

        <div>
          <span class={LABEL}>Logo</span>
          <div class="mt-1 flex items-center gap-4">
            {
              settings.logoUrl ? (
                <img src={settings.logoUrl} alt="Logo atual" class="h-16 w-16 rounded-md border border-slate-200 bg-white object-contain p-1" />
              ) : (
                <span class="flex h-16 w-16 items-center justify-center rounded-md border border-dashed border-slate-300 text-xs text-slate-400">Sem logo</span>
              )
            }
            <div class="flex flex-col gap-2">
              <input
                type="file"
                id="logo"
                name="logo"
                accept={Object.keys(LOGO_TYPES).join(",")}
                aria-label={settings.logoUrl ? "Trocar o logo" : "Enviar o logo"}
                class="text-sm text-slate-700 file:mr-3 file:rounded-md file:border file:border-slate-300 file:bg-white file:px-3 file:py-1.5 file:text-sm file:font-medium"
              />
              {
                settings.logoUrl && (
                  <label class="flex items-center gap-2 text-sm text-slate-700">
                    <input type="checkbox" name="remove_logo" class="h-4 w-4 rounded border-slate-300" />
                    Remover o logo
                  </label>
                )
              }
            </div>
          </div>
          <p class={HINT}>PNG, JPG ou WebP, até 1 MB. De preferência quadrado. Sem logo, aparece só o nome da clínica.</p>
        </div>

        <div>
          <label for="brand_color" class={LABEL}>Cor da clínica</label>
          <div class="mt-1 flex flex-wrap items-center gap-2" data-brand-swatches>
            {
              BRAND_COLOR_OPTIONS.map((option) => (
                <button
                  type="button"
                  data-color={option.value}
                  title={option.label}
                  aria-label={option.label}
                  aria-pressed={option.value === currentColor ? "true" : "false"}
                  class="h-9 w-9 rounded-full border-2 border-white shadow ring-1 ring-slate-300 aria-pressed:ring-2 aria-pressed:ring-slate-900"
                  style={`background-color: ${option.value};`}
                />
              ))
            }
            <label class="ml-1 flex items-center gap-2 text-sm text-slate-600">
              Outra:
              <input type="color" id="brand_color" name="brand_color" value={currentColor} class="h-9 w-14 rounded border border-slate-300" />
            </label>
          </div>
          <p class={HINT}>Fundo do topo, com o nome e o logo. Escolha uma das cores ou outra em "Outra".</p>
        </div>

        <div>
          <label for="website_url" class={LABEL}>Site da clínica</label>
          <input id="website_url" name="website_url" inputmode="url" placeholder="www.suaclinica.com.br" value={settings.websiteUrl ?? ""} class={INPUT} />
          <p class={HINT}>Opcional. Com site, as páginas mostram o botão "Voltar para o site".</p>
        </div>
      </fieldset>

      {
        hasBot && (
          <fieldset class="flex flex-col gap-4 border-t border-slate-200 pt-4">
            <legend class="text-sm font-semibold uppercase tracking-wide text-slate-500">Informações que o bot responde</legend>
            <div>
              <label for="bot_payment_info" class={LABEL}>
                Formas de pagamento
              </label>
              <textarea id="bot_payment_info" name="bot_payment_info" rows="3" class={INPUT}>{settings.botPaymentInfo ?? ""}</textarea>
            </div>
            <div>
              <label for="bot_insurance_info" class={LABEL}>
                Convênios
              </label>
              <textarea id="bot_insurance_info" name="bot_insurance_info" rows="3" class={INPUT}>{settings.botInsuranceInfo ?? ""}</textarea>
            </div>
            <div>
              <label for="bot_notes" class={LABEL}>
                Observações
              </label>
              <textarea id="bot_notes" name="bot_notes" rows="3" class={INPUT}>{settings.botNotes ?? ""}</textarea>
            </div>
          </fieldset>
        )
      }

      <button type="submit" class={`${PRIMARY_BUTTON} self-start`}>Salvar</button>
    </form>
  </Card>
</AdminLayout>

<script>
  // Cores prontas: clicar marca a bolinha e passa a cor para o campo "Outra",
  // que é o que vai no formulário; escolher em "Outra" desmarca as bolinhas.
  document.querySelectorAll<HTMLElement>("[data-brand-swatches]").forEach((group) => {
    const input = group.querySelector<HTMLInputElement>("input[type=color]")!;
    const swatches = [...group.querySelectorAll<HTMLButtonElement>("button[data-color]")];
    const mark = () =>
      swatches.forEach((swatch) =>
        swatch.setAttribute("aria-pressed", String(swatch.dataset.color!.toLowerCase() === input.value.toLowerCase())),
      );
    swatches.forEach((swatch) =>
      swatch.addEventListener("click", () => {
        input.value = swatch.dataset.color!;
        mark();
      }),
    );
    input.addEventListener("input", mark);
  });
</script>

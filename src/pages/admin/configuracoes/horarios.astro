---
// Configurações › Horários (F4.4b): dias e horários de atendimento de cada
// agenda, por local. Um horário pode valer só para um serviço (ex.: exame só
// na terça) e, se o serviço for em turma, define as vagas. A sobreposição
// segue a regra de 04/out (por agenda; ver src/lib/data/config/availability.ts).
// Redesign 3B (cliente, 19/out/2026): uma coluna por dia no computador, com o
// total de horas, o "⋯" de cada horário e "Adicionar" (abre o formulário com o
// dia marcado); no celular e no tablet, uma linha por dia.
import ConfigShell from "../../../components/admin/config/ConfigShell.astro";
import HorarioBloco, { type HorarioHeader } from "../../../components/admin/config/HorarioBloco.astro";
import { agendaCategoriesTitle, CATEGORY_STYLES, serviceBesideCategory, serviceLook, serviceTints } from "../../../components/admin/agenda/categoryStyle";
import Card from "../../../components/admin/config/Panel.astro";
import ConfirmDeleteDialog from "../../../components/admin/ConfirmDeleteDialog.astro";
import Icon from "../../../components/admin/Icon.astro";
import { CHECK, HINT, INPUT, INPUT_INLINE, LABEL, PRIMARY_BUTTON, SECONDARY_BUTTON } from "../../../components/admin/config/formStyles";
import { createUserClient } from "../../../lib/data/clients";
import { listAgendas } from "../../../lib/data/config/agendas";
import { listAvailability, WEEKDAY_NAMES } from "../../../lib/data/config/availability";
import { listLocations } from "../../../lib/data/config/locations";
import { listServiceRefs, listServices } from "../../../lib/data/config/services";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const showInactive = Astro.url.searchParams.get("todos") === "1";
const [agendas, locations, services, serviceRefs] = await Promise.all([
  listAgendas(db, clinic.clinicId),
  listLocations(db, clinic.clinicId, { includeInactive: true }),
  listServices(db, clinic.clinicId, { includeInactive: true }),
  listServiceRefs(db, clinic.clinicId),
]);
// Cor de cada serviço, a mesma da Agenda (cliente, 19/out/2026).
const tints = serviceTints(serviceRefs);
const agenda = agendas.find((a) => a.id === Astro.url.searchParams.get("agenda")) ?? agendas[0] ?? null;
const windows = agenda ? await listAvailability(db, clinic.clinicId, agenda.id, { includeInactive: showInactive }) : [];

const locationName = new Map(locations.map((l) => [l.id, l.name]));
const serviceById = new Map(services.map((s) => [s.id, s]));
// Domiciliar e exames só com o item liberado (D11). Horários já gravados com
// eles continuam na lista, marcados como não liberados.
const homeVisitOn = clinic.features.includes("home_visit");
const examsOn = clinic.features.includes("exams");
const homeVisitIds = new Set(locations.filter((l) => l.type === "home_visit").map((l) => l.id));
const activeLocations = locations.filter((l) => l.isActive && (homeVisitOn || l.type !== "home_visit"));
const agendaServices = agenda ? services.filter((s) => s.isActive && s.agendaIds.includes(agenda.id) && (examsOn || s.category !== "exam")) : [];
const notEnabled = (w: { locationId: string; serviceId: string | null }) =>
  (!homeVisitOn && homeVisitIds.has(w.locationId)) || (!examsOn && !!w.serviceId && serviceById.get(w.serviceId)?.category === "exam");
const action = "/api/admin/configuracoes/horarios";
// Editar um horário (cliente, 21/out/2026): o formulário de baixo abre com ele.
const editing = windows.find((w) => w.id === Astro.url.searchParams.get("editar")) ?? null;
// Local e serviço sem valor padrão (cliente, 21/out/2026): só vem escolhido o
// serviço de onde a pessoa veio ("Cadastrar os horários" do serviço, F6.3b).
const preselectedService = editing
  ? (editing.serviceId ?? "todos")
  : (agendaServices.find((s) => s.id === Astro.url.searchParams.get("servico"))?.id ?? "");
// Na edição, o local e o serviço já gravados aparecem mesmo desativados.
const locationOptions = activeLocations.concat(locations.filter((l) => l.id === editing?.locationId && !activeLocations.includes(l)));
const editingService = editing?.serviceId ? serviceById.get(editing.serviceId) : undefined;
const serviceOptions = agendaServices.concat(editingService && !agendaServices.includes(editingService) ? [editingService] : []);
const agendaQuery = (extra = "") => `?agenda=${agenda?.id ?? ""}${extra}`;
// Segunda a sábado primeiro, domingo no fim (como a semana da clínica).
const weekdayOrder = [1, 2, 3, 4, 5, 6, 0];
const SHORT = ["Dom", "Seg", "Ter", "Qua", "Qui", "Sex", "Sáb"];
const minutesOf = (t: string) => {
  const [h, m] = t.split(":").map(Number);
  return h * 60 + m;
};
const formatHours = (minutes: number) => {
  const h = Math.floor(minutes / 60);
  const m = minutes % 60;
  return m ? `${h}h${String(m).padStart(2, "0")}` : `${h}h`;
};
const days = weekdayOrder.map((weekday) => {
  const dayWindows = windows.filter((w) => w.weekday === weekday);
  const minutes = dayWindows.filter((w) => w.isActive).reduce((sum, w) => sum + minutesOf(w.endTime) - minutesOf(w.startTime), 0);
  return {
    weekday,
    name: WEEKDAY_NAMES[weekday],
    column: WEEKDAY_NAMES[weekday].replace("-feira", ""),
    short: SHORT[weekday],
    windows: dayWindows,
    minutes,
    total: minutes > 0 ? formatHours(minutes) : dayWindows.length > 0 ? "desativado" : "",
    // "na segunda-feira", "no sábado".
    addLabel: `Novo horário ${weekday === 0 || weekday === 6 ? "no" : "na"} ${WEEKDAY_NAMES[weekday].toLowerCase()}`,
  };
});
const weekMinutes = days.reduce((sum, d) => sum + d.minutes, 0);
const activeDays = days.filter((d) => d.minutes > 0).length;
// "Adicionar" de um dia: o formulário abre com ele marcado.
const preselectedDay = Number(Astro.url.searchParams.get("dia"));
const addHref = (weekday: number) => `${agendaQuery(`${showInactive ? "&todos=1" : ""}&dia=${weekday}`)}#novo-horario`;
const editHref = (id: string) => `${agendaQuery(`${showInactive ? "&todos=1" : ""}&editar=${id}`)}#novo-horario`;
const cancelEditHref = `${agendaQuery(showInactive ? "&todos=1" : "")}#novo-horario`;
// Faixa do tipo (proposta A, 19/out): o tipo do serviço do horário; no horário
// de todos os serviços, os tipos que a agenda atende ("Consulta e Retorno").
const agendaCategories = [...new Set(agendaServices.map((s) => s.category))];
const generalHeader: HorarioHeader =
  agendaCategories.length === 1
    ? { ...CATEGORY_STYLES[agendaCategories[0]], border: "border-line-strong", service: null }
    : {
        label: agendaCategoriesTitle(agendaCategories),
        icon: "queue-list",
        band: "border-[#a9d6c6] bg-brand-soft",
        text: "text-brand-ink",
        detail: "text-brand-ink",
        border: "border-[#a9d6c6]",
        service: null,
      };
const headerOf = (w: (typeof windows)[number]): HorarioHeader => {
  const service = w.serviceId ? serviceById.get(w.serviceId) : undefined;
  if (!service) return generalHeader;
  return { ...serviceLook(service.category, tints.get(service.id)), service: serviceBesideCategory(service.name, service.category) };
};
const blockProps = (w: (typeof windows)[number], dayName: string) => ({
  window: w,
  dayName,
  locationName: locationName.get(w.locationId) ?? "Local",
  header: headerOf(w),
  notEnabled: notEnabled(w),
  agendaId: agenda?.id ?? "",
  showInactive,
  editHref: editHref(w.id),
});
import HowItWorks from "../../../components/admin/ui/HowItWorks.astro";
import { configuracoes } from "../../../lib/ajuda/configuracoes";
---

<ConfigShell current="horarios" title="Horários" subtitle="Quando cada agenda atende, em que local e com quais serviços.">

  {
    !agenda ? (
      <p class="mt-4 text-sm text-ink-soft">
        Nenhuma agenda ativa. Cadastre uma em{" "}
        <a href="/admin/configuracoes/agendas" class="text-brand hover:underline">
          Agendas
        </a>
        .
      </p>
    ) : (
      <>
        <HowItWorks id="horarios" topic={configuracoes.comoFunciona.horarios} class="mb-3">
          <p class="text-[15px] text-ink-soft">Como os horários viram vagas para marcar.</p>
        </HowItWorks>
        <form method="GET" class="flex flex-wrap items-center gap-x-4 gap-y-3 rounded-xl border border-line bg-white px-3.5 py-2.5">
          <div class="flex min-w-0 flex-1 items-center gap-3 sm:flex-none">
            <label for="agenda" class="text-[15px] font-semibold text-ink">
              Agenda
            </label>
            <select id="agenda" name="agenda" class={`${INPUT_INLINE} min-w-0 flex-1 sm:w-60 sm:flex-none`} data-autosubmit>
              {agendas.map((a) => (
                <option value={a.id} selected={a.id === agenda.id}>
                  {a.name}
                </option>
              ))}
            </select>
          </div>
          <label class="inline-flex min-h-11 items-center gap-2 text-[15px] text-ink">
            <input type="checkbox" name="todos" value="1" checked={showInactive} class={CHECK} data-autosubmit />
            Mostrar desativados
          </label>
          <noscript>
            <button type="submit" class={SECONDARY_BUTTON}>
              Ver
            </button>
          </noscript>
          <p class="text-[15px] text-ink-mid lg:ml-auto">
            {weekMinutes > 0 ? (
              <>
                <strong class="text-ink">{formatHours(weekMinutes)}</strong> por semana, em {activeDays} {activeDays === 1 ? "dia" : "dias"}
              </>
            ) : (
              "Nenhum horário ativo nesta agenda."
            )}
          </p>
        </form>

        <section aria-label={`Semana de ${agenda.name}`} class="hidden gap-2 xl:grid xl:grid-cols-7">
          {days.map((day) => (
            <div class={`flex min-h-[340px] min-w-0 flex-col gap-2 rounded-xl border border-line p-2 ${day.windows.length ? "bg-white" : "bg-[#f8faf9]"}`}>
              <div class="flex flex-col gap-0.5 border-b border-[#e6ecea] px-0.5 pb-2">
                <h2 class="font-display text-base leading-tight font-bold text-ink">{day.column}</h2>
                <span class="min-h-[18px] text-[13px] text-ink-soft">{day.total}</span>
              </div>
              {day.windows.length === 0 && <p class="px-0.5 py-1 text-sm text-ink-soft">Sem atendimento</p>}
              {day.windows.map((w) => (
                <HorarioBloco {...blockProps(w, day.name)} idPrefix="col" />
              ))}
              <a
                href={addHref(day.weekday)}
                aria-label={day.addLabel}
                class="mt-auto flex h-9 items-center justify-center gap-1 rounded-lg border border-dashed border-[#a9bdb6] text-sm font-semibold text-brand-ink no-underline hover:border-brand hover:bg-brand-soft/50"
              >
                <Icon name="plus" class="h-3.5 w-3.5" strokeWidth={2.6} /> Adicionar
              </a>
            </div>
          ))}
        </section>

        <section aria-label={`Semana de ${agenda.name}`} class="flex flex-col overflow-hidden rounded-xl border border-line bg-white xl:hidden">
          {days.map((day, i) => (
            <div class={`flex items-start gap-2.5 py-3 pr-3 pl-3.5 ${i > 0 ? "border-t border-[#e6ecea]" : ""} ${day.windows.length ? "" : "bg-[#f8faf9]"}`}>
              <div class="flex w-14 shrink-0 flex-col gap-0.5 pt-0.5">
                <h2 class="font-display text-base leading-tight font-bold text-ink">
                  <span aria-hidden="true">{day.short}</span>
                  <span class="sr-only">{day.name}</span>
                </h2>
                <span class="text-[13px] text-ink-soft">{day.total}</span>
              </div>
              <div class="flex min-w-0 flex-1 flex-col gap-1.5">
                {day.windows.length === 0 && <p class="py-1 text-[15px] text-ink-soft">Sem atendimento</p>}
                {day.windows.map((w) => (
                  <HorarioBloco {...blockProps(w, day.name)} idPrefix="lin" large />
                ))}
              </div>
              <a
                href={addHref(day.weekday)}
                aria-label={day.addLabel}
                class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-line-strong bg-white text-brand-ink no-underline hover:border-brand"
              >
                <Icon name="plus" class="h-4 w-4" strokeWidth={2.6} />
              </a>
            </div>
          ))}
        </section>

        <Card id="novo-horario" class="max-w-3xl scroll-mt-4">
          <h2 class="font-display text-[17px] leading-tight font-bold text-ink sm:text-lg">
            {editing ? `Editar horário: ${WEEKDAY_NAMES[editing.weekday].toLowerCase()}, ${editing.startTime}–${editing.endTime}` : `Novo horário em ${agenda.name}`}
          </h2>
          {editing && <p class={HINT}>Os atendimentos já marcados continuam como estão.</p>}
          {locationOptions.length === 0 ? (
            <p class="mt-2 text-sm text-ink-soft">
              Cadastre um local em{" "}
              <a href="/admin/configuracoes/locais" class="text-brand hover:underline">
                Locais
              </a>{" "}
              antes.
            </p>
          ) : (
            <form method="POST" action={action} class="mt-3 flex flex-col gap-4">
              <input type="hidden" name="acao" value={editing ? "editar" : "adicionar"} />
              <input type="hidden" name="agenda_id" value={agenda.id} />
              {editing && <input type="hidden" name="window_id" value={editing.id} />}
              {showInactive && <input type="hidden" name="todos" value="1" />}
              <fieldset>
                <legend class={LABEL}>{editing ? "Dia da semana" : "Dias da semana"}</legend>
                <div class="mt-2 flex flex-wrap gap-1.5">
                  {weekdayOrder.map((weekday) => (
                    <label class="inline-flex h-10 min-w-14 cursor-pointer items-center justify-center rounded-full border border-line-strong bg-white px-3 text-[15px] font-semibold text-ink select-none has-[:checked]:border-brand has-[:checked]:bg-brand has-[:checked]:text-white has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-brand">
                      <input
                        type={editing ? "radio" : "checkbox"}
                        name="weekday"
                        value={weekday}
                        required={!!editing}
                        checked={editing ? editing.weekday === weekday : preselectedDay === weekday && Astro.url.searchParams.has("dia")}
                        class="sr-only"
                      />
                      <span aria-hidden="true">{SHORT[weekday]}</span>
                      <span class="sr-only">{WEEKDAY_NAMES[weekday]}</span>
                    </label>
                  ))}
                </div>
                {!editing && <p class={HINT}>O mesmo horário entra em cada dia marcado.</p>}
              </fieldset>
              <div class="flex flex-wrap gap-4">
                <div>
                  <label for="start_time" class={LABEL}>
                    Início
                  </label>
                  <input id="start_time" name="start_time" type="time" required value={editing?.startTime} class={`${INPUT_INLINE} mt-1.5 w-32`} />
                </div>
                <div>
                  <label for="end_time" class={LABEL}>
                    Fim
                  </label>
                  <input id="end_time" name="end_time" type="time" required value={editing?.endTime} class={`${INPUT_INLINE} mt-1.5 w-32`} />
                </div>
              </div>
              <div>
                <label for="location_id" class={LABEL}>
                  Local
                </label>
                <select id="location_id" name="location_id" required class={INPUT}>
                  <option value="" selected={!editing}>
                    Escolha o local…
                  </option>
                  {locationOptions.map((l) => (
                    <option value={l.id} selected={l.id === editing?.locationId}>
                      {l.name}
                      {!l.isActive ? " (desativado)" : ""}
                    </option>
                  ))}
                </select>
              </div>
              <div>
                <label for="service_id" class={LABEL}>
                  Serviço
                </label>
                <select id="service_id" name="service_id" required class={INPUT}>
                  <option value="" selected={preselectedService === ""}>
                    Escolha o serviço…
                  </option>
                  <option value="todos" selected={preselectedService === "todos"}>
                    Qualquer serviço desta agenda
                  </option>
                  {serviceOptions.map((s) => (
                    <option value={s.id} data-group={s.schedulingMode === "group" ? "1" : undefined} selected={s.id === preselectedService}>
                      {s.name}
                      {s.schedulingMode === "group" ? " (turma)" : ""}
                    </option>
                  ))}
                </select>
                <p class={HINT}>Escolha um serviço quando o horário for só dele (ex.: exame só na terça de manhã).</p>
              </div>
              <div data-capacity hidden>
                <label for="capacity" class={LABEL}>
                  Vagas da turma
                </label>
                <input id="capacity" name="capacity" type="number" min="1" value={editing?.capacity ?? undefined} class={`${INPUT_INLINE} mt-1.5 w-28`} />
              </div>
              {editing ? (
                <div class="flex flex-wrap gap-2">
                  <button type="submit" class={PRIMARY_BUTTON} data-sending-label="Salvando…">
                    Salvar
                  </button>
                  <a href={cancelEditHref} class={SECONDARY_BUTTON}>
                    Cancelar
                  </a>
                </div>
              ) : (
                <button type="submit" class={`${PRIMARY_BUTTON} self-start`}>
                  Adicionar
                </button>
              )}
            </form>
          )}
        </Card>
        <ConfirmDeleteDialog />
      </>
    )
  }

  <script>
    // Vagas só para serviço em turma.
    const service = document.getElementById("service_id") as HTMLSelectElement | null;
    const capacity = document.querySelector<HTMLElement>("[data-capacity]");
    const sync = () => {
      if (!service || !capacity) return;
      const isGroup = service.selectedOptions[0]?.dataset.group === "1";
      capacity.hidden = !isGroup;
      const input = capacity.querySelector("input");
      if (input) {
        input.required = isGroup;
        if (!isGroup) input.value = "";
      }
    };
    service?.addEventListener("change", sync);
    sync();
  </script>
</ConfigShell>

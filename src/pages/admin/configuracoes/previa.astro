---
// Prévia das páginas públicas (F5.1): topo e rodapé com a marca salva da
// clínica, em volta de um exemplo de conteúdo. Abre em outra aba a partir de
// Configurações › Clínica. Redesign R11: a mesma moldura das páginas do
// paciente (PatientLayout).
import PatientLayout from "../../../layouts/PatientLayout.astro";
import { PATIENT_TEXT } from "../../../components/public/styles";
import { createUserClient } from "../../../lib/data/clients";
import { getPublicClinicBrand } from "../../../lib/data/config/brand";

const clinic = Astro.locals.clinic!;
const brand = await getPublicClinicBrand(createUserClient(Astro.request, Astro.cookies), clinic.clinicId);
---

<PatientLayout title="Prévia" brand={brand}>
  <p slot="before-header" class="bg-amber-100 px-4 py-2 text-center text-sm text-amber-900">
    Prévia: é assim que o paciente vê o topo e o rodapé. O conteúdo do meio é só um exemplo.
  </p>
  <div>
    <p class="text-[15px] font-semibold text-clinic-ink">Exemplo</p>
    <h1 class="mt-0.5 text-[26px] leading-tight font-bold text-gray-900 sm:text-3xl">Escolha o dia e o horário</h1>
  </div>
  <div class={PATIENT_TEXT}>Aqui aparecem os dias e horários livres para marcar ou remarcar o atendimento.</div>
</PatientLayout>

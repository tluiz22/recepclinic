---
// Configurações › Locais (F4.3): consultório (com endereço) ou domiciliar.
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Badge from "../../../components/admin/Badge.astro";
import Card from "../../../components/admin/Card.astro";
import ConfiguracoesTabs from "../../../components/admin/ConfiguracoesTabs.astro";
import FlashMessage from "../../../components/admin/FlashMessage.astro";
import { PRIMARY_BUTTON } from "../../../components/admin/fieldStyles";
import { createUserClient } from "../../../lib/data/clients";
import { listLocations } from "../../../lib/data/config/locations";

const clinic = Astro.locals.clinic!;
const showInactive = Astro.url.searchParams.get("todos") === "1";
const locations = await listLocations(createUserClient(Astro.request, Astro.cookies), clinic.clinicId, { includeInactive: showInactive });
---

<AdminLayout title="Locais">
  <h1 class="text-2xl font-bold text-slate-900">Configurações</h1>
  <ConfiguracoesTabs current="locais" />
  <FlashMessage />

  <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
    <a href="/admin/configuracoes/locais/novo" class={PRIMARY_BUTTON}>Novo local</a>
    <a href={showInactive ? "?" : "?todos=1"} class="text-sm text-sky-700 hover:underline">
      {showInactive ? "Esconder desativados" : "Mostrar desativados"}
    </a>
  </div>

  <ul class="mt-4 grid gap-3 sm:grid-cols-2">
    {
      locations.map((location) => (
        <li>
          <a href={`/admin/configuracoes/locais/${location.id}`}>
            <Card class="h-full hover:border-sky-300 hover:bg-sky-50" muted={!location.isActive}>
              <p class="font-medium text-slate-900">
                {location.name} <Badge variant={location.type === "home_visit" ? "accent" : "info"}>{location.type === "home_visit" ? "Domiciliar" : "Consultório"}</Badge>{" "}
                {!location.isActive && <Badge>desativado</Badge>}
              </p>
              <p class="mt-1 text-sm text-slate-600">{location.type === "home_visit" ? "Endereço de cada paciente" : (location.address ?? "Sem endereço")}</p>
            </Card>
          </a>
        </li>
      ))
    }
  </ul>
  {locations.length === 0 && <p class="mt-4 text-sm text-slate-600">Nenhum local cadastrado.</p>}
</AdminLayout>

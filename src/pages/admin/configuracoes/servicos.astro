---
// Configurações › Serviços (F4.3, D4c): consulta, retorno e exame, com as
// agendas que atendem e os locais em que são oferecidos.
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Badge from "../../../components/admin/Badge.astro";
import IssueBadges from "../../../components/admin/setup/IssueBadges.astro";
import { loadSetupStatus } from "../../../lib/data/config/setup";
import Card from "../../../components/admin/Card.astro";
import ConfiguracoesTabs from "../../../components/admin/ConfiguracoesTabs.astro";
import FlashMessage from "../../../components/admin/FlashMessage.astro";
import { PRIMARY_BUTTON } from "../../../components/admin/fieldStyles";
import { createUserClient } from "../../../lib/data/clients";
import { listAgendas } from "../../../lib/data/config/agendas";
import { listServices } from "../../../lib/data/config/services";
import { formatCentsBRL } from "../../../lib/money";
import { CATEGORY_LABELS } from "../../../lib/serviceLabels";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const showInactive = Astro.url.searchParams.get("todos") === "1";
const [services, agendas] = await Promise.all([
  listServices(db, clinic.clinicId, { includeInactive: showInactive }),
  listAgendas(db, clinic.clinicId, { includeInactive: true }),
]);
const agendaName = new Map(agendas.map((a) => [a.id, a.name]));
// Pendências da jornada de configuração (F6.3b), nos selos.
const setup = await loadSetupStatus(createUserClient(Astro.request, Astro.cookies), clinic.clinicId, clinic.features);
---

<AdminLayout title="Serviços">
  <h1 class="text-2xl font-bold text-slate-900">Configurações</h1>
  <ConfiguracoesTabs current="servicos" />
  <FlashMessage />

  <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
    <a href="/admin/configuracoes/servicos/novo" class={PRIMARY_BUTTON}>Novo serviço</a>
    <a href={showInactive ? "?" : "?todos=1"} class="text-sm text-sky-700 hover:underline">
      {showInactive ? "Esconder desativados" : "Mostrar desativados"}
    </a>
  </div>

  <ul class="mt-4 grid gap-3 sm:grid-cols-2">
    {
      services.map((service) => (
        <li>
          <a href={`/admin/configuracoes/servicos/${service.id}`}>
            <Card class="h-full hover:border-sky-300 hover:bg-sky-50" muted={!service.isActive}>
              <p class="font-medium text-slate-900">
                {service.name} <Badge variant={service.category === "exam" ? "accent" : "info"}>{CATEGORY_LABELS[service.category]}</Badge>{" "}
                {service.schedulingMode === "group" && <Badge variant="warning">turma</Badge>} {!service.isActive && <Badge>desativado</Badge>} <IssueBadges issues={setup.issues.services.get(service.id)} />
              </p>
              <p class="mt-1 text-sm text-slate-600">
                {service.durationMinutes} min · {formatCentsBRL(service.priceCents)}
                {service.returnDeadlineDays ? ` · retorno em até ${service.returnDeadlineDays} dias` : ""}
              </p>
              <p class="text-sm text-slate-500">
                {service.agendaIds.length ? service.agendaIds.map((id) => agendaName.get(id)).join(", ") : "Nenhuma agenda: não aparece para marcar"}
              </p>
            </Card>
          </a>
        </li>
      ))
    }
  </ul>
  {services.length === 0 && <p class="mt-4 text-sm text-slate-600">Nenhum serviço cadastrado.</p>}
</AdminLayout>

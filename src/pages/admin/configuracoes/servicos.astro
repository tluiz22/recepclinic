---
import { ownSettingsOnly } from "../../../lib/clinicAccess";
// Configurações › Serviços (F4.3, D4c): consulta, retorno e exame, com o
// profissional dono (MS, 07/nov/2026) e os locais em que são oferecidos.
// Redesign R9 (cliente, 17/out/2026): uma linha por serviço, "Ativos | Todos".
import ConfigShell from "../../../components/admin/config/ConfigShell.astro";
import { withAllFilter } from "../../../lib/returnPath";
import ConfigEmpty from "../../../components/admin/config/ConfigEmpty.astro";
import ActiveFilter from "../../../components/admin/config/ActiveFilter.astro";
import { HEAD_ROW, LIST, ROW, ROW_CELL, ROW_GO, ROW_NAME, SOFT } from "../../../components/admin/config/formStyles";
import Icon from "../../../components/admin/Icon.astro";
import IssueBadges from "../../../components/admin/setup/IssueBadges.astro";
import Button from "../../../components/admin/ui/Button.astro";
import Notice from "../../../components/admin/ui/Notice.astro";
import Pill from "../../../components/admin/ui/Pill.astro";
import Tag from "../../../components/admin/ui/Tag.astro";
import { createUserClient } from "../../../lib/data/clients";
import { listProfessionals } from "../../../lib/data/config/professionals";
import { hasOwner, listServices, TEAM_OWNER } from "../../../lib/data/config/services";
import { ownerLabel, ownerOptionGroups } from "../../../lib/serviceOwner";
import OwnerPicker from "../../../components/admin/OwnerPicker.astro";

const OWNER_COOKIE = "rc_servicos_profissional";
import { loadSetupStatus } from "../../../lib/data/config/setup";
import { formatCentsBRL } from "../../../lib/money";
import { CATEGORY_LABELS } from "../../../lib/serviceLabels";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const showInactive = Astro.url.searchParams.get("todos") === "1";
const [all, professionals, setup] = await Promise.all([
  listServices(db, clinic.clinicId, { includeInactive: true }),
  listProfessionals(db, clinic.clinicId, { includeInactive: true }),
  // Pendências da jornada de configuração (F6.3b), nos selos.
  loadSetupStatus(db, clinic.clinicId, clinic.features),
]);
// Profissional com login (MS, S1): só os serviços dele.
const ownOnly = ownSettingsOnly(clinic);
// Busca de profissional (MS, S4, opção D; cliente, 07/nov/2026): com mais de um dono, a lista mostra só os serviços
// do escolhido; a última escolha fica lembrada neste navegador. Agrupada pela especialidade (10+ profissionais).
const NO_OWNER = "sem";
const keyOf = (s: { professionalId: string | null; isTeam: boolean }) => (s.isTeam ? TEAM_OWNER : (s.professionalId ?? NO_OWNER));
const counts = new Map<string, number>();
for (const s of all) counts.set(keyOf(s), (counts.get(keyOf(s)) ?? 0) + 1);
const ownerGroups = [
  ...ownerOptionGroups(professionals.filter((p) => counts.has(p.id)), { team: counts.has(TEAM_OWNER) }),
  ...(counts.has(NO_OWNER) ? [{ label: "Sem profissional", options: [{ value: NO_OWNER, label: "Sem profissional (desativados)" }] }] : []),
];
const ownerKeys = ownerGroups.flatMap((g) => g.options.map((o) => o.value));
const usePicker = !ownOnly && ownerKeys.length > 1;
const asked = Astro.url.searchParams.get("profissional");
const remembered = Astro.cookies.get(OWNER_COOKIE)?.value ?? null;
const chosenKey = usePicker ? ([asked, asked === null ? remembered : null].find((k) => k && ownerKeys.includes(k)) ?? null) : null;
if (usePicker) {
  if (chosenKey) Astro.cookies.set(OWNER_COOKIE, chosenKey, { path: "/admin/configuracoes/servicos", maxAge: 180 * 24 * 60 * 60, sameSite: "lax", httpOnly: true });
  else if (asked !== null) Astro.cookies.delete(OWNER_COOKIE, { path: "/admin/configuracoes/servicos" });
}
const chosenLabel = chosenKey === NO_OWNER ? "Sem profissional" : chosenKey ? ownerLabel({ professionalId: chosenKey === TEAM_OWNER ? null : chosenKey, isTeam: chosenKey === TEAM_OWNER }, professionals) : "";
const mine = ownOnly ? all.filter((s) => s.professionalId === clinic.ownProfessionalId) : usePicker ? all.filter((s) => keyOf(s) === chosenKey) : all;
const clinicActive = (ownOnly ? mine : all).filter((s) => s.isActive);
const active = mine.filter((s) => s.isActive);
const newHref = chosenKey && chosenKey !== NO_OWNER ? `/admin/configuracoes/servicos/novo?profissional=${chosenKey}` : "/admin/configuracoes/servicos/novo";
// Aba "Desativados" (cliente, 21/out/2026): só os desativados.
const services = showInactive ? mine.filter((s) => !s.isActive) : active;
// Sem retorno com horário, o bot não mostra "Marcar retorno" (cliente, 18/out/2026).
const returns = clinicActive.filter((s) => s.category === "return_visit");
const returnReady = returns.some((s) => !setup.issues.services.get(s.id)?.length);
const cols = "lg:grid-cols-[minmax(0,2fr)_200px_minmax(0,2fr)_36px]";
import HowItWorks from "../../../components/admin/ui/HowItWorks.astro";
import { configuracoes } from "../../../lib/ajuda/configuracoes";
---

<ConfigShell current="servicos" title={ownOnly ? "Meus serviços" : "Serviços"} subtitle={ownOnly ? "O que você oferece para marcar, com duração e preço." : "O que cada profissional oferece para marcar, com duração e preço."} setup={setup}>
  <Button slot="actions" href={newHref} variant="primary">
    <Icon name="plus" class="h-[18px] w-[18px]" strokeWidth={2.2} /> Novo serviço
  </Button>

  {
    clinicActive.length > 0 &&
      !returnReady &&
      (returns.length ? (
        <Notice tone="info">
          Nenhum serviço de Retorno está pronto para marcar (veja os selos abaixo): o bot não mostra a opção <strong>Marcar retorno</strong>.
        </Notice>
      ) : (
        <Notice tone="info" href="/admin/configuracoes/servicos/novo?tipo=retorno" linkLabel="Cadastrar o retorno">
          A clínica não tem serviço do tipo Retorno: o bot não mostra a opção <strong>Marcar retorno</strong>. Se a clínica faz retorno, cadastre um.
        </Notice>
      ))
  }

  <HowItWorks id="servicos" topic={configuracoes.comoFunciona.servicos} class="mb-3">
    <p class="text-[15px] text-ink-soft">O que o paciente pode marcar e do que o serviço depende.</p>
  </HowItWorks>

  {
    usePicker && !chosenKey && (
      <section aria-labelledby="busca-titulo" class="mb-4 flex max-w-2xl flex-col gap-3 rounded-xl border border-line bg-white p-4 sm:p-5">
        <div>
          <h2 id="busca-titulo" class="font-display text-[19px] font-bold text-ink">De qual profissional?</h2>
          <p class="text-[15px] text-ink-soft">Cada profissional tem os próprios serviços. Escolha para ver e editar os dele.</p>
        </div>
        <OwnerPicker id="busca-profissional" groups={ownerGroups} counts={counts} href={(value) => `?profissional=${value}`} />
      </section>
    )
  }
  {
    usePicker && chosenKey && (
      <div class="mb-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 rounded-xl border border-line bg-white px-4 py-3">
        <p class="text-[15px] text-ink">
          <span class="text-ink-soft">Profissional: </span>
          <strong class="font-semibold">{chosenLabel}</strong>
        </p>
        <a href="?profissional=" class="inline-flex min-h-11 items-center text-[15px] font-semibold text-brand no-underline hover:underline">
          Trocar de profissional
        </a>
      </div>
    )
  }

  {(!usePicker || chosenKey) && (<>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <p class="text-sm text-ink-soft" role="status">
      {services.length} {services.length === 1 ? "serviço" : "serviços"}{services.length === 1 ? (showInactive ? " desativado" : " ativo") : showInactive ? " desativados" : " ativos"}
    </p>
    <ActiveFilter showInactive={showInactive} active={active.length} inactive={mine.length - active.length} />
  </div>

  {
    services.length > 0 ? (
      <section aria-label="Serviços" class={LIST}>
        <div aria-hidden="true" class={`${HEAD_ROW} ${cols}`}>
          <span>Serviço</span>
          <span>Duração e preço</span>
          <span>Profissional</span>
          <span />
        </div>
        <ul>
          {services.map((service) => {
            const href = withAllFilter(`/admin/configuracoes/servicos/${service.id}`, showInactive);
            return (
              <li class={`${ROW} ${cols} ${service.isActive ? "" : "opacity-60"}`}>
                <div class="flex min-w-0 flex-col gap-1.5">
                  <span class="flex flex-wrap items-center gap-x-2 gap-y-1">
                    <a href={href} class={ROW_NAME}>
                      {service.name}
                    </a>
                    <Tag>{CATEGORY_LABELS[service.category]}</Tag>
                    {service.schedulingMode === "group" && <Tag>Turma</Tag>}
                    {!service.isActive && <Pill>Desativado</Pill>}
                  </span>
                  {service.isActive && (
                    <span class="flex flex-wrap gap-1.5 empty:hidden">
                      <IssueBadges issues={setup.issues.services.get(service.id)} />
                    </span>
                  )}
                </div>
                <a href={href} aria-label={`Abrir ${service.name}`} class={ROW_GO}>
                  <Icon name="chevron-right" class="h-5 w-5" strokeWidth={2.2} />
                </a>
                <span class={`${ROW_CELL} tabular-nums`}>
                  {service.durationMinutes} min
                  <span class="text-ink-soft max-lg:before:content-['_·_'] lg:block">
                    {formatCentsBRL(service.priceCents)}
                    {service.returnDeadlineDays ? ` · retorno em até ${service.returnDeadlineDays} dias` : ""}
                  </span>
                </span>
                <span class={ROW_CELL}>
                  {hasOwner(service) ? (
                    ownerLabel(service, professionals)
                  ) : (
                    <span class={SOFT}>Sem profissional: escolha para reativar</span>
                  )}
                </span>
              </li>
            );
          })}
        </ul>
      </section>
    ) : (
      <ConfigEmpty
        onlyInactive={mine.length > 0}
        showingInactive={showInactive}
        none="Nenhum serviço"
        text="Sem serviço, nada aparece para marcar."
        href={newHref}
        label="Cadastrar o primeiro serviço"
      />
    )
  }
  </>)}
</ConfigShell>

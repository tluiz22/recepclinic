---
// Relacionamento (CRM A1, cliente, 27/out/2026): as pendências que pedem
// contato da equipe, por aba. Administrador e Recepção, com o item
// "Relacionamento" (conferido no middleware pela área); Lembretes e Lista de
// espera exigem também o item da lista de origem. As listas e as ações são as
// do Resumo do Dia, que continua igual (Q1); só a volta das ações é esta tela.
// A2 (27/out): Atendimento (resumo), Retomar contato, Retorno, Faltosos e
// Contatos para revisar; as das Métricas sem exigir os itens delas. P3
// (28/out): Lembretes da equipe, os da ficha com data até hoje.
import AdminLayout from "../../layouts/AdminLayout.astro";
import ConfirmDeleteDialog from "../../components/admin/ConfirmDeleteDialog.astro";
import FlashMessage from "../../components/admin/FlashMessage.astro";
import AguardandoTab from "../../components/admin/resumo/AguardandoTab.astro";
import ListaEsperaTab from "../../components/admin/resumo/ListaEsperaTab.astro";
import AtendimentoTab from "../../components/admin/relacionamento/AtendimentoTab.astro";
import FaltososTab from "../../components/admin/relacionamento/FaltososTab.astro";
import LembretesEquipeTab from "../../components/admin/relacionamento/LembretesEquipeTab.astro";
import LembretesPendentesTab from "../../components/admin/relacionamento/LembretesPendentesTab.astro";
import RetomarContatoTab from "../../components/admin/relacionamento/RetomarContatoTab.astro";
import RetornoTab from "../../components/admin/relacionamento/RetornoTab.astro";
import RevisarTab from "../../components/admin/relacionamento/RevisarTab.astro";
import EmptyState from "../../components/admin/ui/EmptyState.astro";
import HowItWorks from "../../components/admin/ui/HowItWorks.astro";
import PageHeader from "../../components/admin/ui/PageHeader.astro";
import Tabs, { type TabItem } from "../../components/admin/ui/Tabs.astro";
import { relacionamento } from "../../lib/ajuda/relacionamento";
import { createUserClient } from "../../lib/data/clients";
import { loadActorLabels } from "../../lib/data/agenda/trail";
import type { AgendaAppointment } from "../../lib/data/agenda/view";
import { listServiceRefs } from "../../lib/data/config/services";
import { loadRelationshipLists, menuTotal, RELATIONSHIP_TABS, relationshipCounts, relationshipTabs, type RelationshipTab } from "../../lib/data/relationship";
import { listRecentOffers } from "../../lib/data/waitlist/entries";
import { serviceTags } from "../../components/admin/agenda/categoryStyle";
import { todayIn } from "../../lib/clinicTime";
import { logError } from "../../lib/log";
import { vocabularyFor } from "../../lib/vocabulary";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const vocabulary = vocabularyFor(clinic.clinicProfile);
const now = new Date();

const available = relationshipTabs(clinic.features);
const failed = (tab: RelationshipTab, error: unknown) => logError(`relacionamento: ${tab} não carregou`, error, { clinica: clinic.clinicId });
const lists = await loadRelationshipLists(db, clinic.clinicId, available, failed, { timeZone: clinic.timezone, now });
const counts = relationshipCounts(lists);
Astro.locals.relationshipMenuTotal = menuTotal(counts);

// Sem aba no endereço, abre a primeira com pendência (ou a primeira).
const asked = Astro.url.searchParams.get("tab");
const tab: RelationshipTab =
  available.find((id) => id === asked) ?? available.find((id) => (counts[id] ?? 0) > 0) ?? available[0];
const tabHref = (id: RelationshipTab) => `/admin/relacionamento?tab=${id}`;
const returnTo = tabHref(tab);

// A aba aberta usa a lista já lida para o contador.
let loadFailed = lists[tab] === null;
const awaiting: AgendaAppointment[] = lists.aguardando_remarcacao ?? [];
const reminders = lists.lembretes ?? [];
const waitlist = lists.lista_espera ?? [];
let offers: Awaited<ReturnType<typeof listRecentOffers>> = [];
if (tab === "lista_espera" && !loadFailed) {
  try {
    offers = await listRecentOffers(db, clinic.clinicId);
  } catch (error) {
    failed(tab, error);
    loadFailed = true;
  }
}
const [actors, serviceRefs] = await Promise.all([
  loadActorLabels(db, clinic.clinicId, tab === "aguardando_remarcacao" ? awaiting.map((a) => a.canceledBy) : []),
  listServiceRefs(db, clinic.clinicId),
]);
const tags = serviceTags(serviceRefs);

const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
const countOf = (id: RelationshipTab): Pick<TabItem, "count" | "countTone" | "alert" | "countLabel"> => {
  const n = counts[id];
  // Contagem que falhou: aviso, nunca 0 (seção 13.4 do plano).
  if (n === null || n === undefined) return { alert: true, countLabel: "Não foi possível contar" };
  if (id === "lista_espera") return { count: n, countTone: "info", countLabel: `${plural(n, "pessoa", "pessoas")} na lista` };
  if (id === "lembretes_equipe") return { count: n, countLabel: `${plural(n, "lembrete", "lembretes")} para hoje ou atrasado(s)` };
  if (id === "lembretes") return { count: n, countLabel: `${n} sem resposta ou não entregue(s)` };
  if (id === "atendimento") return { count: n, countTone: "alert", countLabel: `${n} aguardando a clínica` };
  // Retomar contato sem número (cliente, 31/out/2026): abandonar a conversa é normal.
  if (id === "retomar_contato") return {};
  if (id === "retorno") return { count: n, countLabel: `${n} com retorno a marcar` };
  if (id === "faltosos") return { count: n, countTone: "neutral", countLabel: `${n} faltam com frequência` };
  if (id === "revisar") return { count: n, countLabel: `${n} para revisar` };
  return { count: n, countLabel: `${n} aguardando` };
};
const tabs = RELATIONSHIP_TABS.filter((t) => available.includes(t.id)).map((t) => ({ label: t.label, href: tabHref(t.id), active: t.id === tab, ...countOf(t.id) }));
---
<AdminLayout title="Relacionamento">
  <PageHeader title="Relacionamento" />
  <HowItWorks id="relacionamento" topic={relacionamento.comoFunciona.central} class="mt-1">
    <p class="text-[15px] text-ink-soft sm:text-base">Pendências que pedem contato da equipe.</p>
  </HowItWorks>
  <Tabs label="Abas do Relacionamento" class="mt-4" tabs={tabs} />
  <FlashMessage />

  {loadFailed && (
    <div class="mt-4 max-w-4xl">
      <EmptyState variant="dashed" title="Não foi possível carregar esta lista" text="As outras abas continuam disponíveis. Tente abrir esta aba de novo daqui a pouco." />
    </div>
  )}
  {!loadFailed && tab === "atendimento" && <AtendimentoTab items={lists.atendimento ?? []} timeZone={clinic.timezone} now={now} />}
  {!loadFailed && tab === "retomar_contato" && <RetomarContatoTab groups={lists.retomar_contato ?? []} timeZone={clinic.timezone} vocabulary={vocabulary} />}
  {!loadFailed && tab === "retorno" && <RetornoTab opportunities={lists.retorno ?? []} timeZone={clinic.timezone} vocabulary={vocabulary} returnTo={returnTo} />}
  {!loadFailed && tab === "faltosos" && <FaltososTab patients={lists.faltosos ?? []} timeZone={clinic.timezone} vocabulary={vocabulary} />}
  {!loadFailed && tab === "revisar" && <RevisarTab contacts={lists.revisar ?? []} timeZone={clinic.timezone} returnTo={returnTo} />}
  {!loadFailed && tab === "aguardando_remarcacao" && (
    awaiting.length > 0
      ? <AguardandoTab tags={tags} appointments={awaiting} actors={actors} timeZone={clinic.timezone} vocabulary={vocabulary} returnTo={returnTo} />
      : <div class="mt-4 max-w-4xl"><EmptyState variant="dashed" title={relacionamento.vazios.aguardando.titulo} text={relacionamento.vazios.aguardando.texto} /></div>
  )}
  {!loadFailed && tab === "lembretes" && <LembretesPendentesTab tags={tags} reminders={reminders} timeZone={clinic.timezone} vocabulary={vocabulary} />}
  {!loadFailed && tab === "lembretes_equipe" && <LembretesEquipeTab reminders={lists.lembretes_equipe ?? []} today={todayIn(clinic.timezone, now)} vocabulary={vocabulary} returnTo={returnTo} />}
  {!loadFailed && tab === "lista_espera" && <ListaEsperaTab tags={tags} entries={waitlist} offers={offers} timeZone={clinic.timezone} returnTo={returnTo} />}
  <ConfirmDeleteDialog />
</AdminLayout>

---
// Financeiro › DMED (F11.6, cliente, 12/out/2026): escolher o ano, conferir o
// resumo (quem pagou, total) e os pagamentos que ficam de fora (sem CPF de
// quem pagou ou de paciente anonimizado), e baixar o arquivo para o contador
// importar no programa da Receita. Os responsáveis (preenchimento, perante o
// CNPJ) e o CNES ficam guardados. Só o Administrador da clínica gera; o
// Suporte vê o resumo.
//
// Redesign R8 (proposta aprovada pelo cliente em 17/out/2026): aba do
// Financeiro; o ano em botões; 4 indicadores; "Antes de baixar" (lista de
// conferência com o botão, que só habilita sem pendência que impeça); os
// responsáveis em modo leitura com "Editar" (aberto quando nada foi salvo);
// "Ficam de fora" e "Quem pagou" em tabelas. No celular, os cartões
// recolhidos e o botão de baixar na barra fixa.
import AdminLayout from "../../../layouts/AdminLayout.astro";
import FlashMessage from "../../../components/admin/FlashMessage.astro";
import Icon, { type IconName } from "../../../components/admin/Icon.astro";
import FinanceHeader from "../../../components/admin/financeiro/FinanceHeader.astro";
import Button from "../../../components/admin/ui/Button.astro";
import EditCard from "../../../components/admin/ui/EditCard.astro";
import Pill from "../../../components/admin/ui/Pill.astro";
import SegmentedControl from "../../../components/admin/ui/SegmentedControl.astro";
import Stat from "../../../components/admin/ui/Stat.astro";
import { CONTROL, TABLE } from "../../../components/admin/ui/styles";
import { formatCalendarDate, todayIn } from "../../../lib/clinicTime";
import { formatCnpj } from "../../../lib/cnpj";
import { formatCpf, maskCpf } from "../../../lib/cpf";
import { createUserClient } from "../../../lib/data/clients";
import { dmedYears, getDmedSettings, loadDmedYear } from "../../../lib/data/dmed";
import { getFiscalSettings } from "../../../lib/data/fiscal";
import { setFlash } from "../../../lib/flash";
import { formatCentsBRL } from "../../../lib/money";
import { currentPath, withReturn } from "../../../lib/returnPath";
import { capitalize, vocabularyFor } from "../../../lib/vocabulary";

const clinic = Astro.locals.clinic!;
const isClinicAdmin = clinic.roles.includes("admin");
if (!isClinicAdmin && !clinic.isPlatformStaff) {
  setFlash(Astro.cookies, { tone: "error", text: "A DMED é só do Administrador da clínica." });
  return Astro.redirect("/admin/financeiro");
}
const db = createUserClient(Astro.request, Astro.cookies);
const vocabulary = vocabularyFor(clinic.clinicProfile);
const currentYear = Number(todayIn(clinic.timezone).slice(0, 4));
const years = dmedYears(currentYear);
const wanted = Number(Astro.url.searchParams.get("ano"));
// Padrão: o ano passado (o da entrega até fevereiro).
const year = years.includes(wanted) ? wanted : currentYear - 1;
const [fiscal, settings, data] = await Promise.all([getFiscalSettings(db, clinic.clinicId), getDmedSettings(db, clinic.clinicId), loadDmedYear(db, clinic.clinicId, year)]);
const action = "/api/admin/financeiro/dmed";
const here = currentPath(Astro.url);
const beneficiaries = data.responsibles.reduce((sum, r) => sum + r.beneficiaries.length, 0);
const canGenerate = isClinicAdmin && fiscal !== null && settings !== null;
const cpfValue = (cpf: string | null | undefined) => (cpf ? formatCpf(cpf) : "");
const REASON = { no_cpf: "Falta o CPF de quem pagou", anonymized: "Paciente anonimizado" } as const;
const leftOut = data.leftOut.length;
// Total em reais inteiros no indicador (cabe no cartão); o valor exato embaixo.
const totalShort = formatCentsBRL(Math.round(data.totalCents / 100) * 100).replace(/,00$/, "");
const phoneText = (ddd: string, phone: string, extension: string | null) =>
  `(${ddd}) ${phone.length > 4 ? `${phone.slice(0, -4)}-${phone.slice(-4)}` : phone}${extension ? ` r. ${extension}` : ""}`;

// Nota fiscal volta para a DMED no mesmo ano (R9, S-01 do relatório da R8).
type Check = { state: "ok" | "warn" | "bad"; title: string; text?: string; href?: string; linkLabel?: string };
const checks: Check[] = [
  fiscal
    ? { state: "ok", title: "Dados fiscais da clínica", text: `${fiscal.legalName} · CNPJ ${formatCnpj(fiscal.cnpj)}` }
    : { state: "bad", title: "Faltam os dados fiscais da clínica", href: withReturn("/admin/configuracoes/nota-fiscal", `/admin/financeiro/dmed?ano=${year}`), linkLabel: "Configurações › Nota fiscal" },
  settings
    ? { state: "ok", title: "Responsáveis da declaração", text: "Salvos." }
    : { state: "bad", title: "Faltam os responsáveis da declaração", text: "Preencha e salve no cartão \"Responsáveis da declaração\"." },
  year < currentYear
    ? { state: "ok", title: "Ano encerrado", text: `${year} terminou: o arquivo sai completo.` }
    : { state: "warn", title: `${year} ainda não terminou`, text: "O arquivo fica parcial." },
  leftOut === 0
    ? { state: "ok", title: "Nenhum pagamento fica de fora" }
    : {
        state: "warn",
        title: `${leftOut} ${leftOut === 1 ? "pagamento fica" : "pagamentos ficam"} de fora`,
        text: "Não impede o arquivo.",
        href: "#fora",
        linkLabel: leftOut === 1 ? "Ver qual" : "Ver quais",
      },
];
const CHECK_STYLE: Record<Check["state"], { box: string; icon: IconName; label: string }> = {
  ok: { box: "bg-conf-100 text-conf-800", icon: "check", label: "Em ordem" },
  warn: { box: "bg-pend-100 text-pend-800", icon: "warning", label: "Atenção" },
  bad: { box: "bg-can-100 text-can-800", icon: "x-mark", label: "Falta" },
};
const field = "flex flex-col gap-1.5";
const fieldLabel = "text-[14.5px] font-semibold text-ink";
const hint = "text-sm text-ink-soft";
const kv = "grid grid-cols-[minmax(120px,190px)_minmax(0,1fr)] gap-x-3 gap-y-2 text-[15px]";
const downloadLabel = `Baixar o arquivo da DMED de ${year}`;
---

<AdminLayout title="DMED">
  <FinanceHeader active="dmed" />
  <FlashMessage />

  <div class="mt-5 flex flex-wrap items-end justify-between gap-x-6 gap-y-4">
    <div class="max-w-2xl min-w-0">
      <h2 class="font-display text-2xl leading-tight font-bold text-ink">DMED de {year}</h2>
      <p class="mt-1.5 text-[15px] text-ink-soft">
        Declaração que a clínica entrega à Receita até o fim de fevereiro, com o que cada pessoa pagou no ano. Baixe o arquivo e envie ao contador: ele importa
        no programa da Receita (PGD Dmed), que confere tudo antes de transmitir.
      </p>
      {
        fiscal && (
          <p class="mt-2 text-[14.5px] text-ink">
            Declarante: <strong>{fiscal.legalName}</strong> · CNPJ {formatCnpj(fiscal.cnpj)}
          </p>
        )
      }
    </div>
    <div class="flex flex-col gap-1.5 max-sm:w-full">
      <span class="text-[13.5px] font-semibold text-ink-soft" aria-hidden="true">Ano dos pagamentos</span>
      <SegmentedControl label="Ano dos pagamentos" current={String(year)} items={years.map((y) => ({ id: String(y), label: String(y), href: `/admin/financeiro/dmed?ano=${y}` }))} />
    </div>
  </div>

  <div class="mt-4 grid grid-cols-2 gap-2.5 lg:grid-cols-4 lg:gap-3">
    <Stat label="Quem pagou" value={data.responsibles.length} hint={data.responsibles.length === 1 ? "pessoa com CPF" : "pessoas com CPF"} />
    <Stat label="Beneficiários" value={beneficiaries} hint="quem recebeu o atendimento" />
    <Stat label="Total" value={totalShort} hint={`${formatCentsBRL(data.totalCents)} no arquivo`} />
    {
      leftOut > 0 ? (
        <Stat label="Ficam de fora" value={leftOut} hint={leftOut === 1 ? "pagamento sem CPF" : "pagamentos sem CPF"} attention href="#fora" />
      ) : (
        <Stat label="Ficam de fora" value={0} hint="nenhum pagamento" />
      )
    }
  </div>

  <div class="mt-4 grid items-start gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)]">
    <section aria-labelledby="antes-titulo" class="flex flex-col rounded-xl border border-line bg-white px-3.5 pt-3.5 pb-4 lg:px-5 lg:pt-[18px]">
      <h2 id="antes-titulo" class="mb-1.5 font-display text-[17px] leading-tight font-bold text-ink sm:text-lg">Antes de baixar</h2>
      <ul>
        {
          checks.map((c) => (
            <li class="grid grid-cols-[28px_minmax(0,1fr)] items-start gap-2.5 border-t border-[#e6ecea] py-2.5">
              <span class={`flex h-7 w-7 items-center justify-center rounded-full ${CHECK_STYLE[c.state].box}`}>
                <Icon name={CHECK_STYLE[c.state].icon} class="h-4 w-4" strokeWidth={2.6} />
                <span class="sr-only">{CHECK_STYLE[c.state].label}:</span>
              </span>
              <div class="min-w-0">
                <p class="text-[15.5px] leading-snug font-semibold text-ink">{c.title}</p>
                {(c.text || c.href) && (
                  <p class="mt-0.5 text-sm text-ink-soft">
                    {c.text}
                    {c.href && (
                      <>
                        {c.text ? " " : ""}
                        <a href={c.href} class="font-bold text-brand no-underline hover:underline">
                          {c.linkLabel} ›
                        </a>
                      </>
                    )}
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ul>
      <div class="flex flex-col gap-2 border-t border-[#e6ecea] pt-3.5">
        {
          isClinicAdmin ? (
            <>
              <form method="POST" action={action} data-envio-livre class="max-sm:hidden">
                <input type="hidden" name="acao" value="gerar" />
                <input type="hidden" name="ano" value={year} />
                <Button type="submit" variant="primary" class="h-12 text-base sm:h-12" disabled={!canGenerate}>
                  <Icon name="arrow-down-tray" class="h-[18px] w-[18px]" strokeWidth={2.2} /> {downloadLabel}
                </Button>
              </form>
              <p class={hint}>{canGenerate ? "Um arquivo .txt para o contador importar no PGD Dmed." : "Resolva os itens em vermelho para baixar."}</p>
            </>
          ) : (
            <p class={hint}>Só o Administrador da clínica baixa o arquivo.</p>
          )
        }
      </div>
    </section>

    <EditCard id="responsaveis" title="Responsáveis da declaração" summary={settings ? settings.fillerName : "Falta preencher"} editable={isClinicAdmin} editOpen={isClinicAdmin && !settings}>
      <p class={hint}>Ficam guardados para o ano que vem.</p>
      {
        settings ? (
          <dl class={kv}>
            <dt class="text-ink-soft">Preenchimento</dt>
            <dd class="font-semibold text-ink">
              {settings.fillerName}
              <span class="block font-normal text-ink-soft tabular-nums">
                CPF {maskCpf(settings.fillerCpf)} · {phoneText(settings.fillerDdd, settings.fillerPhone, settings.fillerExtension)}
              </span>
              {settings.fillerEmail && <span class="block font-normal break-all text-ink-soft">{settings.fillerEmail}</span>}
            </dd>
            <dt class="text-ink-soft">Responsável perante o CNPJ</dt>
            <dd class="font-semibold text-ink tabular-nums">CPF {maskCpf(settings.legalResponsibleCpf)}</dd>
            <dt class="text-ink-soft">CNES</dt>
            <dd class={settings.cnes ? "font-semibold text-ink" : "text-ink-soft"}>{settings.cnes ?? "não informado (opcional)"}</dd>
          </dl>
        ) : (
          <p class="text-[15px] text-ink-soft">Nada salvo ainda.</p>
        )
      }
      <form slot="edit" method="POST" action={action} class="flex flex-col gap-4">
        <input type="hidden" name="acao" value="salvar" />
        <input type="hidden" name="ano" value={year} />
        <fieldset class="flex flex-col gap-3">
          <legend class="mb-1 text-[15px] font-semibold text-ink">Responsável pelo preenchimento (em geral, o contador)</legend>
          <div class="grid gap-3 sm:grid-cols-2">
            <div class={field}>
              <label for="filler_name" class={fieldLabel}>Nome</label>
              <input id="filler_name" name="filler_name" required value={settings?.fillerName ?? ""} class={CONTROL} />
            </div>
            <div class={field}>
              <label for="filler_cpf" class={fieldLabel}>CPF</label>
              <input id="filler_cpf" name="filler_cpf" required inputmode="numeric" placeholder="000.000.000-00" value={cpfValue(settings?.fillerCpf)} class={CONTROL} />
            </div>
          </div>
          <div class="grid grid-cols-[5rem_minmax(0,1fr)_6rem] gap-3">
            <div class={field}>
              <label for="filler_ddd" class={fieldLabel}>DDD</label>
              <input id="filler_ddd" name="filler_ddd" required inputmode="numeric" maxlength="2" value={settings?.fillerDdd ?? ""} class={CONTROL} />
            </div>
            <div class={field}>
              <label for="filler_phone" class={fieldLabel}>Telefone</label>
              <input id="filler_phone" name="filler_phone" required inputmode="numeric" value={settings?.fillerPhone ?? ""} class={CONTROL} />
            </div>
            <div class={field}>
              <label for="filler_extension" class={fieldLabel}>Ramal</label>
              <input id="filler_extension" name="filler_extension" inputmode="numeric" value={settings?.fillerExtension ?? ""} class={CONTROL} />
            </div>
          </div>
          <div class={field}>
            <label for="filler_email" class={fieldLabel}>E-mail <span class="font-normal text-ink-soft">(opcional)</span></label>
            <input id="filler_email" name="filler_email" type="email" value={settings?.fillerEmail ?? ""} class={CONTROL} />
          </div>
        </fieldset>
        <div class={`${field} border-t border-[#e6ecea] pt-3`}>
          <label for="legal_responsible_cpf" class={fieldLabel}>CPF do responsável perante o CNPJ</label>
          <input
            id="legal_responsible_cpf"
            name="legal_responsible_cpf"
            required
            inputmode="numeric"
            placeholder="000.000.000-00"
            aria-describedby="legal-hint"
            value={cpfValue(settings?.legalResponsibleCpf)}
            class={`${CONTROL} sm:w-56`}
          />
          <p id="legal-hint" class={hint}>O sócio ou administrador que responde pela clínica na Receita.</p>
        </div>
        <div class={field}>
          <label for="cnes" class={fieldLabel}>CNES <span class="font-normal text-ink-soft">(opcional)</span></label>
          <input id="cnes" name="cnes" inputmode="numeric" maxlength="7" value={settings?.cnes ?? ""} class={`${CONTROL} sm:w-40`} />
        </div>
        <div class="flex gap-2">
          <Button type="submit" variant="primary" data-sending-label="Salvando…">Salvar</Button>
          {settings && <Button href={here} data-edit-cancel>Cancelar</Button>}
        </div>
      </form>
    </EditCard>
  </div>

  {
    leftOut > 0 && (
      <EditCard id="fora" title={`Ficam de fora (${leftOut})`} summary="Confira" editable={false} class="mt-4">
        <p class={hint}>Sem o CPF de quem pagou, o pagamento não entra na DMED. Para incluir, abra o pagamento, exclua e registre de novo com o CPF.</p>
        <div data-scroll-region="Pagamentos que ficam de fora" class="-mx-3.5 overflow-x-auto border-t border-line lg:-mx-5">
          <table class={TABLE.table}>
            <thead>
              <tr>
                <th scope="col" class={TABLE.th}>Pago em</th>
                <th scope="col" class={`${TABLE.th} text-right`}>Valor</th>
                <th scope="col" class={TABLE.th}>Quem pagou</th>
                <th scope="col" class={TABLE.th}>{capitalize(vocabulary.patient)}</th>
                <th scope="col" class={TABLE.th}>Motivo</th>
                <th scope="col" class={TABLE.th}><span class="sr-only">Ação</span></th>
              </tr>
            </thead>
            <tbody class="[&>tr:last-child>td]:border-b-0">
              {data.leftOut.map((p) => (
                <tr>
                  <td class={`${TABLE.td} whitespace-nowrap tabular-nums`}>{formatCalendarDate(p.paidOn, "dd/MM/yyyy")}</td>
                  <td class={`${TABLE.td} ${TABLE.num}`}>{formatCentsBRL(p.amountCents)}</td>
                  <td class={TABLE.td}>{p.payerName}</td>
                  <td class={TABLE.td}>{p.patientName}</td>
                  <td class={TABLE.td}>
                    <Pill tone="warning" icon="warning">
                      {REASON[p.reason]}
                    </Pill>
                  </td>
                  <td class={`${TABLE.td} text-right`}>
                    <Button href={withReturn(`/admin/financeiro/pagamento/${p.appointmentId}`, here)} size="sm">
                      Abrir o pagamento
                    </Button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </EditCard>
    )
  }

  <EditCard id="quem-pagou" title={`Quem pagou em ${year}`} summary={`${data.responsibles.length} · ${formatCentsBRL(data.totalCents)}`} editable={false} class="mt-4 overflow-hidden">
    {
      data.responsibles.length === 0 ? (
        <p class="text-[15px] text-ink-soft">Nenhum pagamento com CPF em {year}.</p>
      ) : (
        <div data-scroll-region={`Quem pagou em ${year}`} class="-mx-3.5 -mb-3.5 overflow-x-auto border-t border-line lg:-mx-5 lg:-mb-[18px]">
          <table class={TABLE.table}>
            <thead>
              <tr>
                <th scope="col" class={TABLE.th}>Quem pagou</th>
                <th scope="col" class={TABLE.th}>CPF</th>
                <th scope="col" class={TABLE.th}>Para quem</th>
                <th scope="col" class={`${TABLE.th} text-right`}>Total</th>
              </tr>
            </thead>
            <tbody class="[&>tr:last-child>td]:border-b-0">
              {data.responsibles.map((r) => (
                <tr>
                  <td class={`${TABLE.td} font-semibold`}>{r.name}</td>
                  <td class={`${TABLE.td} whitespace-nowrap tabular-nums`}>{maskCpf(r.cpf)}</td>
                  <td class={`${TABLE.td} min-w-[220px]`}>
                    {[
                      r.ownCents > 0 ? `Próprio: ${formatCentsBRL(r.ownCents)}` : "",
                      ...r.beneficiaries.map((b) => `${b.name}: ${formatCentsBRL(b.cents)}${b.cpf ? "" : " (sem CPF, vai a data de nascimento)"}`),
                    ]
                      .filter(Boolean)
                      .join(" · ")}
                  </td>
                  <td class={`${TABLE.td} ${TABLE.num}`}>{formatCentsBRL(r.ownCents + r.beneficiaries.reduce((sum, b) => sum + b.cents, 0))}</td>
                </tr>
              ))}
              <tr class={TABLE.total}>
                <td colspan="3" class={TABLE.td}>
                  Total ({data.responsibles.length} {data.responsibles.length === 1 ? "pessoa" : "pessoas"})
                </td>
                <td class={`${TABLE.td} ${TABLE.num}`}>{formatCentsBRL(data.totalCents)}</td>
              </tr>
            </tbody>
          </table>
        </div>
      )
    }
  </EditCard>

  {
    isClinicAdmin && (
      <>
        <div class="h-20 sm:hidden" aria-hidden="true" />
        <form
          method="POST"
          action={action}
          data-envio-livre
          class="fixed inset-x-0 bottom-[calc(61px+env(safe-area-inset-bottom))] z-10 flex border-t border-line bg-white px-4 py-2.5 shadow-[0_-4px_14px_rgba(18,48,42,.08)] sm:hidden"
        >
          <input type="hidden" name="acao" value="gerar" />
          <input type="hidden" name="ano" value={year} />
          <Button type="submit" variant="primary" class="h-12 w-full text-base" disabled={!canGenerate}>
            <Icon name="arrow-down-tray" class="h-[18px] w-[18px]" strokeWidth={2.2} /> Baixar a DMED de {year}
          </Button>
        </form>
      </>
    )
  }
</AdminLayout>

<script>
  // "Ver ›" e "Ver quais ›" levam a um cartão que, no celular, pode estar
  // recolhido: abre antes de rolar até ele.
  document.addEventListener("click", (event) => {
    const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
    const target = link ? document.querySelector<HTMLDetailsElement>(`details${link.getAttribute("href")}`) : null;
    if (target) target.open = true;
  });
</script>

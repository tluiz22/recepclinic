---
// Financeiro › Pagamento do atendimento (F11.2, cliente, 12/out/2026): aberto
// pelo botão "Pagamento" da Agenda (ou pelo cartão Financeiro do paciente).
// Mostra o preço, o que já foi pago e o que falta, os pagamentos (os
// excluídos também, riscados) e o formulário: valor (sugerido o que falta),
// forma, data e quem pagou (o responsável financeiro já marcado, trocável só
// neste pagamento). A confirmação fica no botão final, com o aviso "acima do
// preço". Só o Administrador e a Recepção gravam; o Suporte só vê.
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import Badge, { type BadgeVariant } from "../../../../components/admin/Badge.astro";
import Card from "../../../../components/admin/Card.astro";
import ConfirmDeleteDialog from "../../../../components/admin/ConfirmDeleteDialog.astro";
import FlashMessage from "../../../../components/admin/FlashMessage.astro";
import Icon from "../../../../components/admin/Icon.astro";
import { HINT, INPUT, LABEL, PRIMARY_BUTTON } from "../../../../components/admin/fieldStyles";
import { isUuid } from "../../../../lib/clinicAccess";
import { formatCalendarDate, formatInstant, localDateOf, todayIn } from "../../../../lib/clinicTime";
import { formatCpf, maskCpf } from "../../../../lib/cpf";
import { getAgendaAppointment } from "../../../../lib/data/agenda/view";
import { createUserClient } from "../../../../lib/data/clients";
import { effectivePayer, getContactCpf, getPatientFinance } from "../../../../lib/data/finance";
import { getContact, getPatient } from "../../../../lib/data/patients";
import {
  canReceivePayment,
  getAppointmentPrice,
  listAppointmentPayments,
  PAYMENT_METHOD_LABEL,
  PAYMENT_METHODS,
  summarizePayments,
} from "../../../../lib/data/payments";
import { centsToInput } from "../../../../lib/forms";
import { ACTIVE_INVOICE, CANCEL_REASONS, listPaymentInvoices, nfseReadiness, type Invoice, type InvoiceStatus } from "../../../../lib/data/nfse";
import { getSavedDestinations, listInvoiceDeliveries } from "../../../../lib/data/nfseDelivery";
import { formatPhoneBR } from "../../../../lib/phone";
import { formatCentsBRL } from "../../../../lib/money";
import { receivedReturn, withReturn } from "../../../../lib/returnPath";
import { capitalize, vocabularyFor } from "../../../../lib/vocabulary";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const vocabulary = vocabularyFor(clinic.clinicProfile);
const id = Astro.params.id!;
const appointment = isUuid(id) ? await getAgendaAppointment(db, clinic.clinicId, id).catch(() => null) : null;
if (!appointment) return Astro.redirect("/admin/agenda");

const volta = receivedReturn(Astro.url);
const back = volta ?? `/admin/agenda?date=${localDateOf(appointment.scheduledAt, clinic.timezone)}`;
const [patient, price, payments] = await Promise.all([
  getPatient(db, clinic.clinicId, appointment.patientId),
  getAppointmentPrice(db, clinic.clinicId, appointment.id),
  listAppointmentPayments(db, clinic.clinicId, appointment.id),
]);
const [contact, finance, contactCpf] = await Promise.all([
  getContact(db, clinic.clinicId, patient.contactId),
  getPatientFinance(db, clinic.clinicId, patient.id),
  getContactCpf(db, clinic.clinicId, patient.contactId),
]);
const summary = summarizePayments(price, payments);
// Nota fiscal (F11.4): a situação de cada pagamento e se a clínica já emite.
const [invoices, financeReady] = await Promise.all([
  listPaymentInvoices(db, clinic.clinicId, payments.map((p) => p.id)),
  nfseReadiness(db, clinic.clinicId),
]);
// Envio da nota (F11.5): os envios de cada nota e os destinos guardados no Financeiro.
const allInvoiceIds = [...invoices.values()].flat().map((n) => n.id);
const [deliveries, saved] = await Promise.all([
  listInvoiceDeliveries(db, clinic.clinicId, allInvoiceIds),
  getSavedDestinations(db, clinic.clinicId, patient.id),
]);
const DELIVERY_STATUS = { sent: "enviado", delivered: "entregue", read: "lido", failed: "não saiu" } as const;
const activeInvoice = (paymentId: string) => (invoices.get(paymentId) ?? []).find((n) => ACTIVE_INVOICE.includes(n.status));
const isClinicAdmin = clinic.roles.includes("admin");
const INVOICE_BADGE: Record<InvoiceStatus, { variant: BadgeVariant; label: (n: Invoice) => string }> = {
  issuing: { variant: "warning", label: () => "Emitindo…" },
  issued: { variant: "success", label: (n) => (n.nfseNumber ? `Nota nº ${n.nfseNumber}` : "Nota emitida") },
  // Certificado que não abre ou DPS que a Receita não recebeu: não chegou a ser recusada.
  rejected: { variant: "danger", label: (n) => (n.errorCode === "CERTIFICADO" || n.errorCode === "SEM-NOTA" ? "Não emitida" : "Recusada pela Receita") },
  canceling: { variant: "warning", label: () => "Cancelando…" },
  canceled: { variant: "neutral", label: (n) => (n.nfseNumber ? `Nota nº ${n.nfseNumber} cancelada` : "Nota cancelada") },
};
const today = todayIn(clinic.timezone);
const canEdit = clinic.roles.includes("admin") || clinic.roles.includes("reception");
const receives = canReceivePayment(appointment.status) && !patient.anonymizedAt;
const defaultPayer = effectivePayer(patient, finance.payer);
const suggested = summary.remainingCents !== null && summary.remainingCents > 0 ? summary.remainingCents : null;
const action = withReturn(`/api/admin/financeiro/pagamentos/${appointment.id}`, volta);
const when = formatInstant(appointment.scheduledAt, clinic.timezone, "EEE dd/MM/yyyy 'às' HH:mm");

const statusBadge: Record<string, { label: string; variant: BadgeVariant }> = {
  scheduled: { label: "Marcado", variant: "info" },
  confirmed: { label: "Marcado", variant: "info" },
  completed: { label: "Compareceu", variant: "success" },
  canceled: { label: "Cancelado", variant: "danger" },
  no_show: { label: "Faltou", variant: "danger" },
};
const status = statusBadge[appointment.status];

// Quem pagou: o contato (ou o próprio paciente, quando ele fala por si), o
// paciente e outra pessoa; o CPF do cadastro aparece, e o que falta é pedido.
const payerOptions = [
  {
    value: "contact",
    label: patient.isContactSelf ? patient.fullName : `${contact.fullName} (${vocabulary.contact})`,
    cpf: contactCpf,
  },
  ...(patient.isContactSelf ? [] : [{ value: "patient", label: patient.fullName, cpf: finance.cpf }]),
] as { value: "contact" | "patient"; label: string; cpf: string | null }[];
const otherDefault = defaultPayer === "other" ? { name: finance.payerName ?? "", cpf: finance.payerCpf } : { name: "", cpf: null };
---

<AdminLayout title="Pagamento">
  <a href={back} class="inline-flex items-center gap-1 text-sm font-medium text-sky-700 hover:underline">
    <Icon name="chevron-left" class="h-4 w-4" /> Voltar
  </a>
  <h1 class="mt-3 text-2xl font-bold text-slate-900">Pagamento</h1>
  <FlashMessage />

  <Card class="mt-4 max-w-2xl">
    <p class="flex flex-wrap items-center gap-2 font-medium text-slate-900">
      {appointment.patientName}
      {status && <Badge variant={status.variant}>{status.label}</Badge>}
    </p>
    <p class="text-sm text-slate-600">{appointment.serviceName} · {appointment.agendaName} · {when}</p>
    <dl class="mt-3 grid grid-cols-3 gap-3 text-sm">
      <div>
        <dt class="text-slate-500">Preço</dt>
        <dd class="font-semibold text-slate-900">{summary.priceCents === null ? "Sem preço" : formatCentsBRL(summary.priceCents)}</dd>
      </div>
      <div>
        <dt class="text-slate-500">Pago</dt>
        <dd class="font-semibold text-slate-900">{formatCentsBRL(summary.paidCents)}</dd>
      </div>
      <div>
        <dt class="text-slate-500">{summary.overPrice ? "Acima do preço" : "Falta"}</dt>
        <dd class={`font-semibold ${summary.overPrice ? "text-amber-700" : "text-slate-900"}`}>
          {summary.overPrice ? formatCentsBRL(summary.paidCents - summary.priceCents!) : summary.remainingCents === null ? "—" : formatCentsBRL(summary.remainingCents)}
        </dd>
      </div>
    </dl>
  </Card>

  <Card class="mt-4 max-w-2xl">
    <h2 class="font-semibold text-slate-900">Pagamentos ({payments.filter((p) => !p.deletedAt).length})</h2>
    <ul class="mt-2 divide-y divide-slate-100">
      {
        payments.map((p) => (
          <li class="py-2 text-sm">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class={p.deletedAt ? "text-slate-400 line-through" : ""}>
                <span class="font-medium text-slate-900">{formatCentsBRL(p.amountCents)}</span> · {PAYMENT_METHOD_LABEL[p.method]} · {formatCalendarDate(p.paidOn, "dd/MM/yyyy")}
                <span class="block text-slate-500">
                  Pagou: {p.payerName}
                  {p.payerCpf ? ` · CPF ${maskCpf(p.payerCpf)}` : ""}
                </span>
              </span>
              <span class="flex items-center gap-2">
                {p.deletedAt ? (
                  <Badge>excluído em {formatInstant(p.deletedAt, clinic.timezone, "dd/MM 'às' HH:mm")}</Badge>
                ) : (
                  <>
                    {!p.payerCpf && <Badge variant="warning">falta CPF</Badge>}
                    {canEdit && !activeInvoice(p.id) && (
                      <form method="POST" action={action}>
                        <input type="hidden" name="acao" value="excluir" />
                        <input type="hidden" name="payment_id" value={p.id} />
                        <button
                          type="submit"
                          class="js-confirm-delete text-xs font-medium text-red-700 hover:underline"
                          data-confirm-title="Excluir o pagamento?"
                          data-confirm-message={`${formatCentsBRL(p.amountCents)} (${PAYMENT_METHOD_LABEL[p.method]}), de ${p.payerName}. Sai das somas e fica guardado como excluído; registre de novo o certo.`}
                          data-confirm-label="Excluir pagamento"
                        >
                          Excluir
                        </button>
                      </form>
                    )}
                  </>
                )}
              </span>
            </div>
            {
              !p.deletedAt && (
                <div class="mt-2 rounded-md bg-slate-50 px-3 py-2">
                  {(invoices.get(p.id) ?? []).map((n) => (
                    <div class="flex flex-wrap items-center gap-2 py-0.5">
                      <Badge variant={INVOICE_BADGE[n.status].variant}>{INVOICE_BADGE[n.status].label(n)}</Badge>
                      {n.environment === "restricted" && <Badge>teste</Badge>}
                      <span class="text-xs text-slate-500">pedida em {formatInstant(n.requestedAt, clinic.timezone, "dd/MM 'às' HH:mm")}</span>
                      {n.hasXml && (
                        <>
                          <a href={`/api/admin/financeiro/notas/${n.id}?formato=pdf`} target="_blank" rel="noopener" class="text-xs font-medium text-sky-700 hover:underline">
                            Baixar PDF
                          </a>
                          <a href={`/api/admin/financeiro/notas/${n.id}`} class="text-xs font-medium text-sky-700 hover:underline">
                            Baixar XML
                          </a>
                        </>
                      )}
                      {canEdit && (n.status === "issuing" || n.status === "canceling") && (
                        <form method="POST" action={action}>
                          <input type="hidden" name="acao" value="conferir_nota" />
                          <input type="hidden" name="invoice_id" value={n.id} />
                          <input type="hidden" name="payment_id" value={p.id} />
                          <button type="submit" class="text-xs font-medium text-sky-700 hover:underline">
                            Conferir na Receita
                          </button>
                        </form>
                      )}
                      {n.errorMessage && n.status !== "canceled" && <p class="w-full text-xs text-red-700">{n.errorMessage}</p>}
                      {(deliveries.get(n.id) ?? []).map((e) => (
                        <p class="w-full text-xs text-slate-600">
                          {e.channel === "email" ? "E-mail" : "WhatsApp"} {e.channel === "whatsapp" && e.destination.startsWith("+") ? formatPhoneBR(e.destination) : e.destination}
                          {e.target === "contact" ? " (contato)" : ""}: <span class={e.status === "failed" ? "text-red-700" : ""}>{DELIVERY_STATUS[e.status]}</span>
                          {e.error ? ` (${e.error})` : ""} · {formatInstant(e.createdAt, clinic.timezone, "dd/MM 'às' HH:mm")}
                          {e.automatic ? " · automático" : ""}
                        </p>
                      ))}
                      {canEdit && n.status === "issued" && n.hasXml && (
                        <details class="w-full">
                          <summary class="cursor-pointer text-xs font-medium text-sky-700">Enviar nota</summary>
                          <form method="POST" action={action} class="mt-2 flex flex-col gap-2 text-xs text-slate-700">
                            <input type="hidden" name="acao" value="enviar_nota" />
                            <input type="hidden" name="invoice_id" value={n.id} />
                            <label class="flex items-center gap-2">
                              <input type="checkbox" name="para_contato" value="1" checked class="h-4 w-4" />
                              WhatsApp do {vocabulary.contact}: {contact.fullName} · {formatPhoneBR(contact.phone)}
                            </label>
                            <label class="flex flex-wrap items-center gap-2">
                              <input type="checkbox" name="para_numero" value="1" checked={!!saved.phone} class="h-4 w-4" />
                              Outro WhatsApp
                              <input name="numero" inputmode="tel" placeholder="(84) 98888-0000" value={saved.phone ? formatPhoneBR(saved.phone) : ""} class={`${INPUT} mt-0 w-44 text-xs`} />
                            </label>
                            <label class="flex flex-wrap items-center gap-2">
                              <input type="checkbox" name="para_email" value="1" checked={!!saved.email} class="h-4 w-4" />
                              E-mail
                              <input name="email" type="email" placeholder="nome@exemplo.com" value={saved.email ?? ""} class={`${INPUT} mt-0 w-60 text-xs`} />
                            </label>
                            <label class="flex items-center gap-2">
                              <input type="checkbox" name="guardar" value="1" checked class="h-4 w-4" />
                              Guardar o número e o e-mail no Financeiro do {vocabulary.patient}
                            </label>
                            <label class="flex items-center gap-2">
                              <input type="checkbox" name="enviar_sempre" value="1" checked={saved.autoSend} class="h-4 w-4" />
                              Enviar sempre para eles, junto com o {vocabulary.contact}
                            </label>
                            <button
                              type="submit"
                              class="js-confirm-delete self-start text-xs font-medium text-sky-700 hover:underline"
                              data-confirm-title="Enviar a nota fiscal?"
                              data-confirm-message={`Nota nº ${n.nfseNumber} (PDF${" e XML no e-mail"}) para os destinos marcados.${n.environment === "restricted" ? " Nota de teste, sem valor fiscal." : ""}`}
                              data-confirm-label="Enviar nota"
                              data-confirm-tone="primary"
                            >
                              Enviar
                            </button>
                          </form>
                        </details>
                      )}
                      {isClinicAdmin && n.status === "issued" && (
                        <details class="w-full">
                          <summary class="cursor-pointer text-xs font-medium text-red-700">Cancelar nota</summary>
                          <form method="POST" action={action} class="mt-2 flex flex-col gap-2">
                            <input type="hidden" name="acao" value="cancelar_nota" />
                            <input type="hidden" name="invoice_id" value={n.id} />
                            <select name="motivo" required class={`${INPUT} mt-0 text-xs`}>
                              {CANCEL_REASONS.map((r) => (
                                <option value={r.code}>{r.label}</option>
                              ))}
                            </select>
                            <input name="motivo_texto" required minlength="15" maxlength="255" placeholder="Explique (15 a 255 caracteres)" class={`${INPUT} mt-0 text-xs`} />
                            <button
                              type="submit"
                              class="js-confirm-delete self-start text-xs font-medium text-red-700 hover:underline"
                              data-confirm-title="Cancelar a nota fiscal?"
                              data-confirm-message={`Nota ${n.nfseNumber ? `nº ${n.nfseNumber}` : ""} de ${formatCentsBRL(p.amountCents)}, de ${p.payerName}. O cancelamento vai para a Receita e não dá para desfazer; depois, dá para emitir de novo.`}
                              data-confirm-label="Cancelar nota"
                            >
                              Cancelar nota
                            </button>
                          </form>
                        </details>
                      )}
                    </div>
                  ))}
                  {!activeInvoice(p.id) && (
                    <div class="flex flex-wrap items-center gap-2 py-0.5">
                      {(invoices.get(p.id) ?? []).length === 0 && <span class="text-xs text-slate-500">Sem nota fiscal.</span>}
                      {canEdit && p.payerCpf && financeReady.ready && (
                        <form method="POST" action={action}>
                          <input type="hidden" name="acao" value="emitir_nota" />
                          <input type="hidden" name="payment_id" value={p.id} />
                          <button
                            type="submit"
                            class="js-confirm-delete text-xs font-medium text-sky-700 hover:underline"
                            data-confirm-title="Emitir a nota fiscal?"
                            data-confirm-message={`${formatCentsBRL(p.amountCents)}, no CPF de ${p.payerName}. ${financeReady.environment === "restricted" ? "Ambiente de testes (sem valor fiscal)." : "A nota vai para a Receita."}`}
                            data-confirm-label="Emitir nota"
                            data-confirm-tone="primary"
                          >
                            Emitir nota
                          </button>
                        </form>
                      )}
                      {canEdit && !p.payerCpf && <span class="text-xs text-slate-500">Sem o CPF de quem pagou, a nota não sai.</span>}
                      {canEdit && p.payerCpf && !financeReady.ready && <span class="text-xs text-slate-500">{financeReady.reason}</span>}
                    </div>
                  )}
                </div>
              )
            }
          </li>
        ))
      }
      {payments.length === 0 && <li class="py-2 text-sm text-slate-500">Nenhum pagamento ainda.</li>}
    </ul>
  </Card>

  {
    !receives && (
      <p class="mt-4 max-w-2xl text-sm text-slate-600">
        {patient.anonymizedAt ? "Cadastro anonimizado: não recebe pagamento novo." : "Atendimento cancelado ou com falta: não recebe pagamento novo."}
      </p>
    )
  }
  {receives && !canEdit && <p class="mt-4 max-w-2xl text-sm text-slate-600">Só a Recepção e o Administrador da clínica registram pagamentos.</p>}

  {
    receives && canEdit && (
      <Card class="mt-4 max-w-2xl">
        <h2 class="font-semibold text-slate-900">Registrar pagamento</h2>
        <form method="POST" action={action} class="mt-3 flex flex-col gap-4" id="pagamento" data-patient={appointment.patientName} data-remaining={summary.remainingCents ?? ""}>
          <input type="hidden" name="acao" value="registrar" />
          <div class="grid gap-3 sm:grid-cols-2">
            <div>
              <label for="amount" class={LABEL}>Valor (R$)</label>
              <input id="amount" name="amount" required inputmode="decimal" placeholder="0,00" value={centsToInput(suggested)} class={INPUT} />
              <p class={HINT}>{suggested !== null ? "Sugerido: o que falta." : summary.priceCents === null ? "Atendimento sem preço." : "Já pago por inteiro."}</p>
            </div>
            <div>
              <label for="paid_on" class={LABEL}>Data do pagamento</label>
              <input id="paid_on" name="paid_on" type="date" required max={today} value={today} class={INPUT} />
            </div>
          </div>
          <fieldset>
            <legend class={LABEL}>Forma</legend>
            <div class="mt-1 flex flex-wrap gap-2">
              {PAYMENT_METHODS.map((m, i) => (
                <label class="cursor-pointer rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 shadow-sm has-[:checked]:border-sky-700 has-[:checked]:bg-sky-50">
                  <input type="radio" name="method" value={m.value} required checked={i === 0} class="mr-1" />
                  {m.label}
                </label>
              ))}
            </div>
          </fieldset>
          <fieldset>
            <legend class={LABEL}>Quem pagou (a nota sai no CPF dele)</legend>
            <div class="mt-1 flex flex-col gap-1 text-sm">
              {payerOptions.map((o) => (
                <label class="flex items-center gap-2">
                  <input type="radio" name="payer" value={o.value} checked={defaultPayer === o.value} class="h-4 w-4" />
                  {o.label}
                  {defaultPayer === o.value && <span class="text-xs text-slate-500">(responsável financeiro)</span>}
                </label>
              ))}
              <label class="flex items-center gap-2">
                <input type="radio" name="payer" value="other" checked={defaultPayer === "other"} class="h-4 w-4" />
                Outra pessoa
                {defaultPayer === "other" && <span class="text-xs text-slate-500">(responsável financeiro)</span>}
              </label>
            </div>
          </fieldset>
          {payerOptions.map((o) => (
            <div data-payer-only={o.value}>
              {o.cpf ? (
                <p class="text-sm text-slate-700">CPF de {o.label}: {formatCpf(o.cpf)}</p>
              ) : (
                <>
                  <label for={`payer_cpf_${o.value}`} class={LABEL}>
                    CPF de {o.label} (opcional)
                  </label>
                  <input id={`payer_cpf_${o.value}`} name="payer_cpf" inputmode="numeric" placeholder="000.000.000-00" class={`${INPUT} w-48`} />
                  <p class={HINT}>Sem o CPF, o pagamento é registrado, mas a nota fiscal não sai. Digitado aqui, fica também no cadastro financeiro.</p>
                </>
              )}
            </div>
          ))}
          <div data-payer-only="other" class="grid gap-3 sm:grid-cols-2">
            <div>
              <label for="payer_name" class={LABEL}>Nome de quem pagou</label>
              <input id="payer_name" name="payer_name" value={otherDefault.name} class={INPUT} />
            </div>
            <div>
              <label for="payer_cpf_other" class={LABEL}>CPF de quem pagou (opcional)</label>
              <input
                id="payer_cpf_other"
                name="payer_cpf"
                inputmode="numeric"
                placeholder="000.000.000-00"
                value={otherDefault.cpf ? formatCpf(otherDefault.cpf) : ""}
                class={INPUT}
              />
            </div>
            <p class={`${HINT} sm:col-span-2`}>Vale só para este pagamento; para mudar o responsável de sempre, use o cartão "Financeiro" do {vocabulary.patient}.</p>
          </div>
          {
            financeReady.ready && (
              <label class="flex items-start gap-2 text-sm text-slate-700">
                <input type="checkbox" name="emitir_nota" value="1" checked class="mt-0.5 h-4 w-4" />
                <span>
                  Emitir a nota fiscal agora, no CPF de quem pagou
                  {financeReady.environment === "restricted" && <span class="text-xs text-slate-500"> (ambiente de testes, sem valor fiscal)</span>}
                </span>
              </label>
            )
          }
          <button
            type="submit"
            class={`${PRIMARY_BUTTON} js-confirm-delete self-start`}
            data-confirm-title="Registrar o pagamento?"
            data-confirm-message={appointment.patientName}
            data-confirm-label="Registrar pagamento"
            data-confirm-tone="primary"
          >
            Registrar pagamento
          </button>
        </form>
      </Card>
    )
  }
  <p class="mt-4 max-w-2xl text-xs text-slate-500">
    <a href={withReturn(`/admin/pacientes/${patient.id}`, volta)} class="text-sky-700 hover:underline">{capitalize(vocabulary.patient)}: {patient.fullName}</a>
  </p>
  <ConfirmDeleteDialog />
</AdminLayout>

<script>
  import { parseMoneyCents } from "../../../../lib/forms";

  // Mostra só os campos de quem pagou (e só eles vão no envio) e monta o
  // texto da confirmação, com o aviso "acima do preço".
  const form = document.getElementById("pagamento") as HTMLFormElement | null;
  if (form) {
    const brl = (cents: number) => (cents / 100).toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
    const submit = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const sync = () => {
      const payer = form.querySelector<HTMLInputElement>('input[name="payer"]:checked')?.value ?? "contact";
      form.querySelectorAll<HTMLElement>("[data-payer-only]").forEach((block) => {
        const on = block.dataset.payerOnly === payer;
        block.hidden = !on;
        block.querySelectorAll<HTMLInputElement>("input").forEach((input) => (input.disabled = !on));
      });
      const nameInput = form.querySelector<HTMLInputElement>("#payer_name");
      if (nameInput) nameInput.required = payer === "other";

      const cents = parseMoneyCents(form.querySelector<HTMLInputElement>("#amount")?.value ?? "");
      const method = form.querySelector<HTMLInputElement>('input[name="method"]:checked')?.parentElement?.textContent?.trim() ?? "";
      const remaining = form.dataset.remaining === "" ? null : Number(form.dataset.remaining);
      const over = remaining !== null && Number.isFinite(cents) && cents > remaining;
      submit.dataset.confirmMessage = [
        `${form.dataset.patient}: ${Number.isFinite(cents) ? brl(cents) : "valor a conferir"}${method ? ` (${method})` : ""}.`,
        over ? `Atenção: fica acima do preço do atendimento (${remaining === 0 ? "já estava pago por inteiro" : `faltavam ${brl(remaining)}`}).` : "",
      ]
        .filter(Boolean)
        .join(" ");
    };
    form.addEventListener("input", sync);
    form.addEventListener("change", sync);
    sync();
  }
</script>

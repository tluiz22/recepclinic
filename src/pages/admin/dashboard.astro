---
// Meu dia (antigo Início; RX2 do redesign da Recepção, cliente, 02/nov/2026; Fase 9 do piloto, banco novo na F4.1): números de hoje no dia
// da clínica, alerta de envios automáticos e atalhos. Cartões e atalhos seguem
// os itens liberados para a clínica (D11). Com o bot, "Contatos para revisar"
// (F9.6a): quem bateu um limite do bot nos últimos 7 dias e ainda não foi
// marcado como revisado (Recepção e Administrador marcam aqui ou no contato).
// R7 (cliente, 16/out/2026): indicador único, atalhos no cabeçalho, avisos no
// padrão do painel e "Contatos para revisar" em linhas; Marcar na barra fixa
// do celular.
import { currentPath, withReturn } from "../../lib/returnPath";
import AdminLayout from "../../layouts/AdminLayout.astro";
import ConfirmDeleteDialog from "../../components/admin/ConfirmDeleteDialog.astro";
import FixNumberDialog from "../../components/admin/FixNumberDialog.astro";
import FlashMessage from "../../components/admin/FlashMessage.astro";
import Icon from "../../components/admin/Icon.astro";
import PhoneLinks from "../../components/admin/PhoneLinks.astro";
import Button from "../../components/admin/ui/Button.astro";
import Notice, { type NoticeTone } from "../../components/admin/ui/Notice.astro";
import HowItWorks from "../../components/admin/ui/HowItWorks.astro";
import { relacionamento } from "../../lib/ajuda/relacionamento";
import { meuDia } from "../../lib/ajuda/meu-dia";
import { createUserClient } from "../../lib/data/clients";
import { getDashboardCounts } from "../../lib/data/dashboard";
import { describeSendsAlert, getSendsAlert } from "../../lib/data/sends";
import { handoffReasonLabel, listHumanAttention } from "../../lib/data/whatsapp/attention";
import { BOT_LIMIT_LABELS, listContactsToReview, REVIEW_WINDOW_DAYS } from "../../lib/data/whatsapp/botLimits";
import { addDays, dayBounds, formatCalendarDate, formatInstant, localHourOf, todayIn } from "../../lib/clinicTime";
import CardActionButton from "../../components/admin/agenda/CardActionButton.astro";
import { cardActions } from "../../components/admin/agenda/cardActions";
import { appointmentSituation } from "../../components/admin/agenda/situationStyle";
import StatusPill from "../../components/admin/ui/StatusPill.astro";
import { listAgendas } from "../../lib/data/config/agendas";
import { listAgendaAppointments, type AgendaAppointment } from "../../lib/data/agenda/view";
import { listPendingReminders } from "../../lib/data/relationship";
import { listPendingAttendance } from "../../lib/data/daily";
import { isAnonymizedPhone } from "../../lib/anonymization";
import { formatPhoneBR } from "../../lib/phone";
import { serviceLook } from "../../components/admin/agenda/categoryStyle";
import { logError } from "../../lib/log";
import { vocabularyFor } from "../../lib/vocabulary";
import { certificateStatus } from "../../lib/certificate";
import { getFiscalCertificate } from "../../lib/data/fiscal";
import { getWhatsappConnection, listWhatsappTemplates } from "../../lib/data/whatsapp/connection";
import { latestAutomaticEcho } from "../../lib/data/whatsapp/conversations";
import { GUIDE_AUTOMATIONS_ANCHOR, GUIDE_BEFORE_CONNECT_PATH } from "../../lib/guides";
import { getDeliveredConnectionTest } from "../../lib/data/whatsapp/connectionTest";
import { listNumbersWithoutWhatsapp } from "../../lib/data/whatsapp/undeliverable";
import { MESSAGE_LABELS, OTHER_MESSAGE } from "../../lib/data/agenda/trail";
import { describeTemplateApproval, templateApproval, templatesInUse } from "../../lib/data/whatsapp/templates";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const has = (feature: (typeof clinic.features)[number]) => clinic.features.includes(feature);

// Avisos técnicos só para o Suporte (cliente, 02/nov/2026): certificado A1 (F11.3, a partir de 30 dias do
// vencimento), templates na Meta (F8.2) e forma de pagamento do WhatsApp (F8.3). O Administrador da clínica não os vê.
const isSupport = clinic.isPlatformStaff;
const certificateOn = has("finance") && isSupport;
// Todos os avisos técnicos do Meu dia são do Suporte (cliente, 02/nov/2026): desconexão avisada pela Meta, envios
// com falha e os de cima. O Suporte acompanha as clínicas; a tela de pendências do Suporte está em docs/painel-suporte.md.
const [counts, sendsAlert, toReview, certificate, connection, templates, attention, deliveredTest, autoReplyAt] = await Promise.all([
  getDashboardCounts(db, clinic.clinicId, clinic.timezone),
  getSendsAlert(db, clinic.clinicId),
  has("whatsapp_bot") ? listContactsToReview(db, clinic.clinicId) : Promise.resolve(null),
  certificateOn ? getFiscalCertificate(db, clinic.clinicId) : Promise.resolve(null),
  isSupport ? getWhatsappConnection(db, clinic.clinicId) : Promise.resolve(null),
  isSupport ? listWhatsappTemplates(db, clinic.clinicId) : Promise.resolve([]),
  has("whatsapp_bot") ? listHumanAttention(db, clinic.clinicId) : Promise.resolve([]),
  isSupport ? getDeliveredConnectionTest(db, clinic.clinicId) : Promise.resolve(null),
  // IS4: mensagem automática do app nas últimas 6 horas (Administrador e Suporte).
  has("whatsapp_bot") && (isSupport || clinic.roles.includes("admin")) ? latestAutomaticEcho(db, clinic.clinicId) : Promise.resolve(null),
]);
// Atendimento humano (F8.5a, cliente, 27/out/2026): faixa com as conversas que aguardam a clínica.
const awaiting = attention.filter((item) => item.status === "waiting");
const inProgress = attention.filter((item) => item.status === "in_progress");
const namesOf = (names: string[]) => (names.length > 3 ? `${names.slice(0, 3).join(", ")} e mais ${names.length - 3}` : names.join(", ").replace(/, ([^,]*)$/, " e $1"));
const inProgressNames = namesOf(inProgress.map((item) => item.name ?? "número sem cadastro"));
const oldestWait = awaiting[0]
  ? (() => {
      const minutes = Math.max(0, Math.floor((Date.now() - awaiting[0].waitingSince!.getTime()) / 60_000));
      const wait = minutes < 60 ? `${minutes} min` : `${Math.floor(minutes / 60)} h${minutes % 60 ? ` ${minutes % 60} min` : ""}`;
      return `A mais antiga espera há ${wait} (${awaiting[0].name ?? "número sem cadastro"}: ${handoffReasonLabel(awaiting[0].reason).toLowerCase()}).`;
    })()
  : null;
const templatesAlert =
  isSupport && connection?.status === "connected" ? describeTemplateApproval(templateApproval(templatesInUse(clinic.features), templates)) : null;
// IS2 (cliente, 03/nov/2026): sem mensagem de teste entregue (no lugar da forma de pagamento conferida à mão, F8.3);
// desconexão avisada pela Meta (F8.3).
const paymentAlert = isSupport && connection?.status === "connected" && !deliveredTest;
const disconnectedAlert = connection?.status === "disconnected" && connection.disconnectedVia === "meta" ? connection.disconnectedAt : null;
const certificateAlert = (() => {
  if (!certificate) return null;
  const status = certificateStatus(certificate.validUntil);
  if (status.state === "expired") return "O certificado digital A1 venceu: a clínica não emite nota fiscal até enviar o novo.";
  if (status.state === "expiring")
    return `O certificado digital A1 vence em ${status.daysLeft} ${status.daysLeft === 1 ? "dia" : "dias"} (${formatInstant(certificate.validUntil, clinic.timezone, "dd/MM/yyyy")}): renove e envie o novo.`;
  return null;
})();
const sendsAlertLines = isSupport ? describeSendsAlert(sendsAlert) : [];

const here = currentPath(Astro.url);

// RX3: "Esperando o paciente" (lembretes sem resposta de hoje e de amanhã, ainda por vir) e "Próximas consultas"
// (as de hoje que ainda não foram registradas). Falha de leitura vira aviso na seção, nunca lista vazia.
const nowAt = new Date();
const todayDate = todayIn(clinic.timezone, nowAt);
const tomorrowEnd = dayBounds(addDays(todayDate, 1), clinic.timezone).end;
const vocabulary = vocabularyFor(clinic.clinicProfile);
const load = async <T,>(label: string, run: () => Promise<T>): Promise<T | null> => {
  try {
    return await run();
  } catch (error) {
    logError(`meu dia: ${label} não carregou`, error, { clinica: clinic.clinicId });
    return null;
  }
};
const [pendingReminders, todayAppointments, pendingAttendanceList, numbersToFix] = await Promise.all([
  has("reminders") ? load("lembretes sem resposta", () => listPendingReminders(db, clinic.clinicId, nowAt)) : Promise.resolve([]),
  load("próximas consultas", async () => {
    const agendas = await listAgendas(db, clinic.clinicId, { includeInactive: true });
    return listAgendaAppointments(db, clinic.clinicId, { fromDate: todayDate, toDate: todayDate, timeZone: clinic.timezone, agendaIds: agendas.map((a) => a.id) });
  }),
  // Nomes da linha "Registrar presença" (só se há algo a registrar; a contagem vem de getDashboardCounts).
  counts.pendingAttendance > 0 ? load("consultas a registrar", () => listPendingAttendance(db, clinic.clinicId, nowAt)) : Promise.resolve([]),
  // Número sem WhatsApp (cliente, 05/nov/2026): a recepção corrige o cadastro ou diz que o número está certo.
  load("números sem WhatsApp", () => listNumbersWithoutWhatsapp(db, clinic.clinicId, nowAt)),
]);
const toFix = numbersToFix ?? [];
const waiting = pendingReminders?.filter((r) => r.kind === "no_answer" && r.appointment.scheduledAt > nowAt && r.appointment.scheduledAt < tomorrowEnd).map((r) => ({ appointment: r.appointment, sentAt: r.sentAt })) ?? [];
const upcoming = todayAppointments?.filter((a) => a.status === "scheduled" || a.status === "confirmed") ?? [];
const hhmm = (d: Date) => formatInstant(d, clinic.timezone, "HH:mm");
// Mesmas ações e confirmações do cartão da Agenda; aqui só as que a linha precisa.
const rowActions = (a: AgendaAppointment) =>
  cardActions({
    appointment: a,
    now: nowAt,
    // C23: quem está em "Esperando o paciente" tem lembrete sem resposta, que pode ser reenviado.
    reminderAction: "resend_unanswered",
    who: `${a.patientName}, ${formatInstant(a.scheduledAt, clinic.timezone, "dd/MM 'às' HH:mm")}`,
    contact: vocabulary.contact,
    returnTo: here,
    preparationResendable: false,
    guidanceResendable: false,
    waitlistOn: false,
    onWaitlist: false,
  });
const endpointOf = (a: AgendaAppointment) => `/api/admin/agenda/atendimentos/${a.id}`;
const dayLabel = (a: AgendaAppointment) => (localDay(a.scheduledAt) === todayDate ? "hoje" : "amanhã");
// "lembrete enviado ontem, 18:00".
const sentText = (sentAt: Date) => {
  const day = localDay(sentAt);
  const when = day === todayDate ? "hoje" : day === addDays(todayDate, -1) ? "ontem" : formatInstant(sentAt, clinic.timezone, "dd/MM");
  return `lembrete enviado ${when}, ${hhmm(sentAt)}`;
};
function localDay(d: Date) {
  return formatInstant(d, clinic.timezone, "yyyy-MM-dd");
}
const canReview = clinic.isPlatformStaff || clinic.roles.includes("admin") || clinic.roles.includes("reception");
// A aba Envios fica no Resumo do Dia, para toda a equipe (cliente, 05/out/2026).

const aviso = Astro.url.searchParams.get("aviso");
const NOTICES: Record<string, { tone: NoticeTone; text: string }> = {
  // Redirecionado pelo middleware: área sem acesso para o papel ou item não liberado.
  acesso_negado: { tone: "warning", text: "Essa tela não está disponível para o seu acesso." },
  senha_definida: { tone: "success", text: "Senha salva. Use-a nos próximos logins." },
};
const notice = aviso ? NOTICES[aviso] : undefined;

const today = formatCalendarDate(todayIn(clinic.timezone), "EEEE, d 'de' MMMM");
// Saudação do protótipo aprovado ("Bom dia, Marta"): pelo horário da clínica e pelo primeiro nome da pessoa na equipe
// (o nome que ela tem na clínica; sem nome, ou no Suporte que não é da equipe, só a saudação).
const hour = localHourOf(new Date(), clinic.timezone);
const greeting = hour < 12 ? "Bom dia" : hour < 18 ? "Boa tarde" : "Boa noite";
const memberName = await db
  .from("clinic_members")
  .select("display_name")
  .eq("clinic_id", clinic.clinicId)
  .eq("user_id", clinic.userId)
  .maybeSingle()
  .then((r) => r.data?.display_name ?? null, () => null);
const firstName = memberName?.trim().split(/\s+/)[0] ?? "";
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
// Linha do dia (RX2; C25, cliente, 04/nov, opção B): cada atendimento de hoje num grupo só, a soma dá o total.
// Aparecem só os grupos com algum atendimento; a barra segue a mesma ordem.
const pct = (n: number) => (counts.totalToday > 0 ? (n / counts.totalToday) * 100 : 0);
const dayGroups = [
  { n: counts.completedToday, text: plural(counts.completedToday, "já atendida", "já atendidas"), color: "bg-att-500" },
  { n: counts.noShowToday, text: plural(counts.noShowToday, "faltou", "faltaram"), color: "bg-ns-500" },
  { n: counts.confirmedToday, text: plural(counts.confirmedToday, "confirmada", "confirmadas"), color: "bg-conf-500" },
  { n: counts.toConfirmToday, text: `${counts.toConfirmToday} a confirmar`, color: "bg-pend-500" },
].filter((g) => g.n > 0);
// "Registrar presença": as primeiras consultas, em ordem de horário, para o detalhe da linha.
const pendingSorted = [...(pendingAttendanceList ?? [])].sort((a, b) => a.scheduledAt.getTime() - b.scheduledAt.getTime());
const pendingNames = (() => {
  const shown = pendingSorted.slice(0, 3).map((a) => `${a.patientName} ${formatInstant(a.scheduledAt, clinic.timezone, localDay(a.scheduledAt) === todayDate ? "HH:mm" : "dd/MM HH:mm")}`);
  const more = counts.pendingAttendance - shown.length;
  return shown.join(" · ") + (more > 0 ? ` e mais ${more}` : "");
})();
const pendingFirstDate = pendingSorted[0] ? localDay(pendingSorted[0].scheduledAt) : todayDate;
// Linhas de "Precisa de você" (o número ao lado do título; o do menu soma os itens).
const precisaLines = (awaiting.length > 0 ? 1 : 0) + (inProgress.length > 0 ? 1 : 0) + (counts.pendingAttendance > 0 ? 1 : 0) + (toReview?.length ?? 0) + toFix.length;
const tagClass = "rounded-md px-2 py-0.5 text-[12.5px] font-bold whitespace-nowrap";
// "Precisa de você": some a linha de quem não tem pendência; vazio mostra um texto de tudo em dia.
// O menu usa este número (mesma conta de getMeuDiaCount) sem ler de novo.
Astro.locals.meuDiaCount = awaiting.length + inProgress.length + counts.pendingAttendance + (toReview?.length ?? 0) + toFix.length;
Astro.locals.meuDiaConversations = awaiting.length + inProgress.length;
const hasPending = awaiting.length > 0 || inProgress.length > 0 || counts.pendingAttendance > 0 || (toReview?.length ?? 0) > 0 || toFix.length > 0;
const RESENDABLE = new Set(["appointment_confirmation", "appointment_reschedule"]);
const sectionTitle = "font-display text-[17px] leading-tight font-bold text-ink sm:text-lg";
---

<AdminLayout title="Meu dia" autoRefresh>
  <header class="flex flex-wrap items-end justify-between gap-x-4 gap-y-3">
    <div class="flex min-w-0 flex-col gap-1">
      <p class="text-[15px] text-ink-soft first-letter:uppercase">{today}</p>
      <h1 class="font-display text-[28px] leading-[1.1] font-bold text-ink sm:text-[32px]">{firstName ? `${greeting}, ${firstName}` : greeting}</h1>
    </div>
    <div class="flex flex-wrap items-end gap-2.5 max-sm:w-full">
      {/* C30 (cliente, 04/nov): no computador, a busca (com rótulo) e Marcar consulta alinham pela base, na mesma altura (54px). */}
      {/* C23 (cliente, 04/nov, opção A): busca com rótulo à vista, mais alta e com a borda da marca. */}
      <form method="GET" action="/admin/pacientes" role="search" class="w-full sm:w-[360px]">
        <label for="buscar-paciente" class="mb-1.5 block text-[15px] font-bold text-ink">Buscar paciente</label>
        <div class="flex h-[54px] items-center gap-2.5 rounded-xl border-2 border-brand bg-white px-3.5 shadow-[0_4px_14px_rgba(11,122,98,.14)] focus-within:ring-2 focus-within:ring-brand/40">
          <Icon name="magnifying-glass" class="h-[22px] w-[22px] shrink-0 text-brand" strokeWidth={2.4} />
          <input id="buscar-paciente" name="q" type="search" placeholder="Nome, telefone ou nascimento" class="min-w-0 flex-1 border-0 bg-transparent p-0 text-[17px] text-ink outline-none focus:ring-0" />
        </div>
      </form>
      <Button href={withReturn("/admin/agenda/marcar", here)} variant="primary" class="max-sm:hidden sm:h-[54px] sm:px-5 sm:text-base">
        <Icon name="plus" class="h-[18px] w-[18px]" strokeWidth={2.2} /> Marcar consulta
      </Button>
    </div>
  </header>

  {notice && (
    <div class="mt-4">
      <Notice tone={notice.tone}>{notice.text}</Notice>
    </div>
  )}
  <FlashMessage />

  {/* Avisos que ficavam no Início continuam no alto (RX2). */}
  {
    (sendsAlertLines.length > 0 || certificateAlert || templatesAlert || paymentAlert || disconnectedAlert || autoReplyAt) && (
      <section aria-label="Avisos" class="mt-4 flex flex-col gap-2">
        {sendsAlertLines.length > 0 && (
          <Notice tone="danger" href="/admin/consultas?tab=envios" linkLabel="Ver os envios">
            {sendsAlertLines.join(" ")}
          </Notice>
        )}
        {disconnectedAlert && (
          <Notice tone="danger" href={withReturn("/admin/configuracoes/whatsapp", here)} linkLabel="Conectar de novo">
            O WhatsApp da clínica foi desconectado da Meta em {formatInstant(disconnectedAlert, clinic.timezone, "dd/MM")}: o bot, os avisos e os lembretes
            pararam. Conecte de novo em Configurações › WhatsApp.
          </Notice>
        )}
        {paymentAlert && (
          <Notice tone="warning" href={withReturn("/admin/configuracoes/whatsapp#teste", here)} linkLabel="Enviar o teste">
            Falta uma mensagem de teste entregue: ela confirma o cartão na Meta e o modelo aprovado. Sem o cartão, os lembretes e os avisos automáticos não
            saem.
          </Notice>
        )}
        {autoReplyAt && (
          <Notice tone="warning" href={`${GUIDE_BEFORE_CONNECT_PATH}#${GUIDE_AUTOMATIONS_ANCHOR}`} linkLabel="Como desligar">
            O app WhatsApp Business da clínica mandou uma mensagem automática (saudação ou ausência) em{" "}
            {formatInstant(autoReplyAt, clinic.timezone, "dd/MM 'às' HH:mm")}, segundos depois da mensagem do paciente. O bot seguiu atendendo, mas o paciente
            recebeu duas respostas. Desligue a saudação e a ausência no app.
          </Notice>
        )}
        {templatesAlert && (
          <Notice tone="warning" href={withReturn("/admin/configuracoes/whatsapp", here)} linkLabel="Abrir WhatsApp">
            Algumas mensagens automáticas do WhatsApp ainda não estão aprovadas pela Meta ({templatesAlert}). Enquanto isso, esses envios não saem.
          </Notice>
        )}
        {certificateAlert && (
          <Notice tone="warning" href={withReturn("/admin/configuracoes/nota-fiscal", here)} linkLabel="Abrir Nota fiscal">
            {certificateAlert}
          </Notice>
        )}
      </section>
    )
  }

  <section aria-labelledby="hoje" class="mt-5 flex flex-col gap-2.5 rounded-xl border border-line bg-white px-4 py-3.5 sm:px-5">
    <div class="flex flex-wrap items-baseline gap-x-5 gap-y-1 text-[15.5px]">
      <h2 id="hoje" class="text-[16.5px] font-bold text-ink">
        {counts.totalToday === 0 ? "Nenhum atendimento hoje" : `Hoje, ${plural(counts.totalToday, has("exams") ? "atendimento" : "consulta", has("exams") ? "atendimentos" : "consultas")}`}
      </h2>
      {
        counts.totalToday > 0 && (
          <>
            {dayGroups.map((g) => (
              <span class="inline-flex items-center gap-1.5"><span class={`h-2.5 w-2.5 rounded-[3px] ${g.color}`} aria-hidden="true"></span>{g.text}</span>
            ))}
          </>
        )
      }
      <a href="/admin/agenda" class="font-semibold text-brand no-underline hover:underline sm:ml-auto">Abrir agenda de hoje</a>
    </div>
    {
      counts.totalToday > 0 && (
        <div
          class="flex h-2 gap-0.5 overflow-hidden rounded-full bg-line"
          role="img"
          aria-label={`${dayGroups.map((g) => g.text).join(", ")}, de ${counts.totalToday} hoje`}
        >
          {dayGroups.map((g) => <span class={g.color} style={`width:${pct(g.n)}%`}></span>)}
        </div>
      )
    }
  </section>

  <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1fr)_340px] lg:items-start">
  <div class="flex min-w-0 flex-col gap-6">
  <section aria-labelledby="precisa" class="overflow-hidden rounded-xl border border-line bg-white">
    <div class="flex flex-col gap-0.5 px-4 pt-4 pb-3 sm:px-[18px]">
      <h2 id="precisa" class="flex items-center gap-2.5 font-display text-[21px] leading-tight font-bold text-ink">
        Precisa de você
        {precisaLines > 0 && <span class="rounded-full bg-can-100 px-2.5 py-px font-sans text-sm font-bold text-can-800">{precisaLines}</span>}
      </h2>
      <p class="text-[14.5px] text-ink-soft">Só some daqui quando alguém resolver.</p>
      {
        toReview && toReview.length > 0 && (
          // "Como funciona?" de "Conferir contato" (texto aprovado pelo cliente em 31/out/2026).
          <HowItWorks id="contatos-revisar" topic={relacionamento.comoFunciona.revisar} class="mt-1">
            <p class="text-sm text-ink-soft">Nos últimos {REVIEW_WINDOW_DAYS} dias, o bot deixou de marcar para estes números por um limite do contato.</p>
          </HowItWorks>
        )
      }
    </div>
    {!hasPending && <p class="border-t border-[#e7eeeb] px-4 py-4 text-[15px] text-ink-soft sm:px-[18px]">Nada pendente agora.</p>}
    {
      awaiting.length > 0 && (
        <a
          href="/admin/atendimento"
          class="flex flex-wrap items-center gap-3.5 border-t border-can-200 bg-can-50 px-4 py-3.5 text-can-800 no-underline hover:bg-can-100/60 sm:px-[18px]"
        >
          <span class="flex h-11 w-11 flex-none items-center justify-center rounded-full bg-can-500 font-display text-xl font-bold text-white">{awaiting.length}</span>
          <span class="flex min-w-0 flex-[1_1_280px] flex-col gap-0.5">
            <strong class="text-[17px]">{plural(awaiting.length, "conversa aguardando atendimento humano", "conversas aguardando atendimento humano")}</strong>
            <span class="text-[15px] text-ink-mid">{oldestWait}</span>
          </span>
          <span class="flex-none text-[15px] font-bold">Ver conversas ›</span>
        </a>
      )
    }
    {
      inProgress.length > 0 && (
        // Conversas que a clínica assumiu e ainda não finalizou (cliente, 27/out/2026; CA, 04/nov/2026).
        <a
          href="/admin/atendimento?aba=atendimento"
          class="flex flex-wrap items-center gap-3.5 border-t border-pend-200 bg-pend-50 px-4 py-3.5 text-pend-800 no-underline hover:bg-pend-100/60 sm:px-[18px]"
        >
          <span class="flex h-11 w-11 flex-none items-center justify-center rounded-full bg-pend-500 font-display text-xl font-bold text-ink">{inProgress.length}</span>
          <span class="flex min-w-0 flex-[1_1_280px] flex-col gap-0.5">
            <strong class="text-[17px]">
              {inProgress.length === 1 ? "1 conversa está com a clínica e ainda não voltou ao bot" : `${inProgress.length} conversas estão com a clínica e ainda não voltaram ao bot`}
            </strong>
            <span class="text-[15px] text-ink-mid">{inProgressNames}. Ao terminar, use "Finalizar atendimento" em Atendimento (sem nova mensagem, volta sozinha 12 h depois da última).</span>
          </span>
          <span class="flex-none text-[15px] font-bold">Ver conversas ›</span>
        </a>
      )
    }
    {
      counts.pendingAttendance > 0 && (
        <div class="flex flex-wrap items-center gap-3 border-t border-[#e7eeeb] px-4 py-3.5 sm:px-[18px]">
          <span class={`${tagClass} bg-att-100 text-att-800`}>Registrar presença</span>
          <div class="flex min-w-0 flex-[1_1_200px] flex-col gap-0.5">
            <span class="text-base"><strong>{plural(counts.pendingAttendance, "consulta", "consultas")}</strong> já {counts.pendingAttendance === 1 ? "passou" : "passaram"}, sem presença ou falta</span>
            {pendingNames && <span class="text-sm text-ink-soft">{pendingNames}</span>}
          </div>
          <div class="flex flex-wrap gap-2">
            <Button href="/admin/consultas?tab=pendentes">Registrar</Button>
            <Button href={withReturn(`/admin/agenda?date=${pendingFirstDate}`, here)} variant="quiet">Abrir na agenda</Button>
          </div>
        </div>
      )
    }
    {
      toReview?.map((item) => (
        <div class="flex flex-wrap items-center gap-3 border-t border-[#e7eeeb] px-4 py-3.5 sm:px-[18px]">
          <span class={`${tagClass} bg-blk-100 text-blk-800`}>Conferir contato</span>
          <div class="flex min-w-0 flex-[1_1_200px] flex-col gap-0.5">
            <span class="text-base"><strong>{item.name}</strong> {BOT_LIMIT_LABELS[item.last.reason].toLowerCase()}</span>
            <span class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-ink-soft">
              {item.phone && <PhoneLinks phone={item.phone} plain />}
              <span class="tabular-nums">
                {formatInstant(item.last.at, clinic.timezone, "dd/MM HH:mm")}
                {item.hits > 1 && ` · ${plural(item.hits, "vez", "vezes")}`}
              </span>
            </span>
          </div>
          <div class="flex flex-wrap gap-2">
            <Button href={withReturn(`/admin/pacientes/contato/${item.contactId}`, here)}>Ver contato</Button>
            {canReview && (
              <form method="POST" action={`/api/admin/pacientes/contato/${item.contactId}`} class="contents">
                <input type="hidden" name="acao" value="revisado" />
                <input type="hidden" name="voltar" value="painel" />
                <Button
                  type="submit"
                  variant="quiet"
                  class="js-confirm-delete"
                  data-confirm-title="Marcar como revisado?"
                  data-confirm-message={`${item.name} sai desta lista. Se atingir um limite de novo, volta.`}
                  data-confirm-label="Revisado"
                >
                  Marcar como visto
                </Button>
              </form>
            )}
          </div>
        </div>
      ))
    }
    {
      toFix.map((item) => {
        const label = (MESSAGE_LABELS[item.messageType] ?? OTHER_MESSAGE).label.toLowerCase();
        const resend = RESENDABLE.has(item.messageType) && !!item.appointment && item.appointment.scheduledAt > nowAt;
        return (
          <div class="flex flex-wrap items-center gap-3 border-t border-[#e7eeeb] px-4 py-3.5 sm:px-[18px]">
            <span class={`${tagClass} bg-[#fbe4e1] text-danger`}>Corrigir número</span>
            <div class="flex min-w-0 flex-[1_1_200px] flex-col gap-0.5">
              <span class="text-base">
                <strong>{item.contactName}</strong> não recebeu a mensagem ({label}): o número não tem WhatsApp
              </span>
              <span class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-ink-soft">
                <span class="font-semibold text-ink">{formatPhoneBR(item.phone)}</span>
                <span class="tabular-nums">{formatInstant(item.failedAt, clinic.timezone, "dd/MM HH:mm")}</span>
                {item.appointment && (
                  <span>
                    · {item.appointment.patientName}, {formatInstant(item.appointment.scheduledAt, clinic.timezone, "dd/MM 'às' HH:mm")}
                  </span>
                )}
              </span>
            </div>
            {canReview && (
              <div class="flex flex-wrap gap-2">
                <Button
                  type="button"
                  class="js-fix-number"
                  data-message-id={item.messageId}
                  data-contact-name={item.contactName}
                  data-phone={formatPhoneBR(item.phone)}
                  data-resend={resend ? "1" : "0"}
                >
                  Corrigir número
                </Button>
                <form method="POST" action="/api/admin/envios/falha" class="contents">
                  <input type="hidden" name="acao" value="numero_certo" />
                  <input type="hidden" name="mensagem" value={item.messageId} />
                  <input type="hidden" name="return_to" value="/admin/dashboard" />
                  <Button
                    type="submit"
                    variant="quiet"
                    class="js-confirm-delete"
                    data-confirm-title="O número está certo?"
                    data-confirm-message={`O aviso de ${item.contactName} sai do Início. Se uma próxima mensagem também não chegar, ele volta.`}
                    data-confirm-label="O número está certo"
                    data-confirm-tone="primary"
                  >
                    O número está certo
                  </Button>
                </form>
              </div>
            )}
          </div>
        );
      })
    }
  </section>

  {
    has("reminders") && (
      <section aria-labelledby="esperando" class="overflow-hidden rounded-xl border border-line bg-white">
        <div class="flex flex-col gap-0.5 px-4 pt-4 pb-3 sm:px-[18px]">
          <h2 id="esperando" class="flex items-center gap-2.5 font-display text-[21px] leading-tight font-bold text-ink">
            Esperando o paciente
            {waiting.length > 0 && <span data-waiting-count class="rounded-full bg-pend-100 px-2.5 py-px font-sans text-sm font-bold text-pend-800">{waiting.length}</span>}
          </h2>
          <HowItWorks id="esperando-paciente" topic={meuDia.comoFunciona.esperando} class="mt-1">
            <p class="text-[14.5px] text-ink-soft">O lembrete foi enviado e o paciente ainda não respondeu. Se quiser insistir, reenvie o lembrete; se ele confirmou por outro meio, confirme a presença. Sai da lista na hora da consulta.</p>
          </HowItWorks>
        </div>
        {pendingReminders === null && <div class="px-4 pb-4 sm:px-[18px]"><Notice tone="warning">Não foi possível carregar os lembretes sem resposta. Tente atualizar a página.</Notice></div>}
        <p data-waiting-empty hidden={pendingReminders === null || waiting.length > 0} class="border-t border-[#e7eeeb] px-4 py-4 text-[15px] text-ink-soft sm:px-[18px]">Nenhum lembrete de hoje ou de amanhã sem resposta.</p>
        {
          waiting.map(({ appointment: a, sentAt }) => {
            const actions = rowActions(a);
            const confirm = actions.primary?.kind === "form" && actions.primary.acao === "confirmar_presenca" ? actions.primary : undefined;
            const resend = actions.visible.find((x) => x.kind === "form" && x.acao === "lembrete");
            const rebook = actions.visible.find((x) => x.kind === "link" && x.label === "Remarcar");
            const phone = formatPhoneBR(a.contactPhone);
            return (
              <div data-waiting-row data-starts-at={a.scheduledAt.toISOString()} class="flex flex-wrap items-center gap-3 border-t border-[#e7eeeb] px-4 py-3.5 sm:px-[18px]">
                <div class="flex min-w-[56px] flex-col">
                  <strong class="text-base tabular-nums">{hhmm(a.scheduledAt)}</strong>
                  <span class="text-[13.5px] text-ink-soft">{dayLabel(a)}</span>
                </div>
                <div class="flex min-w-0 flex-[1_1_150px] flex-col gap-0.5">
                  <span class="text-base">
                    <a href={withReturn(`/admin/pacientes/${a.patientId}`, here)} class="font-bold text-ink no-underline hover:text-brand hover:underline">{a.patientName}</a>
                    {" · "}{serviceLook(a.category).label}
                  </span>
                  <span class="text-sm text-ink-soft">
                    {!a.isContactSelf && `${a.contactName} · `}
                    {isAnonymizedPhone(a.contactPhone) ? "telefone anonimizado" : phone} · {sentText(sentAt)}
                  </span>
                </div>
                {/* C23 (cliente, 04/nov): só Confirmar presença, Reenviar lembrete e Remarcar. */}
                <div class="flex flex-wrap gap-2">
                  {confirm && <CardActionButton action={confirm} endpoint={endpointOf(a)} returnTo={here} variant="primary" />}
                  {resend && <CardActionButton action={resend} endpoint={endpointOf(a)} returnTo={here} />}
                  {rebook && <CardActionButton action={rebook} endpoint={endpointOf(a)} returnTo={here} variant="quiet" />}
                </div>
              </div>
            );
          })
        }
      </section>
    )
  }
  </div>

  <aside aria-labelledby="proximas" class="flex flex-col gap-2">
    <h2 id="proximas" class={sectionTitle}>Próximas consultas</h2>
    {todayAppointments === null && <Notice tone="warning">Não foi possível carregar as consultas de hoje. Tente atualizar a página.</Notice>}
    {todayAppointments !== null && upcoming.length === 0 && <p class="rounded-xl border border-line bg-white px-4 py-3.5 text-[15px] text-ink-soft">Nenhuma consulta pendente hoje.</p>}
    {
      upcoming.length > 0 && (
        <ul class="rounded-xl border border-line bg-white px-4">
          {upcoming.map((a) => {
            const actions = rowActions(a);
            const done = actions.primary?.kind === "form" && actions.primary.acao === "compareceu" ? actions.primary : undefined;
            return (
              <li class="flex flex-col gap-1.5 border-t border-[#e6ecea] py-3 first:border-t-0">
                <span class="flex items-baseline gap-2">
                  <span class="font-display text-[17px] font-bold text-ink tabular-nums">{hhmm(a.scheduledAt)}</span>
                  <a href={withReturn(`/admin/pacientes/${a.patientId}`, here)} class="min-w-0 truncate text-base font-semibold text-ink no-underline hover:text-brand hover:underline">
                    {a.patientName}
                  </a>
                </span>
                <span class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-ink-soft">
                  {a.agendaName}
                  <StatusPill situation={appointmentSituation(a)} />
                </span>
                {done && (
                  <span class="mt-0.5 flex">
                    <CardActionButton action={done} endpoint={endpointOf(a)} returnTo={here} variant="primary" />
                  </span>
                )}
              </li>
            );
          })}
        </ul>
      )
    }
  </aside>
  </div>

  {/* C23: na hora da consulta, a linha sai de "Esperando o paciente" sem esperar a recarga (que não acontece com a
      busca em uso). */}
  <script>
    const hidePast = () => {
      const rows = [...document.querySelectorAll<HTMLElement>("[data-waiting-row]")];
      if (rows.length === 0) return;
      const now = Date.now();
      for (const row of rows) if (new Date(row.dataset.startsAt ?? "").getTime() <= now) row.remove();
      const left = document.querySelectorAll("[data-waiting-row]").length;
      const count = document.querySelector<HTMLElement>("[data-waiting-count]");
      if (count) count.textContent = String(left);
      if (left === 0) {
        count?.remove();
        document.querySelector<HTMLElement>("[data-waiting-empty]")?.removeAttribute("hidden");
      }
    };
    hidePast();
    setInterval(hidePast, 15_000);
  </script>

  {/* Um só diálogo de confirmação para todas as ações da tela. */}
  <ConfirmDeleteDialog />
  <FixNumberDialog />

  <div class="h-20 sm:hidden" aria-hidden="true" />
  <div class="fixed-bar fixed inset-x-0 bottom-[calc(61px+env(safe-area-inset-bottom))] z-10 flex items-center gap-3 border-t border-line bg-white px-4 py-2.5 shadow-[0_-4px_14px_rgba(18,48,42,.08)] sm:hidden">
    <span class="min-w-0 flex-1 truncate text-base font-semibold text-ink">Meu dia</span>
    <Button href={withReturn("/admin/agenda/marcar", here)} variant="primary" class="h-12 px-6 text-base">Marcar consulta</Button>
  </div>
</AdminLayout>

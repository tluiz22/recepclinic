---
// Meu dia (antigo Início; RX2 do redesign da Recepção, cliente, 02/nov/2026; Fase 9 do piloto, banco novo na F4.1): números de hoje no dia
// da clínica, alerta de envios automáticos e atalhos. Cartões e atalhos seguem
// os itens liberados para a clínica (D11). Com o bot, "Contatos para revisar"
// (F9.6a): quem bateu um limite do bot nos últimos 7 dias e ainda não foi
// marcado como revisado (Recepção e Administrador marcam aqui ou no contato).
// R7 (cliente, 16/out/2026): indicador único, atalhos no cabeçalho, avisos no
// padrão do painel e "Contatos para revisar" em linhas; Marcar na barra fixa
// do celular.
import { currentPath, withReturn } from "../../lib/returnPath";
import AdminLayout from "../../layouts/AdminLayout.astro";
import ConfirmDeleteDialog from "../../components/admin/ConfirmDeleteDialog.astro";
import FlashMessage from "../../components/admin/FlashMessage.astro";
import Icon from "../../components/admin/Icon.astro";
import PhoneLinks from "../../components/admin/PhoneLinks.astro";
import Button from "../../components/admin/ui/Button.astro";
import Notice, { type NoticeTone } from "../../components/admin/ui/Notice.astro";
import PageHeader from "../../components/admin/ui/PageHeader.astro";
import HowItWorks from "../../components/admin/ui/HowItWorks.astro";
import { relacionamento } from "../../lib/ajuda/relacionamento";
import { createUserClient } from "../../lib/data/clients";
import { getDashboardCounts } from "../../lib/data/dashboard";
import { describeSendsAlert, getSendsAlert } from "../../lib/data/sends";
import { handoffReasonLabel, listHumanAttention } from "../../lib/data/whatsapp/attention";
import { BOT_LIMIT_LABELS, listContactsToReview, REVIEW_WINDOW_DAYS } from "../../lib/data/whatsapp/botLimits";
import { formatCalendarDate, formatInstant, todayIn } from "../../lib/clinicTime";
import { certificateStatus } from "../../lib/certificate";
import { getFiscalCertificate } from "../../lib/data/fiscal";
import { getWhatsappConnection, listWhatsappTemplates } from "../../lib/data/whatsapp/connection";
import { describeTemplateApproval, templateApproval, templatesInUse } from "../../lib/data/whatsapp/templates";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const has = (feature: (typeof clinic.features)[number]) => clinic.features.includes(feature);

// Certificado A1 (F11.3): aviso ao Administrador a partir de 30 dias do vencimento.
const certificateOn = has("finance") && (clinic.roles.includes("admin") || clinic.isPlatformStaff);
// Templates na Meta (F8.2, cliente, 25/out): aviso ao Administrador enquanto algum em uso não estiver aprovado.
const isAdmin = clinic.roles.includes("admin") || clinic.isPlatformStaff;
const [counts, sendsAlert, toReview, certificate, connection, templates, attention] = await Promise.all([
  getDashboardCounts(db, clinic.clinicId, clinic.timezone),
  getSendsAlert(db, clinic.clinicId),
  has("whatsapp_bot") ? listContactsToReview(db, clinic.clinicId) : Promise.resolve(null),
  certificateOn ? getFiscalCertificate(db, clinic.clinicId) : Promise.resolve(null),
  isAdmin ? getWhatsappConnection(db, clinic.clinicId) : Promise.resolve(null),
  isAdmin ? listWhatsappTemplates(db, clinic.clinicId) : Promise.resolve([]),
  has("whatsapp_bot") ? listHumanAttention(db, clinic.clinicId) : Promise.resolve([]),
]);
// Atendimento humano (F8.5a, cliente, 27/out/2026): faixa com as conversas que aguardam a clínica.
const awaiting = attention.filter((item) => item.status === "waiting");
const inProgress = attention.filter((item) => item.status === "in_progress");
const namesOf = (names: string[]) => (names.length > 3 ? `${names.slice(0, 3).join(", ")} e mais ${names.length - 3}` : names.join(", ").replace(/, ([^,]*)$/, " e $1"));
const inProgressNames = namesOf(inProgress.map((item) => item.name ?? "número sem cadastro"));
const oldestWait = awaiting[0]
  ? (() => {
      const minutes = Math.max(0, Math.floor((Date.now() - awaiting[0].waitingSince!.getTime()) / 60_000));
      const wait = minutes < 60 ? `${minutes} min` : `${Math.floor(minutes / 60)} h${minutes % 60 ? ` ${minutes % 60} min` : ""}`;
      return `A mais antiga espera há ${wait} (${awaiting[0].name ?? "número sem cadastro"}: ${handoffReasonLabel(awaiting[0].reason).toLowerCase()}).`;
    })()
  : null;
const templatesAlert =
  connection?.status === "connected" ? describeTemplateApproval(templateApproval(templatesInUse(clinic.features), templates)) : null;
// F8.3 (cliente, 24 e 25/out): forma de pagamento ainda não conferida pelo Suporte; desconexão avisada pela Meta.
const paymentAlert = connection?.status === "connected" && !connection.paymentCheckedAt;
const disconnectedAlert = connection?.status === "disconnected" && connection.disconnectedVia === "meta" ? connection.disconnectedAt : null;
const certificateAlert = (() => {
  if (!certificate) return null;
  const status = certificateStatus(certificate.validUntil);
  if (status.state === "expired") return "O certificado digital A1 venceu: a clínica não emite nota fiscal até enviar o novo.";
  if (status.state === "expiring")
    return `O certificado digital A1 vence em ${status.daysLeft} ${status.daysLeft === 1 ? "dia" : "dias"} (${formatInstant(certificate.validUntil, clinic.timezone, "dd/MM/yyyy")}): renove e envie o novo.`;
  return null;
})();
const sendsAlertLines = describeSendsAlert(sendsAlert);
const canReview = clinic.isPlatformStaff || clinic.roles.includes("admin") || clinic.roles.includes("reception");
// A aba Envios fica no Resumo do Dia, para toda a equipe (cliente, 05/out/2026).

const aviso = Astro.url.searchParams.get("aviso");
const NOTICES: Record<string, { tone: NoticeTone; text: string }> = {
  // Redirecionado pelo middleware: área sem acesso para o papel ou item não liberado.
  acesso_negado: { tone: "warning", text: "Essa tela não está disponível para o seu acesso." },
  senha_definida: { tone: "success", text: "Senha salva. Use-a nos próximos logins." },
};
const notice = aviso ? NOTICES[aviso] : undefined;

const here = currentPath(Astro.url);
const today = formatCalendarDate(todayIn(clinic.timezone), "EEEE, d 'de' MMMM 'de' yyyy");
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
// Linha do dia (RX2): atendidas e confirmadas sobre o total de hoje; o resto ainda não confirmou.
const pct = (n: number) => (counts.totalToday > 0 ? Math.round((n / counts.totalToday) * 100) : 0);
const donePct = pct(counts.completedToday);
const confirmedPct = pct(counts.confirmedToday);
// "Precisa de você": some a linha de quem não tem pendência; vazio mostra um texto de tudo em dia.
const hasPending = awaiting.length > 0 || inProgress.length > 0 || counts.pendingAttendance > 0 || (toReview?.length ?? 0) > 0;
const sectionTitle = "font-display text-[17px] leading-tight font-bold text-ink sm:text-lg";
---

<AdminLayout title="Meu dia" autoRefresh>
  <PageHeader title="Meu dia" subtitle={today}>
    <Fragment slot="actions">
      <Button href={withReturn("/admin/agenda/marcar", here)} variant="primary" class="max-sm:hidden">
        <Icon name="plus" class="h-[18px] w-[18px]" strokeWidth={2.2} /> Marcar consulta
      </Button>
    </Fragment>
  </PageHeader>

  <form method="GET" action="/admin/pacientes" role="search" class="mt-3 flex max-w-xl gap-2">
    <label for="buscar-paciente" class="sr-only">Buscar paciente por nome, telefone ou nascimento</label>
    <input
      id="buscar-paciente"
      name="q"
      type="search"
      placeholder="Buscar paciente por nome, telefone ou nascimento"
      class="h-11 min-w-0 flex-1 rounded-lg border border-line bg-white px-3 text-base text-ink focus:border-brand focus:ring-0"
    />
    <Button type="submit" class="h-11">Buscar</Button>
  </form>

  {notice && (
    <div class="mt-4">
      <Notice tone={notice.tone}>{notice.text}</Notice>
    </div>
  )}
  <FlashMessage />

  {/* Avisos que ficavam no Início continuam no alto (RX2). */}
  {
    (sendsAlertLines.length > 0 || certificateAlert || templatesAlert || paymentAlert || disconnectedAlert) && (
      <section aria-label="Avisos" class="mt-4 flex flex-col gap-2">
        {sendsAlertLines.length > 0 && (
          <Notice tone="danger" href="/admin/consultas?tab=envios" linkLabel="Ver os envios">
            {sendsAlertLines.join(" ")}
          </Notice>
        )}
        {disconnectedAlert && (
          <Notice tone="danger" href={withReturn("/admin/configuracoes/whatsapp", here)} linkLabel="Conectar de novo">
            O WhatsApp da clínica foi desconectado da Meta em {formatInstant(disconnectedAlert, clinic.timezone, "dd/MM")}: o bot, os avisos e os lembretes
            pararam. Conecte de novo em Configurações › WhatsApp.
          </Notice>
        )}
        {paymentAlert && (
          <Notice tone="warning" href={withReturn("/admin/configuracoes/whatsapp", here)} linkLabel="Abrir WhatsApp">
            Falta conferir a forma de pagamento da conta do WhatsApp na Meta: sem ela, os lembretes e os avisos automáticos não saem. Adicione no Gerenciador
            do WhatsApp e avise o suporte do RecepClinic para conferir.
          </Notice>
        )}
        {templatesAlert && (
          <Notice tone="warning" href={withReturn("/admin/configuracoes/whatsapp", here)} linkLabel="Abrir WhatsApp">
            Algumas mensagens automáticas do WhatsApp ainda não estão aprovadas pela Meta ({templatesAlert}). Enquanto isso, esses envios não saem.
          </Notice>
        )}
        {certificateAlert && (
          <Notice tone="warning" href={withReturn("/admin/configuracoes/nota-fiscal", here)} linkLabel="Abrir Nota fiscal">
            {certificateAlert}
          </Notice>
        )}
      </section>
    )
  }

  <section aria-labelledby="hoje" class="mt-5 rounded-xl border border-line bg-white px-4 py-3.5 sm:px-5">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h2 id="hoje" class={sectionTitle}>
        {counts.totalToday === 0 ? "Nenhum atendimento hoje" : plural(counts.totalToday, "atendimento hoje", "atendimentos hoje")}
      </h2>
      <a href="/admin/agenda" class="text-[15px] font-bold text-brand no-underline hover:underline">Abrir agenda de hoje ›</a>
    </div>
    {
      counts.totalToday > 0 && (
        <>
          <div
            class="mt-3 flex h-2.5 overflow-hidden rounded-full bg-line"
            role="img"
            aria-label={`${counts.completedToday} já atendidos e ${counts.confirmedToday} confirmados de ${counts.totalToday} atendimentos hoje`}
          >
            <span class="bg-brand" style={`width:${donePct}%`}></span>
            <span class="bg-brand/45" style={`width:${confirmedPct}%`}></span>
          </div>
          <dl class="mt-2.5 flex flex-wrap gap-x-6 gap-y-1 text-[15px] text-ink-mid">
            <div class="flex gap-1.5"><dt>Confirmados</dt><dd class="font-bold text-ink tabular-nums">{counts.confirmedToday}</dd></div>
            {has("reminders") && (
              <div class="flex gap-1.5"><dt>Sem resposta</dt><dd class="font-bold text-ink tabular-nums">{counts.unansweredReminders}</dd></div>
            )}
            <div class="flex gap-1.5"><dt>Já atendidos</dt><dd class="font-bold text-ink tabular-nums">{counts.completedToday}</dd></div>
          </dl>
        </>
      )
    }
  </section>

  <section aria-labelledby="precisa" class="mt-6 flex flex-col gap-2">
    <h2 id="precisa" class={sectionTitle}>Precisa de você</h2>
    {!hasPending && <p class="rounded-xl border border-line bg-white px-4 py-3.5 text-[15px] text-ink-soft">Nada pendente agora.</p>}
    {
      awaiting.length > 0 && (
        <a
          href="/admin/atendimento"
          class="flex items-center gap-4 rounded-xl border border-can-200 bg-can-50 px-4 py-3.5 text-can-800 no-underline hover:border-can-500 sm:px-5"
        >
          <span class="flex h-11 w-11 flex-none items-center justify-center rounded-full bg-can-500 font-display text-xl font-bold text-white">
            {awaiting.length}
          </span>
          <span class="flex min-w-0 flex-1 flex-col gap-0.5">
            <strong class="text-[17px]">{plural(awaiting.length, "conversa aguardando atendimento humano", "conversas aguardando atendimento humano")}</strong>
            <span class="text-[15px] text-ink-mid">{oldestWait}</span>
          </span>
          <span class="flex-none text-[15px] font-bold max-sm:hidden">Ver conversas ›</span>
        </a>
      )
    }
    {
      inProgress.length > 0 && (
        // Conversas que a clínica assumiu e ainda não devolveu ao bot (cliente, 27/out/2026).
        <Notice tone="warning" href="/admin/atendimento" linkLabel="Ver conversas">
          {inProgress.length === 1
            ? `A conversa com ${inProgressNames} está com a clínica e ainda não voltou ao bot.`
            : `${inProgress.length} conversas estão com a clínica e ainda não voltaram ao bot (${inProgressNames}).`}{" "}
          O bot não volta sozinho: ao terminar, use "Devolver ao bot" em Atendimento.
        </Notice>
      )
    }
    {
      counts.pendingAttendance > 0 && (
        <a
          href="/admin/consultas?tab=pendentes"
          class="flex items-center gap-4 rounded-xl border border-pend-200 bg-pend-50 px-4 py-3.5 text-pend-800 no-underline hover:border-pend-500 sm:px-5"
        >
          <span class="flex h-11 w-11 flex-none items-center justify-center rounded-full bg-pend-500 font-display text-xl font-bold text-white">
            {counts.pendingAttendance}
          </span>
          <span class="flex min-w-0 flex-1 flex-col gap-0.5">
            <strong class="text-[17px]">{plural(counts.pendingAttendance, "consulta para registrar presença", "consultas para registrar presença")}</strong>
            <span class="text-[15px] text-ink-mid">Já passaram e ainda estão sem "Compareceu" ou "Faltou".</span>
          </span>
          <span class="flex-none text-[15px] font-bold max-sm:hidden">Registrar ›</span>
        </a>
      )
    }
    {
      toReview && toReview.length > 0 && (
        <div class="flex flex-col rounded-xl border border-line bg-white p-3.5 sm:px-5 sm:py-[18px]">
          <h3 id="revisar" class="font-display text-[17px] leading-tight font-bold text-ink">
            Conferir contato <span class="font-sans text-sm font-semibold text-ink-soft">({toReview.length})</span>
          </h3>
          {/* "Como funciona?" (texto aprovado pelo cliente em 31/out/2026). */}
          <HowItWorks id="contatos-revisar" topic={relacionamento.comoFunciona.revisar} class="mt-1">
            <p class="text-sm text-ink-soft">Nos últimos {REVIEW_WINDOW_DAYS} dias, o bot deixou de marcar para estes números por um limite do contato.</p>
          </HowItWorks>
          <ul class="mt-2">
            {toReview.map((item) => (
              <li class="grid gap-x-4 gap-y-1 border-t border-[#e6ecea] py-3 first:border-t-0 sm:grid-cols-[minmax(0,1fr)_260px_150px_auto] sm:items-center">
                <span class="flex flex-wrap items-center gap-x-2 gap-y-1">
                  <a href={withReturn(`/admin/pacientes/contato/${item.contactId}`, here)} class="text-base font-semibold text-ink no-underline hover:text-brand hover:underline">
                    {item.name}
                  </a>
                  {item.phone && <PhoneLinks phone={item.phone} plain class="text-sm text-ink-soft" />}
                </span>
                <span class="text-[15px] text-ink">{BOT_LIMIT_LABELS[item.last.reason]}</span>
                <span class="text-sm text-ink-soft tabular-nums">
                  {formatInstant(item.last.at, clinic.timezone, "dd/MM HH:mm")}
                  {item.hits > 1 && ` · ${plural(item.hits, "vez", "vezes")}`}
                </span>
                {canReview && (
                  <form method="POST" action={`/api/admin/pacientes/contato/${item.contactId}`} class="max-sm:mt-1">
                    <input type="hidden" name="acao" value="revisado" />
                    <input type="hidden" name="voltar" value="painel" />
                    <Button
                      type="submit"
                      size="sm"
                      class="js-confirm-delete"
                      data-confirm-title="Marcar como revisado?"
                      data-confirm-message={`${item.name} sai desta lista. Se atingir um limite de novo, volta.`}
                      data-confirm-label="Revisado"
                    >
                      Revisado
                    </Button>
                  </form>
                )}
              </li>
            ))}
          </ul>
          {canReview && <ConfirmDeleteDialog />}
        </div>
      )
    }
  </section>

  <div class="h-20 sm:hidden" aria-hidden="true" />
  <div class="fixed inset-x-0 bottom-[calc(61px+env(safe-area-inset-bottom))] z-10 flex items-center gap-3 border-t border-line bg-white px-4 py-2.5 shadow-[0_-4px_14px_rgba(18,48,42,.08)] sm:hidden">
    <span class="min-w-0 flex-1 truncate text-base font-semibold text-ink">Meu dia</span>
    <Button href={withReturn("/admin/agenda/marcar", here)} variant="primary" class="h-12 px-6 text-base">Marcar consulta</Button>
  </div>
</AdminLayout>

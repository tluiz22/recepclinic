---
// Fase 9 — resumo do dia: lê só o `status` do Supabase (a única agenda desde
// a Fase 20). Ver plano, seção "Fase 9".
import { fetchReminderResponseReport } from "../../lib/metrics/data";
import AdminLayout from "../../layouts/AdminLayout.astro";
import Card from "../../components/admin/Card.astro";
import Icon from "../../components/admin/Icon.astro";
import type { IconName } from "../../components/admin/Icon.astro";
import { createClient } from "../../lib/supabase/server";
import { describeSendsAlert, fetchSendsAlert } from "../../lib/automaticSends";

const PENDING_WINDOW_DAYS = 60;

const supabase = createClient(Astro.request, Astro.cookies);

const now = new Date();

// Mesma técnica de "hoje" usada em getNextAvailableDates.ts/daily-summary.ts.
const todayStr = new Date(now.getTime() - 3 * 60 * 60 * 1000).toISOString().slice(0, 10);
const todayStart = new Date(`${todayStr}T00:00:00-03:00`);
const todayEnd = new Date(`${todayStr}T23:59:59.999-03:00`);

// "Presença não confirmada" (Fase 19; revisto na Fase 23 a pedido do
// cliente): lembretes enviados hoje ainda sem resposta — o mesmo número de
// "Não responderam" em Consultas › Lembretes, que o cartão abre. Antes do
// envio do dia fica 0.
const tomorrowStart = new Date(todayEnd.getTime() + 1);

const [{ data: todayRows }, { count: pendingCount }, reminderReport, sendsAlert] = await Promise.all([
  supabase
    .from("appointments")
    .select("appointment_type")
    .neq("status", "canceled")
    .gte("scheduled_at", todayStart.toISOString())
    .lte("scheduled_at", todayEnd.toISOString()),
  supabase
    .from("appointments")
    .select("id", { count: "exact", head: true })
    .in("status", ["scheduled", "confirmed"])
    .lt("scheduled_at", now.toISOString())
    .gte("scheduled_at", new Date(now.getTime() - PENDING_WINDOW_DAYS * 24 * 60 * 60 * 1000).toISOString()),
  fetchReminderResponseReport(supabase, todayStart, tomorrowStart),
  // Alerta de envios automáticos (Fase 22 · etapa 5).
  fetchSendsAlert(supabase, now),
]);

const sendsAlertLines = describeSendsAlert(sendsAlert);
// Alerta leva a médica à aba Envios de Métricas e a secretária à Agenda, onde
// ficam os botões de envio (Fase 23 · etapa 5).
const isMedica = Astro.locals.role === "medica";

const appointmentsToday = (todayRows ?? []).filter((row) => row.appointment_type !== "exam").length;
const examsToday = (todayRows ?? []).length - appointmentsToday;

// Redirecionado pelo middleware ao tentar abrir uma tela só da médica (Fase 14).
const accessDenied = Astro.url.searchParams.get("aviso") === "acesso_negado";

const shortcuts:{ label: string; href: string; icon: IconName }[] = [
  { label: "Agenda do dia", href: "/admin/agenda", icon: "calendar" },
  { label: "Marcar consulta", href: "/admin/agenda/marcar", icon: "plus" },
  { label: "Marcar exame", href: "/admin/agenda/marcar-exame", icon: "plus" },
  { label: "Registrar comparecimento", href: "/admin/consultas?tab=pendentes", icon: "check-circle" },
];
---

<AdminLayout title="Dashboard">
  <h1 class="text-2xl font-bold text-slate-900">Dashboard</h1>
  <p class="mt-2 text-slate-600">Resumo de hoje.</p>

  {
    accessDenied && (
      <p class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">
        Essa tela é de acesso exclusivo da médica.
      </p>
    )
  }

  {
    sendsAlertLines.length > 0 && (
      <a
        href={isMedica ? "/admin/metricas?tab=envios" : "/admin/agenda"}
        class="mt-4 block rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800 hover:bg-red-100"
      >
        {sendsAlertLines.map((line) => <p>⚠ {line}</p>)}
        <p class="mt-1 font-medium underline">{isMedica ? "Ver envios automáticos" : "Ver na Agenda"}</p>
      </a>
    )
  }

  <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <Card class="text-center">
      <p class="text-3xl font-bold text-sky-700">{appointmentsToday}</p>
      <p class="mt-1 text-sm text-slate-600">Consultas hoje</p>
    </Card>
    <Card class="text-center">
      <p class="text-3xl font-bold text-sky-700">{examsToday}</p>
      <p class="mt-1 text-sm text-slate-600">Exames hoje</p>
    </Card>
    <a href="/admin/consultas?tab=pendentes">
      <Card class="h-full text-center hover:border-sky-300 hover:bg-sky-50">
        <p class="text-3xl font-bold text-amber-600">{pendingCount ?? 0}</p>
        <p class="mt-1 text-sm text-slate-600">Comparecimento a registrar</p>
      </Card>
    </a>
    <a href="/admin/consultas?tab=lembretes&lista=sem_resposta">
      <Card class="h-full text-center hover:border-sky-300 hover:bg-sky-50">
        <p class="text-3xl font-bold text-amber-600">{reminderReport.noResponse}</p>
        <p class="mt-1 text-sm text-slate-600">Presença não confirmada</p>
      </Card>
    </a>
  </div>

  <h2 class="mt-8 text-sm font-semibold uppercase tracking-wide text-slate-500">Atalhos</h2>
  <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4">
    {
      shortcuts.map((shortcut) => (
        <a href={shortcut.href}>
          <Card class="flex h-full flex-col items-center gap-2 text-center hover:border-sky-300 hover:bg-sky-50">
            <Icon name={shortcut.icon} class="h-6 w-6 text-sky-700" />
            <span class="text-sm font-medium text-slate-700">{shortcut.label}</span>
          </Card>
        </a>
      ))
    }
  </div>
</AdminLayout>

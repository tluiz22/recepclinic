---
// Tela inicial (Fase 9 do piloto; banco novo na F4.1): números de hoje no dia
// da clínica, alerta de envios automáticos e atalhos. Cartões e atalhos seguem
// os itens liberados para a clínica (D11). Com o bot, "Contatos para revisar"
// (F9.6a): quem bateu um limite do bot nos últimos 7 dias e ainda não foi
// marcado como revisado (Recepção e Administrador marcam aqui ou no contato).
import AdminLayout from "../../layouts/AdminLayout.astro";
import Card from "../../components/admin/Card.astro";
import ConfirmDeleteDialog from "../../components/admin/ConfirmDeleteDialog.astro";
import FlashMessage from "../../components/admin/FlashMessage.astro";
import FormMessage from "../../components/admin/FormMessage.astro";
import { SECONDARY_BUTTON } from "../../components/admin/fieldStyles";
import Icon from "../../components/admin/Icon.astro";
import type { IconName } from "../../components/admin/Icon.astro";
import { createUserClient } from "../../lib/data/clients";
import { getDashboardCounts } from "../../lib/data/dashboard";
import { describeSendsAlert, getSendsAlert } from "../../lib/data/sends";
import { BOT_LIMIT_LABELS, listContactsToReview, REVIEW_WINDOW_DAYS } from "../../lib/data/whatsapp/botLimits";
import { formatInstant } from "../../lib/clinicTime";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const has = (feature: (typeof clinic.features)[number]) => clinic.features.includes(feature);

const [counts, sendsAlert, toReview] = await Promise.all([
  getDashboardCounts(db, clinic.clinicId, clinic.timezone),
  getSendsAlert(db, clinic.clinicId),
  has("whatsapp_bot") ? listContactsToReview(db, clinic.clinicId) : Promise.resolve(null),
]);
const sendsAlertLines = describeSendsAlert(sendsAlert);
const canReview = clinic.isPlatformStaff || clinic.roles.includes("admin") || clinic.roles.includes("reception");
// A aba Envios fica no Resumo do Dia, para toda a equipe (cliente, 05/out/2026).

const aviso = Astro.url.searchParams.get("aviso");
const NOTICES: Record<string, { tone: "warning" | "success"; text: string }> = {
  // Redirecionado pelo middleware: área sem acesso para o papel ou item não liberado.
  acesso_negado: { tone: "warning", text: "Essa tela não está disponível para o seu acesso." },
  senha_definida: { tone: "success", text: "Senha salva. Use-a nos próximos logins." },
};
const notice = aviso ? NOTICES[aviso] : undefined;

const shortcuts: { label: string; href: string; icon: IconName }[] = [
  { label: "Agenda do dia", href: "/admin/agenda", icon: "calendar" },
  { label: "Marcar", href: "/admin/agenda/marcar", icon: "plus" },
  { label: "Registrar comparecimento", href: "/admin/consultas?tab=pendentes", icon: "check-circle" },
];
---

<AdminLayout title="Início">
  <h1 class="text-2xl font-bold text-slate-900">Início</h1>
  <p class="mt-2 text-slate-600">Resumo de hoje.</p>

  {notice && <FormMessage tone={notice.tone}>{notice.text}</FormMessage>}
  <FlashMessage />

  {
    sendsAlertLines.length > 0 && (
      <a
        href="/admin/consultas?tab=envios"
        class="mt-4 block rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800 hover:bg-red-100"
      >
        {sendsAlertLines.map((line) => <p>⚠ {line}</p>)}
        <p class="mt-1 font-medium underline">Ver os envios</p>
      </a>
    )
  }

  <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <Card class="text-center">
      <p class="text-3xl font-bold text-sky-700">{counts.consultationsToday}</p>
      <p class="mt-1 text-sm text-slate-600">Consultas hoje</p>
    </Card>
    {
      has("exams") && (
        <Card class="text-center">
          <p class="text-3xl font-bold text-sky-700">{counts.examsToday}</p>
          <p class="mt-1 text-sm text-slate-600">Exames hoje</p>
        </Card>
      )
    }
    <a href="/admin/consultas?tab=pendentes">
      <Card class="h-full text-center hover:border-sky-300 hover:bg-sky-50">
        <p class="text-3xl font-bold text-amber-600">{counts.pendingAttendance}</p>
        <p class="mt-1 text-sm text-slate-600">Comparecimento a registrar</p>
      </Card>
    </a>
    {
      has("reminders") && (
        <a href="/admin/consultas?tab=lembretes&grupo=no_answer">
          <Card class="h-full text-center hover:border-sky-300 hover:bg-sky-50">
            <p class="text-3xl font-bold text-amber-600">{counts.unansweredReminders}</p>
            <p class="mt-1 text-sm text-slate-600">Presença não confirmada</p>
          </Card>
        </a>
      )
    }
  </div>

  {
    toReview && (
      <Card class="mt-6">
        <h2 class="font-semibold text-slate-900">Contatos para revisar</h2>
        <p class="mt-1 text-sm text-slate-600">
          Nos últimos {REVIEW_WINDOW_DAYS} dias, o bot deixou de marcar para estes números por um limite do contato.
        </p>
        {toReview.length === 0 ? (
          <p class="mt-2 text-sm text-slate-500">Nenhum.</p>
        ) : (
          <ul class="mt-2 divide-y divide-slate-100 text-sm">
            {toReview.map((item) => (
              <li class="flex flex-wrap items-center gap-x-3 gap-y-1 py-2">
                <a href={`/admin/pacientes/contato/${item.contactId}`} class="flex flex-1 flex-wrap items-center justify-between gap-x-3 gap-y-1 hover:text-sky-700">
                  <span class="font-medium text-slate-900">{item.name}</span>
                  <span class="text-slate-600">
                    {BOT_LIMIT_LABELS[item.last.reason]} · {formatInstant(item.last.at, clinic.timezone, "dd/MM HH:mm")}
                    {item.hits > 1 && ` · ${item.hits} vezes`}
                  </span>
                </a>
                {canReview && (
                  <form method="POST" action={`/api/admin/pacientes/contato/${item.contactId}`}>
                    <input type="hidden" name="acao" value="revisado" />
                    <input type="hidden" name="voltar" value="painel" />
                    <button
                      type="submit"
                      class={`${SECONDARY_BUTTON} js-confirm-delete py-1`}
                      data-confirm-title="Marcar como revisado?"
                      data-confirm-message={`${item.name} sai desta lista. Se atingir um limite de novo, volta.`}
                      data-confirm-label="Revisado"
                    >
                      Revisado
                    </button>
                  </form>
                )}
              </li>
            ))}
          </ul>
        )}
        {canReview && toReview.length > 0 && <ConfirmDeleteDialog />}
      </Card>
    )
  }

  <h2 class="mt-8 text-sm font-semibold uppercase tracking-wide text-slate-500">Atalhos</h2>
  <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4">
    {
      shortcuts.map((shortcut) => (
        <a href={shortcut.href}>
          <Card class="flex h-full flex-col items-center gap-2 text-center hover:border-sky-300 hover:bg-sky-50">
            <Icon name={shortcut.icon} class="h-6 w-6 text-sky-700" />
            <span class="text-sm font-medium text-slate-700">{shortcut.label}</span>
          </Card>
        </a>
      ))
    }
  </div>
</AdminLayout>

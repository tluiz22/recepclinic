---
// Agenda › Dia (F4.5; F5a, R3, cliente, 08/nov/2026): a grade do dia por horário, uma coluna por agenda, com todas as
// agendas a que a pessoa tem acesso (sem lembrar filtro). Até 7: colunas na largura toda e o filtro "Agenda". A partir
// de 8: Especialidade ou Profissional (um de cada vez, com busca), colunas agrupadas por especialidade e a barra de
// rolagem no topo. Filtro Situação (sem Origem). Na grade: atendimentos pela cor da situação, reserva do portal
// tracejada, bloqueio hachurado, turma e os horários livres (levam à Marcar). Tocar num atendimento abre o painel ao lado
// (R2: a agenda dele vai para a primeira coluna); a escolha fica no endereço (`sel`), para a atualização automática e o
// "Voltar" das ações a manterem. No celular, uma agenda por vez (M4).
import { withReturn } from "../../lib/returnPath";
import AdminLayout from "../../layouts/AdminLayout.astro";
import AgendaHeader from "../../components/admin/agenda/AgendaHeader.astro";
import AgendaGrid, { type GridItem } from "../../components/admin/agenda/AgendaGrid.astro";
import AgendaPhoneList from "../../components/admin/agenda/AgendaPhoneList.astro";
import ColumnPicker from "../../components/admin/agenda/ColumnPicker.astro";
import AppointmentCard from "../../components/admin/agenda/AppointmentCard.astro";
import AgendaPanel from "../../components/admin/agenda/AgendaPanel.astro";
import ConfirmDeleteDialog from "../../components/admin/ConfirmDeleteDialog.astro";
import { SITUATIONS, appointmentSituation, type Situation } from "../../components/admin/agenda/situationStyle";
import { serviceLook, serviceTints } from "../../components/admin/agenda/categoryStyle";
import Icon from "../../components/admin/Icon.astro";
import FlashMessage from "../../components/admin/FlashMessage.astro";
import FixNumberDialog from "../../components/admin/FixNumberDialog.astro";
import SendTracker from "../../components/admin/agenda/SendTracker.astro";
import Button from "../../components/admin/ui/Button.astro";
import Tag from "../../components/admin/ui/Tag.astro";
import { CONTROL } from "../../components/admin/ui/styles";
import { addDays, formatCalendarDate, formatInstant, isCalendarDate, localDateOf, localTimeOf, todayIn, weekdayOf } from "../../lib/clinicTime";
import { canAccessArea, isUuid } from "../../lib/clinicAccess";
import { createUserClient } from "../../lib/data/clients";
import { loadAgendaScope } from "../../lib/data/agenda/scope";
import { loadActorLabels } from "../../lib/data/agenda/trail";
import { listOpenBirthdateChecks } from "../../lib/data/portalBirthdate";
import { bookingOriginText } from "../../lib/bookingOrigin";
import { listFreeGaps, loadClinicHolidays } from "../../lib/data/agenda/slots";
import { listPortalHolds, loadSpecialtiesByProfessional, loadWindowSpans } from "../../lib/data/agenda/grid";
import { listNationalHolidays } from "../../lib/holidays";
import Notice from "../../components/admin/ui/Notice.astro";
import { buildDayItems, itemAgendaId, listAgendaAppointments, listAgendaBlocks, listNoShowStats, listOrigins } from "../../lib/data/agenda/view";
import { assignLanes, buildColumns, filterColumns, gridLines, gridRange, MANY_AGENDAS, specialtyOptions } from "../../lib/agendaGrid";
import { listReturnReady } from "../../lib/data/agenda/returnReady";
import { listServiceRefs } from "../../lib/data/config/services";
import { listPaymentStates } from "../../lib/data/payments";
import { activeWaitlistAppointmentIds } from "../../lib/data/waitlist/entries";
import { listGuidanceResendable } from "../../lib/data/whatsapp/guidance";
import { listPreparationResendable } from "../../lib/data/whatsapp/preparation";
import { listReminderActions } from "../../lib/data/whatsapp/reminders";
import { logError } from "../../lib/log";
import HowItWorks from "../../components/admin/ui/HowItWorks.astro";
import { agenda as ajudaAgenda } from "../../lib/ajuda/agenda";
import { capitalize, vocabularyFor } from "../../lib/vocabulary";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const now = new Date();
const today = todayIn(clinic.timezone, now);
const params = Astro.url.searchParams;
const dateParam = params.get("date");
const date = dateParam && isCalendarDate(dateParam) ? dateParam : today;

// Colunas: todas as agendas que a pessoa vê, agrupadas por especialidade; o filtro estreita (um de cada vez).
const [scope, specialtiesOf] = await Promise.all([
  loadAgendaScope(db, clinic.clinicId, Astro.url),
  loadSpecialtiesByProfessional(db, clinic.clinicId).catch((error: unknown) => {
    logError("agenda: especialidades não carregaram", error, { clinica: clinic.clinicId });
    return new Map<string, string[]>();
  }),
]);
const many = scope.selectable.length >= MANY_AGENDAS;
const allColumns = buildColumns(scope.agendas, specialtiesOf);
const filtered = filterColumns(allColumns, { specialty: many ? params.get("esp") : null, agendaId: scope.selectedAgendaId });
const specialty = filtered.filter.specialty;
const chosenAgendaId = filtered.filter.agendaId;
const visibleIds = filtered.columns.map((c) => c.id);
const agendaNames = scope.agendaNames;

const SITUATION_FILTERS: Situation[] = ["pending", "confirmed", "attended", "no_show", "canceled"];
const situationParam = params.get("situacao");
const situation = SITUATION_FILTERS.find((s) => s === situationParam) ?? null;

const range = { fromDate: date, toDate: date, timeZone: clinic.timezone, agendaIds: visibleIds };
// Horário livre (RX8) e reservas do portal: se a leitura falhar, a Agenda abre sem eles.
const [allAppointments, blocks, serviceRefs, gaps, holds, windowSpans] = await Promise.all([
  listAgendaAppointments(db, clinic.clinicId, range),
  listAgendaBlocks(db, clinic.clinicId, { ...range, agendaNames }),
  listServiceRefs(db, clinic.clinicId),
  situation
    ? Promise.resolve([])
    : listFreeGaps(db, clinic.clinicId, { date, agendaIds: visibleIds, timeZone: clinic.timezone }, now).catch((error: unknown) => {
        logError("agenda: horários livres não carregaram", error, { clinica: clinic.clinicId });
        return [];
      }),
  situation
    ? Promise.resolve([])
    : listPortalHolds(db, clinic.clinicId, range, now).catch((error: unknown) => {
        logError("agenda: reservas do portal não carregaram", error, { clinica: clinic.clinicId });
        return [];
      }),
  loadWindowSpans(db, clinic.clinicId, visibleIds, weekdayOf(date)).catch(() => []),
]);
const appointments = situation ? allAppointments.filter((a) => appointmentSituation(a) === situation) : allAppointments;
const tints = serviceTints(serviceRefs);
// Horário em reserva: a reserva aparece no lugar do "Livre".
// Na agenda de Exames a reserva só segura o mesmo exame (20270108140000): lá o "Livre" fica (os outros exames marcam).
const teamAgendas = new Set(scope.agendas.filter((a) => a.kind === "resource").map((a) => a.id));
const openGaps = gaps.filter((gap) => teamAgendas.has(gap.agendaId) || !holds.some((h) => h.agendaId === gap.agendaId && h.start < gap.end && h.end > gap.start));
const items = buildDayItems(appointments, situation ? [] : blocks, openGaps.map((gap) => ({ ...gap, agendaName: agendaNames.get(gap.agendaId) ?? "" })));

const activeFuture = appointments.filter((a) => (a.status === "scheduled" || a.status === "confirmed") && a.scheduledAt > now).map((a) => a.id);
const examsFuture = appointments.filter((a) => a.category === "exam" && activeFuture.includes(a.id)).map((a) => a.id);
const waitlistOn = clinic.features.includes("waitlist");
const consultationsFuture = appointments.filter((a) => a.category === "consultation" && activeFuture.includes(a.id)).map((a) => a.id);
// Módulo financeiro (F11.2): selo e botão "Pagamento", para quem tem a área.
const financeOn = canAccessArea(clinic, "finance");
const [reminderActions, preparationResendable, guidanceResendable, onWaitlist, noShows, origins, paymentStates, returnReady, actors, birthdateChecks] = await Promise.all([
  listReminderActions(db, clinic.clinicId, activeFuture, now),
  clinic.features.includes("exams") ? listPreparationResendable(db, clinic.clinicId, examsFuture) : Promise.resolve(new Set<string>()),
  listGuidanceResendable(db, clinic.clinicId, consultationsFuture),
  waitlistOn ? activeWaitlistAppointmentIds(db, clinic.clinicId, activeFuture) : Promise.resolve(new Set<string>()),
  listNoShowStats(db, clinic.clinicId, appointments.map((a) => a.patientId)),
  listOrigins(db, clinic.clinicId, appointments),
  financeOn ? listPaymentStates(db, clinic.clinicId, appointments.map((a) => a.id)) : Promise.resolve(null),
  listReturnReady(db, clinic.clinicId, appointments, clinic.timezone, now),
  // Origem no atendimento aberto (R2; F2c): quem da equipe marcou e as datas de nascimento a conferir (portal).
  loadActorLabels(db, clinic.clinicId, appointments.filter((a) => a.bookingChannel === "admin").map((a) => a.createdBy)),
  listOpenBirthdateChecks(db, clinic.clinicId, appointments.map((a) => a.patientId)),
]);
const actorName = (id: string | null) => {
  const label = id ? actors.get(id) : undefined;
  return label ? (label.isSupport ? "Suporte" : label.name.split(" ")[0]) : null;
};

const vocabulary = vocabularyFor(clinic.clinicProfile);

// Endereços: a mesma Agenda com o filtro trocado (o resto se mantém).
type Link = { date?: string; agenda?: string | null; esp?: string | null; situacao?: string | null; ver?: string | null; sel?: string | null };
const current: Required<Link> = { date, agenda: chosenAgendaId, esp: specialty, situacao: situation, ver: null, sel: null };
const link = (change: Link = {}) => {
  const next = { ...current, ...change };
  const query = new URLSearchParams();
  query.set("date", next.date);
  for (const key of ["agenda", "esp", "situacao", "ver", "sel"] as const) if (next[key]) query.set(key, next[key]!);
  return `/admin/agenda?${query}`;
};
const verParam = params.get("ver");
const base = link({ ver: verParam && isUuid(verParam) ? verParam : null });
const returnTo = base;
const sel = params.get("sel") ?? "";
// Depois de marcar, remarcar ou alterar (cliente, 05/nov/2026, opção C): o aviso do topo acompanha a confirmação.
const envio = params.get("envio");
const trackedAppointment = isUuid(envio) ? envio : null;
const itemKey = (item: (typeof items)[number]) =>
  item.kind === "appointment" ? item.appointment.id : item.kind === "group" ? `turma-${item.agendaId}-${item.start.getTime()}` : item.kind === "block" ? `bloqueio-${item.block.id}` : "";
const selHref = (key: string) => `${base}&sel=${encodeURIComponent(key)}`;
const selected = items.find((item) => item.kind !== "free" && itemKey(item) === sel);
const selectedColumnId = selected ? itemAgendaId(selected) : null;

// Bloqueio de vários dias: data junto do horário quando não é o dia aberto.
const blockTime = (d: Date) => formatInstant(d, clinic.timezone, localDateOf(d, clinic.timezone) === date ? "HH:mm" : "dd/MM HH:mm");
const time = (d: Date) => formatInstant(d, clinic.timezone, "HH:mm");
// Minutos do dia aberto (antes do dia = 0; depois = 24h).
const minuteOf = (d: Date) => {
  const day = localDateOf(d, clinic.timezone);
  if (day < date) return 0;
  if (day > date) return 24 * 60;
  const [h, m] = localTimeOf(d, clinic.timezone).split(":").map(Number);
  return h * 60 + m;
};

// Faixa de horas: o que aparece no dia (bloqueio de dia inteiro não estica a grade).
const spanOf = (item: { start: Date; end: Date }) => ({ start: minuteOf(item.start), end: Math.max(minuteOf(item.end), minuteOf(item.start) + 15) });
const mainSpans = [...items.filter((i) => i.kind !== "block").map(spanOf), ...holds.map(spanOf), ...windowSpans];
const blockSpans = items.filter((i) => i.kind === "block").map(spanOf).map((s) => ({ start: Math.max(s.start, 7 * 60), end: Math.min(s.end, 20 * 60) }));
const dayRange = gridRange(mainSpans.length ? mainSpans : blockSpans);
const clip = (s: { start: number; end: number }) => ({ start: Math.max(s.start, dayRange.start), end: Math.min(s.end, dayRange.end) });

const dayWord = date === today ? "hoje" : "no dia";
const columns = filtered.columns
  .map((column) => {
    const mine = items.filter((item) => itemAgendaId(item) === column.id);
    const mineHolds = holds.filter((h) => h.agendaId === column.id);
    const count = mine.reduce((n, item) => n + (item.kind === "appointment" ? (item.appointment.status === "canceled" && situation !== "canceled" ? 0 : 1) : item.kind === "group" ? item.appointments.filter((a) => a.status !== "canceled" || situation === "canceled").length : 0), 0);
    const raw: ((GridItem extends infer T ? (T extends GridItem ? Omit<T, "top" | "height" | "lane" | "lanes"> : never) : never) & { span: { start: number; end: number } })[] = [];
    for (const item of mine) {
      const span = clip(spanOf(item));
      if (span.end <= span.start) continue;
      if (item.kind === "free") {
        raw.push({
          kind: "free",
          key: `livre-${column.id}-${item.time}`,
          span,
          time: item.time,
          endTime: item.endTime,
          detail: item.group ? `${item.group.serviceName}, ${item.group.spots} ${item.group.spots === 1 ? "vaga" : "vagas"}` : "",
          href: withReturn(`/admin/agenda/marcar?date=${date}&agenda_id=${item.agendaId}&hora=${item.time}${item.group ? `&service_id=${item.group.serviceId}` : ""}`, returnTo),
        });
      } else if (item.kind === "appointment") {
        const a = item.appointment;
        const situationOf = appointmentSituation(a);
        raw.push({
          kind: "appointment",
          key: a.id,
          span,
          time: time(a.scheduledAt),
          title: a.patientName,
          detail: `${serviceLook(a.category).label}${a.isHomeVisit ? " · em casa" : ""}`,
          situation: situationOf,
          label: SITUATIONS[situationOf].label,
          href: selHref(a.id),
        });
      } else if (item.kind === "group") {
        const live = item.appointments.filter((a) => a.status !== "canceled").length;
        raw.push({ kind: "group", key: itemKey(item), span, time: time(item.start), title: `Turma · ${live} ${vocabulary.patients}`, detail: item.serviceName, href: selHref(itemKey(item)) });
      } else {
        raw.push({ kind: "block", key: itemKey(item), span, time: blockTime(item.start), title: `Bloqueado até ${blockTime(item.end)}`, detail: item.block.reason, href: selHref(itemKey(item)) });
      }
    }
    for (const hold of mineHolds) {
      const span = clip(spanOf(hold));
      if (span.end > span.start) raw.push({ kind: "hold", key: `reserva-${column.id}-${hold.start.getTime()}`, span, time: time(hold.start), until: time(hold.expiresAt) });
    }
    const lanes = assignLanes(raw.map((r) => r.span));
    const placed = raw.map(({ span, ...rest }, i) => ({ ...rest, top: span.start - dayRange.start, height: span.end - span.start, ...lanes[i] }) as GridItem);
    return { ...column, countText: count === 0 ? `nenhum ${dayWord}` : `${count} ${dayWord}`, items: placed, hasContent: mine.some((i) => i.kind !== "free") };
  })
  // Agenda desativada só aparece se tiver algo no dia.
  .filter((column) => column.isActive || column.hasContent);
const hasContent = columns.some((c) => c.hasContent);
const nowAt = date === today && minuteOf(now) >= dayRange.start && minuteOf(now) <= dayRange.end ? minuteOf(now) - dayRange.start : null;

// Celular: uma agenda por vez (`ver`), senão a do atendimento aberto, senão a primeira.
const phoneIndex = Math.max(0, columns.findIndex((c) => c.id === (verParam ?? selectedColumnId)));
const phoneColumn = columns[phoneIndex] ?? null;
const verLink = (id: string) => link({ ver: id });
const groupsOf = (list: typeof allColumns, href: (id: string) => string, currentId: string | null) => {
  const groups: { name: string | null; options: { label: string; terms?: string; href: string; current: boolean }[] }[] = [];
  for (const column of list) {
    let group = groups.find((g) => g.name === column.group);
    if (!group) groups.push((group = { name: column.group, options: [] }));
    // A busca também acha pelas outras especialidades do profissional.
    group.options.push({ label: column.name, terms: column.specialties.join(" "), href: href(column.id), current: column.id === currentId });
  }
  return groups;
};
const selectableColumns = allColumns.filter((c) => c.isActive);

const cardProps = (a: (typeof appointments)[number]) => ({
  appointment: a,
  tint: tints.get(a.serviceId),
  timeZone: clinic.timezone,
  now,
  showAgenda: false,
  agendaOnPhone: false,
  vocabulary,
  returnTo,
  reminderAction: reminderActions.get(a.id),
  preparationResendable: preparationResendable.has(a.id),
  guidanceResendable: guidanceResendable.has(a.id),
  waitlistOn,
  onWaitlist: onWaitlist.has(a.id),
  noShow: noShows.get(a.patientId),
  origin: a.originAppointmentId ? origins.get(a.originAppointmentId) : undefined,
  payment: paymentStates ? (paymentStates.get(a.id) ?? "none") : undefined,
  returnReady: returnReady.get(a.id),
});
// Feriado: a Agenda não mostra horários livres (a mesma regra do bot e do Marcar); um aviso diz por quê.
const holidayName =
  listNationalHolidays(Number(date.slice(0, 4))).find((h) => h.date === date)?.name ??
  ((await loadClinicHolidays(db, clinic.clinicId, date, date).catch(() => new Set<string>())).has(date) ? "feriado da clínica" : null);
const panelItems = items.filter((item) => item.kind !== "free");
const tomorrow = addDays(today, 1);
const dayText = date === today ? "Hoje" : date === tomorrow ? "Amanhã" : capitalize(formatCalendarDate(date, "EEE dd/MM"));
const title = `${formatCalendarDate(date, "EEEE").replace("-feira", "")}, ${formatCalendarDate(date, date.slice(0, 4) === today.slice(0, 4) ? "d 'de' MMMM" : "d 'de' MMMM 'de' yyyy")}`;
const panelProps = (a: (typeof appointments)[number]) => ({
  ...cardProps(a),
  returnTo: selHref(a.id),
  dayText,
  closeHref: base,
  bookedBy: bookingOriginText(a, clinic.timezone, actorName(a.createdBy)),
  birthdateToCheck: birthdateChecks.has(a.patientId),
});
const freeHref = withReturn(`/admin/agenda/livres?date=${date}${specialty ? `&esp=${encodeURIComponent(specialty)}` : ""}`, base);
const LEGEND = [
  { label: "Não confirmado", swatch: "border-pend-200 bg-pend-50" },
  { label: "Confirmado", swatch: "border-conf-200 bg-conf-50" },
  { label: "Compareceu", swatch: "border-att-200 bg-att-50" },
  { label: "Faltou", swatch: "border-ns-200 bg-ns-50" },
  { label: "Cancelado", swatch: "border-can-200 bg-can-50" },
];
---

<AdminLayout title="Agenda" autoRefresh edge>
  <AgendaHeader view="dia" date={date} agendas={scope.selectable} selectedAgendaId={chosenAgendaId} subtitle={title}>
    <div slot="nav" class="flex items-center gap-1.5">
      <Button href={link({ date: addDays(date, -1), ver: phoneColumn?.id ?? null })} aria-label="Dia anterior" class="w-9 px-0">
        <Icon name="chevron-left" class="h-5 w-5 shrink-0" strokeWidth={2.2} />
      </Button>
      <Button href={link({ date: today, ver: phoneColumn?.id ?? null })} aria-current={date === today ? "date" : undefined} class="px-3">Hoje</Button>
      <Button href={link({ date: addDays(date, 1), ver: phoneColumn?.id ?? null })} aria-label="Próximo dia" class="w-9 px-0">
        <Icon name="chevron-right" class="h-5 w-5 shrink-0" strokeWidth={2.2} />
      </Button>
    </div>
    {/* O dia é o título; tocar nele abre o calendário do aparelho para ir a outro dia. */}
    <form slot="title" method="GET" action="/admin/agenda" class="relative">
      {chosenAgendaId && <input type="hidden" name="agenda" value={chosenAgendaId} />}
      {specialty && <input type="hidden" name="esp" value={specialty} />}
      {situation && <input type="hidden" name="situacao" value={situation} />}
      {verParam && isUuid(verParam) && <input type="hidden" name="ver" value={verParam} />}
      <h1 class="font-display text-[18px] leading-tight font-bold whitespace-nowrap text-ink first-letter:uppercase xl:text-[19px]">{title}</h1>
      <label class="absolute inset-0 cursor-pointer rounded-md focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-brand" title="Escolher o dia">
        <span class="sr-only">Escolher o dia</span>
        <input type="date" name="date" value={date} data-autosubmit class="absolute inset-0 h-full w-full cursor-pointer opacity-0" />
      </label>
    </form>
    <Fragment slot="filters">
      {
        many ? (
          <div class="contents max-sm:hidden">
            <ColumnPicker
              id="filtro-especialidade"
              label="Especialidade"
              allText="todas"
              allHref={link({ esp: null, agenda: null })}
              groups={[{ name: null, options: specialtyOptions(allColumns).map((name) => ({ label: name, href: link({ esp: name, agenda: null }), current: name === specialty })) }]}
              currentText={specialty}
              searchPlaceholder="Buscar especialidade"
            />
            <ColumnPicker
              id="filtro-profissional"
              label="Profissional"
              allText="todos"
              allHref={link({ agenda: null, esp: null })}
              groups={groupsOf(selectableColumns, (id) => link({ agenda: id, esp: null }), chosenAgendaId)}
              currentText={chosenAgendaId ? (agendaNames.get(chosenAgendaId) ?? null) : null}
              searchPlaceholder="Nome ou especialidade"
            />
          </div>
        ) : (
          scope.selectable.length > 1 && (
            <form method="GET" action="/admin/agenda" class="max-sm:hidden">
              <input type="hidden" name="date" value={date} />
              {situation && <input type="hidden" name="situacao" value={situation} />}
              <label for="agenda_choice" class="sr-only">
                Agenda
              </label>
              <select id="agenda_choice" name="agenda" class={`${CONTROL} w-56`} data-autosubmit>
                <option value="" selected={!chosenAgendaId}>
                  Todas as agendas
                </option>
                {scope.selectable.map((agenda) => (
                  <option value={agenda.id} selected={agenda.id === chosenAgendaId}>
                    {agenda.name}
                  </option>
                ))}
              </select>
              <noscript>
                <button type="submit" class="ml-2 text-sm text-brand">
                  Ver
                </button>
              </noscript>
            </form>
          )
        )
      }
      <form method="GET" action="/admin/agenda">
        <input type="hidden" name="date" value={date} />
        {chosenAgendaId && <input type="hidden" name="agenda" value={chosenAgendaId} />}
        {specialty && <input type="hidden" name="esp" value={specialty} />}
        {phoneColumn && verParam && <input type="hidden" name="ver" value={phoneColumn.id} />}
        <label for="situacao" class="sr-only">
          Situação
        </label>
        <select id="situacao" name="situacao" class={`${CONTROL} w-48 ${situation ? "border-brand bg-conf-50" : ""}`} data-autosubmit>
          <option value="" selected={!situation}>
            Situação: todas
          </option>
          {SITUATION_FILTERS.map((s) => (
            <option value={s} selected={s === situation}>
              {SITUATIONS[s].label}
            </option>
          ))}
        </select>
        <noscript>
          <button type="submit" class="ml-2 text-sm text-brand">
            Ver
          </button>
        </noscript>
      </form>
      <Button href={freeHref} class="border-brand text-brand-ink sm:ml-auto max-sm:w-full max-sm:bg-conf-50">
        <Icon name="magnifying-glass" class="h-[18px] w-[18px]" strokeWidth={2.2} /> Próximos horários livres
      </Button>
    </Fragment>
  </AgendaHeader>

  <HowItWorks id="situacoes-dia" topic={ajudaAgenda.comoFunciona.situacoes} class="mt-2">
    <p class="text-[14.5px] text-ink-soft">Toque num atendimento para ver as ações. Nos horários livres, toque para marcar.</p>
  </HowItWorks>
  <FlashMessage />
  {trackedAppointment && <SendTracker appointmentId={trackedAppointment} />}
  {
    holidayName && (
      <Notice tone="info" class="mt-4">
        Feriado ({holidayName}): neste dia a Agenda não mostra horários livres e o bot não oferece horários. Para marcar assim mesmo, use "+ Marcar
        consulta".
      </Notice>
    )
  }

  <ul class="mt-3 flex flex-wrap gap-x-3.5 gap-y-1.5 text-[13.5px] text-ink-mid max-sm:hidden" aria-label="Legenda das cores">
    {
      LEGEND.map((l) => (
        <li class="flex items-center gap-1.5">
          <span class={`h-3.5 w-3.5 rounded border ${l.swatch}`} />
          {l.label}
        </li>
      ))
    }
    <li class="flex items-center gap-1.5"><span class="h-3.5 w-3.5 rounded border-2 border-dashed border-att-500"></span>Em reserva: paciente escolhendo no portal</li>
    <li class="flex items-center gap-1.5">
      <span class="h-3.5 w-3.5 rounded border border-blk-200" style="background-image:repeating-linear-gradient(135deg,var(--color-blk-100) 0 3px,var(--color-blk-50) 3px 6px)"></span>Bloqueado
    </li>
  </ul>

  <div class="mt-3 flex items-start gap-4 max-sm:mt-4">
    {
      columns.length === 0 ? (
        <p class="flex-1 rounded-xl border border-line bg-white px-4 py-5 text-[15px] text-ink-soft">Nenhuma agenda para mostrar.</p>
      ) : (
        <>
          <AgendaGrid columns={columns} lines={gridLines(dayRange)} minutes={dayRange.end - dayRange.start} nowAt={nowAt} many={many} selectedKey={sel} selectedColumnId={selectedColumnId} />
          <AgendaPhoneList
            column={phoneColumn}
            position={phoneIndex + 1}
            total={columns.length}
            prevHref={phoneIndex > 0 ? verLink(columns[phoneIndex - 1].id) : null}
            nextHref={phoneIndex < columns.length - 1 ? verLink(columns[phoneIndex + 1].id) : null}
            pickerGroups={groupsOf(columns, verLink, phoneColumn?.id ?? null)}
            allHref={base}
            clearHref={chosenAgendaId || specialty ? link({ agenda: null, esp: null, ver: phoneColumn?.id ?? null }) : null}
            selectedKey={sel}
          />
        </>
      )
    }
    {situation && !hasContent && <p class="sr-only" aria-live="polite">Nenhum atendimento com essa situação neste dia.</p>}

    <aside
      id="painel"
      aria-label="Atendimento selecionado"
      data-agenda-panel
      data-has-selection={selected ? "" : undefined}
      class="min-w-0 overflow-hidden rounded-xl border-2 border-brand bg-white [&:not([data-has-selection])]:hidden lg:sticky lg:top-4 lg:max-h-[calc(100vh-2rem)] lg:w-[372px] lg:shrink-0 lg:overflow-y-auto max-lg:fixed max-lg:inset-x-0 max-lg:bottom-0 max-lg:z-30 max-lg:max-h-[80vh] max-lg:overflow-y-auto max-lg:rounded-b-none max-lg:shadow-[0_-10px_30px_rgba(18,48,42,.2)]"
    >
      {
        panelItems.map((item) => {
          const key = itemKey(item);
          return (
            <div data-panel={key} hidden={key !== sel} class="h-full">
              {item.kind === "appointment" ? (
                <AgendaPanel {...panelProps(item.appointment)} />
              ) : item.kind === "group" ? (
                <div class="flex flex-col">
                  <p class="bg-[#f6e6da] px-[18px] py-1.5 text-[12.5px] font-bold tracking-[.04em] text-[#7a3d12] uppercase">Turma · {item.serviceName}</p>
                  <div class="flex items-center justify-between gap-2 border-b border-[#e7eeeb] px-[18px] py-3.5">
                    <strong class="text-base tabular-nums">{dayText}, {time(item.start)}–{time(item.end)} · {item.agendaName}</strong>
                    <a href={base} data-panel-close aria-label="Fechar" class="inline-flex min-h-8 items-center rounded-lg px-1.5 text-brand hover:bg-brand-soft">
                      <Icon name="x-mark" class="h-[18px] w-[18px]" strokeWidth={2.2} />
                    </a>
                  </div>
                  <div class="flex flex-col gap-1.5 px-[18px] py-4">
                    <h2 data-panel-title tabindex="-1" class="font-display text-[20px] font-bold outline-none">{item.appointments.filter((a) => a.status !== "canceled").length} {vocabulary.patients}</h2>
                    <Tag>{item.locationName}</Tag>
                    {item.appointments.map((a) => (
                      <AppointmentCard {...cardProps(a)} returnTo={selHref(key)} compact />
                    ))}
                  </div>
                </div>
              ) : (
                <div class="flex flex-col">
                  <p class="bg-blk-100 px-[18px] py-1.5 text-[12.5px] font-bold tracking-[.04em] text-blk-800 uppercase">Bloqueio</p>
                  <div class="flex items-center justify-between gap-2 border-b border-[#e7eeeb] px-[18px] py-3.5">
                    <strong class="text-base tabular-nums">{blockTime(item.start)} – {blockTime(item.end)} · {item.agendaName}</strong>
                    <a href={base} data-panel-close aria-label="Fechar" class="inline-flex min-h-8 items-center rounded-lg px-1.5 text-brand hover:bg-brand-soft">
                      <Icon name="x-mark" class="h-[18px] w-[18px]" strokeWidth={2.2} />
                    </a>
                  </div>
                  <div class="flex flex-col gap-3 px-[18px] py-4">
                    <h2 data-panel-title tabindex="-1" class="text-[17px] font-semibold text-blk-800 outline-none">{item.block.reason}</h2>
                    <div class="grid grid-cols-2 gap-2">
                      <Button size="sm" href={withReturn(`/admin/agenda/bloqueios/${item.block.id}`, returnTo)} class="w-full">
                        Editar
                      </Button>
                      <form method="POST" action={`/api/admin/agenda/bloqueios/${item.block.id}`} class="contents">
                        <input type="hidden" name="acao" value="remover" />
                        <input type="hidden" name="return_to" value={returnTo} />
                        <Button
                          type="submit"
                          size="sm"
                          variant="danger"
                          class="js-confirm-delete w-full"
                          data-confirm-title="Remover o bloqueio?"
                          data-confirm-message={`${item.block.reason}. Os horários voltam a ser oferecidos.`}
                          data-confirm-label="Remover"
                        >
                          Remover
                        </Button>
                      </form>
                    </div>
                  </div>
                </div>
              )}
            </div>
          );
        })
      }
    </aside>
  </div>
  <ConfirmDeleteDialog />
  <FixNumberDialog />

  <script>
    // Tocar num atendimento abre o painel, sem recarregar; o endereço guarda a escolha (`sel`), para a atualização
    // automática e o "Voltar" manterem o painel aberto. Fechar limpa a escolha. A grade ouve "agenda:select" para pôr
    // a agenda do atendimento na primeira coluna (R2).
    const panel = document.querySelector<HTMLElement>("[data-agenda-panel]");
    if (panel) {
      const show = (key: string) => {
        panel.querySelectorAll<HTMLElement>("[data-panel]").forEach((p) => (p.hidden = p.dataset.panel !== key));
        panel.toggleAttribute("data-has-selection", key !== "");
        document.querySelectorAll<HTMLElement>("[data-select]").forEach((row) => {
          const on = row.dataset.select === key;
          row.toggleAttribute("data-selected", on);
          if (on) row.setAttribute("aria-current", "true");
          else row.removeAttribute("aria-current");
        });
        const url = new URL(location.href);
        if (key) url.searchParams.set("sel", key);
        else url.searchParams.delete("sel");
        history.replaceState(null, "", url);
        document.dispatchEvent(new CustomEvent("agenda:select", { detail: key }));
        if (key) panel.querySelector<HTMLElement>(`[data-panel="${CSS.escape(key)}"] [data-panel-title]`)?.focus({ preventScroll: window.matchMedia("(min-width: 1024px)").matches });
      };
      document.addEventListener("click", (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
        const target = event.target as Element | null;
        const row = target?.closest<HTMLElement>("[data-select]");
        const close = target?.closest("[data-panel-close]");
        if (row) {
          event.preventDefault();
          show(row.dataset.select ?? "");
        } else if (close) {
          event.preventDefault();
          closePanel();
        }
      });
      // Fechar (botão ou Esc) devolve o foco ao atendimento na grade ou na lista do celular.
      const closePanel = () => {
        const key = new URL(location.href).searchParams.get("sel") ?? "";
        show("");
        [...document.querySelectorAll<HTMLElement>(`[data-select="${CSS.escape(key)}"]`)].find((el) => el.offsetParent !== null)?.focus();
      };
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && panel.hasAttribute("data-has-selection") && !document.querySelector("dialog[open], :popover-open")) closePanel();
      });
    }
  </script>
</AdminLayout>

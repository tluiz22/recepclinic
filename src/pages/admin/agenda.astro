---
// Agenda › Dia (F4.5): atendimentos, turmas e bloqueios do dia nas agendas
// escolhidas (todas por padrão, com o nome da agenda em cada um; cliente,
// 05/out/2026), com as ações de cada atendimento no cartão.
import { withReturn } from "../../lib/returnPath";
import AdminLayout from "../../layouts/AdminLayout.astro";
import AgendaHeader from "../../components/admin/agenda/AgendaHeader.astro";
import AppointmentCard from "../../components/admin/agenda/AppointmentCard.astro";
import ConfirmDeleteDialog from "../../components/admin/ConfirmDeleteDialog.astro";
import SituationLegend from "../../components/admin/agenda/SituationLegend.astro";
import { countSituations } from "../../components/admin/agenda/situationStyle";
import { serviceBesideCategory, serviceLook, serviceTints } from "../../components/admin/agenda/categoryStyle";
import Icon from "../../components/admin/Icon.astro";
import FlashMessage from "../../components/admin/FlashMessage.astro";
import Button from "../../components/admin/ui/Button.astro";
import StatusPill from "../../components/admin/ui/StatusPill.astro";
import Tag from "../../components/admin/ui/Tag.astro";
import DateStepper from "../../components/admin/ui/DateStepper.astro";
import { addDays, formatCalendarDate, formatInstant, isCalendarDate, localDateOf, todayIn } from "../../lib/clinicTime";
import { canAccessArea } from "../../lib/clinicAccess";
import { createUserClient } from "../../lib/data/clients";
import { loadAgendaScope } from "../../lib/data/agenda/scope";
import { buildDayItems, itemAgendaId, listAgendaAppointments, listAgendaBlocks, listNoShowStats, listOrigins } from "../../lib/data/agenda/view";
import { listReturnReady } from "../../lib/data/agenda/returnReady";
import { listServiceRefs } from "../../lib/data/config/services";
import { listPaymentStates } from "../../lib/data/payments";
import { activeWaitlistAppointmentIds } from "../../lib/data/waitlist/entries";
import { listGuidanceResendable } from "../../lib/data/whatsapp/guidance";
import { listPreparationResendable } from "../../lib/data/whatsapp/preparation";
import { listReminderActions } from "../../lib/data/whatsapp/reminders";
import { vocabularyFor } from "../../lib/vocabulary";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const now = new Date();
const today = todayIn(clinic.timezone, now);
const dateParam = Astro.url.searchParams.get("date");
const date = dateParam && isCalendarDate(dateParam) ? dateParam : today;

const scope = await loadAgendaScope(db, clinic.clinicId, Astro.url, Astro.cookies);
const range = { fromDate: date, toDate: date, timeZone: clinic.timezone, agendaIds: scope.agendaIds };
const [appointments, blocks, serviceRefs] = await Promise.all([
  listAgendaAppointments(db, clinic.clinicId, range),
  listAgendaBlocks(db, clinic.clinicId, { ...range, agendaNames: scope.agendaNames }),
  listServiceRefs(db, clinic.clinicId),
]);
// Cor de cada serviço na faixa do cartão (cliente, 19/out/2026).
const tints = serviceTints(serviceRefs);
const items = buildDayItems(appointments, blocks);

const activeFuture = appointments.filter((a) => (a.status === "scheduled" || a.status === "confirmed") && a.scheduledAt > now).map((a) => a.id);
const examsFuture = appointments.filter((a) => a.category === "exam" && activeFuture.includes(a.id)).map((a) => a.id);
const waitlistOn = clinic.features.includes("waitlist");
const consultationsFuture = appointments.filter((a) => a.category === "consultation" && activeFuture.includes(a.id)).map((a) => a.id);
// Módulo financeiro (F11.2): selo e botão "Pagamento", para quem tem a área.
const financeOn = canAccessArea(clinic, "finance");
const [reminderActions, preparationResendable, guidanceResendable, onWaitlist, noShows, origins, paymentStates, returnReady] = await Promise.all([
  listReminderActions(db, clinic.clinicId, activeFuture, now),
  clinic.features.includes("exams") ? listPreparationResendable(db, clinic.clinicId, examsFuture) : Promise.resolve(new Set<string>()),
  listGuidanceResendable(db, clinic.clinicId, consultationsFuture),
  waitlistOn ? activeWaitlistAppointmentIds(db, clinic.clinicId, activeFuture) : Promise.resolve(new Set<string>()),
  listNoShowStats(db, clinic.clinicId, appointments.map((a) => a.patientId)),
  listOrigins(db, clinic.clinicId, appointments),
  financeOn ? listPaymentStates(db, clinic.clinicId, appointments.map((a) => a.id)) : Promise.resolve(null),
  listReturnReady(db, clinic.clinicId, appointments, clinic.timezone, now),
]);

const vocabulary = vocabularyFor(clinic.clinicProfile);
// "Todas as agendas" com mais de uma: uma coluna por agenda, lado a lado
// (cliente, 05/out/2026). Agenda desativada só aparece se tiver algo no dia.
const byColumn = !scope.selectedAgendaId && scope.agendas.length > 1;
const columns = byColumn
  ? scope.agendas
      .map((agenda) => ({ ...agenda, items: items.filter((item) => itemAgendaId(item) === agenda.id) }))
      .filter((column) => column.isActive || column.items.length > 0)
  : [{ id: scope.selectedAgendaId ?? "", name: "", isActive: true, items }];
const returnTo = `/admin/agenda?date=${date}`;
// Celular com "Todas as agendas": lista única por horário, com o nome da agenda
// em cada cartão (cliente, 15/out/2026). As colunas viram uma lista só e cada
// item leva a posição dele no dia (a lista `items` já vem por horário).
const orderOf = (item: (typeof items)[number]) => (byColumn ? items.indexOf(item) : undefined);
const counts = countSituations(appointments, blocks.length);
const activeCount = appointments.filter((a) => a.status !== "canceled").length;
const subtitle = [
  formatCalendarDate(date, "EEEE, d 'de' MMMM 'de' yyyy"),
  `${activeCount} ${activeCount === 1 ? "atendimento" : "atendimentos"}${byColumn ? ` em ${columns.length} agendas` : ""}`,
].join(" · ");
// Bloqueio de vários dias: data junto do horário quando não é o dia aberto.
const blockTime = (d: Date) => formatInstant(d, clinic.timezone, localDateOf(d, clinic.timezone) === date ? "HH:mm" : "dd/MM HH:mm");
const time = (d: Date) => formatInstant(d, clinic.timezone, "HH:mm");
const cardProps = (a: (typeof appointments)[number]) => ({
  appointment: a,
  tint: tints.get(a.serviceId),
  timeZone: clinic.timezone,
  now,
  showAgenda: false,
  agendaOnPhone: byColumn,
  vocabulary,
  returnTo,
  reminderAction: reminderActions.get(a.id),
  preparationResendable: preparationResendable.has(a.id),
  guidanceResendable: guidanceResendable.has(a.id),
  waitlistOn,
  onWaitlist: onWaitlist.has(a.id),
  noShow: noShows.get(a.patientId),
  origin: a.originAppointmentId ? origins.get(a.originAppointmentId) : undefined,
  payment: paymentStates ? (paymentStates.get(a.id) ?? "none") : undefined,
  returnReady: returnReady.get(a.id),
});
---

<AdminLayout title="Agenda">
  <AgendaHeader view="dia" date={date} agendas={scope.selectable} selectedAgendaId={scope.selectedAgendaId} subtitle={subtitle}>
    <DateStepper
      slot="nav"
      action="/admin/agenda"
      date={date}
      prevHref={`/admin/agenda?date=${addDays(date, -1)}`}
      nextHref={`/admin/agenda?date=${addDays(date, 1)}`}
      todayHref={date !== today ? "/admin/agenda" : undefined}
    />
  </AgendaHeader>

  <FlashMessage />
  <SituationLegend counts={counts} class="mt-4" />

  {
    byColumn && (
      <div data-columns-top class="mt-4 hidden overflow-x-auto sm:block" aria-hidden="true">
        <div data-columns-top-inner class="h-px" />
      </div>
    )
  }
  <div data-columns-frame class={`relative ${byColumn ? "mt-1 sm:mt-1" : "mt-4"}`}>
    <div
      data-columns
      class={byColumn
        ? "flex flex-col gap-2.5 pb-2 sm:grid sm:auto-cols-[minmax(250px,1fr)] sm:grid-flow-col sm:items-start sm:gap-4 sm:overflow-x-auto"
        : "flex max-w-3xl flex-col gap-2.5 pb-2"}
    >
      {
        columns.map((column) => (
          <section class={byColumn ? "flex min-w-0 flex-col gap-2.5 max-sm:contents" : "contents"} aria-label={byColumn ? column.name : undefined}>
            {byColumn && (
              <div class="hidden items-baseline justify-between gap-2 border-b-2 border-line px-0.5 pt-1 pb-1.5 sm:flex">
                <h2 class="truncate text-base leading-snug font-bold text-ink">{column.name}</h2>
                <span class="text-[13px] whitespace-nowrap text-ink-soft">
                  {(() => {
                    // Como no título do dia: o cancelado não conta.
                    const live = (a: { status: string }) => (a.status === "canceled" ? 0 : 1);
                    const n = column.items.reduce((sum, item) => sum + (item.kind === "appointment" ? live(item.appointment) : item.kind === "group" ? item.appointments.reduce((t, a) => t + live(a), 0) : 0), 0);
                    const b = column.items.filter((item) => item.kind === "block").length;
                    return [n > 0 || b === 0 ? `${n} ${n === 1 ? "atendimento" : "atendimentos"}` : "", b > 0 ? `${b} ${b === 1 ? "bloqueio" : "bloqueios"}` : ""].filter(Boolean).join(" · ");
                  })()}
                </span>
              </div>
            )}
            {column.items.map((item) =>
              item.kind === "appointment" ? (
                <AppointmentCard {...cardProps(item.appointment)} order={orderOf(item)} />
              ) : item.kind === "group" ? (
                <article class="flex min-w-0 flex-col gap-1.5 rounded-xl border border-line bg-white px-3 pt-3 pb-2.5" style={orderOf(item) !== undefined ? `order: ${orderOf(item)}` : undefined}>
                  {/* Faixa do tipo, como no cartão do atendimento (1C; turma decidida pelo cliente, S-01, 19/out/2026). */}
                  {(() => {
                    const first = item.appointments[0];
                    if (!first) return null;
                    const category = first.category;
                    const style = serviceLook(category, tints.get(first.serviceId));
                    const service = serviceBesideCategory(item.serviceName, category);
                    return (
                      <div class={`-mx-3 -mt-3 mb-0.5 flex flex-wrap items-center gap-x-2 gap-y-0.5 rounded-t-[11px] border-b px-3 py-2 ${style.band}`}>
                        <span class={`inline-flex items-center gap-1.5 font-display text-[17px] leading-tight font-bold ${style.text}`}>
                          <Icon name={style.icon} class="h-[18px] w-[18px] shrink-0" strokeWidth={2.2} />
                          {style.label}
                        </span>
                        {service && <span class={`text-[15px] leading-snug sm:text-sm ${style.detail}`}>{service}</span>}
                      </div>
                    );
                  })()}
                  <div class="flex items-center justify-between gap-2">
                    <span class="text-base leading-tight font-bold whitespace-nowrap text-ink tabular-nums">
                      {time(item.start)} – {time(item.end)}
                    </span>
                    <span class="inline-flex items-center rounded-md bg-[#f6e6da] px-1.5 text-[13px] leading-normal font-semibold text-[#7a3d12]">Turma</span>
                  </div>
                  <p class="text-[15px] font-semibold text-ink">
                    {item.appointments.filter((a) => a.status !== "canceled").length} {vocabulary.patients}
                  </p>
                  <div class="flex flex-wrap gap-1.5">
                    {byColumn && <Tag strong class="sm:hidden">{item.agendaName}</Tag>}
                    <Tag>{item.locationName}</Tag>
                  </div>
                  <div class="mt-1 flex flex-col gap-1.5">
                    {item.appointments.map((a) => (
                      <AppointmentCard {...cardProps(a)} compact />
                    ))}
                  </div>
                </article>
              ) : (
                <article class="flex min-w-0 flex-col gap-1.5 rounded-xl border border-blk-200 border-l-[5px] border-l-blk-500 bg-blk-50 px-3 pt-3 pb-2.5" style={orderOf(item) !== undefined ? `order: ${orderOf(item)}` : undefined}>
                  <div class="flex items-center justify-between gap-2">
                    <span class="text-base leading-tight font-bold whitespace-nowrap text-ink tabular-nums">
                      {blockTime(item.start)} – {blockTime(item.end)}
                    </span>
                    <StatusPill situation="block" />
                  </div>
                  <p class="text-[15px] text-blk-800">{item.block.reason}</p>
                  {byColumn && (
                    <div class="flex flex-wrap gap-1.5 sm:hidden">
                      <Tag strong>{item.agendaName}</Tag>
                    </div>
                  )}
                  <div class="mt-0.5 flex items-center justify-between gap-1.5 border-t border-ink/10 pt-2.5 sm:pt-2">
                    <Button size="sm" href={withReturn(`/admin/agenda/bloqueios/${item.block.id}`, returnTo)}>
                      Editar
                    </Button>
                    <form method="POST" action={`/api/admin/agenda/bloqueios/${item.block.id}`} class="contents">
                      <input type="hidden" name="acao" value="remover" />
                      <input type="hidden" name="return_to" value={returnTo} />
                      <Button
                        type="submit"
                        size="sm"
                        variant="danger-quiet"
                        class="js-confirm-delete"
                        data-confirm-title="Remover o bloqueio?"
                        data-confirm-message={`${item.block.reason}. Os horários voltam a ser oferecidos.`}
                        data-confirm-label="Remover"
                      >
                        Remover
                      </Button>
                    </form>
                  </div>
                </article>
              ),
            )}
            {column.items.length === 0 && (
              <p class={`rounded-xl border border-dashed border-line-strong px-3 py-5 text-center text-[15px] text-ink-soft ${byColumn ? "hidden sm:block" : ""}`}>
                {byColumn ? "Nenhum atendimento." : "Nenhum atendimento neste dia."}
              </p>
            )}
          </section>
        ))
      }
      {byColumn && items.length === 0 && (
        <p class="rounded-xl border border-dashed border-line-strong px-3 py-5 text-center text-[15px] text-ink-soft sm:hidden">Nenhum atendimento neste dia.</p>
      )}
    </div>
  </div>
  <ConfirmDeleteDialog />

  <script>
    // Colunas por agenda: uma barra de rolagem também acima dos nomes
    // (cliente, 05/out/2026), andando junto com a de baixo, e uma sombra na
    // borda quando há mais agendas de lado (redesign, 15/out/2026).
    const top = document.querySelector<HTMLElement>("[data-columns-top]");
    const inner = document.querySelector<HTMLElement>("[data-columns-top-inner]");
    const columns = document.querySelector<HTMLElement>("[data-columns]");
    const frame = document.querySelector<HTMLElement>("[data-columns-frame]");
    if (top && inner && columns && frame) {
      const edges = () => {
        const max = columns.scrollWidth - columns.clientWidth;
        frame.toggleAttribute("data-more-left", columns.scrollLeft > 1);
        frame.toggleAttribute("data-more-right", columns.scrollLeft < max - 1);
      };
      const size = () => {
        inner.style.width = `${columns.scrollWidth}px`;
        top.hidden = columns.scrollWidth <= columns.clientWidth;
        edges();
      };
      let syncing = false;
      const follow = (from: HTMLElement, to: HTMLElement) => () => {
        if (syncing) return;
        syncing = true;
        to.scrollLeft = from.scrollLeft;
        requestAnimationFrame(() => (syncing = false));
      };
      top.addEventListener("scroll", follow(top, columns));
      columns.addEventListener("scroll", follow(columns, top));
      columns.addEventListener("scroll", edges, { passive: true });
      new ResizeObserver(size).observe(columns);
      size();
    }
  </script>

  <style>
    [data-columns-frame]::before,
    [data-columns-frame]::after {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0.5rem;
      width: 24px;
      pointer-events: none;
      opacity: 0;
      transition: opacity 150ms;
      z-index: 1;
    }
    [data-columns-frame]::before {
      left: 0;
      background: linear-gradient(to right, rgb(18 48 42 / 0.12), transparent);
    }
    [data-columns-frame]::after {
      right: 0;
      background: linear-gradient(to left, rgb(18 48 42 / 0.12), transparent);
    }
    [data-columns-frame][data-more-left]::before,
    [data-columns-frame][data-more-right]::after {
      opacity: 1;
    }
  </style>
</AdminLayout>

---
// Agenda › Dia (F4.5): atendimentos, turmas e bloqueios do dia nas agendas
// escolhidas (todas por padrão, com o nome da agenda em cada um; cliente,
// 05/out/2026), com as ações de cada atendimento no cartão.
import AdminLayout from "../../layouts/AdminLayout.astro";
import AgendaHeader from "../../components/admin/agenda/AgendaHeader.astro";
import AppointmentCard from "../../components/admin/agenda/AppointmentCard.astro";
import Badge from "../../components/admin/Badge.astro";
import Card from "../../components/admin/Card.astro";
import ConfirmDeleteDialog from "../../components/admin/ConfirmDeleteDialog.astro";
import FlashMessage from "../../components/admin/FlashMessage.astro";
import Icon from "../../components/admin/Icon.astro";
import { addDays, formatCalendarDate, formatInstant, isCalendarDate, todayIn } from "../../lib/clinicTime";
import { createUserClient } from "../../lib/data/clients";
import { loadAgendaScope } from "../../lib/data/agenda/scope";
import { buildDayItems, itemAgendaId, listAgendaAppointments, listAgendaBlocks, listNoShowStats, listOrigins } from "../../lib/data/agenda/view";
import { activeWaitlistAppointmentIds } from "../../lib/data/waitlist/entries";
import { listGuidanceResendable } from "../../lib/data/whatsapp/guidance";
import { listPreparationResendable } from "../../lib/data/whatsapp/preparation";
import { listReminderActions } from "../../lib/data/whatsapp/reminders";
import { vocabularyFor } from "../../lib/vocabulary";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const now = new Date();
const today = todayIn(clinic.timezone, now);
const dateParam = Astro.url.searchParams.get("date");
const date = dateParam && isCalendarDate(dateParam) ? dateParam : today;

const scope = await loadAgendaScope(db, clinic.clinicId, Astro.url, Astro.cookies);
const range = { fromDate: date, toDate: date, timeZone: clinic.timezone, agendaIds: scope.agendaIds };
const [appointments, blocks] = await Promise.all([
  listAgendaAppointments(db, clinic.clinicId, range),
  listAgendaBlocks(db, clinic.clinicId, { ...range, agendaNames: scope.agendaNames }),
]);
const items = buildDayItems(appointments, blocks);

const activeFuture = appointments.filter((a) => (a.status === "scheduled" || a.status === "confirmed") && a.scheduledAt > now).map((a) => a.id);
const examsFuture = appointments.filter((a) => a.category === "exam" && activeFuture.includes(a.id)).map((a) => a.id);
const waitlistOn = clinic.features.includes("waitlist");
const consultationsFuture = appointments.filter((a) => a.category === "consultation" && activeFuture.includes(a.id)).map((a) => a.id);
const [reminderActions, preparationResendable, guidanceResendable, onWaitlist, noShows, origins] = await Promise.all([
  listReminderActions(db, clinic.clinicId, activeFuture, now),
  clinic.features.includes("exams") ? listPreparationResendable(db, clinic.clinicId, examsFuture) : Promise.resolve(new Set<string>()),
  listGuidanceResendable(db, clinic.clinicId, consultationsFuture),
  waitlistOn ? activeWaitlistAppointmentIds(db, clinic.clinicId, activeFuture) : Promise.resolve(new Set<string>()),
  listNoShowStats(db, clinic.clinicId, appointments.map((a) => a.patientId)),
  listOrigins(db, clinic.clinicId, appointments),
]);

const vocabulary = vocabularyFor(clinic.clinicProfile);
// "Todas as agendas" com mais de uma: uma coluna por agenda, lado a lado
// (cliente, 05/out/2026). Agenda desativada só aparece se tiver algo no dia.
const byColumn = !scope.selectedAgendaId && scope.agendas.length > 1;
const columns = byColumn
  ? scope.agendas
      .map((agenda) => ({ ...agenda, items: items.filter((item) => itemAgendaId(item) === agenda.id) }))
      .filter((column) => column.isActive || column.items.length > 0)
  : [{ id: scope.selectedAgendaId ?? "", name: "", isActive: true, items }];
const returnTo = `/admin/agenda?date=${date}`;
const time = (d: Date) => formatInstant(d, clinic.timezone, "HH:mm");
const cardProps = (a: (typeof appointments)[number]) => ({
  appointment: a,
  timeZone: clinic.timezone,
  now,
  showAgenda: false,
  vocabulary,
  returnTo,
  reminderAction: reminderActions.get(a.id),
  preparationResendable: preparationResendable.has(a.id),
  guidanceResendable: guidanceResendable.has(a.id),
  waitlistOn,
  onWaitlist: onWaitlist.has(a.id),
  noShow: noShows.get(a.patientId),
  origin: a.originAppointmentId ? origins.get(a.originAppointmentId) : undefined,
  massCancelForm: MASS_CANCEL,
});
// Cancelamento em massa (F4.6): caixinhas nos cartões, ligadas a este formulário.
const MASS_CANCEL = "cancelar_selecionados";
const hasMassCancel = activeFuture.length > 0;
const groupActiveIds = (group: { appointments: typeof appointments }) =>
  group.appointments.filter((a) => activeFuture.includes(a.id)).map((a) => a.id);
---

<AdminLayout title="Agenda">
  <AgendaHeader view="dia" date={date} agendas={scope.selectable} selectedAgendaId={scope.selectedAgendaId} />

  <form method="GET" action="/admin/agenda" class="mt-4 flex items-center gap-1 rounded-lg border border-slate-200 bg-white p-2 sm:inline-flex">
    <a href={`/admin/agenda?date=${addDays(date, -1)}`} aria-label="Dia anterior" class="rounded-md p-2 text-slate-500 hover:bg-slate-100 hover:text-sky-700">
      <Icon name="chevron-left" class="h-5 w-5" />
    </a>
    <input type="date" name="date" value={date} onchange="this.form.submit()" class="min-w-0 flex-1 rounded-md border border-slate-300 px-3 py-2 text-sm sm:flex-none" />
    <a href={`/admin/agenda?date=${addDays(date, 1)}`} aria-label="Próximo dia" class="rounded-md p-2 text-slate-500 hover:bg-slate-100 hover:text-sky-700">
      <Icon name="chevron-right" class="h-5 w-5" />
    </a>
    {
      date !== today && (
        <a href="/admin/agenda" class="ml-1 shrink-0 rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50">
          Hoje
        </a>
      )
    }
  </form>
  <p class="mt-2 text-sm capitalize text-slate-600">{formatCalendarDate(date, "EEEE, d 'de' MMMM 'de' yyyy")}</p>
  <FlashMessage />

  {
    hasMassCancel && (
      <form id={MASS_CANCEL} method="POST" action="/api/admin/agenda/cancelar-selecionados" class="mt-4 flex flex-wrap items-center justify-between gap-3">
        <input type="hidden" name="return_to" value={returnTo} />
        <div class="flex gap-3 text-sm">
          <button type="button" data-select="all" class="text-sky-700 hover:underline">
            Selecionar todos
          </button>
          <button type="button" data-select="none" class="text-sky-700 hover:underline">
            Selecionar nenhum
          </button>
        </div>
        <button
          type="submit"
          data-mass-cancel-submit
          disabled
          class="js-confirm-delete rounded-md border border-red-300 bg-white px-3 py-2 text-sm font-semibold text-red-700 hover:bg-red-50 disabled:cursor-not-allowed disabled:opacity-50"
          data-confirm-title="Cancelar os atendimentos selecionados?"
          data-confirm-message="Os selecionados serão cancelados pela clínica. Cada paciente recebe a mensagem pelo WhatsApp da clínica, com o link para remarcar."
          data-confirm-label="Cancelar atendimentos"
        >
          Cancelar selecionados (<span data-mass-cancel-count>0</span>)
        </button>
      </form>
    )
  }

  {
    byColumn && (
      <div data-columns-top class="-mx-4 mt-4 overflow-x-auto px-4" aria-hidden="true">
        <div data-columns-top-inner class="h-px" />
      </div>
    )
  }
  <div data-columns class={byColumn ? "-mx-4 mt-1 flex gap-3 overflow-x-auto px-4 pb-2" : "mt-4"}>
    {
      columns.map((column) => (
        <section class={byColumn ? "flex w-80 shrink-0 flex-col gap-3" : "flex flex-col gap-3"}>
          {byColumn && <h2 class="rounded-md bg-slate-100 px-3 py-2 text-sm font-semibold text-slate-800">{column.name}</h2>}
    {
      column.items.map((item) =>
        item.kind === "appointment" ? (
          <AppointmentCard {...cardProps(item.appointment)} />
        ) : item.kind === "group" ? (
          <Card>
            <div class="flex flex-wrap items-center justify-between gap-2">
              <label class="flex items-center gap-2">
                {groupActiveIds(item).length > 0 && (
                  <input
                    type="checkbox"
                    form={MASS_CANCEL}
                    name="ids"
                    value={groupActiveIds(item).join(",")}
                    class="js-mass-cancel h-4 w-4 rounded border-slate-300"
                    aria-label="Selecionar a turma inteira para cancelar"
                  />
                )}
                <span class="text-base font-semibold text-slate-900">
                  {time(item.start)} – {time(item.end)}
                </span>
              </label>
              <Badge variant="warning">Turma</Badge>
            </div>
            <p class="mt-2 text-sm font-medium text-slate-900">
              {item.serviceName} · {item.appointments.filter((a) => a.status !== "canceled").length} {vocabulary.patients}
            </p>
            <p class="text-sm text-slate-500">
              {item.locationName}
            </p>
            <div class="mt-3 flex flex-col gap-2">
              {item.appointments.map((a) => (
                <AppointmentCard {...cardProps(a)} massCancelForm={undefined} compact />
              ))}
            </div>
          </Card>
        ) : (
          <Card>
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="text-base font-semibold text-slate-900">
                {formatInstant(item.start, clinic.timezone, "dd/MM HH:mm")} – {formatInstant(item.end, clinic.timezone, "dd/MM HH:mm")}
              </span>
              <Badge variant="strong">Bloqueio</Badge>
            </div>
            <p class="mt-2 text-sm text-slate-600">{item.block.reason}</p>
            <div class="mt-3 flex flex-wrap gap-2 border-t border-slate-100 pt-3">
              <a href={`/admin/agenda/bloqueios/${item.block.id}`} class="inline-flex items-center gap-1 rounded-md border border-slate-300 bg-white px-2.5 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50">
                Editar
              </a>
              <form method="POST" action={`/api/admin/agenda/bloqueios/${item.block.id}`}>
                <input type="hidden" name="acao" value="remover" />
                <input type="hidden" name="return_to" value={returnTo} />
                <button
                  type="submit"
                  class="js-confirm-delete inline-flex items-center gap-1 rounded-md border border-red-300 bg-white px-2.5 py-1.5 text-xs font-semibold text-red-700 hover:bg-red-50"
                  data-confirm-title="Remover o bloqueio?"
                  data-confirm-message={`${item.block.reason}. Os horários voltam a ser oferecidos.`}
                  data-confirm-label="Remover"
                >
                  Remover
                </button>
              </form>
            </div>
          </Card>
        ),
      )
    }
          {column.items.length === 0 && <Card class="text-center text-sm text-slate-500">{byColumn ? "Nenhum atendimento." : "Nenhum atendimento neste dia."}</Card>}
        </section>
      ))
    }
  </div>
  <ConfirmDeleteDialog />

  <script>
    // Cancelamento em massa: conta os selecionados e liga o botão.
    const massBoxes = [...document.querySelectorAll<HTMLInputElement>(".js-mass-cancel")];
    const massSubmit = document.querySelector<HTMLButtonElement>("[data-mass-cancel-submit]");
    const massCount = document.querySelector<HTMLElement>("[data-mass-cancel-count]");
    const countSelected = () => {
      const total = massBoxes.filter((b) => b.checked).reduce((sum, b) => sum + b.value.split(",").length, 0);
      if (massCount) massCount.textContent = String(total);
      if (massSubmit) massSubmit.disabled = total === 0;
    };
    massBoxes.forEach((b) => b.addEventListener("change", countSelected));
    document.querySelectorAll<HTMLButtonElement>("[data-select]").forEach((button) =>
      button.addEventListener("click", () => {
        massBoxes.forEach((b) => (b.checked = button.dataset.select === "all"));
        countSelected();
      }),
    );
    countSelected();
  </script>

  <script>
    // Colunas por agenda: uma barra de rolagem também acima dos nomes
    // (cliente, 05/out/2026), andando junto com a de baixo.
    const top = document.querySelector<HTMLElement>("[data-columns-top]");
    const inner = document.querySelector<HTMLElement>("[data-columns-top-inner]");
    const columns = document.querySelector<HTMLElement>("[data-columns]");
    if (top && inner && columns) {
      const size = () => {
        inner.style.width = `${columns.scrollWidth}px`;
        top.hidden = columns.scrollWidth <= columns.clientWidth;
      };
      let syncing = false;
      const follow = (from: HTMLElement, to: HTMLElement) => () => {
        if (syncing) return;
        syncing = true;
        to.scrollLeft = from.scrollLeft;
        requestAnimationFrame(() => (syncing = false));
      };
      top.addEventListener("scroll", follow(top, columns));
      columns.addEventListener("scroll", follow(columns, top));
      new ResizeObserver(size).observe(columns);
      size();
    }
  </script>
</AdminLayout>

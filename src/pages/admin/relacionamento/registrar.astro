---
// Relacionamento › Registrar contato (CRM C2, cliente, 28/out/2026): o que
// aconteceu quando a equipe procurou alguém de uma pendência (as 7 opções da
// Q7 e da Q10). "Marcou" só com um atendimento ativo achado pelo sistema;
// Lembretes e Aguardando remarcação ficam sem ele. Volta para a tela de onde
// veio (a aba da central ou a ficha do paciente).
import AdminLayout from "../../../layouts/AdminLayout.astro";
import FlashMessage from "../../../components/admin/FlashMessage.astro";
import Icon from "../../../components/admin/Icon.astro";
import PhoneLinks from "../../../components/admin/PhoneLinks.astro";
import Button from "../../../components/admin/ui/Button.astro";
import PageHeader from "../../../components/admin/ui/PageHeader.astro";
import { CONTROL } from "../../../components/admin/ui/styles";
import { formatInstant } from "../../../lib/clinicTime";
import { createUserClient } from "../../../lib/data/clients";
import { exitsList, NOTE_MAX, OUTCOME_LABEL, parseRegisterRequest, registerParams, resolveRegisterTarget, type LoggedSource } from "../../../lib/data/contactInteractions";
import { RELATIONSHIP_TABS } from "../../../lib/data/relationship";
import { receivedReturn, returnLabel } from "../../../lib/returnPath";
import { capitalize, vocabularyFor } from "../../../lib/vocabulary";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const vocabulary = vocabularyFor(clinic.clinicProfile);
const volta = receivedReturn(Astro.url) ?? "/admin/relacionamento";
const req = parseRegisterRequest((name) => Astro.url.searchParams.get(name));
const target = req ? await resolveRegisterTarget(db, clinic.clinicId, req).catch(() => null) : null;
if (!req || !target) return Astro.redirect(volta);

const sourceLabel = (source: LoggedSource) =>
  source === "ficha_paciente" ? `Ficha do ${vocabulary.patient}` : (RELATIONSHIP_TABS.find((t) => t.id === source)?.label ?? "");
const who = target.patientName ?? target.contactName ?? `${capitalize(vocabulary.contact)} sem cadastro`;
const hint = (outcome: (typeof target.options)[number]) => {
  if (outcome === "scheduled") {
    return target.booked
      ? `Atendimento em ${formatInstant(target.booked.scheduledAt, clinic.timezone, "dd/MM 'às' HH:mm")}.${exitsList(target.source, outcome) ? " Sai da lista." : ""}`
      : "Ainda não há atendimento marcado para este contato.";
  }
  if (target.source === "ficha_paciente") return null;
  if (exitsList(target.source, outcome)) return "Sai da lista.";
  if (outcome === "link_sent") return 'Continua na lista, com "link enviado".';
  return target.source === "aguardando_remarcacao" ? "Continua na lista até remarcar ou desistir." : "Continua na lista, com a tentativa.";
};
const radio = "flex items-start gap-2.5 rounded-lg border border-line px-3 py-2.5 text-[15px] text-ink has-[:checked]:border-brand has-[:checked]:bg-brand-soft has-[:disabled]:opacity-60";
---

<AdminLayout title="Registrar contato">
  <a href={volta} class="inline-flex min-h-8 items-center gap-1 text-[15px] font-semibold text-brand no-underline hover:underline">
    <Icon name="chevron-left" class="h-[18px] w-[18px]" strokeWidth={2.2} />
    {returnLabel(volta)}
  </a>
  <PageHeader title="Registrar contato" class="mt-2" />
  <FlashMessage />

  <form method="POST" action="/api/admin/relacionamento/registro" class="mt-3 flex max-w-2xl flex-col gap-4 rounded-xl border border-line bg-white p-4 sm:p-5">
    {Object.entries(registerParams(req)).map(([name, value]) => <input type="hidden" name={name} value={value} />)}
    <input type="hidden" name="return_to" value={volta} />

    <div class="flex flex-col gap-0.5">
      <p class="text-[17px] font-bold text-ink">{who}</p>
      {target.patientName && target.contactName && target.contactName !== target.patientName && (
        <p class="text-[15px] text-ink-soft">{capitalize(vocabulary.contact)}: {target.contactName}</p>
      )}
      <p class="text-[15px] text-ink-soft"><PhoneLinks phone={target.phone} plain /></p>
      <p class="text-[13px] text-ink-soft">{sourceLabel(target.source)}</p>
    </div>

    <fieldset class="flex flex-col gap-2">
      <legend class="mb-1.5 text-[14.5px] font-semibold text-ink">O que aconteceu?</legend>
      {target.options.map((outcome) => {
        const disabled = outcome === "scheduled" && !target.booked;
        const text = hint(outcome);
        return (
          <label class={radio}>
            <input type="radio" name="outcome" value={outcome} required disabled={disabled} class="mt-0.5 h-[18px] w-[18px] shrink-0 accent-brand" />
            <span class="flex flex-col">
              <span class="font-semibold">{OUTCOME_LABEL[outcome]}</span>
              {text && <span class="text-[13.5px] text-ink-soft">{text}</span>}
            </span>
          </label>
        );
      })}
    </fieldset>

    <div class="flex flex-col gap-1.5">
      <label for="note" class="text-[14.5px] font-semibold text-ink">Observação</label>
      <textarea id="note" name="note" rows="3" maxlength={NOTE_MAX} aria-describedby="note-hint" class={`${CONTROL} h-auto! py-2.5`}></textarea>
      <p id="note-hint" class="text-sm text-ink-soft">Opcional; obrigatória em "Outro". Só a equipe vê.</p>
    </div>

    <div class="flex flex-wrap gap-2">
      <Button type="submit" variant="primary">Registrar</Button>
      <Button href={volta}>Cancelar</Button>
    </div>
  </form>
</AdminLayout>

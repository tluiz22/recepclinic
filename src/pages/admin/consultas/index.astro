---
// Resumo do Dia (F4.8), no banco novo, com as abas do piloto: Resumo do dia
// (só informação), Lembretes (item), Lista de espera (item), Aguardando
// remarcação, A registrar, Registradas e Envios (cliente, 05/out/2026: aqui,
// para toda a equipe; com o lembrete ou o resumo do dia liberado). Tudo das
// agendas que a pessoa vê (o Profissional, só as próprias).
// Redesign do Relatório do dia, opção C (cliente, 02/nov/2026): três abas. Resumo do dia (linhas curtas), Lembretes
// (como antes) e A registrar (linhas com Compareceu e Faltou, a mais antiga primeiro). Saíram Lista de espera e
// Aguardando remarcação (estão em Pacientes › Para contatar), Registradas (corrigir pela Agenda) e Envios (só o
// Suporte, até a tela de pendências do Suporte; docs/painel-suporte.md). Os endereços antigos levam ao lugar novo.
import AdminLayout from "../../../layouts/AdminLayout.astro";
import CardActionButton from "../../../components/admin/agenda/CardActionButton.astro";
import { cardActions } from "../../../components/admin/agenda/cardActions";
import { isAnonymizedPhone } from "../../../lib/anonymization";
import { formatPhoneBR } from "../../../lib/phone";
import { withReturn } from "../../../lib/returnPath";
import ConfirmDeleteDialog from "../../../components/admin/ConfirmDeleteDialog.astro";
import FlashMessage from "../../../components/admin/FlashMessage.astro";
import HowItWorks from "../../../components/admin/ui/HowItWorks.astro";
import { resumo as ajudaResumo } from "../../../lib/ajuda/resumo";
import EnviosTab from "../../../components/admin/resumo/EnviosTab.astro";
import LembretesTab from "../../../components/admin/resumo/LembretesTab.astro";
import ResumoDia from "../../../components/admin/resumo/ResumoDia.astro";
import Button from "../../../components/admin/ui/Button.astro";
import type { TabItem } from "../../../components/admin/ui/Tabs.astro";
import { addDays, formatCalendarDate, formatInstant, isCalendarDate, localDateOf, todayIn } from "../../../lib/clinicTime";
import { canAccessArea } from "../../../lib/clinicAccess";
import { createUserClient } from "../../../lib/data/clients";
import { loadActorLabels } from "../../../lib/data/agenda/trail";
import { listAgendaAppointments, type AgendaAppointment } from "../../../lib/data/agenda/view";
import { listAgendas } from "../../../lib/data/config/agendas";
import { getResumoTabCounts, listPendingAttendance, listRemindersOfDay } from "../../../lib/data/daily";
import { describeSendsAlert, getSendsAlert, listAppointmentsWithFailedSends, listJobRuns } from "../../../lib/data/sends";
import { listServiceRefs } from "../../../lib/data/config/services";
import { serviceTags } from "../../../components/admin/agenda/categoryStyle";
import { vocabularyFor } from "../../../lib/vocabulary";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const vocabulary = vocabularyFor(clinic.clinicProfile);
const params = Astro.url.searchParams;
const has = (key: string) => clinic.features.includes(key as never);
const sendsOn = has("reminders") || has("daily_summary");

type Tab = "resumo" | "lembretes" | "pendentes" | "envios";
const tabs: { id: Tab; label: string; show: boolean }[] = [
  { id: "resumo", label: "Resumo do dia", show: true },
  { id: "lembretes", label: "Lembretes", show: has("reminders") },
  { id: "pendentes", label: "A registrar", show: true },
  { id: "envios", label: "Envios (Suporte)", show: sendsOn && clinic.isPlatformStaff },
];
// Abas que saíram: o endereço antigo leva ao lugar novo.
const asked = params.get("tab");
if (asked === "lista_espera" || asked === "aguardando_remarcacao") {
  return Astro.redirect(canAccessArea(clinic, "relationship") ? `/admin/pacientes/para-contatar?lista=${asked}` : "/admin/consultas");
}
if (asked === "confirmadas") return Astro.redirect("/admin/consultas?tab=pendentes");
const visible = tabs.filter((t) => t.show);
const tab: Tab = visible.find((t) => t.id === asked)?.id ?? "resumo";

const now = new Date();
const today = todayIn(clinic.timezone, now);
const date = isCalendarDate(params.get("date") ?? "") ? params.get("date")! : today;
const agendas = await listAgendas(db, clinic.clinicId, { includeInactive: true });
const showAgenda = agendas.length > 1;
// Resumo do dia e Lembretes são de um dia: as abas e a volta das ações levam
// a data escolhida (teste do redesign, NAV-08, 16/out/2026).
const isDatedTab = (id: Tab) => id === "resumo" || id === "lembretes";
const tabHref = (id: Tab) => `/admin/consultas?tab=${id}${isDatedTab(id) && date !== today ? `&date=${date}` : ""}`;
const returnTo = tabHref(tab);

let dayAppointments: AgendaAppointment[] = [];
let cards: AgendaAppointment[] = [];
let reminders: Awaited<ReturnType<typeof listRemindersOfDay>> = [];
let sends: { alerts: string[]; runs: Awaited<ReturnType<typeof listJobRuns>>; failed: Awaited<ReturnType<typeof listAppointmentsWithFailedSends>> } | null = null;

switch (tab) {
  case "resumo":
    dayAppointments = await listAgendaAppointments(db, clinic.clinicId, { fromDate: date, toDate: date, timeZone: clinic.timezone, agendaIds: agendas.map((a) => a.id) });
    break;
  case "lembretes":
    reminders = await listRemindersOfDay(db, clinic.clinicId, date, clinic.timezone);
    break;
  case "pendentes":
    // A mais antiga primeiro (protótipo B do redesign, aba A registrar).
    cards = (await listPendingAttendance(db, clinic.clinicId, now)).sort((a, b) => a.scheduledAt.getTime() - b.scheduledAt.getTime());
    break;
  case "envios": {
    const [alert, runs, failed] = await Promise.all([
      getSendsAlert(db, clinic.clinicId, now),
      listJobRuns(db, clinic.clinicId, { limit: 20 }),
      listAppointmentsWithFailedSends(db, clinic.clinicId, {}, now),
    ]);
    sends = { alerts: describeSendsAlert(alert), runs, failed };
    break;
  }
}
const actors = await loadActorLabels(db, clinic.clinicId, dayAppointments.map((a) => a.createdBy));
const serviceRefs = await listServiceRefs(db, clinic.clinicId);
// Cor de cada serviço: faixa do cartão e etiqueta do tipo nas outras abas (cliente, 19/out/2026).
const tags = serviceTags(serviceRefs);
// Contadores das abas (R3; cliente, 15/out/2026): onde há pendência.
const counts = await getResumoTabCounts(db, clinic.clinicId, { timeZone: clinic.timezone, reminders: has("reminders"), waitlist: false, sends: sendsOn && clinic.isPlatformStaff }, now);
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
const tabCount: Partial<Record<Tab, Pick<TabItem, "count" | "countTone" | "alert" | "countLabel">>> = {
  lembretes: { count: counts.reminders, countLabel: `${counts.reminders ?? 0} sem resposta, não concluído(s) ou não entregue(s) hoje` },
  pendentes: { count: counts.pendingAttendance, countLabel: `${counts.pendingAttendance} a registrar` },
  envios: { alert: counts.sendsAlert, countLabel: "Há envios que pedem atenção" },
};
const dated = isDatedTab(tab);
const dayHref = (d: string) => `/admin/consultas?tab=${tab}&date=${d}`;
const activeOfDay = dayAppointments.filter((a) => a.status !== "canceled").length;
const canceledOfDay = dayAppointments.length - activeOfDay;
const dayTitle = `${formatCalendarDate(date, "EEEE").replace("-feira", "")}, ${formatCalendarDate(date, date.slice(0, 4) === today.slice(0, 4) ? "d 'de' MMMM" : "d 'de' MMMM 'de' yyyy")}`;
const dayCounts = tab === "resumo" ? [plural(activeOfDay, "atendimento", "atendimentos"), ...(canceledOfDay ? [plural(canceledOfDay, "cancelado", "cancelados")] : [])].join(" · ") : "";
// A registrar: as ações Compareceu e Faltou do cartão da Agenda (cardActions), com a mesma confirmação.
const who = (a: AgendaAppointment) => `${a.patientName}, ${formatInstant(a.scheduledAt, clinic.timezone, "dd/MM 'às' HH:mm")}`;
const registerActions = (a: AgendaAppointment) => {
  const actions = cardActions({ appointment: a, now, who: who(a), contact: vocabulary.contact, returnTo, preparationResendable: false, guidanceResendable: false, waitlistOn: false, onWaitlist: false });
  const forms = [actions.primary, ...actions.visible].filter((x): x is Extract<typeof x, { kind: "form" }> => !!x && x.kind === "form");
  return { came: forms.find((x) => x.acao === "compareceu"), missed: forms.find((x) => x.acao === "faltou") };
};
const dayWord = (a: AgendaAppointment) => {
  const day = localDateOf(a.scheduledAt, clinic.timezone);
  return day === today ? "hoje" : day === addDays(today, -1) ? "ontem" : formatInstant(a.scheduledAt, clinic.timezone, "EEEE, dd/MM").replace("-feira", "");
};
const tabClass = (on: boolean) =>
  `inline-flex min-h-11 items-center gap-1.5 border-b-[3px] px-0.5 text-base font-semibold no-underline ${on ? "border-brand text-brand-ink" : "border-transparent text-ink-soft hover:text-ink"}`;
---
<AdminLayout title="Relatório do dia" autoRefresh>
  <header class="flex flex-wrap items-end gap-x-6 gap-y-2 border-b border-line">
    <h1 class="mb-1.5 font-display text-[28px] leading-tight font-bold text-ink">Relatório do dia</h1>
    <nav aria-label="Abas do Relatório do dia" class="flex flex-wrap gap-x-6">
      {
        visible.map((t) => {
          const c = tabCount[t.id];
          return (
            <a href={tabHref(t.id)} aria-current={t.id === tab ? "page" : undefined} class={tabClass(t.id === tab)}>
              {t.label}
              {c?.alert ? (
                <span class="rounded-full bg-can-100 px-1.5 text-[13px] font-bold text-can-800" aria-label={c.countLabel}>!</span>
              ) : c?.count ? (
                <span class="rounded-full bg-pend-100 px-1.5 text-[13px] font-bold text-pend-800 tabular-nums" aria-label={c.countLabel}>{c.count}</span>
              ) : null}
            </a>
          );
        })
      }
    </nav>
  </header>
  <FlashMessage />

  {dated && (
    <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2">
      <div class="flex items-center gap-1.5">
        <Button href={dayHref(addDays(date, -1))} aria-label="Dia anterior" class="w-9 px-0">‹</Button>
        <Button href={dayHref(today)} class="px-3">Hoje</Button>
        <Button href={dayHref(addDays(date, 1))} aria-label="Próximo dia" class="w-9 px-0">›</Button>
      </div>
      <form method="GET" action="/admin/consultas" class="relative">
        <input type="hidden" name="tab" value={tab} />
        <h2 class="font-display text-[22px] leading-tight font-bold text-ink first-letter:uppercase">{dayTitle}</h2>
        <label class="absolute inset-0 cursor-pointer" title="Escolher o dia">
          <span class="sr-only">Escolher o dia</span>
          <input type="date" name="date" value={date} data-autosubmit class="absolute inset-0 h-full w-full cursor-pointer opacity-0" />
        </label>
      </form>
      {dayCounts && <span class="text-[15px] text-ink-soft">{dayCounts}</span>}
      {tab === "resumo" && <a href={`/admin/agenda?date=${date}`} class="text-[15px] font-semibold text-brand no-underline hover:underline sm:ml-auto">Abrir na Agenda</a>}
    </div>
  )}
  {tab === "resumo" && <ResumoDia tags={tags} appointments={dayAppointments} actors={actors} date={date} timeZone={clinic.timezone} vocabulary={vocabulary} showAgenda={showAgenda} />}
  {tab === "lembretes" && <LembretesTab tags={tags} reminders={reminders} timeZone={clinic.timezone} vocabulary={vocabulary} openGroup={params.get("grupo")} />}
  {tab === "envios" && sends && <EnviosTab tags={tags} alerts={sends.alerts} runs={sends.runs} failed={sends.failed} timeZone={clinic.timezone} />}

  {
    tab === "pendentes" && (
      <section aria-labelledby="registrar-titulo" class="mt-4 overflow-hidden rounded-xl border border-line bg-white">
        <div class="flex flex-col gap-0.5 px-4 pt-4 pb-3 sm:px-[18px]">
          <h2 id="registrar-titulo" class="font-display text-[21px] leading-tight font-bold text-ink">Consultas sem presença registrada</h2>
          <HowItWorks id="a-registrar" topic={ajudaResumo.comoFunciona.aRegistrar} class="mt-1">
          <p class="text-[14.5px] text-ink-soft">
            Já passaram e estão sem "Compareceu" ou "Faltou", de qualquer dia (até 60 dias), a mais antiga primeiro. Errou um registro? Corrija pela
            Agenda, no atendimento.
          </p>
          </HowItWorks>
        </div>
        {cards.map((a) => {
          const { came, missed } = registerActions(a);
          const endpoint = `/api/admin/agenda/atendimentos/${a.id}`;
          return (
            <div class="flex flex-wrap items-center gap-x-3.5 gap-y-2 border-t border-[#e7eeeb] px-4 py-3.5 sm:px-[18px]">
              <div class="flex min-w-[108px] flex-col">
                <strong class="text-[15.5px] tabular-nums">{formatInstant(a.scheduledAt, clinic.timezone, "HH:mm")}</strong>
                <span class="text-[13.5px] text-ink-soft">{dayWord(a)}</span>
              </div>
              <div class="flex min-w-0 flex-[1_1_220px] flex-col gap-0.5">
                <span class="text-base">
                  <a href={withReturn(`/admin/pacientes/${a.patientId}`, returnTo)} class="font-bold text-ink no-underline hover:text-brand hover:underline">{a.patientName}</a>
                  {" · "}
                  {a.serviceName} · {a.agendaName}
                </span>
                <span class="text-sm text-ink-soft">
                  {!a.isContactSelf && `${vocabulary.contact === "contato" ? "Contato" : "Resp."}: ${a.contactName} · `}
                  {isAnonymizedPhone(a.contactPhone) ? "telefone anonimizado" : formatPhoneBR(a.contactPhone)}
                </span>
              </div>
              <div class="flex flex-wrap items-center gap-2">
                {came && <CardActionButton action={came} endpoint={endpoint} returnTo={returnTo} variant="primary" />}
                {missed && <CardActionButton action={missed} endpoint={endpoint} returnTo={returnTo} variant="danger" />}
                <Button href={withReturn(`/admin/agenda?date=${localDateOf(a.scheduledAt, clinic.timezone)}&sel=${a.id}`, returnTo)} variant="quiet" size="sm">
                  Abrir na Agenda
                </Button>
              </div>
            </div>
          );
        })}
        {cards.length === 0 && <p class="border-t border-[#e7eeeb] px-4 py-5 text-[15px] text-ink-soft sm:px-[18px]">Tudo registrado.</p>}
      </section>
    )
  }
  <ConfirmDeleteDialog />
</AdminLayout>

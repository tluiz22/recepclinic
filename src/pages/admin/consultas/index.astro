---
// Resumo do Dia (F4.8), no banco novo, com as abas do piloto: Resumo do dia
// (só informação), Lembretes (item), Lista de espera (item), Aguardando
// remarcação, A registrar, Registradas e Envios (cliente, 05/out/2026: aqui,
// para toda a equipe; com o lembrete ou o resumo do dia liberado). Tudo das
// agendas que a pessoa vê (o Profissional, só as próprias).
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AppointmentCard from "../../../components/admin/agenda/AppointmentCard.astro";
import ConfirmDeleteDialog from "../../../components/admin/ConfirmDeleteDialog.astro";
import FlashMessage from "../../../components/admin/FlashMessage.astro";
import AguardandoTab from "../../../components/admin/resumo/AguardandoTab.astro";
import EnviosTab from "../../../components/admin/resumo/EnviosTab.astro";
import LembretesTab from "../../../components/admin/resumo/LembretesTab.astro";
import ListaEsperaTab from "../../../components/admin/resumo/ListaEsperaTab.astro";
import ResumoDia from "../../../components/admin/resumo/ResumoDia.astro";
import Button from "../../../components/admin/ui/Button.astro";
import DateStepper from "../../../components/admin/ui/DateStepper.astro";
import PageHeader from "../../../components/admin/ui/PageHeader.astro";
import Tabs, { type TabItem } from "../../../components/admin/ui/Tabs.astro";
import { addDays, formatCalendarDate, isCalendarDate, todayIn } from "../../../lib/clinicTime";
import { canAccessArea } from "../../../lib/clinicAccess";
import { createUserClient } from "../../../lib/data/clients";
import { loadActorLabels } from "../../../lib/data/agenda/trail";
import { listAgendaAppointments, listNoShowStats, listOrigins, type AgendaAppointment } from "../../../lib/data/agenda/view";
import { listAgendas } from "../../../lib/data/config/agendas";
import { getResumoTabCounts, listAwaitingRebooking, listPendingAttendance, listRecordedPage, listRemindersOfDay } from "../../../lib/data/daily";
import { describeSendsAlert, getSendsAlert, listAppointmentsWithFailedSends, listJobRuns } from "../../../lib/data/sends";
import { listPaymentStates } from "../../../lib/data/payments";
import { listReturnReady } from "../../../lib/data/agenda/returnReady";
import { listServiceRefs } from "../../../lib/data/config/services";
import { serviceTags, serviceTints } from "../../../components/admin/agenda/categoryStyle";
import { listRecentOffers, listWaitlist } from "../../../lib/data/waitlist/entries";
import { vocabularyFor } from "../../../lib/vocabulary";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const vocabulary = vocabularyFor(clinic.clinicProfile);
const params = Astro.url.searchParams;
const has = (key: string) => clinic.features.includes(key as never);
const sendsOn = has("reminders") || has("daily_summary");

type Tab = "resumo" | "lembretes" | "lista_espera" | "aguardando_remarcacao" | "pendentes" | "confirmadas" | "envios";
const tabs: { id: Tab; label: string; show: boolean }[] = [
  { id: "resumo", label: "Resumo do dia", show: true },
  { id: "lembretes", label: "Lembretes", show: has("reminders") },
  { id: "lista_espera", label: "Lista de espera", show: has("waitlist") },
  { id: "aguardando_remarcacao", label: "Aguardando remarcação", show: true },
  { id: "pendentes", label: "A registrar", show: true },
  { id: "confirmadas", label: "Registradas", show: true },
  { id: "envios", label: "Envios", show: sendsOn },
];
const visible = tabs.filter((t) => t.show);
const tab: Tab = visible.find((t) => t.id === params.get("tab"))?.id ?? "resumo";

const now = new Date();
const today = todayIn(clinic.timezone, now);
const date = isCalendarDate(params.get("date") ?? "") ? params.get("date")! : today;
const agendas = await listAgendas(db, clinic.clinicId, { includeInactive: true });
const showAgenda = agendas.length > 1;
// Resumo do dia e Lembretes são de um dia: as abas e a volta das ações levam
// a data escolhida (teste do redesign, NAV-08, 16/out/2026).
const isDatedTab = (id: Tab) => id === "resumo" || id === "lembretes";
const tabHref = (id: Tab) => `/admin/consultas?tab=${id}${isDatedTab(id) && date !== today ? `&date=${date}` : ""}`;
const returnTo = tabHref(tab);

let dayAppointments: AgendaAppointment[] = [];
let cards: AgendaAppointment[] = [];
let recorded: Awaited<ReturnType<typeof listRecordedPage>> | null = null;
let reminders: Awaited<ReturnType<typeof listRemindersOfDay>> = [];
let waitlist: Awaited<ReturnType<typeof listWaitlist>> = [];
let offers: Awaited<ReturnType<typeof listRecentOffers>> = [];
let awaiting: AgendaAppointment[] = [];
let sends: { alerts: string[]; runs: Awaited<ReturnType<typeof listJobRuns>>; failed: Awaited<ReturnType<typeof listAppointmentsWithFailedSends>> } | null = null;

switch (tab) {
  case "resumo":
    dayAppointments = await listAgendaAppointments(db, clinic.clinicId, { fromDate: date, toDate: date, timeZone: clinic.timezone, agendaIds: agendas.map((a) => a.id) });
    break;
  case "lembretes":
    reminders = await listRemindersOfDay(db, clinic.clinicId, date, clinic.timezone);
    break;
  case "lista_espera":
    [waitlist, offers] = await Promise.all([listWaitlist(db, clinic.clinicId), listRecentOffers(db, clinic.clinicId)]);
    break;
  case "aguardando_remarcacao":
    awaiting = await listAwaitingRebooking(db, clinic.clinicId, now);
    break;
  case "pendentes":
    cards = await listPendingAttendance(db, clinic.clinicId, now);
    break;
  case "confirmadas":
    recorded = await listRecordedPage(db, clinic.clinicId, Number(params.get("pagina")) || 1);
    cards = recorded.items;
    break;
  case "envios": {
    const [alert, runs, failed] = await Promise.all([
      getSendsAlert(db, clinic.clinicId, now),
      listJobRuns(db, clinic.clinicId, { limit: 20 }),
      listAppointmentsWithFailedSends(db, clinic.clinicId, {}, now),
    ]);
    sends = { alerts: describeSendsAlert(alert), runs, failed };
    break;
  }
}
const actors = await loadActorLabels(db, clinic.clinicId, [...dayAppointments.map((a) => a.createdBy), ...awaiting.map((a) => a.canceledBy)]);
// Módulo financeiro (F11.2): selo e botão "Pagamento", para quem tem a área.
const financeOn = canAccessArea(clinic, "finance");
const [noShows, origins, paymentStates, serviceRefs, returnReady] = await Promise.all([
  cards.length ? listNoShowStats(db, clinic.clinicId, cards.map((a) => a.patientId)) : Promise.resolve(new Map()),
  cards.length ? listOrigins(db, clinic.clinicId, cards) : Promise.resolve(new Map()),
  financeOn && cards.length ? listPaymentStates(db, clinic.clinicId, cards.map((a) => a.id)) : Promise.resolve(null),
  listServiceRefs(db, clinic.clinicId),
  cards.length ? listReturnReady(db, clinic.clinicId, cards, clinic.timezone, now) : Promise.resolve(new Map()),
]);
// Cor de cada serviço: faixa do cartão e etiqueta do tipo nas outras abas (cliente, 19/out/2026).
const tints = serviceTints(serviceRefs);
const tags = serviceTags(serviceRefs);
// Contadores das abas (R3; cliente, 15/out/2026): onde há pendência.
const counts = await getResumoTabCounts(db, clinic.clinicId, { timeZone: clinic.timezone, reminders: has("reminders"), waitlist: has("waitlist"), sends: sendsOn }, now);
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
const tabCount: Partial<Record<Tab, Pick<TabItem, "count" | "countTone" | "alert" | "countLabel">>> = {
  lembretes: { count: counts.reminders, countLabel: `${counts.reminders ?? 0} sem resposta ou não entregue(s) hoje` },
  lista_espera: { count: counts.waitlist, countTone: "info", countLabel: `${plural(counts.waitlist ?? 0, "pessoa", "pessoas")} na lista` },
  aguardando_remarcacao: { count: counts.awaitingRebooking, countLabel: `${counts.awaitingRebooking} aguardando` },
  pendentes: { count: counts.pendingAttendance, countLabel: `${counts.pendingAttendance} a registrar` },
  envios: { alert: counts.sendsAlert, countLabel: "Há envios que pedem atenção" },
};
const dated = isDatedTab(tab);
const dayHref = (d: string) => `/admin/consultas?tab=${tab}&date=${d}`;
const activeOfDay = dayAppointments.filter((a) => a.status !== "canceled").length;
const canceledOfDay = dayAppointments.length - activeOfDay;
const subtitle = !dated
  ? undefined
  : [
      formatCalendarDate(date, "EEEE, d 'de' MMMM 'de' yyyy"),
      ...(tab === "resumo" ? [plural(activeOfDay, "atendimento", "atendimentos"), ...(canceledOfDay ? [plural(canceledOfDay, "cancelado", "cancelados")] : [])] : []),
    ].join(" · ");
---
<AdminLayout title="Resumo do Dia">
  <PageHeader title="Resumo do Dia" subtitle={subtitle}>
    {tab === "resumo" && (
      <Button slot="actions" href={`/admin/agenda?date=${date}`}>
        Abrir na Agenda
      </Button>
    )}
  </PageHeader>
  <Tabs
    label="Abas do Resumo do Dia"
    class="mt-4"
    tabs={visible.map((t) => ({ label: t.label, href: tabHref(t.id), active: t.id === tab, ...tabCount[t.id] }))}
  />
  <FlashMessage />

  {dated && (
    <DateStepper
      class="mt-4"
      action="/admin/consultas"
      date={date}
      hidden={{ tab }}
      prevHref={dayHref(addDays(date, -1))}
      nextHref={dayHref(addDays(date, 1))}
      todayHref={date !== today ? dayHref(today) : undefined}
    />
  )}
  {tab === "resumo" && <ResumoDia tags={tags} appointments={dayAppointments} actors={actors} date={date} timeZone={clinic.timezone} vocabulary={vocabulary} showAgenda={showAgenda} />}
  {tab === "lembretes" && <LembretesTab tags={tags} reminders={reminders} timeZone={clinic.timezone} vocabulary={vocabulary} openGroup={params.get("grupo")} />}
  {tab === "lista_espera" && <ListaEsperaTab tags={tags} entries={waitlist} offers={offers} timeZone={clinic.timezone} />}
  {tab === "aguardando_remarcacao" && <AguardandoTab tags={tags} appointments={awaiting} actors={actors} timeZone={clinic.timezone} vocabulary={vocabulary} />}
  {tab === "envios" && sends && <EnviosTab tags={tags} alerts={sends.alerts} runs={sends.runs} failed={sends.failed} timeZone={clinic.timezone} />}

  {
    (tab === "pendentes" || tab === "confirmadas") && (
      <>
        <p class="mt-4 text-[15px] text-ink-soft">
          {tab === "pendentes"
            ? `Atendimentos dos últimos 60 dias que já passaram sem registro (${cards.length}).`
            : `Comparecimento já registrado (${recorded?.total ?? 0}). Dá para corrigir.`}
        </p>
        <div class="mt-3 grid items-start gap-3 lg:grid-cols-2 2xl:grid-cols-3">
          {cards.map((a) => (
            <AppointmentCard
              appointment={a}
              tint={tints.get(a.serviceId)}
              timeZone={clinic.timezone}
              now={now}
              showAgenda={showAgenda}
              vocabulary={vocabulary}
              returnTo={returnTo}
              preparationResendable={false}
              waitlistOn={false}
              onWaitlist={false}
              noShow={noShows.get(a.patientId)}
              origin={a.originAppointmentId ? origins.get(a.originAppointmentId) : undefined}
              payment={paymentStates ? (paymentStates.get(a.id) ?? "none") : undefined}
              returnReady={returnReady.get(a.id)}
              withDate
            />
          ))}
        </div>
        {cards.length === 0 && (
          <p class="mt-3 rounded-xl border border-dashed border-line-strong px-3 py-5 text-center text-[15px] text-ink-soft">
            {tab === "pendentes" ? "Nada a registrar." : "Nenhum registro ainda."}
          </p>
        )}
        {recorded && recorded.pageCount > 1 && (
          <nav aria-label="Páginas" class="mt-4 flex items-center gap-2 text-[15px]">
            {recorded.page > 1 && (
              <Button size="sm" href={`/admin/consultas?tab=confirmadas&pagina=${recorded.page - 1}`}>
                Anterior
              </Button>
            )}
            <span class="px-1 text-ink-soft">
              Página {recorded.page} de {recorded.pageCount}
            </span>
            {recorded.page < recorded.pageCount && (
              <Button size="sm" href={`/admin/consultas?tab=confirmadas&pagina=${recorded.page + 1}`}>
                Próxima
              </Button>
            )}
          </nav>
        )}
      </>
    )
  }
  <ConfirmDeleteDialog />
</AdminLayout>

---
// Resumo do Dia (F4.8), no banco novo, com as abas do piloto: Resumo do dia
// (só informação), Lembretes (item), Lista de espera (item), Aguardando
// remarcação, A registrar, Registradas e Envios (cliente, 05/out/2026: aqui,
// para toda a equipe; com o lembrete ou o resumo do dia liberado). Tudo das
// agendas que a pessoa vê (o Profissional, só as próprias).
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AppointmentCard from "../../../components/admin/agenda/AppointmentCard.astro";
import Card from "../../../components/admin/Card.astro";
import ConfirmDeleteDialog from "../../../components/admin/ConfirmDeleteDialog.astro";
import FlashMessage from "../../../components/admin/FlashMessage.astro";
import TabBar from "../../../components/admin/TabBar.astro";
import AguardandoTab from "../../../components/admin/resumo/AguardandoTab.astro";
import DateNav from "../../../components/admin/resumo/DateNav.astro";
import EnviosTab from "../../../components/admin/resumo/EnviosTab.astro";
import LembretesTab from "../../../components/admin/resumo/LembretesTab.astro";
import ListaEsperaTab from "../../../components/admin/resumo/ListaEsperaTab.astro";
import ResumoDia from "../../../components/admin/resumo/ResumoDia.astro";
import { isCalendarDate, todayIn } from "../../../lib/clinicTime";
import { createUserClient } from "../../../lib/data/clients";
import { loadActorLabels } from "../../../lib/data/agenda/trail";
import { listAgendaAppointments, listNoShowStats, listOrigins, type AgendaAppointment } from "../../../lib/data/agenda/view";
import { listAgendas } from "../../../lib/data/config/agendas";
import { listAwaitingRebooking, listPendingAttendance, listRecordedPage, listRemindersOfDay } from "../../../lib/data/daily";
import { describeSendsAlert, getSendsAlert, listAppointmentsWithFailedSends, listJobRuns } from "../../../lib/data/sends";
import { listRecentOffers, listWaitlist } from "../../../lib/data/waitlist/entries";
import { vocabularyFor } from "../../../lib/vocabulary";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const vocabulary = vocabularyFor(clinic.clinicProfile);
const params = Astro.url.searchParams;
const has = (key: string) => clinic.features.includes(key as never);
const sendsOn = has("reminders") || has("daily_summary");

type Tab = "resumo" | "lembretes" | "lista_espera" | "aguardando_remarcacao" | "pendentes" | "confirmadas" | "envios";
const tabs: { id: Tab; label: string; show: boolean }[] = [
  { id: "resumo", label: "Resumo do dia", show: true },
  { id: "lembretes", label: "Lembretes", show: has("reminders") },
  { id: "lista_espera", label: "Lista de espera", show: has("waitlist") },
  { id: "aguardando_remarcacao", label: "Aguardando remarcação", show: true },
  { id: "pendentes", label: "A registrar", show: true },
  { id: "confirmadas", label: "Registradas", show: true },
  { id: "envios", label: "Envios", show: sendsOn },
];
const visible = tabs.filter((t) => t.show);
const tab: Tab = visible.find((t) => t.id === params.get("tab"))?.id ?? "resumo";

const now = new Date();
const today = todayIn(clinic.timezone, now);
const date = isCalendarDate(params.get("date") ?? "") ? params.get("date")! : today;
const agendas = await listAgendas(db, clinic.clinicId, { includeInactive: true });
const showAgenda = agendas.length > 1;
const returnTo = `/admin/consultas?tab=${tab}`;

let dayAppointments: AgendaAppointment[] = [];
let cards: AgendaAppointment[] = [];
let recorded: Awaited<ReturnType<typeof listRecordedPage>> | null = null;
let reminders: Awaited<ReturnType<typeof listRemindersOfDay>> = [];
let waitlist: Awaited<ReturnType<typeof listWaitlist>> = [];
let offers: Awaited<ReturnType<typeof listRecentOffers>> = [];
let awaiting: AgendaAppointment[] = [];
let sends: { alerts: string[]; runs: Awaited<ReturnType<typeof listJobRuns>>; failed: Awaited<ReturnType<typeof listAppointmentsWithFailedSends>> } | null = null;

switch (tab) {
  case "resumo":
    dayAppointments = await listAgendaAppointments(db, clinic.clinicId, { fromDate: date, toDate: date, timeZone: clinic.timezone, agendaIds: agendas.map((a) => a.id) });
    break;
  case "lembretes":
    reminders = await listRemindersOfDay(db, clinic.clinicId, date, clinic.timezone);
    break;
  case "lista_espera":
    [waitlist, offers] = await Promise.all([listWaitlist(db, clinic.clinicId), listRecentOffers(db, clinic.clinicId)]);
    break;
  case "aguardando_remarcacao":
    awaiting = await listAwaitingRebooking(db, clinic.clinicId, now);
    break;
  case "pendentes":
    cards = await listPendingAttendance(db, clinic.clinicId, now);
    break;
  case "confirmadas":
    recorded = await listRecordedPage(db, clinic.clinicId, Number(params.get("pagina")) || 1);
    cards = recorded.items;
    break;
  case "envios": {
    const [alert, runs, failed] = await Promise.all([
      getSendsAlert(db, clinic.clinicId, now),
      listJobRuns(db, clinic.clinicId, { limit: 20 }),
      listAppointmentsWithFailedSends(db, clinic.clinicId, {}, now),
    ]);
    sends = { alerts: describeSendsAlert(alert), runs, failed };
    break;
  }
}
const actors = await loadActorLabels(db, clinic.clinicId, [...dayAppointments.map((a) => a.createdBy), ...awaiting.map((a) => a.canceledBy)]);
const [noShows, origins] = cards.length
  ? await Promise.all([listNoShowStats(db, clinic.clinicId, cards.map((a) => a.patientId)), listOrigins(db, clinic.clinicId, cards)])
  : [new Map(), new Map()];
---

<AdminLayout title="Resumo do Dia">
  <h1 class="text-2xl font-bold text-slate-900">Resumo do Dia</h1>
  <TabBar
    label="Abas do Resumo do Dia"
    class="mt-4"
    tabs={visible.map((t) => ({ label: t.label, href: `/admin/consultas?tab=${t.id}`, active: t.id === tab }))}
  />
  <FlashMessage />

  {(tab === "resumo" || tab === "lembretes") && <DateNav tab={tab} date={date} today={today} />}
  {tab === "resumo" && <ResumoDia appointments={dayAppointments} actors={actors} date={date} timeZone={clinic.timezone} vocabulary={vocabulary} showAgenda={showAgenda} />}
  {tab === "lembretes" && <LembretesTab reminders={reminders} timeZone={clinic.timezone} vocabulary={vocabulary} openGroup={params.get("grupo")} />}
  {tab === "lista_espera" && <ListaEsperaTab entries={waitlist} offers={offers} timeZone={clinic.timezone} />}
  {tab === "aguardando_remarcacao" && <AguardandoTab appointments={awaiting} actors={actors} timeZone={clinic.timezone} vocabulary={vocabulary} />}
  {tab === "envios" && sends && <EnviosTab alerts={sends.alerts} runs={sends.runs} failed={sends.failed} timeZone={clinic.timezone} />}

  {
    (tab === "pendentes" || tab === "confirmadas") && (
      <>
        <p class="mt-3 text-sm text-slate-600">
          {tab === "pendentes"
            ? `Atendimentos dos últimos 60 dias que já passaram sem registro (${cards.length}).`
            : `Comparecimento já registrado (${recorded?.total ?? 0}). Dá para corrigir.`}
        </p>
        <div class="mt-3 grid gap-3 lg:grid-cols-2">
          {cards.map((a) => (
            <AppointmentCard
              appointment={a}
              timeZone={clinic.timezone}
              now={now}
              showAgenda={showAgenda}
              vocabulary={vocabulary}
              returnTo={returnTo}
              preparationResendable={false}
              waitlistOn={false}
              onWaitlist={false}
              noShow={noShows.get(a.patientId)}
              origin={a.originAppointmentId ? origins.get(a.originAppointmentId) : undefined}
            />
          ))}
        </div>
        {cards.length === 0 && <Card class="mt-3 text-center text-slate-500">{tab === "pendentes" ? "Nada a registrar." : "Nenhum registro ainda."}</Card>}
        {recorded && recorded.pageCount > 1 && (
          <nav class="mt-4 flex items-center gap-3 text-sm">
            {recorded.page > 1 && (
              <a href={`/admin/consultas?tab=confirmadas&pagina=${recorded.page - 1}`} class="text-sky-700 hover:underline">
                Anterior
              </a>
            )}
            <span class="text-slate-500">
              Página {recorded.page} de {recorded.pageCount}
            </span>
            {recorded.page < recorded.pageCount && (
              <a href={`/admin/consultas?tab=confirmadas&pagina=${recorded.page + 1}`} class="text-sky-700 hover:underline">
                Próxima
              </a>
            )}
          </nav>
        )}
      </>
    )
  }
  <ConfirmDeleteDialog />
</AdminLayout>

---
import Notice from "../../components/admin/ui/Notice.astro";
import { AUTH_INPUT, AUTH_LABEL, AUTH_LINK } from "../../components/admin/auth/styles";
import { buttonClass } from "../../components/admin/ui/styles";
import AuthLayout from "../../layouts/AuthLayout.astro";

// Recuperação de senha (F4.1). A resposta é a mesma, exista ou não o e-mail.
const sent = Astro.url.searchParams.get("enviado") === "1";
---

<AuthLayout title="Esqueci minha senha">
  {!sent && <p slot="subtitle" class="text-[15px] text-ink-soft">Informe o seu e-mail. Enviaremos um link para criar uma senha nova.</p>}
  {
    sent ? (
      <Notice tone="success">
        Se este e-mail tiver acesso ao painel, enviamos um link para criar uma senha nova. Confira a caixa de entrada (e o spam).
      </Notice>
    ) : (
      <form method="POST" action="/api/admin/auth/recuperar" class="flex flex-col gap-4">
        <div>
          <label for="email" class={AUTH_LABEL}>
            E-mail
          </label>
          <input type="email" name="email" id="email" required autocomplete="email" class={AUTH_INPUT} />
        </div>
        <button type="submit" data-sending-label="Enviando…" class={`${buttonClass("primary")} mt-1 h-[46px] w-full text-base sm:h-[46px]`}>
          Enviar link
        </button>
      </form>
    )
  }
  <a href="/admin/login" class={AUTH_LINK}>‹ Voltar para o login</a>
</AuthLayout>

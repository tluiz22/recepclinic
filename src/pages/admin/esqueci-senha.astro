---
import FormMessage from "../../components/admin/FormMessage.astro";
import AuthLayout from "../../layouts/AuthLayout.astro";

// Recuperação de senha (F4.1). A resposta é a mesma, exista ou não o e-mail.
const sent = Astro.url.searchParams.get("enviado") === "1";
---

<AuthLayout title="Esqueci minha senha">
  {
    sent ? (
      <FormMessage tone="success">
        Se este e-mail tiver acesso ao painel, enviamos um link para criar uma senha nova. Confira a caixa de entrada (e o
        spam).
      </FormMessage>
    ) : (
      <>
        <p class="mt-1 text-sm text-slate-600">Informe o seu e-mail. Enviaremos um link para criar uma senha nova.</p>
        <form method="POST" action="/api/admin/auth/recuperar" class="mt-6 flex flex-col gap-4">
          <div>
            <label for="email" class="block text-sm font-medium text-slate-700">
              E-mail
            </label>
            <input type="email" name="email" id="email" required autocomplete="email" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" />
          </div>
          <button type="submit" class="rounded-md bg-sky-700 px-4 py-2 text-sm font-medium text-white hover:bg-sky-800">
            Enviar link
          </button>
        </form>
      </>
    )
  }
  <a href="/admin/login" class="mt-4 block text-center text-sm text-sky-700 hover:underline">Voltar para o login</a>
</AuthLayout>

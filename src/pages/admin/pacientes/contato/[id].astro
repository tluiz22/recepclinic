---
// Pacientes › responsável/contato (F4.7): quem fala com a clínica pelo
// WhatsApp. Nome, telefone (único na clínica) e o endereço padrão do
// atendimento domiciliar (com o item); os pacientes dele, com "cadastrar
// outro" já ligado a este contato; desativar/reativar. Com o bot, os limites
// do contato (F9.6a): aviso no topo enquanto está para revisar, os últimos
// limites atingidos, "Revisado" (Recepção e Administrador) e liberar dos
// limites (só o Administrador). Bloquear no bot (F9.6b, só o Administrador),
// com a opção de cancelar sem aviso os atendimentos futuros; desbloquear.
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import ActiveToggle from "../../../../components/admin/ActiveToggle.astro";
import ConfirmDeleteDialog from "../../../../components/admin/ConfirmDeleteDialog.astro";
import Badge from "../../../../components/admin/Badge.astro";
import Card from "../../../../components/admin/Card.astro";
import FlashMessage from "../../../../components/admin/FlashMessage.astro";
import FormMessage from "../../../../components/admin/FormMessage.astro";
import Icon from "../../../../components/admin/Icon.astro";
import PhoneLinks from "../../../../components/admin/PhoneLinks.astro";
import { HINT, INPUT, LABEL, PRIMARY_BUTTON, SECONDARY_BUTTON } from "../../../../components/admin/fieldStyles";
import { formatAge } from "../../../../lib/age";
import { isUuid } from "../../../../lib/clinicAccess";
import { formatInstant, todayIn } from "../../../../lib/clinicTime";
import { createUserClient } from "../../../../lib/data/clients";
import { getContact, listContactPatients } from "../../../../lib/data/patients";
import { getContactBlock, listContactFutureAppointmentIds } from "../../../../lib/data/whatsapp/contactBlock";
import {
  BOT_LIMIT_LABELS,
  describeBotLimitHit,
  exemptByLabel,
  getContactBotLimitsStatus,
  isPendingReview,
  listContactLimitEvents,
  type BotLimitEvent,
} from "../../../../lib/data/whatsapp/botLimits";
import { formatPhoneBR } from "../../../../lib/phone";
import { capitalize, vocabularyFor } from "../../../../lib/vocabulary";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const vocabulary = vocabularyFor(clinic.clinicProfile);
const id = Astro.params.id!;
const contact = isUuid(id) ? await getContact(db, clinic.clinicId, id).catch(() => null) : null;
if (!contact) return Astro.redirect("/admin/pacientes?tab=contatos");
const patients = await listContactPatients(db, clinic.clinicId, contact.id, { includeInactive: true });
const today = todayIn(clinic.timezone);
const homeVisitOn = clinic.features.includes("home_visit");
const action = `/api/admin/pacientes/contato/${contact.id}`;
const hasBot = clinic.features.includes("whatsapp_bot") && !contact.anonymizedAt;
const [limitEvents, limitsStatus] = hasBot
  ? await Promise.all([listContactLimitEvents(db, clinic.clinicId, contact.id), getContactBotLimitsStatus(db, clinic.clinicId, contact.id)])
  : [[], null];
const pendingLimit = limitEvents[0] && limitsStatus && isPendingReview(limitEvents[0], limitsStatus.reviewedAt) ? limitEvents[0] : null;
const canReview = clinic.isPlatformStaff || clinic.roles.includes("admin") || clinic.roles.includes("reception");
const canExempt = clinic.isPlatformStaff || clinic.roles.includes("admin");
const canBlock = canExempt;
const [block, futureCount] = hasBot
  ? await Promise.all([getContactBlock(db, clinic.clinicId, contact.id), listContactFutureAppointmentIds(db, clinic.clinicId, contact.id).then((ids) => ids.length)])
  : [null, 0];
const blockedBy = block?.blockedBy ? await exemptByLabel(db, clinic.clinicId, block.blockedBy) : null;
const exemptBy = limitsStatus?.exemptAt && limitsStatus.exemptBy ? await exemptByLabel(db, clinic.clinicId, limitsStatus.exemptBy) : null;
const when = (event: BotLimitEvent) => formatInstant(event.at, clinic.timezone, "dd/MM 'às' HH:mm");
const limitLine = (event: BotLimitEvent) => `${BOT_LIMIT_LABELS[event.reason]}: ${describeBotLimitHit(event)}`;
---

<AdminLayout title={contact.fullName}>
  <a href="/admin/pacientes?tab=contatos" class="inline-flex items-center gap-1 text-sm font-medium text-sky-700 hover:underline">
    <Icon name="chevron-left" class="h-4 w-4" />
    {capitalize(vocabulary.contacts)}
  </a>
  <h1 class="mt-3 flex flex-wrap items-center gap-2 text-2xl font-bold text-slate-900">
    {contact.fullName}
    {contact.anonymizedAt ? <Badge variant="warning">anonimizado</Badge> : !contact.isActive && <Badge>desativado</Badge>}
    {contact.botBlockedAt && <Badge variant="danger">bloqueado</Badge>}
  </h1>
  <p class="mt-1 text-sm"><PhoneLinks phone={contact.phone} plain class="text-slate-700" /></p>
  <FlashMessage />
  {
    pendingLimit && (
      <FormMessage tone="warning">
        {pendingLimit.paused ? "Bot pausado" : "O bot não marcou"} em {when(pendingLimit)}. {limitLine(pendingLimit)}.
        {pendingLimit.paused ? " A conversa está com a recepção." : " A recepção precisa entrar em contato."}
      </FormMessage>
    )
  }

  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    <div class="flex flex-col gap-4">
      <Card>
        <h2 class="font-semibold text-slate-900">Dados</h2>
        {
          contact.anonymizedAt && (
            <p class="mt-1 text-sm text-amber-700">
              Anonimizado a pedido (LGPD): nome, telefone e mensagens foram apagados. Para os outros pacientes dele voltarem a receber mensagens,
              informe o nome e o WhatsApp de quem fala por eles agora.
            </p>
          )
        }
        <form method="POST" action={action} class="mt-3 flex flex-col gap-3">
          <input type="hidden" name="acao" value="salvar" />
          <div>
            <label for="full_name" class={LABEL}>Nome</label>
            <input id="full_name" name="full_name" required value={contact.anonymizedAt ? "" : contact.fullName} class={INPUT} />
          </div>
          <div>
            <label for="phone" class={LABEL}>WhatsApp</label>
            <input id="phone" name="phone" type="tel" required value={contact.anonymizedAt ? "" : formatPhoneBR(contact.phone)} class={INPUT} />
            <p class={HINT}>É por este número que a clínica conversa com ele e envia lembretes.</p>
          </div>
          {
            homeVisitOn && (
              <div>
                <label for="default_home_address" class={LABEL}>
                  Endereço do atendimento domiciliar
                </label>
                <input id="default_home_address" name="default_home_address" value={contact.defaultHomeAddress ?? ""} class={INPUT} />
                <p class={HINT}>Já vem preenchido ao marcar um atendimento domiciliar.</p>
              </div>
            )
          }
          <button type="submit" class={`${SECONDARY_BUTTON} self-start`}>Salvar</button>
        </form>
      </Card>
      {hasBot && limitsStatus && (
        <Card>
          <h2 class="font-semibold text-slate-900">Limites do bot</h2>
          {limitsStatus.exemptAt ? (
            <p class="mt-1 text-sm text-emerald-800">
              Liberado dos limites do bot por {exemptBy ?? "—"} em {formatInstant(limitsStatus.exemptAt, clinic.timezone, "dd/MM/yyyy")}: o bot marca e
              cadastra para este número sem limite.
            </p>
          ) : (
            <p class={HINT}>
              Atendimentos futuros, cadastros pelo bot e faltas, somando os pacientes deste número (Configurações › Clínica).
            </p>
          )}
          {limitEvents.length > 0 ? (
            <ul class="mt-2 divide-y divide-slate-100 text-sm">
              {limitEvents.map((event) => (
                <li class="py-2">
                  <span class="tabular-nums text-slate-500">{when(event)}</span> · <span class="text-slate-900">{limitLine(event)}</span>
                  <span class="text-slate-500">{event.paused ? " · conversa passada à recepção" : " · sem pausa (número sem coexistência)"}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-2 text-sm text-slate-500">Nenhum limite atingido.</p>
          )}
          <div class="mt-3 flex flex-wrap gap-2">
            {pendingLimit && canReview && (
              <form method="POST" action={action}>
                <input type="hidden" name="acao" value="revisado" />
                <button
                  type="submit"
                  class={`${SECONDARY_BUTTON} js-confirm-delete`}
                  data-confirm-title="Marcar como revisado?"
                  data-confirm-message="O contato sai de &quot;Contatos para revisar&quot; no Painel. Se atingir um limite de novo, volta para a lista."
                  data-confirm-label="Revisado"
                >
                  Revisado
                </button>
              </form>
            )}
            {canExempt && (
              <form method="POST" action={action}>
                <input type="hidden" name="acao" value={limitsStatus.exemptAt ? "aplicar_limites" : "liberar_limites"} />
                <button
                  type="submit"
                  class={`${SECONDARY_BUTTON} js-confirm-delete`}
                  data-confirm-title={limitsStatus.exemptAt ? "Voltar a aplicar os limites?" : "Liberar dos limites do bot?"}
                  data-confirm-message={
                    limitsStatus.exemptAt
                      ? "O bot volta a aplicar os limites de atendimentos, cadastros e faltas a este número."
                      : "O bot deixa de aplicar os limites de atendimentos, cadastros e faltas a este número até alguém desfazer. Use para quem marca muitos pacientes com acordo da clínica (ex.: uma empresa)."
                  }
                  data-confirm-label={limitsStatus.exemptAt ? "Aplicar os limites" : "Liberar"}
                >
                  {limitsStatus.exemptAt ? "Voltar a aplicar os limites" : "Liberar dos limites do bot"}
                </button>
              </form>
            )}
          </div>
          {/* Com o contato ativo, o diálogo já vem do "Desativar". */}
          {!contact.isActive && <ConfirmDeleteDialog />}
        </Card>
      )}
      {hasBot && (block || canBlock) && (
        <Card>
          <h2 class="font-semibold text-slate-900">Bloqueio no bot</h2>
          {block ? (
            <>
              <p class="mt-1 text-sm text-red-800">
                Bloqueado por {blockedBy ?? "—"} em {formatInstant(block.blockedAt, clinic.timezone, "dd/MM/yyyy 'às' HH:mm")}. O bot não atende este número
                (responde, uma vez por dia, que a conversa está com a recepção); só os botões do lembrete funcionam.
              </p>
              {block.reason && <p class="mt-1 text-sm text-slate-700">Motivo: {block.reason}</p>}
              {canBlock && (
                <form method="POST" action={action} class="mt-3">
                  <input type="hidden" name="acao" value="desbloquear" />
                  <button
                    type="submit"
                    class={`${SECONDARY_BUTTON} js-confirm-delete`}
                    data-confirm-title="Desbloquear o contato?"
                    data-confirm-message="O bot volta a atender este número. Atendimentos cancelados no bloqueio não voltam."
                    data-confirm-label="Desbloquear"
                  >
                    Desbloquear
                  </button>
                </form>
              )}
            </>
          ) : (
            <form method="POST" action={action} class="mt-2 flex flex-col gap-3">
              <input type="hidden" name="acao" value="bloquear" />
              <p class={HINT}>
                O bot deixa de atender este número: não marca, não cadastra e responde, uma vez por dia, que a conversa está com a recepção. A equipe
                continua marcando pelo painel. Os pacientes dele saem da lista de espera.
              </p>
              <div>
                <label for="motivo" class={LABEL}>Motivo (opcional)</label>
                <input id="motivo" name="motivo" maxlength="300" class={INPUT} />
              </div>
              {futureCount > 0 && (
                <label class="flex items-start gap-2 text-sm text-slate-700">
                  <input type="checkbox" name="cancelar_futuros" checked class="mt-0.5 h-4 w-4 rounded border-slate-300" />
                  <span>
                    Cancelar {futureCount === 1 ? "o atendimento futuro" : `os ${futureCount} atendimentos futuros`} ligados a este contato, sem aviso (não gasta template; a vaga volta para a lista de espera). Séries terminam.
                  </span>
                </label>
              )}
              <button
                type="submit"
                class={`${SECONDARY_BUTTON} js-confirm-delete self-start text-red-700`}
                data-confirm-title="Bloquear o contato?"
                data-confirm-message="O bot deixa de atender este número. Se a opção de cancelar estiver marcada, os atendimentos futuros são cancelados sem aviso e as séries terminam; desbloquear não desfaz isso."
                data-confirm-label="Bloquear"
              >
                Bloquear contato
              </button>
            </form>
          )}
        </Card>
      )}
      {!contact.anonymizedAt && (
        <Card>
          <ActiveToggle action={action} isActive={contact.isActive} what={`o ${vocabulary.contact}`} />
        </Card>
      )}
    </div>

    <Card>
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class="font-semibold text-slate-900">{capitalize(vocabulary.patients)}</h2>
        {contact.isActive && <a href={`/admin/pacientes/novo?contato=${contact.id}`} class={PRIMARY_BUTTON}>Cadastrar outro</a>}
      </div>
      <ul class="mt-2 divide-y divide-slate-100">
        {
          patients.map((p) => (
            <li class={p.isActive ? "" : "opacity-60"}>
              <a href={`/admin/pacientes/${p.id}`} class="flex flex-wrap items-center justify-between gap-2 py-2 text-sm hover:text-sky-700">
                <span class="font-medium text-slate-900">
                  {p.fullName} {p.isContactSelf && <span class="font-normal text-slate-500">(ele mesmo)</span>}
                </span>
                <span class="text-slate-500">
                  {formatAge(p.birthdate, today)} {!p.isActive && <Badge>desativado</Badge>}
                </span>
              </a>
            </li>
          ))
        }
        {patients.length === 0 && <li class="py-2 text-sm text-slate-500">Nenhum.</li>}
      </ul>
    </Card>
  </div>
</AdminLayout>

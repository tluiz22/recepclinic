---
// Pacientes › responsável/contato (F4.7): quem fala com a clínica pelo
// WhatsApp. Nome, telefone (único na clínica) e o endereço padrão do
// atendimento domiciliar (com o item); os pacientes dele, com "cadastrar
// outro" já ligado a este contato; desativar/reativar. Com o bot, os limites
// do contato (F9.6a): aviso no topo enquanto está para revisar, os últimos
// limites atingidos, "Revisado" (Recepção e Administrador) e liberar dos
// limites (só o Administrador). Bloquear no bot (F9.6b, só o Administrador),
// com a opção de cancelar sem aviso os atendimentos futuros; desbloquear.
// Com o Módulo financeiro (F11.1), o CPF do contato (Administrador e Recepção
// gravam; o Suporte só vê).
//
// Redesign R6 (proposta aprovada pelo cliente em 16/out/2026): no alto, o
// contato, o aviso "para revisar" com "Revisado" e o "Mais" (Liberar dos
// limites, Desativar, Bloquear no bot…); os pacientes dele em destaque; os
// dados em modo leitura com "Editar". "Bloquear no bot…" abre o cartão do
// bloqueio (`?bloquear=1`), com o motivo e a opção de cancelar os futuros.
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import ConfirmDeleteDialog from "../../../../components/admin/ConfirmDeleteDialog.astro";
import FlashMessage from "../../../../components/admin/FlashMessage.astro";
import Icon from "../../../../components/admin/Icon.astro";
import PhoneLinks from "../../../../components/admin/PhoneLinks.astro";
import Button from "../../../../components/admin/ui/Button.astro";
import EditCard from "../../../../components/admin/ui/EditCard.astro";
import MoreMenu from "../../../../components/admin/ui/MoreMenu.astro";
import Pill from "../../../../components/admin/ui/Pill.astro";
import { CONTROL, menuItemClass } from "../../../../components/admin/ui/styles";
import { formatAge } from "../../../../lib/age";
import { canAccessArea, isUuid } from "../../../../lib/clinicAccess";
import { formatCpf } from "../../../../lib/cpf";
import { getContactCpf } from "../../../../lib/data/finance";
import { currentPath, receivedReturn, withReturn } from "../../../../lib/returnPath";
import { formatInstant, todayIn } from "../../../../lib/clinicTime";
import { createUserClient } from "../../../../lib/data/clients";
import { getContact, listContactPatients } from "../../../../lib/data/patients";
import { getContactBlock, listContactFutureAppointmentIds } from "../../../../lib/data/whatsapp/contactBlock";
import {
  BOT_LIMIT_LABELS,
  describeBotLimitHit,
  exemptByLabel,
  getContactBotLimitsStatus,
  isPendingReview,
  listContactLimitEvents,
  type BotLimitEvent,
} from "../../../../lib/data/whatsapp/botLimits";
import { formatPhoneBR } from "../../../../lib/phone";
import { capitalize, vocabularyFor } from "../../../../lib/vocabulary";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const vocabulary = vocabularyFor(clinic.clinicProfile);
const id = Astro.params.id!;
const contact = isUuid(id) ? await getContact(db, clinic.clinicId, id).catch(() => null) : null;
if (!contact) return Astro.redirect("/admin/pacientes?tab=contatos");
const patients = await listContactPatients(db, clinic.clinicId, contact.id, { includeInactive: true });
const today = todayIn(clinic.timezone);
const homeVisitOn = clinic.features.includes("home_visit");
// Voltar: para a tela de onde veio (cliente, 10/out/2026); sem origem, a lista.
const volta = receivedReturn(Astro.url);
const here = currentPath(Astro.url);
const action = withReturn(`/api/admin/pacientes/contato/${contact.id}`, volta);
const hasBot = clinic.features.includes("whatsapp_bot") && !contact.anonymizedAt;
const [limitEvents, limitsStatus] = hasBot
  ? await Promise.all([listContactLimitEvents(db, clinic.clinicId, contact.id), getContactBotLimitsStatus(db, clinic.clinicId, contact.id)])
  : [[], null];
const pendingLimit = limitEvents[0] && limitsStatus && isPendingReview(limitEvents[0], limitsStatus.reviewedAt) ? limitEvents[0] : null;
const canReview = clinic.isPlatformStaff || clinic.roles.includes("admin") || clinic.roles.includes("reception");
const canExempt = clinic.isPlatformStaff || clinic.roles.includes("admin");
const canBlock = canExempt;
const [block, futureCount] = hasBot
  ? await Promise.all([getContactBlock(db, clinic.clinicId, contact.id), listContactFutureAppointmentIds(db, clinic.clinicId, contact.id).then((ids) => ids.length)])
  : [null, 0];
const blockedBy = block?.blockedBy ? await exemptByLabel(db, clinic.clinicId, block.blockedBy) : null;
const exemptBy = limitsStatus?.exemptAt && limitsStatus.exemptBy ? await exemptByLabel(db, clinic.clinicId, limitsStatus.exemptBy) : null;
const financeOn = canAccessArea(clinic, "finance") && !contact.anonymizedAt;
const canEditFinance = financeOn && (clinic.roles.includes("admin") || clinic.roles.includes("reception"));
const contactCpf = financeOn ? await getContactCpf(db, clinic.clinicId, contact.id) : null;
const financeAction = withReturn(`/api/admin/financeiro/contato/${contact.id}`, volta);
const when = (event: BotLimitEvent) => formatInstant(event.at, clinic.timezone, "dd/MM 'às' HH:mm");
const limitLine = (event: BotLimitEvent) => `${BOT_LIMIT_LABELS[event.reason]}: ${describeBotLimitHit(event)}`;
// "Bloquear no bot…" (no "Mais") abre o cartão com o motivo.
const blocking = hasBot && canBlock && !block && Astro.url.searchParams.get("bloquear") === "1";
const blockHref = `${withReturn(`/admin/pacientes/contato/${contact.id}?bloquear=1`, volta)}#bloqueio`;
const pageHref = withReturn(`/admin/pacientes/contato/${contact.id}`, volta);
const showMenu = !contact.anonymizedAt || (hasBot && canExempt && limitsStatus);

const card = "flex flex-col gap-3 rounded-xl border border-line bg-white p-3.5 sm:px-5 sm:py-[18px]";
const sectionTitle = "font-display text-[17px] leading-tight font-bold text-ink sm:text-lg";
const field = "flex flex-col gap-1.5";
const fieldLabel = "text-[14.5px] font-semibold text-ink";
const hint = "text-sm text-ink-soft";
const kv = "grid grid-cols-[150px_minmax(0,1fr)] gap-x-3 gap-y-2 text-[15px]";
const dt = "text-ink-soft";
const dd = "font-semibold text-ink";
---

<AdminLayout title={contact.fullName}>
  <a href={volta ?? "/admin/pacientes?tab=contatos"} class="inline-flex min-h-8 items-center gap-1 text-[15px] font-semibold text-brand no-underline hover:underline">
    <Icon name="chevron-left" class="h-[18px] w-[18px]" strokeWidth={2.2} />
    {volta ? "Voltar" : capitalize(vocabulary.contacts)}
  </a>
  <FlashMessage />

  <section aria-label={capitalize(vocabulary.contact)} class={`${card} mt-3 sm:px-6 sm:py-5`}>
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="flex min-w-0 flex-col gap-2">
        <div class="flex flex-wrap items-center gap-2.5">
          <h1 class="font-display text-[26px] leading-[1.1] font-bold text-ink sm:text-[30px]">{contact.fullName}</h1>
          {contact.anonymizedAt ? <Pill tone="warning">Anonimizado</Pill> : !contact.isActive && <Pill tone="neutral">Desativado</Pill>}
          {contact.botBlockedAt && <Pill tone="danger" icon="lock">Bloqueado</Pill>}
          {pendingLimit && <Pill tone="warning" icon="warning">Para revisar</Pill>}
        </div>
        <PhoneLinks phone={contact.phone} plain class="text-[15.5px] text-ink" />
      </div>
      {
        showMenu && (
          <MoreMenu id="mais-contato" label={`Mais ações: ${contact.fullName}`} size="md">
            {hasBot && canExempt && limitsStatus && (
              <form method="POST" action={action}>
                <input type="hidden" name="acao" value={limitsStatus.exemptAt ? "aplicar_limites" : "liberar_limites"} />
                <button
                  type="submit"
                  class={`${menuItemClass()} js-confirm-delete`}
                  data-confirm-title={limitsStatus.exemptAt ? "Voltar a aplicar os limites?" : "Liberar dos limites do bot?"}
                  data-confirm-message={
                    limitsStatus.exemptAt
                      ? "O bot volta a aplicar os limites de atendimentos, cadastros e faltas a este número."
                      : "O bot deixa de aplicar os limites de atendimentos, cadastros e faltas a este número até alguém desfazer. Use para quem marca muitos pacientes com acordo da clínica (ex.: uma empresa)."
                  }
                  data-confirm-label={limitsStatus.exemptAt ? "Aplicar os limites" : "Liberar"}
                >
                  {limitsStatus.exemptAt ? "Voltar a aplicar os limites" : "Liberar dos limites do bot…"}
                </button>
              </form>
            )}
            {!contact.anonymizedAt && (
              <form method="POST" action={action}>
                <input type="hidden" name="acao" value={contact.isActive ? "desativar" : "reativar"} />
                <button
                  type="submit"
                  class={`${menuItemClass()} ${contact.isActive ? "js-confirm-delete" : ""}`}
                  data-confirm-title={`Desativar o ${vocabulary.contact}?`}
                  data-confirm-message="Sai das telas de marcação; o histórico fica. Dá para reativar depois."
                  data-confirm-label="Desativar"
                >
                  {contact.isActive ? `Desativar o ${vocabulary.contact}` : `Reativar o ${vocabulary.contact}`}
                </button>
              </form>
            )}
            {hasBot && canBlock && !block && (
              <a href={blockHref} class={`${menuItemClass(true)} mt-1 border-t border-line pt-1`}>
                Bloquear no bot…
              </a>
            )}
          </MoreMenu>
        )
      }
    </div>
    {
      pendingLimit && (
        <div class="flex flex-wrap items-start gap-x-3 gap-y-2 rounded-[10px] border border-pend-200 bg-pend-50 px-3.5 py-3 text-[15px] leading-snug text-pend-800" role="status">
          <Icon name="warning" class="mt-0.5 h-[18px] w-[18px] shrink-0" strokeWidth={2} />
          <span class="min-w-0 flex-[1_1_240px]">
            {pendingLimit.paused ? "Bot pausado" : "O bot não marcou"} em {when(pendingLimit)}. {limitLine(pendingLimit)}.
            {pendingLimit.paused ? " A conversa está com a recepção." : " A recepção precisa entrar em contato."}
          </span>
          {canReview && (
            <form method="POST" action={action}>
              <input type="hidden" name="acao" value="revisado" />
              <Button
                type="submit"
                size="sm"
                class="js-confirm-delete"
                data-confirm-title="Marcar como revisado?"
                data-confirm-message="O contato sai de &quot;Contatos para revisar&quot; no Painel. Se atingir um limite de novo, volta para a lista."
                data-confirm-label="Revisado"
              >
                Revisado
              </Button>
            </form>
          )}
        </div>
      )
    }
    {
      contact.anonymizedAt && (
        <p class="flex items-start gap-2.5 rounded-[10px] border border-line bg-canvas px-3.5 py-3 text-[15px] leading-snug text-ink">
          <Icon name="information-circle" class="mt-0.5 h-[18px] w-[18px] shrink-0 text-ink-soft" strokeWidth={2} />
          Anonimizado a pedido (LGPD): nome, telefone e mensagens foram apagados. Para os outros pacientes dele voltarem a receber mensagens, informe em
          "Dados" o nome e o WhatsApp de quem fala por eles agora.
        </p>
      )
    }
  </section>

  <div class="mt-4 grid items-start gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-5">
    <section aria-labelledby="pacientes-titulo" class={card}>
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 id="pacientes-titulo" class={sectionTitle}>
          {capitalize(vocabulary.patients)} <span class="font-medium text-ink-soft">({patients.length})</span>
        </h2>
        {
          contact.isActive && (
            <Button href={withReturn(`/admin/pacientes/novo?contato=${contact.id}`, here)} variant="primary" size="sm">
              <Icon name="plus" class="h-4 w-4" strokeWidth={2.2} /> Cadastrar outro
            </Button>
          )
        }
      </div>
      <ul>
        {
          patients.map((p) => (
            <li class={`border-t border-line first:border-t-0 ${p.isActive ? "" : "opacity-60"}`}>
              <a href={withReturn(`/admin/pacientes/${p.id}`, here)} class="grid grid-cols-[minmax(0,1fr)_auto_20px] items-center gap-3 py-3 text-ink no-underline hover:bg-canvas/60">
                <span class="flex min-w-0 flex-wrap items-center gap-2">
                  <span class="text-base font-semibold">{p.fullName}</span>
                  {p.isContactSelf && <span class="text-sm text-ink-soft">(ele mesmo)</span>}
                  {!p.isActive && <Pill tone="neutral">Desativado</Pill>}
                </span>
                <span class="text-sm text-ink-soft">{formatAge(p.birthdate, today)}</span>
                <Icon name="chevron-right" class="h-[18px] w-[18px] text-ink-soft" strokeWidth={2.2} />
              </a>
            </li>
          ))
        }
      </ul>
      {patients.length === 0 && <p class="text-[15px] text-ink-soft">Nenhum.</p>}
    </section>

    <div class="flex flex-col gap-4">
      {
        blocking && (
          <section id="bloqueio" aria-labelledby="bloquear-titulo" class={`${card} border-danger-line`}>
            <h2 id="bloquear-titulo" class={sectionTitle}>Bloquear no bot</h2>
            <form method="POST" action={action} class="flex flex-col gap-4">
              <input type="hidden" name="acao" value="bloquear" />
              <p class={hint}>
                O bot deixa de atender este número: não marca, não cadastra e responde, uma vez por dia, que a conversa está com a recepção. A equipe continua
                marcando pelo painel. Os pacientes dele saem da lista de espera.
              </p>
              <div class={field}>
                <label for="motivo" class={fieldLabel}>
                  Motivo <span class="font-normal text-ink-soft">(opcional)</span>
                </label>
                <input id="motivo" name="motivo" maxlength="300" class={CONTROL} />
              </div>
              {futureCount > 0 && (
                <label class="flex items-start gap-2.5 text-[15px] leading-snug text-ink">
                  <input type="checkbox" name="cancelar_futuros" checked class="mt-0.5 h-[18px] w-[18px] shrink-0 accent-brand" />
                  <span>
                    Cancelar {futureCount === 1 ? "o atendimento futuro" : `os ${futureCount} atendimentos futuros`} ligados a este contato, sem aviso (não gasta
                    template; a vaga volta para a lista de espera). Séries terminam.
                  </span>
                </label>
              )}
              <div class="flex gap-2">
                <Button
                  type="submit"
                  variant="danger"
                  class="js-confirm-delete"
                  data-confirm-title="Bloquear o contato?"
                  data-confirm-message="O bot deixa de atender este número. Se a opção de cancelar estiver marcada, os atendimentos futuros são cancelados sem aviso e as séries terminam; desbloquear não desfaz isso."
                  data-confirm-label="Bloquear"
                >
                  Bloquear contato
                </Button>
                <Button href={pageHref}>Cancelar</Button>
              </div>
            </form>
          </section>
        )
      }

      {
        hasBot && block && (
          <section aria-labelledby="bloqueio-titulo" class={`${card} border-danger-line`}>
            <h2 id="bloqueio-titulo" class={sectionTitle}>Bloqueio no bot</h2>
            <p class="text-[15px] leading-snug text-can-800">
              Bloqueado por {blockedBy ?? "—"} em {formatInstant(block.blockedAt, clinic.timezone, "dd/MM/yyyy 'às' HH:mm")}. O bot não atende este número
              (responde, uma vez por dia, que a conversa está com a recepção); só os botões do lembrete funcionam.
            </p>
            {block.reason && <p class="text-[15px] text-ink">Motivo: {block.reason}</p>}
            {canBlock && (
              <form method="POST" action={action}>
                <input type="hidden" name="acao" value="desbloquear" />
                <Button
                  type="submit"
                  class="js-confirm-delete"
                  data-confirm-title="Desbloquear o contato?"
                  data-confirm-message="O bot volta a atender este número. Atendimentos cancelados no bloqueio não voltam."
                  data-confirm-label="Desbloquear"
                >
                  Desbloquear
                </Button>
              </form>
            )}
          </section>
        )
      }

      <EditCard id="dados" title="Dados" summary={contact.anonymizedAt ? "Anonimizado" : formatPhoneBR(contact.phone)}>
        <dl class={kv}>
          <dt class={dt}>Nome</dt>
          <dd class={contact.anonymizedAt ? "text-ink-soft" : dd}>{contact.anonymizedAt ? "anonimizado" : contact.fullName}</dd>
          <dt class={dt}>WhatsApp</dt>
          <dd class={contact.anonymizedAt ? "text-ink-soft" : `${dd} tabular-nums`}>{contact.anonymizedAt ? "anonimizado" : formatPhoneBR(contact.phone)}</dd>
          {
            homeVisitOn && (
              <>
                <dt class={dt}>Endereço domiciliar</dt>
                <dd class={contact.defaultHomeAddress ? "font-medium text-ink" : "text-ink-soft"}>{contact.defaultHomeAddress ?? "não informado"}</dd>
              </>
            )
          }
        </dl>
        <p class={hint}>É pelo WhatsApp que a clínica conversa com ele e envia lembretes.</p>
        <form slot="edit" method="POST" action={action} class="flex flex-col gap-4">
          <input type="hidden" name="acao" value="salvar" />
          <div class={field}>
            <label for="full_name" class={fieldLabel}>Nome</label>
            <input id="full_name" name="full_name" required value={contact.anonymizedAt ? "" : contact.fullName} class={CONTROL} />
          </div>
          <div class={field}>
            <label for="phone" class={fieldLabel}>WhatsApp</label>
            <input
              id="phone"
              name="phone"
              type="tel"
              required
              value={contact.anonymizedAt ? "" : formatPhoneBR(contact.phone)}
              aria-describedby="phone-hint"
              class={`${CONTROL} w-full sm:w-64`}
            />
            <p id="phone-hint" class={hint}>É por este número que a clínica conversa com ele e envia lembretes.</p>
          </div>
          {
            homeVisitOn && (
              <div class={field}>
                <label for="default_home_address" class={fieldLabel}>
                  Endereço do atendimento domiciliar
                </label>
                <input
                  id="default_home_address"
                  name="default_home_address"
                  value={contact.defaultHomeAddress ?? ""}
                  aria-describedby="address-hint"
                  class={CONTROL}
                />
                <p id="address-hint" class={hint}>Já vem preenchido ao marcar um atendimento domiciliar.</p>
              </div>
            )
          }
          <div class="flex gap-2">
            <Button type="submit" variant="primary" data-sending-label="Salvando…">Salvar</Button>
            <Button href={here} data-edit-cancel>Cancelar</Button>
          </div>
        </form>
      </EditCard>

      {
        financeOn && (
          <EditCard id="financeiro" title="Financeiro" summary={contactCpf ? `CPF ${formatCpf(contactCpf)}` : "Sem CPF"} editable={canEditFinance}>
            <dl class={kv}>
              <dt class={dt}>CPF</dt>
              <dd class={contactCpf ? `${dd} tabular-nums` : "text-ink-soft"}>{contactCpf ? formatCpf(contactCpf) : "não informado"}</dd>
            </dl>
            <p class={hint}>Usado na nota fiscal quando {contact.fullName} é quem paga, o padrão para os cadastros deste WhatsApp.</p>
            <form slot="edit" method="POST" action={financeAction} class="flex flex-col gap-4">
              <div class={field}>
                <label for="fin_cpf" class={fieldLabel}>CPF</label>
                <input id="fin_cpf" name="cpf" inputmode="numeric" placeholder="000.000.000-00" value={contactCpf ? formatCpf(contactCpf) : ""} class={`${CONTROL} w-full sm:w-56`} />
              </div>
              <div class="flex gap-2">
                <Button type="submit" variant="primary" data-sending-label="Salvando…">Salvar CPF</Button>
                <Button href={here} data-edit-cancel>Cancelar</Button>
              </div>
            </form>
          </EditCard>
        )
      }

      {
        hasBot && limitsStatus && (
          <EditCard id="limites" title="Limites do bot" summary={limitEvents.length ? `${limitEvents.length} atingido(s)` : "Nenhum atingido"} editable={false}>
            {limitsStatus.exemptAt ? (
              <p class="text-[15px] leading-snug text-conf-800">
                Liberado dos limites do bot por {exemptBy ?? "—"} em {formatInstant(limitsStatus.exemptAt, clinic.timezone, "dd/MM/yyyy")}: o bot marca e cadastra
                para este número sem limite.
              </p>
            ) : (
              <p class={hint}>Atendimentos futuros, cadastros pelo bot e faltas, somando os pacientes deste número (Configurações › Clínica).</p>
            )}
            {limitEvents.length > 0 ? (
              <ul class="text-[15px]">
                {limitEvents.map((event) => (
                  <li class="border-t border-line py-2 first:border-t-0">
                    <span class="text-ink-soft tabular-nums">{when(event)}</span> · <span class="text-ink">{limitLine(event)}</span>
                    <span class="text-ink-soft">{event.paused ? " · conversa passada à recepção" : " · sem pausa (número sem coexistência)"}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-[15px] text-ink-soft">Nenhum limite atingido.</p>
            )}
          </EditCard>
        )
      }
    </div>
  </div>
  <ConfirmDeleteDialog />
</AdminLayout>

---
import AdminLayout from "../../../../../../layouts/AdminLayout.astro";
import Card from "../../../../../../components/admin/Card.astro";
import Icon from "../../../../../../components/admin/Icon.astro";
import { createClient } from "../../../../../../lib/supabase/server";
import { isOverConsultationAgeLimit } from "../../../../../../lib/age";
import { todayFortaleza } from "../../../../../../lib/scheduling/returnVisitDeadline";
import {
  PATIENT_FORM_ERRORS,
  consultationAgeLimitWarning,
  getConsultationAgeLimit,
} from "../../../../../../lib/patientRegistration";

const supabase = createClient(Astro.request, Astro.cookies);
const { id: guardianId, patientId } = Astro.params;

const { data: guardian } = await supabase
  .from("guardians")
  .select("id, full_name")
  .eq("id", guardianId)
  .maybeSingle();

if (!guardian) {
  return Astro.redirect("/admin/pacientes?error=not_found");
}

const { data: patient } = await supabase
  .from("patients")
  .select("id, full_name, birthdate, notes, is_guardian_self")
  .eq("id", patientId)
  .eq("guardian_id", guardianId)
  .maybeSingle();

if (!patient) {
  return Astro.redirect(`/admin/pacientes/${guardianId}?error=not_found`);
}

const errorParam = Astro.url.searchParams.get("error");
const errorMessage = errorParam ? (PATIENT_FORM_ERRORS[errorParam] ?? PATIENT_FORM_ERRORS["1"]) : null;

// Aviso (sem bloquear) pela data de nascimento já gravada.
const ageLimit = await getConsultationAgeLimit(supabase);
const overAgeLimit = isOverConsultationAgeLimit(patient.birthdate, todayFortaleza(), ageLimit);
---

<AdminLayout title={`Editar ${patient.full_name}`}>
  <a
    href={`/admin/pacientes/${guardian.id}`}
    class="inline-flex items-center gap-1 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-50"
  >
    <Icon name="chevron-left" class="h-4 w-4" />
    {guardian.full_name}
  </a>

  <h1 class="mt-3 text-2xl font-bold text-slate-900">Editar paciente</h1>
  {
    patient.is_guardian_self && (
      <p class="mt-1 text-sm text-slate-600">
        Próprio responsável — o nome do responsável acompanha o nome do paciente, e a data de nascimento precisa
        ser de 18 anos ou mais.
      </p>
    )
  }
  {
    overAgeLimit && (
      <p class="mt-3 max-w-xl rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">
        {consultationAgeLimitWarning(ageLimit)}
      </p>
    )
  }

  {
    errorMessage && (
      <p class="mt-4 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">{errorMessage}</p>
    )
  }

  <Card class="mt-4 max-w-xl">
    <form
      method="POST"
      action={`/api/admin/pacientes/${guardian.id}/criancas/${patient.id}/editar`}
      class="flex flex-col gap-4"
    >
      <div>
        <label for="full_name" class="block text-sm font-medium text-slate-700">Nome</label>
        <input
          type="text"
          id="full_name"
          name="full_name"
          value={patient.full_name}
          required
          class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600"
        />
      </div>
      <div>
        <label for="birthdate" class="block text-sm font-medium text-slate-700">
          Data de nascimento
        </label>
        <input
          type="date"
          id="birthdate"
          name="birthdate"
          value={patient.birthdate}
          min="1900-01-01"
          max={todayFortaleza()}
          required
          class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600"
        />
      </div>
      <div>
        <label for="notes" class="block text-sm font-medium text-slate-700">
          Observação (operacional, não clínica)
        </label>
        <input
          type="text"
          id="notes"
          name="notes"
          value={patient.notes ?? ""}
          class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600"
        />
      </div>
      <div class="flex flex-col-reverse gap-2 sm:flex-row sm:items-center">
        <a
          href={`/admin/pacientes/${guardian.id}`}
          class="w-full rounded-md border border-slate-300 px-4 py-3 text-center text-sm font-semibold text-slate-600 hover:bg-slate-50 sm:w-fit"
        >
          Cancelar
        </a>
        <button
          type="submit"
          class="w-full rounded-md bg-sky-700 px-4 py-3 text-sm font-semibold text-white hover:bg-sky-800 sm:w-fit"
        >
          Salvar
        </button>
      </div>
    </form>
  </Card>
</AdminLayout>

---
// Histórico de agendamentos da criança (Fase 17): atendimentos com status e
// quem marcou/remarcou/cancelou. Fase 22 · etapa 4: futuros no topo (o
// próximo primeiro) + os 10 passados mais recentes, com "Mostrar mais
// antigos" de 10 em 10 (`?passados=`); cada card traz a trilha recolhida,
// buscada só ao abrir (`/admin/trilha/[id]`), e o aviso de envio com falha
// visível mesmo fechado.
import NoShowBadge from "../../../../../../components/admin/NoShowBadge.astro";
import { fetchNoShowStats } from "../../../../../../lib/noShow";
import AdminLayout from "../../../../../../layouts/AdminLayout.astro";
import Card from "../../../../../../components/admin/Card.astro";
import Badge from "../../../../../../components/admin/Badge.astro";
import type { BadgeVariant } from "../../../../../../components/admin/Badge.astro";
import Icon from "../../../../../../components/admin/Icon.astro";
import { createClient } from "../../../../../../lib/supabase/server";
import { buildAppointmentTypeLabel } from "../../../../../../lib/whatsapp/notifications";
import { formatWhen } from "../../../../../../lib/whatsapp/formatDateTime";
import { AUTHORSHIP_COLUMNS, fetchStaffLabels, formatBookedByLines, formatCanceledByLine } from "../../../../../../lib/authorship";
import { fetchTrailSummaries } from "../../../../../../lib/appointmentTrail";

const supabase = createClient(Astro.request, Astro.cookies);
const { id: guardianId, patientId } = Astro.params;

const { data: guardian } = await supabase
  .from("guardians")
  .select("id, full_name")
  .eq("id", guardianId)
  .maybeSingle();

if (!guardian) {
  return Astro.redirect("/admin/pacientes?error=not_found");
}

const { data: patient } = await supabase
  .from("patients")
  .select("id, full_name")
  .eq("id", patientId)
  .eq("guardian_id", guardianId)
  .maybeSingle();

if (!patient) {
  return Astro.redirect(`/admin/pacientes/${guardianId}?error=not_found`);
}

// Selo "Faltou X de Y" (Fase 23 · etapa 7).
const noShowStats = await fetchNoShowStats(supabase, [patient.id]);

const PAST_PAGE_SIZE = 10;
const requestedPast = Number.parseInt(Astro.url.searchParams.get("passados") ?? "", 10);
const pastLimit =
  Number.isFinite(requestedPast) && requestedPast > PAST_PAGE_SIZE
    ? Math.ceil(requestedPast / PAST_PAGE_SIZE) * PAST_PAGE_SIZE
    : PAST_PAGE_SIZE;

const nowIso = new Date().toISOString();
const appointmentColumns = `id, scheduled_at, appointment_type, status, home_visit_address, ${AUTHORSHIP_COLUMNS}, clinic_locations ( type ), exam_types ( name ), origin:origin_appointment_id ( scheduled_at )`;

const [{ data: futureAppointments }, { data: pastAppointmentsPlusOne }, staffLabels] = await Promise.all([
  supabase
    .from("appointments")
    .select(appointmentColumns)
    .eq("patient_id", patient.id)
    .gte("scheduled_at", nowIso)
    .order("scheduled_at", { ascending: true }),
  // Um a mais que o limite, só pra saber se ainda há mais antigos.
  supabase
    .from("appointments")
    .select(appointmentColumns)
    .eq("patient_id", patient.id)
    .lt("scheduled_at", nowIso)
    .order("scheduled_at", { ascending: false })
    .limit(pastLimit + 1),
  fetchStaffLabels(supabase),
]);

const hasOlder = (pastAppointmentsPlusOne ?? []).length > pastLimit;
const pastAppointments = (pastAppointmentsPlusOne ?? []).slice(0, pastLimit);

const trailSummaries = await fetchTrailSummaries(supabase, [...(futureAppointments ?? []), ...pastAppointments]);

const statusLabels: Record<string, { label: string; variant: BadgeVariant }> = {
  scheduled: { label: "Agendada", variant: "info" },
  confirmed: { label: "Confirmada", variant: "info" },
  completed: { label: "Realizada", variant: "success" },
  no_show: { label: "Não compareceu", variant: "danger" },
  canceled: { label: "Cancelada", variant: "neutral" },
};

function typeBadgeVariant(type: string): BadgeVariant {
  if (type === "exam") return "warning";
  if (type === "return_visit") return "accent";
  return "info";
}

function locationLabel(type: string | undefined): string {
  if (type === "clinic") return "Consultório";
  if (type === "exam") return "Exames";
  return "Domiciliar";
}

function formatDateBR(iso: string): string {
  return new Intl.DateTimeFormat("pt-BR", {
    timeZone: "America/Fortaleza",
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  }).format(new Date(iso));
}

function toRow(a: NonNullable<typeof futureAppointments>[number]) {
  const location = (a.clinic_locations ?? null) as unknown as { type: string } | null;
  const examType = (a.exam_types ?? null) as unknown as { name: string } | null;
  const origin = (a.origin ?? null) as unknown as { scheduled_at: string } | null;
  const status = statusLabels[a.status] ?? { label: a.status, variant: "neutral" as BadgeVariant };

  const canceledByLine = formatCanceledByLine(a, staffLabels);
  const authorLines = [...formatBookedByLines(a, staffLabels), ...(canceledByLine ? [canceledByLine] : [])];

  return {
    id: a.id,
    whenLabel: formatWhen(new Date(a.scheduled_at)),
    typeLabel: buildAppointmentTypeLabel(a.appointment_type, examType?.name),
    typeVariant: typeBadgeVariant(a.appointment_type),
    locationLabel: a.appointment_type === "exam" ? null : locationLabel(location?.type),
    homeVisitAddress: a.home_visit_address as string | null,
    originLabel: origin ? `Retorno da consulta de ${formatDateBR(origin.scheduled_at)}` : null,
    status,
    authorLines,
    trail: trailSummaries.get(a.id) ?? { count: 0, failedSends: 0 },
  };
}

const futureRows = (futureAppointments ?? []).map(toRow);
const pastRows = pastAppointments.map(toRow);
const olderHref = `?passados=${pastLimit + PAST_PAGE_SIZE}${pastRows.length ? `#card-${pastRows[pastRows.length - 1].id}` : ""}`;
const sections = [
  { title: "Próximos", rows: futureRows },
  { title: "Anteriores", rows: pastRows },
].filter((section) => section.rows.length > 0);
---

<AdminLayout title={`Histórico de ${patient.full_name}`}>
  <a
    href={`/admin/pacientes/${guardian.id}`}
    class="inline-flex items-center gap-1 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-50"
  >
    <Icon name="chevron-left" class="h-4 w-4" />
    {guardian.full_name}
  </a>

  <h1 class="mt-3 text-2xl font-bold text-slate-900">Histórico de agendamentos</h1>
  <p class="mt-1 flex flex-wrap items-center gap-2 text-slate-600">
    {patient.full_name}
    <NoShowBadge stats={noShowStats.get(patient.id)} />
  </p>

  <div class="mt-6 flex max-w-xl flex-col gap-6">
    {
      sections.length ? (
        sections.map((section) => (
          <section class="flex flex-col gap-3">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">{section.title}</h2>
            {section.rows.map((row) => (
              <Card>
                <div id={`card-${row.id}`} class="scroll-mt-20">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <span class="text-base font-semibold text-slate-900">{row.whenLabel}</span>
                    <Badge variant={row.status.variant}>{row.status.label}</Badge>
                  </div>
                  <div class="mt-1.5 flex flex-wrap items-center gap-2">
                    <Badge variant={row.typeVariant}>{row.typeLabel}</Badge>
                    {row.locationLabel && <span class="text-sm text-slate-500">{row.locationLabel}</span>}
                  </div>
                  {row.homeVisitAddress && <p class="mt-1 text-sm text-slate-500">Endereço: {row.homeVisitAddress}</p>}
                  {row.originLabel && <p class="mt-1 text-sm text-slate-500">{row.originLabel}</p>}
                  {row.authorLines.map((line) => <p class="mt-1 text-xs text-slate-400">{line}</p>)}
                  {row.trail.failedSends > 0 && (
                    <p class="mt-2 text-sm font-medium text-red-700">
                      ⚠ {row.trail.failedSends} {row.trail.failedSends === 1 ? "envio com falha" : "envios com falha"}
                    </p>
                  )}
                  {row.trail.count > 0 && (
                    <details class="trail mt-3 border-t border-slate-100 pt-2" data-trail-url={`/admin/trilha/${row.id}`}>
                      <summary class="cursor-pointer select-none text-sm font-medium text-slate-600 hover:text-slate-900">
                        Ver trilha ({row.trail.count})
                      </summary>
                      <div class="trail-body mt-2 text-sm text-slate-500">Carregando…</div>
                    </details>
                  )}
                </div>
              </Card>
            ))}
            {section.title === "Anteriores" && hasOlder && (
              <a
                href={olderHref}
                class="self-start rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-50"
              >
                Mostrar mais antigos
              </a>
            )}
          </section>
        ))
      ) : (
        <Card class="text-slate-500">Nenhum agendamento para esse paciente ainda.</Card>
      )
    }
  </div>
</AdminLayout>

<script>
  // Trilha buscada só na primeira vez que o card é aberto.
  document.querySelectorAll<HTMLDetailsElement>("details.trail").forEach((details) => {
    details.addEventListener("toggle", async () => {
      if (!details.open || details.dataset.loaded) return;
      details.dataset.loaded = "1";
      const body = details.querySelector<HTMLElement>(".trail-body");
      if (!body) return;
      try {
        const response = await fetch(details.dataset.trailUrl ?? "");
        // Sessão expirada: o middleware redireciona pro login — não injeta a tela de login no card.
        if (!response.ok || response.redirected) throw new Error(String(response.status));
        body.innerHTML = await response.text();
      } catch {
        delete details.dataset.loaded;
        body.textContent = "Não foi possível carregar a trilha. Feche e abra de novo para tentar outra vez.";
      }
    });
  });
</script>

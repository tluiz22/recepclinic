---
import { logError } from "../../../lib/log";
// Pacientes › cadastrar (F4.7; antes, o cadastro rápido do Marcar, F4.5):
// nome, nascimento, observações, plano de saúde (com o item "Convênios") e
// quem fala com a clínica pelo WhatsApp: o próprio paciente (maior de 18), um
// responsável/contato novo, ou o contato da página dele (`?contato=`). Vindo
// do Marcar (`?volta=`), volta para lá com o paciente escolhido; vindo de
// outra tela, "Voltar" leva a ela (cliente, 10/out/2026). A página
// mesma recebe o envio: as confirmações (mesma pessoa, possível repetido)
// voltam na tela com os dados, nunca no endereço.
//
// Redesign R6 (proposta aprovada pelo cliente em 16/out/2026): 3 blocos
// numerados (paciente, quem fala pelo WhatsApp, plano de saúde), "quem fala"
// em cartões de escolha e cada aviso junto do campo dele.
import { receivedReturn, withReturn } from "../../../lib/returnPath";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import FormMessage from "../../../components/admin/FormMessage.astro";
import Icon from "../../../components/admin/Icon.astro";
import Button from "../../../components/admin/ui/Button.astro";
import PageHeader from "../../../components/admin/ui/PageHeader.astro";
import { CONTROL } from "../../../components/admin/ui/styles";
import { isUuid } from "../../../lib/clinicAccess";
import { todayIn } from "../../../lib/clinicTime";
import { createUserClient } from "../../../lib/data/clients";
import { listInsurancePlans } from "../../../lib/data/config/insurance";
import { DataError } from "../../../lib/data/errors";
import { describeDataError } from "../../../lib/data/formAction";
import { getContact, registerPatient, type ContactChoice } from "../../../lib/data/patients";
import { setFlash } from "../../../lib/flash";
import { formChecked, formOptionalText, formText } from "../../../lib/forms";
import { formatPhoneBR } from "../../../lib/phone";
import { capitalize, vocabularyFor } from "../../../lib/vocabulary";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const vocabulary = vocabularyFor(clinic.clinicProfile);
const today = todayIn(clinic.timezone);
const params = Astro.url.searchParams;
const volta = params.get("volta") ?? "";
const backToBooking = /^\/admin\/agenda\/marcar(\?[^\s]*)?$/.test(volta) ? volta : null;
const contactParam = params.get("contato");
const fixedContact = isUuid(contactParam) ? await getContact(db, clinic.clinicId, contactParam).catch(() => null) : null;
const insuranceOn = clinic.features.includes("insurance");
const plans = insuranceOn ? await listInsurancePlans(db, clinic.clinicId) : [];
const origin = backToBooking ? null : receivedReturn(Astro.url);
const backHref = backToBooking ?? origin ?? (fixedContact ? `/admin/pacientes/contato/${fixedContact.id}` : "/admin/pacientes");

const card = "flex flex-col gap-4 rounded-xl border border-line bg-white p-3.5 sm:px-5 sm:py-[18px]";
const blockTitle = "flex items-center gap-2.5 font-display text-[17px] leading-tight font-bold text-ink sm:text-lg";
const number = "flex h-[26px] w-[26px] shrink-0 items-center justify-center rounded-full bg-brand font-sans text-sm font-bold text-white";
const field = "flex flex-col gap-1.5";
const fieldLabel = "text-[14.5px] font-semibold text-ink";
const optional = "font-normal text-ink-soft";
const hint = "text-sm text-ink-soft";
const choice =
  "relative flex flex-1 cursor-pointer items-start gap-3 rounded-[10px] border border-line-strong bg-white px-3.5 py-3 text-left has-[:checked]:border-brand has-[:checked]:bg-brand-soft/60 has-[:checked]:shadow-[0_0_0_1px_var(--color-brand)] has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-brand";
const fieldError = "flex items-start gap-1.5 text-sm font-semibold text-danger";
const invalidControl = "border-danger focus:border-danger focus:ring-danger";
const firstInvalid = (name: string) => Object.keys(fieldErrors).sort((a, b) => FIELD_ORDER.indexOf(a) - FIELD_ORDER.indexOf(b))[0] === name;
const FIELD_ORDER = ["full_name", "birthdate", "mode", "contact_name", "phone", "card_valid_until"];
/** Atributos do campo com erro: marcado, ligado à mensagem e, o primeiro, com o foco. */
const invalidAttrs = (name: string, describedBy?: string): { "aria-invalid"?: "true"; "aria-describedby"?: string; autofocus?: boolean } =>
  fieldErrors[name]
    ? { "aria-invalid": "true", "aria-describedby": [`${name}-erro`, describedBy].filter(Boolean).join(" "), autofocus: firstInvalid(name) }
    : describedBy
      ? { "aria-describedby": describedBy }
      : {};
const alertBox = "flex items-start gap-2.5 rounded-[10px] border border-pend-200 bg-pend-50 px-3.5 py-3 text-[15px] leading-snug text-pend-800";

const values = {
  full_name: "",
  birthdate: "",
  notes: "",
  mode: fixedContact ? "existing" : clinic.clinicProfile === "adult" ? "self" : "new",
  contact_name: "",
  phone: "",
  plan_id: "",
  card_number: "",
  card_valid_until: "",
  confirmed_contact_id: "",
};
let error: string | null = null;
// Erro de validação junto do campo (teste da R6, QA-03): o nome na camada de
// dados vira o nome do campo do formulário; o primeiro recebe o foco.
const FIELD_OF: Record<string, string> = {
  fullName: "full_name",
  birthdate: "birthdate",
  isContactSelf: "mode",
  contactFullName: "contact_name",
  phone: "phone",
  cardValidUntil: "card_valid_until",
};
let fieldErrors: Record<string, string> = {};
let notice: string | null = null;
let askDuplicate = false;
/** O aviso do número já cadastrado fica junto do WhatsApp; o do repetido, junto da confirmação. */
let samePerson = false;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData().catch(() => null);
  for (const key of Object.keys(values) as (keyof typeof values)[]) values[key] = formText(form, key);
  if (fixedContact) values.mode = "existing";
  const contact: ContactChoice =
    values.mode === "existing" && fixedContact
      ? { mode: "existing", contactId: fixedContact.id }
      : values.mode === "self"
        ? { mode: "self", phone: values.phone, confirmedContactId: formOptionalText(form, "confirmed_contact_id") ?? undefined }
        : { mode: "new", fullName: values.contact_name, phone: values.phone };
  try {
    const result = await registerPatient(
      db,
      clinic.clinicId,
      {
        fullName: values.full_name,
        birthdate: values.birthdate,
        notes: values.notes,
        insurance: insuranceOn && values.plan_id ? { planId: values.plan_id, cardNumber: values.card_number, cardValidUntil: values.card_valid_until } : null,
        contact,
        confirmDuplicate: formChecked(form, "confirm_duplicate"),
      },
      today,
    );
    if (result.status === "created") {
      const age = result.overConsultationAgeLimit ? " Passou da idade limite da Consulta (só aviso)." : "";
      setFlash(Astro.cookies, { tone: "success", text: `${capitalize(vocabulary.patient)} cadastrado.${age}` });
      const to = backToBooking ? `${backToBooking}${backToBooking.includes("?") ? "&" : "?"}patient_id=${result.patient.id}` : withReturn(`/admin/pacientes/${result.patient.id}`, origin);
      return Astro.redirect(to, 303);
    }
    if (result.status === "confirm_same_person") {
      values.confirmed_contact_id = result.contact.id;
      samePerson = true;
      notice = `Este WhatsApp já é de ${result.contact.fullName}. Se for a mesma pessoa, confirme abaixo.`;
    } else {
      askDuplicate = true;
      notice = `Este ${vocabulary.contact} já tem ${result.existingNames.join(", ")} com a mesma data de nascimento. Se for outra pessoa, marque a confirmação abaixo.`;
    }
  } catch (caught) {
    if (!(caught instanceof DataError)) logError("paciente novo", caught);
    if (caught instanceof DataError && caught.code === "invalid") {
      fieldErrors = Object.fromEntries(
        Object.entries(caught.fields)
          .filter(([key]) => FIELD_OF[key])
          .map(([key, text]) => [FIELD_OF[key], text]),
      );
    }
    // Só o que não tem campo na tela fica no aviso do alto.
    if (Object.keys(fieldErrors).length === 0) {
      error = caught instanceof DataError ? describeDataError(caught) : "Não foi possível cadastrar. Tente de novo.";
    }
  }
}
---

<AdminLayout title={`Cadastrar ${vocabulary.patient}`}>
  <a href={backHref} class="inline-flex min-h-8 items-center gap-1 text-[15px] font-semibold text-brand no-underline hover:underline">
    <Icon name="chevron-left" class="h-[18px] w-[18px]" strokeWidth={2.2} />
    {backToBooking ? "Marcar" : origin ? "Voltar" : fixedContact ? fixedContact.fullName : capitalize(vocabulary.patients)}
  </a>
  <PageHeader title={`Cadastrar ${vocabulary.patient}`} class="mt-2" />
  {error && <FormMessage tone="error">{error}</FormMessage>}

  <form method="POST" class="mt-4 flex max-w-[680px] flex-col gap-4">
    <input type="hidden" name="confirmed_contact_id" value={values.confirmed_contact_id} />
    <section aria-labelledby="bloco-paciente" class={card}>
      <h2 id="bloco-paciente" class={blockTitle}><span class={number} aria-hidden="true">1</span>{capitalize(vocabulary.patient)}</h2>
      <div class={field}>
        <label for="full_name" class={fieldLabel}>Nome do {vocabulary.patient}</label>
        <input id="full_name" name="full_name" required value={values.full_name} {...invalidAttrs("full_name")} class={`${CONTROL} ${fieldErrors.full_name ? invalidControl : ""}`} />
        {fieldErrors.full_name && (
                <p id="full_name-erro" class={fieldError}>
                  <Icon name="warning" class="mt-0.5 h-4 w-4 shrink-0" strokeWidth={2.2} />
                  {fieldErrors.full_name}
                </p>
              )}
      </div>
      <div class={field}>
        <label for="birthdate" class={fieldLabel}>Data de nascimento</label>
        <input
          id="birthdate"
          name="birthdate"
          type="date"
          required
          max={today}
          value={values.birthdate}
          {...invalidAttrs("birthdate")}
          class={`${CONTROL} w-52 ${fieldErrors.birthdate ? invalidControl : ""}`}
        />
        {fieldErrors.birthdate && (
                <p id="birthdate-erro" class={fieldError}>
                  <Icon name="warning" class="mt-0.5 h-4 w-4 shrink-0" strokeWidth={2.2} />
                  {fieldErrors.birthdate}
                </p>
              )}
      </div>
      <div class={field}>
        <label for="notes" class={fieldLabel}>Observações <span class={optional}>(opcional)</span></label>
        <textarea id="notes" name="notes" rows="2" aria-describedby="notes-hint" class={`${CONTROL} h-auto! py-2.5`}>{values.notes}</textarea>
        <p id="notes-hint" class={hint}>Só a equipe vê.</p>
      </div>
    </section>

    <section aria-labelledby="bloco-contato" class={card}>
      <h2 id="bloco-contato" class={blockTitle}><span class={number} aria-hidden="true">2</span>Quem fala com a clínica pelo WhatsApp</h2>
      {
        fixedContact ? (
          <p class="text-[15px] text-ink">
            <span class="font-semibold">{fixedContact.fullName}</span> · {formatPhoneBR(fixedContact.phone)}
          </p>
        ) : (
          <>
            <fieldset aria-describedby={fieldErrors.mode ? "mode-erro" : undefined}>
              <legend class="sr-only">Quem fala com a clínica pelo WhatsApp</legend>
              <div class="flex flex-col gap-2.5 sm:flex-row">
                <label class={choice}>
                  <input type="radio" name="mode" value="self" checked={values.mode === "self"} autofocus={firstInvalid("mode") && values.mode === "self"} class="mt-0.5 h-[18px] w-[18px] shrink-0 accent-brand" />
                  <span class="flex flex-col gap-0.5">
                    <span class="text-[15.5px] leading-snug font-semibold text-ink">O próprio {vocabulary.patient}</span>
                    <span class={hint}>Maior de 18 anos</span>
                  </span>
                </label>
                <label class={choice}>
                  <input type="radio" name="mode" value="new" checked={values.mode === "new"} autofocus={firstInvalid("mode") && values.mode === "new"} class="mt-0.5 h-[18px] w-[18px] shrink-0 accent-brand" />
                  <span class="flex flex-col gap-0.5">
                    <span class="text-[15.5px] leading-snug font-semibold text-ink">Um {vocabulary.contact}</span>
                    <span class={hint}>Outra pessoa fala por ele</span>
                  </span>
                </label>
              </div>
              <div class="mt-2">
              {fieldErrors.mode && (
                <p id="mode-erro" class={fieldError}>
                  <Icon name="warning" class="mt-0.5 h-4 w-4 shrink-0" strokeWidth={2.2} />
                  {fieldErrors.mode}
                </p>
              )}
              </div>
            </fieldset>
            <div data-contact-name class={field}>
              <label for="contact_name" class={fieldLabel}>Nome do {vocabulary.contact}</label>
              <input
                id="contact_name"
                name="contact_name"
                value={values.contact_name}
                {...invalidAttrs("contact_name")}
                class={`${CONTROL} ${fieldErrors.contact_name ? invalidControl : ""}`}
              />
              {fieldErrors.contact_name && (
                <p id="contact_name-erro" class={fieldError}>
                  <Icon name="warning" class="mt-0.5 h-4 w-4 shrink-0" strokeWidth={2.2} />
                  {fieldErrors.contact_name}
                </p>
              )}
            </div>
            <div class={field}>
              <label for="phone" class={fieldLabel}>WhatsApp</label>
              <input
                id="phone"
                name="phone"
                type="tel"
                required
                placeholder="(84) 99999-9999"
                value={values.phone}
                {...invalidAttrs("phone", samePerson ? "phone-aviso phone-hint" : "phone-hint")}
                class={`${CONTROL} w-full sm:w-64 ${fieldErrors.phone ? invalidControl : samePerson ? "border-pend-500" : ""}`}
              />
              {fieldErrors.phone && (
                <p id="phone-erro" class={fieldError}>
                  <Icon name="warning" class="mt-0.5 h-4 w-4 shrink-0" strokeWidth={2.2} />
                  {fieldErrors.phone}
                </p>
              )}
              {samePerson && notice && (
                <p id="phone-aviso" role="alert" tabindex="-1" data-form-error class={alertBox}>
                  <Icon name="warning" class="mt-0.5 h-[18px] w-[18px] shrink-0" strokeWidth={2} />
                  {notice}
                </p>
              )}
              <p id="phone-hint" class={hint}>Se o número já for de um {vocabulary.contact} cadastrado, o {vocabulary.patient} entra junto dele.</p>
            </div>
          </>
        )
      }
    </section>

    {
      insuranceOn && (
        <section aria-labelledby="bloco-plano" class={card}>
          <h2 id="bloco-plano" class={blockTitle}><span class={number} aria-hidden="true">3</span>Plano de saúde</h2>
          <div class={field}>
            <label for="plan_id" class={fieldLabel}>Plano</label>
            <select id="plan_id" name="plan_id" class={`${CONTROL} w-full sm:w-80`}>
              <option value="">Particular</option>
              {plans.map((plan) => (
                <option value={plan.id} selected={plan.id === values.plan_id}>
                  {plan.name}
                </option>
              ))}
            </select>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div class={field}>
              <label for="card_number" class={fieldLabel}>Carteirinha <span class={optional}>(opcional)</span></label>
              <input id="card_number" name="card_number" value={values.card_number} class={CONTROL} />
            </div>
            <div class={field}>
              <label for="card_valid_until" class={fieldLabel}>Validade <span class={optional}>(opcional)</span></label>
              <input
                id="card_valid_until"
                name="card_valid_until"
                type="date"
                value={values.card_valid_until}
                {...invalidAttrs("card_valid_until")}
                class={`${CONTROL} ${fieldErrors.card_valid_until ? invalidControl : ""}`}
              />
              {fieldErrors.card_valid_until && (
                <p id="card_valid_until-erro" class={fieldError}>
                  <Icon name="warning" class="mt-0.5 h-4 w-4 shrink-0" strokeWidth={2.2} />
                  {fieldErrors.card_valid_until}
                </p>
              )}
            </div>
          </div>
        </section>
      )
    }

    {
      askDuplicate && notice && (
        <div class="flex flex-col gap-2.5">
          <p role="alert" tabindex="-1" data-form-error class={alertBox}>
            <Icon name="warning" class="mt-0.5 h-[18px] w-[18px] shrink-0" strokeWidth={2} />
            {notice}
          </p>
          <label class="flex min-h-11 items-center gap-2.5 text-[15px] text-ink">
            <input type="checkbox" name="confirm_duplicate" class="h-[18px] w-[18px] accent-brand" /> Confirmo que é outra pessoa
          </label>
        </div>
      )
    }
    <div>
      <Button type="submit" variant="primary" class="h-12 px-[22px] text-base sm:h-12" data-sending-label="Cadastrando…">
        {notice ? "Confirmar e cadastrar" : `Cadastrar ${vocabulary.patient}`}
      </Button>
    </div>
  </form>

  <script>
    // Nome do responsável só quando não é o próprio paciente.
    const box = document.querySelector<HTMLElement>("[data-contact-name]");
    const sync = () => {
      const mode = document.querySelector<HTMLInputElement>("input[name='mode']:checked")?.value;
      if (!box) return;
      box.hidden = mode === "self";
      const input = box.querySelector("input");
      if (input) input.required = mode !== "self";
    };
    document.querySelectorAll("input[name='mode']").forEach((input) => input.addEventListener("change", sync));
    sync();
  </script>
</AdminLayout>

---
// Pacientes (F4.7): abas Pacientes e Responsáveis/Contatos (pelo
// vocabulário da clínica), busca pelo nome ou pelo telefone (4+ dígitos), 20
// por página e "Mostrar desativados", como no piloto. Toda a equipe vê todos
// os pacientes (D6, revisão de 04/out).
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Badge from "../../../components/admin/Badge.astro";
import Card from "../../../components/admin/Card.astro";
import FlashMessage from "../../../components/admin/FlashMessage.astro";
import TabBar from "../../../components/admin/TabBar.astro";
import { INPUT, PRIMARY_BUTTON, SECONDARY_BUTTON } from "../../../components/admin/fieldStyles";
import { formatAge } from "../../../lib/age";
import { todayIn } from "../../../lib/clinicTime";
import { createUserClient } from "../../../lib/data/clients";
import { listNoShowStats } from "../../../lib/data/agenda/view";
import { listInsurancePlans } from "../../../lib/data/config/insurance";
import { listContactsPage, listPatientsPage } from "../../../lib/data/patients";
import { formatPhoneBR } from "../../../lib/phone";
import { capitalize, vocabularyFor } from "../../../lib/vocabulary";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const vocabulary = vocabularyFor(clinic.clinicProfile);
const params = Astro.url.searchParams;
const tab = params.get("tab") === "contatos" ? "contatos" : "pacientes";
const q = (params.get("q") ?? "").trim();
const showInactive = params.get("todos") === "1";
const page = Number(params.get("pagina")) || 1;
const today = todayIn(clinic.timezone);
const insuranceOn = clinic.features.includes("insurance");

const patients = tab === "pacientes" ? await listPatientsPage(db, clinic.clinicId, { query: q, includeInactive: showInactive, page }) : null;
const contacts = tab === "contatos" ? await listContactsPage(db, clinic.clinicId, { query: q, includeInactive: showInactive, page }) : null;
const [plans, noShows] = await Promise.all([
  insuranceOn && patients ? listInsurancePlans(db, clinic.clinicId, { includeInactive: true }) : Promise.resolve([]),
  patients ? listNoShowStats(db, clinic.clinicId, patients.items.map((p) => p.id)) : Promise.resolve(new Map()),
]);
const planName = new Map(plans.map((p) => [p.id, p.name]));
const result = patients ?? contacts!;

const link = (changes: Record<string, string>) => {
  const next = new URLSearchParams({ ...(tab === "contatos" ? { tab } : {}), ...(q ? { q } : {}), ...(showInactive ? { todos: "1" } : {}), ...changes });
  for (const [key, value] of [...next]) if (!value) next.delete(key);
  return `/admin/pacientes?${next}`;
};
---

<AdminLayout title={capitalize(vocabulary.patients)}>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold text-slate-900">{capitalize(vocabulary.patients)}</h1>
    <a href="/admin/pacientes/novo" class={PRIMARY_BUTTON}>Cadastrar {vocabulary.patient}</a>
  </div>
  <TabBar
    label="Listas"
    class="mt-4"
    tabs={[
      { label: capitalize(vocabulary.patients), href: "/admin/pacientes", active: tab === "pacientes" },
      { label: capitalize(vocabulary.contacts), href: "/admin/pacientes?tab=contatos", active: tab === "contatos" },
    ]}
  />
  <FlashMessage />

  <form method="GET" class="mt-4 flex flex-wrap items-center gap-2">
    {tab === "contatos" && <input type="hidden" name="tab" value="contatos" />}
    {showInactive && <input type="hidden" name="todos" value="1" />}
    <input name="q" value={q} placeholder="Nome ou telefone" class={`${INPUT} mt-0 sm:w-80`} />
    <button type="submit" class={SECONDARY_BUTTON}>Buscar</button>
    {q && <a href={link({ q: "" })} class="text-sm text-sky-700 hover:underline">Limpar</a>}
    <a href={link({ todos: showInactive ? "" : "1" })} class="ml-auto text-sm text-sky-700 hover:underline">
      {showInactive ? "Esconder desativados" : "Mostrar desativados"}
    </a>
  </form>

  <p class="mt-3 text-sm text-slate-500">{result.total} {result.total === 1 ? "encontrado" : "encontrados"}</p>
  <ul class="mt-2 grid gap-3 sm:grid-cols-2">
    {
      patients?.items.map((p) => {
        const stats = noShows.get(p.id);
        return (
          <li>
            <a href={`/admin/pacientes/${p.id}`}>
              <Card class="h-full hover:border-sky-300 hover:bg-sky-50" muted={!p.isActive}>
                <p class="flex flex-wrap items-center gap-2 font-medium text-slate-900">
                  {p.fullName}
                  {!p.isActive && <Badge>desativado</Badge>}
                  {stats && <Badge variant="danger">Faltou {stats.noShows} de {stats.total}</Badge>}
                </p>
                <p class="mt-0.5 text-sm text-slate-600">
                  {formatAge(p.birthdate, today)}
                  {insuranceOn && ` · ${p.insurance ? (planName.get(p.insurance.planId) ?? "Plano") : "Particular"}`}
                </p>
                <p class="text-sm text-slate-500">
                  {!p.isContactSelf && `${capitalize(vocabulary.contact)}: ${p.contact.fullName} · `}
                  {formatPhoneBR(p.contact.phone)}
                </p>
              </Card>
            </a>
          </li>
        );
      })
    }
    {
      contacts?.items.map((c) => (
        <li>
          <a href={`/admin/pacientes/contato/${c.id}`}>
            <Card class="h-full hover:border-sky-300 hover:bg-sky-50" muted={!c.isActive}>
              <p class="flex flex-wrap items-center gap-2 font-medium text-slate-900">
                {c.fullName} {!c.isActive && <Badge>desativado</Badge>}
              </p>
              <p class="mt-0.5 text-sm text-slate-600">{formatPhoneBR(c.phone)}</p>
              <p class="text-sm text-slate-500">{c.patientNames.length ? c.patientNames.join(", ") : `Sem ${vocabulary.patients} ativos`}</p>
            </Card>
          </a>
        </li>
      ))
    }
  </ul>
  {result.total === 0 && <p class="mt-2 text-sm text-slate-600">{q ? "Ninguém encontrado." : "Ninguém cadastrado ainda."}</p>}

  {
    result.pageCount > 1 && (
      <nav class="mt-4 flex items-center gap-3 text-sm">
        {result.page > 1 && (
          <a href={link({ pagina: String(result.page - 1) })} class="text-sky-700 hover:underline">
            Anterior
          </a>
        )}
        <span class="text-slate-500">
          Página {result.page} de {result.pageCount}
        </span>
        {result.page < result.pageCount && (
          <a href={link({ pagina: String(result.page + 1) })} class="text-sky-700 hover:underline">
            Próxima
          </a>
        )}
      </nav>
    )
  }
</AdminLayout>

---
// Pacientes › paciente (F4.7): dados (nome, nascimento, observações), quem
// fala com a clínica, plano de saúde (com o item "Convênios", D10), marcar,
// desativar/reativar e o histórico (próximos e anteriores) das agendas que a
// pessoa vê. Anonimizar a pedido (F9.4, LGPD): só o Administrador e o
// Suporte; depois disso a página só mostra o histórico. Com o Módulo
// financeiro (F11.1), o cartão "Financeiro": CPF e responsável financeiro (só o
// Administrador e a Recepção; o Suporte só vê).
import AdminLayout from "../../../layouts/AdminLayout.astro";
import ActiveToggle from "../../../components/admin/ActiveToggle.astro";
import Badge, { type BadgeVariant } from "../../../components/admin/Badge.astro";
import Card from "../../../components/admin/Card.astro";
import ConfirmDeleteDialog from "../../../components/admin/ConfirmDeleteDialog.astro";
import FlashMessage from "../../../components/admin/FlashMessage.astro";
import Icon from "../../../components/admin/Icon.astro";
import PhoneLinks from "../../../components/admin/PhoneLinks.astro";
import { HINT, INPUT, LABEL, PRIMARY_BUTTON, SECONDARY_BUTTON } from "../../../components/admin/fieldStyles";
import { formatAge, isOverConsultationAgeLimit } from "../../../lib/age";
import { canAccessArea, isUuid } from "../../../lib/clinicAccess";
import { formatCpf } from "../../../lib/cpf";
import { getContactCpf, getPatientFinance, resolvePayer } from "../../../lib/data/finance";
import { currentPath, receivedReturn, withReturn } from "../../../lib/returnPath";
import { formatInstant, localDateOf, todayIn } from "../../../lib/clinicTime";
import { createUserClient } from "../../../lib/data/clients";
import { listNoShowStats, listPatientAppointments } from "../../../lib/data/agenda/view";
import { getClinicSettings } from "../../../lib/data/config/clinic";
import { listInsurancePlans } from "../../../lib/data/config/insurance";
import { getContact, getPatient, previewAnonymization } from "../../../lib/data/patients";
import { capitalize, vocabularyFor } from "../../../lib/vocabulary";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const vocabulary = vocabularyFor(clinic.clinicProfile);
const id = Astro.params.id!;
const patient = isUuid(id) ? await getPatient(db, clinic.clinicId, id).catch(() => null) : null;
if (!patient) return Astro.redirect("/admin/pacientes");
const insuranceOn = clinic.features.includes("insurance");
const [contact, history, noShows, plans, settings] = await Promise.all([
  getContact(db, clinic.clinicId, patient.contactId),
  listPatientAppointments(db, clinic.clinicId, patient.id),
  listNoShowStats(db, clinic.clinicId, [patient.id]),
  insuranceOn ? listInsurancePlans(db, clinic.clinicId, { includeInactive: true }) : Promise.resolve([]),
  getClinicSettings(db, clinic.clinicId),
]);
const now = new Date();
const today = todayIn(clinic.timezone);
const upcoming = history.filter((a) => (a.status === "scheduled" || a.status === "confirmed") && a.scheduledAt > now).reverse();
const previous = history.filter((a) => !upcoming.includes(a));
const stats = noShows.get(patient.id);
const statusBadge: Record<string, { label: string; variant: BadgeVariant }> = {
  scheduled: { label: "Marcado", variant: "info" },
  confirmed: { label: "Marcado", variant: "info" },
  canceled: { label: "Cancelado", variant: "danger" },
  completed: { label: "Compareceu", variant: "success" },
  no_show: { label: "Faltou", variant: "danger" },
};
const pending = (a: (typeof history)[number]) => (a.status === "scheduled" || a.status === "confirmed") && a.scheduledAt <= now;
// Voltar: para a tela de onde veio (cliente, 10/out/2026); sem origem, Pacientes.
const volta = receivedReturn(Astro.url);
const here = currentPath(Astro.url);
const action = withReturn(`/api/admin/pacientes/${patient.id}`, volta);
const anonymized = patient.anonymizedAt !== null;
const canAnonymize = !anonymized && (clinic.isPlatformStaff || clinic.roles.includes("admin"));
const preview = canAnonymize ? await previewAnonymization(db, clinic.clinicId, patient.id, now) : null;
const anonymizeMessage = preview
  ? [
      `Nome, nascimento, observações e carteirinha de ${patient.fullName} serão apagados, e o ${vocabulary.contact} (${contact.fullName}) perde nome, telefone, endereço e as mensagens do WhatsApp. O histórico de atendimentos fica, sem identificação.`,
      preview.futureAppointments > 0
        ? `${preview.futureAppointments} ${preview.futureAppointments === 1 ? "atendimento futuro será cancelado" : "atendimentos futuros serão cancelados"}, sem aviso ao paciente.`
        : "",
      preview.otherPatients.length > 0
        ? `Também ficam sem telefone: ${preview.otherPatients.map((p) => p.fullName).join(", ")} (cadastre um telefone novo no ${vocabulary.contact} depois).`
        : "",
      "Não dá para desfazer.",
    ]
      .filter(Boolean)
      .join(" ")
  : "";
// Módulo financeiro (F11.1): o Suporte vê, mas só a equipe da clínica grava.
const financeOn = canAccessArea(clinic, "finance") && !anonymized;
const canEditFinance = financeOn && (clinic.roles.includes("admin") || clinic.roles.includes("reception"));
const [finance, contactCpf] = financeOn
  ? await Promise.all([getPatientFinance(db, clinic.clinicId, patient.id), getContactCpf(db, clinic.clinicId, contact.id)])
  : [null, null];
const responsible = finance ? resolvePayer(patient, contact, finance, contactCpf) : null;
const financeAction = withReturn(`/api/admin/financeiro/paciente/${patient.id}`, volta);
const cpfValue = (cpf: string | null) => (cpf ? formatCpf(cpf) : "");
const ageWarning =
  settings.consultationAgeLimitYears !== null && isOverConsultationAgeLimit(patient.birthdate, today, settings.consultationAgeLimitYears)
    ? `Passou da idade limite da Consulta (${settings.consultationAgeLimitYears} anos): só Retorno e Exame.`
    : null;
---

<AdminLayout title={patient.fullName}>
  <a href={volta ?? "/admin/pacientes"} class="inline-flex items-center gap-1 text-sm font-medium text-sky-700 hover:underline">
    <Icon name="chevron-left" class="h-4 w-4" />
    {volta ? "Voltar" : capitalize(vocabulary.patients)}
  </a>
  <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
    <h1 class="flex flex-wrap items-center gap-2 text-2xl font-bold text-slate-900">
      {patient.fullName}
      {anonymized ? <Badge variant="warning">anonimizado</Badge> : !patient.isActive && <Badge>desativado</Badge>}
      {stats && <Badge variant="danger">Faltou {stats.noShows} de {stats.total}</Badge>}
      {contact.botBlockedAt && <Badge variant="danger">{vocabulary.contact} bloqueado</Badge>}
    </h1>
    {patient.isActive && !anonymized && <a href={withReturn(`/admin/agenda/marcar?patient_id=${patient.id}`, here)} class={PRIMARY_BUTTON}>Marcar</a>}
  </div>
  <FlashMessage />

  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    <div class="flex flex-col gap-4">
      {anonymized && (
        <Card>
          <h2 class="font-semibold text-slate-900">Anonimizado</h2>
          <p class="mt-1 text-sm text-slate-600">
            Em {formatInstant(patient.anonymizedAt!, clinic.timezone, "dd/MM/yyyy 'às' HH:mm")}, a pedido (LGPD). Nome, nascimento, observações, telefone e
            mensagens foram apagados; o histórico de atendimentos fica, sem identificação.
          </p>
        </Card>
      )}
      {!anonymized && (
      <Card>
        <h2 class="font-semibold text-slate-900">Dados</h2>
        <p class="mt-1 text-sm text-slate-600">{formatAge(patient.birthdate, today)}</p>
        {ageWarning && <p class="mt-1 text-sm text-amber-700">{ageWarning}</p>}
        <form method="POST" action={action} class="mt-3 flex flex-col gap-3">
          <input type="hidden" name="acao" value="salvar" />
          <div>
            <label for="full_name" class={LABEL}>Nome</label>
            <input id="full_name" name="full_name" required value={patient.fullName} class={INPUT} />
          </div>
          <div>
            <label for="birthdate" class={LABEL}>Data de nascimento</label>
            <input id="birthdate" name="birthdate" type="date" required max={today} value={patient.birthdate} class={`${INPUT} w-48`} />
          </div>
          <div>
            <label for="notes" class={LABEL}>Observações</label>
            <textarea id="notes" name="notes" rows="3" class={INPUT}>{patient.notes ?? ""}</textarea>
            <p class={HINT}>Só a equipe vê.</p>
          </div>
          <button type="submit" class={`${SECONDARY_BUTTON} self-start`}>Salvar</button>
        </form>
      </Card>
      )}

      <Card>
        <h2 class="font-semibold text-slate-900">{patient.isContactSelf ? "WhatsApp" : capitalize(vocabulary.contact)}</h2>
        <p class="mt-1 text-sm text-slate-700">
          {!patient.isContactSelf && <a href={withReturn(`/admin/pacientes/contato/${contact.id}`, here)} class="font-medium text-sky-700 hover:underline">{contact.fullName}</a>}
          {!patient.isContactSelf && " · "}
          <PhoneLinks phone={contact.phone} plain class="text-slate-700" />
        </p>
        {patient.isContactSelf && <a href={withReturn(`/admin/pacientes/contato/${contact.id}`, here)} class="mt-1 inline-block text-sm text-sky-700 hover:underline">Editar o telefone</a>}
      </Card>

      {
        finance && responsible && (
          <Card>
            <h2 class="font-semibold text-slate-900">Financeiro</h2>
            <p class="mt-1 text-sm text-slate-700">
              Responsável financeiro: <span class="font-medium">{responsible.name}</span>
              {responsible.cpf ? ` · CPF ${formatCpf(responsible.cpf)}` : ""}
            </p>
            {!responsible.cpf && <p class="mt-1 text-sm text-amber-700">Falta o CPF do responsável financeiro: sem ele, a nota fiscal não sai.</p>}
            <form method="POST" action={financeAction} class="mt-3 flex flex-col gap-3" id="financeiro">
              <fieldset disabled={!canEditFinance} class="flex flex-col gap-3">
                <div>
                  <label for="fin_cpf" class={LABEL}>CPF de {patient.fullName}{patient.isContactSelf ? "" : " (opcional)"}</label>
                  <input
                    id="fin_cpf"
                    name={patient.isContactSelf ? "contact_cpf" : "cpf"}
                    inputmode="numeric"
                    placeholder="000.000.000-00"
                    value={cpfValue(patient.isContactSelf ? contactCpf : finance.cpf)}
                    class={`${INPUT} w-48`}
                  />
                </div>
                <div>
                  <p class={LABEL}>Quem paga (a nota sai no CPF dele)</p>
                  <div class="mt-1 flex flex-col gap-1 text-sm">
                    <label class="flex items-center gap-2">
                      <input type="radio" name="payer" value="contact" checked={responsible.payer === "contact"} class="h-4 w-4" />
                      {patient.isContactSelf ? patient.fullName : `${contact.fullName} (${vocabulary.contact})`}
                    </label>
                    {!patient.isContactSelf && (
                      <label class="flex items-center gap-2">
                        <input type="radio" name="payer" value="patient" checked={responsible.payer === "patient"} class="h-4 w-4" />
                        {patient.fullName}
                      </label>
                    )}
                    <label class="flex items-center gap-2">
                      <input type="radio" name="payer" value="other" checked={responsible.payer === "other"} class="h-4 w-4" />
                      Outra pessoa
                    </label>
                  </div>
                </div>
                {!patient.isContactSelf && (
                  <div data-payer-only="contact">
                    <label for="fin_contact_cpf" class={LABEL}>CPF de {contact.fullName}</label>
                    <input id="fin_contact_cpf" name="contact_cpf" inputmode="numeric" placeholder="000.000.000-00" value={cpfValue(contactCpf)} class={`${INPUT} w-48`} />
                    <p class={HINT}>Vale também para os outros cadastros deste WhatsApp.</p>
                  </div>
                )}
                <div data-payer-only="other" class="grid gap-3 sm:grid-cols-2">
                  <div>
                    <label for="fin_payer_name" class={LABEL}>Nome de quem paga</label>
                    <input id="fin_payer_name" name="payer_name" value={finance.payerName ?? ""} class={INPUT} />
                  </div>
                  <div>
                    <label for="fin_payer_cpf" class={LABEL}>CPF de quem paga</label>
                    <input id="fin_payer_cpf" name="payer_cpf" inputmode="numeric" placeholder="000.000.000-00" value={cpfValue(finance.payerCpf)} class={INPUT} />
                  </div>
                </div>
                {canEditFinance && <button type="submit" class={`${SECONDARY_BUTTON} self-start`}>Salvar dados financeiros</button>}
              </fieldset>
            </form>
            <p class={HINT}>Só a Recepção e o Administrador veem estes dados; o bot e as páginas públicas não.</p>
          </Card>
        )
      }

      {
        insuranceOn && !anonymized && (
          <Card>
            <h2 class="font-semibold text-slate-900">Plano de saúde</h2>
            <form method="POST" action={action} class="mt-2 flex flex-col gap-3">
              <input type="hidden" name="acao" value="plano" />
              <select name="plan_id" class={`${INPUT} mt-0`}>
                <option value="">Particular</option>
                {plans
                  .filter((plan) => plan.isActive || plan.id === patient.insurance?.planId)
                  .map((plan) => (
                    <option value={plan.id} selected={plan.id === patient.insurance?.planId}>
                      {plan.name}
                      {!plan.isActive && " (desativado)"}
                    </option>
                  ))}
              </select>
              <div class="grid gap-3 sm:grid-cols-2">
                <div>
                  <label for="card_number" class={LABEL}>Carteirinha</label>
                  <input id="card_number" name="card_number" value={patient.insurance?.cardNumber ?? ""} class={INPUT} />
                </div>
                <div>
                  <label for="card_valid_until" class={LABEL}>Validade</label>
                  <input id="card_valid_until" name="card_valid_until" type="date" value={patient.insurance?.cardValidUntil ?? ""} class={INPUT} />
                </div>
              </div>
              <button type="submit" class={`${SECONDARY_BUTTON} self-start`}>Salvar plano</button>
            </form>
          </Card>
        )
      }

      {!anonymized && (
        <Card>
          <ActiveToggle action={action} isActive={patient.isActive} what={`o ${vocabulary.patient}`} />
        </Card>
      )}

      {
        canAnonymize && (
          <Card>
            <h2 class="font-semibold text-slate-900">Anonimizar (LGPD)</h2>
            <p class="mt-1 text-sm text-slate-600">
              Quando o {vocabulary.patient} pede a exclusão dos dados. O histórico fica sem identificação; o {vocabulary.contact}, o telefone e as mensagens
              são apagados junto. Não dá para desfazer.
            </p>
            <form method="POST" action={action} class="mt-3">
              <input type="hidden" name="acao" value="anonimizar" />
              <button
                type="submit"
                class={`${SECONDARY_BUTTON} js-confirm-delete text-red-700`}
                data-confirm-title={`Anonimizar ${patient.fullName}?`}
                data-confirm-message={anonymizeMessage}
                data-confirm-label="Anonimizar"
              >
                Anonimizar {vocabulary.patient}
              </button>
            </form>
          </Card>
        )
      }
    </div>

    <div class="flex flex-col gap-4">
      {
        [
          { title: "Próximos", rows: upcoming },
          { title: "Anteriores e cancelados", rows: previous },
        ].map((section) => (
          <Card>
            <h2 class="font-semibold text-slate-900">
              {section.title} ({section.rows.length})
            </h2>
            <ul class="mt-2 divide-y divide-slate-100">
              {section.rows.map((a) => (
                <li class="flex flex-wrap items-center justify-between gap-2 py-2 text-sm">
                  <a href={`/admin/agenda?date=${localDateOf(a.scheduledAt, clinic.timezone)}`} class="hover:text-sky-700">
                    <span class="font-medium capitalize text-slate-900">{formatInstant(a.scheduledAt, clinic.timezone, "EEE dd/MM/yyyy 'às' HH:mm")}</span>
                    <span class="block text-slate-500">
                      {a.serviceName} · {a.agendaName}
                      {a.seriesId ? " · série" : ""}
                    </span>
                  </a>
                  <span class="flex items-center gap-2">
                    {pending(a) ? <Badge variant="warning">Registrar comparecimento</Badge> : <Badge variant={statusBadge[a.status].variant}>{statusBadge[a.status].label}</Badge>}
                    <a href={withReturn(`/admin/agenda/trilha/${a.id}`, here)} class="text-xs font-medium text-sky-700 hover:underline">
                      Trilha
                    </a>
                  </span>
                </li>
              ))}
              {section.rows.length === 0 && <li class="py-2 text-sm text-slate-500">Nenhum.</li>}
            </ul>
          </Card>
        ))
      }
    </div>
  </div>
  {canAnonymize && <ConfirmDeleteDialog />}
</AdminLayout>

<script>
  // Financeiro: mostra só os campos do responsável escolhido.
  const form = document.getElementById("financeiro");
  if (form) {
    const sync = () => {
      const payer = form.querySelector<HTMLInputElement>('input[name="payer"]:checked')?.value ?? "contact";
      form.querySelectorAll<HTMLElement>("[data-payer-only]").forEach((block) => {
        block.hidden = block.dataset.payerOnly !== payer;
      });
    };
    form.addEventListener("change", sync);
    sync();
  }
</script>

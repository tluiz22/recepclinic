---
// Pacientes › paciente (F4.7): dados (nome, nascimento, observações), quem
// fala com a clínica, plano de saúde (com o item "Convênios", D10), marcar,
// desativar/reativar e o histórico (próximos e anteriores) das agendas que a
// pessoa vê. Anonimizar a pedido (F9.4, LGPD): só o Administrador e o
// Suporte; depois disso a página só mostra o histórico. Com o Módulo
// financeiro (F11.1), o cartão "Financeiro": CPF e responsável financeiro (só o
// Administrador e a Recepção; o Suporte só vê).
//
// Redesign R6 (proposta aprovada pelo cliente em 16/out/2026): no alto, o
// paciente com os selos, o contato e as ações (Marcar e o "Mais" com
// Desativar e Anonimizar); à esquerda, os atendimentos em abas, só informação,
// com "Abrir na Agenda" e "Trilha"; à direita, os cartões em modo leitura com
// "Editar". Quem vê o Financeiro vê também "Pago"/"Pago em parte" nos
// atendimentos e a nota de cada pagamento. No celular, os cartões recolhidos e
// "Marcar" na barra fixa.
//
// CRM P2 (28/out/2026): aba "Anotações" no lugar das Observações (Q20, Q21):
// lista datada com o autor; Administrador, Recepção e Profissional escrevem;
// só o autor edita; só o Administrador apaga.
//
// CRM P1 (28/out/2026): aba "Documentos" ao lado dos atendimentos (cliente:
// lista longa não cabe na coluna da direita), com filtro por tipo. Foto ou PDF
// da carteirinha, identidade, pedidos: a equipe toda vê, abre e baixa;
// Administrador e Recepção anexam e apagam (Q19); "Baixar selecionados" e, no
// celular, "Compartilhar" (Q24). O arquivo vai do aparelho direto ao armazenamento.
import AdminLayout from "../../../layouts/AdminLayout.astro";
import ConfirmDeleteDialog from "../../../components/admin/ConfirmDeleteDialog.astro";
import FlashMessage from "../../../components/admin/FlashMessage.astro";
import Icon from "../../../components/admin/Icon.astro";
import PhoneLinks from "../../../components/admin/PhoneLinks.astro";
import { appointmentSituation } from "../../../components/admin/agenda/situationStyle";
import Button from "../../../components/admin/ui/Button.astro";
import EditCard from "../../../components/admin/ui/EditCard.astro";
import MoreMenu from "../../../components/admin/ui/MoreMenu.astro";
import Pill, { type PillTone } from "../../../components/admin/ui/Pill.astro";
import StatusPill from "../../../components/admin/ui/StatusPill.astro";
import Tabs from "../../../components/admin/ui/Tabs.astro";
import Tag from "../../../components/admin/ui/Tag.astro";
import { buttonClass, CONTROL, menuItemClass } from "../../../components/admin/ui/styles";
import { formatAge, isOverConsultationAgeLimit } from "../../../lib/age";
import { canAccessArea, isUuid } from "../../../lib/clinicAccess";
import { formatCpf } from "../../../lib/cpf";
import { getContactCpf, getPatientFinance, resolvePayer } from "../../../lib/data/finance";
import { listPatientPayments, listPaymentStates, PAYMENT_METHOD_LABEL } from "../../../lib/data/payments";
import { ACTIVE_INVOICE, listPaymentInvoices, type InvoiceStatus } from "../../../lib/data/nfse";
import { getSavedDestinations } from "../../../lib/data/nfseDelivery";
import { formatPhoneBR } from "../../../lib/phone";
import { formatCentsBRL } from "../../../lib/money";
import { currentPath, receivedReturn, withReturn } from "../../../lib/returnPath";
import { formatCalendarDate, formatInstant, localDateOf, todayIn } from "../../../lib/clinicTime";
import { createUserClient } from "../../../lib/data/clients";
import { listNoShowStats, listPatientAppointments } from "../../../lib/data/agenda/view";
import { getClinicSettings } from "../../../lib/data/config/clinic";
import { listInsurancePlans } from "../../../lib/data/config/insurance";
import { getContact, getPatient, previewAnonymization } from "../../../lib/data/patients";
import { actorText, loadActorLabels } from "../../../lib/data/agenda/trail";
import { listPatientNotes, NOTE_MAX } from "../../../lib/data/patientNotes";
import { DESCRIPTION_MAX, DOCUMENT_KIND_LABEL, DOCUMENT_KINDS, DOCUMENT_MIME_TYPES, listPatientDocuments } from "../../../lib/data/patientDocuments";
import { platformEnv } from "../../../lib/env";
import { capitalize, vocabularyFor } from "../../../lib/vocabulary";

const clinic = Astro.locals.clinic!;
const db = createUserClient(Astro.request, Astro.cookies);
const vocabulary = vocabularyFor(clinic.clinicProfile);
const id = Astro.params.id!;
const patient = isUuid(id) ? await getPatient(db, clinic.clinicId, id).catch(() => null) : null;
if (!patient) return Astro.redirect("/admin/pacientes");
const insuranceOn = clinic.features.includes("insurance");
const [contact, history, noShows, plans, settings] = await Promise.all([
  getContact(db, clinic.clinicId, patient.contactId),
  listPatientAppointments(db, clinic.clinicId, patient.id),
  listNoShowStats(db, clinic.clinicId, [patient.id]),
  insuranceOn ? listInsurancePlans(db, clinic.clinicId, { includeInactive: true }) : Promise.resolve([]),
  getClinicSettings(db, clinic.clinicId),
]);
const now = new Date();
const today = todayIn(clinic.timezone);
const upcoming = history.filter((a) => (a.status === "scheduled" || a.status === "confirmed") && a.scheduledAt > now).reverse();
const previous = history.filter((a) => !upcoming.includes(a));
const stats = noShows.get(patient.id);
const pending = (a: (typeof history)[number]) => (a.status === "scheduled" || a.status === "confirmed") && a.scheduledAt <= now;
// Voltar: para a tela de onde veio (cliente, 10/out/2026); sem origem, Pacientes.
const volta = receivedReturn(Astro.url);
const here = currentPath(Astro.url);
const action = withReturn(`/api/admin/pacientes/${patient.id}`, volta);
const anonymized = patient.anonymizedAt !== null;
const canAnonymize = !anonymized && (clinic.isPlatformStaff || clinic.roles.includes("admin"));
const preview = canAnonymize ? await previewAnonymization(db, clinic.clinicId, patient.id, now) : null;
const anonymizeMessage = preview
  ? [
      `Só a pedido do ${vocabulary.patient} (LGPD). Nome, nascimento, anotações, documentos e carteirinha de ${patient.fullName} serão apagados, e o ${vocabulary.contact} (${contact.fullName}) perde nome, telefone, endereço e as mensagens do WhatsApp. O histórico de atendimentos fica, sem identificação.`,
      preview.futureAppointments > 0
        ? `${preview.futureAppointments} ${preview.futureAppointments === 1 ? "atendimento futuro será cancelado" : "atendimentos futuros serão cancelados"}, sem aviso ao paciente.`
        : "",
      preview.otherPatients.length > 0
        ? `Também ficam sem telefone: ${preview.otherPatients.map((p) => p.fullName).join(", ")} (cadastre um telefone novo no ${vocabulary.contact} depois).`
        : "",
      // Os pagamentos ficam pelo prazo fiscal (F11.2); ajuda contextual, 23/out/2026.
      canAccessArea(clinic, "finance") ? "Os pagamentos continuam guardados, pelo prazo fiscal." : "",
      "Não dá para desfazer.",
    ]
      .filter(Boolean)
      .join(" ")
  : "";
// Módulo financeiro (F11.1): o Suporte vê, mas só a equipe da clínica grava.
// Os pagamentos (F11.2) ficam visíveis também depois da anonimização (prazo fiscal).
const paymentsOn = canAccessArea(clinic, "finance");
const financeOn = paymentsOn && !anonymized;
const canEditFinance = financeOn && (clinic.roles.includes("admin") || clinic.roles.includes("reception"));
const [finance, contactCpf] = financeOn
  ? await Promise.all([getPatientFinance(db, clinic.clinicId, patient.id), getContactCpf(db, clinic.clinicId, contact.id)])
  : [null, null];
const responsible = finance ? resolvePayer(patient, contact, finance, contactCpf) : null;
const payments = paymentsOn ? await listPatientPayments(db, clinic.clinicId, patient.id) : [];
// Selos da R6 (cliente, 16/out/2026): pago em cada atendimento e a nota de cada pagamento.
const [paymentStates, invoices] = paymentsOn
  ? await Promise.all([
      listPaymentStates(db, clinic.clinicId, history.map((a) => a.id)),
      listPaymentInvoices(db, clinic.clinicId, payments.map((p) => p.id)),
    ])
  : [null, null];
// Envio das notas (F11.5): outro WhatsApp e e-mail guardados no Financeiro.
const savedDelivery = financeOn ? await getSavedDestinations(db, clinic.clinicId, patient.id) : null;
const financeAction = withReturn(`/api/admin/financeiro/paciente/${patient.id}`, volta);
const cpfValue = (cpf: string | null) => (cpf ? formatCpf(cpf) : "");
const ageWarning =
  !anonymized && settings.consultationAgeLimitYears !== null && isOverConsultationAgeLimit(patient.birthdate, today, settings.consultationAgeLimitYears)
    ? `Passou da idade limite da Consulta (${settings.consultationAgeLimitYears} anos): só Retorno e Exame.`
    : null;
// Documentos (CRM P1).
const documents = anonymized ? [] : await listPatientDocuments(db, clinic.clinicId, patient.id);
const canAttach = !anonymized && (clinic.isPlatformStaff || clinic.roles.includes("admin") || clinic.roles.includes("reception"));
// Anotações (CRM P2).
const notes = anonymized ? [] : await listPatientNotes(db, clinic.clinicId, patient.id);
const canWriteNotes = !anonymized && (clinic.isPlatformStaff || clinic.roles.some((r) => r === "admin" || r === "reception" || r === "professional"));
const canDeleteNotes = !anonymized && (clinic.isPlatformStaff || clinic.roles.includes("admin"));
const notesApi = `/api/admin/pacientes/${patient.id}/anotacoes`;
const documentActors = await loadActorLabels(db, clinic.clinicId, [...documents.map((d) => d.createdBy), ...notes.map((n) => n.createdBy)]);
const documentsApi = `/api/admin/pacientes/${patient.id}/documentos`;
// O envio e o "Compartilhar" falam direto com o armazenamento do Supabase (fora do 'self' da CSP).
if ((canAttach || documents.length > 0) && Astro.csp) Astro.csp.insertDirective(`connect-src 'self' ${new URL(platformEnv().supabaseUrl).origin}`);
const fileSize = (bytes: number) => (bytes >= 1024 * 1024 ? `${(bytes / (1024 * 1024)).toFixed(1).replace(".", ",")} MB` : `${Math.max(1, Math.round(bytes / 1024))} KB`);
const fileType = (mime: string) => (mime === "application/pdf" ? "PDF" : "Foto");
const planName = (planId: string) => plans.find((plan) => plan.id === planId)?.name ?? "Plano";
const planLabel = patient.insurance ? planName(patient.insurance.planId) : "Particular";

// Abas dos atendimentos: links que mantêm a origem do "Voltar".
const tab =
  !anonymized && Astro.url.searchParams.get("aba") === "documentos"
    ? "documentos"
    : !anonymized && Astro.url.searchParams.get("aba") === "anotacoes"
      ? "anotacoes"
      : Astro.url.searchParams.get("atendimentos") === "anteriores"
      ? "anteriores"
      : "proximos";
const tabQuery: Record<string, string> = { proximos: "", anteriores: "?atendimentos=anteriores", documentos: "?aba=documentos", anotacoes: "?aba=anotacoes" };
const isAppointments = tab === "proximos" || tab === "anteriores";
const tabHref = (value: string) => withReturn(`/admin/pacientes/${patient.id}${tabQuery[value]}`, volta);
// Filtro por tipo na aba Documentos (só os tipos que o paciente tem).
const kindFilter = DOCUMENT_KINDS.find((k) => k.key === Astro.url.searchParams.get("tipo"))?.key ?? null;
const shownDocuments = kindFilter ? documents.filter((d) => d.kind === kindFilter) : documents;
const kindsPresent = DOCUMENT_KINDS.filter((k) => documents.some((d) => d.kind === k.key));
const kindHref = (key: string | null) => withReturn(`/admin/pacientes/${patient.id}?aba=documentos${key ? `&tipo=${key}` : ""}`, volta);
const plural = (n: number) => `${n} ${n === 1 ? "atendimento" : "atendimentos"}`;
const rows = tab === "anteriores" ? previous : upcoming;

// Nota de cada pagamento: a ativa (emitida, emitindo ou cancelando); sem ela, "Sem nota".
const INVOICE_PILL: Partial<Record<InvoiceStatus, { tone: PillTone; text: (n: string | null) => string }>> = {
  issued: { tone: "success", text: (n) => (n ? `Nota nº ${n}` : "Nota emitida") },
  issuing: { tone: "warning", text: () => "Emitindo…" },
  canceling: { tone: "warning", text: () => "Cancelando…" },
};
const activeInvoice = (paymentId: string) => (invoices?.get(paymentId) ?? []).find((n) => ACTIVE_INVOICE.includes(n.status));

const deliveryText = () => {
  const base = `WhatsApp do ${vocabulary.contact}`;
  const extras = [savedDelivery?.phone ? formatPhoneBR(savedDelivery.phone) : null, savedDelivery?.email].filter(Boolean);
  if (!extras.length) return `${base}.`;
  return `${base}; também ${extras.join(" e ")}${savedDelivery?.autoSend ? ", sempre" : ", quando escolhido no envio"}.`;
};
const payerRole = (payer: string) => (payer === "other" ? "outra pessoa" : payer === "patient" ? vocabulary.patient : patient.isContactSelf ? vocabulary.patient : vocabulary.contact);

const card = "flex flex-col rounded-xl border border-line bg-white p-3.5 sm:px-5 sm:py-[18px]";
const sectionTitle = "font-display text-[17px] leading-tight font-bold text-ink sm:text-lg";
const notice = "flex items-start gap-2.5 rounded-[10px] border px-3.5 py-3 text-[15px] leading-snug";
const field = "flex flex-col gap-1.5";
const fieldLabel = "text-[14.5px] font-semibold text-ink";
const hint = "text-sm text-ink-soft";
const kv = "grid grid-cols-[120px_minmax(0,1fr)] gap-x-3 gap-y-2 text-[15px]";
const dt = "text-ink-soft";
const dd = "font-semibold text-ink";
const radio = "flex items-center gap-2.5 text-[15px] text-ink";
const canBook = patient.isActive && !anonymized;
---

<AdminLayout title={patient.fullName}>
  <a href={volta ?? "/admin/pacientes"} class="inline-flex min-h-8 items-center gap-1 text-[15px] font-semibold text-brand no-underline hover:underline">
    <Icon name="chevron-left" class="h-[18px] w-[18px]" strokeWidth={2.2} />
    {volta ? "Voltar" : capitalize(vocabulary.patients)}
  </a>
  <FlashMessage />

  <section aria-label={capitalize(vocabulary.patient)} class={`${card} mt-3 gap-3 sm:px-6 sm:py-5`}>
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="flex min-w-0 flex-col gap-2">
        <div class="flex flex-wrap items-center gap-2.5">
          <h1 class="font-display text-[26px] leading-[1.1] font-bold text-ink sm:text-[30px]">{patient.fullName}</h1>
          {anonymized ? <Pill tone="warning">Anonimizado</Pill> : !patient.isActive && <Pill tone="neutral">Desativado</Pill>}
          {stats && <Pill tone="alert" icon="user-x">Faltou {stats.noShows} de {stats.total}</Pill>}
          {contact.botBlockedAt && <Pill tone="danger" icon="lock">{capitalize(vocabulary.contact)} bloqueado</Pill>}
        </div>
        <div class="flex flex-wrap items-center gap-x-3.5 gap-y-1.5 text-[15.5px] text-ink">
          {!anonymized && <span>{formatAge(patient.birthdate, today)}</span>}
          {insuranceOn && !anonymized && <Tag>{planLabel}</Tag>}
          <span class="inline-flex flex-wrap items-center gap-x-1.5 gap-y-1">
            {patient.isContactSelf ? (
              "WhatsApp:"
            ) : (
              <>
                {capitalize(vocabulary.contact)}:
                <a href={withReturn(`/admin/pacientes/contato/${contact.id}`, here)} class="font-semibold text-brand no-underline hover:underline">{contact.fullName}</a>·
              </>
            )}
            <PhoneLinks phone={contact.phone} plain />
          </span>
          {
            patient.isContactSelf && (
              <a href={withReturn(`/admin/pacientes/contato/${contact.id}`, here)} class="text-[15px] font-semibold text-brand no-underline hover:underline">
                Editar o telefone
              </a>
            )
          }
        </div>
      </div>
      {
        !anonymized && (
          <div class="flex gap-2">
            <MoreMenu id="mais-paciente" label={`Mais ações: ${patient.fullName}`} size="md">
              <form method="POST" action={action}>
                <input type="hidden" name="acao" value={patient.isActive ? "desativar" : "reativar"} />
                <button
                  type="submit"
                  class={`${menuItemClass()} ${patient.isActive ? "js-confirm-delete" : ""}`}
                  data-confirm-title={`Desativar o ${vocabulary.patient}?`}
                  data-confirm-message="Sai das telas de marcação; o histórico fica. Dá para reativar depois."
                  data-confirm-label="Desativar"
                >
                  {patient.isActive ? `Desativar o ${vocabulary.patient}` : `Reativar o ${vocabulary.patient}`}
                </button>
              </form>
              {
                canAnonymize && (
                  <form method="POST" action={action} class="mt-1 border-t border-line pt-1">
                    <input type="hidden" name="acao" value="anonimizar" />
                    <button
                      type="submit"
                      class={`${menuItemClass(true)} js-confirm-delete`}
                      data-confirm-title={`Anonimizar ${patient.fullName}?`}
                      data-confirm-message={anonymizeMessage}
                      data-confirm-label="Anonimizar"
                    >
                      Anonimizar (LGPD)…
                    </button>
                  </form>
                )
              }
            </MoreMenu>
            {
              canBook && (
                <Button href={withReturn(`/admin/agenda/marcar?patient_id=${patient.id}`, here)} variant="primary" class="max-sm:hidden">
                  <Icon name="plus" class="h-[18px] w-[18px]" strokeWidth={2.2} /> Marcar
                </Button>
              )
            }
          </div>
        )
      }
    </div>
    {
      ageWarning && (
        <p class={`${notice} border-pend-200 bg-pend-50 text-pend-800`}>
          <Icon name="warning" class="mt-0.5 h-[18px] w-[18px] shrink-0" strokeWidth={2} />
          {ageWarning}
        </p>
      )
    }
    {
      anonymized && (
        <p class={`${notice} border-line bg-canvas text-ink`}>
          <Icon name="information-circle" class="mt-0.5 h-[18px] w-[18px] shrink-0 text-ink-soft" strokeWidth={2} />
          <span>
            Anonimizado em {formatInstant(patient.anonymizedAt!, clinic.timezone, "dd/MM/yyyy 'às' HH:mm")}, a pedido (LGPD). Nome, nascimento, observações,
            telefone e mensagens foram apagados; o histórico de atendimentos fica, sem identificação.
          </span>
        </p>
      )
    }
  </section>

  <div class="mt-4 grid grid-cols-[minmax(0,1fr)] items-start gap-4 lg:grid-cols-[minmax(0,1fr)_400px] lg:gap-5">
    <section aria-labelledby="atendimentos-titulo" class={`${card} gap-1`}>
      <h2 id="atendimentos-titulo" class={sectionTitle}>{anonymized ? "Atendimentos" : "Atendimentos, documentos e anotações"}</h2>
      <Tabs
        inCard
        label="Atendimentos, documentos e anotações"
        class="mt-1"
        tabs={[
          { label: "Próximos", href: tabHref("proximos"), active: tab === "proximos", count: upcoming.length, countTone: "neutral", countLabel: plural(upcoming.length) },
          {
            label: "Anteriores e cancelados",
            href: tabHref("anteriores"),
            active: tab === "anteriores",
            count: previous.length,
            countTone: "neutral",
            countLabel: plural(previous.length),
          },
          ...(anonymized
            ? []
            : [
                {
                  label: "Documentos",
                  href: tabHref("documentos"),
                  active: tab === "documentos",
                  count: documents.length,
                  countTone: "neutral" as const,
                  countLabel: `${documents.length} ${documents.length === 1 ? "documento" : "documentos"}`,
                },
                {
                  label: "Anotações",
                  href: tabHref("anotacoes"),
                  active: tab === "anotacoes",
                  count: notes.length,
                  countTone: "neutral" as const,
                  countLabel: `${notes.length} ${notes.length === 1 ? "anotação" : "anotações"}`,
                },
              ]),
        ]}
      />
      {isAppointments && <ul>
        {rows.map((a) => {
          const paid = paymentStates?.get(a.id);
          return (
            <li class="grid grid-cols-[112px_minmax(0,1fr)] gap-x-3 gap-y-2.5 border-t border-line py-3.5 first:border-t-0 sm:grid-cols-[124px_minmax(0,1fr)_auto] sm:items-center sm:gap-x-4">
              <div class="flex flex-col">
                <span class="text-[13.5px] font-semibold text-ink-soft first-letter:uppercase">{formatInstant(a.scheduledAt, clinic.timezone, "EEE, dd/MM/yyyy")}</span>
                <span class="font-display text-[22px] leading-tight font-bold text-ink tabular-nums">{formatInstant(a.scheduledAt, clinic.timezone, "HH:mm")}</span>
              </div>
              <div class="flex min-w-0 flex-col gap-1.5">
                <span class={`text-[15.5px] leading-snug font-semibold ${a.status === "canceled" ? "text-ink-soft" : "text-ink"}`}>
                  {a.serviceName} · {a.agendaName}
                </span>
                <span class="flex flex-wrap items-center gap-1.5">
                  {pending(a) ? (
                    <Pill tone="warning" icon="clock">
                      Registrar comparecimento
                    </Pill>
                  ) : (
                    <StatusPill situation={appointmentSituation(a)} />
                  )}
                  {a.seriesId && <Tag>série</Tag>}
                  {paid === "paid" && (
                    <Pill tone="success" icon="banknotes">
                      Pago
                    </Pill>
                  )}
                  {paid === "partial" && (
                    <Pill tone="warning" icon="banknotes">
                      Pago em parte
                    </Pill>
                  )}
                </span>
              </div>
              <div class="col-span-2 flex flex-wrap gap-1.5 sm:col-span-1 sm:justify-end">
                <Button href={`/admin/agenda?date=${localDateOf(a.scheduledAt, clinic.timezone)}`} size="sm">
                  Abrir na Agenda
                </Button>
                <Button href={withReturn(`/admin/agenda/trilha/${a.id}`, here)} size="sm" variant="quiet">
                  Trilha
                </Button>
              </div>
            </li>
          );
        })}
      </ul>}
      {
        isAppointments && rows.length === 0 && (
          <p class="py-3 text-[15px] text-ink-soft">{tab === "anteriores" ? "Nenhum atendimento anterior." : "Nenhum atendimento marcado."}</p>
        )
      }
      {
        tab === "documentos" && (
          <div class="flex flex-col gap-3 pt-2">
            {kindsPresent.length > 1 && (
              <nav aria-label="Filtrar por tipo" class="flex flex-wrap gap-1.5">
                {[{ key: null, label: "Todos", count: documents.length }, ...kindsPresent.map((k) => ({ key: k.key, label: k.label, count: documents.filter((d) => d.kind === k.key).length }))].map((f) => (
                  <Button
                    size="sm"
                    href={kindHref(f.key)}
                    aria-current={kindFilter === f.key ? "page" : undefined}
                    class={kindFilter === f.key ? "border-brand! bg-brand-soft! text-brand-ink!" : ""}
                  >
                    {f.label} ({f.count})
                  </Button>
                ))}
              </nav>
            )}
            {canAttach && (
              <details class="group" data-attach-box>
                <summary class={`${buttonClass("primary", "sm")} cursor-pointer list-none group-open:hidden [&::-webkit-details-marker]:hidden`}>Anexar documento</summary>
                <form class="flex flex-col gap-3 rounded-lg border border-line p-3" data-attach={documentsApi} novalidate>
                  <div class={field}>
                    <label for="document-kind" class={fieldLabel}>Tipo</label>
                    <select id="document-kind" name="kind" required class={CONTROL}>
                      <option value="">Escolha</option>
                      {DOCUMENT_KINDS.map((k) => <option value={k.key}>{k.label}</option>)}
                    </select>
                  </div>
                  <div class={field}>
                    <label for="document-description" class={fieldLabel}>Descrição (opcional)</label>
                    <input id="document-description" name="description" maxlength={DESCRIPTION_MAX} placeholder="Ex.: Carteirinha Unimed 2026" class={CONTROL} />
                  </div>
                  <div class={field}>
                    <span class={fieldLabel}>Arquivo</span>
                    <div class="flex flex-wrap items-center gap-2.5">
                      <input id="document-file" name="file" type="file" required accept={["image/*", ...DOCUMENT_MIME_TYPES].join(",")} class="peer sr-only" />
                      <label for="document-file" class={`${buttonClass("secondary", "sm")} cursor-pointer peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand`}>
                        Escolher arquivo
                      </label>
                      <span class="min-w-0 text-[15px] break-all text-ink-soft" data-file-name>Nenhum arquivo escolhido</span>
                    </div>
                    <p class={hint}>Foto (JPG, PNG ou HEIC) ou PDF, até 10 MB. No celular, dá para tirar a foto na hora.</p>
                  </div>
                  <p class="hidden text-[15px] font-semibold text-can-800" role="alert" data-attach-error></p>
                  <div class="flex flex-wrap items-center gap-2">
                    <Button type="submit" variant="primary" data-attach-submit>Anexar</Button>
                    <Button data-attach-cancel>Cancelar</Button>
                    <span class="text-[15px] text-ink-soft" aria-live="polite" data-attach-status></span>
                  </div>
                </form>
                <noscript><p class={hint}>Para anexar, ative o JavaScript do navegador.</p></noscript>
              </details>
            )}
            {shownDocuments.length > 0 && (
              <ul data-documents={documentsApi}>
                {shownDocuments.map((d) => {
                  const by = d.createdBy ? actorText(documentActors.get(d.createdBy)) : null;
                  return (
                    <li class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-3 gap-y-2 border-t border-line py-3 first:border-t-0 sm:grid-cols-[auto_minmax(0,1fr)_auto] sm:items-center">
                      <input
                        type="checkbox"
                        class="mt-0.5 h-[18px] w-[18px] shrink-0 self-start accent-brand sm:self-center"
                        aria-label={`Selecionar ${DOCUMENT_KIND_LABEL[d.kind]}${d.description ? `: ${d.description}` : ""}`}
                        data-document={d.id}
                        data-name={d.fileName}
                        data-type={d.mimeType}
                      />
                      <div class="flex min-w-0 flex-col gap-0.5">
                        <span class="text-[15.5px] leading-snug font-semibold text-ink">
                          {DOCUMENT_KIND_LABEL[d.kind]}
                          {d.description && <span class="font-normal break-words"> · {d.description}</span>}
                        </span>
                        <span class="text-[13.5px] text-ink-soft">
                          {[formatInstant(d.createdAt, clinic.timezone, "dd/MM/yyyy"), by, `${fileType(d.mimeType)}, ${fileSize(d.sizeBytes)}`].filter(Boolean).join(" · ")}
                        </span>
                      </div>
                      <div class="col-span-2 flex flex-wrap gap-1.5 sm:col-span-1 sm:justify-end">
                        <Button size="sm" href={`${documentsApi}/${d.id}`} target="_blank" rel="noopener">Abrir</Button>
                        <Button size="sm" href={`${documentsApi}/${d.id}?modo=baixar`} download={d.fileName}>Baixar</Button>
                        {canAttach && (
                          <form method="POST" action={withReturn(documentsApi, volta)} class="contents">
                            <input type="hidden" name="acao" value="apagar" />
                            <input type="hidden" name="documento" value={d.id} />
                            <button
                              type="submit"
                              class={`js-confirm-delete ${buttonClass("danger-quiet", "sm")}`}
                              data-confirm-title="Apagar o documento?"
                              data-confirm-message={`${DOCUMENT_KIND_LABEL[d.kind]}${d.description ? ` (${d.description})` : ""} sai da ficha e o arquivo é apagado. Não dá para desfazer.`}
                              data-confirm-label="Apagar"
                            >
                              Apagar
                            </button>
                          </form>
                        )}
                      </div>
                    </li>
                  );
                })}
              </ul>
            )}
            {shownDocuments.length > 0 && (
              <div class="flex flex-wrap items-center gap-2">
                <div class="flex flex-wrap gap-2" data-selection hidden>
                  <Button size="sm" data-download-selected>Baixar selecionados</Button>
                  <Button size="sm" data-share-selected hidden>Compartilhar</Button>
                </div>
                <p class={hint} data-selection-hint>Marque os documentos para baixar ou compartilhar vários de uma vez.</p>
              </div>
            )}
            {documents.length === 0 && <p class="py-3 text-[15px] text-ink-soft">Nenhum documento. Anexe a carteirinha, a identidade ou os pedidos em foto ou PDF.</p>}

          </div>
        )
      }
      {
        tab === "anotacoes" && (
          <div class="flex flex-col gap-3 pt-2">
            {canWriteNotes && (
              <form method="POST" action={withReturn(notesApi, volta)} class="flex flex-col gap-2">
                <input type="hidden" name="acao" value="escrever" />
                <label for="note-body" class="sr-only">Nova anotação</label>
                <textarea
                  id="note-body"
                  name="body"
                  rows="3"
                  required
                  maxlength={NOTE_MAX}
                  placeholder="Ex.: Plano pediu o laudo do exame; a mãe prefere atendimento à tarde."
                  class={`${CONTROL} h-auto! py-2.5`}
                ></textarea>
                <div class="flex flex-wrap items-center gap-2">
                  <Button type="submit" variant="primary" size="sm" data-sending-label="Salvando…">Salvar anotação</Button>
                  <span class={hint}>Só a equipe vê.</span>
                </div>
              </form>
            )}
            {notes.length > 0 && (
              <ul>
                {notes.map((n) => {
                  const by = n.fromObservations ? "Observações anteriores" : n.createdBy ? actorText(documentActors.get(n.createdBy)) : null;
                  const mine = !!n.createdBy && n.createdBy === clinic.userId && canWriteNotes;
                  return (
                    <li class="flex flex-col gap-1.5 border-t border-line py-3 first:border-t-0">
                      <p class="text-[15.5px] leading-snug whitespace-pre-line break-words text-ink">{n.body}</p>
                      <span class="text-[13.5px] text-ink-soft">
                        {[
                          n.fromObservations ? null : formatInstant(n.createdAt, clinic.timezone, "dd/MM/yyyy 'às' HH:mm"),
                          by,
                          n.updatedAt ? `editada em ${formatInstant(n.updatedAt, clinic.timezone, "dd/MM 'às' HH:mm")}` : null,
                        ]
                          .filter(Boolean)
                          .join(" · ")}
                      </span>
                      {(mine || canDeleteNotes) && (
                        <div class="flex flex-wrap items-start gap-1.5">
                          {mine && (
                            <details class="group open:w-full">
                              <summary class={`${buttonClass("secondary", "sm")} cursor-pointer list-none group-open:hidden [&::-webkit-details-marker]:hidden`}>Editar</summary>
                              <form method="POST" action={withReturn(notesApi, volta)} class="flex flex-col gap-2">
                                <input type="hidden" name="acao" value="editar" />
                                <input type="hidden" name="anotacao" value={n.id} />
                                <label for={`note-${n.id}`} class="sr-only">Corrigir a anotação</label>
                                <textarea id={`note-${n.id}`} name="body" rows="3" required maxlength={NOTE_MAX} class={`${CONTROL} h-auto! py-2.5`}>{n.body}</textarea>
                                <div class="flex flex-wrap gap-2">
                                  <Button type="submit" variant="primary" size="sm" data-sending-label="Salvando…">Salvar</Button>
                                  <Button size="sm" href={tabHref("anotacoes")}>Cancelar</Button>
                                </div>
                              </form>
                            </details>
                          )}
                          {canDeleteNotes && (
                            <form method="POST" action={withReturn(notesApi, volta)} class="contents">
                              <input type="hidden" name="acao" value="apagar" />
                              <input type="hidden" name="anotacao" value={n.id} />
                              <button
                                type="submit"
                                class={`js-confirm-delete ${buttonClass("danger-quiet", "sm")}`}
                                data-confirm-title="Apagar a anotação?"
                                data-confirm-message="A anotação sai da ficha do paciente. Não dá para desfazer."
                                data-confirm-label="Apagar"
                              >
                                Apagar
                              </button>
                            </form>
                          )}
                        </div>
                      )}
                    </li>
                  );
                })}
              </ul>
            )}
            {notes.length === 0 && <p class="py-3 text-[15px] text-ink-soft">Nenhuma anotação.</p>}
          </div>
        )
      }
    </section>

    <div class="flex flex-col gap-4">
      {
        !anonymized && (
          <EditCard id="dados" title="Dados" summary={`Nasc. ${formatCalendarDate(patient.birthdate, "dd/MM/yyyy")}`}>
            <dl class={kv}>
              <dt class={dt}>Nascimento</dt>
              <dd class={dd}>{formatCalendarDate(patient.birthdate, "dd/MM/yyyy")}</dd>
            </dl>
            <form slot="edit" method="POST" action={action} class="flex flex-col gap-4">
              <input type="hidden" name="acao" value="salvar" />
              <div class={field}>
                <label for="full_name" class={fieldLabel}>Nome</label>
                <input id="full_name" name="full_name" required value={patient.fullName} class={CONTROL} />
              </div>
              <div class={field}>
                <label for="birthdate" class={fieldLabel}>Data de nascimento</label>
                <input id="birthdate" name="birthdate" type="date" required max={today} value={patient.birthdate} class={`${CONTROL} w-48`} />
              </div>
              <div class="flex gap-2">
                <Button type="submit" variant="primary" data-sending-label="Salvando…">Salvar</Button>
                <Button href={here} data-edit-cancel>Cancelar</Button>
              </div>
            </form>
          </EditCard>
        )
      }

      {
        insuranceOn && !anonymized && (
          <EditCard id="plano" title="Plano de saúde" summary={planLabel}>
            <dl class={kv}>
              <dt class={dt}>Plano</dt>
              <dd class={dd}>{planLabel}</dd>
              {patient.insurance?.cardNumber && (
                <>
                  <dt class={dt}>Carteirinha</dt>
                  <dd class={`${dd} tabular-nums`}>{patient.insurance.cardNumber}</dd>
                </>
              )}
              {patient.insurance?.cardValidUntil && (
                <>
                  <dt class={dt}>Validade</dt>
                  <dd class={dd}>{formatCalendarDate(patient.insurance.cardValidUntil, "dd/MM/yyyy")}</dd>
                </>
              )}
            </dl>
            <form slot="edit" method="POST" action={action} class="flex flex-col gap-4">
              <input type="hidden" name="acao" value="plano" />
              <div class={field}>
                <label for="plan_id" class={fieldLabel}>Plano</label>
                <select id="plan_id" name="plan_id" class={CONTROL}>
                  <option value="">Particular</option>
                  {plans
                    .filter((plan) => plan.isActive || plan.id === patient.insurance?.planId)
                    .map((plan) => (
                      <option value={plan.id} selected={plan.id === patient.insurance?.planId}>
                        {plan.name}
                        {!plan.isActive && " (desativado)"}
                      </option>
                    ))}
                </select>
              </div>
              <div class="grid gap-4 sm:grid-cols-2">
                <div class={field}>
                  <label for="card_number" class={fieldLabel}>Carteirinha</label>
                  <input id="card_number" name="card_number" value={patient.insurance?.cardNumber ?? ""} class={CONTROL} />
                </div>
                <div class={field}>
                  <label for="card_valid_until" class={fieldLabel}>Validade</label>
                  <input id="card_valid_until" name="card_valid_until" type="date" value={patient.insurance?.cardValidUntil ?? ""} class={CONTROL} />
                </div>
              </div>
              <div class="flex gap-2">
                <Button type="submit" variant="primary" data-sending-label="Salvando…">Salvar plano</Button>
                <Button href={here} data-edit-cancel>Cancelar</Button>
              </div>
            </form>
          </EditCard>
        )
      }

      {
        finance && responsible && (
          <EditCard id="financeiro" title="Financeiro" summary={responsible.name || "Outra pessoa"} editable={canEditFinance}>
            <dl class={kv}>
              <dt class={dt}>Quem paga</dt>
              <dd class={dd}>
                {responsible.name || "—"} <span class="font-normal text-ink-soft">({payerRole(responsible.payer)})</span>
              </dd>
              <dt class={dt}>CPF</dt>
              <dd class={responsible.cpf ? `${dd} tabular-nums` : "text-ink-soft"}>{responsible.cpf ? formatCpf(responsible.cpf) : "não informado"}</dd>
              {!patient.isContactSelf && responsible.payer !== "patient" && (
                <>
                  <dt class={dt}>CPF de {patient.fullName.split(" ")[0]}</dt>
                  <dd class={finance.cpf ? `${dd} tabular-nums` : "text-ink-soft"}>{finance.cpf ? formatCpf(finance.cpf) : "não informado (opcional)"}</dd>
                </>
              )}
              <dt class={dt}>Envio das notas</dt>
              <dd class="font-medium text-ink">{deliveryText()}</dd>
            </dl>
            {
              !responsible.cpf && (
                <p class={`${notice} border-pend-200 bg-pend-50 text-pend-800`}>
                  <Icon name="warning" class="mt-0.5 h-[18px] w-[18px] shrink-0" strokeWidth={2} />
                  Falta o CPF do responsável financeiro: sem ele, a nota fiscal não sai.
                </p>
              )
            }
            <p class={hint}>Só a Recepção e o Administrador veem estes dados; o bot e as páginas públicas não.</p>
            <form slot="edit" method="POST" action={financeAction} class="flex flex-col gap-4" id="financeiro-form">
              <div class={field}>
                <label for="fin_cpf" class={fieldLabel}>
                  CPF de {patient.fullName}
                  {patient.isContactSelf ? "" : <span class="font-normal text-ink-soft"> (opcional)</span>}
                </label>
                <input
                  id="fin_cpf"
                  name={patient.isContactSelf ? "contact_cpf" : "cpf"}
                  inputmode="numeric"
                  placeholder="000.000.000-00"
                  value={cpfValue(patient.isContactSelf ? contactCpf : finance.cpf)}
                  class={`${CONTROL} w-full sm:w-56`}
                />
              </div>
              <fieldset class="flex flex-col gap-2">
                <legend class={`${fieldLabel} mb-2`}>
                  Quem paga <span class="font-normal text-ink-soft">(a nota sai no CPF dele)</span>
                </legend>
                <label class={radio}>
                  <input type="radio" name="payer" value="contact" checked={responsible.payer === "contact"} class="h-[18px] w-[18px] shrink-0 accent-brand" />
                  {patient.isContactSelf ? patient.fullName : `${contact.fullName} (${vocabulary.contact})`}
                </label>
                {!patient.isContactSelf && (
                  <label class={radio}>
                    <input type="radio" name="payer" value="patient" checked={responsible.payer === "patient"} class="h-[18px] w-[18px] shrink-0 accent-brand" />
                    {patient.fullName}
                  </label>
                )}
                <label class={radio}>
                  <input type="radio" name="payer" value="other" checked={responsible.payer === "other"} class="h-[18px] w-[18px] shrink-0 accent-brand" />
                  Outra pessoa
                </label>
              </fieldset>
              {!patient.isContactSelf && (
                <div data-payer-only="contact" class={field}>
                  <label for="fin_contact_cpf" class={fieldLabel}>CPF de {contact.fullName}</label>
                  <input
                    id="fin_contact_cpf"
                    name="contact_cpf"
                    inputmode="numeric"
                    placeholder="000.000.000-00"
                    value={cpfValue(contactCpf)}
                    aria-describedby="fin_contact_cpf-hint"
                    class={`${CONTROL} w-full sm:w-56`}
                  />
                  <p id="fin_contact_cpf-hint" class={hint}>Vale também para os outros cadastros deste WhatsApp.</p>
                </div>
              )}
              <div data-payer-only="other" class="grid gap-4 sm:grid-cols-2">
                <div class={field}>
                  <label for="fin_payer_name" class={fieldLabel}>Nome de quem paga</label>
                  <input id="fin_payer_name" name="payer_name" value={finance.payerName ?? ""} class={CONTROL} />
                </div>
                <div class={field}>
                  <label for="fin_payer_cpf" class={fieldLabel}>CPF de quem paga</label>
                  <input id="fin_payer_cpf" name="payer_cpf" inputmode="numeric" placeholder="000.000.000-00" value={cpfValue(finance.payerCpf)} class={CONTROL} />
                </div>
              </div>
              <fieldset class="flex flex-col gap-3 border-t border-line pt-4">
                <legend class="sr-only">Envio das notas fiscais</legend>
                <p class={fieldLabel} aria-hidden="true">Envio das notas fiscais</p>
                <p class={hint}>A nota vai sempre para o WhatsApp do {vocabulary.contact}. Aqui, outro número e um e-mail (ex.: de quem paga).</p>
                <div class="grid gap-4 sm:grid-cols-2">
                  <div class={field}>
                    <label for="fin_invoice_phone" class={fieldLabel}>Outro WhatsApp</label>
                    <input
                      id="fin_invoice_phone"
                      name="invoice_phone"
                      inputmode="tel"
                      placeholder="(84) 98888-0000"
                      value={savedDelivery?.phone ? formatPhoneBR(savedDelivery.phone) : ""}
                      class={CONTROL}
                    />
                  </div>
                  <div class={field}>
                    <label for="fin_invoice_email" class={fieldLabel}>E-mail</label>
                    <input id="fin_invoice_email" name="invoice_email" type="email" value={savedDelivery?.email ?? ""} class={CONTROL} />
                  </div>
                </div>
                <label class="flex items-start gap-2.5 text-[15px] leading-snug text-ink">
                  <input type="checkbox" name="invoice_auto_send" value="1" checked={savedDelivery?.autoSend ?? false} class="mt-0.5 h-[18px] w-[18px] shrink-0 accent-brand" />
                  Enviar sempre para eles, junto com o {vocabulary.contact}
                </label>
              </fieldset>
              <div class="flex gap-2">
                <Button type="submit" variant="primary" data-sending-label="Salvando…">Salvar dados financeiros</Button>
                <Button href={here} data-edit-cancel>Cancelar</Button>
              </div>
            </form>
          </EditCard>
        )
      }

      {
        paymentsOn && (
          <EditCard id="pagamentos" title={`Pagamentos (${payments.filter((p) => !p.deletedAt).length})`} editable={false}>
            <ul class="-mt-1">
              {payments.map((p) => {
                const invoice = activeInvoice(p.id);
                const pill = invoice ? INVOICE_PILL[invoice.status] : undefined;
                return (
                  <li class="border-t border-line first:border-t-0">
                    <a
                      href={withReturn(`/admin/financeiro/pagamento/${p.appointmentId}`, here)}
                      class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-2 py-2.5 text-ink no-underline hover:bg-canvas/60"
                    >
                      <span class={`flex min-w-0 flex-col ${p.deletedAt ? "text-ink-soft line-through" : ""}`}>
                        <span>
                          <span class="font-display text-[17px] font-bold tabular-nums">{formatCentsBRL(p.amountCents)}</span>
                          <span class={hint}>
                            {" "}
                            · {PAYMENT_METHOD_LABEL[p.method]} · {formatCalendarDate(p.paidOn, "dd/MM/yyyy")}
                          </span>
                        </span>
                        <span class={hint}>
                          {p.serviceName} de {formatInstant(p.appointmentAt, clinic.timezone, "dd/MM/yyyy")} · pagou: {p.payerName}
                        </span>
                      </span>
                      <span class="flex flex-col items-end gap-1">
                        {p.deletedAt ? (
                          <Pill tone="neutral">Excluído</Pill>
                        ) : !p.payerCpf ? (
                          <Pill tone="warning">Falta CPF</Pill>
                        ) : pill && invoice ? (
                          <Pill tone={pill.tone} icon="document-check">
                            {pill.text(invoice.nfseNumber)}
                          </Pill>
                        ) : (
                          <Pill tone="warning">Sem nota</Pill>
                        )}
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
            {payments.length === 0 && <p class={hint}>Nenhum pagamento ainda. Registre pelo botão "Pagamento" na Agenda.</p>}
          </EditCard>
        )
      }
    </div>
  </div>

  {
    canBook && (
      <>
        <div class="h-20 sm:hidden" aria-hidden="true" />
        <div class="fixed inset-x-0 bottom-[calc(61px+env(safe-area-inset-bottom))] z-10 flex items-center gap-3 border-t border-line bg-white px-4 py-2.5 shadow-[0_-4px_14px_rgba(18,48,42,.08)] sm:hidden">
          <span class="min-w-0 flex-1 truncate text-base font-semibold text-ink">{patient.fullName}</span>
          <Button href={withReturn(`/admin/agenda/marcar?patient_id=${patient.id}`, here)} variant="primary" class="h-12 px-6 text-base">
            Marcar
          </Button>
        </div>
      </>
    )
  }
  {!anonymized && <ConfirmDeleteDialog />}
</AdminLayout>

<script>
  // Documentos (CRM P1): anexar em dois passos (o arquivo vai direto ao
  // armazenamento), baixar ou compartilhar os selecionados.
  const attach = document.querySelector<HTMLFormElement>("form[data-attach]");
  if (attach) {
    const api = attach.dataset.attach!;
    const error = attach.querySelector<HTMLElement>("[data-attach-error]")!;
    const status = attach.querySelector<HTMLElement>("[data-attach-status]")!;
    const submit = attach.querySelector<HTMLButtonElement>("[data-attach-submit]")!;
    const fileInput = attach.elements.namedItem("file") as HTMLInputElement;
    const fileName = attach.querySelector<HTMLElement>("[data-file-name]")!;
    fileInput.addEventListener("change", () => {
      fileName.textContent = fileInput.files?.[0]?.name ?? "Nenhum arquivo escolhido";
      fileName.classList.toggle("text-ink", !!fileInput.files?.length);
    });
    attach.querySelector<HTMLButtonElement>("[data-attach-cancel]")!.addEventListener("click", () => {
      attach.reset();
      fileName.textContent = "Nenhum arquivo escolhido";
      error.classList.add("hidden");
      attach.closest("details")!.open = false;
    });
    const fail = (text: string) => {
      error.textContent = text;
      error.classList.remove("hidden");
      status.textContent = "";
      submit.disabled = false;
    };
    const post = async (body: Record<string, unknown>) => {
      const response = await fetch(api, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
      const data = await response.json().catch(() => ({ error: "Não deu certo. Tente de novo." }));
      if (!response.ok) throw new Error(Object.values(data.fields ?? {})[0] as string ?? data.error);
      return data;
    };
    attach.addEventListener("submit", async (event) => {
      event.preventDefault();
      error.classList.add("hidden");
      const file = (attach.elements.namedItem("file") as HTMLInputElement).files?.[0];
      const kind = (attach.elements.namedItem("kind") as HTMLSelectElement).value;
      if (!kind) return fail("Escolha o tipo do documento.");
      if (!file) return fail("Escolha o arquivo.");
      const input = {
        kind,
        description: (attach.elements.namedItem("description") as HTMLInputElement).value,
        fileName: file.name,
        mimeType: file.type,
        sizeBytes: file.size,
      };
      submit.disabled = true;
      try {
        status.textContent = "Preparando…";
        const { documentId, uploadUrl } = await post({ acao: "preparar", ...input });
        status.textContent = "Enviando o arquivo…";
        const body = new FormData();
        body.append("cacheControl", "3600");
        body.append("", file);
        const upload = await fetch(uploadUrl, { method: "PUT", headers: { "x-upsert": "false" }, body });
        if (!upload.ok) throw new Error("O arquivo não foi enviado. Confira a internet e tente de novo.");
        status.textContent = "Salvando…";
        const { redirectTo } = await post({ acao: "confirmar", documentId, ...input });
        window.location.href = redirectTo;
      } catch (e) {
        fail(e instanceof Error && e.message ? e.message : "Não deu certo. Tente de novo.");
      }
    });
  }

  const list = document.querySelector<HTMLElement>("[data-documents]");
  if (list) {
    const bar = document.querySelector<HTMLElement>("[data-selection]")!;
    const share = bar.querySelector<HTMLButtonElement>("[data-share-selected]")!;
    const api = list.dataset.documents!;
    const selected = () => [...list.querySelectorAll<HTMLInputElement>("input[data-document]:checked")];
    const link = async (id: string, download: boolean) => {
      const response = await fetch(`${api}/${id}?formato=json${download ? "&modo=baixar" : ""}`);
      if (!response.ok) throw new Error("Documento não encontrado.");
      return ((await response.json()) as { url: string }).url;
    };
    const canShareFiles = typeof navigator.canShare === "function" && navigator.canShare({ files: [new File([""], "teste.pdf", { type: "application/pdf" })] });
    const selectionHint = document.querySelector<HTMLElement>("[data-selection-hint]");
    list.addEventListener("change", () => {
      bar.hidden = selected().length === 0;
      if (selectionHint) selectionHint.hidden = !bar.hidden;
      share.hidden = !canShareFiles;
    });
    bar.querySelector<HTMLButtonElement>("[data-download-selected]")!.addEventListener("click", async () => {
      for (const box of selected()) {
        const a = document.createElement("a");
        a.href = await link(box.dataset.document!, true);
        a.rel = "noopener";
        // Download: a barra de carregamento do painel não liga (a tela não muda).
        a.download = box.dataset.name!;
        document.body.append(a);
        a.click();
        a.remove();
        await new Promise((resolve) => setTimeout(resolve, 600));
      }
    });
    share.addEventListener("click", async () => {
      share.disabled = true;
      try {
        const files = await Promise.all(
          selected().map(async (box) => {
            const blob = await (await fetch(await link(box.dataset.document!, false))).blob();
            return new File([blob], box.dataset.name!, { type: box.dataset.type });
          }),
        );
        await navigator.share({ files });
      } catch {
        // Cancelado pela pessoa ou o aparelho não aceitou: nada a fazer.
      } finally {
        share.disabled = false;
      }
    });
  }

  // Financeiro: mostra só os campos do responsável escolhido.
  const form = document.getElementById("financeiro-form");
  if (form) {
    const sync = () => {
      const payer = form.querySelector<HTMLInputElement>('input[name="payer"]:checked')?.value ?? "contact";
      form.querySelectorAll<HTMLElement>("[data-payer-only]").forEach((block) => {
        block.hidden = block.dataset.payerOnly !== payer;
      });
    };
    form.addEventListener("change", sync);
    sync();
  }
</script>

---
// P6 Dias e horários (F2a): quem atende e o atendimento no topo (com "Trocar"), o tipo de consulta antes dos dias
// quando há mais de um (a duração muda os horários), a faixa de dias (só dias com horário livre, no prazo do
// profissional) e os horários do dia por turno. Tudo do servidor, pelas mesmas funções do bot e do Marcar. Um dia ou
// uma seta da faixa troca os horários sem recarregar (sem JavaScript, o link abre a página nesse dia). "Continuar"
// confere de novo se o horário está livre.
import PatientDayStrip from "../../../../components/public/PatientDayStrip.astro";
import PatientSlots, { type PatientSlot } from "../../../../components/public/PatientSlots.astro";
import PortalDoctor from "../../../../components/portal/PortalDoctor.astro";
import PortalLayout from "../../../../components/portal/PortalLayout.astro";
import PortalWaitlistNotice from "../../../../components/portal/PortalWaitlistNotice.astro";
import { sessionJoinsWaitlist } from "../../../../lib/data/portal/links";
import PortalNotice from "../../../../components/portal/PortalNotice.astro";
import PortalPreparation from "../../../../components/portal/PortalPreparation.astro";
import PortalStepBar from "../../../../components/portal/PortalStepBar.astro";
import PortalSummary from "../../../../components/portal/PortalSummary.astro";
import { capitalize } from "../../../../lib/vocabulary";
import { formatCalendarDate, formatInstant, isCalendarDate } from "../../../../lib/clinicTime";
import { slotChoiceValue } from "../../../../lib/data/agenda/publicBooking";
import { openPortalPage, professionalOf, singleProfessional } from "../../../../lib/data/portal/page";
import { groupSessions, isProfessionalDayOpen, locationsAt, placesOf, professionalDates, professionalSlots } from "../../../../lib/data/portal/portal";
import { hitLimits, readSession, releaseHold } from "../../../../lib/data/portal/identity";
import { blockedText, ipPrefix, LIMITS } from "../../../../lib/portalIdentity";
import { buildDayStrip, type DayStrip } from "../../../../lib/dayStrip";
import { backFromProfessional, changeProfessionalHref, chosenModality, flowParams, formatPrice, helpForOf, modalityLabelAt, modalityOptions, ofName, portalHref, privateLabel, professionalSteps, readFlow, shortName, stepPosition, WHERE_PARAM, whoLabel, type PortalWhere } from "../../../../lib/portal";

const page = await openPortalPage(Astro);
const professional = page.kind === "open" ? professionalOf(page.portal, Astro.params.profissional) : null;
if (!professional && page.kind !== "unavailable") Astro.response.status = 404;
const params = Astro.url.searchParams;
const asked = readFlow(params);
// Onde (F3e-1, D5 DM1c): quem atende no consultório e em casa escolhe aqui, em cima dos dias (consultório primeiro);
// quem atende num lugar só não escolhe.
const places = professional ? placesOf(professional) : [];
const where: PortalWhere | null = places.length > 1 ? (asked.where ?? "clinic") : null;
const flow = { ...asked, where };
const whereType = where === "home" ? "home_visit" : where === "clinic" ? "clinic" : null;
const atHome = whereType === "home_visit" || (places.length === 1 && places[0] === "home_visit");
const scope = professional ? { locations: locationsAt(professional, whereType) } : {};
const base = page.kind === "open" ? page.base : "";
const options = professional ? modalityOptions(professional) : [];
const modality = chosenModality(options, params.get("mod"));
const modalityPath = professional ? `${base}/${professional.slug}/atendimento` : "";
// Sem escolha válida (o convênio pode ter deixado de ser atendido): de volta à P5, com o aviso.
if (professional && options.length > 0 && !modality) {
  return Astro.redirect(portalHref(modalityPath, { ...flowParams(flow), erro: params.get("mod") ? "plano" : null }));
}
const single = page.kind === "open" && !!singleProfessional(page.portal);
// Só as consultas do lugar escolhido (cliente, 10/nov): "No consultório" não oferece a consulta só de casa, e vice-versa.
const offeredAt = (c: { prices: Partial<Record<"clinic" | "home_visit", number | null>> }, type: "clinic" | "home_visit") => Object.hasOwn(c.prices, type);
const consultations = professional ? professional.consultations.filter((c) => !whereType || offeredAt(c, whereType)) : [];
const consultation = consultations.find((c) => c.serviceId === params.get("tipo")) ?? consultations[0] ?? null;
const timeZone = page.kind === "open" ? page.portal.timeZone : "America/Fortaleza";
const dateParam = (name: string) => {
  const value = params.get(name);
  return value && isCalendarDate(value) ? value : null;
};

let strip: DayStrip | null = null;
let slotOptions: PatientSlot[] = [];
let unavailableOpen = false;
let blockedUntil: Date | null = null;
let sessionId: string | null = null;
let viaBotLink = false;
let waitlist = false;
// Turma (F3e-2, D5 TU2a): lista de dias com vaga, sem o número de vagas, com "Ver mais dias".
const GROUP_PAGE = 8;
const isGroup = !!professional?.exam?.isGroup;
const GROUP_MAX = 60;
const groupShown = Math.min(Math.max(Number.parseInt(params.get("mais") ?? "", 10) || GROUP_PAGE, GROUP_PAGE), GROUP_MAX);
let groupMore = false;
if (page.kind === "open" && professional && consultation && modality) {
  // Limite de consultas de horários (F2b; proposta 7.2): por IP e, com sessão, por sessão.
  const session = await readSession(page.db, page.portal.clinicId, Astro.cookies);
  sessionId = session?.id ?? null;
  viaBotLink = !!session?.linkId;
  waitlist = await sessionJoinsWaitlist(page.db, page.portal.clinicId, session);
  const ip = ipPrefix((() => {
    try {
      return Astro.clientAddress;
    } catch {
      return Astro.request.headers.get("x-forwarded-for");
    }
  })());
  blockedUntil = await hitLimits(page.db, page.portal.clinicId, [
    [`ip:${ip}`, LIMITS.slotsPerIp],
    ...(session ? ([[`session:${session.id}`, LIMITS.slotsPerSession]] as [string, (typeof LIMITS)["slotsPerSession"]][]) : []),
  ]);
  // Voltou da reserva: o horário é solto para todos.
  if (session && params.get("soltar")) await releaseHold(page.db, page.portal.clinicId, session.id);
}
if (page.kind === "open" && professional && consultation && modality && !blockedUntil && isGroup) {
  const sessions = await groupSessions(page.db, page.portal.clinicId, professional, timeZone, { count: groupShown + 1, sessionId });
  // No teto (60 dias), sem "Ver mais dias": o link não traria nada novo.
  groupMore = sessions.length > groupShown && groupShown < GROUP_MAX;
  const locationName = (id: string) => professional.locations.find((l) => l.id === id)?.name ?? "";
  slotOptions = sessions.slice(0, groupShown).map((s) => ({
    value: slotChoiceValue({ start: s.start, agendaId: professional.agendaId, locationId: s.locationId }),
    label: capitalize(formatCalendarDate(s.date, "EEEE, d 'de' MMMM")),
    detail: `às ${s.time}${professional.locations.length > 1 ? `, ${locationName(s.locationId)}` : ""}`,
    summary: `${capitalize(formatInstant(s.start, timeZone, "EEE").slice(0, 3))}, ${formatInstant(s.start, timeZone, "dd/MM 'às' HH:mm")}`,
  }));
} else if (page.kind === "open" && professional && consultation && modality && !blockedUntil) {
  const dates = await professionalDates(page.db, page.portal.clinicId, professional, consultation.serviceId, timeZone, { sessionId, scope });
  strip = buildDayStrip(dates, dateParam("date"), dateParam("start"));
  if (strip.unavailable && !strip.selected && dates.length) strip = { ...buildDayStrip(dates, null, null), unavailable: strip.unavailable };
  const [slots, open] = await Promise.all([
    strip.selected ? professionalSlots(page.db, page.portal.clinicId, professional, consultation.serviceId, strip.selected, timeZone, new Date(), sessionId, scope) : [],
    strip.unavailable ? isProfessionalDayOpen(page.db, page.portal.clinicId, professional, consultation.serviceId, strip.unavailable, timeZone, new Date(), scope) : false,
  ]);
  unavailableOpen = open;
  const shown = scope.locations ?? professional.locations;
  const locationName = (id: string) => shown.find((l) => l.id === id)?.name ?? "";
  slotOptions = slots.map((slot) => ({
    value: slotChoiceValue({ start: slot.start, agendaId: professional.agendaId, locationId: slot.locationId }),
    label: formatInstant(slot.start, timeZone, "HH:mm"),
    detail: shown.length > 1 ? locationName(slot.locationId) : "",
    summary: `${capitalize(formatInstant(slot.start, timeZone, "EEE").slice(0, 3))}, ${formatInstant(slot.start, timeZone, "dd/MM 'às' HH:mm")}`,
  }));
}

const keep = { ...flowParams(flow), mod: modality?.value ?? null, tipo: professional && professional.consultations.length > 1 ? consultation?.serviceId : null };
const timesPath = professional ? `${base}/${professional.slug}/horarios` : "";
const dayHref = (date: string, start: string) => portalHref(timesPath, { ...keep, date, start });
const back = professional ? (options.length > 1 ? portalHref(modalityPath, { ...flowParams(flow), mod: modality?.value }) : backFromProfessional(base, professional.slug, flow, single)) : base;
const changeDoctor = changeProfessionalHref(base, flow);
const changeModality = options.length > 1 ? portalHref(modalityPath, { ...flowParams(flow), mod: modality?.value }) : null;
const step = stepPosition(professionalSteps(flow, options.length > 1, viaBotLink, atHome), "time");
// "No consultório R$ 350" / "Em casa R$ 550": o valor só no particular (no convênio, nenhum).
const placeLabel: Record<PortalWhere, string> = { clinic: "No consultório", home: "Em casa" };
const placePrice = (type: "clinic" | "home_visit") => {
  if (modality?.value !== "particular" || !professional) return null;
  // O valor da consulta escolhida, se ela é oferecida lá; senão, o menor das consultas de lá.
  const there = consultation && offeredAt(consultation, type) ? [consultation] : professional.consultations.filter((c) => offeredAt(c, type));
  const values = there.map((c) => c.prices[type]).filter((v): v is number => typeof v === "number" && v > 0);
  const cents = values.length ? Math.min(...values) : null;
  return cents ? formatPrice(cents) : null;
};
// "Ver valores e convênios aceitos" (cliente, 11/nov/2026): o particular do lugar escolhido (em casa, o valor de casa),
// não o menor de todos os lugares.
const priceType: "clinic" | "home_visit" | null = atHome ? "home_visit" : whereType;
const pricedHere = priceType ? consultations.map((c) => c.prices[priceType]).filter((v): v is number => typeof v === "number" && v > 0) : [];
const privateHere = professional
  ? priceType && pricedHere.length
    ? privateLabel({ ...professional, privatePriceCents: Math.min(...pricedHere), privatePriceVaries: new Set(pricedHere).size > 1 })
    : privateLabel(professional)
  : "";
const placeHref = (value: PortalWhere) => portalHref(timesPath, { ...keep, onde: WHERE_PARAM[value], date: null, start: null });
const taken = params.get("erro") === "horario";
const unavailableNote = !strip?.unavailable
  ? null
  : unavailableOpen
    ? `${capitalize(formatCalendarDate(strip.unavailable, "EEEE, d 'de' MMMM"))} não tem mais horário livre.${strip.selected > strip.unavailable ? " Mostramos o próximo dia com horário." : ""}`
    : "Não há atendimento nesse dia. Mostramos o próximo dia com horário.";
const notice = "flex items-start gap-2.5 rounded-[14px] border px-4 py-3 text-[17px]";
const specialtyName = professional?.specialties.find((s) => s.id === flow.specialty)?.name ?? null;
const modalityText = modality ? (modality.value === "particular" ? "Particular" : modality.label) : null;
---

<PortalLayout
  title={professional ? `Dia e horário: ${professional.name}` : page.kind === "unavailable" ? "Agendamento indisponível" : "Link não encontrado"}
  brand={page.kind === "open" ? page.portal.brand : page.kind === "unavailable" ? page.brand : null}
  receptionHours={page.kind === "open" ? page.portal.receptionHours : null}
  helpFor={professional ? helpForOf(professional) : null}
  width="wide"
>
  {page.kind === "unavailable" && <PortalNotice kind="unavailable" brand={page.brand} />}
  {page.kind === "not_found" && <PortalNotice kind="not_found" />}
  {page.kind === "open" && !professional && <PortalNotice kind="not_found" brand={page.portal.brand} home={base} />}
  {
    professional && consultation && (
      <form method="GET" action={`${base}/${professional.slug}/continuar`} id="portal-horario" class="grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_320px]">
        <div class="flex min-w-0 flex-col gap-4">
          <PortalStepBar back={back} step={step} />
          <PortalDoctor professional={professional} change={changeDoctor} specialtyId={flow.specialty} atHome={atHome}>
            {modality && (
              <p class="flex items-center justify-between gap-2.5 border-t border-black/10 pt-1 text-base sm:border-gray-100">
                <span>Atendimento: <b>{where && modality.value === "particular" ? "Particular" : modalityLabelAt(modality, whereType || atHome ? consultation.prices[atHome ? "home_visit" : "clinic"] : null)}</b>{modality.detail ? `. ${modality.detail}` : ""}</span>
                {changeModality && <a href={changeModality} class="inline-flex min-h-11 shrink-0 items-center px-1 font-bold text-clinic-ink underline" aria-label="Trocar o atendimento">Trocar</a>}
              </p>
            )}
          </PortalDoctor>
          {Object.entries(keep).map(([name, value]) => value && <input type="hidden" name={name} value={value} />)}
          {professional.exam && <PortalPreparation exam={professional.exam} />}
          {where && (
            <nav aria-labelledby="portal-onde" class="mt-2 flex flex-col gap-3">
              <h2 id="portal-onde" class="font-display text-2xl leading-tight font-bold lg:text-[26px]">Onde será o atendimento?</h2>
              <ul class="flex gap-1 rounded-[14px] bg-gray-100 p-1">
                {(["clinic", "home"] as const).map((value) => (
                  <li class="flex-1">
                    <a
                      href={placeHref(value)}
                      aria-current={value === where ? "true" : undefined}
                      data-portal-onde
                      class={`flex min-h-14 flex-col items-center justify-center rounded-[11px] px-2 text-center text-[17px] leading-tight font-semibold no-underline ${value === where ? "bg-white text-clinic-ink shadow-[0_0_0_1.5px_var(--color-clinic-ink)_inset]" : "text-gray-700 hover:bg-white/60"}`}
                    >
                      <span>{placeLabel[value]}</span>
                      {placePrice(value === "home" ? "home_visit" : "clinic") && <span class="text-[15px] font-normal">{placePrice(value === "home" ? "home_visit" : "clinic")}</span>}
                    </a>
                  </li>
                ))}
              </ul>
              {where === "home" && <p class="text-base text-gray-700">{shortName(professional.name)} vai até o endereço que você informar. O endereço é pedido depois de escolher o paciente.</p>}
            </nav>
          )}
          {!where && atHome && <p class="mt-2 rounded-[14px] border border-gray-200 bg-white px-4 py-3 text-base">Atendimento em casa: {shortName(professional.name)} vai até o endereço que você informar, pedido depois de escolher o paciente.</p>}
          <h1 class="mt-2 font-display text-[30px] leading-[1.1] font-bold tracking-[-0.01em] lg:text-[38px]">{isGroup ? "Escolha o dia" : "Escolha o dia e o horário"}</h1>
          {waitlist && <PortalWaitlistNotice />}
          {consultations.length > 1 && (
            <nav aria-label="Tipo de consulta" class="flex flex-col gap-2">
              <p class="text-base font-semibold text-gray-700">Tipo de consulta</p>
              <ul class="flex flex-wrap gap-2">
                {consultations.map((c) => (
                  <li>
                    <a
                      href={portalHref(timesPath, { ...keep, tipo: c.serviceId })}
                      aria-current={c.serviceId === consultation.serviceId ? "true" : undefined}
                      class={`inline-flex min-h-12 flex-col justify-center rounded-xl border-[1.5px] px-4 py-1.5 leading-tight no-underline ${c.serviceId === consultation.serviceId ? "border-clinic-ink bg-clinic-tint font-bold text-clinic-ink" : "border-gray-300 bg-white text-gray-900 hover:border-clinic-ink"}`}
                    >
                      <span>{c.name}</span>
                      <span class="text-[15px] font-normal text-gray-700">{c.durationMinutes} min{modality?.value === "particular" && (whereType ? c.prices[whereType] : c.priceCents) ? ` · ${formatPrice((whereType ? c.prices[whereType] : c.priceCents)!)}` : ""}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}
          <div id="portal-escolha" class="flex flex-col gap-4" aria-live="polite">
            {blockedUntil && (
              <p class={`${notice} border-amber-200 bg-amber-50 text-amber-900`} role="alert">
                Muitas consultas em pouco tempo. Tente de novo {blockedText(blockedUntil)} ou toque em "Recepção", no topo, para falar com a clínica.
              </p>
            )}
            {taken && (
              <p class={`${notice} border-red-200 bg-red-50 text-red-800`} role="alert">Esse horário acabou de ser ocupado por outra pessoa. Escolha outro.</p>
            )}
            {unavailableNote && <p class={`${notice} border-amber-200 bg-amber-50 text-amber-900`} role="status">{unavailableNote}</p>}
            {blockedUntil ? null : isGroup && slotOptions.length ? (
              <>
                <p class="text-base text-gray-600">O exame é feito em grupo, no horário marcado. Só aparecem os dias com vaga.</p>
                {params.get("date") && <input type="hidden" name="date" value={params.get("date")!} />}
                <PatientSlots options={slotOptions} sessions />
                {groupMore && (
                  <a href={portalHref(timesPath, { ...keep, mais: String(groupShown + GROUP_PAGE) })} class="flex min-h-[52px] items-center justify-center rounded-xl border-[1.5px] border-gray-300 bg-white font-bold text-clinic-ink no-underline hover:border-clinic-ink">
                    Ver mais dias
                  </a>
                )}
              </>
            ) : strip && strip.selected ? (
              <>
                <p class="text-base text-gray-600">Só aparecem os dias com horário livre.</p>
                <input type="hidden" name="date" value={strip.selected} />
                <PatientDayStrip strip={strip} title="Dias com horário" href={dayHref} />
                <p class="mt-1 font-display text-[21px] font-bold lg:text-[22px]">{capitalize(formatCalendarDate(strip.selected, "EEEE, d 'de' MMMM"))}</p>
                {slotOptions.length ? (
                  <PatientSlots options={slotOptions} />
                ) : (
                  <p class="text-base text-gray-600">Nenhum horário livre nesse dia. Escolha outro dia.</p>
                )}
              </>
            ) : (
              <div class="flex flex-col gap-3 rounded-[14px] border border-gray-200 bg-white px-4 py-4" role="status">
                <p>Sem horários nos próximos {professional.horizonDays} dias. Toque em "Recepção", no topo, para falar com a clínica.</p>
                {changeDoctor && <a href={changeDoctor} class="self-start font-semibold text-clinic-ink">{professional.exam ? "Ver outro exame" : "Ver outro médico"}</a>}
              </div>
            )}
          </div>
          <div class="mt-2 grid gap-3 lg:grid-cols-2">
            {professional.orientation && (
              <div class="flex flex-col gap-1 rounded-[14px] border border-gray-200 bg-white px-4 py-3.5">
                <p class="text-[15px] text-gray-600">Orientações {ofName(shortName(professional.name))}</p>
                <p class="text-[17px] whitespace-pre-line">{professional.orientation}</p>
              </div>
            )}
            <details class="self-start rounded-[14px] border border-gray-200 bg-white px-4">
              <summary class="flex min-h-[52px] cursor-pointer items-center font-bold text-clinic-ink">Ver valores e convênios aceitos</summary>
              <p class="pb-3.5 text-base">
                {professional.acceptsPrivate ? `${privateHere}.` : professional.exam ? "Não aceita particular." : "Não atende particular."}
                {professional.plans.length > 0 && ` ${professional.plans.map((p) => p.name).join(", ")}.`}
              </p>
            </details>
          </div>
          <div class="sticky bottom-0 -mx-4 mt-4 flex items-center justify-between gap-3 border-t border-gray-200 bg-white px-4 pt-3 pb-[max(14px,env(safe-area-inset-bottom))] sm:-mx-6 sm:px-6 lg:hidden">
            <p class="min-w-0 text-base leading-tight">
              <span class="block text-gray-600">Escolhido</span>
              <b class="block truncate text-lg" data-portal-slot>Escolha um horário</b>
            </p>
            <button type="submit" class="min-h-14 shrink-0 rounded-xl bg-clinic px-6 text-[19px] font-bold text-clinic-text hover:opacity-90 disabled:opacity-45" data-portal-continue disabled={!slotOptions.length}>Continuar</button>
          </div>
        </div>
        <PortalSummary
          rows={[
            ...(specialtyName ? [{ label: "Especialidade", value: specialtyName }] : []),
            { label: whoLabel(professional), value: professional.name, change: changeDoctor },
            { label: "Atendimento", value: modalityText, detail: modality?.detail, change: changeModality },
            ...(atHome ? [{ label: "Onde", value: "Em casa" }] : []),
            { label: "Dia e horário", value: null, live: "slot" },
          ]}
        >
          <button type="submit" class="mt-3 min-h-14 rounded-xl bg-clinic px-6 text-[19px] font-bold text-clinic-text hover:opacity-90 disabled:opacity-45" data-portal-continue disabled={!slotOptions.length}>Continuar</button>
        </PortalSummary>
      </form>
    )
  }
</PortalLayout>

<script>
  // O horário escolhido vai para a barra e o resumo; um dia ou uma seta troca só a parte dos horários (sem
  // recarregar); "Continuar" sem horário avisa no próprio campo.
  const area = document.getElementById("portal-escolha");
  const form = document.getElementById("portal-horario") as HTMLFormElement | null;
  const EMPTY = "Escolha um horário";
  const refresh = () => {
    const chosen = area?.querySelector<HTMLInputElement>('input[name="start"]:checked');
    document.querySelectorAll<HTMLElement>("[data-portal-slot], [data-portal-live=slot]").forEach((el) => {
      el.textContent = chosen?.dataset.summary ?? (el.dataset.portalLive ? "a escolher" : EMPTY);
      el.classList.toggle("italic", !chosen && !!el.dataset.portalLive);
    });
    const hasOptions = !!area?.querySelector('input[name="start"]');
    document.querySelectorAll<HTMLButtonElement>("[data-portal-continue]").forEach((b) => (b.disabled = !hasOptions));
  };
  area?.addEventListener("change", refresh);
  area?.addEventListener("click", async (event) => {
    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>("a[data-agendar-nav]");
    if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return;
    event.preventDefault();
    area.setAttribute("aria-busy", "true");
    area.classList.add("opacity-60");
    try {
      const response = await fetch(link.href, { headers: { Accept: "text/html" } });
      if (!response.ok) throw new Error(String(response.status));
      const next = new DOMParser().parseFromString(await response.text(), "text/html").getElementById("portal-escolha");
      if (!next) throw new Error("sem os horários");
      area.replaceChildren(...Array.from(next.childNodes));
      history.replaceState(null, "", link.href);
      area.querySelector<HTMLElement>('[aria-current="date"]')?.focus();
    } catch {
      window.location.href = link.href;
      return;
    } finally {
      area.removeAttribute("aria-busy");
      area.classList.remove("opacity-60");
    }
    refresh();
  });
  form?.addEventListener("submit", (event) => {
    const first = area?.querySelector<HTMLInputElement>('input[name="start"]');
    if (first && !area?.querySelector('input[name="start"]:checked')) {
      event.preventDefault();
      first.reportValidity();
    }
  });
  refresh();
</script>

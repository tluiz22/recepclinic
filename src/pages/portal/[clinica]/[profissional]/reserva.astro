---
// Horário reservado (F2b; proposta 7.3, RD4): depois do celular comprovado, o horário fica guardado para esta sessão
// pelo prazo da clínica (padrão 5 min), com o contador visível e anunciado no último minuto. Quem será atendido, a
// revisão e a marcação (P8 a P10) chegam na F2c: até lá, esta tela leva o pedido à recepção pelo WhatsApp. O Voltar
// solta a reserva; vencida, ela deixa de contar sozinha.
import PortalLayout from "../../../../components/portal/PortalLayout.astro";
import PortalNotice from "../../../../components/portal/PortalNotice.astro";
import PortalStepBar from "../../../../components/portal/PortalStepBar.astro";
import { capitalize } from "../../../../lib/vocabulary";
import { formatInstant } from "../../../../lib/clinicTime";
import { openPortalPage, professionalOf } from "../../../../lib/data/portal/page";
import { activeHold, readSession, type ActiveHold, type PortalSession } from "../../../../lib/data/portal/identity";
import { formatPhoneBR } from "../../../../lib/phone";
import { chosenModality, flowParams, modalityOptions, ofName, portalHref, professionalSteps, readFlow, receptionWhatsappHref, stepPosition } from "../../../../lib/portal";
import { clock } from "../../../../lib/portalIdentity";

const page = await openPortalPage(Astro);
const professional = page.kind === "open" ? professionalOf(page.portal, Astro.params.profissional) : null;
if (!professional && page.kind !== "unavailable") Astro.response.status = 404;
const params = Astro.url.searchParams;
const flow = readFlow(params);
const base = page.kind === "open" ? page.base : "";
const options = professional ? modalityOptions(professional) : [];
const modality = chosenModality(options, params.get("mod"));
const keep = { ...flowParams(flow), mod: modality?.value ?? null, tipo: params.get("tipo") };
const timesPath = professional ? `${base}/${professional.slug}/horarios` : "";
const holdId = params.get("reserva") ?? "";

let session: PortalSession | null = null;
let hold: ActiveHold | null = null;
if (page.kind === "open" && professional && /^[0-9a-f-]{36}$/.test(holdId)) {
  session = await readSession(page.db, page.portal.clinicId, Astro.cookies);
  if (session) hold = await activeHold(page.db, page.portal.clinicId, session.id, holdId);
  // A reserva é deste profissional (o endereço pode ter sido trocado à mão).
  if (hold && hold.agendaId !== professional.agendaId) hold = null;
}
const timeZone = page.kind === "open" ? page.portal.timeZone : "America/Fortaleza";
const consultation = professional && hold ? (professional.consultations.find((c) => c.serviceId === hold!.serviceId) ?? null) : null;
const location = professional && hold ? (professional.locations.find((l) => l.id === hold!.locationId) ?? null) : null;
const when = hold ? capitalize(formatInstant(hold.start, timeZone, "EEEE, d 'de' MMMM 'às' HH:mm")) : "";
const secondsLeft = hold ? Math.max(0, Math.floor((hold.expiresAt.getTime() - Date.now()) / 1000)) : 0;
// Voltar: os horários do mesmo dia, soltando a reserva.
const back = portalHref(timesPath, { ...keep, date: params.get("date"), soltar: "1" });
const step = stepPosition(professionalSteps(flow, options.length > 1), "patient");
const phone = page.kind === "open" ? page.portal.brand.whatsappPhone : null;
const request =
  professional && hold
    ? `Olá! Reservei um horário no portal: ${consultation?.name ?? "consulta"} com ${professional.name}, ${when.toLowerCase()} (${modality?.value === "particular" ? "particular" : (modality?.label ?? "")}). Pode marcar para mim?`
    : "";
const row = "flex flex-col gap-px border-b border-gray-100 py-2.5 last:border-b-0";
---

<PortalLayout
  title={hold ? "Horário reservado" : professional ? "A reserva acabou" : page.kind === "unavailable" ? "Agendamento indisponível" : "Link não encontrado"}
  brand={page.kind === "open" ? page.portal.brand : page.kind === "unavailable" ? page.brand : null}
  receptionHours={page.kind === "open" ? page.portal.receptionHours : null}
  helpFor={professional ? ofName(professional.name) : null}
>
  {page.kind === "unavailable" && <PortalNotice kind="unavailable" brand={page.brand} />}
  {page.kind === "not_found" && <PortalNotice kind="not_found" />}
  {page.kind === "open" && !professional && <PortalNotice kind="not_found" brand={page.portal.brand} home={base} />}
  {
    professional && !hold && (
      <div class="flex flex-col gap-5">
        <PortalStepBar back={portalHref(timesPath, { ...keep, date: params.get("date") })} />
        <h1 class="font-display text-[30px] leading-[1.1] font-bold tracking-[-0.01em]">O tempo da reserva acabou</h1>
        <p class="text-lg text-gray-700">O horário foi liberado. Escolha o horário de novo: se ainda estiver livre, ele aparece na lista.</p>
        <a href={portalHref(timesPath, { ...keep, date: params.get("date") })} class="flex min-h-14 items-center justify-center rounded-xl bg-clinic px-5 text-[19px] font-bold text-clinic-text no-underline hover:opacity-90 sm:max-w-[360px]">
          Ver os horários
        </a>
      </div>
    )
  }
  {
    professional && hold && (
      <div class="flex flex-col gap-5" data-portal-hold data-seconds={secondsLeft} data-expired-href={portalHref(`${base}/${professional.slug}/reserva`, { ...keep, date: params.get("date"), reserva: hold.id })}>
        <PortalStepBar back={back} step={step} />
        <p class="flex items-center gap-2.5 self-start rounded-full bg-clinic-tint px-4 py-2 text-[17px] font-semibold text-clinic-ink">
          <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
          <span>Reservamos este horário por <span class="tabular-nums" data-portal-hold-clock>{clock(secondsLeft)}</span></span>
        </p>
        <p class="sr-only" aria-live="assertive" data-portal-hold-alert></p>
        <h1 class="font-display text-[30px] leading-[1.1] font-bold tracking-[-0.01em]">Horário reservado</h1>
        <dl class="flex flex-col rounded-2xl border border-gray-200 bg-white px-4 py-1.5 sm:px-5">
          <div class={row}><dt class="text-[15px] text-gray-600">Dia e horário</dt><dd class="text-lg font-bold">{when}</dd></div>
          <div class={row}><dt class="text-[15px] text-gray-600">Com quem</dt><dd>{professional.name}</dd></div>
          <div class={row}><dt class="text-[15px] text-gray-600">Atendimento</dt><dd>{modality?.label}</dd></div>
          {location?.address && <div class={row}><dt class="text-[15px] text-gray-600">Onde</dt><dd>{location.address}</dd></div>}
          {session?.phone && <div class={row}><dt class="text-[15px] text-gray-600">Celular confirmado</dt><dd>{formatPhoneBR(session.phone)}</dd></div>}
        </dl>
        <p class="rounded-[14px] border border-amber-200 bg-amber-50 px-4 py-3 text-[17px] text-amber-900" role="status">
          O horário ainda não está marcado. Nesta versão de teste, a marcação pelo portal não está pronta: envie o pedido à recepção pelo WhatsApp.
        </p>
        {phone && (
          <a href={receptionWhatsappHref(phone, request)} target="_blank" rel="noopener" class="flex min-h-14 items-center justify-center rounded-xl bg-clinic px-5 text-[19px] font-bold text-clinic-text no-underline hover:opacity-90 sm:max-w-[420px]">
            Pedir este horário no WhatsApp
          </a>
        )}
      </div>
    )
  }
</PortalLayout>

<script>
  // Contador da reserva: aviso no último minuto (leitores de tela) e, no fim, a tela "acabou" (recarrega).
  const box = document.querySelector<HTMLElement>("[data-portal-hold]");
  const clockEl = box?.querySelector<HTMLElement>("[data-portal-hold-clock]");
  const alertEl = box?.querySelector<HTMLElement>("[data-portal-hold-alert]");
  let left = Number(box?.dataset.seconds ?? 0);
  if (box && clockEl && left > 0) {
    const started = Date.now();
    const total = left;
    const timer = setInterval(() => {
      left = Math.max(0, total - Math.floor((Date.now() - started) / 1000));
      clockEl.textContent = `${Math.floor(left / 60)}:${String(left % 60).padStart(2, "0")}`;
      if (left === 60 && alertEl) alertEl.textContent = "Falta 1 minuto para a reserva acabar.";
      if (left <= 0) {
        clearInterval(timer);
        window.location.href = box.dataset.expiredHref ?? window.location.href;
      }
    }, 1000);
  }
</script>

---
// P7 Celular e código (F2b; proposta 5.1, RD2, RD9). Depois do "Continuar" da P6: o horário é conferido de novo
// (ocupado: volta aos horários do mesmo dia, com o aviso). Com o celular já comprovado nesta sessão, reserva o horário
// e segue. Senão: "Qual é o seu celular com WhatsApp?" com o CAPTCHA (Turnstile) → código de 6 números pelo WhatsApp
// da clínica → reserva do horário (prazo da clínica, padrão 5 min) → tela da reserva. Limites de uso e bloqueio
// progressivo no servidor. Formulários POST nesta mesma página (o endereço do portal não abre o /api).
import PortalLayout from "../../../../components/portal/PortalLayout.astro";
import PortalNotice from "../../../../components/portal/PortalNotice.astro";
import PortalStepBar from "../../../../components/portal/PortalStepBar.astro";
import PortalSummary from "../../../../components/portal/PortalSummary.astro";
import { capitalize } from "../../../../lib/vocabulary";
import { formatInstant } from "../../../../lib/clinicTime";
import { parseSlotChoice } from "../../../../lib/data/agenda/publicBooking";
import { createClinicSender } from "../../../../lib/data/whatsapp/send";
import { publicBaseUrl } from "../../../../lib/data/whatsapp/clinicSender";
import { openPortalPage, professionalOf } from "../../../../lib/data/portal/page";
import { isSlotStillFree } from "../../../../lib/data/portal/portal";
import {
  ensureSession,
  forgetPhone,
  hitLimits,
  holdSlot,
  pendingCode,
  readSession,
  sendCode,
  verifyCode,
  type PendingCode,
  type SendCodeResult,
} from "../../../../lib/data/portal/identity";
import { platformEnv } from "../../../../lib/env";
import { formatPhoneBR, normalizePhone } from "../../../../lib/phone";
import { changeProfessionalHref, chosenModality, flowParams, modalityOptions, ofName, portalHref, professionalSteps, readFlow, stepPosition } from "../../../../lib/portal";
import { blockedText, cleanCode, clock, ipPrefix, LIMITS, phoneEnding, resendWaitSeconds } from "../../../../lib/portalIdentity";
import { TURNSTILE_SCRIPT, verifyTurnstile } from "../../../../lib/turnstile";

const page = await openPortalPage(Astro);
const professional = page.kind === "open" ? professionalOf(page.portal, Astro.params.profissional) : null;
if (!professional && page.kind !== "unavailable") Astro.response.status = 404;
const params = Astro.url.searchParams;
const flow = readFlow(params);
const base = page.kind === "open" ? page.base : "";
const options = professional ? modalityOptions(professional) : [];
const modality = chosenModality(options, params.get("mod"));
const choice = parseSlotChoice(params.get("start"));
const consultation = professional ? (professional.consultations.find((c) => c.serviceId === params.get("tipo")) ?? professional.consultations[0]) : null;
const timesPath = professional ? `${base}/${professional.slug}/horarios` : "";
const keep = { ...flowParams(flow), mod: modality?.value ?? null, tipo: params.get("tipo") };
const here = portalHref(`${base}/${professional?.slug ?? ""}/continuar`, { ...keep, date: params.get("date"), start: params.get("start") });
const timeZone = page.kind === "open" ? page.portal.timeZone : "America/Fortaleza";
// No computador local (npm run dev), sem WhatsApp de verdade, o código aparece na tela. Nunca no build.
const devMode = import.meta.env.DEV;
const turnstile = platformEnv().turnstile;
const clientIp = (() => {
  try {
    return Astro.clientAddress;
  } catch {
    return Astro.request.headers.get("x-forwarded-for");
  }
})();
const ip = ipPrefix(clientIp);

type Problem = { field: "phone" | "code" | "page"; text: string };
let problem: Problem | null = null;
let typedPhone = "";
let blockedUntil: Date | null = null;
let pending: PendingCode | null = null;
let devCode: string | null = devMode ? params.get("dev") : null;
let unavailable = false;

if (page.kind === "open" && professional && consultation) {
  const { db, portal } = page;
  const clinicId = portal.clinicId;
  let session = await readSession(db, clinicId, Astro.cookies);
  const free =
    !!choice &&
    !!modality &&
    choice.agendaId === professional.agendaId &&
    (await isSlotStillFree(db, clinicId, professional, { serviceId: consultation.serviceId, locationId: choice.locationId, start: choice.start }, timeZone, new Date(), session?.id ?? null));
  if (!free) return Astro.redirect(portalHref(timesPath, { ...keep, date: params.get("date"), erro: choice ? "horario" : null }));

  const slot = {
    agendaId: professional.agendaId,
    serviceId: consultation.serviceId,
    locationId: choice!.locationId,
    start: choice!.start,
    end: new Date(choice!.start.getTime() + consultation.durationMinutes * 60_000),
  };
  // Celular comprovado: reserva e segue para a tela da reserva.
  const reserve = async (sessionId: string): Promise<Response | null> => {
    const blocked = await hitLimits(db, clinicId, [[`ip:${ip}`, LIMITS.holdPerIp]]);
    if (blocked) {
      blockedUntil = blocked;
      return null;
    }
    const hold = await holdSlot(db, clinicId, sessionId, slot);
    if (hold.status === "ok") return Astro.redirect(portalHref(`${base}/${professional.slug}/reserva`, { ...keep, date: params.get("date"), reserva: hold.holdId }));
    if (hold.status === "taken") return Astro.redirect(portalHref(timesPath, { ...keep, date: params.get("date"), erro: "horario" }));
    problem = {
      field: "page",
      text: hold.status === "limit" ? "Este celular já reservou muitos horários hoje. Para marcar, fale com a recepção." : "Confirme o seu celular de novo.",
    };
    return null;
  };
  const afterSend = (sent: SendCodeResult, field: "phone" | "code"): Response | null => {
    if (sent.status === "sent") return Astro.redirect(sent.devCode ? `${here}&dev=${sent.devCode}` : here);
    if (sent.status === "wait") problem = { field, text: `Já mandamos um código. Você pode pedir outro em ${clock(sent.seconds)}.` };
    if (sent.status === "blocked") blockedUntil = sent.until;
    if (sent.status === "unavailable") unavailable = true;
    return null;
  };
  const sender = () => createClinicSender(db, clinicId, { baseUrl: publicBaseUrl(Astro.url) }).catch(() => null);

  if (Astro.request.method === "POST") {
    const form = await Astro.request.formData().catch(() => null);
    const action = String(form?.get("acao") ?? "");
    if (action === "enviar") {
      typedPhone = String(form?.get("celular") ?? "").slice(0, 30);
      const phone = normalizePhone(typedPhone);
      if (!phone || !/^\+55\d{2}9\d{8}$/.test(phone)) {
        problem = { field: "phone", text: "Confira o DDD e o número do celular." };
      } else if (!turnstile && !devMode) {
        unavailable = true;
      } else if (turnstile && !(await verifyTurnstile(turnstile.secretKey, String(form?.get("cf-turnstile-response") ?? ""), clientIp))) {
        problem = { field: "phone", text: "Não conseguimos confirmar que você não é um robô. Tente de novo." };
      } else {
        session = await ensureSession(db, clinicId, Astro.cookies, { ip, secure: Astro.url.protocol === "https:" });
        const next = afterSend(await sendCode(db, clinicId, session, phone, { ip, sender: await sender(), devMode }), "phone");
        if (next) return next;
      }
    } else if (session && action === "reenviar") {
      const current = await pendingCode(db, clinicId, session.id);
      if (current) {
        const next = afterSend(await sendCode(db, clinicId, session, current.phone, { ip, sender: await sender(), devMode }), "code");
        if (next) return next;
      }
    } else if (session && action === "codigo") {
      const code = cleanCode(String(form?.get("codigo") ?? ""));
      if (!code) {
        problem = { field: "code", text: "Digite os 6 números do código." };
      } else {
        const blocked = await hitLimits(db, clinicId, [
          [`ip:${ip}`, LIMITS.verifyPerIp],
          [`session:${session.id}`, LIMITS.verifyPerSession],
        ]);
        const result = blocked ? null : await verifyCode(db, clinicId, session, code);
        if (!result) {
          blockedUntil = blocked;
        } else if (result.status === "ok") {
          // O celular já está comprovado nesta sessão (se a reserva não sair agora, a página não pede o código de novo).
          session = { ...session, phone: result.phone, verified: true };
          const next = await reserve(session.id);
          if (next) return next;
        } else if (result.status === "wrong") {
          problem = { field: "code", text: `Código incorreto. ${result.attemptsLeft === 1 ? "Resta 1 tentativa." : `Restam ${result.attemptsLeft} tentativas.`}` };
        } else {
          problem = { field: "page", text: result.status === "expired" ? "O código venceu. Digite o celular de novo para receber outro." : "Muitas tentativas com este código. Digite o celular de novo para receber outro." };
        }
      }
    } else if (session && action === "trocar") {
      await forgetPhone(db, clinicId, session.id);
      return Astro.redirect(here);
    }
  } else if (session?.verified) {
    const next = await reserve(session.id);
    if (next) return next;
  }
  if (session && !session.verified) pending = await pendingCode(db, clinicId, session.id);
  if (!pending) devCode = null;
}

const when = choice ? `${capitalize(formatInstant(choice.start, timeZone, "EEE")).slice(0, 3)}, ${formatInstant(choice.start, timeZone, "dd/MM 'às' HH:mm")}` : "";
const back = portalHref(timesPath, { ...keep, date: params.get("date") });
const step = stepPosition(professionalSteps(flow, options.length > 1), "phone");
const changeDoctor = changeProfessionalHref(base, flow);
const changeModality = options.length > 1 && professional ? portalHref(`${base}/${professional.slug}/atendimento`, { ...flowParams(flow), mod: modality?.value }) : null;
const waitSeconds = pending ? resendWaitSeconds(pending.sentAt) : 0;
const input =
  "min-h-14 w-full rounded-xl border-[1.5px] border-gray-300 bg-white px-3.5 text-xl text-gray-900 focus:border-clinic-ink focus:outline-none focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-clinic-ink aria-[invalid=true]:border-red-700";
const cta = "flex min-h-[58px] w-full items-center justify-center rounded-xl bg-clinic px-6 text-[19px] font-bold text-clinic-text hover:opacity-90 disabled:opacity-45 sm:w-auto sm:min-w-[260px]";
const link = "inline-flex min-h-11 items-center px-1 text-base font-bold text-clinic-ink underline";
const errorText = "text-base font-semibold text-red-700";
const notice = "rounded-[14px] border px-4 py-3 text-[17px]";
---

<PortalLayout
  title={professional ? (pending ? "Digite o código" : "Seu celular com WhatsApp") : page.kind === "unavailable" ? "Agendamento indisponível" : "Link não encontrado"}
  brand={page.kind === "open" ? page.portal.brand : page.kind === "unavailable" ? page.brand : null}
  receptionHours={page.kind === "open" ? page.portal.receptionHours : null}
  helpFor={professional ? ofName(professional.name) : null}
  width="wide"
>
  {page.kind === "unavailable" && <PortalNotice kind="unavailable" brand={page.brand} />}
  {page.kind === "not_found" && <PortalNotice kind="not_found" />}
  {page.kind === "open" && !professional && <PortalNotice kind="not_found" brand={page.portal.brand} home={base} />}
  {
    professional && choice && (
      <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_320px]">
        <div class="flex min-w-0 flex-col gap-[18px]">
          <PortalStepBar back={back} step={step} />
          <p class="-mx-4 flex items-center justify-between gap-2.5 bg-clinic-tint px-4 py-1.5 text-base leading-snug sm:mx-0 sm:rounded-xl lg:hidden">
            <span>
              <b>{professional.name}</b>, {modality?.label}
              <br />
              {when}
            </span>
            <a href={back} class={link} aria-label="Trocar o horário">Trocar</a>
          </p>
          <h1 class="font-display text-[30px] leading-[1.1] font-bold tracking-[-0.01em] lg:text-[38px]">Qual é o seu celular com WhatsApp?</h1>

          {blockedUntil && (
            <p class={`${notice} border-amber-200 bg-amber-50 text-amber-900`} role="alert">
              Muitas tentativas. Tente de novo {blockedText(blockedUntil)} ou toque em "Recepção", no topo, para falar com a clínica.
            </p>
          )}
          {unavailable && (
            <p class={`${notice} border-amber-200 bg-amber-50 text-amber-900`} role="alert">
              Não conseguimos mandar o código agora. Toque em "Recepção", no topo, para marcar com a clínica.
            </p>
          )}
          {problem?.field === "page" && <p class={`${notice} border-red-200 bg-red-50 text-red-800`} role="alert">{problem.text}</p>}

          {pending ? (
            <>
              <form method="POST" action={here} class="flex max-w-[460px] flex-col gap-1.5">
                <label for="celular-fixo" class="text-base font-semibold text-gray-700">Celular com DDD</label>
                <div class="flex items-center gap-2.5">
                  <input id="celular-fixo" type="text" value={formatPhoneBR(pending.phone)} readonly class={input.replace("bg-white", "bg-gray-100").replace("text-gray-900", "text-gray-700")} />
                  <input type="hidden" name="acao" value="trocar" />
                  <button type="submit" class={`${link} whitespace-nowrap`}>Trocar número</button>
                </div>
              </form>
              <form method="POST" action={here} class="flex max-w-[680px] flex-col gap-2.5 rounded-2xl border border-gray-200 bg-white p-4 sm:p-5">
                <input type="hidden" name="acao" value="codigo" />
                <p class="text-[17px]">Mandamos um código de 6 números no WhatsApp do celular {phoneEnding(pending.phone)}. Abra a conversa e digite o código aqui.</p>
                {devCode && (
                  <p class="rounded-lg border border-dashed border-gray-400 bg-gray-50 px-3 py-2 text-[15px] text-gray-700">
                    Só no computador local (sem WhatsApp de verdade): o código é <b>{devCode}</b>.
                  </p>
                )}
                <label for="codigo" class="text-base font-semibold text-gray-700">Código</label>
                <input
                  id="codigo"
                  name="codigo"
                  type="text"
                  inputmode="numeric"
                  autocomplete="one-time-code"
                  maxlength="9"
                  required
                  placeholder="000000"
                  aria-invalid={problem?.field === "code" ? "true" : undefined}
                  aria-describedby={problem?.field === "code" ? "codigo-erro" : undefined}
                  autofocus
                  class={`${input} max-w-[260px] text-center font-display text-[28px] font-bold tracking-[0.4em]`}
                />
                {problem?.field === "code" && <p id="codigo-erro" class={errorText} role="alert">{problem.text}</p>}
                <button type="submit" class={`${cta} mt-2`} data-sending-label="Conferindo…">Confirmar código</button>
              </form>
              <form method="POST" action={here} class="flex items-center gap-2">
                <input type="hidden" name="acao" value="reenviar" />
                <p class="text-base text-gray-600" data-portal-resend-wait hidden={waitSeconds === 0} aria-live="polite">
                  Reenviar código em <span data-portal-resend-clock data-seconds={waitSeconds}>{clock(waitSeconds)}</span>
                </p>
                <button type="submit" class={link} data-portal-resend hidden={waitSeconds > 0}>Reenviar código</button>
              </form>
            </>
          ) : (
            <form method="POST" action={here} class="flex max-w-[460px] flex-col gap-3">
              <input type="hidden" name="acao" value="enviar" />
              <div class="flex flex-col gap-1.5">
                <label for="celular" class="text-base font-semibold text-gray-700">Celular com DDD</label>
                <input
                  id="celular"
                  name="celular"
                  type="tel"
                  inputmode="numeric"
                  autocomplete="tel"
                  required
                  value={typedPhone}
                  placeholder="(84) 99999-9999"
                  aria-invalid={problem?.field === "phone" ? "true" : undefined}
                  aria-describedby={problem?.field === "phone" ? "celular-erro celular-ajuda" : "celular-ajuda"}
                  class={input}
                />
                {problem?.field === "phone" && <p id="celular-erro" class={errorText} role="alert">{problem.text}</p>}
                <p id="celular-ajuda" class="text-[15px] text-gray-600">Vamos mandar um código de 6 números no WhatsApp deste celular.</p>
              </div>
              {turnstile && <div class="cf-turnstile" data-sitekey={turnstile.siteKey} data-language="pt-br" data-size="flexible" />}
              <button type="submit" class={`${cta} mt-1`} data-sending-label="Enviando…">Receber código no WhatsApp</button>
            </form>
          )}
          <p class="text-[15px] text-gray-600">
            Usamos seu número só para o agendamento.{" "}
            <a href="https://www.recepclinic.com.br/privacidade" target="_blank" rel="noopener" class="font-semibold text-clinic-ink">Privacidade</a>
          </p>
        </div>
        <PortalSummary
          rows={[
            { label: "Médico", value: professional.name, change: changeDoctor },
            { label: "Atendimento", value: modality?.label ?? null, change: changeModality },
            { label: "Dia e horário", value: when, change: back },
          ]}
        />
      </div>
    )
  }
  {turnstile && !pending && professional && <script is:inline src={TURNSTILE_SCRIPT} async defer />}
</PortalLayout>

<script>
  // "Reenviar código em 0:59": o contador e, no fim, o botão.
  const clockEl = document.querySelector<HTMLElement>("[data-portal-resend-clock]");
  const wait = document.querySelector<HTMLElement>("[data-portal-resend-wait]");
  const resend = document.querySelector<HTMLElement>("[data-portal-resend]");
  let left = Number(clockEl?.dataset.seconds ?? 0);
  if (clockEl && left > 0) {
    const timer = setInterval(() => {
      left -= 1;
      clockEl.textContent = `${Math.floor(left / 60)}:${String(left % 60).padStart(2, "0")}`;
      if (left <= 0) {
        clearInterval(timer);
        if (wait) wait.hidden = true;
        if (resend) resend.hidden = false;
      }
    }, 1000);
  }
</script>

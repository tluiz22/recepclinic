---
// Retorno, passo 1 (F2d; D4; canvas RT2, DRT2 e RT5). Sem o celular comprovado nesta sessão: "Qual é o seu celular com
// WhatsApp?" e o código (o mesmo da P7). Depois: "De qual consulta é o retorno?", um cartão por consulta com direito
// (paciente, médico, data, "Retorno até…") e, embaixo, as consultas sem direito com o motivo. Uma só com direito: vai
// direto aos horários. Nenhuma: o motivo principal (como o bot), e no prazo vencido "Agendar consulta com {médico}".
import PortalLayout from "../../../../components/portal/PortalLayout.astro";
import PortalChangePhone from "../../../../components/portal/PortalChangePhone.astro";
import PortalNotice from "../../../../components/portal/PortalNotice.astro";
import PortalPhoneCode from "../../../../components/portal/PortalPhoneCode.astro";
import PortalStepBar from "../../../../components/portal/PortalStepBar.astro";
import { formatInstant } from "../../../../lib/clinicTime";
import { runIdentityStep, type IdentityState } from "../../../../lib/data/portal/identityStep";
import { openPortalPage } from "../../../../lib/data/portal/page";
import { loadReturnOptions, type ReturnOptions } from "../../../../lib/data/portal/returnVisit";
import { portalHref, receptionWhatsappHref, toName, withName } from "../../../../lib/portal";
import { phoneEnding } from "../../../../lib/portalIdentity";
import { consultationOn, dayMonth, mainRefusal, refusalText, returnButton, returnUntil } from "../../../../lib/portalReturn";

const page = await openPortalPage(Astro);
if (page.kind === "not_found") Astro.response.status = 404;
const base = page.kind === "open" ? page.base : "";
const here = `${base}/retorno`;
const timeZone = page.kind === "open" ? page.portal.timeZone : "America/Fortaleza";

let identity: IdentityState | null = null;
let options: ReturnOptions | null = null;
let phone: string | null = null;
if (page.kind === "open") {
  const { db, portal } = page;
  identity = await runIdentityStep(Astro, {
    db,
    clinicId: portal.clinicId,
    here,
    // Código conferido: abre a lista (GET), para o Voltar e o recarregar não reenviarem o formulário.
    onVerified: async () => (Astro.request.method === "POST" ? Astro.redirect(here) : null),
  });
  if (identity.response) return identity.response;
  if (identity.session?.verified && identity.session.phone) {
    phone = identity.session.phone;
    options = await loadReturnOptions(db, portal, phone);
    // Sem o serviço de retorno com médicos do portal: o início (o botão nem aparece).
    if (!options.offered) return Astro.redirect(base || "/");
    if (options.cards.length === 1 && Astro.url.searchParams.get("aviso") !== "mudou") return Astro.redirect(portalHref(`${base}/retorno/horarios`, { consulta: options.cards[0].originId, unica: "1" }));
  }
}

// Voltou da revisão porque o retorno deixou de ter direito no meio do caminho (outro canal marcou, a consulta mudou).
const changed = Astro.url.searchParams.get("aviso") === "mudou";
const changedNotice = "Não foi possível marcar: esse retorno não está mais disponível pelo portal. Veja abaixo ou fale com a recepção.";
const refusal = options && !options.cards.length ? mainRefusal(options.refusals) : null;
const waPhone = page.kind === "open" ? page.portal.brand.whatsappPhone : null;
const waHref = waPhone ? receptionWhatsappHref(waPhone, "Olá! Quero marcar um retorno e preciso de ajuda.") : null;
const title = !options ? "Seu celular com WhatsApp" : options.cards.length ? "De qual consulta é o retorno?" : refusal?.kind === "expired" ? "O prazo do retorno acabou" : "Retorno";
const cta = "flex min-h-[54px] w-full items-center justify-center rounded-xl bg-clinic px-6 text-lg font-bold text-clinic-text no-underline hover:opacity-90";
const ctaWide = "flex min-h-[58px] w-full items-center justify-center rounded-xl bg-clinic px-6 text-center text-[19px] font-bold text-clinic-text no-underline hover:opacity-90 sm:max-w-[420px]";
const secondary = "flex min-h-14 w-full items-center justify-center gap-2.5 rounded-xl border-[1.5px] border-clinic-ink bg-white px-6 text-lg font-bold text-clinic-ink no-underline sm:max-w-[420px]";
const waIcon = "M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 20.5l1.6-5.4A8.5 8.5 0 1 1 21 11.5z";
---

<PortalLayout
  title={page.kind === "not_found" ? "Link não encontrado" : page.kind === "unavailable" ? "Agendamento indisponível" : title}
  brand={page.kind === "open" ? page.portal.brand : page.kind === "unavailable" ? page.brand : null}
  receptionHours={page.kind === "open" ? page.portal.receptionHours : null}
  width="wide"
>
  {page.kind === "unavailable" && <PortalNotice kind="unavailable" brand={page.brand} />}
  {page.kind === "not_found" && <PortalNotice kind="not_found" />}
  {
    page.kind === "open" && identity && !options && (
      <div class="flex max-w-[680px] flex-col gap-[18px]">
        <PortalStepBar back={base || "/"} />
        <h1 class="font-display text-[30px] leading-[1.1] font-bold tracking-[-0.01em] lg:text-[38px]">Qual é o seu celular com WhatsApp?</h1>
        <p class="text-[17px] text-gray-700">Mostramos as consultas deste celular que dão direito a retorno.</p>
        <PortalPhoneCode state={identity} action={here} />
      </div>
    )
  }
  {
    options && options.cards.length > 0 && phone && (
      <div class="flex flex-col gap-[18px]">
        <PortalStepBar back={base || "/"} step={{ current: 1, total: 3 }} />
        <div class="flex flex-col gap-1.5">
          <h1 class="font-display text-[30px] leading-[1.1] font-bold tracking-[-0.01em] lg:text-[36px]">De qual consulta é o retorno?</h1>
          <p class="text-base text-gray-600 lg:text-[17px]">
            Consultas no WhatsApp {phoneEnding(phone)} que ainda dão direito a retorno. <PortalChangePhone action={here} />
          </p>
        </div>
        {changed && <p class="rounded-[14px] border border-amber-200 bg-amber-50 px-4 py-3 text-[17px] text-amber-900" role="alert">{changedNotice}</p>}
        <ul class="grid gap-3.5 lg:grid-cols-2 lg:gap-[18px]">
          {options.cards.map((card) => (
            <li class="flex flex-col overflow-hidden rounded-2xl border-[1.5px] border-gray-200 bg-white">
              <div class="flex flex-col gap-0.5 px-4 pt-3.5 pb-3 lg:px-[18px] lg:pt-4">
                <b class="text-[19px] lg:text-xl">{card.patient.fullName}</b>
                <span class="text-base text-gray-700">
                  {card.professional.name}
                  {card.professional.specialties[0] ? `, ${card.professional.specialties[0].name}` : ""}
                </span>
                <span class="text-base text-gray-700">{consultationOn(card.originDate)}</span>
              </div>
              <p class="flex items-center gap-2.5 bg-clinic-tint px-4 py-3 lg:px-[18px]">
                <svg aria-hidden="true" class="h-[22px] w-[22px] shrink-0 text-clinic-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                <b class="font-display text-xl lg:text-[21px]">{returnUntil(card.lastDate)}</b>
              </p>
              <div class="mt-auto px-4 pt-3 pb-3.5 lg:px-[18px] lg:pt-3.5 lg:pb-4">
                <a href={portalHref(`${base}/retorno/horarios`, { consulta: card.originId })} class={cta}>{returnButton(card.patient.fullName)}</a>
              </div>
            </li>
          ))}
        </ul>
        <div class="grid items-start gap-3.5 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] lg:gap-[18px]">
          {options.refusals.length > 0 ? (
            <details open class="rounded-[14px] border border-gray-200 bg-white px-4 lg:px-[18px]">
              <summary class="flex min-h-[52px] cursor-pointer items-center font-bold text-clinic-ink">
                {options.refusals.length === 1 ? "1 consulta sem direito a retorno" : `${options.refusals.length} consultas sem direito a retorno`}
              </summary>
              <ul class="pb-1.5">
                {options.refusals.map((r) => (
                  <li class="flex flex-col gap-0.5 border-gray-100 py-3 [&+&]:border-t">
                    <b class="text-[17px]">{r.patient.fullName}, {r.professional.name}</b>
                    <span class="text-base text-gray-700">
                      {refusalText({ kind: r.kind, originDate: r.originDate, lastDate: "lastDate" in r ? r.lastDate : undefined, scheduledAt: "scheduledAt" in r ? r.scheduledAt : undefined, professionalName: r.professional.name }, timeZone)}
                    </span>
                  </li>
                ))}
              </ul>
            </details>
          ) : (
            <span class="hidden lg:block" />
          )}
          <div class="flex flex-col gap-1 rounded-[14px] border border-gray-200 bg-white px-4 py-3.5 lg:px-[18px]">
            <span class="text-base text-gray-600">Não achou a consulta?</span>
            {waHref ? (
              <a href={waHref} target="_blank" rel="noopener" class="flex min-h-11 items-center text-[17px] font-bold text-clinic-ink">Falar com a recepção</a>
            ) : (
              <span class="text-[17px]">Toque em "Recepção", no topo, para falar com a clínica.</span>
            )}
          </div>
        </div>
      </div>
    )
  }
  {
    options && !options.cards.length && phone && (
      <div class="flex max-w-[640px] flex-col gap-3.5">
        <PortalStepBar back={base || "/"} />
        {changed && <p class="rounded-[14px] border border-amber-200 bg-amber-50 px-4 py-3 text-[17px] text-amber-900" role="alert">{changedNotice}</p>}
        <span class="mt-4 flex h-16 w-16 items-center justify-center rounded-full bg-amber-100 text-amber-900" aria-hidden="true">
          <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /><path d="M10 14l4 4M14 14l-4 4" /></svg>
        </span>
        {refusal?.kind === "expired" ? (
          <>
            <h1 class="font-display text-[32px] leading-[1.1] font-bold tracking-[-0.015em] lg:text-[38px]">O prazo do retorno acabou</h1>
            <p class="text-lg text-gray-700">
              Não há consulta com direito a retorno no WhatsApp {phoneEnding(phone)}. <PortalChangePhone action={here} />
            </p>
            <div class="mt-1.5 flex flex-col gap-1 rounded-[14px] border border-gray-200 bg-white px-4 py-3.5">
              <span class="text-[15px] text-gray-600">Última consulta</span>
              <b class="text-lg">{refusal.patient.fullName}</b>
              <span class="text-base text-gray-700">
                {refusal.professional.name}
                {refusal.professional.specialties[0] ? `, ${refusal.professional.specialties[0].name}` : ""}, em {dayMonth(refusal.originDate)}
              </span>
              <span class="text-base text-gray-700">O retorno podia ser marcado até {dayMonth(refusal.lastDate)}.</span>
            </div>
            <p class="text-[17px] text-gray-700">Para voltar {toName(refusal.professional.name)}, agende uma consulta nova. Se precisar de ajuda, fale com a recepção.</p>
            <div class="mt-4 flex flex-col gap-2.5">
              <a href={`${base}/${refusal.professional.slug}/atendimento`} class={ctaWide}>Agendar consulta {withName(refusal.professional.name)}</a>
              {waHref && (
                <a href={waHref} target="_blank" rel="noopener" class={secondary}>
                  <svg aria-hidden="true" class="h-[22px] w-[22px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={waIcon} /></svg>
                  Falar com a recepção
                </a>
              )}
            </div>
          </>
        ) : (
          <>
            <h1 class="font-display text-[32px] leading-[1.1] font-bold tracking-[-0.015em] lg:text-[38px]">Não há retorno para marcar</h1>
            <p class="text-lg text-gray-700">
              {refusal?.kind === "home_visit" && "A última consulta foi um atendimento domiciliar, e consulta domiciliar não dá direito a retorno."}
              {refusal?.kind === "used" && `O retorno da última consulta de ${refusal.patient.fullName} já foi marcado: cada consulta dá direito a um retorno.`}
              {refusal?.kind === "future" &&
                `${refusal.patient.fullName} já tem atendimento marcado ${withName(refusal.professional.name)} em ${formatInstant(refusal.scheduledAt, timeZone, "dd/MM 'às' HH:mm")}.`}
              {!refusal && `Não encontramos consulta recente no WhatsApp ${phoneEnding(phone)} que dê direito a retorno.`}
            </p>
            <p class="text-base text-gray-700">
              Celular {phoneEnding(phone)}. <PortalChangePhone action={here} />
            </p>
            <p class="text-[17px] text-gray-700">
              {refusal?.kind === "future" ? "Para mudar o dia, fale com a recepção." : "Para um novo atendimento, agende uma consulta."}
            </p>
            <div class="mt-4 flex flex-col gap-2.5">
              {refusal?.kind !== "future" && <a href={base || "/"} class={ctaWide}>Agendar consulta</a>}
              {waHref && (
                <a href={waHref} target="_blank" rel="noopener" class={secondary}>
                  <svg aria-hidden="true" class="h-[22px] w-[22px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={waIcon} /></svg>
                  Falar com a recepção
                </a>
              )}
            </div>
          </>
        )}
      </div>
    )
  }
</PortalLayout>

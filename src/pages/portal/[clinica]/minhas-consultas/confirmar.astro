---
// Remarcar, passo 2 (F3c): "Confirme a remarcação" com o horário de hoje e o novo, e "Confirmar remarcação" (uma vez
// só: o botão trava no envio e o banco confere o horário). Depois: Minhas consultas com "Pronto, remarcado" e o aviso
// da remarcação pelo WhatsApp. Ocupado no meio: volta aos horários do mesmo dia, com o aviso. Em casa (F3e-1, DM4):
// "O endereço continua o mesmo?" ("Sim, é esse" marcado; "Não, mudou" abre os campos aqui mesmo).
import PortalLayout from "../../../../components/portal/PortalLayout.astro";
import PortalNotice from "../../../../components/portal/PortalNotice.astro";
import PortalStepBar from "../../../../components/portal/PortalStepBar.astro";
import { portalCta, portalError, portalInput, portalNotice, portalTitle } from "../../../../components/portal/styles";
import { HOME_ADDRESS_INPUTS, HOME_ADDRESS_MAX, joinHomeAddress, type HomeAddressField, type HomeAddressFields } from "../../../../lib/portalBooking";
import { parseSlotChoice } from "../../../../lib/data/agenda/publicBooking";
import { openChangePage } from "../../../../lib/data/portal/changePage";
import { afterLinkBooking } from "../../../../lib/data/portal/links";
import { isRescheduleSlotFree, rescheduleMine, rescheduleScope, whatOf, whenOf } from "../../../../lib/data/portal/myAppointments";
import { clinicSenderFor } from "../../../../lib/data/whatsapp/clinicSender";
import { mapsHref, portalHref } from "../../../../lib/portal";

const view = await openChangePage(Astro, "remarcar");
if (view.kind === "redirect") return view.response;
const params = Astro.url.searchParams;
const choice = parseSlotChoice(params.get("start"));

let problem: string | null = null;
let newWhen = "";
let oldWhen = "";
let what = "";
let locationName = "";
let locationAddress: string | null = null;
// Em casa (F3e-1): o endereço mantido ou o novo.
let addressChoice: "mesmo" | "mudou" = "mesmo";
let fields: HomeAddressFields = { street: "", complement: "", district: "", reference: "" };
let errors: Partial<Record<HomeAddressField, string>> = {};
if (view.kind === "open") {
  const { page, item, session } = view;
  const { db, portal } = page;
  const timesHref = (erro: string | null) => portalHref(`${view.listHref}/remarcar`, { a: item.id, date: params.get("date"), erro });
  const scope = await rescheduleScope(db, portal.clinicId, item, { timeZone: portal.timeZone, sessionId: session.id, rebook: view.rebook });
  const slot = choice && choice.agendaId === item.agendaId ? { start: choice.start, locationId: choice.locationId } : null;
  if (!slot || !(await isRescheduleSlotFree(db, portal.clinicId, item, scope, slot, portal.timeZone))) {
    return Astro.redirect(timesHref(slot ? "horario" : null));
  }
  const form = Astro.request.method === "POST" ? await Astro.request.formData().catch(() => null) : null;
  let newAddress: string | null = null;
  if (form && item.locationType === "home_visit") {
    const value = (name: string) => String(form.get(name) ?? "");
    // Sem endereço gravado (atendimento antigo), "mesmo" não serve.
    addressChoice = value("endereco") === "mesmo" && item.homeVisitAddress ? "mesmo" : "mudou";
    if (addressChoice === "mudou") {
      const joined = joinHomeAddress({ street: value("rua"), complement: value("complemento"), district: value("bairro"), reference: value("referencia") });
      fields = joined.fields;
      if (joined.ok) newAddress = joined.text;
      else errors = joined.errors;
    }
  }
  if (form && !Object.keys(errors).length) {
    const outcome = await rescheduleMine(db, portal.clinicId, {
      item,
      slot,
      scope,
      rebook: view.rebook,
      leadHours: view.leadHours,
      sender: await clinicSenderFor(portal.clinicId, Astro.url).catch(() => null),
      homeVisitAddress: newAddress,
      phone: session.phone,
    });
    if (outcome.status === "done") {
      // Pelo link do bot (Remarcar do menu ou do lembrete): o link fica usado e o funil fecha.
      if (view.link) await afterLinkBooking(db, portal.clinicId, view.link.id, outcome.appointmentId);
      return Astro.redirect(portalHref(view.listHref, { aviso: view.rebook ? "marcada" : "remarcada" }));
    }
    if (outcome.status === "taken") return Astro.redirect(timesHref("horario"));
    if (outcome.status === "duplicate") return Astro.redirect(portalHref(view.listHref, { aviso: "duplicado" }));
    if (outcome.status === "lead") return Astro.redirect(portalHref(view.listHref, { aviso: "prazo" }));
    if (outcome.status === "gone") return Astro.redirect(portalHref(view.listHref, { aviso: "mudou" }));
    problem = "Não conseguimos remarcar agora. Toque em “Confirmar remarcação” de novo ou fale com a recepção.";
  } else if (form) problem = "Confira o endereço: faltou alguma informação.";
  if (item.locationType === "home_visit" && !item.homeVisitAddress) addressChoice = "mudou";
  const tz = portal.timeZone;
  newWhen = whenOf(slot.start, tz);
  oldWhen = whenOf(item.start, tz);
  what = whatOf(item);
  const location = scope.locations.find((l) => l.id === slot.locationId);
  locationName = location?.name ?? item.locationName;
  locationAddress = slot.locationId === item.locationId ? item.locationAddress : null;
}
const atHome = view.kind === "open" && view.item.locationType === "home_visit";
const inputs = HOME_ADDRESS_INPUTS;
const choiceCard =
  "flex min-h-14 cursor-pointer items-center gap-3 rounded-2xl border-[1.5px] border-gray-200 bg-white px-4 py-2.5 text-lg has-[:checked]:border-clinic-ink has-[:checked]:bg-clinic-tint has-[:focus-visible]:outline-3 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-clinic-ink";
const page = view.page;
const back = view.kind === "open" ? portalHref(`${view.listHref}/remarcar`, { a: view.item.id, date: params.get("date") }) : "";
const here = view.kind === "open" ? portalHref(`${view.listHref}/confirmar`, { a: view.item.id, date: params.get("date"), start: params.get("start") }) : "";
const row = "flex flex-col gap-0.5 border-t border-gray-100 py-3 first:border-t-0";
---

<PortalLayout
  title={view.kind === "open" ? "Confirme a remarcação" : page.kind === "unavailable" ? "Agendamento indisponível" : "Link não encontrado"}
  brand={page.kind === "open" ? page.portal.brand : page.kind === "unavailable" ? page.brand : null}
  receptionHours={page.kind === "open" ? page.portal.receptionHours : null}
  width="wide"
>
  {page.kind === "unavailable" && <PortalNotice kind="unavailable" brand={page.brand} />}
  {page.kind === "not_found" && <PortalNotice kind="not_found" />}
  {
    view.kind === "open" && (
      <div class="flex max-w-[620px] flex-col gap-[18px]">
        <PortalStepBar back={back} />
        <h1 class={portalTitle}>Confirme {view.rebook ? "o novo horário" : "a remarcação"}</h1>
        {problem && <p class={`${portalNotice} border-red-200 bg-red-50 text-red-800`} role="alert">{problem}</p>}
        <div class="flex flex-col rounded-2xl border-[1.5px] border-gray-200 bg-white px-4 lg:px-[18px]">
          <p class={row}>
            <span class="text-[15px] text-gray-600">Paciente</span>
            <b class="text-lg">{view.item.patientName}</b>
          </p>
          <p class={row}>
            <span class="text-[15px] text-gray-600">Atendimento</span>
            <b class="text-lg">{what}</b>
          </p>
          {!view.rebook && (
            <p class={row}>
              <span class="text-[15px] text-gray-600">Marcado para</span>
              <span class="text-lg text-gray-700 line-through decoration-gray-400">{oldWhen}</span>
            </p>
          )}
          <p class={row}>
            <span class="text-[15px] text-gray-600">Novo horário</span>
            <b class="text-lg">{newWhen}</b>
            <a href={back} class="inline-flex min-h-11 items-center self-start px-0 text-base font-bold text-clinic-ink underline">Trocar o horário</a>
          </p>
          {!atHome && (<p class={row}>
            <span class="text-[15px] text-gray-600">Local</span>
            <span class="text-lg">
              {locationName}
              {locationAddress && (
                <>
                  {" · "}
                  <a href={mapsHref(locationAddress)} target="_blank" rel="noopener" class="font-semibold text-clinic-ink underline">Ver no mapa</a>
                </>
              )}
            </span>
          </p>)}
          {atHome && (
            <p class={row}>
              <span class="text-[15px] text-gray-600">Onde</span>
              <span class="text-lg">Em casa</span>
            </p>
          )}
        </div>
        <form method="POST" action={here} id="confirmar-remarcacao" class="group flex flex-col gap-[18px]" novalidate>
          {atHome && (
            <fieldset class="flex flex-col gap-2.5">
              <legend class="mb-1.5 font-display text-2xl leading-tight font-bold">O endereço continua o mesmo?</legend>
              {view.item.homeVisitAddress && <p class="mb-1 text-[17px] break-words">{view.item.homeVisitAddress}</p>}
              {view.item.homeVisitAddress && (
                <label class={choiceCard}>
                  <input type="radio" name="endereco" value="mesmo" checked={addressChoice === "mesmo"} class="h-6 w-6 shrink-0 accent-[var(--clinic-ink)]" />
                  <b>Sim, é esse</b>
                </label>
              )}
              <label class={choiceCard}>
                <input type="radio" name="endereco" value="mudou" id="endereco-mudou" checked={addressChoice === "mudou"} class="h-6 w-6 shrink-0 accent-[var(--clinic-ink)]" />
                <b>{view.item.homeVisitAddress ? "Não, mudou" : "Informar o endereço"}</b>
              </label>
              <div class="mt-1 hidden flex-col gap-4 group-has-[#endereco-mudou:checked]:flex" data-endereco-campos>
                {inputs.map((i) => (
                  <div class="flex flex-col gap-1.5">
                    <label for={`endereco-${i.name}`} class="text-base font-semibold text-gray-700">
                      {i.label}
                      {i.optional && <span class="font-normal text-gray-600"> (se tiver)</span>}
                    </label>
                    <input
                      id={`endereco-${i.name}`}
                      name={i.name}
                      value={fields[i.field]}
                      maxlength={HOME_ADDRESS_MAX[i.field]}
                      autocomplete={i.autocomplete}
                      class={portalInput}
                      aria-invalid={errors[i.field] ? "true" : undefined}
                      aria-describedby={errors[i.field] ? `endereco-${i.name}-erro` : undefined}
                    />
                    {errors[i.field] && <p id={`endereco-${i.name}-erro`} class={portalError} aria-live="polite">{errors[i.field]}</p>}
                  </div>
                ))}
              </div>
            </fieldset>
          )}
        </form>
        {/* Botão sempre à vista no celular (cliente, 10/nov): barra fixa no rodapé; no computador, no fim da tela. */}
        <div class="sticky bottom-0 z-10 -mx-4 flex flex-col gap-2 border-t border-gray-200 bg-white px-4 pt-3 pb-[max(14px,env(safe-area-inset-bottom))] sm:-mx-6 sm:px-6 lg:static lg:mx-0 lg:gap-[18px] lg:border-0 lg:bg-transparent lg:p-0">
          <p class="text-base text-gray-700 lg:text-[17px]">A confirmação chega no WhatsApp.</p>
          <button type="submit" form="confirmar-remarcacao" class={portalCta} data-sending-label="Remarcando…">
            Confirmar {view.rebook ? "novo horário" : "remarcação"}
          </button>
        </div>
      </div>
    )
  }
</PortalLayout>

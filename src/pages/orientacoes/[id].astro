---
// Orientações gerais da consulta (cliente, 08/out/2026) — página pública, sem
// login, com o texto da clínica formatado e a marca dela, no modelo da página
// do preparo do exame. É o link do template enviado fora da janela de 24h da
// Meta (dentro dela, o texto vai na conversa).
//
// O endereço leva o id da clínica; a leitura usa a credencial limitada a ela
// (D1). Não mostra nenhum dado de paciente. Com o envio desligado depois, o
// texto continua aparecendo: quem já recebeu o link ainda pode precisar dele.
// Redesign R11 (cliente, 17/out/2026): texto em 17px, como o do preparo.
import { DEFAULT_DESIGNATION, designationText } from "../../lib/designation";
import LinkNotice from "../../components/public/LinkNotice.astro";
import PatientLayout from "../../layouts/PatientLayout.astro";
import { PATIENT_TEXT } from "../../components/public/styles";
import { createClinicServiceClient } from "../../lib/data/clinicService";
import { getPublicClinicBrand, type PublicClinicBrand } from "../../lib/data/config/brand";
import { getGuidance } from "../../lib/data/whatsapp/customMessages";
import { DataError } from "../../lib/data/errors";
import { whatsAppTextToHtml } from "../../lib/whatsappFormat";
import { parsePublicId } from "../../lib/publicId";

// Link curto ou o UUID dos links antigos (cliente, 18/out/2026: chave Pix no WhatsApp).
const id = parsePublicId(Astro.params.id) ?? "";

let guidance: string | null = null;
let brand: PublicClinicBrand | null = null;
if (id) {
  const db = createClinicServiceClient(id);
  brand = await getPublicClinicBrand(db, id).catch((error) => {
    if (error instanceof DataError && error.code === "not_found") return null;
    throw error;
  });
  if (brand) guidance = (await getGuidance(db, id))?.trim() || null;
}

if (!guidance) Astro.response.status = 404;
const pageTitle = guidance ? "Orientações gerais para a consulta" : "Orientações não encontradas";
// "fale com o consultório": como a clínica é chamada (cliente, 11/out/2026).
const clinicWord = designationText(brand?.designation ?? DEFAULT_DESIGNATION);
---

<PatientLayout title={pageTitle} brand={brand}>
  {
    brand && guidance ? (
      <>
        <div>
          <p class="text-[15px] font-semibold text-clinic-ink">{brand.name}</p>
          <h1 class="mt-0.5 text-[26px] leading-tight font-bold text-gray-900 sm:text-3xl">Orientações gerais para a consulta</h1>
        </div>
        <div class={PATIENT_TEXT} set:html={whatsAppTextToHtml(guidance)} />
      </>
    ) : (
      <LinkNotice icon="information-circle" title="Orientações não encontradas" whatsappPhone={brand?.whatsappPhone} clinicWord={clinicWord}>
        Em caso de dúvida, fale com {clinicWord} pelo WhatsApp.
      </LinkNotice>
    )
  }
</PatientLayout>

---
// Fontes da marca no próprio servidor (redesign R0; a CSP não carrega fontes de fora).
import "@fontsource-variable/bricolage-grotesque/opsz.css";
import "@fontsource-variable/source-sans-3";
import "../styles/global.css";
import AppInstallHead from "../components/admin/AppInstallHead.astro";
import Icon from "../components/admin/Icon.astro";
import type { IconName } from "../components/admin/Icon.astro";
import MoreMenu from "../components/admin/ui/MoreMenu.astro";
import { menuItemClass } from "../components/admin/ui/styles";
import { canAccessArea, roleLabel as describeRoles } from "../lib/clinicAccess";
import { pageFlash } from "../lib/flash";
import { createUserClient } from "../lib/data/clients";
import { loadRelationshipLists, menuTotal, relationshipCounts, relationshipTabs } from "../lib/data/relationship";
import { countAwaitingClinic } from "../lib/data/whatsapp/attention";
import { logError } from "../lib/log";

interface Props {
  title: string;
  /** Tela da administração do sistema (só o Suporte, sem clínica ativa). */
  platform?: boolean;
}

// Uma largura só para todas as telas (cliente, 16/out/2026: a Agenda e o Resumo do Dia
// deixaram a largura de 1600px da R1 para ficar como as outras).
const { title, platform = false } = Astro.props;
const frame = "max-w-6xl";

type NavItem = { label: string; href: string; icon: IconName; badge?: number; badgeLabel?: string };

// Os 4 primeiros são a barra inferior de abas no celular (uso frequente,
// toque de um dedo só); Configurações/Relatórios ficam dentro de "Mais" —
// ver decisão de navegação mobile no plano, seção Fase 9.
const primaryNavItems: NavItem[] = [
  { label: "Início", href: "/admin/dashboard", icon: "home" },
  { label: "Agenda", href: "/admin/agenda", icon: "calendar" },
  { label: "Pacientes", href: "/admin/pacientes", icon: "users" },
  // "Consultas" renomeado a pedido do cliente (Fase 23); a tela continua em /admin/consultas.
  { label: "Resumo do Dia", href: "/admin/consultas", icon: "check-circle" },
];

// Papéis do login na clínica ativa, resolvidos pelo middleware (F3.2, D6).
// Áreas sem acesso somem do menu, não só ficam bloqueadas na rota.
// Relatórios virou uma aba de Métricas (Fase 23 · etapa 4).
const clinic = Astro.locals.clinic;
// O aviso da tela é lido antes das esperas do menu (contadores do Atendimento e do
// Relacionamento): depois delas a resposta já começou a sair e o cookie não é mais
// apagado, e o aviso aparecia de novo na tela seguinte (como o QA-02 da R9).
pageFlash(Astro);
const access = clinic ?? { roles: [], isPlatformStaff: false };
const roleLabel = describeRoles(access);

// Atendimento humano (F8.5a, cliente, 27/out/2026): com o bot, toda a equipe vê as conversas que aguardam a
// clínica; o contador fica no menu (e no "Mais" do celular). Falha na contagem não derruba a tela.
const attentionCount =
  clinic && !platform && clinic.features.includes("whatsapp_bot")
    ? await countAwaitingClinic(createUserClient(Astro.request, Astro.cookies), clinic.clinicId, clinic.timezone).catch((error: unknown) => {
        logError("atendimento humano: contador do menu", error, { clinica: clinic.clinicId });
        return 0;
      })
    : null;

// Relacionamento (CRM A1, cliente, 27/out/2026): Administrador e Recepção, com o item. No celular fica no
// "Mais", ao lado do Atendimento (Q1). O contador soma as pendências que pedem contato (menuTotal); falha
// numa lista não derruba a tela nem o menu.
const relationshipOn = clinic && !platform && canAccessArea(clinic, "relationship");
const relationshipCount = !relationshipOn
  ? 0
  : (Astro.locals.relationshipMenuTotal ??
    menuTotal(
      relationshipCounts(
        await loadRelationshipLists(
          createUserClient(Astro.request, Astro.cookies),
          clinic.clinicId,
          relationshipTabs(clinic.features).filter((tab) => tab !== "lista_espera"),
          (tab, error) => logError(`relacionamento: contador do menu (${tab})`, error, { clinica: clinic.clinicId }),
        ),
      ),
    ));

const clinicMoreItems: NavItem[] = [
  ...(relationshipOn
    ? [{ label: "Relacionamento", href: "/admin/relacionamento", icon: "user-check" as IconName, badge: relationshipCount, badgeLabel: `${relationshipCount} pendência(s)` }]
    : []),
  ...(attentionCount !== null ? [{ label: "Atendimento", href: "/admin/atendimento", icon: "chat-bubble" as IconName, badge: attentionCount }] : []),
  // Envios automáticos virou aba de Métricas (Fase 23 · etapa 5).
  ...(canAccessArea(access, "settings")
    ? [{ label: "Configurações", href: "/admin/configuracoes", icon: "settings" as IconName }]
    : []),
  ...(canAccessArea(access, "metrics")
    ? [{ label: "Métricas", href: "/admin/metricas", icon: "funnel" as IconName }]
    : []),
  // Módulo financeiro (F11): Administrador e Recepção, com o item liberado.
  ...(canAccessArea(access, "finance")
    ? [{ label: "Financeiro", href: "/admin/financeiro", icon: "banknotes" as IconName }]
    : []),
];

// Administração do sistema (F4.2, F4.4a, F9.3 e F9.5): só o Suporte.
const systemNavItems: NavItem[] =
  platform || clinic?.isPlatformStaff
    ? [
        { label: "Clínicas", href: "/admin/sistema/clinicas", icon: "building" },
        { label: "Matriz de acesso", href: "/admin/sistema/matriz", icon: "squares" },
        { label: "Vendas", href: "/admin/sistema/vendas", icon: "tag" },
        { label: "Uso", href: "/admin/sistema/uso", icon: "chart-bar" },
        { label: "Erros", href: "/admin/sistema/erros", icon: "warning" },
        { label: "Tecnologia", href: "/admin/sistema/tecnologia", icon: "cpu" },
      ]
    : [];

// Menu do Suporte agrupado (pendência da R1, U-07; cliente, 16/out/2026):
// dentro de uma clínica, os itens dela ficam no cabeçalho e os do sistema vão
// para o botão "Sistema"; na Administração do sistema (sem clínica aberta),
// só os do sistema. No celular, o "Mais" separa os grupos Clínica e Sistema.
const headerNavItems = platform ? systemNavItems : [...primaryNavItems, ...clinicMoreItems];
const headerSystemItems = platform ? [] : systemNavItems;
const tabBarItems = platform ? systemNavItems.slice(0, 4) : primaryNavItems;
const moreGroups: { title?: string; items: NavItem[] }[] = platform
  ? [{ items: systemNavItems.slice(4) }]
  : systemNavItems.length > 0
    ? [
        { title: "Clínica", items: clinicMoreItems },
        { title: "Sistema · só o Suporte", items: systemNavItems },
      ].filter((group) => group.items.length > 0)
    : [{ items: clinicMoreItems }];
const moreNavItems = moreGroups.flatMap((group) => group.items);

// Dentro da clínica, a faixa amarela já diz que é o Suporte: o canto direito fica só com o "Sair".
const showRoleLabel = platform || !clinic?.isPlatformStaff;

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath.startsWith(href);
const isMoreActive = moreNavItems.some((item) => isActive(item.href));
const isSystemActive = headerSystemItems.some((item) => isActive(item.href));
const navLinkClass = (active: boolean) =>
  `rounded-lg px-2.5 py-2 whitespace-nowrap no-underline ${
    active ? "bg-brand-soft text-brand-ink" : "text-ink-soft hover:bg-canvas hover:text-ink"
  }`;
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title} | RecepClinic</title>
    <meta name="robots" content="noindex, nofollow" />

    <AppInstallHead />
    <style>
      /* Esconde o marcador padrão do <details>/<summary> (seta/triângulo) —
         usado no botão "Mais" da barra inferior, sem precisar de JS. */
      .more-menu summary {
        list-style: none;
      }
      .more-menu summary::-webkit-details-marker {
        display: none;
      }
      .more-menu[open] > summary > .more-backdrop {
        display: block;
      }
      /* Barra de carregamento (Fase 23 · etapa 1): cada toque recarrega a
         página no servidor, então mostra que algo está acontecendo. */
      #page-loading[data-active] {
        display: block;
      }
      /* Abaixo da barra de status do celular (viewport-fit=cover): em top 0,
         ficava escondida atrás do relógio no iPhone (teste do cliente, 17/out). */
      #page-loading {
        top: env(safe-area-inset-top, 0px);
      }
      #page-loading > div {
        animation: page-loading 1.1s ease-in-out infinite;
      }
      @keyframes page-loading {
        from {
          transform: translateX(-100%);
        }
        to {
          transform: translateX(250%);
        }
      }
    </style>
  </head>
  <body class="flex min-h-screen flex-col bg-canvas font-body text-ink antialiased">
    <!-- Pular o menu pelo teclado (auditoria de frontend, A-03): aparece só com o foco. -->
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-brand focus:shadow-lg focus:ring-2 focus:ring-brand"
    >
      Pular para o conteúdo
    </a>
    <div
      id="page-loading"
      class="fixed inset-x-0 z-50 hidden h-1 overflow-hidden bg-brand-soft"
      role="progressbar"
      aria-label="Carregando"
    >
      <div class="h-full w-2/5 bg-brand"></div>
    </div>
    <header class="border-b border-line bg-white pt-[env(safe-area-inset-top)]">
      <div class={`mx-auto flex min-h-16 items-center justify-between gap-4 px-4 py-2.5 sm:gap-6 ${frame}`}>
        <div class="flex min-w-[9.5rem] max-w-64 shrink-0 items-center gap-2.5 max-sm:shrink">
          <span aria-hidden="true" class="flex h-8 w-8 shrink-0 items-center justify-center rounded-[9px] bg-brand font-display text-[17px] font-bold text-white">R</span>
          <div class="min-w-0">
          {/* O link fica na linha de cima, fora do nome cortado (truncate): ali dentro, sumia com nome longo. */}
          <span class="flex flex-wrap items-baseline gap-x-2">
            <span class="text-[11px] leading-tight font-bold tracking-[.09em] text-brand uppercase">RecepClinic</span>
            {
              (platform || clinic?.canSwitchClinic) && (
                <a href="/admin/escolher-clinica" class="whitespace-nowrap text-xs font-normal text-brand hover:underline">
                  {platform ? "Abrir uma clínica" : "Trocar"}
                </a>
              )
            }
          </span>
          <span class="block truncate text-[15px] leading-tight font-semibold text-ink">{platform ? "Administração do sistema" : clinic?.clinicName}</span>
          </div>
        </div>

        <nav aria-label="Menu principal" class="hidden min-w-0 flex-1 flex-wrap gap-0 text-[15px] font-semibold sm:flex">
          {
            headerNavItems.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class={`${navLinkClass(isActive(item.href))} ${item.badge ? "inline-flex items-center gap-1.5" : ""}`}
              >
                {item.label}
                {item.badge ? (
                  <span class="rounded-full bg-can-500 px-1.5 text-[12px] leading-5 font-bold text-white" aria-label={item.badgeLabel ?? `${item.badge} aguardando`}>
                    {item.badge}
                  </span>
                ) : null}
              </a>
            ))
          }
          {
            headerSystemItems.length > 0 && (
              <MoreMenu
                id="menu-sistema"
                label="Sistema"
                text="Sistema"
                triggerClass={`inline-flex cursor-pointer items-center gap-1 border-0 font-semibold focus-visible:outline-2 focus-visible:outline-brand ${navLinkClass(isSystemActive)}`}
              >
                <span class="px-2.5 pt-2 pb-1 text-[11.5px] font-bold tracking-[.08em] text-ink-soft uppercase">Sistema · só o Suporte</span>
                {
                  headerSystemItems.map((item) => (
                    <a
                      href={item.href}
                      aria-current={isActive(item.href) ? "page" : undefined}
                      class={`${menuItemClass()} ${isActive(item.href) ? "bg-brand-soft text-brand-ink" : ""}`}
                    >
                      <Icon name={item.icon} class="h-[18px] w-[18px] shrink-0" strokeWidth={1.8} />
                      {item.label}
                    </a>
                  ))
                }
              </MoreMenu>
            )
          }
        </nav>

        <div class="flex shrink-0 items-center gap-3">
          {
            showRoleLabel && (
              // No celular, "Suporte RecepClinic" empurrava o "Sair" para fora da tela
              // (teste da R10); o nome "Administração do sistema" já diz onde se está.
              // Abaixo de 380px, o papel também sai (QA-01 do teste da S-01 e S-02).
              <span class={`text-sm text-ink-soft ${platform ? "max-sm:hidden" : "max-[380px]:hidden"}`}>
                {platform ? "Suporte RecepClinic" : roleLabel}
              </span>
            )
          }
          <form method="POST" action="/api/admin/auth/logout">
            <button
              type="submit"
              class="h-9 rounded-[7px] border border-line-strong bg-white px-3 text-sm font-semibold text-ink hover:bg-canvas sm:h-8"
            >
              Sair
            </button>
          </form>
        </div>
      </div>
    </header>

    {
      clinic?.isPlatformStaff && (
        <div class="border-b border-amber-200 bg-amber-50 px-4 py-2 text-center text-xs text-amber-800">
          Você está como Suporte RecepClinic nesta clínica: cada tela aberta fica registrada.
        </div>
      )
    }
    {
      !platform && clinic?.clinicStatus === "onboarding" && (
        <div class="border-b border-amber-200 bg-amber-50 px-4 py-2 text-center text-xs text-amber-800">
          Clínica em implantação: nada sai para os pacientes pelo WhatsApp (bot, avisos e lembretes) até o Suporte do RecepClinic ativar.
        </div>
      )
    }

    <main id="conteudo" tabindex="-1" class={`mx-auto w-full flex-1 px-4 pt-6 pb-28 outline-none sm:pb-12 ${frame} sm:pt-8`}>
      <slot />
    </main>

    <!-- Barra inferior de abas — só no celular (escondida a partir de `sm`). -->
    <nav
      class="fixed inset-x-0 bottom-0 z-20 flex border-t border-line bg-white pb-[env(safe-area-inset-bottom)] sm:hidden"
      aria-label="Navegação principal"
    >
      {
        tabBarItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class={`flex min-w-0 flex-1 flex-col items-center gap-0.5 py-2 text-center text-[11.5px] font-semibold leading-tight no-underline ${
              isActive(item.href) ? "text-brand" : "text-ink-soft"
            }`}
          >
            <Icon name={item.icon} class="h-6 w-6 shrink-0" />
            {item.label}
          </a>
        ))
      }

      <details class="more-menu relative flex flex-1 flex-col items-center justify-center">
        <summary
          class={`flex cursor-pointer list-none flex-col items-center gap-0.5 py-2 text-[11px] font-medium ${
            isMoreActive ? "text-brand" : "text-ink-soft"
          }`}
        >
          <span class="relative">
            <Icon name="more" class="h-6 w-6" />
            {attentionCount ? (
              <span class="absolute -top-1.5 -right-2.5 rounded-full bg-can-500 px-1.5 text-[11px] leading-[18px] font-bold text-white" aria-label={`${attentionCount} conversas aguardando a clínica`}>
                {attentionCount}
              </span>
            ) : null}
          </span>
          Mais
        </summary>

        <div class="absolute bottom-full right-2 mb-2 w-52 rounded-[10px] border border-line bg-white p-1.5 text-[15px] shadow-[0_10px_30px_rgba(18,48,42,.16)]">
          {
            moreGroups.map((group, index) => (
              <div class={index > 0 ? "mt-1.5 border-t border-line pt-1.5" : ""}>
                {group.title && (
                  <span class="block px-3 pt-1.5 pb-1 text-[11.5px] font-bold tracking-[.08em] text-ink-soft uppercase">{group.title}</span>
                )}
                {group.items.map((item) => (
                  <a
                    href={item.href}
                    aria-current={isActive(item.href) ? "page" : undefined}
                    class={`flex items-center gap-2 rounded-md px-3 py-2 font-medium ${
                      isActive(item.href) ? "bg-brand-soft text-brand-ink" : "text-ink hover:bg-canvas"
                    }`}
                  >
                    <Icon name={item.icon} class="h-5 w-5" />
                    {item.label}
                    {item.badge ? (
                      <span class="ml-auto rounded-full bg-can-500 px-1.5 text-[12px] leading-5 font-bold text-white" aria-label={item.badgeLabel ?? `${item.badge} aguardando`}>
                        {item.badge}
                      </span>
                    ) : null}
                  </a>
                ))}
              </div>
            ))
          }
          <form method="POST" action="/api/admin/auth/logout">
            <button
              type="submit"
              class="flex w-full items-center gap-2 rounded-md px-3 py-2 text-left font-medium text-ink hover:bg-canvas"
            >
              <Icon name="logout" class="h-5 w-5" />
              Sair
            </button>
          </form>
        </div>
      </details>
    </nav>

    <script src="../scripts/keepFormValues.ts"></script>
    <script src="../scripts/sendOnce.ts"></script>
    <script src="../scripts/scrollRegion.ts"></script>
    <script src="../scripts/helpTips.ts"></script>
    <script>
      // Liga a barra ao sair da página: link interno ou envio de formulário
      // que não foi tratado por JavaScript (ex.: botões de reenvio, que
      // chamam a API sem recarregar, cancelam o envio padrão).
      const loading = document.getElementById("page-loading");
      const show = () => loading?.setAttribute("data-active", "");

      document.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const link = (event.target as Element | null)?.closest("a");
        if (!link || !link.href || link.target || link.hasAttribute("download")) return;
        const url = new URL(link.href, location.href);
        if (url.origin !== location.origin) return;
        if (url.pathname === location.pathname && url.search === location.search && url.hash) return;
        // Deixa outros handlers do mesmo clique decidirem antes.
        setTimeout(() => {
          if (!event.defaultPrevented) show();
        });
      });

      document.addEventListener("submit", (event) => {
        setTimeout(() => {
          if (!event.defaultPrevented) show();
        });
      });

      // Filtros que recarregam a página ao mudar (data, agenda, serviço). Sem
      // onchange no HTML: o CSP (F9.1) não deixa rodar script em atributo.
      document.addEventListener("change", (event) => {
        const field = event.target as HTMLInputElement | HTMLSelectElement | null;
        if (!field?.form || !field.hasAttribute("data-autosubmit")) return;
        show();
        field.form.submit();
      });

      // Voltar pelo navegador pode reabrir a página do cache com a barra ligada.
      window.addEventListener("pageshow", () => loading?.removeAttribute("data-active"));
    </script>
  </body>
</html>

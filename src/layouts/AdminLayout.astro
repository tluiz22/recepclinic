---
// Fontes da marca no próprio servidor (redesign R0; a CSP não carrega fontes de fora).
import { GUIDE_BEFORE_CONNECT_PATH } from "../lib/guides";
import "@fontsource-variable/bricolage-grotesque/opsz.css";
import "@fontsource-variable/source-sans-3";
import "../styles/global.css";
import AppInstallHead from "../components/admin/AppInstallHead.astro";
import Icon from "../components/admin/Icon.astro";
import type { IconName } from "../components/admin/Icon.astro";
import { canAccessArea, inSuspendedView, ownSettingsOnly, roleLabel as describeRoles, SUSPENDED_ADMIN_PAGE } from "../lib/clinicAccess";
import { pageFlash } from "../lib/flash";
import { createUserClient } from "../lib/data/clients";
import { getMeuDiaCount } from "../lib/data/dashboard";
import { countWaitingConversations, isCentralActive } from "../lib/data/central";
import { logError } from "../lib/log";
import { articleForPath } from "../lib/central";
import { canSeeArticle } from "../lib/central/access";

interface Props {
  title: string;
  /** Tela da administração do sistema (só o Suporte, sem clínica ativa). */
  platform?: boolean;
  /** Recarrega sozinha a cada 1 minuto, com a aba à vista (src/scripts/autoRefresh.ts). */
  autoRefresh?: boolean;
  /** Tela larga (Conversas, cliente, 06/nov/2026): ocupa a largura toda no computador, sem a moldura de 6xl. */
  wide?: boolean;
  /** Tela que ocupa a altura da janela no computador, sem rolar a página (Conversas, cliente, 06/nov/2026): o conteúdo
   * rola por dentro dos quadros. */
  fill?: boolean;
  /** Nome da área cujas seções vêm no slot "side" (ex.: "Configurações"), no lugar do menu principal. */
  sideTitle?: string;
}

// Uma largura só para todas as telas (cliente, 16/out/2026: a Agenda e o Resumo do Dia
// deixaram a largura de 1600px da R1 para ficar como as outras).
const { title, platform = false, autoRefresh = false, wide = false, fill = false, sideTitle } = Astro.props;
// Seções de uma área na lateral (M5, Configurações; cliente, 30/out/2026): elas aparecem no lugar do menu
// principal, que volta pelo "‹ Menu principal" sem sair da tela.
const hasSide = Astro.slots.has("side");
const frame = wide ? "max-w-[1760px]" : "max-w-6xl";

// `match`: outras rotas que deixam o item marcado (o Atendimento é do Meu dia; o Relatório do dia, da Agenda; o
// Relacionamento antigo, de Pacientes).
type NavItem = { label: string; href: string; icon: IconName; badge?: number; badgeLabel?: string; match?: string[]; shortLabel?: string };

// Menu novo (RX6 do redesign da Recepção, RX-D1; cliente, 02/nov/2026): os lugares de trabalho, que também são a
// barra inferior de abas no celular e no tablet (mais o "Mais"). Os demais itens ficam no grupo "Mais".
const primaryNavItems: NavItem[] = [
  { label: "Meu dia", href: "/admin/dashboard", icon: "home", match: ["/admin/atendimento"] },
  { label: "Agenda", href: "/admin/agenda", icon: "calendar" },
  // Relatório do dia (antigo Resumo do Dia) no menu, à vista (cliente, 02/nov/2026); também no "Mais" da Agenda.
  { label: "Relatório do dia", shortLabel: "Relatório", href: "/admin/consultas", icon: "check-circle", match: ["/admin/envios"] },
  { label: "Pacientes", href: "/admin/pacientes", icon: "users", match: ["/admin/relacionamento"] },
];

// Papéis do login na clínica ativa, resolvidos pelo middleware (F3.2, D6).
// Áreas sem acesso somem do menu, não só ficam bloqueadas na rota.
// Relatórios virou uma aba de Métricas (Fase 23 · etapa 4).
const clinic = Astro.locals.clinic;
// O aviso da tela é lido antes das esperas do menu (contadores do Atendimento e do
// Relacionamento): depois delas a resposta já começou a sair e o cookie não é mais
// apagado, e o aviso aparecia de novo na tela seguinte (como o QA-02 da R9).
pageFlash(Astro);
const access = clinic ?? { roles: [], isPlatformStaff: false };
// Clínica suspensa (F12.3): fora o Suporte, o menu tem só a Assinatura (Administrador) e nada mais.
const suspendedView = !platform && inSuspendedView(clinic);
const roleLabel = describeRoles(access);

// Contador do Meu dia (RX6, decisão 5.1; cliente, 02/nov/2026): conversas aguardando atendimento humano, conversas
// que a clínica assumiu e ainda não devolveu ao bot, consultas sem presença registrada e contatos a conferir. A tela
// do Meu dia informa o número que já leu; nas outras, ele é lido aqui. Falha na contagem não derruba o menu.
// Central de atendimento (CN3a; tela T6, cliente, 05/nov/2026): com ela ligada, o item Conversas logo abaixo do Meu dia,
// com as conversas que aguardam a clínica, e o Meu dia deixa de contar conversas. Falha na leitura: menu sem o item.
const db = clinic && !platform ? createUserClient(Astro.request, Astro.cookies) : null;
const centralRoles = clinic && (clinic.isPlatformStaff || clinic.roles.some((role) => role === "admin" || role === "reception" || role === "professional"));
const centralOn =
  !suspendedView && !!db && !!clinic && !!centralRoles && clinic.features.includes("central_attendance")
    ? await isCentralActive(db, clinic.clinicId).catch((error) => (logError("conversas: menu", error, { clinica: clinic.clinicId }), false))
    : false;
const conversationsWaiting = centralOn ? await countWaitingConversations(db!, clinic!.clinicId).catch(() => 0) : 0;
const meuDiaCount =
  clinic && db && !suspendedView
    ? Astro.locals.meuDiaCount !== undefined
      ? Math.max(0, Astro.locals.meuDiaCount - (centralOn ? (Astro.locals.meuDiaConversations ?? 0) : 0))
      : await getMeuDiaCount(
          db,
          clinic.clinicId,
          clinic.features,
          (label, error) => logError(`meu dia: contador do menu (${label})`, error, { clinica: clinic.clinicId }),
          new Date(),
          { conversations: !centralOn },
        )
    : 0;

const [homeItem, agendaItem, reportItem, patientsItem] = primaryNavItems;
const conversationsItem: NavItem | null = centralOn
  ? {
      label: "Conversas",
      href: "/admin/conversas",
      icon: "chat-bubble",
      ...(conversationsWaiting > 0 ? { badge: conversationsWaiting, badgeLabel: `${conversationsWaiting} aguardando a clínica` } : {}),
    }
  : null;
// Grupo "Mais" (RX-D1): o que a pessoa tem acesso, na ordem do desenho; sem acesso, o item some.
const moreItems: NavItem[] = [
  // Módulo financeiro (F11): Administrador e Recepção, com o item liberado.
  ...(canAccessArea(access, "finance") ? [{ label: "Financeiro", href: "/admin/financeiro", icon: "banknotes" as IconName }] : []),
  // Envios automáticos virou aba de Métricas (Fase 23 · etapa 5).
  ...(canAccessArea(access, "metrics") ? [{ label: "Métricas", href: "/admin/metricas", icon: "funnel" as IconName }] : []),
  ...(canAccessArea(access, "settings") ? [{ label: "Configurações", href: "/admin/configuracoes", icon: "settings" as IconName }] : []),
  // Profissional com login (MS, S1): Configurações com só o que é dele, abrindo nos serviços.
  ...(!canAccessArea(access, "settings") && ownSettingsOnly(access) ? [{ label: "Configurações", href: "/admin/configuracoes/servicos", icon: "settings" as IconName }] : []),
  // Quem só tem a permissão de convênios (Equipe; MC, 07/nov/2026) vai direto à tela dela.
  ...(!canAccessArea(access, "settings") && canAccessArea(access, "insurance") && (clinic?.features ?? []).includes("insurance")
    ? [{ label: "Convênios", href: "/admin/configuracoes/convenios", icon: "credit-card" as IconName }]
    : []),
];

// Central de Ajuda (cliente, 01/nov/2026): item permanente, para todos os papéis e para o Suporte.
const helpItem: NavItem = { label: "Central de Ajuda", href: "/admin/ajuda", icon: "life-buoy" };
// O Meu dia leva o número das pendências (nos itens da lateral e da barra do celular).
const withCount = (item: NavItem): NavItem => (item === homeItem && meuDiaCount > 0 ? { ...item, badge: meuDiaCount, badgeLabel: `${meuDiaCount} pendência(s) no Meu dia` } : item);

// Administração do sistema (F4.2, F4.4a, F9.3 e F9.5): só o Suporte.
const systemNavItems: NavItem[] =
  platform || clinic?.isPlatformStaff
    ? [
        { label: "Clínicas", href: "/admin/sistema/clinicas", icon: "building" },
        { label: "Matriz de acesso", href: "/admin/sistema/matriz", icon: "squares" },
        { label: "Base de conhecimento", href: "/admin/sistema/conhecimento", icon: "chat-bubble" },
        { label: "Vendas", href: "/admin/sistema/vendas", icon: "tag" },
        { label: "Uso", href: "/admin/sistema/uso", icon: "chart-bar" },
        { label: "Preços da Meta", href: "/admin/sistema/precos-meta", icon: "banknotes" },
        { label: "Erros", href: "/admin/sistema/erros", icon: "warning" },
        { label: "Problemas conhecidos", href: "/admin/sistema/problemas", icon: "life-buoy" },
        { label: "Tecnologia", href: "/admin/sistema/tecnologia", icon: "cpu" },
        { label: "Suporte", href: "/admin/sistema/suporte", icon: "device-phone" },
      ]
    : [];

// Menu lateral (M1–M3, M7; cliente, 30/out/2026): a partir de `lg`, os grupos ficam
// numa coluna à esquerda, sem barra no topo; o Sistema (só o Suporte) vem por último.
// Na Administração do sistema (sem clínica aberta), só os itens do Sistema.
type NavGroup = { title?: string; support?: boolean; items: NavItem[] };
const SYSTEM_TITLE = "Sistema · só o Suporte";
const subscriptionItem: NavItem = { label: "Assinatura", href: SUSPENDED_ADMIN_PAGE, icon: "banknotes" };
const suspendedItems: NavItem[] = clinic?.roles.includes("admin") ? [subscriptionItem] : [];
const sideGroups: NavGroup[] = (
  platform
    ? [{ items: systemNavItems }, { title: "Ajuda", items: [helpItem] }]
    : suspendedView
      ? [{ items: suspendedItems }]
      : [
          { items: [withCount(homeItem), ...(conversationsItem ? [conversationsItem] : []), agendaItem, reportItem, patientsItem] },
        { title: "Mais", items: [...moreItems, helpItem] },
        { title: SYSTEM_TITLE, support: true, items: systemNavItems },
      ]
).filter((group) => group.items.length > 0);

// Celular e tablet (M6): a barra inferior de sempre e o "Mais" com os mesmos grupos,
// sem os itens que já estão na barra.
// Com a Central (M1): Conversas entra na barra no lugar do Relatório do dia, que vai para o "Mais". Clínica suspensa: só
// os itens da suspensão.
const tabBarItems = platform
  ? systemNavItems.slice(0, 4)
  : suspendedView
    ? suspendedItems
    : conversationsItem
      ? [withCount(homeItem), conversationsItem, agendaItem, patientsItem]
      : primaryNavItems.map(withCount);
const moreGroups: NavGroup[] = (
  platform
    ? [{ items: systemNavItems.slice(4) }, { title: "Ajuda", items: [helpItem] }]
    : suspendedView
      ? []
      : [
          { items: [...(conversationsItem ? [reportItem] : []), ...moreItems, helpItem] },
        { title: SYSTEM_TITLE, support: true, items: systemNavItems },
      ]
).filter((group) => group.items.length > 0);
const moreNavItems = moreGroups.flatMap((group) => group.items);

// Quem está no painel, no pé da lateral (o "Sair" fica ao lado).
const whoLabel = platform || clinic?.isPlatformStaff ? "Suporte RecepClinic" : roleLabel;
const placeName = platform ? "Administração do sistema" : (clinic?.clinicName ?? "");
const switchLink = platform ? "Abrir uma clínica" : clinic?.canSwitchClinic ? "Trocar clínica" : null;
// Iniciais da clínica no quadradinho do alto da lateral ("Clínica Bem-Estar" → "CB").
const initials = platform
  ? "R"
  : placeName
      .split(/[\s-]+/)
      .filter(Boolean)
      .slice(0, 2)
      .map((word) => word[0].toUpperCase())
      .join("");

const currentPath = Astro.url.pathname;
// "Ajuda desta tela": o artigo da Central ligado a esta rota, se a pessoa pode ver (painel lateral).
const helpArticle = (() => {
  if (suspendedView) return undefined;
  const found = articleForPath(currentPath);
  return found && canSeeArticle(access as Parameters<typeof canSeeArticle>[0], found) ? found : undefined;
})();
const isActive = (item: NavItem) => [item.href, ...(item.match ?? [])].some((path) => currentPath.startsWith(path));
const isMoreActive = moreNavItems.some((item) => isActive(item));
const sideLinkClass = (active: boolean) =>
  `group/side flex h-10 items-center gap-3 rounded-[10px] px-2.5 text-[15px] no-underline ${
    active ? "bg-brand-soft font-bold text-brand-ink" : "font-semibold text-ink hover:bg-canvas"
  }`;
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title} | RecepClinic</title>
    <meta name="robots" content="noindex, nofollow" />

    <AppInstallHead />
    <style>
      /* Esconde o marcador padrão do <details>/<summary> (seta/triângulo) —
         usado no botão "Mais" da barra inferior, sem precisar de JS. */
      .more-menu summary {
        list-style: none;
      }
      .more-menu summary::-webkit-details-marker {
        display: none;
      }
      .more-menu[open] > summary > .more-backdrop {
        display: block;
      }
      /* Barra de carregamento (Fase 23 · etapa 1): cada toque recarrega a
         página no servidor, então mostra que algo está acontecendo. */
      #page-loading[data-active] {
        display: block;
      }
      /* Abaixo da barra de status do celular (viewport-fit=cover): em top 0,
         ficava escondida atrás do relógio no iPhone (teste do cliente, 17/out). */
      #page-loading {
        top: env(safe-area-inset-top, 0px);
      }
      #page-loading > div {
        animation: page-loading 1.1s ease-in-out infinite;
      }
      @keyframes page-loading {
        from {
          transform: translateX(-100%);
        }
        to {
          transform: translateX(250%);
        }
      }
    </style>
  </head>
  <body class="min-h-screen bg-canvas font-body text-ink antialiased lg:flex" data-auto-refresh={autoRefresh ? "" : undefined}>
    <!-- Pular o menu pelo teclado (auditoria de frontend, A-03): aparece só com o foco. -->
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-brand focus:shadow-lg focus:ring-2 focus:ring-brand"
    >
      Pular para o conteúdo
    </a>
    <div
      id="page-loading"
      class="fixed inset-x-0 z-50 hidden h-1 overflow-hidden bg-brand-soft"
      role="progressbar"
      aria-label="Carregando"
    >
      <div class="h-full w-2/5 bg-brand"></div>
    </div>
    <!-- Menu lateral (M1–M3): só a partir de `lg`; fica parado enquanto o conteúdo rola. -->
    <aside class="sticky top-0 hidden h-screen w-60 shrink-0 flex-col gap-5 border-r border-line bg-white px-3.5 pt-[calc(20px+env(safe-area-inset-top))] pb-4 lg:flex">
      <div class="flex items-center gap-3 px-1.5">
        <span aria-hidden="true" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[10px] bg-brand-soft font-display text-base font-bold text-brand-ink">{initials}</span>
        <span class="flex min-w-0 flex-col leading-tight">
          <span class="line-clamp-2 text-[15px] font-bold break-words text-ink" title={placeName}>{placeName}</span>
          {
            switchLink && (
              <a href="/admin/escolher-clinica" class="mt-0.5 text-[13px] font-semibold text-brand no-underline hover:underline">
                {switchLink}
              </a>
            )
          }
        </span>
      </div>

      {/* Só os itens rolam: a clínica (no alto) e o "Sair" (no pé) ficam sempre à vista (QA-01 do teste da L3). */}
      <div data-side-scroll class="-mx-3.5 flex min-h-0 flex-1 flex-col gap-5 overflow-y-auto px-3.5">
      {
        hasSide && (
          <div data-side-view="section" class="flex flex-col gap-5 [&[hidden]]:hidden">
            <button type="button" data-side-switch="main" class="flex h-10 items-center gap-2 rounded-[10px] bg-canvas px-2.5 text-left text-[15px] font-bold text-brand-ink hover:bg-canvas-deep">
              <Icon name="chevron-left" class="h-[18px] w-[18px] shrink-0" strokeWidth={2.2} /> Menu principal
            </button>
            <slot name="side" />
          </div>
        )
      }

      <nav aria-label="Menu principal" data-side-view="main" hidden={hasSide} class="flex flex-col gap-5 [&[hidden]]:hidden">
        {
          hasSide && (
            <button type="button" data-side-switch="section" class="flex min-h-10 items-center py-1.5 leading-snug justify-between gap-2 rounded-[10px] bg-canvas px-2.5 text-left text-[15px] font-bold text-brand-ink hover:bg-canvas-deep">
              Seções de {sideTitle}
              <Icon name="chevron-right" class="h-[18px] w-[18px] shrink-0" strokeWidth={2.2} />
            </button>
          )
        }
        {
          sideGroups.map((group) => (
            <div class="flex flex-col gap-0.5">
              {group.title && (
                <span class={`px-2.5 pb-1 text-[13px] leading-none font-semibold ${group.support ? "text-pend-800" : "text-ink-soft"}`}>{group.title}</span>
              )}
              {group.items.map((item) => (
                <a href={item.href} aria-current={isActive(item) ? "page" : undefined} class={sideLinkClass(isActive(item))}>
                  <Icon
                    name={item.icon}
                    class={`h-5 w-5 shrink-0 ${isActive(item) ? "text-brand" : "text-ink-soft group-hover/side:text-ink"}`}
                    strokeWidth={1.8}
                  />
                  <span class="min-w-0 flex-1 truncate">{item.label}</span>
                  {item.badge ? (
                    <span class="rounded-full bg-can-500 px-1.5 text-[12px] leading-5 font-bold text-white" aria-label={item.badgeLabel ?? `${item.badge} aguardando`}>
                      {item.badge}
                    </span>
                  ) : null}
                </a>
              ))}
            </div>
          ))
        }
      </nav>

      </div>

      {
        // "Ajuda desta tela" (cliente, 07/nov/2026, opção B): no pé do menu lateral, fora da tela, para não ocupar uma
        // faixa acima do título; sempre à vista, inclusive com as seções de Configurações abertas.
        helpArticle && (
          <a
            href={`/admin/ajuda/${helpArticle.id}`}
            data-help-open
            data-help-title={helpArticle.title}
            class="group/side mb-2 flex h-10 shrink-0 items-center gap-3 rounded-[10px] px-2.5 text-[15px] font-semibold text-brand-ink no-underline hover:bg-brand-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
          >
            <Icon name="question-circle" class="h-5 w-5 shrink-0 text-brand" strokeWidth={1.8} />
            Ajuda desta tela
          </a>
        )
      }
      <div class="flex shrink-0 items-center gap-2.5 border-t border-line px-1.5 pt-3">
        <span class="min-w-0 flex-1 truncate text-sm text-ink-soft">{whoLabel}</span>
        <form method="POST" action="/api/admin/auth/logout">
          <button type="submit" class="h-9 rounded-lg border border-line-strong bg-white px-3 text-sm font-semibold text-ink hover:bg-canvas">Sair</button>
        </form>
      </div>
    </aside>

    <div class:list={["flex min-h-screen min-w-0 flex-1 flex-col", fill && "lg:h-dvh lg:min-h-0"]}>
      <!-- Celular e tablet: cabeçalho curto (o menu fica na barra inferior). -->
      <header class="border-b border-line bg-white pt-[env(safe-area-inset-top)] lg:hidden">
        <div class="flex min-h-16 items-center justify-between gap-4 px-4 py-2.5">
          <div class="flex min-w-0 items-center gap-2.5">
            <span aria-hidden="true" class="flex h-8 w-8 shrink-0 items-center justify-center rounded-[9px] bg-brand font-display text-[17px] font-bold text-white">R</span>
            <div class="min-w-0">
              {/* O link fica na linha de cima, fora do nome cortado (truncate): ali dentro, sumia com nome longo. */}
              <span class="flex flex-wrap items-baseline gap-x-2">
                <span class="text-[11px] leading-tight font-bold tracking-[.09em] text-brand uppercase">RecepClinic</span>
                {
                  switchLink && (
                    <a href="/admin/escolher-clinica" class="whitespace-nowrap text-xs font-normal text-brand hover:underline">
                      {platform ? "Abrir uma clínica" : "Trocar"}
                    </a>
                  )
                }
              </span>
              <span class="block truncate text-[15px] leading-tight font-semibold text-ink">{placeName}</span>
            </div>
          </div>

          <div class="flex shrink-0 items-center gap-3">
            {
              // "Ajuda desta tela" no celular e no tablet (cliente, 07/nov/2026, opção B): ícone no cabeçalho, ao lado
              // de Sair, sem a faixa acima do título.
              helpArticle && (
                <a
                  href={`/admin/ajuda/${helpArticle.id}`}
                  data-help-open
                  data-help-title={helpArticle.title}
                  aria-label="Ajuda desta tela"
                  title="Ajuda desta tela"
                  class="flex h-9 w-9 items-center justify-center rounded-[7px] border border-line-strong bg-white text-brand hover:bg-canvas"
                >
                  <Icon name="question-circle" class="h-5 w-5" strokeWidth={1.8} />
                </a>
              )
            }
            {
              // Dentro da clínica, a faixa amarela já diz que é o Suporte. No celular, "Suporte RecepClinic"
              // empurrava o "Sair" para fora da tela (teste da R10); abaixo de 380px, o papel também sai (QA-01
              // do teste da S-01 e S-02).
              (platform || !clinic?.isPlatformStaff) && (
                <span class={`text-sm text-ink-soft ${platform ? "max-sm:hidden" : "max-[380px]:hidden"}`}>{whoLabel}</span>
              )
            }
            <form method="POST" action="/api/admin/auth/logout">
              <button type="submit" class="h-9 rounded-[7px] border border-line-strong bg-white px-3 text-sm font-semibold text-ink hover:bg-canvas">
                Sair
              </button>
            </form>
          </div>
        </div>
      </header>

      {
        clinic?.isPlatformStaff && (
          <div class="border-b border-amber-200 bg-amber-50 px-4 py-2 text-center text-xs text-amber-800">
            Você está como Suporte RecepClinic nesta clínica: cada tela aberta fica registrada.
          </div>
        )
      }
      {
        !platform && clinic?.clinicStatus === "suspended" && (
          <div class="border-b border-can-200 bg-can-100 px-4 py-2 text-center text-xs text-can-800">
            {clinic.isPlatformStaff
              ? "Clínica suspensa: o bot não responde, os links para os pacientes estão indisponíveis e nada sai pelo WhatsApp. A equipe da clínica só vê a Assinatura (Administrador)."
              : "Clínica suspensa: o painel fica restrito à Assinatura até a regularização. O bot não responde e os links de agendamento estão indisponíveis. Fale com o Suporte do RecepClinic."}
          </div>
        )
      }
      {
        !platform && clinic?.clinicStatus === "onboarding" && (
          <div class="border-b border-amber-200 bg-amber-50 px-4 py-2 text-center text-xs text-amber-800">
            Clínica em implantação: nada sai para os pacientes pelo WhatsApp (bot, avisos e lembretes) até o Suporte do RecepClinic ativar.
            {/* IS1 (03/nov/2026): o que preparar antes de conectar o WhatsApp. */}
            <a href={GUIDE_BEFORE_CONNECT_PATH} target="_blank" rel="noopener" class="ml-1 font-semibold whitespace-nowrap text-amber-900 underline">
              Antes de conectar o WhatsApp: veja o guia
            </a>
          </div>
        )
      }

      <main
        id="conteudo"
        tabindex="-1"
        class={`mx-auto w-full flex-1 px-4 pt-6 pb-28 outline-none sm:pt-8 lg:px-6 ${fill ? "lg:flex lg:min-h-0 lg:flex-col lg:pb-6" : "lg:pb-12"} ${frame}`}
      >
        <slot />
      </main>
    </div>

    <!-- Barra inferior de abas: celular e tablet (escondida a partir de `lg`, onde há o menu lateral). -->
    <nav
      class="fixed-bar fixed inset-x-0 bottom-0 z-20 flex border-t border-line bg-white pb-[env(safe-area-inset-bottom)] lg:hidden"
      aria-label="Navegação principal"
    >
      {
        tabBarItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item) ? "page" : undefined}
            class={`flex min-w-0 flex-1 flex-col items-center gap-0.5 py-2 text-center text-[11.5px] font-semibold leading-tight no-underline ${
              isActive(item) ? "text-brand" : "text-ink-soft"
            }`}
          >
            <span class="relative">
              <Icon name={item.icon} class="h-6 w-6 shrink-0" />
              {item.badge ? (
                <span class="absolute -top-1.5 -right-3 rounded-full bg-can-500 px-1.5 text-[11px] leading-[18px] font-bold text-white" aria-label={item.badgeLabel ?? `${item.badge} aguardando`}>
                  {item.badge}
                </span>
              ) : null}
            </span>
            {item.shortLabel ?? item.label}
          </a>
        ))
      }

      <details class="more-menu relative flex flex-1 flex-col items-center justify-center">
        <summary
          class={`flex cursor-pointer list-none flex-col items-center gap-0.5 py-2 text-[11px] font-medium ${
            isMoreActive ? "text-brand" : "text-ink-soft"
          }`}
        >
          <span class="relative">
            <Icon name="more" class="h-6 w-6" />
          </span>
          Mais
        </summary>

        <div class="absolute right-2 bottom-full mb-2 max-h-[70vh] w-60 overflow-y-auto rounded-[12px] border border-line bg-white p-1.5 text-[15px] shadow-[0_10px_30px_rgba(18,48,42,.16)]">
          {
            moreGroups.map((group, index) => (
              <div class={index > 0 ? "mt-1.5 border-t border-line pt-1.5" : ""}>
                {group.title && (
                  <span class={`block px-3 pt-1.5 pb-1 text-[13px] font-semibold ${group.support ? "text-pend-800" : "text-ink-soft"}`}>{group.title}</span>
                )}
                {group.items.map((item) => (
                  <a
                    href={item.href}
                    aria-current={isActive(item) ? "page" : undefined}
                    class={`flex min-h-11 items-center gap-2 rounded-md px-3 font-medium ${
                      isActive(item) ? "bg-brand-soft text-brand-ink" : "text-ink hover:bg-canvas"
                    }`}
                  >
                    <Icon name={item.icon} class="h-5 w-5" />
                    {item.label}
                    {item.badge ? (
                      <span class="ml-auto rounded-full bg-can-500 px-1.5 text-[12px] leading-5 font-bold text-white" aria-label={item.badgeLabel ?? `${item.badge} aguardando`}>
                        {item.badge}
                      </span>
                    ) : null}
                  </a>
                ))}
              </div>
            ))
          }
          <form method="POST" action="/api/admin/auth/logout" class="mt-1.5 border-t border-line pt-1.5">
            <button type="submit" class="flex min-h-11 w-full items-center gap-2 rounded-md px-3 text-left font-medium text-ink hover:bg-canvas">
              <Icon name="logout" class="h-5 w-5" />
              Sair
            </button>
          </form>
        </div>
      </details>
    </nav>

    <script src="../scripts/keepFormValues.ts"></script>
    <script src="../scripts/sendOnce.ts"></script>
    <script src="../scripts/scrollRegion.ts"></script>
    <script src="../scripts/helpTips.ts"></script>
    <script src="../scripts/helpPanel.ts"></script>
    {
      helpArticle && (
        <dialog id="help-panel" aria-labelledby="help-panel-title" class="help-panel m-0 ml-auto h-full max-h-none w-full max-w-[520px] border-l border-line bg-white p-0 text-ink shadow-2xl backdrop:bg-black/30">
          <div class="flex h-full flex-col">
            <div class="flex items-start justify-between gap-3 border-b border-line px-4 py-3">
              <div class="min-w-0">
                <p class="text-[12.5px] font-bold tracking-[.06em] text-ink-soft uppercase">Central de Ajuda</p>
                <h2 id="help-panel-title" data-help-title class="font-display text-[20px] leading-tight font-bold">{helpArticle.title}</h2>
              </div>
              <button type="button" data-help-close class="min-h-11 shrink-0 rounded-lg px-3 text-[15px] font-bold text-brand-ink hover:bg-brand-soft">Fechar</button>
            </div>
            <div data-help-scroll class="min-h-0 flex-1 overflow-y-auto px-4 py-4">
              <div data-help-body />
            </div>
            <div class="border-t border-line px-4 py-3 text-[15px]">
              <a data-help-full href={`/admin/ajuda/${helpArticle.id}`} class="font-semibold text-brand no-underline hover:underline">Abrir a página completa</a>
              <span class="text-ink-soft"> · </span>
              <a href="/admin/ajuda" class="font-semibold text-brand no-underline hover:underline">Central de Ajuda</a>
            </div>
          </div>
        </dialog>
      )
    }
    <script src="../scripts/autoRefresh.ts"></script>
    <script>
      // Liga a barra ao sair da página: link interno ou envio de formulário
      // que não foi tratado por JavaScript (ex.: botões de reenvio, que
      // chamam a API sem recarregar, cancelam o envio padrão).
      const loading = document.getElementById("page-loading");
      const show = () => loading?.setAttribute("data-active", "");

      document.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const link = (event.target as Element | null)?.closest("a");
        if (!link || !link.href || link.target || link.hasAttribute("download")) return;
        const url = new URL(link.href, location.href);
        if (url.origin !== location.origin) return;
        // Arquivo (anexo da conversa, XML da nota): baixa sem sair da página, então a barra ficaria girando (06/nov/2026).
        if (url.pathname.startsWith("/api/")) return;
        if (url.pathname === location.pathname && url.search === location.search && url.hash) return;
        // Deixa outros handlers do mesmo clique decidirem antes.
        setTimeout(() => {
          if (!event.defaultPrevented) show();
        });
      });

      document.addEventListener("submit", (event) => {
        setTimeout(() => {
          if (!event.defaultPrevented) show();
        });
      });

      // Filtros que recarregam a página ao mudar (data, agenda, serviço). Sem
      // onchange no HTML: o CSP (F9.1) não deixa rodar script em atributo.
      document.addEventListener("change", (event) => {
        const field = event.target as HTMLInputElement | HTMLSelectElement | null;
        if (!field?.form || !field.hasAttribute("data-autosubmit")) return;
        show();
        field.form.submit();
      });

      // Lateral com as seções de uma área (M5): "‹ Menu principal" mostra o menu e
      // "Seções de …" volta às seções, sem sair da tela.
      document.addEventListener("click", (event) => {
        const button = (event.target as Element | null)?.closest<HTMLElement>("[data-side-switch]");
        if (!button) return;
        const view = button.dataset.sideSwitch;
        for (const panel of document.querySelectorAll<HTMLElement>("[data-side-view]")) {
          panel.hidden = panel.dataset.sideView !== view;
        }
        document.querySelector<HTMLElement>(`[data-side-view="${view}"] [data-side-switch]`)?.focus();
      });

      // Item aberto fora da vista da lateral (tela baixa, seção do fim de Configurações):
      // a lateral rola até ele (QA-02 do teste da L3).
      const sideScroll = document.querySelector<HTMLElement>("[data-side-scroll]");
      const openItem = sideScroll?.querySelector<HTMLElement>("[data-side-view]:not([hidden]) a[aria-current='page']");
      if (sideScroll && openItem) {
        const box = sideScroll.getBoundingClientRect();
        const item = openItem.getBoundingClientRect();
        if (item.bottom > box.bottom) sideScroll.scrollTop += item.bottom - box.bottom + 16;
      }

      // Voltar pelo navegador pode reabrir a página do cache com a barra ligada.
      window.addEventListener("pageshow", () => loading?.removeAttribute("data-active"));
    </script>
  </body>
</html>

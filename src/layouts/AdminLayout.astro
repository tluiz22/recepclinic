---
import "../styles/global.css";
import Icon from "../components/admin/Icon.astro";
import type { IconName } from "../components/admin/Icon.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;

// Os 4 primeiros são a barra inferior de abas no celular (uso frequente,
// toque de um dedo só); Configurações/Relatórios ficam dentro de "Mais" —
// ver decisão de navegação mobile no plano, seção Fase 9.
const primaryNavItems: { label: string; href: string; icon: IconName }[] = [
  { label: "Início", href: "/admin/dashboard", icon: "home" },
  { label: "Agenda", href: "/admin/agenda", icon: "calendar" },
  { label: "Pacientes", href: "/admin/pacientes", icon: "users" },
  { label: "Consultas", href: "/admin/consultas", icon: "check-circle" },
];

// Perfil do login ativo, resolvido pelo middleware (Fase 14). Métricas é só
// da médica — escondida do menu, não só bloqueada na rota. Relatórios virou
// uma aba de Métricas (Fase 23 · etapa 4).
const role = Astro.locals.role ?? "secretaria";
const roleLabel = role === "medica" ? "Médica" : "Secretária";

const moreNavItems: { label: string; href: string; icon: IconName }[] = [
  // Fase 22 · etapa 5: execuções dos crons e envios com falha — Secretária e Médica.
  { label: "Envios", href: "/admin/envios", icon: "paper-airplane" },
  { label: "Configurações", href: "/admin/configuracoes", icon: "settings" },
  ...(role === "medica"
    ? [
        { label: "Métricas", href: "/admin/metricas", icon: "funnel" as IconName },
      ]
    : []),
];

const desktopNavItems = [...primaryNavItems, ...moreNavItems];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath.startsWith(href);
const isMoreActive = moreNavItems.some((item) => isActive(item.href));
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title} | Painel do consultório</title>
    <meta name="robots" content="noindex, nofollow" />

    <!-- PWA instalável (ícone na tela inicial do celular) — escopado só ao
         /admin, sem service worker (painel só faz sentido com internet).
         Ver plano, "Etapa seguinte, planejada — PWA instalável". -->
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" type="image/png" href="/admin-icon-192.png" />
    <meta name="theme-color" content="#0369a1" />
    <!-- Safari não segue o manifest sozinho, precisa destas tags à parte. -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Consultório" />
    <link rel="apple-touch-icon" href="/admin-apple-touch-icon.png" />
    <style>
      /* Esconde o marcador padrão do <details>/<summary> (seta/triângulo) —
         usado no botão "Mais" da barra inferior, sem precisar de JS. */
      .more-menu summary {
        list-style: none;
      }
      .more-menu summary::-webkit-details-marker {
        display: none;
      }
      .more-menu[open] > summary > .more-backdrop {
        display: block;
      }
      /* Barra de carregamento (Fase 23 · etapa 1): cada toque recarrega a
         página no servidor, então mostra que algo está acontecendo. */
      #page-loading[data-active] {
        display: block;
      }
      #page-loading > div {
        animation: page-loading 1.1s ease-in-out infinite;
      }
      @keyframes page-loading {
        from {
          transform: translateX(-100%);
        }
        to {
          transform: translateX(250%);
        }
      }
    </style>
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50 text-slate-900">
    <div
      id="page-loading"
      class="fixed inset-x-0 top-0 z-50 hidden h-1 overflow-hidden bg-sky-100"
      role="progressbar"
      aria-label="Carregando"
    >
      <div class="h-full w-2/5 bg-sky-600"></div>
    </div>
    <header class="border-b border-slate-200 bg-white pt-[env(safe-area-inset-top)]">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4">
        <span class="text-sm font-semibold uppercase tracking-wide text-sky-700">
          Painel do consultório
        </span>

        <nav class="hidden flex-wrap gap-x-6 gap-y-2 text-sm font-medium sm:flex">
          {
            desktopNavItems.map((item) => (
              <a
                href={item.href}
                class={isActive(item.href) ? "text-sky-700" : "text-slate-600 hover:text-sky-700"}
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="flex items-center gap-3">
          <span class="rounded-full bg-sky-50 px-2.5 py-1 text-xs font-medium text-sky-700">
            {roleLabel}
          </span>
          <form method="POST" action="/api/admin/auth/logout">
            <button
              type="submit"
              class="rounded-md border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-100"
            >
              Sair
            </button>
          </form>
        </div>
      </div>
    </header>

    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 pb-28 sm:pb-8">
      <slot />
    </main>

    <!-- Barra inferior de abas — só no celular (escondida a partir de `sm`). -->
    <nav
      class="fixed inset-x-0 bottom-0 z-20 flex border-t border-slate-200 bg-white pb-[env(safe-area-inset-bottom)] sm:hidden"
      aria-label="Navegação principal"
    >
      {
        primaryNavItems.map((item) => (
          <a
            href={item.href}
            class={`flex flex-1 flex-col items-center gap-0.5 py-2 text-[11px] font-medium ${
              isActive(item.href) ? "text-sky-700" : "text-slate-500"
            }`}
          >
            <Icon name={item.icon} class="h-6 w-6" />
            {item.label}
          </a>
        ))
      }

      <details class="more-menu relative flex flex-1 flex-col items-center justify-center">
        <summary
          class={`flex cursor-pointer list-none flex-col items-center gap-0.5 py-2 text-[11px] font-medium ${
            isMoreActive ? "text-sky-700" : "text-slate-500"
          }`}
        >
          <Icon name="more" class="h-6 w-6" />
          Mais
        </summary>

        <div class="absolute bottom-full right-2 mb-2 w-48 rounded-lg border border-slate-200 bg-white p-2 text-sm shadow-lg">
          {
            moreNavItems.map((item) => (
              <a
                href={item.href}
                class={`flex items-center gap-2 rounded-md px-3 py-2 font-medium ${
                  isActive(item.href) ? "text-sky-700" : "text-slate-600 hover:bg-slate-50"
                }`}
              >
                <Icon name={item.icon} class="h-5 w-5" />
                {item.label}
              </a>
            ))
          }
          <form method="POST" action="/api/admin/auth/logout">
            <button
              type="submit"
              class="flex w-full items-center gap-2 rounded-md px-3 py-2 text-left font-medium text-slate-600 hover:bg-slate-50"
            >
              <Icon name="logout" class="h-5 w-5" />
              Sair
            </button>
          </form>
        </div>
      </details>
    </nav>

    <script>
      // Liga a barra ao sair da página: link interno ou envio de formulário
      // que não foi tratado por JavaScript (ex.: botões de reenvio, que
      // chamam a API sem recarregar, cancelam o envio padrão).
      const loading = document.getElementById("page-loading");
      const show = () => loading?.setAttribute("data-active", "");

      document.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const link = (event.target as Element | null)?.closest("a");
        if (!link || !link.href || link.target || link.hasAttribute("download")) return;
        const url = new URL(link.href, location.href);
        if (url.origin !== location.origin) return;
        if (url.pathname === location.pathname && url.search === location.search && url.hash) return;
        // Deixa outros handlers do mesmo clique decidirem antes.
        setTimeout(() => {
          if (!event.defaultPrevented) show();
        });
      });

      document.addEventListener("submit", (event) => {
        setTimeout(() => {
          if (!event.defaultPrevented) show();
        });
      });

      // Voltar pelo navegador pode reabrir a página do cache com a barra ligada.
      window.addEventListener("pageshow", () => loading?.removeAttribute("data-active"));
    </script>
  </body>
</html>

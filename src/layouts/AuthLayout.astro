---
import "../styles/global.css";

// Telas de acesso do painel (F4.1): login, recuperação de senha, senha nova e
// escolha da clínica. Cartão centralizado, sem menu.
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | RecepClinic</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="flex min-h-screen items-center justify-center bg-slate-50 px-4 text-slate-900">
    <div class="w-full max-w-sm rounded-lg border border-slate-200 bg-white p-8 shadow-sm">
      <p class="text-sm font-semibold uppercase tracking-wide text-sky-700">RecepClinic</p>
      <h1 class="mt-1 text-xl font-bold text-slate-900">{title}</h1>
      <slot />
    </div>
  </body>
</html>

# Variáveis da plataforma, conferidas na primeira requisição (src/lib/env.ts):
# PUBLIC_SUPABASE_URL, PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY,
# SUPABASE_JWT_SECRET (32+), CRON_SECRET (32+ caracteres) e SITE_URL (opcional).
# Local: os valores saem de `supabase status` (API_URL, ANON_KEY,
# SERVICE_ROLE_KEY, JWT_SECRET). As do WhatsApp abaixo
# ainda são do código herdado do piloto e passam para o banco, por clínica, na F6.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Assina a credencial limitada à clínica (bot, agendador, páginas públicas; F3.3).
# Na nuvem: o segredo compartilhado do projeto (Settings > JWT Keys).
SUPABASE_JWT_SECRET=
# E-mail próprio por SMTP (F4.4a: convites e pedido de informações). Opcional:
# sem SMTP_HOST, o painel avisa que o e-mail não saiu. Local: o Mailpit do
# Supabase (SMTP_HOST=127.0.0.1, SMTP_PORT=54325). Na nuvem: o provedor (ex.:
# Resend, smtp.resend.com, porta 465, usuário "resend" e a chave como senha).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# App RecepClinic na Meta (F6.1, da plataforma): App Secret (Configurações >
# Básico do app), que confere a assinatura X-Hub-Signature-256 do webhook, e o
# token de verificação do cadastro do webhook. As duas juntas ou nenhuma; sem
# elas, o webhook recusa os eventos. Número e token de cada clínica ficam no
# banco (Configurações > WhatsApp, cadastro do Suporte).
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Segredo das rotinas (/api/cron/…): o agendador do Supabase (pg_cron) manda
# "Authorization: Bearer <CRON_SECRET>"; o endereço e o segredo vão para o
# cofre com `node --env-file=<arquivo> scripts/agendador.mjs` (F6.3/F7). Gerar
# um valor aleatório com 32 caracteres ou mais (ex.: `openssl rand -hex 32`).
CRON_SECRET=

# Opcional — base pública do site, usada pelo bot para montar o link de
# /agendar/[token] enviado por WhatsApp. Sem ela, cai no mesmo fallback do
# astro.config.mjs (domínio de produção em VERCEL_ENV=production, preview da
# Vercel via VERCEL_URL, ou localhost em dev).
SITE_URL=

# Variáveis da plataforma, conferidas na primeira requisição (src/lib/env.ts):
# PUBLIC_SUPABASE_URL, PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY,
# SUPABASE_JWT_SECRET (32+), CRON_SECRET (32+ caracteres) e SITE_URL (opcional).
# Local: os valores saem de `supabase status` (API_URL, ANON_KEY,
# SERVICE_ROLE_KEY, JWT_SECRET). As do WhatsApp abaixo
# ainda são do código herdado do piloto e passam para o banco, por clínica, na F6.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Assina a credencial limitada à clínica (bot, agendador, páginas públicas; F3.3).
# Na nuvem: o segredo compartilhado do projeto (Settings > JWT Keys).
SUPABASE_JWT_SECRET=
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App Secret da Meta (Configurações > Básico do App). Usado para validar a
# assinatura X-Hub-Signature-256 do webhook. Sem ele o POST do webhook é
# recusado (500).
WHATSAPP_APP_SECRET=
# Nomes dos templates aprovados no painel da Meta (um por tipo de evento).
# Sem o template correspondente, a notificação da Fase 3a é só registrada em
# whatsapp_messages (status skipped_no_template), não enviada.
WHATSAPP_TEMPLATE_CONFIRMATION=
# Confirmação de retorno (sem a frase de pagamento) — opcional; vazio = usa o template geral acima.
WHATSAPP_TEMPLATE_CONFIRMATION_RETURN=
# Layout novo da confirmação (set/2026: "Olá! 😊 / Agradecemos por agendar {{1}}." + lista + assinatura) —
# {{1}} passa a ser a frase completa ("a consulta domiciliar com a Dra. …", "o exame …"). Ligar (true) só
# depois que a versão nova do template correspondente for aprovada na Meta.
WHATSAPP_TEMPLATE_CONFIRMATION_NEW_LAYOUT=
WHATSAPP_TEMPLATE_CONFIRMATION_RETURN_NEW_LAYOUT=
# Preparo do exame fora da janela de 24h (Fase 18) — variáveis: {{1}} nome do exame, {{2}} link da página de preparo.
# Vazio = dentro da janela o preparo vai como texto normalmente; fora dela só fica registrado (skipped_no_template).
WHATSAPP_TEMPLATE_EXAM_PREPARATION=
# Oferta de vaga da lista de espera (Fase 25), botões Sim/Não.
WHATSAPP_TEMPLATE_WAITLIST_OFFER=
WHATSAPP_TEMPLATE_RESCHEDULE=
WHATSAPP_TEMPLATE_CANCELLATION=
WHATSAPP_TEMPLATE_REMINDER=
# Lembrete curto (03/out/2026): true = template lembrete_consulta na versão curta
# (4 variáveis, endereço no Local). Vazio = layout antigo (5 variáveis).
WHATSAPP_TEMPLATE_REMINDER_SHORT=
# Resumo diário para a equipe (Fase 7, rota /api/cron/daily-summary) — um
# template por lista (consultas, exames), 1 variável cada (a lista formatada
# numa linha só).
WHATSAPP_TEMPLATE_DAILY_SUMMARY_CONSULTAS=
WHATSAPP_TEMPLATE_DAILY_SUMMARY_EXAMES=
# Mesmos resumos no envio das 06h30 (atendimentos de hoje): texto fixo
# "de hoje" (`resumo_consultas_hoje` / `resumo_exames_hoje`). Vazias → o
# envio da manhã não sai (fica como "template desligado" na tela Envios).
WHATSAPP_TEMPLATE_DAILY_SUMMARY_CONSULTAS_TODAY=
WHATSAPP_TEMPLATE_DAILY_SUMMARY_EXAMES_TODAY=
# Cancelamento em massa de um dia (Fase 12) — motivo fixo ("imprevisto da
# médica") + link de agendamento novo, 5 variáveis.
WHATSAPP_TEMPLATE_MASS_CANCELLATION=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# Segredo do cron de lembretes (rota /api/cron/appointment-reminders).
# A Vercel injeta "Authorization: Bearer <CRON_SECRET>" nas execuções
# agendadas quando esta env var existe no projeto. Gerar um valor aleatório
# com 32 caracteres ou mais (ex.: `openssl rand -hex 32`). Para testar local: mande o mesmo valor no header Authorization.
CRON_SECRET=

# Opcional — base pública do site, usada pelo bot para montar o link de
# /agendar/[token] enviado por WhatsApp. Sem ela, cai no mesmo fallback do
# astro.config.mjs (domínio de produção em VERCEL_ENV=production, preview da
# Vercel via VERCEL_URL, ou localhost em dev).
SITE_URL=
